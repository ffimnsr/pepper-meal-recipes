  "id": "cab26cdd-1caf-5a92-b506-242dcdcec01e",
  "slug": "fluffy-french-toast",
  "name": "Fluffy French Toast",
  "recipe_type": "breakfast",
  "brief_description": "A small scoop of flour makes this the best French toast recipe! Thickening the batter just a little makes tender, fluffy toast and helps it brown nicely.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place flour into a large mixing bowl; slowly whisk in milk until smooth. Whisk in eggs, sugar, vanilla, cinnamon, and salt until well combined."
    },
    {
      "position": 3,
      "text": "Heat a lightly oiled griddle or frying pan over medium heat. Meanwhile, soak bread slices in milk mixture until saturated."
    },
    {
      "position": 4,
      "text": "Working in batches, cook bread on the preheated griddle or pan until golden brown on both sides, about 2 minutes per side."
    },
    {
      "position": 5,
      "text": "Serve hot and enjoy."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

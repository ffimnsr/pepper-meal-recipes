  "id": "aaa5aca1-c913-5a8b-9677-de52b447c593",
  "slug": "creamy-scallop-chowder",
  "name": "Creamy Scallop Chowder",
  "recipe_type": "soup",
  "brief_description": "A wonderful scallop soup featuring white wine, onions, and mushrooms. Use either ocean or bay scallops to make this easy yet decadent chowder.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Wash and drain scallops."
    },
    {
      "position": 2,
      "text": "Melt butter in a small stock pot over medium-low heat. Saut\u00e9 onions and mushrooms until tender."
    },
    {
      "position": 3,
      "text": "Stir in flour. Pour in milk and stir over medium heat until thickened and bubbly. Add wine, scallops, salt, and pepper. Cook over medium heat until thickened. Serve topped with Swiss cheese and parsley."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,

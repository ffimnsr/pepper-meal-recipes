  "id": "30b38428-a697-5f9e-9f97-51a48c1e96da",
  "slug": "mini-crab-cakes",
  "name": "Mini Crab Cakes",
  "recipe_type": "appetizer",
  "brief_description": "Crab cakes made with Greek nonfat yogurt are mini bites of bliss. A fun, festive appetizer!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together crabmeat, egg, 1/3 cup yogurt, red pepper, green onion, lemon zest fresh cracked pepper, and 1/2 cup breadcrumbs."
    },
    {
      "position": 2,
      "text": "Form mini crab cakes using a tablespoon or small ice cream scoop, and coat the crab cakes in remaining breadcrumbs, placing them onto a parchment lined baking sheet. Spray lightly with cooking spray."
    },
    {
      "position": 3,
      "text": "Bake in a 400 degrees F preheated oven for 12-15 minutes or until lightly golden."
    },
    {
      "position": 4,
      "text": "Mix remaining yogurt, lemon juice, chopped parsley and basil. Season with cracked black pepper. Serve sauce with crab cakes."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

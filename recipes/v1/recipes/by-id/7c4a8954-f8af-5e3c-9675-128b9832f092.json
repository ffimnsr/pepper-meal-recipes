  "id": "7c4a8954-f8af-5e3c-9675-128b9832f092",
  "slug": "borscht-ii",
  "name": "Borscht II",
  "recipe_type": "soup",
  "brief_description": "Cross cut beef shank forms the broth for this hot borscht with cabbage, carrots and celery.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "In a large pot over medium heat, brown beef in oil. Stir in onion and water, reduce heat and simmer, covered, 2 hours, until meat is tender."
    },
    {
      "position": 2,
      "text": "Remove meat from broth and set aside to cool slightly. Stir carrots, celery, cabbage, beets, tomato juice, lemon juice, sugar, salt and pepper into broth. When meat is cool enough to handle, cut meat from bone and into bite-size pieces and return to soup. Simmer until vegetables are tender, 20 to 30 minutes."
    }
  ],

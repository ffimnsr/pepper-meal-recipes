  "id": "9da141e6-48e8-5415-9e1f-9d19d3f05fe6",
  "slug": "cajun-ponchartrain-sauce",
  "name": "Cajun Ponchartrain Sauce",
  "recipe_type": "main",
  "brief_description": "Serve this creamy Ponchartrain sauce, made with shrimp and mushrooms, over any grilled, blackened, or pan fried fish for a romantic meal for two.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium saucepan, saute mushrooms in 1 teaspoon butter until tender. Stir in shrimp, and cook until pink. Transfer to a bowl."
    },
    {
      "position": 2,
      "text": "In the same saucepan, melt the remaining butter. Slowly mix in cream. Stir in shrimp and mushroom mixture, and season to taste with garlic powder and black pepper. Simmer over very low heat until thick. Just before serving, stir in Madeira wine."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

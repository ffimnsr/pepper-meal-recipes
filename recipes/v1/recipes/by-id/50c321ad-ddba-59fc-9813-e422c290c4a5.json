  "schema_version": 1,
  "id": "50c321ad-ddba-59fc-9813-e422c290c4a5",
  "slug": "air-fryer-vegan-buffalo-tofu-bites",
  "name": "Air Fryer Vegan Buffalo Tofu Bites",
  "recipe_type": "appetizer",
  "brief_description": "Make Buffalo tofu in the air fryer. No oil needed for these tasty, zesty breaded vegan tofu bites. Using frozen tofu ensures a nice chewy texture.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Remove tofu block from the package and discard liquid. Wrap tofu in cheesecloth, place on a plate, and cover with a heavy pot until remaining liquid has been squeezed out, about 10 minutes. Remove the cheesecloth and cut tofu into 20 1-inch, bite-sized pieces. Place in a freezer-safe container and freeze, 8 hours or overnight."
    },
    {
      "position": 2,
      "text": "Remove tofu from freezer and thaw on paper towels or a dry cheesecloth. Pat dry."
    },
    {
      "position": 3,
      "text": "While tofu is thawing, put cornstarch into a resealable plastic bag. Pour rice milk into a small bowl."
    },
    {
      "position": 4,
      "text": "Preheat an air fryer to 375 degrees F (190 degrees C)."
    },
    {
      "position": 5,
      "text": "Place tofu into the bag with cornstarch, seal, and shake to coat the tofu pieces completely. Remove tofu pieces and dredge each piece in rice milk."
    },
    {
      "position": 6,
      "text": "Place bread crumbs, garlic powder, paprika, onion powder, and pepper in the resealable plastic bag with the cornstarch residue; shake until well mixed. Place each piece of tofu, one at a time, back in the bag with the bread crumbs. Shake the bag until tofu piece is completely coated, tap gently to shake off excess, and place tofu on a wire rack while you repeat with remaining tofu pieces."
    },
    {
      "position": 7,
      "text": "Add coated tofu to the air fryer basket and cook for 10 minutes. Shake the basket to loosen the pieces. Cook for another 3 minutes or until browned."
    },
    {
      "position": 8,
      "text": "Place 1/3 cup Buffalo sauce in a bowl, add cooked tofu bites, and toss to coat. Drizzle remaining Buffalo sauce over tofu and continue tossing to coat. Serve immediately."
    }
  ],
  "servings": 20,

  "slug": "watermelon-feta-salad",
  "name": "Watermelon Salad with Feta",
  "recipe_type": "salad",
  "brief_description": "This watermelon salad with feta, arugula, and tomatoes is easy to make for a refreshing summer salad with sweet, salty, peppery flavors in every bite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk olive oil, vinegar, and salt together in a large mixing bowl. Add tomatoes, arugula, and red onion; toss to coat. Gently stir in watermelon and feta cheese to serve."
    }
  ],
  "servings": 8,

  "id": "ff5fd5b7-e324-53b8-a09c-5e0c15506bc7",
  "slug": "grate-apple-crisp-recipe-8727014",
  "name": "\u201cGrate\u201d Apple Crisp",
  "recipe_type": "dessert",
  "brief_description": "With a luxurious texture and a flavor that approaches apple butter, Chef John's apple crisp is truly delicious. It also skips the tedious peeling, coring, and slicing step.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Generously grease a shallow 2-quart baking dish with 2 tablespoons butter, and set aside."
    },
    {
      "position": 2,
      "text": "Grate apples into a bowl, and add lemon juice, cinnamon, cornstarch, white sugar, and brown sugar. Mix thoroughly, and transfer into the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Add oats, Grape Nuts, flour, white sugar, brown sugar, and melted butter into the bowl used for the apples, and stir thoroughly until everything is evenly coated with melted butter; spread mixture evenly over the apples."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the apple layer has thickened, is bubbling around the sides, and topping is golden brown, about 1 hour."
    },
    {
      "position": 5,
      "text": "Remove and let cool to warm before serving, or chill before serving if you prefer."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "3c842988-74fa-557e-ba29-1a74b775981f",
  "slug": "homemade-dog-food-with-meat-and-vegetables",
  "name": "Homemade Dog Food with Meat and Vegetables",
  "recipe_type": null,
  "brief_description": "Prepared with two different types of meats and a variety of vegetables, this homemade dog food is perfect for even the most sensitive pups.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place sweet potatoes in a large Dutch oven filled 3/4-full with water. Bring to a boil and cook for 10 minutes. Add chuck roast and bison to the pot and cook until meat is no longer pink, 10 to 12 minutes."
    },
    {
      "position": 2,
      "text": "Add carrots, peas, green beans, and spinach to the pot and cook over medium heat for 15 minutes. Add oats and stir until mixture has thickened, 5 to 7 minutes. Stir in pumpkin and olive oil; remove from heat and let cool a bit, 5 to 10 minutes. Transfer roast to a plate and dice meat; return to mixture."
    },
    {
      "position": 3,
      "text": "Use a potato masher to mash up mixture to a mushy consistency. Let mixture cool sufficiently, about 30 minutes. Place into resealable containers and freeze."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

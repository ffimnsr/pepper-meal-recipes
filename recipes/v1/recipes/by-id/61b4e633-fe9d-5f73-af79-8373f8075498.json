  "id": "61b4e633-fe9d-5f73-af79-8373f8075498",
  "slug": "butter-chicken-tarts",
  "name": "Butter Chicken Tarts",
  "recipe_type": "appetizer",
  "brief_description": "These butter chicken tarts with a homemade crust provide a delicious new twist on the classic Indian dinner dish.",
  "cuisine": "Indian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease 6 cups of a muffin tin."
    },
    {
      "position": 2,
      "text": "Stir sugar, salt, cumin, and garlic powder into the melted butter in a bowl. Add flour slowly, mixing until moist but not sticky; you should be able to manipulate it with your hands."
    },
    {
      "position": 3,
      "text": "Separate tart dough into 6 sections; roll each into a ball and flatten into a round in your hand. Press into the prepared muffin cups."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until lightly browned, about 10 minutes."
    },
    {
      "position": 5,
      "text": "While crusts are baking, heat oil over medium-high heat in a skillet. Saute onion and white sections of green onions in the hot oil until just starting to brown, 5 to 7 minutes. Add chicken, soy-based liquid seasoning, salt, and pepper; saute for 1 to 2 minutes. Add butter chicken sauce and cook until warmed through, 1 to 2 minutes."
    },
    {
      "position": 6,
      "text": "Spoon butter chicken mixture into the baked tart shells."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until lightly browned, about 5 minutes. Remove tarts from tin using a butter knife and tongs. Sprinkle green sections of green onions on top."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "53bec660-bb23-5afa-bf0a-e70f136e9b6c",
  "slug": "malasadas",
  "name": "Malasadas",
  "recipe_type": "dessert",
  "brief_description": "A yeast doughnut of Portuguese origins that is very popular in Hawaii, malasadas are rich with eggs, butter and milk. Deep-fried, then coated with plain sugar, they make an irresistible treat.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Dissolve yeast and 1 teaspoon sugar in 1/4 cup warm water; set aside."
    },
    {
      "position": 2,
      "text": "In small bowl, beat eggs until thick."
    },
    {
      "position": 3,
      "text": "Put flour in large bowl, making a well in the center. Into the well add yeast, eggs, 1/2 cup sugar, melted butter, milk, 1 cup water, and salt. Beat thoroughly to form a soft, smooth dough. Cover, let dough rise until doubled."
    },
    {
      "position": 4,
      "text": "Heat oil to 375 degrees F (190 degrees C). Drop dough by big teaspoonfuls into oil, fry until golden brown. Drain on paper towels, shake in a bag of sugar to coat, and serve hot."
    }
  ],
  "servings": 84,

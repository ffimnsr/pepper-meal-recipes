  "id": "5625cf49-d4d5-5cbf-927f-9f97cec35c6f",
  "slug": "instant-pot-minestrone-soup",
  "name": "Instant Pot Minestrone Soup",
  "recipe_type": "soup",
  "brief_description": "Using your Instant Pot is a great way of making a minestrone with Italian turkey sausage, vegetables, and cannellini beans that's amazingly healthy and quick!",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select Saute function. Add sausage and saut\u00e9, breaking it into pieces with a wooden spoon, until browned, about 5 minutes. Add water, chicken soup base, beans, zucchini, onion, carrots, and garlic. Stir once."
    },
    {
      "position": 2,
      "text": "Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 3 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 3,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Add spinach, Italian herbs, and rosemary; stir until spinach has wilted. Ladle minestrone into bowls and top with freshly grated Parmesan cheese."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

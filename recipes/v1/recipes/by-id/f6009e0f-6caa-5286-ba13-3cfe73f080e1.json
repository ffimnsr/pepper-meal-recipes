{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "f6009e0f-6caa-5286-ba13-3cfe73f080e1",
  "slug": "halloween-pumpkin-whoopie-pies-recipe-11819142",
  "name": "Halloween Pumpkin Whoopie Pies",
  "recipe_type": "dessert",
  "brief_description": "Chef John's Halloween pumpkin whoopie pies are an amazing treat\u2014pumpkin sandwich cookies with piped-on decoration baked right in, and a fluffy cream cheese filling.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line 2 baking sheets with parchment."
    },
    {
      "position": 2,
      "text": "Whisk flour, salt, baking powder, baking soda, cinnamon, ginger, and cloves together in a bowl until thoroughly combined."
    },
    {
      "position": 3,
      "text": "In another bowl, whisk pumpkin, brown sugar, egg, and vegetable oil thoroughly together."
    },
    {
      "position": 4,
      "text": "Add orange food coloring to the wet ingredients, along with flour mixture, and stir with a whisk until evenly combined. Whisk in more orange food coloring for a deeper color."
    },
    {
      "position": 5,
      "text": "Transfer 10, evenly spaced, 1 1/2 tablespoon-sized portions onto 1 of the prepared baking sheet. Use a damp finger to flatten the batter slightly, while also making the portions as round as possible."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until cookies just start to turn golden brown ever so slightly around the edges, about 18 minutes. Remove cookies; do not turn the oven off. Cool cookies on the pan for about 15 minutes, then transfer to a wire rack to cool completely."
    },
    {
      "position": 7,
      "text": "Portion 10 more cookies on the second sheet pan as above in Step 4. Add brown food coloring to the remaining batter; transfer into a piping bag fitted with a fine round tip (alternately, add brown batter into a resealable plastic sandwich bag, and snip a very small piece of the corner snipped off after batter is transferred in)."
    },
    {
      "position": 8,
      "text": "Use the darker batter to pipe whatever Halloween designs you want on top of the portioned batter."
    },
    {
      "position": 9,
      "text": "Bake cookies in the preheated oven until cookies just start to turn golden brown ever so slightly around the edges, about 18 minutes. Cool cookies on the pan for about 15 minutes, then transfer to a wire rack to cool completely."
    },
    {
      "position": 10,
      "text": "While cookies are cooling, make the frosting. Combine cream cheese, butter, milk, vanilla, and confectioner\u2019s sugar in a mixing bowl, and beat with an electric hand mixer on High speed to whip the mixture until smooth, light, and fluffy. Refrigerate frosting to firm up a bit before trying to pipe."
    },
    {
      "position": 11,
      "text": "Spread frosting evenly onto the 10 bottom, undecorated cookies, and top with the 10 decorated cookies. Refrigerate cookies until thoroughly chilled before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 45,

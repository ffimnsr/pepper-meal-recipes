  "id": "acaecc78-ec87-5695-b2fe-c56d85c83981",
  "slug": "slow-cooker-corn-chowder",
  "name": "Slow Cooker Corn Chowder",
  "recipe_type": "soup",
  "brief_description": "A can of evaporated milk finishes this ham and corn chowder slow cooker recipe with onion, celery, and potato in a chicken bouillon soup base. Allow 8 hours of cooking time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes, onions, ham, celery, corn, margarine, salt, and pepper in a slow cooker. Add bouillon cubes and enough water to cover."
    },
    {
      "position": 2,
      "text": "Cook on Low for 8 to 9 hours. Stir in evaporated milk, then cook for 30 more minutes."
    }
  ],
  "servings": 9,

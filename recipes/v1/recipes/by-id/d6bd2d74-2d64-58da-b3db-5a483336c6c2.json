  "id": "d6bd2d74-2d64-58da-b3db-5a483336c6c2",
  "slug": "cherry-tarts-recipe-7511030",
  "name": "These Homemade Cherry Tarts Are Sure to Sweeten Your Day",
  "recipe_type": "dessert",
  "brief_description": "These cherry tarts can be served warm or chilled, and they're great with a dollop of whipped cream and a sprinkling of shaved chocolate.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place pie crusts on a lightly floured surface and roll out each crust with a rolling pin, so it is large enough to cut three 5 to 5-1/2-inch circles, for a total of 6 tart crusts."
    },
    {
      "position": 3,
      "text": "Fit each dough circle into a 4-inch removable-bottom tart pan. Press the dough against the sides of the pans, and prick the bottom with a fork to prevent bubbling. Remove any excess dough by running the rolling pin across the top of each pan."
    },
    {
      "position": 4,
      "text": "Refrigerate tart crusts until well chilled, about 45 minutes, keeping them refrigerated until ready to use."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). In a large bowl, combine cherries, tapioca, sugar, almond extract, and salt."
    },
    {
      "position": 6,
      "text": "Remove the pans from the fridge and distribute cherry mixture evenly among the tart pans. Place the pans on a baking sheet."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until cherries are soft and crust is golden brown, 25 to 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "49e5e16f-0197-5b36-9c74-93a85fac6c77",
  "slug": "chicken-mole-enchilada-casserole-recipe-11839036",
  "name": "Chicken Mole Enchilada Casserole",
  "recipe_type": "main",
  "brief_description": "This chicken mole enchilada casserole is made with jarred mole sauce to cut down on time. Cheesy and slightly spicy, the casserole looks beautiful with all the toppings.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Add mole sauce to a saucepan. Slowly whisk in chicken broth and bring to a boil over high heat. Reduce heat to medium and simmer for 10 minutes, stirring frequently. The mixture should be smooth."
    },
    {
      "position": 3,
      "text": "Combine 2 cups of sauce with the chicken in a bowl."
    },
    {
      "position": 4,
      "text": "Dip tortillas in the remaining sauce, removing any excess and set aside."
    },
    {
      "position": 5,
      "text": "Place 6 tortillas in the prepared baking dish, cutting to fit as needed. Add half of the chicken mixture and 1 1/3 cup of the cheese. Repeat with a second layer, then top with the remaining tortillas and sauce."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 20 minutes. Add remaining 1 1/3 cups cheese and bake until cheese is melted and casserole is bubbly, about 10 minutes."
    },
    {
      "position": 7,
      "text": "Top with sour cream, pickled red onion, and cilantro for serving. Recipe developed by Nicole Irwin"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "e2545454-2c35-59f4-8a84-f8a17c8ef11e",
  "slug": "alanes-hanukkah-brisket",
  "name": "Alane's Hanukkah Brisket",
  "recipe_type": "soup",
  "brief_description": "This Hanukkah brisket is cooked for hours in the oven with beef broth, French onion soup, and beer for a flavorful, melt-in-your-mouth meat dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place a large roasting pan over medium-high heat. Sear brisket, fat-side down first, in the hot pan until browned, about 3 minutes per side. Remove brisket from the pan and set aside."
    },
    {
      "position": 3,
      "text": "Place onion slices into the bottom of the same roasting pan; pour 1 can beef broth, 1 can French onion soup, and 1 can beer over onions. Lay brisket on top; pour remaining beef broth, French onion soup, and beer over brisket. Cover the roasting pan with a lid."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 3 hours. Let brisket stand at room temperature for 30 minutes."
    },
    {
      "position": 5,
      "text": "Remove brisket from the roasting pan and wrap tightly in aluminum foil. Pour pan juices and onion into a food storage container and cover tightly with a lid. Refrigerate brisket and pan juices, 8 hours to overnight."
    },
    {
      "position": 6,
      "text": "The next day, preheat the oven to 350 degrees F (175 degrees C). Pour pan juices and onion into a 9x13-inch baking dish."
    },
    {
      "position": 7,
      "text": "Unwrap brisket, cut away any visible fat, and slice thinly across the grain of the meat. Place brisket slices into pan juices."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until pan juices are thickened and meat is hot, about 45 minutes."
    }
  ],
  "servings": 10,

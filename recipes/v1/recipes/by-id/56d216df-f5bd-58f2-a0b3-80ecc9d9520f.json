  "schema_version": 1,
  "id": "56d216df-f5bd-58f2-a0b3-80ecc9d9520f",
  "slug": "grandma-omas-creamy-german-potato-salad-recipe-8653431",
  "name": "Grandma Oma's Creamy German Potato Salad",
  "recipe_type": "salad",
  "brief_description": "This flavor-packed potato salad is made with potatoes, eggs, pickles, and diced German Wiener. It's the perfect thing to bring to your next potluck\u2014it'll be sure to go fast.",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Add potatoes with skin on to a large pot; fill with enough water to cover potatoes completely. Bring to a boil, reduce heat to medium, and cook until potatoes are easily pierced with a fork, 20 to 30 minutes. Drain potatoes, but do not rinse. Peel potatoes when cool enough to handle, leaving them whole. Cover and refrigerate until ready to prepare the salad, ideally overnight."
    },
    {
      "position": 3,
      "text": "Heat a pot of water until boiling. Carefully drop in the cold eggs using a spoon and boil for 7 minutes and 22 seconds. Drain; pour cold water over eggs to stop the boiling process. Peel immediately under cold, running water, shells should come off easily. Let eggs cool; dice 5 eggs for salad, and cut 2 eggs into wedges for garnish; set aside."
    },
    {
      "position": 4,
      "text": "Meanwhile, slice potatoes 1/4-inch thick, and combine with diced onion in a large bowl."
    },
    {
      "position": 5,
      "text": "Combine diced pickles and Wiener sausages in a separate bowl."
    },
    {
      "position": 6,
      "text": "Stir broth, pickle juice, vinegar, and mustard together in a saucepan and bring to a boil. Add salt, pepper, and sugar to taste. Let cool slightly, then pour over potato-onion mixture and let marinate for 10 minutes. Fold in mayonnaise. Stir in diced egg and pickle mixture."
    },
    {
      "position": 7,
      "text": "Serve immediately or refrigerate until ready to serve. Garnish with egg wedges, pickle slices, and parsley before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

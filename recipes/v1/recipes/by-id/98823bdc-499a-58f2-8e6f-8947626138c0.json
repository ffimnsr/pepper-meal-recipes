  "id": "98823bdc-499a-58f2-8e6f-8947626138c0",
  "slug": "filipino-corned-beef-and-cabbage",
  "name": "Filipino Corned Beef and Cabbage",
  "recipe_type": "main",
  "brief_description": "This Filipino version of corned beef and cabbage is really simple to cook and an Asian take on the classic Irish combination.",
  "cuisine": "Filipino",
  "instructions": [
    {
      "position": 1,
      "text": "Heat butter and oil in a large pot over medium heat. Add onion and garlic and cook until onion is soft and translucent, about 5 minutes. Add tomatoes and heat through, about 3 minutes."
    },
    {
      "position": 2,
      "text": "Stir in cabbage and and cook until softened, about 5 minutes. Add a splash of chicken stock and heat through, about 3 minutes."
    },
    {
      "position": 3,
      "text": "Mix in corned beef and cook until heated through and flavors have combined, about 10 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

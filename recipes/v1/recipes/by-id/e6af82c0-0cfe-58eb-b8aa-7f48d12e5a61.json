  "id": "e6af82c0-0cfe-58eb-b8aa-7f48d12e5a61",
  "slug": "squash-and-zucchini-casserole-recipe-11910638",
  "name": "Squash and Zucchini Casserole",
  "recipe_type": "side",
  "brief_description": "For this squash and zucchini casserole, summer squash and zucchini bake together with sharp Cheddar cheese, sour cream, and a buttery stuffing top.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine zucchini, squash, onion, and 1 teaspoon salt in a large pot. Add 1 1/2 cups water and set the pot over medium-high heat. Bring to a boil and cook, stirring occasionally, until vegetables are very tender, about 20 minutes. Drain very well, pressing any excess liquid out through a strainer. Set aside."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9x13-inch (or similar size) baking dish."
    },
    {
      "position": 3,
      "text": "Remove 3/4 cup stuffing mix from the package, making sure to include some of the seasoning that collects in the bottom of the pack. Add stuffing mix to a large bowl and set remaining stuffing mix aside for topping."
    },
    {
      "position": 4,
      "text": "To the large bowl with stuffing mix, add squash mixture, sour cream, mayonnaise, 1 teaspoon salt, pepper, and crushed red pepper; stir to combine. Taste to adjust seasonings if necessary. Stir in egg. Reserve 1/2 cup cheese for topping and stir in remaining cheese. Mix well and transfer mixture to a baking dish."
    },
    {
      "position": 5,
      "text": "Stir remaining stuffing mix and melted butter together in a bowl until well coated. Sprinkle evenly over the top and sprinkle with reserved cheese."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 45 to 50 minutes. Cover loosely with foil halfway through or when top is browned. Let stand 10 minutes before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

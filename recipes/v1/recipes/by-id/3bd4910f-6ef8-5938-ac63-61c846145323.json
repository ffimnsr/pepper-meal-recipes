  "id": "3bd4910f-6ef8-5938-ac63-61c846145323",
  "slug": "mashed-purple-sweet-potatoes",
  "name": "Purple Mashed Potatoes",
  "recipe_type": "dessert",
  "brief_description": "Tender purple mashed sweet potatoes are blended with coconut milk, lime juice, salt, and pepper to make this unique, nutritious, and delicious side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Poke holes all over potatoes with a fork. Arrange in a baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until purple potatoes are easily pierced with a knife, about 45 minutes."
    },
    {
      "position": 4,
      "text": "Cut purple potatoes in half, widthwise, on a cutting board. Scoop flesh into a mixing bowl. Add coconut milk, lime juice, salt, and pepper to taste. Beat with an electric mixer until smooth. Serve while still warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "aabc4ba8-4e51-5f0c-9a74-b09cfc80043c",
  "slug": "lucky-charms-treats-recipe-7488435",
  "name": "Lucky Charms Treats",
  "recipe_type": "dessert",
  "brief_description": "Lucky Charms treats are an easy-to-make, magically delicious marshmallow treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spray a 9x13-inch pan with cooking spray and set aside."
    },
    {
      "position": 2,
      "text": "Melt butter in a large pot over low heat. Stir in marshmallows; stir constantly until marshmallows are completely melted and mixture is smooth."
    },
    {
      "position": 3,
      "text": "Remove from heat and stir in Lucky Charms Cereal, coating cereal with marshmallow mixture."
    },
    {
      "position": 4,
      "text": "Pour into the prepared 9x13 pan. Press gently into the pan in an even layer. Allow to cool completely, 20 minutes to an hour, before cutting into squares."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

  "id": "9bc78783-db73-5c5d-bab4-b99ce57747db",
  "slug": "leftover-mashed-potato-egg-cups-recipe-8754019",
  "name": "Leftover Mashed Potato Egg Cups",
  "recipe_type": "breakfast",
  "brief_description": "These leftover mashed potato egg cups are a great way to use up mashed potatoes, and are quick and easy to assemble for breakfast or brunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Spray 4 (6 ounce) ramekins with cooking spray. Place 4 ounces mashed potatoes into each ramekin. Using the back of a spoon, mold into nests, and brush with 1 lightly beaten egg."
    },
    {
      "position": 3,
      "text": "Break 1 of the 4 remaining eggs into each ramekin. Drizzle each with 1/2 teaspoon milk, top with 1 pat of butter, and 1 tablespoon Cheddar cheese."
    },
    {
      "position": 4,
      "text": "Cook until yolk is starting to set and cheese is melted, 15 to 20 minutes (cooking time will depend on how you want your eggs cooked). Remove from the oven, and let stand until residual heat finishes cooking the egg whites, 1 to 3 minutes."
    },
    {
      "position": 5,
      "text": "Season with salt and pepper, garnish with green onions or chives, and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

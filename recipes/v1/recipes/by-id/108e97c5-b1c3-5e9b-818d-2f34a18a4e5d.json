  "id": "108e97c5-b1c3-5e9b-818d-2f34a18a4e5d",
  "slug": "easy-southern-dressing-recipe-11821083",
  "name": "Easy Southern Dressing",
  "recipe_type": "side",
  "brief_description": "This easy Southern dressing is a cornbread and herb stuffing mix combination that is easy on both time and budget. Cornbread muffin mix and packaged cubed herb-seasoned bread stuffing mix are just the shortcut ingredients you need to make holidays relaxing.",
  "cuisine": "American Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Butter the bottom and sides of a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Add cornbread mix to a bowl. Stir in 2 eggs and 2/3 cup milk until combined; batter will be slightly lumpy. Spread batter into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden brown, and a toothpick inserted in the center comes out clean, about 20 minutes. Set aside to cool completely. (Cornbread can be made the day before.)"
    },
    {
      "position": 4,
      "text": "Melt butter in a large skillet over medium heat. Add onion, celery, and salt to the skillet. Cook until softened, 4 to 5 minutes. Remove from heat and transfer to a large bowl."
    },
    {
      "position": 5,
      "text": "Add remaining milk, chicken stock, eggs, and sage to vegetable mixture and whisk to combine."
    },
    {
      "position": 6,
      "text": "Crumble cornbread into mixture, and add stuffing mix, crackers, and pepper. Stir until everything is well moistened; mixture should be very moist. Season to taste with salt and pepper."
    },
    {
      "position": 7,
      "text": "Transfer stuffing mixture to a 9x13-inch baking dish and cover with foil."
    },
    {
      "position": 8,
      "text": "Bake stuffing in the preheated oven for 30 minutes. Remove cover and continue to bake until set and lightly browned on top, 10 to 20 minutes more. (Alternatively, dressing can be made ahead of time and refrigerated before baking. If refrigerated, bake 40 minutes covered, then uncover and bake an additional 15 to 20 minutes or until done.)"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 25,

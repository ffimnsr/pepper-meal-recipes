  "id": "c39962b9-a0f0-53bf-8f5c-f6e37d86fd7d",
  "slug": "raspberry-rose-scones",
  "name": "Raspberry-Rose Scones",
  "recipe_type": "breakfast",
  "brief_description": "In this raspberry-rose scones recipe, rose water adds a lovely flavor to these tender scones. You'll want to serve the scones warm with a cup of tea.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with a silicone mat or parchment paper."
    },
    {
      "position": 2,
      "text": "Whisk flour, sugar, baking powder, salt, and baking soda together in a large bowl."
    },
    {
      "position": 3,
      "text": "Grate 1/3 butter into flour mixture using the large holes of a box grater; toss lightly with your fingertips until coated with flour. Repeat twice more with remaining 2/3 butter."
    },
    {
      "position": 4,
      "text": "Beat 1/2 cup cream, egg, and rose water together in a small bowl with a fork; pour over flour-butter mixture. Mix with a fork just until large clumps of dough form. Gently mix in raspberries."
    },
    {
      "position": 5,
      "text": "Turn dough out onto a lightly floured surface. Bring together and gently pat into a round about 3/4-inch thick. Cut into 8 wedges with a sharp knife."
    },
    {
      "position": 6,
      "text": "Arrange wedges on the prepared baking sheet. Brush tops with 2 tablespoons cream; sprinkle with raspberry sugar."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until golden, about 15 minutes. Cool before serving, 5 to 10 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

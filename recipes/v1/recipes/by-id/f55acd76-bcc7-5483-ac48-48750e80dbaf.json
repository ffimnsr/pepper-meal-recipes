  "id": "f55acd76-bcc7-5483-ac48-48750e80dbaf",
  "slug": "scallop-and-shrimp-chowder",
  "name": "Scallop and Shrimp Chowder",
  "recipe_type": "soup",
  "brief_description": "This scallop and shrimp chowder is made in the slow cooker with corn, onion, and potatoes, making it a fuss-free meal perfect for chilly evenings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together potatoes, broth, corn, onion, and flour in a 3 1/2-quart slow cooker crock until well combined."
    },
    {
      "position": 2,
      "text": "Cook on Low until potatoes are tender, about 6 hours."
    },
    {
      "position": 3,
      "text": "Stir cream, scallops, shrimp, potato flakes, and garlic pepper into the crock."
    },
    {
      "position": 4,
      "text": "Cook on High until chowder is slightly thickened, 35 to 45 minutes. Season with salt."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 395,
  "preparation_time_minutes": 15,

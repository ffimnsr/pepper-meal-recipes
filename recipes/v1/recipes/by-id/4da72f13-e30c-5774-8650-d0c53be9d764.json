{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "4da72f13-e30c-5774-8650-d0c53be9d764",
  "slug": "sensational-slow-cooked-beef-brisket",
  "name": "Sensational Slow Cooked Beef Brisket",
  "recipe_type": "main",
  "brief_description": "This slow-cooked beef brisket recipe with mushrooms, Worcestershire sauce, red wine, and seasonings is sensational and tender enough to cut with a fork.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine paprika, garlic powder, black pepper, sea salt, and cayenne pepper in a bowl; set aside."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a large skillet over medium heat. Add mushrooms and shallots; cook and stir until mushrooms release their liquid, 5 to 8 minutes. Set aside."
    },
    {
      "position": 4,
      "text": "Melt \u00bc cup margarine in a large skillet over medium-high heat; stir in \u00bc cup Worcestershire sauce. Thoroughly rub beef brisket with spice mixture; place brisket in skillet."
    },
    {
      "position": 5,
      "text": "Brown brisket on all sides, about 5 minutes per side. Add 1 \u00bd cups Worcestershire sauce to the skillet, \u00bd cup at a time, adding more as sauce cooks into brisket."
    },
    {
      "position": 6,
      "text": "Place a rack in a heavy Dutch oven; place brisket on the rack. Pour in Worcestershire sauce skillet drippings, beef broth, red wine, water, and garlic; top with mushroom mixture. Drizzle remaining 1 tablespoon Worcestershire sauce over mushrooms; top with remaining 2 tablespoons margarine. Cover the Dutch oven."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven for 3 hours. Reduce the oven temperature to 300 degrees F (150 degrees C); bake for 1 hour more. Reduce the oven temperature to 225 degrees F (105 degrees C); bake for 1 hour more. Baste with pan drippings every hour."
    },
    {
      "position": 8,
      "text": "Rest brisket before slicing thinly against the grain, about 20 minutes. Serve with pan gravy."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 315,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "expert",

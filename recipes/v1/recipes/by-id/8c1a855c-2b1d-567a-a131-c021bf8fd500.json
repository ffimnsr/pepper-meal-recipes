  "id": "8c1a855c-2b1d-567a-a131-c021bf8fd500",
  "slug": "red-currant-jelly",
  "name": "Red Currant Jelly",
  "recipe_type": "dessert",
  "brief_description": "Red currant jelly is a beautiful ruby-red condiment made with fresh summer red currants. Its sweet-tart flavor pairs perfectly with roast lamb and cheese.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Place red currants into a large pot and crush with a potato masher or berry crusher if you have one. Pour in 1 cup of water and bring to a boil. Simmer for 10 minutes. Strain the fruit through a jelly cloth or cheese cloth, and measure out 5 cups of the juice."
    },
    {
      "position": 2,
      "text": "Pour juice into a large saucepan and stir in sugar. Bring to a rapid boil over high heat, and stir in liquid pectin immediately. Return to a full rolling boil, and allow to boil for 30 seconds."
    },
    {
      "position": 3,
      "text": "Remove from heat and skim off foam from the top. Ladle or pour into sterile \u00bd-pint jars, filling to within \u00bd inch of the top. Wipe the rims with a clean damp cloth. Cover with new sterile lids and rings. Process covered in a bath of simmering water for 10 minutes."
    }
  ],
  "servings": 64,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

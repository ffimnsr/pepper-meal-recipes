  "id": "2f66c997-ef9d-52e7-b5f9-43730f61f774",
  "slug": "brown-sugar-pie-ii",
  "name": "Brown Sugar Pie II",
  "recipe_type": "dessert",
  "brief_description": "Like a pecan pie without the pecans! This is a classic recipe that makes a clear filling with a rich brown sugar flavor.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C.)"
    },
    {
      "position": 2,
      "text": "In a large bowl, combine brown sugar, white sugar, flour, eggs, milk and vanilla. Beat until smooth. Mix in the melted butter. Pour filling into pie crust."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 35 to 40 minutes, or until filling is set."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,

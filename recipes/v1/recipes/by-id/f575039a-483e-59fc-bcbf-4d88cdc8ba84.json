  "id": "f575039a-483e-59fc-bcbf-4d88cdc8ba84",
  "slug": "grandpa-mcandrews-irish-soda-bread",
  "name": "Grandpa McAndrew's Irish Soda Bread",
  "recipe_type": "main",
  "brief_description": "My mom bugged grandpa for this recipe but he told her he didn't have one. So, when he made the bread one day she captured each ingredient in a bowl and measured it and put it in the bowl he planned to mix it in!",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a cast iron skillet."
    },
    {
      "position": 2,
      "text": "In a medium bowl, mix together the flour, baking soda and sugar. Toss the raisins with the flour mixture until coated. Make a well in the center and add the egg, buttermilk, and melted margarine. Stir until all of the dry ingredients are absorbed. Turn the dough out onto a floured surface and knead for a few quick turns just to even out the dough. Handle the dough as little as possible. Pat into a flat circle, and place into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake the bread for 40 to 45 minutes in the preheated oven, or until the edges are golden."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

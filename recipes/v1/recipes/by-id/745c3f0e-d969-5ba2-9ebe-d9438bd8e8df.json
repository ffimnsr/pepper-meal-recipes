  "slug": "green-gazpacho",
  "name": "Green Gazpacho",
  "recipe_type": "appetizer",
  "brief_description": "Make and serve this cold, no-cook green gazpacho recipe featuring honeydew melon, cucumber, and avocado as a starter, or as part of a light meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine melon, cucumber, onion, avocado, vinegar, jalape\u00f1o, lime juice, garlic, salt, and black pepper in a blender; blend until smooth. Taste; adjust seasonings. Chill before serving."
    }
  ],
  "servings": 2,

  "id": "4f5b316a-fc1e-5d50-af9c-0436436ece83",
  "slug": "slow-cooker-overnight-ham-and-cheese-breakfast-casserole-recipe-7372845",
  "name": "Slow Cooker Overnight Ham and Cheese Breakfast Casserole",
  "recipe_type": "breakfast",
  "brief_description": "Wake up and have breakfast already ready to go for the whole family! Slow-cooked to perfection and filled with bell peppers, onions, and cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine eggs and Almond Breeze Unsweetened Original Almondmilk in a large bowl; whisk to combine. Season with salt and pepper."
    },
    {
      "position": 2,
      "text": "Generously spray a 6 qt slow cooker with cooking spray or use a slow cooker liner."
    },
    {
      "position": 3,
      "text": "Layer 1/2 of the frozen hash browns, 1/2 of the diced ham, 1/2 of the diced bell peppers, 1/2 of the green onions, and 1/2 of the shredded cheese into the slow cooker and season with salt and pepper as you go. Repeat layering with the second half of the ingredients. Pour egg mixture over the top."
    },
    {
      "position": 4,
      "text": "Cover slow cooker and cook on Low until eggs are set, 7 to 8 hours. Top with fresh chives if desired."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 480,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

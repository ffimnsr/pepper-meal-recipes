  "id": "399ec2cc-ff71-51cc-ae08-51e658e9a8fd",
  "slug": "air-fryer-baked-potatoes",
  "name": "Air Fryer Baked Potatoes",
  "recipe_type": "side",
  "brief_description": "A baked potato in the air fryer comes out beautifully crusty on the outside and fluffy on the inside. It's what a great baked spud should be, and so easy!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients and preheat an air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Brush potatoes with peanut oil, sprinkle with salt, and place them in the air fryer basket."
    },
    {
      "position": 3,
      "text": "Cook potatoes until very tender when pierced with a fork, about 1 hour. Serve and enjoy!"
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 5,

  "id": "a4b67282-d10e-5324-acc9-0988e58a0cba",
  "slug": "stir-fried-rice",
  "name": "Stir-Fried Rice",
  "recipe_type": "main",
  "brief_description": "This stir-fried rice recipe is made with frozen mixed vegetables and scrambled eggs flavored with soy sauce for a quick, low-calorie, low-fat dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet over medium heat. Cook beaten eggs in hot oil until set, stirring occasionally. Remove scrambled eggs to a plate; set aside."
    },
    {
      "position": 2,
      "text": "Add vegetables, broth, and soy sauce to the same skillet; bring to a boil. Stir in rice; cover. Remove from heat and let stand for 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir scrambled eggs into rice mixture. Serve hot."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

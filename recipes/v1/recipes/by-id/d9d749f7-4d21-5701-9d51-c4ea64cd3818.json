  "id": "d9d749f7-4d21-5701-9d51-c4ea64cd3818",
  "slug": "benne-wafers",
  "name": "Benne Wafers",
  "recipe_type": "dessert",
  "brief_description": "Since I live in the South people refer to these cookies as Benne Wafers, they are actually Sesame Seed Cookies. Toasting benne (sesame) seeds develops their flavor and also gives these cookies a slightly crunchy texture.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Place sesame seeds on an ungreased baking sheet and toast in the preheated oven for 10 to 12 minutes until light brown. Watch closely so that they don't burn."
    },
    {
      "position": 3,
      "text": "Mix together brown sugar, flour, toasted sesame seeds, melted butter, egg, vanilla, salt, and baking powder in a large bowl until combined."
    },
    {
      "position": 4,
      "text": "Drop dough by 1/2 teaspoonfuls, 1 1/2 inches apart, onto a lightly greased baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in batches in the preheated oven for 4 to 6 minutes, until light brown. Let cookies cool briefly before removing from baking sheets to a wire rack to cool completely."
    },
    {
      "position": 6,
      "text": "Repeat Steps 4 and 5 to bake remaining batches."
    }
  ],
  "servings": 72,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "68b9857a-bfcf-547f-8feb-ddd7b87979a3",
  "slug": "crawfish-chowder",
  "name": "Crawfish Chowder",
  "recipe_type": "soup",
  "brief_description": "A creamy chowder consisting of green onions, corn, crawfish, cream of potato and mushroom soups, and a bit of cayenne pepper for a little kick. Serve with cornbread, or some crusty French bread.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Melt 1/4 cup of butter in a large skillet over medium heat. Saute green onions in butter until tender. Remove from pan, and set aside. In the same skillet, melt 1/2 cup of butter, and saute the crawfish for 5 minutes; set aside."
    },
    {
      "position": 2,
      "text": "In a large pot over medium heat, combine potato soup, mushroom soup, corn, and cream cheese. Mix well, and bring to a slow boil. Stir in half-and-half, sauteed green onions, and crawfish. Season with cayenne pepper. Bring to a low boil, and simmer 5 minutes to blend flavors."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

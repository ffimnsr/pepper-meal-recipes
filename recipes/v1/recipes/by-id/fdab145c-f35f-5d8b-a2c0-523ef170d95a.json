  "id": "fdab145c-f35f-5d8b-a2c0-523ef170d95a",
  "slug": "lavosh",
  "name": "Lavosh",
  "recipe_type": "appetizer",
  "brief_description": "Good with soup, as an appetizer or as a snack. Lavosh is an Armenian unleavened flat bread.",
  "cuisine": "Armenian Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large bowl, stir together, flour, sugar and salt. Add water, 1 egg white and melted butter; mix well to make a stiff dough. Knead until dough is smooth, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Divide dough into 10 balls. Roll each ball on lightly floured surface until paper thin. Place on ungreased baking sheet. Brush with egg white and sprinkle with sesame seeds."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven for 10 to 12 minutes, until browned."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

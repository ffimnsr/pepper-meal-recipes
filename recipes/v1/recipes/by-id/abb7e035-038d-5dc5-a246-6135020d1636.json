  "id": "abb7e035-038d-5dc5-a246-6135020d1636",
  "slug": "georgia-peach-homemade-ice-cream",
  "name": "Homemade Peach Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "Homemade peach ice cream is easy to make with fresh juicy peaches, sugar, cream, and three types of milk for a superb summertime frozen treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Working in batches, pur\u00e9e peaches with half-and-half and sugar in a blender or food processor."
    },
    {
      "position": 3,
      "text": "Mix peach mixture, sweetened condensed milk, evaporated milk, and vanilla in a gallon ice cream freezer container. Pour enough whole milk into the container to reach the fill line, about 2 cups. Pour mixture into an ice cream maker."
    },
    {
      "position": 4,
      "text": "Freeze according to manufacturer's instructions, about 20 minutes. Transfer to an airtight container and freeze until firm, about 4 hours."
    }
  ],
  "servings": 32,

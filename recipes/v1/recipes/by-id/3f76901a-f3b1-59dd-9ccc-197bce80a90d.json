  "schema_version": 1,
  "id": "3f76901a-f3b1-59dd-9ccc-197bce80a90d",
  "slug": "baked-apple-empanadas",
  "name": "Baked Apple Empanadas",
  "recipe_type": "appetizer",
  "brief_description": "This baked apple empanadas recipe yields small empanadas filled with apples and cinnamon. The half-circle dough desserts are baked instead of fried.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat butter and cream cheese together in a bowl; stir in flour until dough comes together and forms a ball. Cover dough tightly with plastic wrap; refrigerate 8 hours to overnight."
    },
    {
      "position": 2,
      "text": "Combine apples, sugar, cinnamon, and salt in a saucepan; bring to a boil. Reduce heat, cover, and cook, stirring frequently, until the consistency of chunky applesauce, about 15 minutes. Remove from heat; cool to room temperature."
    },
    {
      "position": 3,
      "text": "Remove dough from the refrigerator; sit at room temperature for 30 minutes."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 5,
      "text": "Divide dough into 10 pieces; roll into balls. Roll out each ball with a rolling pin into a 3- to 4-inch circle. Fill one side of dough circle with apple filling. Moisten edges lightly with water; fold dough over filling and press edges together to seal."
    },
    {
      "position": 6,
      "text": "Arrange empanadas on the prepared baking sheet."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until dough is golden, about 15 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "ad2fd7f9-0e8a-5fbc-90e4-d5923263d5b8",
  "slug": "keto-crackers",
  "name": "Keto Crackers",
  "recipe_type": "appetizer",
  "brief_description": "These low-carb keto crackers are made with mozzarella cheese, almond flour, and egg yolk. The recipe makes about 40 crackers, depending on the size.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine mozzarella cheese, almond flour, garlic powder, and salt in a microwave-safe bowl. Heat in the microwave for 30 seconds."
    },
    {
      "position": 3,
      "text": "Use your hands to knead mozzarella dough until fully mixed. Add egg yolk and continue kneading until completely blended into dough."
    },
    {
      "position": 4,
      "text": "Lay a piece of parchment paper on a flat surface and place dough on top. Place a second piece of parchment paper on top of dough. Press down on dough with your hands until ready for a rolling pin."
    },
    {
      "position": 5,
      "text": "Roll into a very thin rectangle with even sides. Gently poke holes in dough using a fork to prevent it from bubbling while baking. Cut dough into 1-inch squares with a knife."
    },
    {
      "position": 6,
      "text": "Lay squares on the prepared baking sheet, leaving a little space between them"
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven for 5 to 6 minutes. Remove the baking sheet from the oven and turn crackers over. Continue baking until lightly browned and crisp, about 2 more minutes. Watch them closely to prevent burning."
    }
  ],
  "servings": 40,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "ebddb5ca-a91c-574d-a27e-5d43daa83d5d",
  "slug": "chocolate-peanut-butter-energy-balls",
  "name": "Chocolate Peanut Butter Energy Balls",
  "recipe_type": "appetizer",
  "brief_description": "These no-bake energy balls are made with oats, peanut butter, coconut, chocolate chips, and cranberries. They make an excellent pre-workout snack.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine oats, peanut butter, shredded coconut, chocolate chips, cranberries, almond milk, and honey in a bowl and mix thoroughly."
    },
    {
      "position": 2,
      "text": "Roll mixture into bite-size balls and arrange on a baking sheet. Refrigerate until set, at least 15 minutes."
    }
  ],

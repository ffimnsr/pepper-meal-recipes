  "id": "88d2d9e1-cf93-5816-8e22-f470aa1ac9a7",
  "slug": "slow-cooker-ham",
  "name": "Slow Cooker Ham",
  "recipe_type": "main",
  "brief_description": "This slow cooker ham is juicy, delicious, and perfect for holiday meals. A bone-in ham and brown sugar are all you need to make this easy recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Spread about 1 1/2 cups of brown sugar on the bottom of a slow cooker."
    },
    {
      "position": 3,
      "text": "Place ham on the brown sugar with the flat side facing down; you might have to trim it a little to make it fit."
    },
    {
      "position": 4,
      "text": "Use your hands to rub the remaining brown sugar onto the ham. Cover, and cook on Low for 8 hours."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 480,

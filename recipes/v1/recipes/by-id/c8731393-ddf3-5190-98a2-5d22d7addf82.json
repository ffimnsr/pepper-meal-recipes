  "id": "c8731393-ddf3-5190-98a2-5d22d7addf82",
  "slug": "bacon-potato-pancakes",
  "name": "Bacon Potato Pancakes",
  "recipe_type": "dessert",
  "brief_description": "This recipe for bacon potato pancakes is flavorful, crunchy, and loaded with smoky bacon, aromatic thyme, and garlic \u2014 great with any meal of the day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook bacon in a skillet over medium heat until crisp, 3 to 5 minutes. Transfer to a paper towel-lined plate to drain; cool, then crumble. Reserve bacon drippings in the skillet."
    },
    {
      "position": 2,
      "text": "Combine crumbled bacon, potatoes, eggs, flour, garlic, thyme, salt, and black pepper in a large bowl."
    },
    {
      "position": 3,
      "text": "Heat \u00bc-inch vegetable oil with drippings in the skillet over medium heat until oil and drippings shimmer."
    },
    {
      "position": 4,
      "text": "Drop potato mixture by heaping tablespoonfuls carefully into hot oil; flatten into patties about 3 inches in diameter. Cook until browned, about 3 minutes per side."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

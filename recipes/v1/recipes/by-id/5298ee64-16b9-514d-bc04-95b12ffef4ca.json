  "id": "5298ee64-16b9-514d-bc04-95b12ffef4ca",
  "slug": "mother-in-law-eggs",
  "name": "Mother-In-Law Eggs",
  "recipe_type": "appetizer",
  "brief_description": "Deviled eggs made with spicy hot mustard have a sweet and hot kick. A cut stuffed olive on top adds to the presentation.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place eggs into a medium saucepan in a single layer and fill with water to cover eggs by 1 inch. Cover the saucepan and bring to a boil over high heat. Remove from heat and let eggs stand in hot water for 15 minutes. Drain. Cool eggs under cold running water, then peel and halve eggs lengthwise. Scoop yolks into a large bowl; mash yolks with a fork."
    },
    {
      "position": 2,
      "text": "Stir mayonnaise, spicy brown mustard, hot mustard, sugar, salt, and pepper into mashed yolks until well combined. Spoon into a quart-size, resealable plastic bag. Snip a corner off the plastic bag."
    },
    {
      "position": 3,
      "text": "Squeeze yolk mixture into egg white halves. Sprinkle each stuffed egg with paprika and top with an olive half."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

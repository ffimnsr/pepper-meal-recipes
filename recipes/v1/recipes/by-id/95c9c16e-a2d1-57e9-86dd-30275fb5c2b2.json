  "id": "95c9c16e-a2d1-57e9-86dd-30275fb5c2b2",
  "slug": "raspberry-mousse",
  "name": "Raspberry Mousse",
  "recipe_type": "dessert",
  "brief_description": "This light and creamy raspberry mousse made with fresh, juicy raspberries is fun to serve in parfait glasses, but it's also a nice tart or cake filling.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Set a few raspberries aside for garnish. Combine remaining raspberries and confectioners' sugar in a bowl, mix, and set aside for 30 minutes. Pass raspberries through a sieve to strain out seeds. Discard seeds."
    },
    {
      "position": 2,
      "text": "Pour orange juice into a small saucepan and sprinkle gelatin on top. Set aside for 1 minute. Heat over low temperature without boiling until gelatin is fully dissolved, about 3 minutes."
    },
    {
      "position": 3,
      "text": "Remove from the stove, allow to cool slightly, then mix with raspberry pur\u00e9e."
    },
    {
      "position": 4,
      "text": "Beat cream in a chilled glass or metal bowl using an electric mixer until frothy. Add vanilla sugar gradually, continuing to beat until soft peaks form. Fold whipped cream into raspberry pur\u00e9e. Stir in lemon juice and sweeten with more confectioners' sugar if desired. Cover and refrigerate for 2 hours. Garnish with the reserved raspberries."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

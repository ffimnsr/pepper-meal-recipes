{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "08909871-94c7-5d7a-b26e-472eb08d1414",
  "slug": "strawberry-shortcake-dirty-soda-recipe-11989275",
  "name": "Strawberry Shortcake Dirty Soda",
  "recipe_type": "dessert",
  "brief_description": "Chef John's strawberry shortcake dirty soda captures all the nostalgic flavors of the classic dessert in a bubbly, creamy drink. Sweet homemade strawberry syrup, cream soda, and a splash of half-and-half come together for a refreshing treat that's finished with whipped cream and strawberries for the ultimate strawberry shortcake-inspired sip.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine strawberries and 1 cup sugar in a bowl and mix with a spoon. Cover and let sit on the counter for 1 hour, stirring occasionally."
    },
    {
      "position": 2,
      "text": "Add 1 cup of water to the macerated strawberries and stir everything together. Transfer into a saucepan and add the rest of the sugar. Bring to a simmer over medium-high heat, stirring occasionally. Once simmering, lower heat to medium-low. Simmer until strawberries are very soft, stirring occasionally, 20 to 25 minutes. After 10 minutes you can smash the strawberries with a potato masher which will produce a slightly thicker, \u201cfruitier\u201d syrup."
    },
    {
      "position": 3,
      "text": "Remove from heat and allow the pan to cool for 15 minutes before straining the strawberry mixture through a fine mesh strainer. 2 ways for straining: Method 1: place a strainer over a tall pot and let all the syrup drain through the strawberries, stirring occasionally, which will produce a clearer and thinner syrup. Method 2: Use the back of a spoon or ladle to squeeze the syrup through the strainer into a bowl, which will result in some of the strawberry being pushed through, creating a thicker syrup. Stir in vanilla extract, butter extract, almond extract, and a very small pinch of salt. Transfer into a smaller container, and store in the fridge until needed."
    },
    {
      "position": 4,
      "text": "To make each dirty soda, fill a glass with ice, and pour in 2 ounces of cream soda. Fill the glass the rest of the way with strawberry sparkling water, or strawberry soda if you want something sweeter, leaving a half inch unfilled at the top. Pour in 3 to 4 tablespoons strawberry syrup, and stir everything with a spoon for a few seconds. Top of with a splash of half and half. Garnish with a dollop of whipped cream and sprinkle with chopped dehydrated strawberries or chopped fresh strawberries."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

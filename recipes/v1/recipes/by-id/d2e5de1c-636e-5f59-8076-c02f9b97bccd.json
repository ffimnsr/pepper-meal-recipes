  "slug": "revolver-cocktails-recipe-8741080",
  "name": "Revolver Cocktails",
  "recipe_type": "drink",
  "brief_description": "Coffee liqueur replaces the usual vermouth in this variation on a Manhattan. Orange bitters and a citrus twist bring out the coffee\u2019s fruity flavor notes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a mixing glass or cocktail shaker half full with ice. Add bourbon, liqueur, and bitters. Stir or shake until very cold, about 30 seconds."
    },
    {
      "position": 2,
      "text": "Strain into 2 glasses. Rub rim of each glass with an orange twist, then garnish each glass with a twist."
    }
  ],
  "servings": 2,

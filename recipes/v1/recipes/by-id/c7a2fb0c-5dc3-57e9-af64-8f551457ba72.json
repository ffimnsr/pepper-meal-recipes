  "id": "c7a2fb0c-5dc3-57e9-af64-8f551457ba72",
  "slug": "air-fryer-pesto-chicken-quinoa-bowl-recipe-11691482",
  "name": "Air Fryer Pesto Chicken Quinoa Bowl",
  "recipe_type": "main",
  "brief_description": "This air fryer pesto chicken quinoa bowl is a hearty dinner, with air fried, seasoned chicken and zucchini spears atop fluffy, whole-grain quinoa with fresh tomatoes and crumbled feta.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together pesto and garlic powder in a bowl. Add chicken to bowl and stir until evenly coated."
    },
    {
      "position": 2,
      "text": "In a separate bowl mix together olive oil, pepper flakes, salt, and black pepper. Add zucchini to the bowl and stir until evenly coated."
    },
    {
      "position": 3,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 4,
      "text": "Lightly spray air fryer with nonstick spray. Place chicken on one side, and place seasoned zucchini on the other side."
    },
    {
      "position": 5,
      "text": "Fry in the preheated air fryer until an instant-read thermometer inserted into the center of chicken reads 165 degrees F (74 degrees C), about 10 minutes."
    },
    {
      "position": 6,
      "text": "Mix cooked quinoa and chopped basil leaves together."
    },
    {
      "position": 7,
      "text": "In a bowl place 1 cup quinoa, ½ cup chopped tomatoes, half the chicken breasts, and half the zucchini spears. Top each bowl with half the feta cheese and serve."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "25eda99b-8a3e-503e-90ea-2e707bc9f32f",
  "slug": "steak-and-irish-stout-pie",
  "name": "Steak and Irish Stout Pie",
  "recipe_type": "main",
  "brief_description": "This savory steak and stout pie is filled with a decadent Irish stout gravy, loaded with tender pieces of steak, and baked between two flaky pie crusts.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Place steak cubes onto a plate and sprinkle with flour."
    },
    {
      "position": 2,
      "text": "Cook lard and bacon in a large skillet over medium heat until lard melts and bacon begins to sizzle. Add floured steak and cook, stirring frequently, until steak and bacon are browned, 10 to 15 minutes. Transfer to a large casserole dish."
    },
    {
      "position": 3,
      "text": "Add onions and mushrooms to the same skillet; cook and stir over medium heat until onions are lightly browned and mushrooms are tender, about 10 minutes. Transfer to the casserole dish."
    },
    {
      "position": 4,
      "text": "Stir stout beer, parsley, raisins, and brown sugar into the casserole dish. Cover the dish tightly with aluminum foil."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven, stirring occasionally, until gravy has thickened and steak is tender, about 2 1/2 hours. Remove from the oven and increase the temperature to 400 degrees F (200 degrees C)."
    },
    {
      "position": 6,
      "text": "Line a 9-inch deep-dish pie plate with one pie pastry. Bake in the preheated oven until crust is partially cooked and lightly browned, about 10 minutes."
    },
    {
      "position": 7,
      "text": "Spoon cooked steak filling into the partially-baked pie crust. Cover steak filling with the remaining pie pastry, pinching the edges to seal tightly. Return to the oven and bake until top crust is golden brown, 10 to 15 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 195,
  "preparation_time_minutes": 30,

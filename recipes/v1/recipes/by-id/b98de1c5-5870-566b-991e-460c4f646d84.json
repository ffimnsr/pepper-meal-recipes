  "id": "b98de1c5-5870-566b-991e-460c4f646d84",
  "slug": "microwave-mashed-potatoes",
  "name": "Microwave Mashed Potatoes",
  "recipe_type": "side",
  "brief_description": "Mashed potatoes simply cooked in the microwave made with fresh potatoes. Top with your choice of gravy and chives if desired.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place cubed potatoes in a microwave safe dish. Cover with water."
    },
    {
      "position": 2,
      "text": "Microwave until soft on high, about 20 minutes. Drain in a colander."
    },
    {
      "position": 3,
      "text": "Place drained potatoes back in the dish. Add butter and milk. Using a potato masher, smash mixture to desired consistency. Season with salt and pepper to taste."
    }
  ],
  "servings": 4,

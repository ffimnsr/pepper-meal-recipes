  "slug": "shirazi-salad-recipe-8661733",
  "name": "Shirazi Salad",
  "recipe_type": "salad",
  "brief_description": "Shirazi salad, known for its fine, uniform dice, is made with tomato, cucumber, fresh herbs, and a sour grape juice-based dressing.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together tomatoes, cucumbers, red onion, parsley, mint, ab ghooreh, oil, salt, and pepper in a large serving bowl. Season to taste. Garnish with parsley and serve immediately with lemon wedges."
    }
  ],
  "servings": 6,

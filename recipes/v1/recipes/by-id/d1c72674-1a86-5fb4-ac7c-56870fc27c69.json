  "schema_version": 1,
  "id": "d1c72674-1a86-5fb4-ac7c-56870fc27c69",
  "slug": "chicken-cordon-bleu-lasagna",
  "name": "Chicken Cordon Bleu Lasagna",
  "recipe_type": "main",
  "brief_description": "This lasagna recipe, made with Swiss cheese, cooked chicken, and deli ham, has all the flavors of chicken Cordon Blue without too much finicky prep.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook lasagna noodles in the boiling water, stirring occasionally until tender yet firm to the bite, about 8 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Melt butter in a saucepan over medium heat; stir in cream cheese until it begins to melt, about 5 minutes. Season with salt, onion powder, and black pepper. Gradually whisk warm milk into cream cheese until smooth; stir in 1 \u00bd cups Swiss cheese. Bring sauce to a simmer, stirring constantly, until cheese has melted and sauce has thickened, 5 to 10 minutes. Remove from heat."
    },
    {
      "position": 4,
      "text": "Spread \u00be cup cheese sauce into the bottom of a 9x9-inch baking dish. Arrange \u2153 lasagna noodles over sauce; spread \u00bd cooked chicken and \u00bd ham over noodles. Pour 1 cup sauce over top. Repeat layers starting with \u00bd remaining lasagna noodles, remaining \u00bd chicken, remaining \u00bd ham, and 1 cup cheese sauce. Layer on remaining lasagna noodles, remaining sauce, remaining \u00bd cup Swiss cheese, and bread crumbs; sprinkle top with Italian seasoning. Cover dish with aluminum foil."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until bubbling, about 25 minutes. Remove foil; continue baking until bread crumbs are browned, about 10 minutes more. Let casserole stand before serving, 5 to 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "efed72aa-8419-59d9-a677-7dba1bd20d60",
  "slug": "spinach-brownies",
  "name": "Spinach Brownies",
  "recipe_type": "appetizer",
  "brief_description": "Spinach and mozzarella cheese are baked together to make irresistible savory appetizer treats.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Lightly grease a 9x13 inch baking dish."
    },
    {
      "position": 2,
      "text": "Place spinach in a medium saucepan with enough water to cover. Bring to a boil. Lower heat to simmer and cook until spinach is limp, about 3 minutes. Remove from heat, drain, and set aside."
    },
    {
      "position": 3,
      "text": "In a large bowl, mix flour, salt and baking powder. Stir in eggs, milk and butter. Mix in spinach, onion and mozzarella cheese."
    },
    {
      "position": 4,
      "text": "Transfer the mixture to the prepared baking dish. Bake in the preheated oven 30 to 35 minutes, or until a toothpick inserted in the center comes out clean. Cool before serving."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

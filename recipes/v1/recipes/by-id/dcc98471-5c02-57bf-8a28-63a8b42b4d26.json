  "slug": "french-onion-soup-slow-cooker",
  "name": "French Onion Soup (Slow Cooker)",
  "recipe_type": "soup",
  "brief_description": "You can make French onion soup in a slow cooker thanks to this recipe.",
  "cuisine": "French Inspired American French",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a skillet over medium heat. Cook and stir onions in melted butter until clear and browned, 10 to 15 minutes; transfer to a slow cooker. Add beef broth, garlic, salt, and black pepper to the slow cooker."
    },
    {
      "position": 2,
      "text": "Cook on High for 4 hours or on Low for 8 hours."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 250,

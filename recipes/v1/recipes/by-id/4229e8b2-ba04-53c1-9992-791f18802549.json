  "id": "4229e8b2-ba04-53c1-9992-791f18802549",
  "slug": "no-bake-sugar-free-cheese-cake",
  "name": "No Bake Sugar Free Cheese Cake",
  "recipe_type": "dessert",
  "brief_description": "Finally a cheesecake that is easy to make, low in fat and even has no added sugar. Serve with a lemon sorbet.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). In a medium bowl, combine graham cracker crumbs, butter and cinnamon. Mix well and press into the bottom of a 9 inch square pan. Bake in preheated oven for 8 to 10 minutes. Remove from oven and allow to cool."
    },
    {
      "position": 2,
      "text": "Dissolve lemon gelatin in boiling water. Let cool until thickened, but not set. In a large bowl, beat cream cheese and vanilla until smooth. Blend in lemon gelatin. Fold in whipped topping."
    },
    {
      "position": 3,
      "text": "Pour filling into crust. Sprinkle top with graham cracker crumbs. Refrigerate over night."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

  "id": "eacc2fe4-f8b4-546f-8882-5a0931350123",
  "slug": "instant-pot-simple-steamed-crab-legs",
  "name": "Instant Pot Simple Steamed Crab Legs",
  "recipe_type": "main",
  "brief_description": "Learn how long to steam crab legs with this easy and delicious recipe made with 4 simple ingredients in an Instant Pot that's ready in 20 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place a trivet in a multi-functional pressure cooker (such as Instant Pot) and add water. Place crab legs on top of the trivet; you may need to let them thaw for a few minutes so they will fit."
    },
    {
      "position": 3,
      "text": "Close and lock the lid. Select high pressure according to manufacturer's instructions; set the timer for 3 minutes. Allow 10 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid."
    },
    {
      "position": 5,
      "text": "Use tongs to transfer crab legs to a serving dish."
    },
    {
      "position": 6,
      "text": "Squeeze lemon juice on top and serve with melted butter."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

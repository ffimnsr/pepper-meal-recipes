  "id": "1669da91-68c8-5a3e-9d3d-afb82c0bab4d",
  "slug": "brown-sugar-candy",
  "name": "Brown Sugar Candy",
  "recipe_type": "dessert",
  "brief_description": "This sugar candy recipe is from my mother. This is only one of the many candy recipes she makes at Christmas and gives away to friends.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Butter an 8- or 9-inch square baking dish."
    },
    {
      "position": 2,
      "text": "Stir together brown sugar and evaporated milk in a large, heavy saucepan. Bring to a boil over medium-high heat. Cook until temperature reaches between 234 and 240 degrees F (112 to 116 degrees C) or until a small amount of syrup dropped into cold water forms a soft ball that flattens when removed from the water and placed on a flat surface."
    },
    {
      "position": 3,
      "text": "Remove from heat and stir in walnuts, butter, and vanilla. Continue to beat with a sturdy spoon until mixture loses its gloss. Pour into the prepared pan. Score into squares with a knife, then set aside until firm, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Cut into squares. Store in an airtight container in the refrigerator."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "a72fe2f6-b47a-520a-9f7a-e799db4fc138",
  "slug": "american-apple-pie",
  "name": "American Apple Pie",
  "recipe_type": "dessert",
  "brief_description": "This American apple pie recipe is a classic, with a mix of brown and white sugar and raisins folded in. Dot the apples with butter for extra richness.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Spray a deep dish pie plate with cooking spray"
    },
    {
      "position": 2,
      "text": "Mix brown sugar, white sugar, flour, lemon, and cinnamon together in a large bowl. Fold in apples and raisins until coated."
    },
    {
      "position": 3,
      "text": "Spoon mixture into crust. Top with second pie crust; trim edges. Brush with egg; sprinkle with white sugar."
    },
    {
      "position": 4,
      "text": "Bake until golden, 35 to 40 minutes. Place on a wire rack to cool, 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,

  "id": "fbd01d6c-21e2-53ca-b76d-18cf1f8c1498",
  "slug": "buffalo-chicken-calzones-recipe-11769875",
  "name": "Buffalo Chicken Calzones",
  "recipe_type": "soup",
  "brief_description": "These buffalo chicken calzones are filled with rotisserie chicken, canned condensed cream of onion soup, and buffalo sauce—perfect for busy weeknights. Serve these cheesy, spicy calzones with blue cheese or ranch dressing and celery or carrot sticks.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a large rimmed baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Stir together chicken, cheese, frozen vegetables, condensed soup, hot sauce, and green onion for the filling in a bowl."
    },
    {
      "position": 3,
      "text": "Whisk together egg and water in a small bowl for the egg wash."
    },
    {
      "position": 4,
      "text": "On a lightly floured surface, roll each pie crust into a 12-inch circle. Spread half of the filling over half of one of the pie crusts, leaving a 1-inch border. Brush edges with egg wash. Fold dough over filling and crimp edges using fork tines. Carefully transfer to the prepared baking sheet. Repeat with remaining crust and filling."
    },
    {
      "position": 5,
      "text": "Brush tops of calzones with egg wash; cut 3 (1/2-inch-long) slits on top of each to vent."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until slightly puffed and golden brown, 20 to 25 minutes. Cool on a wire rack for 5 minutes before serving."
    },
    {
      "position": 7,
      "text": "Serve with blue cheese dressing, celery, and/or carrots. Garnish with celery leaves."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

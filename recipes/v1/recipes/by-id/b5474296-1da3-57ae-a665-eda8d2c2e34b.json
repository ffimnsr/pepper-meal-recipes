  "id": "b5474296-1da3-57ae-a665-eda8d2c2e34b",
  "slug": "haluski-cabbage-and-noodles",
  "name": "Haluski - Cabbage and Noodles",
  "recipe_type": "side",
  "brief_description": "This haluski recipe is a quick and simple comforting side dish of buttery fried cabbage and onions with noodles, baked and ready in less than 1 hour.",
  "cuisine": "Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 2,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Stir in egg noodles and return to a boil."
    },
    {
      "position": 3,
      "text": "Cook noodles uncovered, stirring occasionally, until tender but slightly firm, about 5 minutes. Drain well and set aside."
    },
    {
      "position": 4,
      "text": "Melt 1/2 cup butter in a large skillet over medium-low heat. Add onions; cook and stir until translucent, 5 to 10 minutes."
    },
    {
      "position": 5,
      "text": "Add cabbage and remaining 1/2 cup butter to onions; cook and stir until cabbage is softened but not browned, 5 to 8 minutes. Season with salt and black pepper."
    },
    {
      "position": 6,
      "text": "Place cooked noodles and cabbage mixture in a large roasting pan; stir gently to combine. Sprinkle with more salt and black pepper, if desired."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until golden brown on top, 30 to 40 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "3bfc3d3c-a178-596f-9648-4ca2bb2bd3d2",
  "slug": "duck-fried-rice",
  "name": "Duck Fried Rice",
  "recipe_type": "main",
  "brief_description": "This duck fried rice is easy to make with takeout Chinese roast duck, cooked rice, green onions, and soy sauce for a delicious meal using leftovers.",
  "cuisine": "Asian Inspired Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Cook duck skin and fat in a wok or large skillet over medium heat until skin is crispy and fat has rendered, about 10 minutes. Increase the heat to medium-high and stir in duck meat, pork, 1/2 of the green onions, and soy sauce. Cook and stir until meats are heated through, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Add rice and toss together until rice is hot and sizzling, about 5 minutes. Make a wide well in the middle of rice, exposing the bottom of the pan. Pour in beaten eggs and stir until scrambled. Stir scrambled eggs into rice along with remaining green onions. Toss and stir until rice is very hot, about 5 minutes. Season to taste with salt and pepper before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

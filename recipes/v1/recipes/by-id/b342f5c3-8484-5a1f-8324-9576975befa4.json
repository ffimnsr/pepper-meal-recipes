{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "b342f5c3-8484-5a1f-8324-9576975befa4",
  "slug": "steak-alfredo",
  "name": "Steak Alfredo",
  "recipe_type": "main",
  "brief_description": "This steak Alfredo recipe is a uniquely rich tweak on standard fettuccine Alfredo. It includes marinated and grilled flat iron steak, herbs, and spinach.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat milk and cream in a saucepan over medium heat until simmering, about 5 minutes. Slowly whisk in Parmesan and Romano cheeses. Remove from heat."
    },
    {
      "position": 2,
      "text": "Whisk egg yolks together in a heat-proof bowl; slowly whisk in about \u00bc cup hot cream mixture to temper eggs. Slowly whisk egg yolk mixture into the cream mixture in the saucepan; season with salt and black pepper. Cool Alfredo sauce; refrigerate until needed."
    },
    {
      "position": 3,
      "text": "Whisk salad dressing, rosemary, and lemon juice together in a large glass or ceramic bowl. Add steak and toss to evenly coat. Cover the bowl with plastic wrap and marinate in the refrigerator for 4 hours."
    },
    {
      "position": 4,
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate."
    },
    {
      "position": 5,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Cook fettuccine at a boil until tender yet firm to the bite, about 8 minutes. Drain."
    },
    {
      "position": 6,
      "text": "Heat 2 cups refrigerated Alfredo sauce in a saucepan over medium heat. Add spinach and 2 tablespoons Gorgonzola cheese."
    },
    {
      "position": 7,
      "text": "Remove steak from marinade; shake off excess. Discard remaining marinade. Cook on the preheated grill to desired doneness, 5 to 10 minutes."
    },
    {
      "position": 8,
      "text": "Pour hot Alfredo sauce into a large serving bowl. Add fettuccine; toss to combine. Sprinkle remaining 2 tablespoons Gorgonzola cheese on top. Add grilled steak; drizzle with balsamic glaze and garnish with parsley."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 60,
  "rest_time_minutes": null,

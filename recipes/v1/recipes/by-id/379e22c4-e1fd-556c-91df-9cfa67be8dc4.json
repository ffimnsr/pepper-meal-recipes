  "id": "379e22c4-e1fd-556c-91df-9cfa67be8dc4",
  "slug": "fast-and-easy-turkey-pot-pie",
  "name": "Fast and Easy Turkey Pot Pie",
  "recipe_type": "soup",
  "brief_description": "An easy turkey pot pie recipe is just the ticket after turkey day! Leftover turkey, frozen veggies, condensed soup, and Cheddar in a comfort food classic.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line an 8-inch pie dish with one of the pastry crusts; set the other crust aside."
    },
    {
      "position": 2,
      "text": "Combine turkey, mixed vegetables, condensed soup, Cheddar cheese, seasoned salt, and seasoned pepper in a bowl; mix until well combined. Pour mixture into the bottom crust."
    },
    {
      "position": 3,
      "text": "Place the second pie crust over the filling; pinch and fold the edges of both crusts together to seal. Use a sharp knife to cut one or two slits in the top pie crust to allow the steam to vent as the pie cooks."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the crust is golden brown and the filling is bubbling, about 40 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

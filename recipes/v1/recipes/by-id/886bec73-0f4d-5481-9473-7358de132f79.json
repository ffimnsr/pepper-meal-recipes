{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "886bec73-0f4d-5481-9473-7358de132f79",
  "slug": "chef-johns-chicken-meatballs",
  "name": "Chef John's Chicken Meatballs",
  "recipe_type": "main",
  "brief_description": "Try these wonderfully tender and moist chicken meatballs served up in tomato sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix chicken and pork together on a plate or tray, and place in the freezer for about 15 minutes, or until firm and very cold. Partially frozen is okay."
    },
    {
      "position": 2,
      "text": "Add breadcrumbs to the bowl of a food processor (this should be crumbled from the inside of a loaf of fresh or day old French bread \u2013 no crust!). Add sauteed onions, egg, white wine, garlic, parsley, salt, pepper, chili flakes, and crushed fennel seeds. Add chilled chicken mixture on top."
    },
    {
      "position": 3,
      "text": "Pulse on and off in the food processor as shown until the mixture resembles ground meat. Stopping occasionally and scraping the bowl of food processor during the process is recommended."
    },
    {
      "position": 4,
      "text": "Transfer mixture to fridge and chill for 1 hour before shaping."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with foil and lightly grease with olive oil."
    },
    {
      "position": 6,
      "text": "Divide mixture into 12 portions, and place on the prepared baking sheet. Use damp hands to roll into smooth balls."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until meatballs are cooked through, about 18 minutes. For some additional browning, turn broiler to high, and broil meatballs for 1 to 2 minutes."
    },
    {
      "position": 8,
      "text": "Meatballs can be served immediately, or transferred into tomato sauce set over low heat. Simmer gently for about 20 minutes to flavor sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 40,

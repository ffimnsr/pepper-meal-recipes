  "id": "9abaf78c-92c3-58c5-80e4-0ef1c05f9d8c",
  "slug": "creamy-green-curry-chicken-ramen",
  "name": "Creamy Green Curry Chicken Ramen",
  "recipe_type": "soup",
  "brief_description": "Ramen noodles have never tasted this good with the additions of creamy coconut milk, Thai curry paste, ginger, chiles, chicken, and vegetables.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large pot over medium heat. Add jalape\u00f1o, garlic, ginger, and lime zest; cook and stir for 1 minute. Add shredded chicken and stir until well blended, about 30 more seconds."
    },
    {
      "position": 2,
      "text": "Add coconut milk, chicken stock, curry paste, soy sauce, fish sauce, brown sugar, and basil; stir well. Bring to a simmer, stirring occasionally."
    },
    {
      "position": 3,
      "text": "Add ramen noodles, snow peas, and bell pepper; cook until noodles are al dente and the vegetables are crisp-tender, 3 to 5 minutes."
    },
    {
      "position": 4,
      "text": "Serve hot garnished with cilantro."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "052e8730-7c7e-5d1c-a9cf-1bf9d982bc82",
  "slug": "cinnamon-heart-popcorn",
  "name": "Cinnamon Heart Popcorn",
  "recipe_type": "appetizer",
  "brief_description": "Pink cinnamon-flavored popcorn is made with the little hot cinnamon heart candies for a fantastic sweet and pretty treat on Valentine's Day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Line baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine cinnamon candies, butter, and corn syrup in a medium pot over medium heat. Bring to a boil and cook for 5 minutes."
    },
    {
      "position": 3,
      "text": "Pour hot syrup over popcorn in a large, heatproof bowl; stir to cover popcorn as evenly as possible. Spread popcorn out onto the prepared baking sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until candy coating is set, about 30 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "0d183e87-6474-51b9-81c8-3ea278a69f93",
  "slug": "quince-apple-sauce",
  "name": "Quince-Apple Sauce",
  "recipe_type": "dessert",
  "brief_description": "Quinces turn wonderfully sweet when cooked in this five-ingredient quince-apple sauce recipe with fresh quinces, fresh apples, lemon, sugar, and water.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Inspect two 16-ounce jars for cracks and rings for rust, discarding any defective ones. Immerse in simmering water until applesauce is ready. Wash new, unused lids and rings in warm soapy water."
    },
    {
      "position": 2,
      "text": "Combine water, quinces, and lemon juice in a pot over medium heat; bring to a boil. Reduce heat; simmer until softened, 8 to 10 minutes. Add apples and sugar; simmer until quinces and apples are very soft, 10 to 15 minutes."
    },
    {
      "position": 3,
      "text": "Strain apple-quince mixture through a fine-mesh sieve. Return apple-quince solids to the same pot; heat until hot, stirring constantly."
    },
    {
      "position": 4,
      "text": "Pack quince-apple sauce into hot, sterilized jars, filling to within 1/4 inch of the top. Run a clean knife or thin spatula around the insides of the jars to remove any air bubbles. Wipe rims with a moist paper towel to remove any spills. Top with lids and screw rings on tightly."
    },
    {
      "position": 5,
      "text": "Place a rack in the bottom of a large stockpot and fill halfway with water. Bring to a boil and lower jars 2 inches apart into the boiling water using a holder. Pour in more boiling water to cover jars by at least 1 inch. Bring to a rolling boil, cover, and process for 5 minutes."
    },
    {
      "position": 6,
      "text": "Remove the jars from the stockpot and let rest, several inches apart, for 12 to 24 hours. Press the center of each lid with a finger to ensure the lid does not move up or down. Remove the rings for storage and store in a cool, dark area."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

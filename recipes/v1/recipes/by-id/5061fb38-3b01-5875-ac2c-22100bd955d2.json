  "id": "5061fb38-3b01-5875-ac2c-22100bd955d2",
  "slug": "light-and-easy-greek-potato-salad",
  "name": "Light and Easy Greek Potato Salad",
  "recipe_type": "salad",
  "brief_description": "This Greek potato salad is a deliciously light potato salad with a tangy lemon vinaigrette made with olive oil, red wine vinegar, and fresh herbs.",
  "cuisine": "Greek Inspired Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Place red potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 25 minutes. Drain and chill in freezer until cold, about 30 minutes."
    },
    {
      "position": 2,
      "text": "Slice potatoes into chunks and place in a large salad bowl; toss potatoes with green onion."
    },
    {
      "position": 3,
      "text": "Whisk olive oil, red wine vinegar, lemon juice, garlic powder, onion powder, salt, black pepper, oregano, sugar, rosemary, and red pepper in a bowl. Pour dressing over potatoes and toss to caot. Serve immediately or chill until serving time."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

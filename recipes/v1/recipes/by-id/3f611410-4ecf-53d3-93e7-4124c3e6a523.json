  "id": "3f611410-4ecf-53d3-93e7-4124c3e6a523",
  "slug": "maryland-crab-cakes-i",
  "name": "Maryland Crab Cakes",
  "recipe_type": "appetizer",
  "brief_description": "These Maryland crab cakes are the real deal, made with fresh lump crab meat, Old Bay seasoning, and white bread for a true Chesapeake Bay staple.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Place crab meat in a large bowl and remove any remaining shell pieces."
    },
    {
      "position": 2,
      "text": "Break bread into small pieces and add to crab meat. Add beaten egg, Old Bay seasoning, mayonnaise, mustard, and Worcestershire sauce to the bowl. Mix by hand to avoid overworking crab meat; you want to keep the lumps of meat as much as possible. Form into 6 patties."
    },
    {
      "position": 3,
      "text": "Heat butter in a skillet over medium heat."
    },
    {
      "position": 4,
      "text": "Fry patties in hot butter until golden brown, about 4 minutes per side."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

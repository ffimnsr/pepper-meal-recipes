  "schema_version": 1,
  "id": "47756ca4-e918-5dc5-9709-3ff183cfa996",
  "slug": "lazy-mans-pierogi",
  "name": "Lazy Man's Pierogi",
  "recipe_type": "soup",
  "brief_description": "An easy substitute for the Polish dish pierogi. Spiral twist pasta and bacon are combined with onions, mushrooms and cream of mushroom soup.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Stir in rotelle and return to a boil. Cook rotelle uncovered, stirring occasionally, until tender yet firm to the bite, 8 to 10 minutes; drain."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Cook bacon in a large, deep skillet over medium-high heat until evenly browned; transfer to a paper-towel-lined plate. Stir onions into skillet; cook until translucent."
    },
    {
      "position": 4,
      "text": "Melt butter in a separate pan. Add mushrooms; saut\u00e9."
    },
    {
      "position": 5,
      "text": "Combine rotelle, bacon, onions, mushrooms, soup, and sauerkraut; season with salt and pepper. Pour into a 9x13-inch baking dish."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

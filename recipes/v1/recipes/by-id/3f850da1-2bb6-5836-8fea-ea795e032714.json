  "id": "3f850da1-2bb6-5836-8fea-ea795e032714",
  "slug": "wonton-crab-grilled-cheese-recipe-11771768",
  "name": "Wonton Crab Grilled Cheese",
  "recipe_type": "side",
  "brief_description": "This wonton crab grilled cheese takes the American Chinese restaurant favorite, crab Rangoon, and fuses it with grilled cheese. It's extra crispy with the bread toasted inside and out.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cream cheese, crab meat, green onions, soy sauce, sesame oil, and garlic powder in a bowl. Mix until well combined. Set aside."
    },
    {
      "position": 2,
      "text": "Spread mayonnaise on 1 side of each bread slice. Place a large skillet over medium heat, and toast bread, mayonnaise side down, until golden brown. Set aside."
    },
    {
      "position": 3,
      "text": "Spread crab mixture on toasted side of 4 slices of bread, drizzle with sweet chili sauce, and place the other 4 bread slices, toasted side down, on top."
    },
    {
      "position": 4,
      "text": "Spread mayonnaise on untoasted sides of bread, place back into the skillet over medium heat, and toast, turning once, until both sides are golden brown. Serve immediately with extra chili sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

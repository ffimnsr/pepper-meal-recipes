  "id": "44d5f1fe-4e28-56f4-b9d4-62363adef041",
  "slug": "easy-cottage-cheese-wrap-recipe-11697300",
  "name": "Easy Cottage Cheese Wrap",
  "recipe_type": "breakfast",
  "brief_description": "This easy cottage cheese wrap is a keto-style flatbread, sprinkled with everything seasoning, a perfect base for a high-protein breakfast wrap. The batter is whipped up in a blender, then poured on a baking sheet and baked.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 380 degrees F (193 degrees C). Line a rimmed baking sheet with parchment and spray with nonstick spray."
    },
    {
      "position": 2,
      "text": "Add eggs and cottage cheese to the jar of a blender; blend on high until smooth, about 30 seconds. Pour mixture onto the prepared pan in a roughly rectangular shape. Sprinkle bagel seasoning over mixture."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 20 minutes. Remove immediately. Allow to cool about 5 minutes before removing wrap from parchment."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

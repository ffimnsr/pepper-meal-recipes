  "id": "69baff22-4cd4-5c4b-a96c-a9f2d6cf7a42",
  "slug": "creamy-lemon-zucchini-pasta-recipe-11740513",
  "name": "Creamy Lemon Zucchini Pasta",
  "recipe_type": "main",
  "brief_description": "In this creamy lemon zucchini pasta, linguine are topped with sauteed shredded zucchini in a lemony alfredo sauce. A delicious summer dish.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook linguine at a boil until tender yet firm to the bite, about 11 minutes. Drain, reserving 1/2 cup of the pasta water."
    },
    {
      "position": 3,
      "text": "Meanwhile, place shredded zucchini on a clean kitchen towel and squeeze out as much liquid as possible."
    },
    {
      "position": 4,
      "text": "Heat 1 tablespoon butter and oil in a large skillet over medium. Add zucchini and cook, stirring occasionally, until zucchini begins to brown, about 15 minutes. Transfer zucchini to a bowl. Wipe skillet clean with a paper towel."
    },
    {
      "position": 5,
      "text": "Melt remaining 2 tablespoon butter in the skillet over medium-high heat. Add garlic and cook 30 seconds. Sprinkle in flour and cook, stirring constantly, 1 minute."
    },
    {
      "position": 6,
      "text": "Whisk in wine, 1 teaspoon lemon zest, and lemon juice. Cook, whisking constantly, for 1 minute. Whisk in cream and cook, stirring constantly, until mixture is thickened and bubbly, 2 to 3 minutes."
    },
    {
      "position": 7,
      "text": "Remove from heat and stir in Parmesan cheese. Season sauce with salt and pepper."
    },
    {
      "position": 8,
      "text": "Add drained pasta and cooked zucchini to the skillet and toss until coated, adding reserved pasta water as needed to reach desired consistency. Heat through. Sprinkle with additional Parmesan cheese and remaining 1 teaspoon lemon zest; serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "45616cc9-1f39-58c5-ae88-b18ff1ec53d7",
  "slug": "carrot-cake",
  "name": "Old-Fashioned Carrot Cake",
  "recipe_type": "dessert",
  "brief_description": "This old-fashioned carrot cake with cream cheese icing is made with buttermilk, coconut, pineapple, and walnuts for a moist, cinnamon-spiced treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish; set aside."
    },
    {
      "position": 2,
      "text": "Mix together sugar, oil, buttermilk, eggs, and 1 teaspoon vanilla in a large bowl until well combined. Stir in carrots, pineapple, and coconut. Combine flour, baking soda, cinnamon, and salt in a medium bowl; gently stir into carrot mixture. Mix in nuts until incorporated. Spread batter into the prepared dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into cake comes out clean, about 55 minutes. Remove from the oven and set aside to cool."
    },
    {
      "position": 4,
      "text": "Beat together confectioners' sugar, cream cheese, butter, and remaining 1 teaspoon vanilla in a large bowl with an electric mixer until creamy. Frost cooled cake while still in the dish."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 30,

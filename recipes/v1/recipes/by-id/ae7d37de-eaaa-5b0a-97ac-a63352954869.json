  "id": "ae7d37de-eaaa-5b0a-97ac-a63352954869",
  "slug": "cheese-lasagna",
  "name": "Cheese Lasagna",
  "recipe_type": "main",
  "brief_description": "This cheese lasagna recipe is an easy vegetarian lasagna with 3 types of Italian cheese: ricotta, mozzarella, and Parmesan. Simple and delicious!",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Add lasagna noodles and cook for 8 to 10 minutes or until al dente; drain and lay noodles flat on foil to cool."
    },
    {
      "position": 3,
      "text": "Mix ricotta, eggs, Parmesan cheese, salt, and pepper together in a bowl; mix well."
    },
    {
      "position": 4,
      "text": "Heat oil in a medium saucepan over medium heat; add garlic and saut\u00e9 2 minutes. Stir in spaghetti sauce and Italian seasoning until warmed through, stirring occasionally, 2 to 5 minutes."
    },
    {
      "position": 5,
      "text": "Spread 1/2 cup of sauce on the bottom of a 9x13-inch baking dish. Cover with a layer of noodles. Spread 1/2 of the ricotta mixture over noodles; top with another layer of noodles. Pour 1 1/2 cups of sauce over noodles and spread the remaining ricotta over the sauce."
    },
    {
      "position": 6,
      "text": "Top with remaining noodles and sauce; sprinkle with remaining mozzarella. Cover with a greased sheet of foil."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until cheese is melted and bubbly, about 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

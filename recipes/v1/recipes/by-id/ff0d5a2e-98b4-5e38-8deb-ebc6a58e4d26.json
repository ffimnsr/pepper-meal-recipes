  "id": "ff0d5a2e-98b4-5e38-8deb-ebc6a58e4d26",
  "slug": "chicken-parmesan-meatloaf-recipe-11681026",
  "name": "Chicken Parmesan Meatloaf",
  "recipe_type": "salad",
  "brief_description": "In this chicken Parmesan meatloaf, Italian flavors take center stage. Made with ground chicken, Parmesan cheese, and herb seasonings, topped with marinara and mozzarella, then finished with crunchy seasoned panko crumbs, this is great with pasta and a green salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (180 degrees C) and line a loaf pan with parchment paper or foil."
    },
    {
      "position": 2,
      "text": "Place ground chicken in a large mixing bowl. Add onion, garlic, egg, 1/4 cup parsley, 1/2 cup marinara, Italian-seasoned bread crumbs, 1/3 cup Parmesan, Italian seasoning, and salt and pepper, to taste. Mix, using hands to combine ingredients. Add chicken mixture to the prepared pan, and shape gently into a loaf."
    },
    {
      "position": 3,
      "text": "Bake in the center of the preheated oven for 45 minutes."
    },
    {
      "position": 4,
      "text": "Remove loaf from the oven and brush with 1/4 cup marinara. Sprinkle mozzarella evenly on the top."
    },
    {
      "position": 5,
      "text": "Bake for 15 minutes more. Allow to cool on a rack for about 10 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, melt butter in a skillet over medium heat. When butter stops sizzling, add panko and garlic powder. Cook, stirring frequently, until panko is lightly toasted, 3 to 4 minutes. Remove from the heat and allow to cool, 4 to 5 minutes."
    },
    {
      "position": 7,
      "text": "Stir in remaining 2 tablespoons Parmesan cheese, and remaining 1 tablespoon minced parsley."
    },
    {
      "position": 8,
      "text": "Plate the meatloaf, top with Parmesan and panko mixture. Serve with remaining marinara sauce and garnish with parsley sprigs or other fresh herbs, if desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

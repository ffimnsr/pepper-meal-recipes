  "id": "e62719db-0775-576e-aeb7-c9677b4aeb79",
  "slug": "cranberry-sauce-with-walnuts",
  "name": "Cranberry Sauce with Walnuts",
  "recipe_type": "side",
  "brief_description": "Try this fresh homemade cranberry sauce with walnuts for the holidays instead of canned cranberry sauce and impress even people who typically do not like it.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cranberries, orange juice, sugar, and orange zest in a large saucepan over medium heat. Bring to boil, reduce heat, and simmer for 10 minutes. Remove from heat and let cool."
    },
    {
      "position": 2,
      "text": "Stir in walnuts until incorporated. Refrigerate for 8 hours to overnight before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,

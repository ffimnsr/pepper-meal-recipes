{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "197eb85b-a4d4-5f3d-97e9-fd5d555ce3ff",
  "slug": "rack-of-lamb-with-strawberry-mint-sauce",
  "name": "Rack of Lamb with Strawberry Mint Sauce",
  "recipe_type": "dessert",
  "brief_description": "Seared rack of lamb coated with a mustard-onion crust crust is roasted until just done to pink perfection, and served with a sweet-savory strawberry-mint sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place halved strawberries, zest from one lemon, juice from 2 lemons, water, honey, salt, and cayenne pepper in a pot over medium-high heat and bring to a simmer. As strawberries begin to release their liquid, soften, and start to break down, reduce heat to medium-low and continue stirring and cooking occasionally until fruit is very soft, about 10 minutes. Remove from heat. Pass mixture through a fine mesh strainer."
    },
    {
      "position": 2,
      "text": "Preheat oven to 475 degrees F (245 degrees C). Line a shallow baking pan with foil, bringing ends up and over sides of the pan."
    },
    {
      "position": 3,
      "text": "Generously season rack of lamb on both sides with kosher salt, freshly ground black pepper, and cayenne pepper. Place lamb on prepared pan. Roast rack of lamb in hot oven to sear, about 10 minutes. Remove pan from oven. Reduce oven temperature to 375 degrees F (190 degrees C)."
    },
    {
      "position": 4,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 5,
      "text": "Combine mustard and onions in a small bowl. Pour melted butter into bread crumbs in a separate bowl; stir until mixture resembles wet sand. Season with salt."
    },
    {
      "position": 6,
      "text": "Coat top of lamb generously with the mustard mixture. Sprinkle crumb mixture onto the mustard mixture and press down to create a crumb crust."
    },
    {
      "position": 7,
      "text": "Roast rack until it reaches an internal temperature of 125 degrees F (50 degrees C), about 15 minutes. Let rack rest 10 minute before slicing between ribs into four 2-rib servings or two 4-rib servings."
    },
    {
      "position": 8,
      "text": "Mix thinly sliced mint into strawberry sauce just before serving. Spoon a small pool of the sauce onto serving plates. Place ribs on sauce to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": 10,
  "difficulty": "medium",

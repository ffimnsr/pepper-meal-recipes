  "id": "ae713ad9-156d-58a3-acde-697a7aed9235",
  "slug": "grilled-spaghetti-recipe-8675070",
  "name": "Grilled Spaghetti",
  "recipe_type": "side",
  "brief_description": "Grilled spaghetti is cooked directly in a very simple sauce, so that all the extra flavor from toasting dry pasta on a grill stays in the sauce. This is delicious on its own as a side dish, or as a base for other grilled things like eggplant or chicken.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Prepare an outdoor charcoal grill for medium-high heat."
    },
    {
      "position": 2,
      "text": "Place dry spaghetti on the hot charcoal grill, and cook, tossing often with tongs until the pasta is toasted to a light brown, about 4 minutes. Remove and set aside."
    },
    {
      "position": 3,
      "text": "Add olive oil to a pan, and set over medium heat. Add garlic and saut\u00e9 until fragrant, 30 seconds to 1 minute. Add tomato paste and saut\u00e9 for about 1 minute; pour in broth."
    },
    {
      "position": 4,
      "text": "Raise heat to medium-high and bring broth to a simmer. Add salt and grilled spaghetti, and use tongs to move spaghetti back and forth until it softens enough to be covered by the broth."
    },
    {
      "position": 5,
      "text": "Cook, stirring, until spaghetti is as tender as you like; it will take a few minutes longer than package directions indicate. If pan gets too dry, add another splash of broth."
    },
    {
      "position": 6,
      "text": "Reduce heat to low; stir in butter and basil. Turn off heat and stir in cheese. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

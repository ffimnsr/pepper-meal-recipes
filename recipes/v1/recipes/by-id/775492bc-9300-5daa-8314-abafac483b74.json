  "id": "775492bc-9300-5daa-8314-abafac483b74",
  "slug": "easy-apple-crisp",
  "name": "Easy Apple Crisp",
  "recipe_type": "dessert",
  "brief_description": "This apple crisp with a cake mix-brown sugar streusel topping is baked in a 9x13-inch dish until bubbly for a warm dessert, great for feeding a crowd.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Arrange sliced apples evenly in the bottom of the prepared baking dish. Pour water over apples."
    },
    {
      "position": 3,
      "text": "Combine cake mix, brown sugar, and cinnamon in a medium bowl. Stir in melted butter until thoroughly blended and crumbly. Sprinkle over apples."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bubbly and topping is browned, 50 to 55 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "crunchy-quick-refrigerator-dill-pickles-recipe-8664645",
  "name": "Crunchy Quick Refrigerator Dill Pickles",
  "recipe_type": "side",
  "brief_description": "These crunchy quick refrigerator dill pickles are easy to make, and cure in the refrigerator for a day before they're ready. They're a great way to use the abundant cucumbers from your garden.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place half of cucumber slices in a large jar. Add garlic, dill, and peppercorns. Top with remaining cucumbers until the jar is filled tightly."
    },
    {
      "position": 2,
      "text": "Bring water, salt, and vinegar to a boil in a small saucepan, stirring occasionally, until salt is dissolved. Remove from heat and let cool 10 minutes. Pour warm mixture over cucumbers and seal jar. Refrigerate at least one day and up to 4 weeks."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

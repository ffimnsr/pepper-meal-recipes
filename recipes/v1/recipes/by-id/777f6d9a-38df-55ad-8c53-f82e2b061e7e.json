  "slug": "raising-canes-sauce-battered-chicken-tenders-recipe-11995195",
  "name": "Raising Cane\u2019s Sauce Battered Chicken Tenders",
  "recipe_type": "main",
  "brief_description": "These Raising Cane\u2019s Sauce chicken tenders take crispy fried chicken to the next level by marinating the tenders in the iconic sauce before breading and frying. A final drizzle adds even more tangy, savory flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Coat chicken tenders in flour."
    },
    {
      "position": 2,
      "text": "Toss floured tenders in Raising Cane\u2019s Sauce and marinate for 10 minutes."
    },
    {
      "position": 3,
      "text": "Mix panko with garlic powder, onion powder, paprika, and pepper. Coat tenders in seasoned panko."
    },
    {
      "position": 4,
      "text": "Preheat oil in a deep heavy skillet to 350 degrees F (180 degrees C)."
    },
    {
      "position": 5,
      "text": "Fry tenders until golden, 8 to 10 minutes total. An instant read thermometer inserted near the center should reach 165 degrees F (74 degrees C)."
    },
    {
      "position": 6,
      "text": "Drain and drizzle with more Raising Cane\u2019s Sauce before serving."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

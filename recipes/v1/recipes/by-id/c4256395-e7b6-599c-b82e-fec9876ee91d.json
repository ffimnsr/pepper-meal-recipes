  "id": "c4256395-e7b6-599c-b82e-fec9876ee91d",
  "slug": "iced-einspaenner-viennese-iced-coffee-recipe-12006025",
  "name": "Iced Einsp\u00e4nner (Viennese Iced Coffee)",
  "recipe_type": "breakfast",
  "brief_description": "This iced einsp\u00e4nner is a refreshing take on the classic Viennese coffee drink, combining chilled espresso with a generous topping of whipped cream. Similar to an affogato but without the ice cream, it can also be made with about 2/3 cup of strong brewed coffee, as long as it\u2019s completely cooled before serving.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place heavy cream, sugar, vanilla, and salt in a mixing bowl. Beat with an electric mixer on medium speed until mixture holds soft peaks. Taste, and adjust sweetness to taste by adding more confectioner\u2019s sugar, if desired."
    },
    {
      "position": 2,
      "text": "Place ice cubes into a tall glass. Pour cooled espresso over ice. Top with whipped cream."
    },
    {
      "position": 3,
      "text": "Sprinkle with cocoa powder, and serve immediately."
    }
  ],
  "servings": 1,

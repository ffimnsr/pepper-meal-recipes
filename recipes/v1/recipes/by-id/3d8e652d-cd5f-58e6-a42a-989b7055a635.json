  "id": "3d8e652d-cd5f-58e6-a42a-989b7055a635",
  "slug": "maries-easy-slow-cooker-pot-roast",
  "name": "Slow Cooker Pot Roast",
  "recipe_type": "soup",
  "brief_description": "This slow cooker pot roast recipe is easy to make with chuck roast, potatoes, carrots, celery, and onion soup mix for tender, juicy results every time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Season roast generously with salt and pepper."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over high heat; add roast and sear, about 4 minutes per side."
    },
    {
      "position": 3,
      "text": "Place roast in the slow cooker; sprinkle soup mix on top."
    },
    {
      "position": 4,
      "text": "Add water; scatter carrots, potatoes, onion, and celery on top."
    },
    {
      "position": 5,
      "text": "Cover and cook on Low for 8 to 10 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 500,
  "preparation_time_minutes": 20,

  "id": "5302736b-c0fc-57a4-b9ac-4fc6e36a4d00",
  "slug": "baked-garlic-parmesan-chicken",
  "name": "Baked Garlic Parmesan Chicken",
  "recipe_type": "main",
  "brief_description": "Deliciously crispy and tender, these baked breaded chicken breasts flavored with garlic and Parmesan cheese are quick and easy to prepare for the tastiest chicken dish ever.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13 inch baking dish."
    },
    {
      "position": 2,
      "text": "In a bowl, blend the olive oil and garlic."
    },
    {
      "position": 3,
      "text": "In a separate bowl, mix the bread crumbs, Parmesan cheese, basil, and pepper."
    },
    {
      "position": 4,
      "text": "Dip each chicken breast in the oil mixture, then in the bread crumb mixture. Arrange the coated chicken breasts in the prepared baking dish, and top with any remaining bread crumb mixture."
    },
    {
      "position": 5,
      "text": "Bake 30 minutes in the preheated oven, or until chicken is no longer pink and juices run clear."
    },
    {
      "position": 6,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

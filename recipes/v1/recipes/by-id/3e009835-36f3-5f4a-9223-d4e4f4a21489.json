  "id": "3e009835-36f3-5f4a-9223-d4e4f4a21489",
  "slug": "wacky-cake-iv",
  "name": "Old-Fashioned Wacky Cake",
  "recipe_type": "dessert",
  "brief_description": "This old-fashioned wacky cake recipe is made with flour, sugar, oil, vinegar, and cold water, topped with a sweet chocolate frosting.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees (175 degrees C). Grease a 13x9-inch cake pan."
    },
    {
      "position": 2,
      "text": "Mix flour, white sugar, 4 \u00bd tablespoons cocoa, baking soda, and salt together in a bowl. Pour dry ingredients into the prepared pan. Scoop out 3 holes in the dry mixture with a spoon: add vegetable oil, vinegar, and 1 \u00bd teaspoons vanilla individually in each hole. Stir in cold water over top until smooth."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until a toothpick inserted into the center comes out clean, about 20 minutes."
    },
    {
      "position": 4,
      "text": "To make the frosting: Melt butter in a saucepan over medium heat: add cocoa. Off heat, stir in salt, milk, and 1 teaspoon vanilla. Mix in confectioners' sugar until your desired consistency. Spread over hot cake."
    }
  ],
  "servings": 14,

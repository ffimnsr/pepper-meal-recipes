{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "e8bd489c-1a9c-5bdf-9c10-70a9ad1a5157",
  "slug": "turkey-tater-tot-hot-dish-recipe-8353228",
  "name": "Turkey Tater Tot Hot Dish",
  "recipe_type": "main",
  "brief_description": "This turkey tater tot hot dish is everything you want from upper-Midwest comfort food. The contrast between the savory, saucy, meaty turkey on the bottom, and the crispy, cheesy tater tot top makes this absolutely irresistible.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat butter and olive oil in a large skillet over high heat, and cook and stir mushrooms with a big pinch of the salt until golden brown, 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Add onions and saut\u00e9 until onions turn translucent, about 3 minutes. Add turkey, and cook for a few minutes, breaking meat up into smaller crumbles."
    },
    {
      "position": 4,
      "text": "Stir in the rest of the salt, black pepper, paprika, garlic powder, and cayenne pepper. Reduce heat to medium high, and cook until turkey is lightly browned and crumbly and liquid is mostly evaporated, 3 to 4 minutes."
    },
    {
      "position": 5,
      "text": "Sprinkle over and stir in flour; cook, stirring, to cook out the raw taste of the flour, another 3 to 4 minutes. Stir in green chiles, bell pepper, and chicken broth. Wait for the mixture to simmer, and cook, stirring, until the liquids thicken, and the texture is to your liking, about 2 minutes. Mixture can be reduced to thicken further, or broth can be added for a thinner texture."
    },
    {
      "position": 6,
      "text": "Taste and adjust seasoning if needed. Transfer to a 9x12-inch, 9x13-inch, or equivalent casserole dish and smooth out the top. Top surface evenly with 4 ounces shredded cheese, and press cheese in lightly with the tip of a spatula."
    },
    {
      "position": 7,
      "text": "Cover casserole surface evenly with 1 layer of frozen or thawed tater tots (if using frozen, add a few minutes to the oven time). Reserve any remaining tots for another use. Top with remaining cheese."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until tater tots are crisp and golden, 30 to 35 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

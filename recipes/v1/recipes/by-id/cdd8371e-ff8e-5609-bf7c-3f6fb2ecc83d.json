  "id": "cdd8371e-ff8e-5609-bf7c-3f6fb2ecc83d",
  "slug": "tex-mex-chicken-and-zucchini-recipe-11895713",
  "name": "Tex-Mex Chicken and Zucchini",
  "recipe_type": "salad",
  "brief_description": "This Tex-Mex chicken and zucchini is a versatile skillet chicken, vegetable and black bean dinner. Serve with a salad and crunchy tortilla chips; in a bowl, over rice with shredded lettuce, pico de gallo, and avocado slices; or wrapped inside a tortilla,",
  "cuisine": "Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large nonstick skillet over medium-high heat."
    },
    {
      "position": 2,
      "text": "When oil shimmers, add onions and bell pepper and cook until onions are translucent, stirring frequently, about 2 minutes."
    },
    {
      "position": 3,
      "text": "Stir in zucchini and minced garlic, and cook, stirring, about 2 minutes. Stir in taco seasoning, ground cumin, and ground coriander. Cook, stirring, until all the vegetables are coated with the seasonings, and they become fragrant, about 2 minutes more."
    },
    {
      "position": 4,
      "text": "Add RO*TEL, and cook for 4 to 5 minutes. Add black beans and corn, stirring until well blended, and cook about 2 minutes."
    },
    {
      "position": 5,
      "text": "Add chicken and cook, stirring, until chicken is warmed through and zucchini is tender, about 3 minutes more. Remove dish from heat; stir in cilantro, lime juice, and pepper."
    },
    {
      "position": 6,
      "text": "Sprinkle cheese over the top, garnish with lime wedges, and serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

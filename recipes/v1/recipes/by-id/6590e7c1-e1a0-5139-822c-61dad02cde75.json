  "id": "6590e7c1-e1a0-5139-822c-61dad02cde75",
  "slug": "5-ingredient-creamy-tortellini-and-sausage-recipe-11731686",
  "name": "5-ingredient Creamy Tortellini and Sausage",
  "recipe_type": "main",
  "brief_description": "This 5-ingredient creamy tortellini and sausage dish is very easy to put together, and a comforting family meal. You can garnish with a little fresh parsley and freshly ground black pepper if you like.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil; stir in tortellini and return to a boil. Cook uncovered, stirring occasionally, until the tortellini float to the top and the filling is hot, about 3 minutes. Drain; set aside."
    },
    {
      "position": 2,
      "text": "Meanwhile, toss diced sausage in a nonstick skillet over medium heat; cook until edges are browned, about 3 minutes. Remove from heat; set aside."
    },
    {
      "position": 3,
      "text": "Pour Alfredo sauce into a saucepan. Add milk to any leftover sauce in the jar; shake it up and pour into saucepan. Stir in Parmesan cheese."
    },
    {
      "position": 4,
      "text": "Warm sauce, stirring often to avoid scorching, over medium-low heat, about 5 minutes. Add sausage and tortellini, and cook just until heated through, about 3 minutes more. Ladle into bowls."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "a7f4450e-0692-5a0f-840f-dcadc9f2b806",
  "slug": "barbeque-pork-fajitas",
  "name": "Barbeque Pork Fajitas",
  "recipe_type": "main",
  "brief_description": "Boneless pork chop strips are tossed with barbeque sauce, bell peppers, and red onion in this quick and easy recipe for colorful fajitas.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine pork strips, cumin, and garlic pepper blend in a large resealable plastic bag. Shake until pork is coated."
    },
    {
      "position": 2,
      "text": "Heat vegetable oil in a large skillet over medium heat. Add pork; cook and stir until browned, 4 to 5 minutes. Add onion, red bell pepper, and green bell pepper; cook until fragrant, about 2 minutes. Stir in barbeque sauce; simmer until flavors combine, about 2 minutes."
    },
    {
      "position": 3,
      "text": "Serve pork mixture over flour tortillas."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 8,
  "preparation_time_minutes": 15,

  "id": "cafd0d37-a126-5a06-9112-e23626502f3f",
  "slug": "salmon-quiche",
  "name": "Salmon Quiche",
  "recipe_type": "breakfast",
  "brief_description": "This salmon quiche recipe is easy to make with canned salmon, eggs, onion, Cheddar cheese, evaporated milk, and a frozen store-bought pie crust.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine evaporated milk, cubed Cheddar, eggs, onion, salt, pepper, garlic powder, parsley, and sage in a blender; blend until smooth."
    },
    {
      "position": 3,
      "text": "Spread salmon over the pie crust and sprinkle with 1/2 of the shredded Cheddar. Pour in egg mixture, then top with remaining shredded Cheddar."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "ee0382d2-85ee-519e-8257-4d3ecd18c748",
  "slug": "cheesy-mashed-potato-stuffed-mushrooms",
  "name": "Cheesy Mashed Potato Stuffed Mushrooms",
  "recipe_type": "appetizer",
  "brief_description": "These Cheesy Mashed Potato Stuffed Mushrooms are so elegant your guests will think you slaved over them. Your secret is safe with us.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F."
    },
    {
      "position": 2,
      "text": "Prepare mashed potatoes according to package directions."
    },
    {
      "position": 3,
      "text": "Add shredded cheese (reserve enough to top mushrooms), chives and bacon."
    },
    {
      "position": 4,
      "text": "Remove stems from clean mushrooms and stuff caps with potato mixture."
    },
    {
      "position": 5,
      "text": "Spread olive oil and minced garlic on bottom of walled cookie sheet or baking dish. Place mushrooms on top."
    },
    {
      "position": 6,
      "text": "Sprinkle shredded cheddar over the top of the mushrooms."
    },
    {
      "position": 7,
      "text": "Bake for 20-25 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,

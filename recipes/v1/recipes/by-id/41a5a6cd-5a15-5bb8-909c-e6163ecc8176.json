  "id": "41a5a6cd-5a15-5bb8-909c-e6163ecc8176",
  "slug": "hawaiian-wedding-cake-i",
  "name": "Tropical Hawaiian Wedding Cake",
  "recipe_type": "dessert",
  "brief_description": "This Hawaiian wedding cake recipe is made from scratch with pantry staples, crushed pineapple, coconut, and walnuts. Top with cream cheese frosting.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch pan."
    },
    {
      "position": 2,
      "text": "Mix flour, sugar, and baking soda together in a large bowl: mix in pineapple with juice and eggs. Stir in nuts and coconut; pour mixture into prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, 35 to 40 minutes. Cool cake on a wire rack before frosting."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,

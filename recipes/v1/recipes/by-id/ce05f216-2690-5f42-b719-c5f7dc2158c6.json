  "id": "ce05f216-2690-5f42-b719-c5f7dc2158c6",
  "slug": "maple-pecan-shortbread-squares",
  "name": "Maple Pecan Shortbread Squares",
  "recipe_type": "dessert",
  "brief_description": "Real maple syrup flavors the sticky pecan topping of these delicious shortbread squares.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine flour and 1/3 cup brown sugar in a mixer. Mix in softened butter until a dough has formed. Press into an ungreased 8x8-inch baking pan; prick dough with a fork."
    },
    {
      "position": 3,
      "text": "Bake shortbread in the preheated oven until golden brown, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, beat egg in a mixing bowl along with 1/3 cup brown sugar, maple syrup, and pecans. Pour pecan mixture over hot crust, and return to oven. Continue baking until topping has firmed, 12 to 15 minutes."
    },
    {
      "position": 5,
      "text": "Remove from oven, and immediately run a knife around the edges to prevent sticking. Cool completely, then cut into 1-inch bar cookies to serve."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,

  "id": "7e4e4e23-26e6-5827-8347-44ae1bcc3062",
  "slug": "cinnamon-sugar-monkey-bread",
  "name": "Cinnamon-Sugar Monkey Bread",
  "recipe_type": "dessert",
  "brief_description": "This fun-to-make version of monkey bread is covered in cinnamon sugar and a sticky glaze for a sweet breakfast treat warm from the oven or the next morning.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine warm water, brown sugar, and yeast in a large mixing bowl and let rest until frothy, about 10 minutes. Add 1/2 cup oil and stir. Set aside."
    },
    {
      "position": 2,
      "text": "Sift flour and salt together in a bowl."
    },
    {
      "position": 3,
      "text": "Mix flour mixture into the yeast mixture and knead until dough forms a sticky ball. Coat the inside of another bowl with oil; transfer dough to the oiled bowl and turn to coat. Cover the bowl and let dough rest in a warm place until doubled in size, about 1 hour."
    },
    {
      "position": 4,
      "text": "Meanwhile, mix white sugar and cinnamon together in a bowl."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Oil a fluted tube pan (such as Bundt\u00ae)."
    },
    {
      "position": 6,
      "text": "Punch down risen dough and roll into 1-inch balls. Roll balls in cinnamon-sugar mixture and arrange a layer in the prepared tube pan. Sprinkle with cinnamon sugar and drizzle with a bit of oil. Continue layering with remaining dough balls and cinnamon sugar."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until puffed up, about 25 minutes."
    },
    {
      "position": 8,
      "text": "Meanwhile, mix confectioners' sugar and milk together in a bowl. Drizzle glaze generously over the warm monkey bread."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,

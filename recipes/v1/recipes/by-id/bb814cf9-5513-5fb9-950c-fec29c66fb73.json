  "id": "bb814cf9-5513-5fb9-950c-fec29c66fb73",
  "slug": "easy-german-apple-streusel-pie",
  "name": "Easy German Apple Streusel Pie",
  "recipe_type": "dessert",
  "brief_description": "This apple streusel pie has a tender apple and cinnamon filling in a sweet crust with a crispy streusel topping made from the same easy dough recipe.",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Combine apple slices and cinnamon in a saucepan and cook over low heat for 10 minutes. If necessary, add a tiny bit of water so apples don't burn. Remove from heat and set aside to cool."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 10-inch springform pan with butter."
    },
    {
      "position": 3,
      "text": "Combine butter, sugar, vanilla sugar, and egg in a large bowl; beat using an electric mixer until smooth and creamy. Mix flour and baking powder in a separate bowl. Add 2/3 of flour mixture, 1 tablespoon at a time, to butter mixture and beat on low speed. Add remaining flour mixture and mix in by hand to make a crumbly dough."
    },
    {
      "position": 4,
      "text": "Transfer 1/2 the dough into the prepared springform pan and press down to create a bottom crust. Add apple slices, leaving a small space around the edges. Crumble remaining dough evenly on top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until streusel and crust are lightly browned, about 50 minutes. Cool on a wire rack for 5 minutes. Run a table knife around the edges to loosen. Carefully transfer to a serving plate or cooling rack."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

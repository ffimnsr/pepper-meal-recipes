  "id": "0d87442c-09f6-5deb-ba33-ba9ee59207d6",
  "slug": "slow-cooker-honey-mustard-pulled-pork-recipe-8782549",
  "name": "Slow Cooker Honey Mustard Pulled Pork",
  "recipe_type": "dessert",
  "brief_description": "This slow cooker honey mustard pulled pork is so punchy and sweet, and the glossy sauce clings nicely to the pork. Serve on slider buns.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir together salt, granulated garlic, onion powder, dry mustard, and black pepper in a small bowl. Rub spice mixture evenly over pork."
    },
    {
      "position": 3,
      "text": "Place pork in an 8-quart slow cooker. Stir honey, Dijon mustard, whole grain mustard, Worcestershire, and apple cider vinegar in a bowl. Pour 1 cup Dijon mixture over pork; cover and refrigerate remaining 1/2 cup. Cover the slow cooker, and cook until fork tender, flipping pork halfway through cooking, 5 to 6 hours on High or 8 to 10 hours on Low."
    },
    {
      "position": 4,
      "text": "Transfer pork to a cutting board, reserve 1/4 cup cooking liquid in the slow cooker; discard remaining cooking liquid. Whisk reserved Dijon mixture into reserved cooking liquid. Shred pork with 2 forks and stir into sauce."
    },
    {
      "position": 5,
      "text": "Serve on slider buns with pickled red onion. Recipe developed by Craig Ruff"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 300,
  "preparation_time_minutes": 15,

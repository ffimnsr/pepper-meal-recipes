  "id": "732f5b21-4ec4-50cb-beb9-db00cc9f438f",
  "slug": "chicken-with-herb-dumplings",
  "name": "Chicken with Herb Dumplings",
  "recipe_type": "soup",
  "brief_description": "Savory, soul-satisfying, slow-simmering chicken and dumplings, made quick and easy with cream of chicken soup and all-purpose baking mix.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Heat shortening in a large skillet over medium-high heat. In a medium bowl, stir together 1 cup baking mix, salt, paprika, and pepper. Coat chicken with mixture, and fry in shortening, turning until browned. Remove chicken to paper towels, and drain fat."
    },
    {
      "position": 2,
      "text": "Wipe out skillet, and return to stove. Stir soup and milk together in skillet. Place chicken in pan, and heat to boiling. Reduce heat to low; cover skillet, and simmer 45 minutes, turning chicken from time to time."
    },
    {
      "position": 3,
      "text": "Meanwhile, in a medium bowl, combine 2 cups baking mix, milk, parsley, and poultry seasoning, stirring together until a soft dough forms. Once the chicken has cooked 45 minutes, drop the dumpling mixture by tablespoonfuls into the simmering gravy. Cook uncovered for 10 minutes; cover, and cook 10 minutes more, until dumplings expand."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "ff9f0691-939c-5f30-a939-1e936062009a",
  "slug": "pineapple-cobbler",
  "name": "Pineapple Cobbler",
  "recipe_type": "dessert",
  "brief_description": "You'll want to make this pineapple cobbler recipe if you like pineapple upside-down cake. All the same great flavors, just in a different format!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Place butter into a 9x13-inch baking dish and set on an oven rack to melt while preheating."
    },
    {
      "position": 2,
      "text": "In a medium bowl, stir together flour, white sugar, and milk until smooth. In a separate bowl, toss pineapple with brown sugar until well coated."
    },
    {
      "position": 3,
      "text": "When the butter is melted, remove the baking dish from the oven. Pour batter into the prepared dish, then drop spoonfuls of pineapple mixture over top. Sprinkle with cherries."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden, about 30 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

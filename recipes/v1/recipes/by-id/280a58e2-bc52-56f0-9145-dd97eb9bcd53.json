{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "280a58e2-bc52-56f0-9145-dd97eb9bcd53",
  "slug": "sweet-and-sour-stuffed-cabbage",
  "name": "Sweet and Sour Stuffed Cabbage",
  "recipe_type": "dessert",
  "brief_description": "This sweet and sour stuffed cabbage rolls recipe includes a ground beef, rice, and raisin filling that gets an extra tang from citric acid powder.",
  "cuisine": "Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water and rice to a boil in a saucepan over high heat. Reduce heat to medium-low, cover, and simmer until rice is tender and liquid has been absorbed, 20 to 25 minutes."
    },
    {
      "position": 2,
      "text": "Fill a large pot with water; bring to a boil. Add 1 head cabbage; boil until softened but still firm, about 5 minutes. Remove cabbage from pot; cool for 15 minutes. Repeat with remaining 1 head cabbage."
    },
    {
      "position": 3,
      "text": "Add ground beef, cooked rice, \u00bd cup ketchup, eggs, 1 \u00bd teaspoons garlic powder, salt, and black pepper to a bowl; mix with your hands until well combined."
    },
    {
      "position": 4,
      "text": "Shave a slice off large veins in center of cabbage leaves so they're easier to roll. Place a heaping spoonful filling in center of 1 leaf. Fold in left and right edges, then roll up leaf from the bottom, forming a tight cylinder. Secure with toothpicks if necessary. Continue filling and rolling leaves; set aside smaller cabbage leaves."
    },
    {
      "position": 5,
      "text": "Chop reserved cabbage leaves; add to a large pot. Add crushed tomatoes, sliced onion, raisins, \u00bd cup ketchup, remaining 1 \u00bd teaspoons garlic powder, citric acid powder (sour salt), salt, and black pepper. Stir in \u00bd cup white sugar; bring to a boil."
    },
    {
      "position": 6,
      "text": "Taste sauce; add remaining \u00bd cup sugar if desired. Place cabbage rolls into sauce. Pour remaining 1 cup ketchup on top of rolls. Cover pot; reduce heat to a simmer."
    },
    {
      "position": 7,
      "text": "Cook rolls for 3 hours, basting every 30 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 230,

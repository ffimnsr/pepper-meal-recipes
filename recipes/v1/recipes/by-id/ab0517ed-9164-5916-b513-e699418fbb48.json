  "id": "ab0517ed-9164-5916-b513-e699418fbb48",
  "slug": "strawberry-rhubarb-cobbler",
  "name": "Strawberry Rhubarb Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This easy and delicious strawberry rhubarb cobbler recipe is made with cake mix, strawberry gelatin, and fresh rhubarb for a simple oven-baked dessert.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat an 11x7x2-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Add rhubarb to the prepared baking dish; sprinkle white sugar on top, followed by gelatin mix and cake mix. Pour water over top; drizzle with melted butter."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until rhubarb is tender, about 50 minutes. Cool on a wire rack for 15 minutes."
    },
    {
      "position": 4,
      "text": "Dust cobbler with confectioners\u2019 sugar; top servings with whipped topping."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,

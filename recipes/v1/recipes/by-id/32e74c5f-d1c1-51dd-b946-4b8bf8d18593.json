  "id": "32e74c5f-d1c1-51dd-b946-4b8bf8d18593",
  "slug": "air-fryer-2-ingredient-mozzarella-sticks-recipe-11944408",
  "name": "Air Fryer 2-Ingredient Mozzarella Sticks",
  "recipe_type": "appetizer",
  "brief_description": "These air-fried 2-ingredient mozzarella sticks are gooey bites of delicious string cheese, wrapped in a tortilla, and cooked until golden in an air fryer. This is a quick snack for after school, a quick lunch, or for any moment when you need something easy and satisfying.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place a cheese stick at the bottom third of each tortilla. Tuck the sides in and roll up. Use a toothpick to secure the tortilla closed if necessary."
    },
    {
      "position": 2,
      "text": "Brush each roll with olive oil and sprinkle lightly with garlic powder and dried parsley."
    },
    {
      "position": 3,
      "text": "Fry in an air fryer at 400 degrees F (200 degrees C) until just browned and toasted, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Serve with marinara if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,

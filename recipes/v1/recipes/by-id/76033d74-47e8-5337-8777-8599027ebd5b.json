  "id": "76033d74-47e8-5337-8777-8599027ebd5b",
  "slug": "green-goddess-quinoa-bowl-recipe-11997356",
  "name": "Green Goddess Quinoa Bowl",
  "recipe_type": "salad",
  "brief_description": "With hearty quinoa and sturdy vegetables, this nutrient-dense bowl is ideal for meal prep. Store the green goddess dressing separately and omit coating the baby kale in Step 2; toss with dressing just before serving.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring broth to a boil in a small saucepan over high heat. Add quinoa and salt; reduce heat to medium-low. Simmer, covered, until quinoa is tender, about 15 minutes. Drain excess broth, if needed. Spread quinoa on a rimmed baking sheet to cool while preparing remaining ingredients."
    },
    {
      "position": 2,
      "text": "Toss kale with half of the Green Goddess Dressing in a large bowl. Divide among 4 bowls. Top with quinoa, chickpeas, tomatoes, carrot, and dried cherries. Drizzle with remaining dressing. Sprinkle with hazelnuts."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

  "id": "74d13aeb-e162-5ef5-881b-7576e19800e4",
  "slug": "easy-apple-pie-bars",
  "name": "Easy Apple Pie Bars",
  "recipe_type": "dessert",
  "brief_description": "A sweet and dense apple filling is sandwiched between 2 tender shortbread crusts in this easy and crowd-pleasing recipe for pie bars.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine 4 cups flour, baking powder, and salt in a large bowl. Cut in shortening with a fork until coarse crumbs form."
    },
    {
      "position": 3,
      "text": "Whisk egg yolks, cold water, and lemon juice together in another bowl. Stir into flour mixture with a fork until dough comes together into a ball; divide in half. Roll out 1 half and press into the bottom of a 10x15-inch baking pan."
    },
    {
      "position": 4,
      "text": "Combine apples, sugar, 1/4 cup flour, and ground cinnamon in a bowl to make filling. Spread over dough in the pan."
    },
    {
      "position": 5,
      "text": "Roll out remaining dough and lay on top of filling. Brush with milk. Cut slits in the dough with a sharp knife."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown, 45 to 50 minutes. Cool before cutting into 24 bars, at least 20 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

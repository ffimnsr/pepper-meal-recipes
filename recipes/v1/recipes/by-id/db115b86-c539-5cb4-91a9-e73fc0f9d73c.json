  "id": "db115b86-c539-5cb4-91a9-e73fc0f9d73c",
  "slug": "spinach-artichoke-pasta-recipe-11699690",
  "name": "Spinach Artichoke Pasta",
  "recipe_type": "main",
  "brief_description": "This creamy spinach artichoke pasta has all the flavors you love in spinach artichoke dip in an easy sauce for pasta, with spinach, cream cheese, chopped artichokes, and cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place thawed spinach between several layers of paper towels. Roll up like a jelly roll and press firmly. Unroll spinach, place on a plate, fluff with a fork, and set aside."
    },
    {
      "position": 2,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Cook fettuccine at a boil until tender yet firm to the bite, about 8 minutes. Drain, and reserve 1/2 cup pasta water. Set aside."
    },
    {
      "position": 3,
      "text": "Meanwhile, cut cream cheese into 1/2-inch chunks. Place in a non-stick skillet over medium-low heat, and add cream, and stir until cream cheese melts."
    },
    {
      "position": 4,
      "text": "Add garlic, Parmesan, and mozzarella and cook, stirring, until cheeses are melted and sauce is bubbly. Add sour cream and mayonnaise; stir until well blended."
    },
    {
      "position": 5,
      "text": "Add spinach and artichokes, and cook, stirring until heated through, about 2 minutes. Add pasta water 1 tablespoon at a time to loosen the sauce, if desired."
    },
    {
      "position": 6,
      "text": "Season sauce with salt and pepper. Stir in drained fettuccine, garnish with fresh herbs, and serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

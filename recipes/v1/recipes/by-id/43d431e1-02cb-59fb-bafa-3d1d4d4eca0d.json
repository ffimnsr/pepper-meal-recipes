{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "43d431e1-02cb-59fb-bafa-3d1d4d4eca0d",
  "slug": "italian-stuffed-pasta-tubes",
  "name": "Italian Stuffed Pasta Tubes",
  "recipe_type": "main",
  "brief_description": "For this Italian stuffed pasta tubes recipe manicotti are stuffed with turkey sausage and spaghetti sauce then covered in a creamy three-cheese sauce.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook manicotti in the boiling water, stirring occasionally, until tender yet firm to the bite, about 7 minutes. Drain; cool."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat a large skillet over medium-high heat. Add sausage; cook and stir until browned and crumbly, 5 to 7 minutes. Drain excess grease."
    },
    {
      "position": 3,
      "text": "Add 2 cups spaghetti sauce, garlic, and Italian seasoning to sausage; simmer for about 10 minutes."
    },
    {
      "position": 4,
      "text": "Cut open manicotti tubes; lay flat. Place about 3 tablespoons sausage mixture down middle of flattened tubes; divide and sprinkle 2/3 cup mozzarella cheese on top sausage mixture. Roll up tubes."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly coat a 9x13-inch casserole dish with cooking spray."
    },
    {
      "position": 6,
      "text": "Melt butter in a medium saucepan over medium heat. Whisk in flour until a smooth paste forms. Slowly pour in cream, whisking to prevent any lumps. Cook until thickened, about 5 minutes. Whisk in Fontina cheese, 1/2 cup mozzarella cheese, and Parmesan cheese until thoroughly blended."
    },
    {
      "position": 7,
      "text": "Pour 1/2 cheese sauce into the prepared casserole dish. Place stuffed tubes, seam-sides down, over sauce; pour remaining 1/2 cheese sauce on top. Pour remaining 1 cup spaghetti sauce down middle of casserole."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until golden, 20 to 25 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,

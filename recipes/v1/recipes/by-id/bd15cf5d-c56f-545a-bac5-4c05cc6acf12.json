  "id": "bd15cf5d-c56f-545a-bac5-4c05cc6acf12",
  "slug": "easiest-zucchini-quiche",
  "name": "Zucchini Quiche",
  "recipe_type": "breakfast",
  "brief_description": "This zucchini quiche is made in a prepared pie crust with grated zucchini, eggs, and Cheddar cheese for a super easy, satisfying brunch dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Spread grated zucchini on the bottom of the pie shell."
    },
    {
      "position": 3,
      "text": "Pour beaten eggs over zucchini and top with Cheddar cheese."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven until a knife inserted into the center of quiche comes out clean, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

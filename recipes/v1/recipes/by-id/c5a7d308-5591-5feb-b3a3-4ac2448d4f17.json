  "id": "c5a7d308-5591-5feb-b3a3-4ac2448d4f17",
  "slug": "chef-johns-buttermilk-fried-chicken",
  "name": "Chef John's Buttermilk Fried Chicken",
  "recipe_type": "main",
  "brief_description": "Buttermilk fried chicken that's crispy and tender. Whole chicken pieces are soaked in buttermilk, coated in seasoned flour, then fried until crisp.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Toss chicken pieces, black pepper, salt, paprika, white pepper, rosemary, thyme, oregano, sage, and cayenne together in a large bowl."
    },
    {
      "position": 3,
      "text": "Stir in buttermilk until chicken is evenly coated. Cover and refrigerate for 6 hours."
    },
    {
      "position": 4,
      "text": "Combine flour, salt, paprika, cayenne, garlic powder, white pepper, and onion powder in a large shallow dish."
    },
    {
      "position": 5,
      "text": "Remove chicken from buttermilk and dredge each piece in seasoned flour; shake off any excess and transfer to a plate."
    },
    {
      "position": 6,
      "text": "Heat peanut oil in a large Dutch oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 7,
      "text": "Add chicken pieces to the hot oil and fry for 10 minutes. Turn chicken pieces and fry for another 10 to 15 minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 8,
      "text": "Transfer fried chicken to a cooling rack set over a paper towel-lined baking sheet. Let sit for 10 minutes before serving."
    },
    {
      "position": 9,
      "text": "Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

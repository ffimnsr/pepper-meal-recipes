  "id": "22f81804-f87e-5d7f-ba27-8b2a2ebefbc0",
  "slug": "easy-never-forgotten-guacamole",
  "name": "Easy Never Forgotten Guacamole",
  "recipe_type": "appetizer",
  "brief_description": "This guacamole has been a hit at our house for years. Great for the Superbowl or any occasion. Sour cream and cream cheese make the guac extra creamy. Spice it up with crushed red pepper.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "In a small bowl, mix together the avocados, sour cream, cream cheese and salsa. Blend to desired consistency."
    },
    {
      "position": 2,
      "text": "In a small bowl mix the salt, pepper, garlic salt and onion powder. Stir into the avocado mixture. Cover and chill in the refrigerator 1/2 hour before serving."
    }
  ],
  "servings": 16,

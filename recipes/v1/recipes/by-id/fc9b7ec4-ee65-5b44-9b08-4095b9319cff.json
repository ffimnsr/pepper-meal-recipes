  "id": "fc9b7ec4-ee65-5b44-9b08-4095b9319cff",
  "slug": "chopped-grinder-sliders-recipe-11697213",
  "name": "Chopped Grinder Sliders",
  "recipe_type": "salad",
  "brief_description": "These chopped grinder sliders feature a chopped Italian salad inside Hawaiian rolls that have been brushed with garlic butter and toasted.",
  "cuisine": "American Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Slice the attached rolls in half horizontally, without detaching."
    },
    {
      "position": 2,
      "text": "Place butter and garlic in a microwave-safe bowl or measuring cup and microwave until melted, 30 to 45 seconds. Brush garlic butter over tops of rolls and over the cut side of bottom half of rolls, and place on a baking sheet, buttered side up."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until lightly toasted, 6 to 7 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile place ham, salami, pepperoni, provolone, lettuce, tomato, red onion, and banana peppers onto a cutting board. Chop the ingredients together until well combined. Add banana pepper brine, olive oil, wine vinegar, Italian seasoning, salt, pepper, and mayonnaise, and chop and mix them all together until everything is well coated."
    },
    {
      "position": 5,
      "text": "Spread mixture evenly over the bottom half of rolls and place top half of rolls on top. Cut into 12 slider sandwiches."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

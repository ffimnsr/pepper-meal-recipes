  "id": "9730b295-5046-5636-bf23-b4a3faa3cb33",
  "slug": "spicy-hawaiian-slow-cooker-chicken-bulgogi",
  "name": "Spicy Hawaiian Slow Cooker Chicken Bulgogi",
  "recipe_type": "drink",
  "brief_description": "If you love spicy food, try this Hawaiian-inspired slow cooker recipe that marinates chicken in bulgogi sauce, gochujang, and pineapple juice.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken and onion in a slow cooker. Stir in pineapple, bulgogi marinade, and gochujang."
    },
    {
      "position": 2,
      "text": "Cook on High for 3 hours."
    },
    {
      "position": 3,
      "text": "Mix shredded carrots and broccoli into the slow cooker and continue cooking for 1 hour."
    },
    {
      "position": 4,
      "text": "Stir in cilantro and cook 15 minutes more. Serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 255,

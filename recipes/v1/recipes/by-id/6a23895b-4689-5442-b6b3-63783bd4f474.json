  "id": "6a23895b-4689-5442-b6b3-63783bd4f474",
  "slug": "purple-carrot-cake",
  "name": "Purple Carrot Cake",
  "recipe_type": "dessert",
  "brief_description": "Traditional carrot cake gets a makeover by using purple carrots. The cake comes out light and moist, not too sweet, with a rich purple color for a stunning presentation.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with butter."
    },
    {
      "position": 2,
      "text": "Combine grated carrots, brown sugar sugar, white sugar, and lemon zest in a bowl. Toss to coat and allow the natural juices to come out. Set aside."
    },
    {
      "position": 3,
      "text": "Mix flour, baking powder, cinnamon, and nutmeg together in a separate bowl."
    },
    {
      "position": 4,
      "text": "Whisk eggs, applesauce, oil, and vanilla extract together in a large bowl. Add flour mixture 1/4 cup at a time, mixing until just combined. Fold in carrot-sugar mixture with all the juice that has accumulated. Add food coloring. Pour batter into the prepared baking dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 45 minutes."
    },
    {
      "position": 6,
      "text": "Cool cake on a wire rack for 5 minutes. Run a table knife around the edges of the pan to loosen. Invert cake carefully onto a serving plate or cooling rack. Let cool completely."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "1af2f233-b9a5-527c-83c6-f47faeabf7b2",
  "slug": "perfect-pomegranate-cranberry-sauce",
  "name": "Perfect Pomegranate Cranberry Sauce",
  "recipe_type": "side",
  "brief_description": "Jazz up your cranberry sauce this year with the addition of pomegranate seeds and port wine to your traditional Thanksgiving table side dish.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine cranberries, sugar, orange juice, water, corn syrup, port wine, lime juice, cinnamon sticks, 1 1/2 teaspoons orange zest, cloves, and 1/4 the pomegranate seeds in a heavy pot; bring to a boil. Reduce heat to low and simmer, stirring occasionally, until cranberries pop and sauce is thickened, about 30 minutes."
    },
    {
      "position": 2,
      "text": "Taste the sauce and add more sugar, corn syrup, or port wine if desired. Remove cloves or cinnamon if the taste is overpowering at this point and add more port wine or lime juice."
    },
    {
      "position": 3,
      "text": "Continue to simmer sauce, stirring occasionally, until desired consistency is reached, 15 to 30 minutes. Remove pot from heat and cool, about 30 minutes. Sauce will thicken as it cools. Remove cinnamon sticks and cloves if still in sauce. Stir remaining pomegranate seeds into sauce and garnish with remaining 1 1/2 teaspoons orange zest."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

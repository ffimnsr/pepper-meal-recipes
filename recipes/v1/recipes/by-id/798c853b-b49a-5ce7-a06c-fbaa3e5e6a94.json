  "id": "798c853b-b49a-5ce7-a06c-fbaa3e5e6a94",
  "slug": "sweet-potato-pie-ii",
  "name": "Sweet Potato Pie II",
  "recipe_type": "soup",
  "brief_description": "My brother loved this pie so much that he learned to make it.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "In a mixing bowl, combine the sweet potatoes, butter, egg yolks, brown sugar, salt, ginger, cinnamon, nutmeg and evaporated milk. Mix together well."
    },
    {
      "position": 3,
      "text": "Beat egg whites until stiff peaks form; add 1/4 cup sugar and fold into sweet potato mixture."
    },
    {
      "position": 4,
      "text": "Pour into pie shell and bake at 400 degrees F (200 degrees C) for 10 minutes. Reduce heat and bake at 350 degrees F (175 degrees C) for 30 minutes or until firm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,

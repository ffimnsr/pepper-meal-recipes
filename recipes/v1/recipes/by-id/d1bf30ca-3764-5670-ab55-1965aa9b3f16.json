  "slug": "easy-and-delicious-chicken-and-rice-casserole",
  "name": "Easy and Delicious Chicken and Rice Casserole",
  "recipe_type": "main",
  "brief_description": "Four simple ingredients go into this creamy casserole. Feel free to add fresh or frozen vegetables for a convenient one-dish meal.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Spread rice in the bottom of a 9x13 inch baking dish. Rinse chicken and pat dry; arrange chicken pieces on top of rice."
    },
    {
      "position": 3,
      "text": "Mix soup and water together and pour over chicken and rice. Sprinkle dry onion soup mix on top. Cover and seal TIGHTLY with foil. Bake in the preheated oven for 1 to 1 1/2 hours. Enjoy!"
    }
  ],
  "servings": 5,

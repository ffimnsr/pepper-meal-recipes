  "id": "b09c6f5b-4421-5799-812f-5c0800e31b4a",
  "slug": "jalapeno-popper-pigs-in-a-blanket-recipe-8584146",
  "name": "Jalape\u00f1o Popper Pigs in a Blanket",
  "recipe_type": "appetizer",
  "brief_description": "These jalape\u00f1o popper pigs in a blanket are a combo of jalapeno poppers and pigs in a blanket, and are so quick and easy, they may become a new favorite way to do both.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line 2 baking sheets with parchment. Rinse jalape\u00f1os to remove any remaining seeds and pat dry."
    },
    {
      "position": 2,
      "text": "Stir cream cheese and Cheddar cheese together in a bowl until well combined. Divide cheese mixture among jalape\u00f1o halves and top each with a sausage."
    },
    {
      "position": 3,
      "text": "Separate crescent dough into 16 triangles. Roll each filled pepper in crescent dough and place on the prepared baking sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, 13 to 15 minutes. Let stand for 5 minutes before serving."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

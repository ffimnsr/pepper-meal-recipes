  "id": "265a77b7-d78b-51fe-877a-09938db2f7b6",
  "slug": "pasta-with-scallops-zucchini-and-tomatoes",
  "name": "Pasta with Scallops, Zucchini, and Tomatoes",
  "recipe_type": "appetizer",
  "brief_description": "This scallop pasta recipe with tomatoes, garlic, and zucchini is an elegant seafood dish that can be served as a main dish or summer appetizer.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat oil in a large skillet; stir in garlic and cook until tender. Add zucchini, salt, and red pepper flakes; saut\u00e9 for 10 minutes. Stir in chopped tomatoes, bay scallops, and fresh basil; simmer for 5 minutes, or until scallops are opaque."
    },
    {
      "position": 3,
      "text": "Pour sauce over cooked pasta and serve with grated Parmesan cheese."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "meyer-lemon-avocado-toast",
  "name": "Meyer Lemon Avocado Toast",
  "recipe_type": "appetizer",
  "brief_description": "This avocado toast recipe, made with Meyer lemon juice and zest, is topped with chia seeds for a hearty, vegan snack or lunch that is quick and easy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Toast bread slices to desired doneness, 3 to 5 minutes."
    },
    {
      "position": 2,
      "text": "Mash avocado in a medium bowl; stir in cilantro, Meyer lemon zest, Meyer lemon juice, cayenne pepper, and sea salt until well combined. Spread avocado mixture onto toast; top with chia seeds."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,

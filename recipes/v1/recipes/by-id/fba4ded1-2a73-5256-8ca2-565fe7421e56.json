  "id": "fba4ded1-2a73-5256-8ca2-565fe7421e56",
  "slug": "italian-sausage-stuffed-zucchini-boats-recipe-11967121",
  "name": "Italian Sausage Stuffed Zucchini Boats",
  "recipe_type": "main",
  "brief_description": "These Italian sausage stuffed zucchini boats are the summer recipe for the abundant garden. Firm, fresh zucchini make the perfect boats to fill with sausage, breadcrumbs, and melty cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Cut each zucchini in half lengthwise. Use a measuring spoon or melon baller to scoop out the center of each half, leaving a 1/4 -inch border. Set aside zucchini and chop flesh and set aside."
    },
    {
      "position": 2,
      "text": "Heat a large deep skillet over medium-high heat. Add sausage and cook until browned and crumbled. Add onion and cook, stirring constantly, until it begins to soften. Add garlic and reserved chopped zucchini flesh and cook until onions are softened, 2 to 3 minutes. Add 1 1/2 cups marinara and stir to combine. Bring mixture to a simmer, reduce heat slightly and cook 5 minutes to slightly thicken. Remove from heat and stir in 1 cup cheese and bread crumbs."
    },
    {
      "position": 3,
      "text": "Fill each prepared zucchini half with sausage mixture and place in a 9x13-inch baking dish."
    },
    {
      "position": 4,
      "text": "Add 1/2 cup water to remaining sauce in the marinara jar. Add cinnamon, coriander, and nutmeg if desired. Cover and shake gently to combine and pour sauce around stuffed zucchini. Top with remaining cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until heated through, browned and bubbly, and zucchini is tender, about 20 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

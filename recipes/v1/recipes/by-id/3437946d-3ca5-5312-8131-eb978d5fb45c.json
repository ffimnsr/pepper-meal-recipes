  "id": "3437946d-3ca5-5312-8131-eb978d5fb45c",
  "slug": "arrabbiata-sauce",
  "name": "Arrabbiata Sauce",
  "recipe_type": "main",
  "brief_description": "Arrabbiata sauce is a spicy, Italian, tomato-based sauce for pasta. In this easy recipe \u2014 a sizeable jolt of crushed red pepper revs up the heat!",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large skillet or saucepan over medium heat. Add onion and garlic; cook and stir until softened, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir in diced tomatoes, wine, tomato paste, sugar, basil, lemon juice, red pepper flakes, Italian seasoning, and black pepper; bring to a boil. Reduce heat to medium and simmer, uncovered, for about 15 minutes."
    },
    {
      "position": 3,
      "text": "Stir in parsley. Ladle sauce over hot cooked pasta of your choice."
    },
    {
      "position": 4,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "bc8778f2-47c2-51a5-8b00-98135691f4f5",
  "slug": "pumpkin-apple-streusel-muffins",
  "name": "Pumpkin Apple Streusel Muffins",
  "recipe_type": "dessert",
  "brief_description": "This pumpkin apple streusel muffin recipe features the texture of apples with the warm taste of pumpkin, while the streusel topping adds extra sweetness.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 18 muffin cups or line cups with paper liners."
    },
    {
      "position": 2,
      "text": "Sift 2 \u00bd cups flour, 2 cups sugar, pumpkin pie spice, baking soda, and salt together into a bowl. Combine pumpkin pur\u00e9e, oil, and eggs in a separate bowl; stir into flour mixture until batter is just moistened. Fold in apples."
    },
    {
      "position": 3,
      "text": "Divide batter among the prepared muffin cups, filling each to the top."
    },
    {
      "position": 4,
      "text": "Whisk remaining \u00bc cup sugar, 2 tablespoons flour, and cinnamon together in a bowl; cut in butter with 2 knives or a pastry blender until mixture resembles coarse crumbs. Sprinkle cinnamon topping evenly over muffin batter."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into muffins comes out clean, 35 to 40 minutes."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

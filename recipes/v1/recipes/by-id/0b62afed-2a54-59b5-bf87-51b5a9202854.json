  "id": "0b62afed-2a54-59b5-bf87-51b5a9202854",
  "slug": "chakchouka-shakshouka",
  "name": "Shakshuka",
  "recipe_type": "breakfast",
  "brief_description": "Shakshuka is a classic North African and Middle Eastern breakfast dish of gently poached eggs in a delicious tomato sauce with onion, garlic, and spices.",
  "cuisine": "Israeli African",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a skillet over medium heat. Stir in onion, bell pepper, and garlic; cook and stir until vegetables have softened and onion has turned translucent, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, mix together tomatoes, chile pepper, cumin, paprika, and salt in a bowl."
    },
    {
      "position": 4,
      "text": "Stir tomato mixture into onion mixture. Simmer, uncovered, until tomato juices have cooked off, about 10 minutes."
    },
    {
      "position": 5,
      "text": "Make 4 indentations in tomato mixture; crack eggs into indentations. Cover the skillet and cook until eggs are firm but not dry, about 5 minutes."
    },
    {
      "position": 6,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "name": "Kale and Banana Smoothie",
  "recipe_type": "breakfast",
  "brief_description": "This kale smoothie with banana is perfect to help get your daily fruits and veggies. Nutrient-rich kale is mixed in with this tasty, easy smoothie.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place kale, banana, soy milk, flax seeds, and maple syrup into a blender."
    },
    {
      "position": 3,
      "text": "Cover and pur\u00e9e until smooth."
    },
    {
      "position": 4,
      "text": "Serve over ice."
    }

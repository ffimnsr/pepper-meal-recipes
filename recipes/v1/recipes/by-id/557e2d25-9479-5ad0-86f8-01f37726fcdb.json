{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "557e2d25-9479-5ad0-86f8-01f37726fcdb",
  "slug": "hamburger-steak-with-onions-and-gravy",
  "name": "Hamburger Steak with Onions and Gravy",
  "recipe_type": "main",
  "brief_description": "These tasty hamburger \"steaks\" are smothered in gravy and onions. It's a great way to dress up a pound of ground beef using easy ingredients.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix ground beef, bread crumbs, egg, Worcestershire sauce, salt, onion powder, garlic powder, and pepper together in a large bowl until combined. Form into 8 balls and flatten into patties."
    },
    {
      "position": 3,
      "text": "Heat oil in a large skillet over medium heat. Add patties and onion; fry until patties are nicely browned, about 4 minutes per side. Transfer beef patties to a plate, and keep warm."
    },
    {
      "position": 4,
      "text": "Sprinkle flour over onions and drippings in the skillet. Stir in flour with a fork, scraping bits of beef off of the bottom of the skillet as you stir. Gradually mix in beef broth and sherry. Season with seasoned salt. Simmer and stir over medium-low heat until gravy thickens, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Reduce heat to low, return patties to the gravy, cover, and simmer until cooked through, about 15 minutes."
    },
    {
      "position": 6,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

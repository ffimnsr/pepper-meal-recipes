  "id": "60ac296f-ff3e-5215-bc04-81e83d05ff3c",
  "slug": "hatteras-style-clam-chowder",
  "name": "Hatteras Style Clam Chowder",
  "recipe_type": "soup",
  "brief_description": "No cream, but a potful of clam juice in this chowder with potatoes, thyme and bacon.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "In a large pot over medium heat, cook onion, celery and carrots in oil until they begin to soften. Stir in potatoes, clams, clam juice, thyme, pepper and bacon. Bring to a boil, then reduce heat and simmer 20 minutes, or until potatoes are tender."
    }
  ],
  "servings": 8,

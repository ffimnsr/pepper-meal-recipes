  "id": "21ce8136-a73c-5374-91a1-42f50d860390",
  "slug": "smokey-butternut-squash-soup",
  "name": "Smokey Butternut Squash Soup",
  "recipe_type": "soup",
  "brief_description": "Enjoy the spicy, smokey flavor of this butternut squash soup topped with pomegranate seeds, goat cheese, and crispy Brussels sprouts.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Line a roasting pan with a large sheet of aluminum foil."
    },
    {
      "position": 2,
      "text": "Toss butternut squash, shallot, 2 tablespoons canola oil, paprika, chili powder, chipotle powder, and ginger together in a bowl until evenly mixed and coated. Pour into prepared roasting pan and wrap aluminum foil around squash mixture."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until squash is tender, 30 to 40 minutes."
    },
    {
      "position": 4,
      "text": "Heat 1 tablespoon canola oil in a cast-iron skillet over medium heat. Cook and stir reserved butternut squash seeds, pinch salt, and pinch ground black pepper in the skillet until lightly toasted, 5 minutes. Add Brussels sprouts leaves and cook, stirring occasionally, until leaves are slightly crispy and seeds are browned, 10 to 15 minutes. Stir maple syrup into seed mixture and immediately remove from heat."
    },
    {
      "position": 5,
      "text": "Pour butternut squash mixture and almond milk into a blender no more than half full. Cover and hold lid down; pulse a few times before leaving on to blend. Puree in batches until soup is smooth."
    },
    {
      "position": 6,
      "text": "Pour butternut squash soup into bowls and top with squash seeds and Brussels sprouts mixture, pomegranate seeds, and goat cheese."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

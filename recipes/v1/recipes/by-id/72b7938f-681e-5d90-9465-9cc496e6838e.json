  "id": "72b7938f-681e-5d90-9465-9cc496e6838e",
  "slug": "garlic-and-herb-pull-apart-bread",
  "name": "Garlic and Herb Pull Apart Bread",
  "recipe_type": "salad",
  "brief_description": "This doughy, garlic, and herb pull-apart bread recipe is easy to make and fun to eat as a side for pasta or salad. You can modify the amount of garlic.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a fluted tube pan (such as a Bundt) with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine butter, garlic, parsley, rosemary, and basil in a bowl. Separate biscuits; dip each into butter-herb mixture. Place biscuits in a random pattern into the prepared pan. Pour any remaining butter-herb mixture over biscuits."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until browned and cooked through, 15 to 20 minutes. Invert the pan on a cutting board; bread will fall out of the pan in one piece. Serve by pulling bread apart into individual servings."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

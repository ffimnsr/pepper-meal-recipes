  "id": "06455b19-1aae-53d0-8a43-7ce5f8949f93",
  "slug": "smokey-vegetarian-cuban-black-bean-soup",
  "name": "Smokey Vegetarian Cuban Black Bean Soup",
  "recipe_type": "soup",
  "brief_description": "Vegetarian black bean soup made with tempeh, veggies, and a splash of rum is a hearty, Cuban-inspired meal both vegetarians and meat-eaters will love.",
  "cuisine": "Cuban American Caribbean",
  "instructions": [
    {
      "position": 1,
      "text": "Place black beans into a large container and cover with several inches of cool water; let stand 8 hours to overnight. Drain beans and rinse with fresh water."
    },
    {
      "position": 2,
      "text": "Heat oil in a large Dutch oven or stockpot over medium heat; cook and stir yellow onion, paprika, and cumin seeds until fragrant, about 3 minutes. Add red bell pepper, green bell pepper, garlic, oregano, and bay leaves; cook and stir until onion is translucent and bell peppers are tender, 6 to 8 minutes."
    },
    {
      "position": 3,
      "text": "Mix vegetable stock, black beans, tempeh, rum, and jalapeno pepper into onion mixture. Increase heat to medium-high, bring to a simmer, reduce heat to medium-low, and cook until beans are tender, about 45 minutes."
    },
    {
      "position": 4,
      "text": "Pour water into bean mixture; season with 1 1/2 teaspoons salt. Cook, stirring occasionally, until beans begin to fall apart and soup thickens, 30 to 40 minutes; season with salt and pepper. Remove and discard bay leaves from soup."
    },
    {
      "position": 5,
      "text": "Ladle soup into bowls and garnish with hard-boiled eggs and red onion."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 85,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

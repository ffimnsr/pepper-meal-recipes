  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "17901a6e-164c-5331-accb-1a5ccda748da",
  "slug": "air-fryer-zucchini-fries",
  "name": "Air Fryer Curly Zucchini Fries",
  "recipe_type": "side",
  "brief_description": "These zucchini curly fries with cheesy panko crumbs are a great substitute for regular French fries especially when cooked in the air fryer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut zucchini into two or three 3-inch pieces, then spiralize each piece."
    },
    {
      "position": 2,
      "text": "Whip egg in a shallow bowl until foamy. Carefully pour melted butter into egg and whip until blended."
    },
    {
      "position": 3,
      "text": "Combine flour, oregano, garlic powder, and pepper in a second shallow bowl. Stir together panko bread crumbs and Parmesan cheese in a third bowl."
    },
    {
      "position": 4,
      "text": "Dredge zucchini spirals in seasoned flour mixture, shaking off excess flour. Dip spirals in egg wash, allowing excess wash to drip off, and then dredge spirals in Parmesan-bread crumbs. Place on a clean sheet pan."
    },
    {
      "position": 5,
      "text": "Set air fryer temperature to 400 degrees F (200 degrees C). Set timer for 12 minutes. Transfer breaded zucchini fries into the air fryer basket in batches without crowding. Cook until crispy, about 12 minutes. Serve immediately."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

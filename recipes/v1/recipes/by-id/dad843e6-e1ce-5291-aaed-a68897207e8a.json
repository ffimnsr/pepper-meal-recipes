  "id": "dad843e6-e1ce-5291-aaed-a68897207e8a",
  "slug": "taco-cheese-ball-wreath",
  "name": "Taco Cheese Ball Wreath",
  "recipe_type": "appetizer",
  "brief_description": "With a surprising taco-flavor, this rich and creamy cheese ball is shaped and decorated like a wreath so it's perfect for your holiday table.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line a 16-ounce bowl with plastic wrap, allowing excess to hang over the sides."
    },
    {
      "position": 2,
      "text": "Combine cream cheese, Monterey Jack cheese, and taco seasoning in a food processor; process until well combined. Add green onions, \u00bd of the cilantro leaves, and green chiles and pulse until well combined with flecks of green; do not fully process."
    },
    {
      "position": 3,
      "text": "Transfer cheese mixture to the lined bowl and press to smooth. Cover and refrigerator for at least 4 hours or up to 8 hours or overnight."
    },
    {
      "position": 4,
      "text": "Invert cheese onto a serving platter and remove plastic. Use a small shot glass or spoon to create a hole in the center of the cheese to form a wreath shape."
    },
    {
      "position": 5,
      "text": "Finely chop remaining cilantro leaves and lightly cover the top of the cheese. Combine tomato, onion, and jalapeno in a small bowl and place over the cilantro in a 1-inch ring around the wreath."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

  "id": "a857d6e4-4941-5ebb-b153-dc4e8f78e585",
  "slug": "american-shepherds-pie",
  "name": "American Shepherd's Pie",
  "recipe_type": "soup",
  "brief_description": "This shepherd's pie with cheese, ground beef, condensed vegetable soup, and onions is smothered in mashed potatoes and baked for a hot, hearty dinner.",
  "cuisine": "American Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 2-quart baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef, onion, and celery in the hot skillet until beef is browned and crumbly. Drain and discard grease."
    },
    {
      "position": 3,
      "text": "Pour beef mixture into the prepared baking dish. Add condensed soup and thyme; stir well. Spread mashed potatoes evenly on top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 20 minutes. Sprinkle with cheese and continue baking until cheese has melted, about 5 minutes more."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

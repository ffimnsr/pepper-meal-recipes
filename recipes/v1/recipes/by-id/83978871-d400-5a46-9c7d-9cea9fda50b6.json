  "id": "83978871-d400-5a46-9c7d-9cea9fda50b6",
  "slug": "easy-chicken-bog-recipe-11913558",
  "name": "Easy Chicken Bog",
  "recipe_type": "main",
  "brief_description": "This easy chicken bog is a chicken, sausage, and rice one\u2014pot dish from the South Carolina Lowcountry region of the US.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken in a Dutch oven and add water just to cover. Add onion, celery, garlic, 2 1/2 teaspoons salt and pepper. Bring to a boil, cover, and reduce heat to a simmer. Cook, covered, for 1 hour 15 minutes."
    },
    {
      "position": 2,
      "text": "Transfer chicken to a cutting board and let rest until cool enough to handle. Shred chicken and set aside. Discard bones and skin."
    },
    {
      "position": 3,
      "text": "Strain chicken broth and set aside. Optional, chop celery and onion and reserve with chicken."
    },
    {
      "position": 4,
      "text": "Wipe any debris from the pot or lightly rinse the pot if desired. Return pot to stove over medium-high heat and add butter to melt. Add sausage and cook until well browned. Pour reserved chicken broth and remaining salt into the pot and bring to a boil. Stir in rice and reserved chicken and return to a simmer. Stir once, reduce heat, cover and simmer until rice is tender and most of the liquid has been absorbed, about 20 minutes. Turn off the heat and let stand, covered, for 5 to 10 minutes."
    },
    {
      "position": 5,
      "text": "Serve topped with green onions, additional black pepper, and sliced okra if desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 100,
  "preparation_time_minutes": 20,

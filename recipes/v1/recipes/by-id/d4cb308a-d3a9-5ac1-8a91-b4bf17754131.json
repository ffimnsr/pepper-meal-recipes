  "id": "d4cb308a-d3a9-5ac1-8a91-b4bf17754131",
  "slug": "bread-maker-doughnuts",
  "name": "Bread Maker Doughnuts",
  "recipe_type": "breakfast",
  "brief_description": "Use your bread machine to make light, yeast-risen dough for delicious homemade deep-fried doughnuts.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place milk, egg, butter, flour, sugar, salt, and yeast into a bread machine in the order listed, or follow the order recommended by your manufacturer if different. Run Dough cycle."
    },
    {
      "position": 2,
      "text": "Remove dough from the machine after the cycle is done, about 90 minutes."
    },
    {
      "position": 3,
      "text": "Knead dough a few times on a floured work surface to collapse all the bubbles. Cut dough into 16 pieces. Cover with a damp cloth and let rest for 20 minutes."
    },
    {
      "position": 4,
      "text": "Stretch each ball out into a 1/4-inch-thick disk. Use a small cutter to cut a hole in the center of each disk. Let doughnuts rise on the floured surface until doubled in size, 30 to 40 minutes."
    },
    {
      "position": 5,
      "text": "Heat oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C)."
    },
    {
      "position": 6,
      "text": "Working in batches of 2 to 3, gently place doughnuts into hot oil; fry until they float to the top and turn golden brown, about 3 minutes. Flip doughnuts and repeat on the other side. Drain on paper towels."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

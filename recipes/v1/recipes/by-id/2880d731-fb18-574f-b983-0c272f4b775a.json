  "id": "2880d731-fb18-574f-b983-0c272f4b775a",
  "slug": "gluten-free-sugar-cookies",
  "name": "Gluten-Free Sugar Cookies",
  "recipe_type": "dessert",
  "brief_description": "These soft gluten-free sugar cookies bake up beautifully! Use cookie cutters to cut out shapes for any holiday and top with icing for a sweet treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk flour, baking powder, and salt together in a bowl."
    },
    {
      "position": 3,
      "text": "Beat white sugar, \u00be cup butter, and 1 teaspoon vanilla extract in a bowl with an electric mixer until creamy, 3 to 4 minutes. Beat in eggs, one at a time, until mixture is smooth. Gradually mix in flour mixture until a dough forms."
    },
    {
      "position": 4,
      "text": "Form dough into a ball; wrap in plastic wrap and refrigerate for 1 hour."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line two baking sheets with parchment paper or silicon baking mats."
    },
    {
      "position": 6,
      "text": "Roll dough on a lightly floured surface and cut into desired shapes using cookie cutters. Arrange cookies on the prepared baking sheets."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until edges begin to brown, about 10 minutes, switching racks halfway through. Cool on the baking sheet briefly before transferring to a wire rack to cool completely, 8 to 10 minutes more."
    },
    {
      "position": 8,
      "text": "Meanwhile, beat cream cheese, \u00bc cup butter, and 1 teaspoon vanilla extract in a bowl using an electric mixer until well combined. Slowly beat in confectioners' sugar until icing is smooth."
    },
    {
      "position": 9,
      "text": "Spread icing onto cooled cookies."
    }
  ],
  "servings": 40,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

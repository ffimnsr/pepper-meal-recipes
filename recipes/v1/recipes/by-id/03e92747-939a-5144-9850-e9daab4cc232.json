  "id": "03e92747-939a-5144-9850-e9daab4cc232",
  "slug": "jewish-shortbread",
  "name": "Jewish Shortbread",
  "recipe_type": "dessert",
  "brief_description": "This is a lovely, not too sweet shortbread, topped with cinnamon sugar. I use walnuts, but feel free to use any nut you wish!",
  "cuisine": "Jewish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large bowl, cream together the butter and 1/3 cup of sugar until smooth. Mix in the walnuts, vanilla, salt and flour until well blended. Shape tablespoonfuls of dough into crescent shapes. Place 1 inch apart on an ungreased baking sheet."
    },
    {
      "position": 3,
      "text": "Bake for 15 to 20 minutes in the preheated oven, until the bottoms begin to brown. In a small bowl, mix together the remaining 1/2 cup of sugar and cinnamon. Roll the cookies in the cinnamon sugar while still hot. Cool completely before storing in an airtight tin."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

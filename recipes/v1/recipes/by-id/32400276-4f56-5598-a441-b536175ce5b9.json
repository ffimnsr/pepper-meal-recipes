  "slug": "high-protein-cottage-cheese-mac-and-cheese-recipe-11687838",
  "name": "High Protein Cottage Cheese Mac and Cheese",
  "recipe_type": "side",
  "brief_description": "This high-protein cottage cheese mac and cheese is both creamy and satisfying. It\u2019s a great option for those looking to boost their protein intake. Everything seasoning adds a fun twist.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of salted water to boil. Add pasta and cook until tender with a bite, about 7 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile in a food processor or high-powered blender add cottage cheese, Cheddar cheese, Parmigiano Reggiano, Cheddar cheese powder, Worcestershire, Dijon, and milk. Season with salt and pepper. Blend until smooth."
    },
    {
      "position": 3,
      "text": "Drain pasta, and return pasta to pan. Pour in cheese sauce. Add everything bagel seasoning; stir to combine. Serve immediately."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

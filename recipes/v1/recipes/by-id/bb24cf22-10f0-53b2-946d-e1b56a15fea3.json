  "id": "bb24cf22-10f0-53b2-946d-e1b56a15fea3",
  "slug": "japanese-style-pickled-cucumber-sunomono",
  "name": "Japanese-Style Pickled Cucumber (Sunomono)",
  "recipe_type": "side",
  "brief_description": "Japanese pickled cucumbers are marinated in rice vinegar, soy sauce, and sesame oil in this Asian pickled vegetable recipe, a quick and easy dish.",
  "cuisine": "Asian Inspired Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Place Persian cucumbers in a bowl; add salt and mix well. Let sit until cucumbers release their juices, about 10 minutes. Squeeze excess juice from cucumbers and drain."
    },
    {
      "position": 2,
      "text": "Whisk together rice vinegar, white sugar, soy sauce, and sesame oil in a bowl until sugar is dissolved; pour over cucumbers. Marinate for 30 minutes. Garnish with sesame seeds."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,

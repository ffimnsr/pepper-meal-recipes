  "id": "a588d168-3898-5504-a7d7-7edfc14077e0",
  "slug": "basic-fruit-bread-recipe",
  "name": "Basic Fruit Bread Recipe",
  "recipe_type": "breakfast",
  "brief_description": "Do not confuse this with the dense Christmas bread with maraschino cherries. This fruit bread recipe is simply a blueprint for making quick bread with fruits or vegetables, from apple to rhubarb or carrot to zucchini.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease one 4 1/2-x 8 1/2-inch loaf pan."
    },
    {
      "position": 2,
      "text": "Mix flour, baking powder, baking soda, salt, sugar, oil, eggs, apple, walnuts, and vanilla in a large bowl until dry ingredients are just moistened. Pour batter into the prepared loaf pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 35 to 40 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

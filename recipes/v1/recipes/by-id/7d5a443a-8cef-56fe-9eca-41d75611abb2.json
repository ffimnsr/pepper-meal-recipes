  "id": "7d5a443a-8cef-56fe-9eca-41d75611abb2",
  "slug": "emilys-chipotle-chili",
  "name": "Emily's Chipotle Chili",
  "recipe_type": "soup",
  "brief_description": "Emily's slow cooker chipotle chili recipe uses hot Italian sausage, ground beef, tomatoes, beans, spices, and chipotle chiles for a subtle, smoky flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook ground beef and sausage in a large pot over medium-high heat until lightly browned and crumbly; drain. Add chili powder, cumin, and coriander; cook and stir until fragrant, about 1 minute. Stir in onion and garlic; cook and stir until onion softened and turned translucent, about 4 minutes."
    },
    {
      "position": 2,
      "text": "Stir in diced tomatoes, tomato sauce, kidney beans, chipotle peppers, salt, and black pepper; bring to a simmer, then transfer chili to a slow cooker. Cover slow cooker."
    },
    {
      "position": 3,
      "text": "Cook on Low for 7 to 9 hours. Stir in tomato paste and cook 1 hour more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 495,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

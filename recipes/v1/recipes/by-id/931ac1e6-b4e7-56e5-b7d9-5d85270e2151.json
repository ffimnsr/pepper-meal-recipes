  "id": "931ac1e6-b4e7-56e5-b7d9-5d85270e2151",
  "slug": "roasted-pork-loin",
  "name": "Roasted Pork Loin",
  "recipe_type": "main",
  "brief_description": "This tender pork loin, roasted with garlic and rosemary and basted with a white wine pan sauce, makes a flavorsome and impressive main dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Crush garlic with rosemary, salt, and pepper in a mortar and pestle to make a paste. If you don\u2019t have a mortar and pestle, mince ingredients finely and mash with the flat side of a knife."
    },
    {
      "position": 3,
      "text": "Pierce meat with a sharp knife in several places and press garlic paste into the openings. Rub pork loin with the remaining garlic mixture and olive oil. Set into a small roasting pan or oven-safe skillet."
    },
    {
      "position": 4,
      "text": "Place pork loin into the preheated oven, turning and basting with pan liquids every 30 minutes. Cook until the pork is no longer pink in the center, 90 minutes to 2 hours. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C). Remove roast to a platter and keep warm."
    },
    {
      "position": 5,
      "text": "Place pan onto the stove over medium-high heat and pour wine into it. Heat wine and stir to loosen browned bits from the bottom of the pan. Simmer for 3 to 5 minutes."
    },
    {
      "position": 6,
      "text": "Slice pork loin and serve with pan juices."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

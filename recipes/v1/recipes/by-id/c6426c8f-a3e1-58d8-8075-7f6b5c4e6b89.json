  "id": "c6426c8f-a3e1-58d8-8075-7f6b5c4e6b89",
  "slug": "instant-pot-chicken-noodle-soup",
  "name": "Easy Instant Pot Chicken Noodle Soup",
  "recipe_type": "soup",
  "brief_description": "Made with either fresh or frozen chicken, this Instant Pot chicken noodle soup is an easy recipe when you're short on time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot), select Saut\u00e9 function, and add butter. Add carrots, celery, and onion to the melted butter; saut\u00e9 until soft, 3 to 5 minutes. Stir in thyme, oregano, salt, and pepper. Cancel Saut\u00e9 function."
    },
    {
      "position": 2,
      "text": "Stir in chicken broth, water, bouillon cubes, and bay leaves. Add frozen chicken breasts. Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 12 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 3,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, 10 minutes. Switch to the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid."
    },
    {
      "position": 4,
      "text": "Remove chicken from the pot. Carefully chop or shred the meat, and add back to the pot."
    },
    {
      "position": 5,
      "text": "Select Saut\u00e9 function and add egg noodles. Cook until noodles are tender yet firm to the bite, 8 to 10 minutes. Stir in dried parsley and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "bebf725f-1077-5bb7-ac06-b207611613a4",
  "slug": "swedish-kringles",
  "name": "Swedish Kringles",
  "recipe_type": "dessert",
  "brief_description": "A Swedish kringle is an irresistible breakfast or dessert pastry with a flaky crust, a buttery, almond-flavored filling, and a sweet almond icing.",
  "cuisine": "Swedish Scandinavian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Make the dough: Cut 1/2 cup butter into 1 cup flour using a knife or pastry blender. Add 1 tablespoon water (or as needed) and mix until crumbly, leaving pea-sized chunks. On a floured surface, roll dough out to 3 or 4 inches in width. Place onto a rectangular cookie sheet."
    },
    {
      "position": 3,
      "text": "Make the filling: In a small saucepan over high heat, bring 1 cup water and 1/2 cup butter to a boil. Remove from the heat and stir in remaining 1 cup flour; mix until smooth. Beat in eggs, one at a time, mixing well after each addition. Stir in 1 teaspoon almond extract. Spread filling over dough."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 55 to 60 minutes. The pastry will fall a little as it cools."
    },
    {
      "position": 5,
      "text": "Meanwhile, make the icing: Combine confectioners\u2019 sugar, cream, 1 tablespoon butter, and remaining 1 teaspoon almond extract."
    },
    {
      "position": 6,
      "text": "Remove kringle from the oven and immediately spread icing over top."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

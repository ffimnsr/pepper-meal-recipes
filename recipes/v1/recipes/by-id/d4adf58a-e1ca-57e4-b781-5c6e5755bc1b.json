  "id": "d4adf58a-e1ca-57e4-b781-5c6e5755bc1b",
  "slug": "oatmeal-chocolate-coconut-chewy",
  "name": "Oatmeal Chocolate Coconut Chewy",
  "recipe_type": "dessert",
  "brief_description": "Irresistible oatmeal coconut cookies full of chocolate chips, shredded coconut, and chopped nuts. Easy to make for a tasty twist on classic treats.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Cream together brown sugar, butter, and white sugar in a large bowl until smooth."
    },
    {
      "position": 3,
      "text": "Beat in eggs one at a time, then stir in milk and vanilla."
    },
    {
      "position": 4,
      "text": "Combine flour, baking soda, and salt; stir into sugar mixture until well blended."
    },
    {
      "position": 5,
      "text": "Stir in oats, chocolate chips, walnuts, and coconut until evenly distributed."
    },
    {
      "position": 6,
      "text": "Drop by rounded spoonfuls onto ungreased cookie sheets. Bake in the preheated oven for 10 to 12 minutes for a chewy cookie or 14 minutes for a firmer cookie."
    },
    {
      "position": 7,
      "text": "Cool for 1 minute on the cookie sheets and then remove to wire rack. Cool completely and then store in a tightly sealed container."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

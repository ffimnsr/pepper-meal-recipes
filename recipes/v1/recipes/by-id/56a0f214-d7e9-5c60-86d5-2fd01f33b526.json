  "id": "56a0f214-d7e9-5c60-86d5-2fd01f33b526",
  "slug": "steffs-shepherd-pie",
  "name": "Steff's Shepherd Pie",
  "recipe_type": "main",
  "brief_description": "A hearty and comforting dish that your whole family will love.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cook and stir ground beef in a skillet over medium-high heat until beef is browned, about 10 minutes. Drain fat. Mix in green beans, cream of mushroom soup, and onion."
    },
    {
      "position": 3,
      "text": "Pour beef mixture into a 2 quart casserole dish and top with Cheddar cheese. Spread mashed potato on top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the pie is hot, and the mashed potatoes are golden brown, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 5,

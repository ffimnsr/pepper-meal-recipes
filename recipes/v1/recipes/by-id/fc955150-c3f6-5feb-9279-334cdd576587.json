  "id": "fc955150-c3f6-5feb-9279-334cdd576587",
  "slug": "callys-omelet",
  "name": "Cally's Omelet",
  "recipe_type": "breakfast",
  "brief_description": "Steak and veggies are sauteed together in this delicious morning favorite made with egg substitute.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a medium saucepan over medium heat. Stir in green bell pepper, red bell pepper, onion and portobello mushrooms. Cook until tender, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir beef into the vegetable mixture, and cook until evenly brown, 5 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Stir egg beaters into the mixture, and cook 10 minutes, or until firm."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

  "id": "9bb6df4a-0286-53bd-8357-30f894997382",
  "slug": "deviled-egg-tater-tot-bites-recipe-11934587",
  "name": "Deviled Egg Tater Tot Bites",
  "recipe_type": "appetizer",
  "brief_description": "These deviled egg tater tot bites turn a classic party favorite into a crispy, crowd-pleasing appetizer with a playful twist. Golden potato cups are filled with a creamy, tangy deviled egg mixture for the perfect bite-sized combination of crunch and flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease 24 (1 3/4-inch) muffin cups with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Place 1 thawed potato nugget in the bottom of each muffin cup and press firmly with your thumb or the back of a teaspoon to form a crust with a well in the center. Bake until crisp and golden, about 20 minutes. Transfer potato cups to a wire rack and let cool slightly."
    },
    {
      "position": 3,
      "text": "Meanwhile, place eggs in a saucepan and add enough cold water to cover by 1 inch. Bring to a boil over high heat. Remove from heat, cover, and let stand for 15 minutes. Transfer eggs to an ice bath and cool for 5 minutes. Peel and set aside."
    },
    {
      "position": 4,
      "text": "Add mayonnaise, relish, mustard, celery salt, hot sauce, black pepper, and paprika to a food processor and pulse until combined. Add peeled eggs and process until smooth. Transfer deviled egg filling to a piping bag and refrigerate until potato cups are just warm to the touch."
    },
    {
      "position": 5,
      "text": "Pipe deviled egg filling evenly into potato cups."
    },
    {
      "position": 6,
      "text": "Garnish with chives and a sprinkle of paprika. Recipe developed by Barrett Heald"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

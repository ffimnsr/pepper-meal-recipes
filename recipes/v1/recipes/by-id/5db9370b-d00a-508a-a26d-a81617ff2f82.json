  "id": "5db9370b-d00a-508a-a26d-a81617ff2f82",
  "slug": "sausage-gravy-iii",
  "name": "Sausage Gravy III",
  "recipe_type": "breakfast",
  "brief_description": "This is a simple and great recipe for sausage gravy that you can serve over hot biscuits. This is a great breakfast treat. Hearty and delectable.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large skillet over medium high heat, saute the sausage for 10 minutes, or until browned. Stir in the margarine until well blended, then stir in the flour until mixture is thick and pasty."
    },
    {
      "position": 2,
      "text": "Reduce heat to medium low and slowly add the milk, stirring constantly, until mixture is thick and bubbly and to desired consistency. Season with salt and pepper to taste."
    }
  ],

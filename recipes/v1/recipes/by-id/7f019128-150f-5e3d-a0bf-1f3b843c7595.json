  "id": "7f019128-150f-5e3d-a0bf-1f3b843c7595",
  "slug": "creamy-cornbread-casserole",
  "name": "Creamy Cornbread Casserole",
  "recipe_type": "main",
  "brief_description": "A deliciously moist and dense cornbread with a topping of melted cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Lightly grease a 9x13 inch baking pan."
    },
    {
      "position": 2,
      "text": "In a large mixing bowl, combine corn, reserved liquid, eggs, corn bread mix and sour cream; stir until blended. Pour batter into prepared pan; sprinkle with cheese."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 30 minutes, until golden brown."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

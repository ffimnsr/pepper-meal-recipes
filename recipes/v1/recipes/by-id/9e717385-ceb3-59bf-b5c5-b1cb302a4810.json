  "schema_version": 1,
  "id": "9e717385-ceb3-59bf-b5c5-b1cb302a4810",
  "slug": "crisp-pickled-green-beans",
  "name": "Crisp Pickled Green Beans",
  "recipe_type": "side",
  "brief_description": "These pickled green beans turn out tasty and crisp, with a wonderful garlicky dill flavor and a red pepper flake punch, ready to eat in 2 weeks.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Inspect six \u00bd-pint jars for cracks and rings for rust, discarding any defective ones. Immerse in simmering water. Wash new, unused lids and rings in warm soapy water."
    },
    {
      "position": 3,
      "text": "While the jars are being sterilized, stir together vinegar, water, and salt in a large saucepan. Add garlic and bring to a rolling boil over high heat."
    },
    {
      "position": 4,
      "text": "Trim green beans to 1/4-inch shorter than the jars."
    },
    {
      "position": 5,
      "text": "Remove jars from simmering water. Place 1 sprig of dill and 1\u20448 teaspoon red pepper flakes in each jar. Pack in green beans standing on end."
    },
    {
      "position": 6,
      "text": "Ladle boiling brine (leave out garlic) into the jars, filling within \u00bc-inch of the tops. Seal jars with lids and rings."
    },
    {
      "position": 7,
      "text": "Place a rack in the bottom of a large stockpot and fill halfway with water."
    },
    {
      "position": 8,
      "text": "Bring to a boil and lower jars 2 inches apart into the boiling water using a holder."
    },
    {
      "position": 9,
      "text": "Pour in more boiling water to cover jars by at least 1 inch. Bring to a simmer (do not boil), cover, and process for 10 minutes."
    },
    {
      "position": 10,
      "text": "Remove jars from the stockpot and cool to room temperature, 8 to 12 hours. Test jars for a good seal by pressing on the center of the lid \u2014 it should not move."
    },
    {
      "position": 11,
      "text": "Let green beans ferment for 2 to 3 weeks in a cool, dark space before eating."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

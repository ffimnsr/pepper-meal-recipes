  "id": "c76cdd26-9d49-564e-861e-dc342581805f",
  "slug": "easy-north-carolina-barbeque",
  "name": "Easy North Carolina Barbeque",
  "recipe_type": "main",
  "brief_description": "'Slow and low' is the secret to good barbecue. Slow-roasted pork is simmered in a sauce featuring white vinegar, butter, sugar, and crushed red pepper makes a North Carolina-style barbecue that will have your friends asking how you did it.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Trim the fat from the roast; place in slow cooker and cook on Low overnight, at least 8 hours."
    },
    {
      "position": 2,
      "text": "To make the sauce, whisk together the vinegar, melted butter, salt, lemon juice, crushed red pepper, hot sauce, black pepper, and sugar in a bowl."
    },
    {
      "position": 3,
      "text": "Carefully remove the roast to a cutting board. Pull the meat from the bone with a fork. Return the pork to the slow cooker. Pour the sauce over the pulled pork. Simmer for 1 hour more."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 540,

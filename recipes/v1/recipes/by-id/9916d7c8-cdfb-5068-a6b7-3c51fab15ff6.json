  "slug": "easy-strawberry-vinaigrette",
  "name": "Easy Strawberry Vinaigrette",
  "recipe_type": "salad",
  "brief_description": "This strawberry vinaigrette made with pureed strawberries, honey, cider vinegar, and olive oil is a delicious salad dressing with bright flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Blend strawberries, honey, apple cider vinegar, olive oil, salt, and black pepper together in a blender until smooth."
    },
    {
      "position": 3,
      "text": "Serve and enjoy!"
    }
  ],

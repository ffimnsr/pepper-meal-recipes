  "id": "d9805c69-685f-5249-a322-34096893f23a",
  "slug": "best-beef-stroganoff",
  "name": "Best Beef Stroganoff",
  "recipe_type": "main",
  "brief_description": "In this easy and very tasty beef stroganoff recipe, thin strips of steak are cooked in a rich sour cream sauce with garlic, fresh mushrooms, and red wine.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil; add noodles and cook 5 to 7 minutes or until al dente; drain."
    },
    {
      "position": 2,
      "text": "Melt butter in a large saucepan over medium-high heat. Stir in onions and garlic; cook until slightly tender. Mix in mushrooms, and continue cooking for 2 minutes. Place steak strips in the saucepan and cook for about 1 minute. Mix in consomme, Burgundy, and lemon juice. Bring to a boil."
    },
    {
      "position": 3,
      "text": "In a small bowl, thoroughly blend flour with cold water until smooth. Reduce saucepan heat to low. While stirring constantly, slowly pour flour mixture into saucepan. Gradually return to a boil while stirring rapidly, until sauce is thick and smooth. Cover saucepan and continue cooking for 5 minutes, stirring occasionally. Remove from heat, let cool slightly and stir in sour cream. Serve over cooked egg noodles."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

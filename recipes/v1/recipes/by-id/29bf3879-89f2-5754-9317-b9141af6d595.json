  "id": "29bf3879-89f2-5754-9317-b9141af6d595",
  "slug": "easy-chicken-quiche",
  "name": "Easy Chicken Quiche",
  "recipe_type": "breakfast",
  "brief_description": "Turn leftover chicken into this simple and gourmet chicken savory quiche with Gouda cheese. Just a perfect quick and easy dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease a 9-inch pie dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Line the prepared pie dish with puff pastry, covering base and sides. Trim excess pastry. Brush bottom with Dijon mustard."
    },
    {
      "position": 3,
      "text": "Melt butter in a saucepan over medium heat. Add chopped green onions and cook until tender, about 5 minutes. Add garlic and cook for 1 minute more. Mix in chicken, and cook for 1 minute more."
    },
    {
      "position": 4,
      "text": "Whisk eggs, heavy cream, salt, nutmeg, ground black pepper, and Italian seasoning together in a bowl."
    },
    {
      "position": 5,
      "text": "Layer 1/2 of the Gouda cheese over the puff pastry and top with chicken mixture. Pour in egg mixture. Sprinkle the remaining Gouda cheese on top."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until set and golden, about 25 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

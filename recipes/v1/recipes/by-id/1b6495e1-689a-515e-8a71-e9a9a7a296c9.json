  "id": "1b6495e1-689a-515e-8a71-e9a9a7a296c9",
  "slug": "california-blt-chopped-bagel-recipe-8604129",
  "name": "California BLT Chopped Bagel",
  "recipe_type": "breakfast",
  "brief_description": "To make this California chopped BLT bagel, you'll chop bacon, tomato, avocado, and lettuce into a smear of chive cream cheese, then sandwich it into an everything bagel. It's quick, easy, and so, so good.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Toast bagel until golden brown, about 3 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, slightly spread cream cheese on a cutting board. Add bacon, lettuce, and tomato on top. Sprinkle with salt and pepper, and chop mixture until chunky and well incorporated. Add avocado and chop 5 to 7 more times."
    },
    {
      "position": 3,
      "text": "Gather mixture together; scrape up with a spatula or bench scraper. Spread mixture onto bottom of toasted bagel and place top piece on top. Serve immediately."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

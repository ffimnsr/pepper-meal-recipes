  "id": "99de1dc9-3aa3-58ab-b7c6-7018fc50917d",
  "slug": "cajun-chicken",
  "name": "Cajun Chicken",
  "recipe_type": "salad",
  "brief_description": "These spicy Cajun-style chicken breasts are coated in a generous blend of spices for a delicious addition to any salad or sandwich, either hot or cold!",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk oil, Cajun seasoning, Italian seasoning, lemon-pepper seasoning, and garlic powder together in a large glass or ceramic bowl. Add chicken and toss to evenly coat. Cover the bowl with plastic wrap and marinate in the refrigerator for 30 minutes."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Remove chicken from marinade and shake off excess. Discard remaining marinade."
    },
    {
      "position": 4,
      "text": "Grill chicken on the preheated grill until juices run clear, 6 to 8 minutes per side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

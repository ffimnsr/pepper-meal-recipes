  "id": "17d83f2c-cb89-524f-b45b-cd00cda4c075",
  "slug": "oven-baked-beef-stew",
  "name": "Oven-Baked Beef Stew",
  "recipe_type": "soup",
  "brief_description": "This is a simple beef stew where the meat is browned on the stove and finished in the oven. Use a lean, bone-in piece of beef, and cook the bone with the stew for added flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 2,
      "text": "Pour flour into a shallow bowl and turn beef in flour, shaking meat to remove excess flour. Heat oil in an ovenproof casserole dish over high heat. Brown beef cubes in hot oil in batches on all sides, about 5 minutes per batch. Transfer beef to a plate."
    },
    {
      "position": 3,
      "text": "Add onion, celery, and carrots to the casserole dish, reduce heat to medium, and cook until softened, about 5 minutes. Add garlic and cook for 1 minute. Pour in broth. Return beef to the casserole dish and stir in bay leaves. Cover casserole."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until beef is tender, 1 1/2 to 2 hours. Remove bay leaves before serving and season with salt and pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 110,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

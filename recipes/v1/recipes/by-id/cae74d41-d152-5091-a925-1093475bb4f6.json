  "id": "cae74d41-d152-5091-a925-1093475bb4f6",
  "slug": "best-greek-quinoa-salad",
  "name": "Best Greek Quinoa Salad",
  "recipe_type": "salad",
  "brief_description": "This Greek quinoa salad features tomatoes, kalamata olives, and feta cheese to create a gluten-free salad that's packed with Mediterranean flavor.",
  "cuisine": "Greek Inspired Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Bring broth and quinoa to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until quinoa is tender and water has been absorbed, 15 to 20 minutes. Transfer quinoa to a large bowl and set aside to cool, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Mix tomatoes, parsley, kalamata olives, onion, feta cheese, olive oil, vinegar, and garlic into quinoa. Squeeze lemon juice over quinoa salad, season with salt and pepper, and toss to coat. Chill in refrigerator, 1 to 4 hours."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "name": "Cornflake Crust",
  "recipe_type": "dessert",
  "brief_description": "This cornflake crust couldn't be easier to make. It's the perfect crust to hold a smooth, creamy, no-bake filling. Crushed cornflake cereal, sugar, and butter are stirred together, pressed into a 9-inch pie tin, and chilled.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix crushed cornflakes, sugar, and melted butter thoroughly in a bowl. Press into an 8-or 9-inch pie plate. Chill in the refrigerator before filling."
    }
  ],

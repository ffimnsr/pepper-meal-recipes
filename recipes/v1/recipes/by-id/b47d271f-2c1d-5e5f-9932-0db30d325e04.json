  "id": "b47d271f-2c1d-5e5f-9932-0db30d325e04",
  "slug": "easy-meatloaf",
  "name": "Easy Meatloaf",
  "recipe_type": "main",
  "brief_description": "This easy meatloaf recipe comes together quickly to make one of our best recipes that's been made over 8,000 times and never disappoints!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x5-inch loaf pan."
    },
    {
      "position": 2,
      "text": "Combine ground beef, onion, milk, bread crumbs, and egg in a large bowl, and season with salt and pepper. Press mixture evenly into the prepared loaf pan."
    },
    {
      "position": 3,
      "text": "Stir ketchup, brown sugar, and mustard together in a small bowl until smooth, and spread evenly over the meatloaf."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until no longer pink in the center, about 1 hour. An instant-read thermometer inserted into the middle reads at least 160 degrees F (70 degrees C)."
    },
    {
      "position": 5,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "c946eb22-8e60-533e-bb22-ce6e5972c810",
  "slug": "air-fryer-beef-tenderloin",
  "name": "Air Fryer Beef Tenderloin",
  "recipe_type": "main",
  "brief_description": "This air fryer beef tenderloin recipe is tender like filet mignon and has a lovely crisp crust perfectly seasoned with oregano, salt, and pepper.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Pat dry tenderloin with paper towels and place on a plate. Drizzle oil all over meat, then sprinkle with oregano, salt, and pepper."
    },
    {
      "position": 3,
      "text": "Rub spices and oil into meat."
    },
    {
      "position": 4,
      "text": "Place into the preheated air fryer basket, folding as needed to make it fit. Close the lid."
    },
    {
      "position": 5,
      "text": "Reduce heat to 390 degrees F (198 degrees C) and cook for 22 minutes. Reduce heat to 360 degrees F (182 degrees C) and cook for 10 more minutes. An instant-read thermometer inserted into the center of tenderloin should read 135 degrees F (57 degrees C) for medium doneness."
    },
    {
      "position": 6,
      "text": "Remove tenderloin to a platter. Allow to rest, uncovered, for at least 10 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 5,

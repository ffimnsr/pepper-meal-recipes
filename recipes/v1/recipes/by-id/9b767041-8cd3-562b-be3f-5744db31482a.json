  "slug": "burrata-caprese",
  "name": "Burrata Caprese",
  "recipe_type": "salad",
  "brief_description": "Try subbing burrata cheese for mozzarella cheese in this Caprese salad that's quick, easy, and enjoyable even on the hottest summer days.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together olive oil, vinegar, salt, and pepper in a large bowl until well combined."
    },
    {
      "position": 2,
      "text": "Add tomatoes, burrata cheese, and basil. Toss to combine. Serve immediately."
    }
  ],

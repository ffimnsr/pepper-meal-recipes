{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "c77c52b0-7002-5a76-8daf-c4e8ad3a3566",
  "slug": "tater-tots-casserole",
  "name": "Tater Tots Casserole",
  "recipe_type": "main",
  "brief_description": "This version of the classic casserole using Tater Tots\u00ae has layers of potatoes, cheese, and ground beef for a savory, comfort-food classic.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Prepare a 13x9-inch casserole dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Spread 20 potato nuggets in the casserole dish."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until warmed through, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef and onion in the hot skillet until beef is completely browned, 5 to 7 minutes; drain and discard grease. Season beef mixture with 2 teaspoons Worcestershire sauce, steak seasoning, garlic powder, and black pepper."
    },
    {
      "position": 5,
      "text": "Stir cream of mushroom soup, milk, 1/2 cup Cheddar cheese, and 1 teaspoon Worcestershire sauce together in a bowl."
    },
    {
      "position": 6,
      "text": "Smash the warmed potato nuggets in the casserole dish to cover the bottom completely. Spread ground beef mixture over the mashed potato nuggets. Pour soup mixture evenly over the beef layer. Top with remaining potato nuggets and sprinkle 1 cup Cheddar cheese evenly over the nuggets."
    },
    {
      "position": 7,
      "text": "Bake in preheated oven until casserole is bubbly and potatoes golden brown, 30 to 40 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

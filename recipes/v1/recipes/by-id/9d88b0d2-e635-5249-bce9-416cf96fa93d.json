  "id": "9d88b0d2-e635-5249-bce9-416cf96fa93d",
  "slug": "easy-creamy-pesto",
  "name": "Easy Creamy Pesto",
  "recipe_type": "side",
  "brief_description": "Pesto gets a creamy boost with butter, heavy cream, and sour cream in this quick and easy recipe that goes well with pasta, veggies, and chicken.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a medium saucepan over medium heat. Stir in heavy cream. Add flour and mix well to remove clumps. Season with salt and pepper."
    },
    {
      "position": 2,
      "text": "Stir sour cream and pesto into the saucepan. Reduce heat to medium-low; simmer, stirring, until flavors combine, 2 to 3 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,

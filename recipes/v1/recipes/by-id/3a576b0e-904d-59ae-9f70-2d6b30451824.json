  "id": "3a576b0e-904d-59ae-9f70-2d6b30451824",
  "slug": "air-fryer-turkey-stuffed-peppers-recipe-11806210",
  "name": "Air Fryer Turkey Stuffed Peppers",
  "recipe_type": "main",
  "brief_description": "These air fryer turkey stuffed peppers are colorful and tasty and take only about 20 minutes in the air fryer. Peppers are stuffed with a simple ground turkey filling with Italian herb seasoning and they are finished with melted mozzarella cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Wash and dry peppers, and cut in half from top to bottom. Remove seeds and white membranes, and trim away stems."
    },
    {
      "position": 2,
      "text": "Brush the outside of each pepper half with olive oil, and place on a work surface, cut side up; sprinkle the inside of each very lightly with salt, about 1/4 teaspoon total."
    },
    {
      "position": 3,
      "text": "In a large bowl, combine egg, ketchup, Italian seasoning, red pepper flakes, black pepper, and remaining 1/2 teaspoon salt. Stir vigorously with a fork or small whisk, until ingredients are well blended."
    },
    {
      "position": 4,
      "text": "Add ground turkey, cooked rice, minced onion, and minced garlic to the bowl. Using clean hands, mix the ingredients until evenly combined."
    },
    {
      "position": 5,
      "text": "Divide turkey mixture evenly into the prepared bell pepper halves, and spray the tops with olive oil spray."
    },
    {
      "position": 6,
      "text": "Preheat an air fryer to 350 degrees F (180 degrees C), if recommended by the manufacturer. Air fry for about 15 minutes. Sprinkle tops of peppers evenly with mozzarella and air fry until cheese is melted, about 5 minutes more. Peppers are done when an instant read thermometer inserted near the center reaches 165 degrees F (74 degrees C)."
    },
    {
      "position": 7,
      "text": "Garnish with Italian flat-leaf parsley and serve warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

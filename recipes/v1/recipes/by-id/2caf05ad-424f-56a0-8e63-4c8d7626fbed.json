  "id": "2caf05ad-424f-56a0-8e63-4c8d7626fbed",
  "slug": "tofu-lasagna",
  "name": "Tofu Lasagna",
  "recipe_type": "main",
  "brief_description": "Tofu is combined with eggs, spaghetti sauce, mozzarella cheese and spices. The mixture is layered with lasagna noodles and topped with more cheese.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Add lasagna and cook for 8 to 10 minutes or until al dente; drain."
    },
    {
      "position": 3,
      "text": "In a medium bowl combine tofu, eggs, salt, pepper, nutmeg, milk, spaghetti sauce, parsley and 1 cup of mozzarella cheese. Spread a layer in the bottom of a 9x13 inch baking dish."
    },
    {
      "position": 4,
      "text": "Layer lasagna noodles with the sauce mixture, ending with sauce. Sprinkle with remaining mozzarella and Parmesan cheese."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven for 25 to 35 minutes."
    }
  ],
  "servings": 7,
  "cooking_time_minutes": 35,

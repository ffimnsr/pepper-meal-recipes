  "id": "9f6ab0f7-608e-5454-886d-e620aea75d5a",
  "slug": "boxed-mac-and-cheese-upgrade-recipe-11875292",
  "name": "Boxed Mac and Cheese Upgrade",
  "recipe_type": "side",
  "brief_description": "This boxed mac & cheese upgrade, with a squeeze of lemon, cracked black pepper, and flaky salt, is not one bit more difficult, but really enhances the flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a pot of salted water to a boil. Add macaroni and cook for 1 minute less than package instructions for al dente."
    },
    {
      "position": 2,
      "text": "Meanwhile, scoop out 1/2 cup pasta water and set aside. Drain macaroni and return to the pot."
    },
    {
      "position": 3,
      "text": "Add butter (up to 3 tablespoons), the cheese packet, and about 2 tablespoons reserved pasta water."
    },
    {
      "position": 4,
      "text": "Stir constantly over medium heat. Continue to add pasta water slowly until cheese is incorporated and the sauce is a glossy consistency. Stir in lemon juice; remove from heat."
    },
    {
      "position": 5,
      "text": "Plate your serving, top with an additional squeeze of lemon, a few cranks of fresh cracked black pepper and a sprinkle of flaky salt. Enjoy!"
    }
  ],
  "servings": null,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

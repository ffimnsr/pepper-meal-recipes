  "id": "9f1062fe-e4ef-5349-829f-6464602fdbc3",
  "slug": "neiman-marcus-quiche-recipe-11864808",
  "name": "Neiman Marcus Quiche",
  "recipe_type": "breakfast",
  "brief_description": "This Neiman Marcus quiche has a buttery, golden Ritz cracker crust and velvety, rich egg custard filling, punctuated and packed with smoky bacon, sharp Cheddar, fresh green onions and sliced almonds.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C)."
    },
    {
      "position": 2,
      "text": "For crust, process crackers, flour, sugar, and salt in a food processor until finely ground, 15 to 30 seconds, stopping to scrape down sides as needed. Add butter and pulse until mixture is evenly moistened and holds when pinched together, 10 to 15 pulses."
    },
    {
      "position": 3,
      "text": "Press cracker mixture evenly over bottom and up sides of a 9-inch pie plate. Line cracker mixture with parchment paper; fill with pie weights or dried beans."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until fragrant, toasted, and set, 10 to 12 minutes. Remove weights and parchment. Let cool slightly in pan on a wire rack."
    },
    {
      "position": 5,
      "text": "Meanwhile, for quiche, cook bacon in a large skillet over medium heat until crisp, 10 to 12 minutes, stirring often and adjusting heat as needed to prevent overbrowning. Remove from heat; drain and discard all but 1 tablespoon drippings from pan. Add cream cheese to the hot pan and stir constantly until melted; gradually whisk in half-and-half until well combined. Set aside."
    },
    {
      "position": 6,
      "text": "Whisk eggs, salt, and garlic powder together in a large bowl until well combined. Whisk in bacon mixture, cheese, green onions, and almonds until evenly combined. Pour egg mixture into prepared crust."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until quiche is set, and a knife inserted in center comes out clean, about 30 minutes. Let cool on a wire for rack 25 minutes."
    },
    {
      "position": 8,
      "text": "Garnish with green onions and serve warm."
    }
  ],
  "servings": 10,

  "id": "cdefe738-7914-5c01-a72c-94693b43ad5d",
  "slug": "15-minute-dinner-nachos-supreme",
  "name": "15-Minute Dinner Nachos Supreme",
  "recipe_type": "appetizer",
  "brief_description": "Enjoy nachos for dinner with crisp tortilla chips dipped into tomatoey taco-seasoned ground beef and rice topped with salsa, cheese and lettuce.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook beef and taco seasoning in a skillet until browned. Pour off fat."
    },
    {
      "position": 2,
      "text": "Add condensed soup, water, and rice. Heat to a boil. Cover and cook over low heat until rice is tender, about 5 min."
    },
    {
      "position": 3,
      "text": "Top with salsa, Cheddar, and lettuce. Serve with tortilla chips for dipping."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

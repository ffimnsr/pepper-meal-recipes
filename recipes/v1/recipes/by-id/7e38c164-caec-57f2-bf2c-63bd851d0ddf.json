  "id": "7e38c164-caec-57f2-bf2c-63bd851d0ddf",
  "slug": "red-white-and-blueberry-lemonade-recipe-11753759",
  "name": "Red, White, and Blueberry Lemonade",
  "recipe_type": "appetizer",
  "brief_description": "Chef John's vibrant red, white, and blueberry lemonade is a version of our world famous state fair lemonade, and this lemonade is incredible, maybe even better than our original. The intense color and berry flavor make it a stunning summer drink.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine strawberries, blueberries, and 1/2 of the sugar in a bowl. Use a potato masher to lightly crush berries until all blueberries have broken open."
    },
    {
      "position": 2,
      "text": "Use a sharp vegetable peeler to peel off just the yellow zest from 6 lemons; add lemon zest to the berry-sugar mixture."
    },
    {
      "position": 3,
      "text": "Pour remaining sugar into the bowl and mix thoroughly. Cover and let sit on the counter for 2 to 6 hours, stirring occasionally, or refrigerate overnight if you prefer."
    },
    {
      "position": 4,
      "text": "Bring 5 cups water to boil in a saucepan, transfer in berry mixture. Immediately turn off heat, and let sit for 5 minutes, stirring a few times."
    },
    {
      "position": 5,
      "text": "Set a fine mesh strainer over a heatproof bowl, and pour berry mixture through the strainer; press out liquid gently. Let cool to room temperature, about 20 minutes."
    },
    {
      "position": 6,
      "text": "Cut the 6 zested lemons in half, and squeeze the juice (through a strainer to catch the seeds) into the bowl."
    },
    {
      "position": 7,
      "text": "Taste, and juice in more lemons as desired. You will have another chance to adjust the final flavor after the lemonade is cold."
    },
    {
      "position": 8,
      "text": "Transfer lemonade into a pitcher and refrigerate until fully chilled, about 1 hour. Give the lemonade a final taste, and adjust with more fresh lemon juice or sugar if necessary. Fill glasses with ice to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 25,

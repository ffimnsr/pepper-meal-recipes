  "id": "2f70bd67-be20-5abf-9a5b-7010113df6d5",
  "slug": "nashville-hot-turkey-legs-recipe-8740143",
  "name": "Nashville Hot Turkey Legs",
  "recipe_type": "main",
  "brief_description": "These Nashville hot turkey legs are breaded, deep fried, then doused in hot, spicy oil.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Stir flour, 2 teaspoons salt, and 1 teaspoon pepper together in a bowl or resealable plastic bag. Coat turkey legs thoroughly in the flour mixture, pressing as necessary to adhere the coating. Allow to stand at room temperature while oil heats."
    },
    {
      "position": 2,
      "text": "Heat oil in a saucepan or deep skillet to 350 degrees F (175 degrees C). Stir remaining salt and pepper, paprika, garlic powder, cayenne, and brown sugar together in a medium bowl until well combined; set aside."
    },
    {
      "position": 3,
      "text": "Fry turkey legs, 2 at a time, until an instant read thermometer inserted near the center reads 170 degrees F (77 degrees C), about 15 minutes. Drain on a wire rack set over paper towels."
    },
    {
      "position": 4,
      "text": "Carefully pour 1 to 1 1/2 cups oil into the bowl with spice mixture (mixture will bubble rapidly), and whisk until well blended. Coat turkey legs in spice oil mixture and allow any excess to drip off. Serve with ranch dressing."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

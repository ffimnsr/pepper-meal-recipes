  "id": "2eaef06c-c01f-5d6c-9588-1ca6193f6f8e",
  "slug": "slow-cooker-borscht",
  "name": "Slow Cooker Borscht",
  "recipe_type": "soup",
  "brief_description": "A delicious and comforting borscht soup recipe made in the slow cooker with chunks of beef, fresh beets, and cabbage flavored with red wine and herbs.",
  "cuisine": "Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Place beets, tomatoes, potatoes, beef, onion, carrots, and garlic in a slow cooker. Whisk beef broth, tomato paste, vinegar, brown sugar, parsley, dill, bay leaf, salt, and black pepper together in a bowl; pour over beef and vegetables, adding more broth to cover as needed. Cover slow cooker."
    },
    {
      "position": 2,
      "text": "Cook on Low for 8\u00bd hours or on High for 4 hours. Stir in shredded cabbage; cover slow cooker. Cook on High until cabbage is tender, about 30 minutes. Remove and discard bay leaf. Top servings with sour cream."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 270,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "expert",

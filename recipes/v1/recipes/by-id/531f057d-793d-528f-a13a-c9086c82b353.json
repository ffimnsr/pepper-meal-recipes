  "id": "531f057d-793d-528f-a13a-c9086c82b353",
  "slug": "shrimp-and-pineapple-ceviche",
  "name": "Shrimp and Pineapple Ceviche",
  "recipe_type": "salad",
  "brief_description": "This shrimp and pineapple ceviche recipe uses bell pepper, avocado, red onion, cilantro, garlic, serrano, and lime. Serve it on its own or on lettuce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Toss shrimp, bell pepper, pineapple, avocado, red onion, cilantro, lime juice, serrano, garlic, salt, and black pepper together in a glass or ceramic bowl until thoroughly combined. Cover the bowl with plastic wrap; refrigerate for 1 hour."
    }
  ],

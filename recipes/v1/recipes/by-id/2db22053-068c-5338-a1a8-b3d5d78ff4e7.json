  "id": "2db22053-068c-5338-a1a8-b3d5d78ff4e7",
  "slug": "super-easy-chicken-and-dumplings",
  "name": "Super Easy Chicken and Dumplings",
  "recipe_type": "soup",
  "brief_description": "This hearty chicken and dumplings soup could not be simpler to make in one pot with easy ingredients for a comforting meal that tastes great!",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir condensed soup, chicken broth, and shredded chicken together in a large saucepan over medium-high heat until it begins to simmer."
    },
    {
      "position": 3,
      "text": "Cut each biscuit into quarters, and gently stir into the simmering soup."
    },
    {
      "position": 4,
      "text": "Reduce heat to medium-low, cover, and simmer until biscuits are no longer doughy in the center, 10 to 15 minutes."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

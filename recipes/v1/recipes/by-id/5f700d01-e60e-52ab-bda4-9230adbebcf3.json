  "slug": "3-ingredient-sugar-cookies-recipe-7968770",
  "name": "3 Ingredient Sugar Cookies",
  "recipe_type": "dessert",
  "brief_description": "These 3-ingredient sugar cookies are super simple to make and truly just three ingredients! Try making this small batch in under a half hour.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Grease a baking sheet or line with parchment."
    },
    {
      "position": 2,
      "text": "In a mixing bowl, beat the butter with an electric mixer until smooth. Add the sugar and beat until combined. Beat in flour until combined."
    },
    {
      "position": 3,
      "text": "Using a cookie scoop, portion dough 2 inches apart onto the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until edges of cookies are set, about 14 minutes."
    },
    {
      "position": 5,
      "text": "Allow cookies to cool completely before removing from the baking sheet."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 14,
  "preparation_time_minutes": 5,

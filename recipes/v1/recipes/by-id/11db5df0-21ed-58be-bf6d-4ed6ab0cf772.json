  "id": "11db5df0-21ed-58be-bf6d-4ed6ab0cf772",
  "slug": "pistachio-financiers-with-raspberry-glaze-recipe-11954901",
  "name": "Pistachio Financiers with Raspberry Glaze",
  "recipe_type": "dessert",
  "brief_description": "These pistachio financiers with raspberry glaze are decadent enough to live up to their name. With a bright pink glaze made with freeze-dried raspberry powder, they are a pretty addition to any celebration, or simply enjoy one with your morning coffee.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Scatter pistachios on a baking tray."
    },
    {
      "position": 2,
      "text": "Place butter in a small pot over medium heat and cook until browned, whisking occasionally, about 5 minutes. Set aside to cool."
    },
    {
      "position": 3,
      "text": "Toast pistachios in the preheated oven for 7 to 8 minutes. Let cool."
    },
    {
      "position": 4,
      "text": "Add pistachios and flour to a food processor. Pulse for 30 seconds to 1 minute, until the mixture is broken down to a fine meal (like almond flour)."
    },
    {
      "position": 5,
      "text": "Add pistachio mixture to a mixing bowl; whisk in confectioner's sugar and salt until combined. Whisk in egg whites and honey. Whisk in half the browned butter until fully incorporated. Add remaining browned butter and whisk until combined."
    },
    {
      "position": 6,
      "text": "Cover and chill the batter for at least 2 hours, or up to overnight."
    },
    {
      "position": 7,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 12-cup muffin pan with nonstick cooking spray. Portion batter evenly into the muffin cups, about 2 tablespoons each."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until edges are browned and center is domed, 12 to 13 minutes. Let cool."
    },
    {
      "position": 9,
      "text": "Meanwhile, for glaze. Combine confectioner\u2019s sugar, milk, and raspberry powder in a small bowl and whisk until smooth."
    },
    {
      "position": 10,
      "text": "Glaze tops of financiers with 2 to 3 teaspoons of glaze each. Sprinkle with chopped pistachios and top with a fresh raspberry."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,

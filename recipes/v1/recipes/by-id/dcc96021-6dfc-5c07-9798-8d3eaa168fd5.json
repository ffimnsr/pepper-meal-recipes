  "id": "dcc96021-6dfc-5c07-9798-8d3eaa168fd5",
  "slug": "rhubarb-almond-muffins-recipe-8379783",
  "name": "Rhubarb Almond Muffins",
  "recipe_type": "breakfast",
  "brief_description": "Almond extract scents these rhubarb almond muffins. Loaded with diced rhubarb, they're a nice morning muffin, easy to make in about 30 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 12-cup muffin tin or line cups with paper liners."
    },
    {
      "position": 2,
      "text": "Whisk milk, oil, egg, white sugar, brown sugar, and almond extract together in a bowl. Whisk flour, baking powder, and salt together in a separate bowl. Make a well in the center; pour in the milk mixture and stir until just combined. Fold in rhubarb. Spoon batter into the prepared muffin cups, filling each 3/4 full."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted near the center comes out clean, 20 to 25 minutes. Sprinkle the tops with sugar while hot."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

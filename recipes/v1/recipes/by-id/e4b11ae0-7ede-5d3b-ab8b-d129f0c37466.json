  "id": "e4b11ae0-7ede-5d3b-ab8b-d129f0c37466",
  "slug": "pineapple-upside-down-cupcakes",
  "name": "Pineapple Upside-Down Cupcakes",
  "recipe_type": "dessert",
  "brief_description": "Enjoy all the goodness of pineapple upside-down cake in cupcake form with this recipe using cake mix, brown sugar, pineapple tidbits, and cherries.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin or line cups with paper liners."
    },
    {
      "position": 2,
      "text": "Combine cake mix, water, oil, and eggs in a large bowl; beat with an electric mixer on low speed for 30 seconds. Increase speed to medium and beat for 2 minutes. Add reserved pineapple juice; beat until combined."
    },
    {
      "position": 3,
      "text": "Divide brown sugar, butter, and pineapple tidbits evenly between the muffin cups. Top each cup with 1 cherry. Divide cake batter between the muffin cups."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden and tops spring back when lightly pressed, 15 to 20 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

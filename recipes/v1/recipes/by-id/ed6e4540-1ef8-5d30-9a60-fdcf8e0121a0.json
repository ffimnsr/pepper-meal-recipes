  "id": "ed6e4540-1ef8-5d30-9a60-fdcf8e0121a0",
  "slug": "sauteed-scallops",
  "name": "Saut\u00e9ed Scallops",
  "recipe_type": "main",
  "brief_description": "Saut\u00e9ed scallops in butter with crushed garlic and fresh rosemary; a very simple yet incredibly delicious shellfish main dish for two!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a medium saucepan over medium-high heat; add crushed garlic and whole sprigs of rosemary."
    },
    {
      "position": 2,
      "text": "Place scallops in skillet and cook until golden brown on one side, about 2 to 3 minutes. Turn scallops over and continue to cook until firm and opaque, about 1 or 2 minutes more."
    },
    {
      "position": 3,
      "text": "Remove crushed garlic and rosemary sprigs from the pan before serving."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,

  "id": "abf39208-9f68-5ef4-854e-f15d77d7934e",
  "slug": "chicken-65",
  "name": "Chicken 65",
  "recipe_type": "main",
  "brief_description": "A very popular dish from India, this chicken 65 recipe delivers succulent pieces of red hot chicken that are sure to make the mouth water!",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken in a medium bowl. Add egg, cornstarch, 1/2 of the minced garlic, 1/2 of the minced ginger, salt, and 1/2 teaspoon black pepper. Mix until chicken is completely coated."
    },
    {
      "position": 2,
      "text": "Heat oil in a deep skillet and fry chicken pieces until no longer pink in the center and the juices run clear, 7 to 10 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C). Set fried chicken aside."
    },
    {
      "position": 3,
      "text": "Heat 2 tablespoons oil in a second skillet over medium heat. Add cumin seeds and cook until crackling, about 1 minute. Add remaining garlic, remaining ginger, serrano peppers, cumin, chile powder, 1/2 teaspoon black pepper, and salt. Add curry leaves and stir to combine. Add chile-garlic paste, ginger paste, and red food coloring. Stir to create a paste. Add water to thin paste slightly."
    },
    {
      "position": 4,
      "text": "Add fried chicken to the the skillet and toss to coat thoroughly. Stir in cilantro."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "dfdf5fc5-1170-5cc2-b090-8dbe9a70111f",
  "slug": "my-hop-pancakes",
  "name": "My-Hop Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These delicious pancakes are said to resemble those from a famous pancake house. The batter rests in the refrigerator for 30 minutes, making the cakes extra fluffy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix buttermilk, vegetable oil, and vanilla in a bowl; stir in sugar. Whisk in flour, baking powder, baking soda, and salt, combining the batter with just a few strokes to moisten. Leave the lumps."
    },
    {
      "position": 3,
      "text": "Whisk egg and lemon juice together in a separate bowl; gently stir into the batter. Refrigerate the batter for at least 30 minutes, up to 1 hour."
    },
    {
      "position": 4,
      "text": "Heat a large skillet over medium heat and grease with the butter. Pour 1/3 cup of batter per pancake into the skillet and cook until bubbles appear on the surface, about 2 minutes."
    },
    {
      "position": 5,
      "text": "Flip with spatula and brown the other side, about 2 more minutes."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

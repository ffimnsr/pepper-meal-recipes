  "id": "06859d88-7aad-5b5e-b482-e150d5d695ec",
  "slug": "instant-pot-sloppy-joes",
  "name": "Instant Pot Sloppy Joes",
  "recipe_type": "dessert",
  "brief_description": "A combination of lean ground beef and apple cider vinegar makes this sloppy Joes recipe slightly sweet and slightly tart right in the Instant Pot.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select Saut\u00e9 function. Add oil; tip Pot to coat bottom. Add ground beef, onion, and bell pepper; season with salt and black pepper. Cook and stir until vegetables are soft and beef is no longer pink, 5 to 7 minutes. Drain and discard grease."
    },
    {
      "position": 2,
      "text": "Add garlic to the Pot; cook 30 seconds more. Stir in crushed tomatoes, vinegar, water, brown sugar, Worcestershire sauce, chili powder, tomato paste, mustard, and red pepper flakes."
    },
    {
      "position": 3,
      "text": "Close and lock the lid; close the vent. Select High pressure according to manufacturer's instructions; set timer for 5 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Meanwhile, toast hamburger buns and coat with butter."
    },
    {
      "position": 5,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, 10 minutes. Release remaining pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid."
    },
    {
      "position": 6,
      "text": "Serve on toasted buns."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": null,
  "rest_time_minutes": null,
  "difficulty": "medium",

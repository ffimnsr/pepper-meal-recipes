  "id": "73046f25-1b11-5c4c-a94a-6f4095f2c312",
  "slug": "easy-pickled-corn-recipe-12057329",
  "name": "Easy Pickled Corn",
  "recipe_type": "dessert",
  "brief_description": "This easy pickled corn recipe gives fresh, sweet corn a deliciously tangy, crunchy twist. Enjoy it as a refreshing snack, side dish, or spicy treat with jalape\u00f1os and red pepper flakes!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, vinegar, and salt in a large pot for the brine. Heat on the stovetop over medium heat until the salt is dissolved, about 5 minutes. Remove and set aside to cool."
    },
    {
      "position": 2,
      "text": "Meanwhile, cut each ear of corn into 2 to 3 pieces. Fill a large bowl with ice and cold water. Bring a large pot of lightly salted water to a boil. Add corn pieces and cook uncovered, about 7 minutes. Drain in a colander and immediately immerse in ice water to stop the cooking process, 7 to 10 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Combine cooled brine and blanched corn cobs in a large jar or several medium-sized jars and add any optional ingredients to season the brine."
    },
    {
      "position": 4,
      "text": "Cover and refrigerate for at least 3 hours and enjoy!"
    }
  ],
  "servings": null,

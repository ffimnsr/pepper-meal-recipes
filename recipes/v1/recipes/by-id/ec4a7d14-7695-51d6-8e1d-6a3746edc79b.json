  "id": "ec4a7d14-7695-51d6-8e1d-6a3746edc79b",
  "slug": "crispy-crunchy-pumpkin-seeds",
  "name": "Crispy, Crunchy Pumpkin Seeds",
  "recipe_type": "appetizer",
  "brief_description": "These crispy, crunchy pumpkin seeds are perfectly seasoned with butter, garlic salt, onion salt, and paprika. They provide a perfect on-the-go snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Line a baking sheet with a silicone mat or aluminum foil."
    },
    {
      "position": 2,
      "text": "Toss pumpkin seeds and melted butter together in a bowl. Season with garlic salt, onion salt, and paprika; toss until evenly coated. Spread on the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden and crisp, stirring halfway through, about 45 minutes. Cool. Store in an airtight container."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,

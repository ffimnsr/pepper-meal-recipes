  "id": "3a1a18dc-79ff-5a40-bc1a-648f0f500b0a",
  "slug": "spanish-flan",
  "name": "Spanish Flan",
  "recipe_type": "dessert",
  "brief_description": "Spanish flan is a baked custard made with condensed and evaporated milk, eggs, and sugar for a rich, smooth dessert smothered with caramel sauce.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt sugar in a medium saucepan over medium-low heat until liquefied and golden in color. Carefully pour hot syrup into a deep 9-inch round glass baking dish, turning the dish to evenly coat the bottom; set aside."
    },
    {
      "position": 3,
      "text": "Beat eggs in a large bowl. Add condensed milk, evaporated milk, and vanilla; beat until smooth. Pour egg mixture on top of caramel in the baking dish; place in a deep roasting pan. Carefully pour in enough hot water to come 1 inch up the sides of the dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until just set with a slight jiggle in the center, about 1 hour, checking after 55 minutes. Keep in mind the flan will continue to set as it cools. Remove from the oven and carefully transfer baking dish to a wire rack; cool to room temperature, then cover with plastic wrap to prevent a skin forming. Refrigerate for 3 hours or up to 3 days."
    },
    {
      "position": 5,
      "text": "To serve, run a knife around the edges of the dish; carefully invert onto a rimmed serving plate and let caramel sauce flow over flan."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

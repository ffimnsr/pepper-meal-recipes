  "slug": "pegu-club-cocktail",
  "name": "Pegu Club Cocktail",
  "recipe_type": "drink",
  "brief_description": "Shake Cointreau, lime juice, and bitters together for the perfectly balanced Pegu Club cocktail, a gin makeover of the classic margarita.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a cocktail shaker with ice; add gin, Cointreau, and lime juice. Shake in bitters. Shake well and strain into a chilled glass. Garnish with a slice of lime."
    }
  ],

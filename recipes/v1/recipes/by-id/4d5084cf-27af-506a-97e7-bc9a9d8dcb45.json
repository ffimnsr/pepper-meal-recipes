  "id": "4d5084cf-27af-506a-97e7-bc9a9d8dcb45",
  "slug": "low-carb-keto-cheese-taco-shells",
  "name": "Low-Carb Keto Cheese Taco Shells",
  "recipe_type": "main",
  "brief_description": "Try keto taco shells made from baked Cheddar cheese for a great gluten-free, low-carb, keto-friendly taco option. Quick, easy, and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line two baking sheets with parchment paper or silicone mats."
    },
    {
      "position": 2,
      "text": "Wrap the handle of a wooden spoon with aluminum foil. Balance between two tall cans."
    },
    {
      "position": 3,
      "text": "Spread Cheddar cheese on the prepared baking sheets into four 6-inch circles placed 2 inches apart."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cheese melts and is lightly brown, 6 to 8 minutes. Cool for 2 to 3 minutes. Lift with a spatula and drape over the wrapped wooden handle to make a taco shell shape. Cool until set, about 10 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "8c52f0d4-33c6-59b9-8400-17646d6a48b6",
  "slug": "pretzel-turtles",
  "name": "Rolo Pretzel Turtles",
  "recipe_type": "dessert",
  "brief_description": "This Rolo pretzel recipe is easy to make with mini pretzels, Rolo chocolate caramel candies, and pecans for a deliciously chewy turtle candy treat!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 300 degrees F (150 degrees C). Line a cookie sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Arrange pretzels in a single layer on the prepared cookie sheet. Place one caramel candy on top of each pretzel."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until caramels soften, about 4 minutes."
    },
    {
      "position": 4,
      "text": "Remove from the oven and immediately press a pecan half into each warm caramel."
    },
    {
      "position": 5,
      "text": "Cool completely before serving."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

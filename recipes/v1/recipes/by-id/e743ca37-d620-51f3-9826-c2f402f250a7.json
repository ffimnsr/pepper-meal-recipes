  "id": "e743ca37-d620-51f3-9826-c2f402f250a7",
  "slug": "simple-lemon-herb-chicken",
  "name": "Simple Lemon Herb Chicken",
  "recipe_type": "main",
  "brief_description": "This lemon herb chicken is a quick and easy main dish of juicy chicken breasts flavored with lemon, oregano, and parsley\u2014ready in just 15 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken in a bowl; pour 1/2 of the lemon juice over chicken and season with salt."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a medium skillet over medium-low heat. Place chicken into hot oil. Add remaining lemon juice and oregano; season with black pepper. Cook chicken until golden brown and the juices run clear, 5 to 10 minutes per side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 3,
      "text": "Garnish chicken with parsley to serve."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

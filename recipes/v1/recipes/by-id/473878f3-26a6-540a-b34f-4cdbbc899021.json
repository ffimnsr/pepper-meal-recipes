  "id": "473878f3-26a6-540a-b34f-4cdbbc899021",
  "slug": "strawberry-pop-tart-pie-recipe-11861155",
  "name": "Strawberry Pop Tart Pie",
  "recipe_type": "dessert",
  "brief_description": "This strawberry pop tart pie brings the nostalgic taste of strawberry pop tarts to life. It's glazed, topped with sprinkles, and easy to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add half of the strawberries to a heavy saucepan and cook over medium heat until strawberries break down and mixture thickens, about 10 minutes. Let berries cool slightly."
    },
    {
      "position": 2,
      "text": "Add apple to a large bowl, then add cooked berries, remaining frozen berries, sugar, tapioca flour, and salt. Toss to combine."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a pie dish."
    },
    {
      "position": 4,
      "text": "Place 1 pie crust in the prepared pie dish and crimp the edges. Pour in berry mixture and smooth the top. Lay remaining crust over filling, then press and crimp the edges to seal. Pinch edges to ensure there are no gaps. Use a sharp knife to cut an X in the center of the top crust to allow steam to escape."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 15 minutes. Remove the pie from the oven and reduce the oven temperature to 350 degrees F (180 degrees C). Return the pie to the oven and continue baking until the filling is bubbling, about 30 minutes more."
    },
    {
      "position": 6,
      "text": "To make the glaze: Whisk confectioner\u2019s sugar and milk together in a small bowl until smooth. Brush over cooled pie, then cover with sprinkles."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

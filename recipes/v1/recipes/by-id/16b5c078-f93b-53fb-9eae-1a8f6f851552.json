  "id": "16b5c078-f93b-53fb-9eae-1a8f6f851552",
  "slug": "grits-sausage-and-egg-casserole",
  "name": "Grits, Sausage, and Egg Casserole",
  "recipe_type": "breakfast",
  "brief_description": "Make this delicious grits, sausage, and egg casserole for your guests and they will be begging for the recipe!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Bring water, half-and-half, and salt to a boil in a saucepan; slowly whisk in grits. Reduce heat to low and simmer, stirring occasionally, until thick, about 20 minutes. Stir in Cheddar cheese and butter until melted. Cool."
    },
    {
      "position": 3,
      "text": "Heat a large skillet over medium-high heat. Add sausage; cook and stir until browned and crumbly, 5 to 7 minutes. Transfer sausage to a paper-towel-lined plate; discard grease."
    },
    {
      "position": 4,
      "text": "Beat eggs and milk together in a bowl. Stir sausage, egg mixture, and bell peppers into grits mixture; pour into prepared baking dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until set, 45 to 60 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

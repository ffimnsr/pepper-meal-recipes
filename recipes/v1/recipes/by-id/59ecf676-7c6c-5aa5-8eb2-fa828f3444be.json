  "id": "59ecf676-7c6c-5aa5-8eb2-fa828f3444be",
  "slug": "moms-sweet-n-sours-pork-ribs",
  "name": "Mom's \"Sweet 'n Sours\" Pork Ribs",
  "recipe_type": "dessert",
  "brief_description": "A family recipe for sweet and sour spare ribs that has been passed down. This favorite sauce combines soy, sugar, vinegar, mustard, garlic, and more.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix sugar, flour, salt, pepper, and mustard in a bowl."
    },
    {
      "position": 3,
      "text": "Stir in water, soy sauce, and vinegar."
    },
    {
      "position": 4,
      "text": "Place ribs in a pot with enough water to cover."
    },
    {
      "position": 5,
      "text": "Bring to a boil, cook for 10 minutes, and drain."
    },
    {
      "position": 6,
      "text": "Heat oil in a large skillet over medium heat. Brown ribs on all sides."
    },
    {
      "position": 7,
      "text": "Mix in sauce mixture."
    },
    {
      "position": 8,
      "text": "Bring to a boil, reduce heat to low, and simmer for 30 minutes."
    },
    {
      "position": 9,
      "text": "Mix in garlic and continue cooking for 15 minutes, or to desired doneness."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

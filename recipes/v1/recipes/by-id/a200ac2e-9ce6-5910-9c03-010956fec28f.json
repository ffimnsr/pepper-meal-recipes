  "id": "a200ac2e-9ce6-5910-9c03-010956fec28f",
  "slug": "very-easy-mushroom-barley-soup",
  "name": "Easy Mushroom Barley Soup",
  "recipe_type": "soup",
  "brief_description": "This delicious mushroom barley soup with carrots, onions, celery, and garlic cooks in less than an hour for a comforting meal on a cold day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large soup pot over medium heat. Add onion, carrots, celery and garlic; cook and stir until onion has softened and turned translucent, about 5 minutes. Stir in mushrooms and continue to cook for about 3 minutes."
    },
    {
      "position": 2,
      "text": "Pour in chicken broth, add barley, and bring to a boil. Reduce heat to low, cover, and simmer until barley is tender, about 40 to 50 minutes."
    },
    {
      "position": 3,
      "text": "Season with salt and pepper before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,

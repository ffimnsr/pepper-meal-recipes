  "id": "d6ba27af-882e-52e2-ac7c-34dd50e3cbf2",
  "slug": "tiktok-brownies",
  "name": "TikTok Brownies",
  "recipe_type": "dessert",
  "brief_description": "Get the recipe for the incredibly easy, six-ingredient brownies you've seen in the TikTok comments.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oven to 350 degrees F (175 degrees C). Coat an 8x8-inch metal baking dish with butter."
    },
    {
      "position": 2,
      "text": "Melt butter in a large saucepan over low heat. Remove from heat and let cool for 5 minutes. Whisk in cocoa powder, sugar, and vanilla extract. Stir in eggs, 1 at a time until incorporated. Add flour and stir until just combined. Scrape mixture into the prepared pan and smooth the top."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted comes out clean, 20 to 25 minutes."
    },
    {
      "position": 4,
      "text": "Remove from the oven and cool on a wire rack for at least 45 minutes before cutting."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

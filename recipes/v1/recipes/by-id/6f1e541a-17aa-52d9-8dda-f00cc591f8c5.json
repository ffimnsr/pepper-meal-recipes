  "schema_version": 1,
  "id": "6f1e541a-17aa-52d9-8dda-f00cc591f8c5",
  "slug": "peking-duck",
  "name": "Peking Duck",
  "recipe_type": "main",
  "brief_description": "Peking duck is made by seasoning a whole duck with a fragrant spice rub before it's steamed, then roasted until golden with deliciously crispy skin.",
  "cuisine": "Chinese Inspired Asian Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Rinse duck inside and out; pat dry. Cut off tail and discard."
    },
    {
      "position": 3,
      "text": "Mix cinnamon, ginger, nutmeg, white pepper, and cloves together in a small bowl. Sprinkle 1 teaspoon of spice mix into cavity of duck."
    },
    {
      "position": 4,
      "text": "Stir 1 tablespoon soy sauce into remaining spice mix and rub evenly over entire outside of duck."
    },
    {
      "position": 5,
      "text": "Cut 1 green onion in half and tuck it inside cavity."
    },
    {
      "position": 6,
      "text": "Cover and refrigerate duck for at least 2 hours or up to overnight."
    },
    {
      "position": 7,
      "text": "Place duck breast-side up on a rack set in a wok or pot. Steam for 1 hour, adding more water as it evaporates."
    },
    {
      "position": 8,
      "text": "Lift duck with two large spoons to drain juices and green onion."
    },
    {
      "position": 9,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Place duck breast-side up in a roasting pan and prick skin all over with a fork."
    },
    {
      "position": 10,
      "text": "Roast duck in the preheated oven for 30 minutes."
    },
    {
      "position": 11,
      "text": "Mix together remaining 2 tablespoons soy sauce and honey in a small bowl. Brush honey mixture onto duck."
    },
    {
      "position": 12,
      "text": "Increase the oven temperature to 500 degrees F (260 degrees C). Roast until skin is richly browned, about 5 minutes. Do not allow skin to char."
    },
    {
      "position": 13,
      "text": "Mix plum jam, chutney, sugar, and vinegar in a small serving bowl. Chop remaining green onions and place them into a separate bowl."
    },
    {
      "position": 14,
      "text": "Place whole duck onto a serving platter and garnish with orange slices and fresh parsley. Serve with plum sauce and chopped green onions."
    }
  ],

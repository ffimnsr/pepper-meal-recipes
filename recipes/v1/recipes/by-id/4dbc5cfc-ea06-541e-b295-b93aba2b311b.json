  "id": "4dbc5cfc-ea06-541e-b295-b93aba2b311b",
  "slug": "tang-pie-recipe-11756744",
  "name": "Tang Pie",
  "recipe_type": "dessert",
  "brief_description": "This tang pie is perfect for summer gatherings and only takes minutes to put together.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine orange drink mix, condensed milk, and cream cheese in a large bowl. Beat with an electric mixer on high speed until well combined. Fold 2 cups whipped topping into cream cheese mixture."
    },
    {
      "position": 2,
      "text": "Pour mixture into graham cracker crust and chill until firm, at least 1 hour. Garnish with remaining whipped topping and mandarin orange segments."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,

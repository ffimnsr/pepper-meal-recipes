  "slug": "chicken-cacciatore-in-a-slow-cooker",
  "name": "Chicken Cacciatore in a Slow Cooker",
  "recipe_type": "main",
  "brief_description": "This chicken cacciatore crockpot recipe is made with chicken breasts simmered in a slow cooker with spaghetti sauce, pepper, mushrooms, and onion.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place chicken in a slow cooker."
    },
    {
      "position": 3,
      "text": "Stir in spaghetti sauce, tomato paste, mushrooms, onion, bell pepper, garlic, oregano, basil, black pepper, and red pepper flakes."
    },
    {
      "position": 4,
      "text": "Cover and cook on Low until chicken is tender, 6 to 8 hours."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 360,

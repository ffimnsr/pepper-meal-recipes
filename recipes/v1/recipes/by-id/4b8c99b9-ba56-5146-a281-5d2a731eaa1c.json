  "id": "4b8c99b9-ba56-5146-a281-5d2a731eaa1c",
  "slug": "15-minute-butter-gnocchi-with-spicy-chili-crisp-capers-and-parmesan-recipe-8684030",
  "name": "15-Minute Butter Gnocchi with Spicy Chili Crisp, Capers and Parmesan",
  "recipe_type": "main",
  "brief_description": "This gnocchi with chili crisp, capers, and Parmesan is a weeknight lifesaver recipe, on the table in just 15 minutes.",
  "cuisine": "Fusion",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pan of water to a steady simmer. Add gnocchi and cook until they float to the top, 2 to 4 minutes. Drain gnocchi, reserving a few tablespoons of cooking water."
    },
    {
      "position": 2,
      "text": "Meanwhile, melt butter in a large skillet over medium-high heat until molten and sizzling, about 2 minutes. Add capers and chili crisp oil and sizzle, stirring continuously, about 30 seconds."
    },
    {
      "position": 3,
      "text": "Add drained gnocchi to the skillet along with a couple of tablespoons of reserved cooking water. Stir or shake the pan until gnocchi are well coated with a slick of red oil and everything\u2019s piping hot. Serve straight away with freshly grated Parmesan cheese to taste."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

  "id": "ee9105b9-2d3d-57d6-99a4-f43f8c379799",
  "slug": "aunt-libbys-southern-meatloaf",
  "name": "Aunt Libby's Southern Meatloaf",
  "recipe_type": "main",
  "brief_description": "Perfectly moist meatloaf topped with a homemade barbeque sauce is Southern-inspired meatloaf that has been passed down through the generations.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Butter a 9x5-inch loaf pan."
    },
    {
      "position": 2,
      "text": "Mix beef, onion, 1 cup ketchup, bread crumbs, eggs, salt, and pepper together in a bowl. Press beef mixture into a loaf in the prepared loaf pan."
    },
    {
      "position": 3,
      "text": "Mix 1 1/2 cups ketchup, water, vinegar, brown sugar, mustard, and Worcestershire sauce together in a saucepan; cook and stir over medium heat until sauce is smooth and warm, about 10 minutes. Pour 1/3 the sauce over meatloaf."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven, basting every 25 minutes with more sauce, until meatloaf is cooked through, 1 to 1 1/2 hours. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C). Cool in the pan for 10 minutes before slicing."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

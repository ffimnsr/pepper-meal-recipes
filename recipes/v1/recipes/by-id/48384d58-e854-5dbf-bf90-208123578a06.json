  "id": "48384d58-e854-5dbf-bf90-208123578a06",
  "slug": "grannys-shortbread-cookies",
  "name": "Granny's Shortbread Cookies",
  "recipe_type": "dessert",
  "brief_description": "Light, buttery shortbread cookies! Cut them into Christmas shapes and decorate with colored sugar and maraschino cherries.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cream together the butter, sugar, salt, nutmeg and egg yolk. Add the flour a little at a time until mixture is stiff."
    },
    {
      "position": 3,
      "text": "Place onto floured board and knead lightly until the dough begins to crack."
    },
    {
      "position": 4,
      "text": "Roll out 1/4 inch thickness and cut into desired shapes."
    },
    {
      "position": 5,
      "text": "Place on un-greased cookie sheet, decorate with colored sugar crystals and maraschino cherries."
    },
    {
      "position": 6,
      "text": "Bake for 10 minutes or until golden brown."
    }
  ],
  "servings": 12,

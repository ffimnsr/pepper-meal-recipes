  "id": "c7652e60-d1c3-5c96-b386-f1e953ae9807",
  "slug": "sally-lunn-cake-recipe-11881236",
  "name": "Sally Lunn Cake",
  "recipe_type": "dessert",
  "brief_description": "Sally Lunn Cake is a classic, lightly sweet yeast cake from England with a tender crumb and rich buttery flavor. Perfect for breakfast or afternoon tea, this timeless recipe is delicious served warm with butter or enjoyed on its own.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together flour, sugar, yeast, and salt in the bowl of a stand mixer"
    },
    {
      "position": 2,
      "text": "Mix in milk, butter and eggs just until combined."
    },
    {
      "position": 3,
      "text": "Cover with plastic wrap and let rise in a warm place until doubled in size, about 45 minutes to 1 hour."
    },
    {
      "position": 4,
      "text": "Grease a 10-cup Bundt pan or fluted cake pan."
    },
    {
      "position": 5,
      "text": "Return bowl to stand mixer and mix on medium speed to knock air out, about 2 to 3 minutes. Pour batter into the prepared pan."
    },
    {
      "position": 6,
      "text": "Cover again and let rise in a warm place until doubled in size, about 45 minutes to 1 hour."
    },
    {
      "position": 7,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Bake until golden brown, 40 to 45 minutes."
    },
    {
      "position": 8,
      "text": "Let cake stand in the pan for 5 minutes. Invert onto a wire rack and cool completely before slicing. Serve warm or at room temperature. Recipe developed by Barrett Heald"
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,

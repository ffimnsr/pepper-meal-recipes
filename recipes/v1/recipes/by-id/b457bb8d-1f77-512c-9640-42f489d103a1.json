  "id": "b457bb8d-1f77-512c-9640-42f489d103a1",
  "slug": "whole-grain-breakfast-cookies",
  "name": "Whole Grain Breakfast Cookies Recipe",
  "recipe_type": "dessert",
  "brief_description": "This whole grain breakfast cookie recipe is made with oats, flax meal, and whole wheat flour, walnuts, almond butter, dried cherries, and chocolate chips.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Pulse walnuts in the bowl of a food processor until ground into a flour; transfer to a bowl. Stir in oats, flax meal, whole wheat flour, baking soda, cinnamon, and salt until thoroughly combined."
    },
    {
      "position": 3,
      "text": "Combine almond butter, brown sugar, canola oil, agave nectar, egg, and vanilla extract in the bowl of a food processor; pulse to blend well. Transfer almond butter mixture to a large bowl; fold in chocolate chips and dried cherries. Stir oatmeal mixture into almond butter mixture; dough will be very thick."
    },
    {
      "position": 4,
      "text": "Scoop dough by heaping teaspoons; roll into balls and place on the prepared baking sheets, about 2 inches apart."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until lightly browned, 8 to 10 minutes. Remove from the oven; flatten cookies with a spatula. Cool on the baking sheets for about 5 minutes before transferring to wire racks to finish cooling."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,

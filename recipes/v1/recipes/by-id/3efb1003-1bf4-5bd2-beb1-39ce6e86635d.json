{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "3efb1003-1bf4-5bd2-beb1-39ce6e86635d",
  "slug": "maple-pumpkin-doughnuts",
  "name": "Maple Pumpkin Doughnuts",
  "recipe_type": "breakfast",
  "brief_description": "These baked pumpkin doughnuts are dipped in a maple glaze and sprinkled with chopped pumpkin seeds, making them an unbelievably delicious fall treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease a doughnut pan with about 1 teaspoon vegetable oil."
    },
    {
      "position": 2,
      "text": "Sift flour, baking powder, cinnamon, ginger, nutmeg, allspice, salt, and cloves together in a large bowl; stir brown sugar into flour mixture until well mixed."
    },
    {
      "position": 3,
      "text": "Whisk pumpkin puree, 1/3 cup vegetable oil, 1/3 cup maple syrup, buttermilk, and egg together in a separate bowl until smooth. Stir pumpkin mixture into flour mixture until batter is just combined. Refrigerate batter for flavors to blend, 20 to 40 minutes."
    },
    {
      "position": 4,
      "text": "Scoop about 1/4 cup batter into each well of the prepared doughnut pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a doughnut comes out clean, 9 to 13 minutes. Cool completely in the pan. Loosen edges of each doughnut with a small offset spatula or knife and transfer to a wire rack."
    },
    {
      "position": 6,
      "text": "Whisk confectioners\u2019 sugar and 3 tablespoons maple syrup together in a small bowl until glaze is smooth."
    },
    {
      "position": 7,
      "text": "Press doughnuts face down into glaze to cover the top completely. Place doughnuts on a wire rack until glaze begins to set, 2 to 3 minutes. Sprinkle pumpkin seeds over glaze."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "c0309fe4-846d-557b-980f-90c63479e374",
  "slug": "mediterranean-ground-turkey-burgers-with-olive-and-feta-topping-recipe-7570594",
  "name": "Mediterranean Ground Turkey Burgers with Olive and Feta Topping",
  "recipe_type": "main",
  "brief_description": "Take your grilling to the next level with these Mediterranean ground turkey burgers, flavored with Mediterranean herbs and finished with a stunning olive and feta topping.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together feta, green olives, black olives, and lemon juice in a small bowl. Season with salt and pepper. Place in the refrigerator until ready to serve."
    },
    {
      "position": 2,
      "text": "Combine ground turkey, breadcrumbs, chopped onion, egg, feta, lemon zest, dill, oregano, garlic, and smoked paprika in a bowl. Shape mixture into four 1/4-pound patties."
    },
    {
      "position": 3,
      "text": "Preheat an outdoor grill to medium-high heat and lightly oil the grate."
    },
    {
      "position": 4,
      "text": "Cook the turkey burgers on the preheated grill until no longer pink in the center and the juices run clear, 7 to 10 minutes per side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 5,
      "text": "Top each burger with olive and feta topping."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "10e45607-2bc8-56e7-b2a4-ff27244f4f76",
  "slug": "nectarine-blueberry-cobbler-recipe-8702250",
  "name": "Nectarine Blueberry Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This nectarine blueberry cobbler is filled with succulent fresh fruit, both sweet and tart, baked under a golden batter topping. It\u2019s simple enough to let the fruit flavors shine through.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray an 8x8-inch baking dish with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Toss sliced nectarines, blueberries, 1 cup sugar, and cornstarch together in a bowl; add fruit to the baking dish."
    },
    {
      "position": 3,
      "text": "Stir flour, remaining 1/2 cup sugar, butter, egg, and vanilla together in a bowl to make a smooth batter. Drop batter by spoonfuls evenly over fruit."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cobbler is golden, and fruit is bubbly, 28 to 35 minutes."
    },
    {
      "position": 5,
      "text": "Optional: Heat an air fryer to 400 degrees F (200 degrees C). Place cobbler in the air fryer until topping is crunchy, about 5 minutes."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 30,

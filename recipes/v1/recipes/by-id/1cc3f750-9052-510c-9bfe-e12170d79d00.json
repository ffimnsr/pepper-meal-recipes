{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "1cc3f750-9052-510c-9bfe-e12170d79d00",
  "slug": "juicy-asian-steamed-chicken-thighs",
  "name": "Thai-Inspired Steamed Chicken Thighs",
  "recipe_type": "drink",
  "brief_description": "Simmer these juicy chicken thighs in coconut juice, then drizzle them with a tangy sauce of Thai chiles, fish sauce, cilantro, and ginger.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with 4 to 5 inches of water. Insert a large steam rack inside the pot."
    },
    {
      "position": 2,
      "text": "Season chicken thighs with salt and spread ginger slices over top. Arrange thighs in an even layer in a large, shallow, heat-proof bowl. Sprinkle white parts of green onions over top; pour in coconut juice and water. Place the bowl onto the steam rack in the pot."
    },
    {
      "position": 3,
      "text": "Cover the pot and bring water to a boil. Reduce the heat to a simmer and cook until chicken is no longer pink at the bone and the juices run clear, about 35 minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 4,
      "text": "While the chicken is cooking, combine Thai chiles, cilantro stems, garlic, ginger, fish sauce, vinegar, lime juice, and palm sugar in a food processor; pulse until mixture is well combined. Transfer sauce to a medium bowl and stir in green parts of green onions."
    },
    {
      "position": 5,
      "text": "Heat vegetable oil in a skillet over medium heat until smoking, about 4 minutes. Remove from the heat, pour hot oil into sauce mixture, and stir to combine."
    },
    {
      "position": 6,
      "text": "Use an oven mitt or dish retriever tool to carefully remove chicken bowls from the pot. Transfer chicken to a plate; discard ginger and green onion pieces."
    },
    {
      "position": 7,
      "text": "Pour remaining cooking liquid through a sieve into sauce mixture; stir to combine."
    },
    {
      "position": 8,
      "text": "Pour sauce over chicken. Garnish with cilantro leaves."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

  "id": "7701d31e-42c5-5295-9cb5-7a6ed4bcfa40",
  "slug": "spinach-con-queso-dip",
  "name": "Spinach Con Queso Dip",
  "recipe_type": "appetizer",
  "brief_description": "This yummy spinach con queso dip is made with cheese, milk, spinach, bell pepper, onions, and tomatoes and served warm with tortilla chips.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine pepper Jack cheese and milk in top of a double boiler over simmering water. Stir frequently, scraping down the sides with a rubber spatula to avoid scorching, until cheese is melted and well combined with the milk, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir onions, tomatoes, spinach, and red bell pepper into the cheese mixture. Cover and simmer until dip has thickened and flavors are well blended, about 15 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 20,

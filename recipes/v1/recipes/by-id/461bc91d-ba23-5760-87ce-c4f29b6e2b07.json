  "id": "461bc91d-ba23-5760-87ce-c4f29b6e2b07",
  "slug": "strawberry-crescent-roll-shortcake",
  "name": "Strawberry Crescent Roll Shortcake",
  "recipe_type": "dessert",
  "brief_description": "This strawberry crescent roll shortcake recipe is an easy and delicious breakfast or dessert using refrigerated crescent roll dough and fresh strawberries.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Place 1/2 cup strawberries and water in the bowl of a food processor; pulse until smooth."
    },
    {
      "position": 3,
      "text": "Combine 3 tablespoons sugar and cornstarch in a saucepan. Add pur\u00e9ed strawberry mixture; cook and stir until strawberry sauce has thickened, about 5 minutes. Stir in remaining 2 cups strawberries and lemon juice. Set aside."
    },
    {
      "position": 4,
      "text": "Unroll dough. Place 1 crescent roll on top of another; roll up, starting at the small end, to make 4 rolled double crescents. Brush each double roll with 1/2 teaspoon heavy cream and sprinkle each with 1/2 teaspoon sugar."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown, 20 to 25 minutes. Transfer to a wire rack; cool completely."
    },
    {
      "position": 6,
      "text": "Split rolls in half horizontally; fill each with strawberry mixture and top with 1/2 cup whipped cream and crescent roll tops. Top servings with more strawberries mixture."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

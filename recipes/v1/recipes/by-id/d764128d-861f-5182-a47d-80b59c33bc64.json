  "id": "d764128d-861f-5182-a47d-80b59c33bc64",
  "slug": "ras-malai",
  "name": "Ras Malai",
  "recipe_type": "dessert",
  "brief_description": "This version of a popular Indian dessert consists of cheese dumplings in a cream sauce topped with pistachios and almonds.",
  "cuisine": "Indian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Blend the ricotta cheese and 1/4 cup sugar together in a bowl with a hand mixer; divide the mixture between 12 muffin cups."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 35 to 40 minutes. Cool in the pans for 10 minutes before removing to cool completely on a wire rack. Arrange the cheese balls onto a dessert platter."
    },
    {
      "position": 4,
      "text": "While the cheese bakes, pour the half and half into a saucepan and bring to a simmer over low heat; simmer 10 minutes. Stir 1 cup sugar, the cardamom, rose water, and saffron into the half and half and simmer another 2 minutes. Remove from heat and allow to cool completely. Drizzle the cooled mixture over the cheese balls. Sprinkle the almonds and pistachios over the cheese balls to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "83fc623a-1a66-5418-923b-5240e60a2f5f",
  "slug": "mexican-gravy",
  "name": "Mexican Gravy",
  "recipe_type": "side",
  "brief_description": "This Mexican-style 'gravy' is a delicious accompaniment for your burritos, tortilla chips, or whatever you think needs a touch of chili powder and oregano.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Mix flour, chili powder, onion powder, oregano, and salt together in a small bowl."
    },
    {
      "position": 2,
      "text": "Heat oil in a large saucepan over low heat. Whisk flour mixture into hot oil until smooth. Pour water into mixture in small amounts and whisk to incorporate smoothly between additions. Bring the gravy to a simmer for 5 minutes. Remove from heat and cool 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,

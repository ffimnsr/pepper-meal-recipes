  "id": "9acbbb7a-ea6e-58bf-96e8-0c6807ecbebf",
  "slug": "butternut-squash-sweet-potato-soup",
  "name": "Butternut Squash Sweet Potato Soup",
  "recipe_type": "soup",
  "brief_description": "Butternut squash and sweet potatoes combine perfectly in this pureed soup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large pot over medium-high heat. Add butternut squash, sweet potato, onion, carrot, celery, and garlic; cook and stir until lightly browned, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir in chicken stock and bell peppers; bring to a boil. Reduce heat to low, cover, and simmer until squash and potato tender, about 40 minutes."
    },
    {
      "position": 3,
      "text": "Fill a blender halfway with soup. Cover and hold lid down with a potholder; pulse a few times before leaving on to blend. Pour into a pot. Repeat with remaining soup. Season with salt and black pepper."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

  "schema_version": 1,
  "id": "d23963bc-30aa-5b98-b00b-e58db56464ab",
  "slug": "chicken-crunchwrap-casserole-recipe-11931124",
  "name": "Chicken Crunchwrap Casserole",
  "recipe_type": "side",
  "brief_description": "This chicken crunchwrap casserole is just the thing for when you crave a crunchwrap but you're cooking for the whole family. Loaded with chicken, pinto beans, Cheddar cheese, and baked inside a crunchy tortilla casing, this is perfect for Taco Tuesday or any weeknight.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Add beans and water to a large sauce pan over medium-high heat and lightly mash beans with a fork. Stir in chicken and taco seasoning and cook until heated through, about 3 minutes."
    },
    {
      "position": 3,
      "text": "Reserve 3 tablespoons green onions for topping and add remaining green onions to chicken mixture. Stir in 1 cup of cheese and set mixture aside."
    },
    {
      "position": 4,
      "text": "Brush half the butter along bottom and sides of a 9x13-inch baking dish. Arrange 5 tortillas along the edges and bottom of the pan, allowing any excess to hang over the sides and overlapping to completely cover the pan. Scatter remaining shredded cheese over tortillas and top with tomatoes. Spread sour cream over tomatoes."
    },
    {
      "position": 5,
      "text": "Arrange tostada shells over the top, allowing them to overlap. Spread nacho cheese sauce evenly over tostada shells; top evenly with chicken mixture. Place remaining tortilla on the center of chicken mixture. Wrap overhanging tortillas around over the top tortilla."
    },
    {
      "position": 6,
      "text": "Brush casserole with remaining butter and press down any loose ends. Place a small sheet pan or another casserole dish on top of casserole."
    },
    {
      "position": 7,
      "text": "Bake casserole in the preheated oven until golden brown, lightly toasted, and heated throughout, about 23 minutes; remove the top pan after 10 minutes. Let stand for 10 minutes before serving with desired toppings."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

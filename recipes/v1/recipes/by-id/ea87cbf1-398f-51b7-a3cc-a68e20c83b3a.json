{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "ea87cbf1-398f-51b7-a3cc-a68e20c83b3a",
  "slug": "kale-and-roasted-butternut-squash-salad-recipe-11853753",
  "name": "Kale and Roasted Butternut Squash Salad",
  "recipe_type": "salad",
  "brief_description": "Kale teams up with roasted butternut squash, red cabbage, a Granny Smith apple, feta cheese, and lots of fall flavors in this colorful and tasty salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C) and line a sheet pan with foil."
    },
    {
      "position": 2,
      "text": "Toss butternut squash cubes with olive oil, everything seasoning, and rosemary in a large bowl. Pour onto the prepared pan in a single layer."
    },
    {
      "position": 3,
      "text": "Roast, uncovered, in the preheated oven until squash is fork tender, 20 to 25 minutes. Place in the refrigerator to cool, about 15 minutes."
    },
    {
      "position": 4,
      "text": "Stack kale leaves, roll up tightly, and cut across the roll in 1/8-inch slices, creating thin shreds (chiffonade). Place shreds in a large salad bowl. Add cabbage, apple, and pomegranate seeds, and butternut squash to the salad bowl."
    },
    {
      "position": 5,
      "text": "For vinaigrette, pour pomegranate juice, olive oil, and red wine vinegar into a jar with a tight-fitting lid. Add Dijon mustard, garlic, honey, and a little salt. Close the lid and shake vigorously. Taste, and adjust honey and salt, if necessary."
    },
    {
      "position": 6,
      "text": "Pour vinaigrette over salad and toss. Garnish with walnuts, feta, and red onion, to taste."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

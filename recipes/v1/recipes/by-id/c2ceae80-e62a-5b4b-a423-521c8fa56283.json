  "id": "c2ceae80-e62a-5b4b-a423-521c8fa56283",
  "slug": "grilled-pita-pizza-recipe-7508264",
  "name": "Grilled Pita Pizza",
  "recipe_type": "snack",
  "brief_description": "Here's an easy grilled pita pizza with grilled vegetables",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the grill for medium-high heat and lightly oil the grate. Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Toss bell pepper and red onion with Italian dressing in a bowl. Grill vegetables until tender with a bite, 5 to 8 minutes, turning occasionally. Allow to cool slightly, then cut peppers into thin strips; cut onions into 3/4-inch pieces."
    },
    {
      "position": 3,
      "text": "Place pita on the grill until grill marks form, 30 seconds to 2 minutes; turn, and grill the other side until grill marks form, 30 seconds to 2 minutes."
    },
    {
      "position": 4,
      "text": "Place pita on a sheet pan. Spread one side of pita with olive oil and pizza sauce. Scatter peppers, onion, mushrooms, and black olives over pita, and sprinkle with mozzarella cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese melts, about 5 minutes."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

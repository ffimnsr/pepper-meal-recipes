  "id": "4ca73439-f475-5bdd-9630-b9d80364befa",
  "slug": "one-pan-pesto-chicken-and-vegetables-recipe-11890699",
  "name": "One-Pan Pesto Chicken and Vegetables",
  "recipe_type": "soup",
  "brief_description": "This one-pan pesto chicken and vegetables is a quick and cozy weeknight dinner. Creamy, herb-packed pesto chicken and orzo come together in one skillet with tender broccoli, Sweety Drop peppers, and a silky bone-broth sauce that tastes indulgent without feeling heavy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large skillet over medium-high heat. Season chicken with salt, pepper, and herbs. Sear until just cooked through, 2 to 3 minutes per side. Transfer to a plate and loosely tent with foil."
    },
    {
      "position": 2,
      "text": "Reduce heat to medium. Add broccoli with a pinch of salt and saut\u00e9 1 to 2 minutes. Stir in garlic and cook until fragrant, about 30 seconds."
    },
    {
      "position": 3,
      "text": "Add orzo to the skillet and toast for 1 minute. Pour in chicken bone broth, scraping up browned bits. Bring to a gentle simmer, cover, and cook, stirring occasionally, until orzo is tender and saucy, 7 to 9 minutes. Stir in tomatoes and capers."
    },
    {
      "position": 4,
      "text": "Lower heat and gently stir in pesto and cream. Nestle chicken back into the skillet; warm for 2 to 3 minutes."
    },
    {
      "position": 5,
      "text": "Remove from heat and fold in Sweetie Drop peppers. Taste; adjust seasoning if needed."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

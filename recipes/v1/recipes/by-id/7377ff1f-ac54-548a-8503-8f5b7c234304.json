  "id": "7377ff1f-ac54-548a-8503-8f5b7c234304",
  "slug": "jambalaya",
  "name": "Best Jambalaya",
  "recipe_type": "soup",
  "brief_description": "This spicy jambalaya with chicken, andouille sausage, rice, and the perfect amount of Cajun seasonings is easy to make in one pot for a hearty meal.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon of peanut oil in a large heavy Dutch oven over medium heat. Season sausage and chicken pieces with Cajun seasoning. Saut\u00e9 sausage until browned. Remove with slotted spoon, and set aside."
    },
    {
      "position": 3,
      "text": "Add 1 tablespoon peanut oil, and saut\u00e9 chicken pieces until lightly browned on all sides. Remove with a slotted spoon, and set aside."
    },
    {
      "position": 4,
      "text": "In the same pot, saut\u00e9 onion, bell pepper, celery, and garlic until tender."
    },
    {
      "position": 5,
      "text": "Stir in crushed tomatoes, and season with red pepper, black pepper, salt, hot pepper sauce, Worcestershire sauce, and fil\u00e9 powder."
    },
    {
      "position": 6,
      "text": "Stir in chicken and sausage. Cook for 10 minutes, stirring occasionally."
    },
    {
      "position": 7,
      "text": "Stir in the rice and chicken broth."
    },
    {
      "position": 8,
      "text": "Bring to a boil, reduce heat, and simmer for 20 to 25 minutes, or until liquid is absorbed."
    },
    {
      "position": 9,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

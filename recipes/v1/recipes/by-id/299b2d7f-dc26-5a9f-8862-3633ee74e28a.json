  "id": "299b2d7f-dc26-5a9f-8862-3633ee74e28a",
  "slug": "chef-johns-beef-sliders",
  "name": "Chef John's Beef Sliders",
  "recipe_type": "main",
  "brief_description": "These flavorful beef sliders are topped with tomato and a dollop of Chef John's secret sauce. Perfect for football Sunday or Super Bowl parties.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place ground beef onto a work surface; divide into 8 equal-size pieces using a knife or pastry cutter. Line 8 muffin cups with paper liners."
    },
    {
      "position": 2,
      "text": "Sprinkle bottoms of paper liners with salt and black pepper. Form each piece of burger into a rough ball and place into a muffin cup. Season tops with salt and pepper."
    },
    {
      "position": 3,
      "text": "Place a second paper liner on top of each piece of meat and gently press it down to shape the mini burger into a round, flat shape. Pull off the paper tops and remove burgers from the muffin cups; remove bottom paper liners from burgers."
    },
    {
      "position": 4,
      "text": "Heat a large nonstick skillet over medium-high heat. Cook burgers in the hot skillet until they have a browned crust and are slightly pink in the middle, about 3 minutes per side. Flip burgers and cook 3 minutes on other side. Remove burgers to a plate to rest for 2 minutes."
    },
    {
      "position": 5,
      "text": "Mix mayonnaise, ketchup, mustard, and pickle relish in a bowl; spoon a dollop onto each bun. Place burgers onto buns, season with more black pepper, and top with a tomato slice. Close buns and serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

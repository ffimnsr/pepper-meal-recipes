  "id": "f560c094-442f-566c-bf00-a0aa1e944993",
  "slug": "simply-traditional-lasagna",
  "name": "Easy Cheesy Lasagna",
  "recipe_type": "main",
  "brief_description": "This easy cheesy lasagna recipe is a simple lasagna made with ground beef, sausage, jarred marinara sauce, and lots of ricotta and mozzarella cheese.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Cook ground beef and Italian sausage in a large skillet over medium-high heat until browned and crumbled; drain excess grease. Stir in olives and water; season with minced garlic, oregano, onion flakes, garlic powder, pepper, sage, and basil. Simmer, stirring frequently, about 15 minutes. Stir in marinara sauce and remove from the heat."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Spoon a layer of meat and sauce on the bottom of a 9x13 inch baking dish. Cover with a layer of dry noodles. Spread a thin layer of ricotta cheese over noodles; sprinkle with some mozzarella cheese. Cover with another layer of sauce; repeat layering, ending with meat and sauce on top. Reserve about 1/2 cup mozzarella cheese."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 45 minutes, checking after 30 minutes. Lasagna is cooked when it\u2019s easily pierced with a knife. Sprinkle reserved mozzarella cheese over lasagna and bake until melted, about 10 minutes more."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "7edde741-ebf9-5cfc-8fa6-834ff5612882",
  "slug": "jamies-cranberry-spinach-salad",
  "name": "Jamie's Cranberry Spinach Salad",
  "recipe_type": "salad",
  "brief_description": "This spinach salad is packed with fresh spinach, toasted almonds, and dried cranberries tossed with a sweet and tangy homemade poppy seed dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a medium saucepan over medium heat. Cook and stir almonds in butter until lightly toasted. Remove from heat and let cool."
    },
    {
      "position": 2,
      "text": "Make dressing: Whisk together oil, sugar, cider vinegar, white wine vinegar, sesame seeds, poppy seeds, minced onion, and paprika in a medium bowl."
    },
    {
      "position": 3,
      "text": "Combine spinach with toasted almonds and cranberries in a large serving bowl. Pour dressing over spinach mixture; toss well."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "cbc9d0c6-5e60-541a-9cb5-e8638d25c46e",
  "slug": "mini-air-fryer-cherry-hand-pies",
  "name": "Mini Air Fryer Cherry Hand Pies",
  "recipe_type": "dessert",
  "brief_description": "These delicious little hand pies filled with a cherry pie filling are great for snacking or for parties. They are quick and easy to make using prepared pie dough and pie filling.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Roll out each circle of pie dough to 1/8-inch thickness. Cut circles into the dough using a 3-inch round cookie cutter to make 16 circles (8 from each dough round)."
    },
    {
      "position": 2,
      "text": "Moisten the edge of a circle with water, then add 1 tablespoon cherry pie filling in the center. Fold the circle in half and pinch the edges of the dough together to seal. Use a fork to crimp the edges to secure them further. Add a slit in the top of the crust with a sharp knife. Repeat with the remaining dough circles."
    },
    {
      "position": 3,
      "text": "Preheat an air fryer to 350 degrees F (175 degrees C) and spray the air fryer bucket with cooking spray. Place pies in the basket in a single layer (you may need to work in batches). Spray the tops of the pies with more cooking spray, and sprinkle the tops with coarse sugar."
    },
    {
      "position": 4,
      "text": "Cook in the air fryer until golden brown, about 9 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

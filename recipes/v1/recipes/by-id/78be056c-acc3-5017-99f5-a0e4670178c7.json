  "slug": "homemade-noodles",
  "name": "Homemade Noodles",
  "recipe_type": "soup",
  "brief_description": "It just takes a few minutes to make wonderful, homemade noodles. All you need is flour, egg and a pinch of salt. What a tasty addition to fresh chicken soup!",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Mix all ingredients. Roll thin with flour, then roll like a jelly roll. Cut into 1/2 inch strips. Let dry."
    },
    {
      "position": 2,
      "text": "Drop into hot chicken broth. Boil for 15 minutes."
    }
  ],

  "id": "93753edd-5281-572c-b73a-346b1fa3e7a5",
  "slug": "pickled-red-onions",
  "name": "Pickled Red Onions",
  "recipe_type": "salad",
  "brief_description": "Pickled red onions are easy to make and add a zesty crunch to tacos, salads, sandwiches, or whatever you put them on. Keep some in the fridge at all times!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Pack onion slices into a sterilized 1-pint jar."
    },
    {
      "position": 3,
      "text": "Combine vinegar, salt, sugar, and peppercorns together in a small saucepan; bring to a boil over medium-high heat."
    },
    {
      "position": 4,
      "text": "Carefully pour brine solution over onions to fill the jar; let stand, uncovered, for 30 minutes."
    },
    {
      "position": 5,
      "text": "Seal the jar with a tight-fitting lid and shake well. Refrigerate until flavor develops, at least 1 hour or up to 2 weeks, before serving. Keep refrigerated."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

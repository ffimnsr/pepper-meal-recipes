  "schema_version": 1,
  "id": "8069148c-ace3-5800-8b95-bd842b9a3980",
  "slug": "pork-wonton-soup",
  "name": "Pork Wonton Soup",
  "recipe_type": "soup",
  "brief_description": "Steamed pork-filled wontons and steamed vegetables make a hearty and satisfying soup.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk rice wine and cornstarch together in large bowl. Add ground pork, 2 tablespoons green onion, soy sauce, ginger, sesame oil, and sugar; stir until well combined and paste-like, about 10 minutes. Cover and refrigerate for 1 hour."
    },
    {
      "position": 2,
      "text": "Place about 1 tablespoon pork mixture in the middle of a wonton wrapper. Brush edges with beaten egg and pinch edges to seal, creating a small pouch. Repeat with remaining wonton wrappers and pork mixture. Refrigerate until ready to use."
    },
    {
      "position": 3,
      "text": "Place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer. Bring water to a boil. Add bok choy, snap peas, carrot, and 2 tablespoons green onion, cover, and steam until tender, 2 to 6 minutes. Remove and distribute evenly among 4 soup bowls."
    },
    {
      "position": 4,
      "text": "Place wontons in steamer basket and steam until pork is no longer pink inside, about 10 minutes. Remove and place in soup bowls alongside vegetables."
    },
    {
      "position": 5,
      "text": "Heat chicken broth and water in a saucepan until hot, 5 to 7 minutes. Pour hot broth mixture evenly into soup bowls atop vegetables and wontons. Sprinkle 1/4 cup chopped green onion evenly over each bowl."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 60,
  "rest_time_minutes": null,
  "difficulty": "hard",

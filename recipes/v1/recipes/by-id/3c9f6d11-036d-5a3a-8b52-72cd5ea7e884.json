  "id": "3c9f6d11-036d-5a3a-8b52-72cd5ea7e884",
  "slug": "grandmas-caramel-popcorn-balls",
  "name": "Grandma's Caramel Popcorn Balls",
  "recipe_type": "dessert",
  "brief_description": "This generational caramel popcorn balls recipe is for sweet and salty popcorn balls, featuring creamy homemade caramel, just like Grandma used to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Line a baking sheet with parchment paper; set aside."
    },
    {
      "position": 2,
      "text": "Sort through popcorn; discard unpopped kernels."
    },
    {
      "position": 3,
      "text": "Combine evaporated milk, sugar, corn syrup, margarine, and salt in a large saucepan over medium heat; attach a candy thermometer to the saucepan and bring mixture to a boil. Cook, stirring constantly, until caramel reaches 246 degrees F (119 degrees C), about 5 minutes."
    },
    {
      "position": 4,
      "text": "Place some popcorn into a very large bowl; pour in some caramel and stir until evenly coated. Add remaining popcorn and caramel in batches, stirring well after each addition."
    },
    {
      "position": 5,
      "text": "Scoop some popcorn mixture onto a piece of plastic wrap; gather and twist the plastic wrap to gently shape mixture into a ball. Place popcorn ball on the prepared baking sheet; repeat with remaining popcorn mixture. Cool popcorn balls until set, about 15 minutes."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

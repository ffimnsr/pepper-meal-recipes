  "slug": "miso-roasted-broccoli-recipe-11702202",
  "name": "Miso Roasted Broccoli",
  "recipe_type": "side",
  "brief_description": "This miso roasted broccoli recipe makes a crispy roasted broccoli with huge flavor, and it is a quick and easy side dish that goes with just about anything.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a large baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "In a large bowl whisk butter, soy sauce, vinegar, miso paste, and garlic until smooth. Add broccoli florets and toss until evenly combined. Spread broccoli mixture on the prepared baking sheet in an even layer."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until tender, about 15 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

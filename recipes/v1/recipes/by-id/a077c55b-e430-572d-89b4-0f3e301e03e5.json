  "id": "a077c55b-e430-572d-89b4-0f3e301e03e5",
  "slug": "nutty-pecan-waffles",
  "name": "Nutty Pecan Waffles",
  "recipe_type": "dessert",
  "brief_description": "Sweet and nutty waffles to warm any winter morning.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat waffle iron. In a large mixing bowl, sift together flour, baking powder, sugar and baking soda. In a separate bowl, beat together egg yolks and milk. Add milk mixture, butter and oil to flour; stir gently to combine. Beat egg whites until stiff peaks have formed; fold into batter."
    },
    {
      "position": 2,
      "text": "Spray preheated waffle iron with non-stick cooking spray. Pour mix onto hot waffle iron and sprinkle generously with chopped pecans. Cook until golden brown. Keep warm in oven while remaining waffles cook."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

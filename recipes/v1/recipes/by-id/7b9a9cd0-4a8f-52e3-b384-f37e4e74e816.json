  "id": "7b9a9cd0-4a8f-52e3-b384-f37e4e74e816",
  "slug": "pizza-pinwheels",
  "name": "Pizza Pinwheels",
  "recipe_type": "appetizer",
  "brief_description": "These easy pizza pinwheels roll pepperoni and mozzarella in crescent dough for a quick, cheesy party snack served with pizza sauce for dipping.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Arrange dough triangles on a large baking sheet. Press seams together to form 4 rectangles. Top each rectangle with 6 pepperoni slices; divide mozzarella evenly among rectangles. Roll each rectangle up tightly lengthwise; cut each roll into 4 pieces."
    },
    {
      "position": 3,
      "text": "Bake until golden brown, about 12 to 14 minutes. Serve with pizza sauce for dipping."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "a2f28f5a-000a-57ac-9e1d-7754f4f850a4",
  "slug": "mexican-chicken-tortilla-lasagna",
  "name": "Mexican Chicken Tortilla Lasagna",
  "recipe_type": "main",
  "brief_description": "Pasta is replaced by tortillas in this lasagna dish, creating a Mexican-Italian mashup that's sure to appeal to everyone at the table.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spread about 4 tablespoons enchilada sauce over the bottom of an 8x6-inch baking dish. Pour remaining enchilada sauce into a medium bowl."
    },
    {
      "position": 2,
      "text": "Heat oil in a heavy skillet over medium-high heat. Add onion; cook and stir until translucent, about 5 minutes. Add ground chicken and saut\u00e9 until browned and crumbly, 5 to 7 minutes. Pour diced tomatoes and liquid into the skillet and stir in taco seasoning until incorporated."
    },
    {
      "position": 3,
      "text": "To the enchilada sauce in the bowl, add 4 ounces queso fresco, 1/4 cup plus 1 tablespoon Mexican crema, and egg; stir to combine."
    },
    {
      "position": 4,
      "text": "Trim tortillas to have a straight edge if desired. Lay two tortillas in enchilada sauce in the baking dish; top with some chicken mixture and some enchilada sauce mixture. Repeat layers (tortillas, chicken, sauce) twice more. Top with remaining queso fresco and Cheddar cheese."
    },
    {
      "position": 5,
      "text": "Bake, covered, in the preheated oven for 35 minutes. Uncover and bake for 10 more minutes. Let rest for 10 to 15 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

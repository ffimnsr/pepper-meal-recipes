  "id": "cba596cf-1e84-5379-9a4f-bb9f49ecd699",
  "slug": "pineapple-teriyaki-chicken-recipe-11739737",
  "name": "Pineapple Teriyaki Chicken",
  "recipe_type": "drink",
  "brief_description": "This pineapple teriyaki chicken, marinated, air fried with pineapple chunks, and then glazed with a thickened pineapple juice, ginger, and garlic sauce, rivals the best of any takeout restaurant. Serve over cooked rice.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Trim chicken breast of any visible fat, then cut chicken into 1 1/2-inch pieces. Set aside."
    },
    {
      "position": 3,
      "text": "Drain pineapple juice and add to a bowl; reserve pineapple chunks for later use. Add coconut aminos, coconut sugar, and agave syrup to the bowl. Use a microplane grater to grate garlic and ginger, mash until a paste forms, and add to the bowl. Stir in sesame oil."
    },
    {
      "position": 4,
      "text": "Pour half the marinade mixture into a resealable plastic bag; reserve remaining marinade. Add the chicken pieces into the bag, seal the bag, and refrigerate for 1 hour."
    },
    {
      "position": 5,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) for 5 minutes, or according to manufacturer\u2019s instructions. Remove chicken from marinade, discard any marinade in the bag, and air fry chicken until no longer pink at the center and juices run clear, about 10 minutes. Add pineapple chunks to the air fryer for the last 2 minutes, if desired."
    },
    {
      "position": 6,
      "text": "Meanwhile add reserved marinade to a large skillet and whisk in cornstarch until smooth; cook over medium-high heat until thickened, about 5 minutes. Add in chicken and pineapple; toss until coated. Garnish with green onions and sesame seeds and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "d083df2a-f3f7-5256-9f40-1b50a21fa679",
  "slug": "jeanies-falafel",
  "name": "Jeanie's Falafel",
  "recipe_type": "main",
  "brief_description": "This is a tasty dense falafel that contains no eggs. Serve on pitas with tzatziki or tahini sauce with lettuce and tomato.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Mash the garbanzo beans in a large bowl. Stir in the onion, garlic, cilantro, parsley, cumin, turmeric, baking powder, bread crumbs, salt and pepper. Do not be afraid to use your hands. Shape the mixture into 1 1/2 inch balls; you should get 18 to 24. If the mixture does not hold together, add a little water."
    },
    {
      "position": 2,
      "text": "Heat the oil in a deep fryer to 375 degrees F (190 degrees C). Carefully drop the balls into the hot oil, and fry until brown. If you do not have a deep fryer, heat the oil in a heavy deep skillet over medium-high heat. You may need to adjust the heat slightly after the first couple of falafels, and be sure to turn frequently so they brown evenly."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 7,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

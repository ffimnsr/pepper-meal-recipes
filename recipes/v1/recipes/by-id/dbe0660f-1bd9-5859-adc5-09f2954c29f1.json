  "id": "dbe0660f-1bd9-5859-adc5-09f2954c29f1",
  "slug": "sheet-pan-orange-chicken-and-broccoli-recipe-11787317",
  "name": "Sheet Pan Orange Chicken and Broccoli",
  "recipe_type": "main",
  "brief_description": "Try this sheet pan orange chicken and broccoli for a mid-week dinner option. It has a fresh orange flavor and is nice and saucy, so best served with rice.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 450 degrees F (220 degrees C). Line a 13x18-inch baking sheet with foil. Coat with cooking spray."
    },
    {
      "position": 2,
      "text": "Toss together chicken, 1 tablespoon olive oil, 1/2 teaspoon salt, and 1/2 teaspoon pepper in a large bowl until coated."
    },
    {
      "position": 3,
      "text": "Sprinkle chicken with flour and toss to coat."
    },
    {
      "position": 4,
      "text": "Transfer chicken to one side of the prepared baking sheet in a single layer."
    },
    {
      "position": 5,
      "text": "Add broccoli to the other side of the baking sheet. Drizzle with remaining 1 tablespoon olive oil and toss to coat. Season broccoli with remaining 1/4 teaspoon salt and 1/4 teaspoon pepper."
    },
    {
      "position": 6,
      "text": "Bake until chicken is cooked and broccoli is lightly browned, 12 minutes."
    },
    {
      "position": 7,
      "text": "Meanwhile, whisk together orange juice, soy sauce, cornstarch, honey, rice vinegar, Sriracha, garlic, sesame oil, and ginger in a medium saucepan. Bring to a boil, stirring often, until sauce thickens, 4 to 5 minutes."
    },
    {
      "position": 8,
      "text": "Toss together chicken and broccoli on the baking sheet and spread in an even layer. Pour sauce over the chicken and broccoli. Bake an additional 5 minutes."
    },
    {
      "position": 9,
      "text": "Serve over cooked white rice. Garnish with orange zest and/or orange slices and sesame seeds, if desired. Recipe developed by Barrett Heald."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,

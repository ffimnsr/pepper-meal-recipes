  "id": "dc9e2ec0-e715-5833-883c-d6af8ba642ef",
  "slug": "homemade-angel-food-cake",
  "name": "Homemade Angel Food Cake",
  "recipe_type": "dessert",
  "brief_description": "This angel food cake is just like grandma use to make.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Sift cake flour and confectioners sugar together 5 times and set aside."
    },
    {
      "position": 2,
      "text": "In a large clean bowl, whip egg whites with a pinch of salt until foamy. Add cream of tartar and continue beating until soft peaks form. Gradually add sugar while beating, and continue to beat until very stiff. Add vanilla."
    },
    {
      "position": 3,
      "text": "Quickly fold in flour mixture. Pour into a 10 inch tube pan."
    },
    {
      "position": 4,
      "text": "Bake at 350 degrees F (175 degrees C) for 45 minutes."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": null,

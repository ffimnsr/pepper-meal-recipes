  "id": "8843d538-c83b-55f7-8ac2-835d3f4d3197",
  "slug": "creamy-garlic-pasta",
  "name": "Creamy Garlic Pasta",
  "recipe_type": "main",
  "brief_description": "Looking for creamy pasta recipes? Look no further. This is the best, with garlic, cream, and Parmesan cheese \u2014 a dish that is easy and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a medium pan over medium heat. Add garlic and stir until fragrant, 1 to 2 minutes. Add butter and stir constantly until melted."
    },
    {
      "position": 3,
      "text": "Pour in 3 cups chicken broth; add pepper and salt. Bring to a boil. Add spaghetti and cook, stirring occasionally, until tender yet firm to the bite, about 12 minutes. Add more chicken broth if pasta starts to stick to the pan."
    },
    {
      "position": 4,
      "text": "Add Parmesan cheese, cream, and parsley and mix until thoroughly combined. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

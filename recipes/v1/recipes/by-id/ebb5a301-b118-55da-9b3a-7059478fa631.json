  "id": "ebb5a301-b118-55da-9b3a-7059478fa631",
  "slug": "fantastic-fennel-bruschetta",
  "name": "Fantastic Fennel Bruschetta",
  "recipe_type": "appetizer",
  "brief_description": "French bread slices, brushed with olive oil and toasted until golden brown, get a flavorful topping of fresh tomato, basil, and fennel seeds for a perfect summer appetizer or light lunch.",
  "cuisine": "Mediterranean Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "In a bowl, mix together the tomatoes, onion, garlic, fennel seed, basil, 1/3 cup olive oil, salt, and pepper. Chill for at least 1 hour to blend the flavors."
    },
    {
      "position": 2,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Brush both sides of bread slices with some of the 1/4 cup of olive oil; place slices onto a baking sheet. Toast the bread until golden brown and crunchy on the outside, about 3 minutes per side. To serve, spoon the tomato mixture onto the toasted bruschetta and arrange on a serving platter."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,

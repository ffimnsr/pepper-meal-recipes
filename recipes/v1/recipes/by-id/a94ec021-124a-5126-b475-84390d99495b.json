  "id": "a94ec021-124a-5126-b475-84390d99495b",
  "slug": "hash-brown-crust-bacon-quiche-recipe-11681752",
  "name": "Hash Brown Crust Bacon Quiche",
  "recipe_type": "main",
  "brief_description": "This hash brown crust bacon quiche elevates humble potatoes to a new gold standard as a crispy quiche crust. With bacon, mozzarella, and Cheddar cheese, it\u2019s perfect to take for weekday lunches.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Lightly grease an ovenproof pie pan."
    },
    {
      "position": 2,
      "text": "Shred potatoes, then place in a cheesecloth. Lightly salt potatoes, then wring out as much water as possible. Pat with a paper towel, then place in a bowl."
    },
    {
      "position": 3,
      "text": "Melt 5 tablespoons butter, add to potatoes, and season with salt, pepper, cayenne, and garlic powder."
    },
    {
      "position": 4,
      "text": "Add 1 egg to potatoes, then mix well. Pour into prepared pie pan; press potatoes into the bottom and up the sides to form a crust, making bottom crust fairly thin so that it will cook completely. Place on a baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 25 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, whisk 4 eggs together in a bowl; season with salt and pepper. Stir in cream and green onions."
    },
    {
      "position": 7,
      "text": "Remove crust from oven; reduce the temperature 350 degrees F (180 degrees C). Sprinkle bacon into the crust, then top with cheese. Carefully pour egg mixture evenly over cheese carefully."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until a fork inserted in the middle comes out clean and the quiche is puffed and golden, about 30 minutes. Let cool 5 minutes before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

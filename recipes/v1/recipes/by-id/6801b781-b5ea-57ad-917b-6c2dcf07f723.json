  "id": "6801b781-b5ea-57ad-917b-6c2dcf07f723",
  "slug": "bistec-encebollao",
  "name": "Bistec Encebollao",
  "recipe_type": "soup",
  "brief_description": "Bistec encebollao is a Puerto Rican beef and onions stew recipe of marinated steak in oil, oregano, and vinegar. Serve it with white rice and tostones.",
  "cuisine": "Puerto Rican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine steak, onions, beef stock, olive oil, vinegar, garlic, Saz\u00f3n seasoning, salt, and oregano in a large resealable plastic bag; toss to coat steak with marinade. Squeeze out excess air and seal the bag. Marinate in the refrigerator at least 4 hours up to 2 days."
    },
    {
      "position": 2,
      "text": "Transfer steak and marinade to a large deep skillet; bring to a boil. Reduce heat to low; cover and simmer until steak is fork-tender, about 40 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,

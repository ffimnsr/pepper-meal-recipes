  "id": "b51c4062-6c6f-5292-9ec5-a93c452f066e",
  "slug": "ranch-burgers",
  "name": "Ranch Burgers",
  "recipe_type": "main",
  "brief_description": "Juicy, delicious ranch burgers, made with lean ground beef, onion, and a package of ranch dressing mix, are a nice departure from plain old beef patties.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Mix ground beef, onion, crushed crackers, egg, and ranch dressing mix together in a bowl until well combined. Form into eight hamburger patties."
    },
    {
      "position": 3,
      "text": "Cook patties on the preheated grill until no longer pink in the center, about 5 minutes per side. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C)."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

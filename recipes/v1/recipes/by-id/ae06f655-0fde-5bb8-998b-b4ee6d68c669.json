  "id": "ae06f655-0fde-5bb8-998b-b4ee6d68c669",
  "slug": "blueberry-banana-breakfast-bars",
  "name": "Blueberry Banana Breakfast Bars",
  "recipe_type": "appetizer",
  "brief_description": "Blueberry and banana breakfast bars are loaded oats, figs, almonds, and sunflower seeds for a healthy, on-the-go breakfast or snack.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line an 8-inch square baking pan with parchment paper, leaving 1 inch of parchment hanging over the sides."
    },
    {
      "position": 2,
      "text": "Mix oats, figs, almonds, and 1/4 cup sunflower seeds together in a bowl."
    },
    {
      "position": 3,
      "text": "Stir bananas, peanut butter, and honey together in a saucepan over medium-low heat until completely melted and smooth, about 5 minutes. Remove saucepan from heat."
    },
    {
      "position": 4,
      "text": "Whisk egg whites together in a bowl until foamy. Mix banana mixture into egg whites and whisk until smooth; add oat mixture and stir until batter well combined. Fold blueberries into batter. Press batter into the prepared pan; top with flax seeds and 1 tablespoon sunflower seeds."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden, about 30 minutes. Cool completely before cutting into bars."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "ed32ffd9-7c4d-5617-8e1d-821a7032caea",
  "slug": "grandmas-lemon-meringue-pie",
  "name": "Grandma\u2019s Lemon Meringue Pie",
  "recipe_type": "dessert",
  "brief_description": "This lemon meringue pie has a deliciously tart homemade lemon filling baked in a pie crust with a fluffy meringue topping for a dreamy dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients and preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "To make the lemon filling: Whisk 1 cup sugar, flour, cornstarch, and salt together in a medium saucepan; stir in water, lemon juice, and lemon zest. Cook over medium-high heat, stirring frequently, until mixture comes to a boil. Stir in butter."
    },
    {
      "position": 3,
      "text": "Place egg yolks in a small bowl and gradually whisk in 1/2 cup of hot sugar mixture."
    },
    {
      "position": 4,
      "text": "Whisk egg yolk mixture back into remaining sugar mixture. Bring to a boil and continue to cook while stirring constantly until thick. Remove from heat; pour filling into prepared baked pie crust."
    },
    {
      "position": 5,
      "text": "To make the meringue topping: Beat egg whites in a glass, metal, or ceramic bowl with an electric mixer until foamy. Gradually add sugar, continuing to beat until stiff peaks form."
    },
    {
      "position": 6,
      "text": "Working quickly, spread meringue over pie filling, sealing the edges at the crust. Use the back of the spoon to create peaks on the top of the meringue if you like."
    },
    {
      "position": 7,
      "text": "Bake pie in the preheated oven until meringue is golden brown, about 20 to 25 minutes."
    },
    {
      "position": 8,
      "text": "Remove pie from oven and cool at room temperature for 45 minutes to 1 hour. Transfer to the refrigerator, uncovered, and chill for a minimum of 2 hours before slicing."
    },
    {
      "position": 9,
      "text": "Serve and enjoy! Store any leftovers in the refrigerator and consume within 2 days."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

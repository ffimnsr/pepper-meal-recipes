  "id": "d5c96912-9982-580b-9d68-8e40587a46e0",
  "slug": "homemade-italian-sausage",
  "name": "Homemade Italian Sausage",
  "recipe_type": "main",
  "brief_description": "Try Chef John's uncle's recipe for a superb homemade spicy Italian sausage.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Cut pork shoulder into cubes. Place in a bowl and refrigerate while preparing the other ingredients."
    },
    {
      "position": 2,
      "text": "Grind garlic with a pinch of salt in a mortar to make a paste. Add fennel, anise, and black pepper. Bruise spices lightly with a pestle to release the flavors. Add red pepper flakes, cayenne pepper, oregano, marjoram, coriander, mustard, allspice, sugar, and a splash of water. Stir to combine."
    },
    {
      "position": 3,
      "text": "Add the spice paste to the pork cubes. Mix thoroughly by hand. Add the remaining salt. Cover and refrigerate until flavors meld, 8 hours to overnight."
    },
    {
      "position": 4,
      "text": "Process the cold pork through a meat grinder on the slowest speed."
    },
    {
      "position": 5,
      "text": "Push a casing onto the stuffing tube of your meat grinder. Feed the sausage meat through the filling tray. Run the meat through the casing on the slowest speed until all the casing is used up. Tie casing at the end into a knot. Pinch and twist the meat to create links if desired."
    },
    {
      "position": 6,
      "text": "Place sausage onto a wire rack set over a sheet pan. Refrigerate uncovered for 24 hours."
    },
    {
      "position": 7,
      "text": "Preheat a charcoal grill for medium heat. Separate the links and grill them until browned, about 5 minutes per side."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 70,
  "rest_time_minutes": null,

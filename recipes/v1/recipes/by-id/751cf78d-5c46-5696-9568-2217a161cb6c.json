  "id": "751cf78d-5c46-5696-9568-2217a161cb6c",
  "slug": "apple-and-brown-sugar-corned-beef",
  "name": "Apple and Brown Sugar Corned Beef",
  "recipe_type": "drink",
  "brief_description": "This brown sugar corned beef features brisket, potatoes, carrots, and cabbage simmered in a slow cooker with apple juice, brown sugar, and mustard.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Pour apple juice into a large slow cooker. Mix in brown sugar and mustard, stirring until brown sugar has dissolved. Mix in the contents of the spice packets, then lay briskets into apple juice mixture. Top with potatoes, cabbage chunks, onions, and carrots, then push vegetables into liquid."
    },
    {
      "position": 2,
      "text": "Cover and cook on High for 4 to 5 hours or on Low for 8 to 10 hours, until corned beef is very tender. Slice the meat thinly across the grain and serve with the vegetables."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 240,
  "preparation_time_minutes": 15,

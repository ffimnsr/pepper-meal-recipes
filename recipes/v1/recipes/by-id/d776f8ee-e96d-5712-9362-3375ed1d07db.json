  "slug": "air-fryer-miso-glazed-salmon-recipe-11842612",
  "name": "Air Fryer Miso-Glazed Salmon",
  "recipe_type": "dessert",
  "brief_description": "This air fryer miso-glazed salmon has a perfect balance of salt, sweet, and heat. With only 5 ingredients, it's quick and easy enough for everyday dinner, but definitely flavorful enough for company.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place salmon fillets in a flat dish."
    },
    {
      "position": 2,
      "text": "Whisk brown sugar, miso paste, soy sauce, and chili flakes in a bowl. Pour mixture over salmon fillets. Cover and refrigerate for 30 minutes."
    },
    {
      "position": 3,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C). Spray basket with cooking spray."
    },
    {
      "position": 4,
      "text": "Using tongs, place salmon filets skin side down in the basket of the air fryer, making sure to reserve the excess marinade. Cook 4 minutes. Baste filets with reserved marinade and cook 4 minutes more."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "abae66ce-3fd4-57dc-8aac-aec326dcd151",
  "slug": "marinated-cucumber-onion-and-tomato-salad",
  "name": "Cucumber Tomato Salad",
  "recipe_type": "salad",
  "brief_description": "This cucumber tomato salad tosses sliced cucumbers, fresh tomatoes, and onion in a sweet and tangy vinaigrette dressing for an easy summer side.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk water, vinegar, oil, sugar, salt, and black pepper together in a large bowl until smooth."
    },
    {
      "position": 3,
      "text": "Add cucumbers, tomatoes, and onion; stir to coat."
    },
    {
      "position": 4,
      "text": "Cover the bowl with plastic wrap; refrigerate for at least 2 hours for best flavor results."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,

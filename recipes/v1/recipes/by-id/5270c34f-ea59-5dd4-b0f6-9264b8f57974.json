  "id": "5270c34f-ea59-5dd4-b0f6-9264b8f57974",
  "slug": "thai-spicy-tuna-lettuce-wraps",
  "name": "Thai Spicy Tuna Lettuce Wraps",
  "recipe_type": "salad",
  "brief_description": "Made with canned tuna, chile peppers, Thai basil, and cilantro, these lettuce wraps drizzled with Sriracha aioli can be served as an appetizer or a light meal.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Make the spicy mayo: Mix Sriracha, mayonnaise, and sambal together in a small bowl. Refrigerate until needed."
    },
    {
      "position": 2,
      "text": "Make the lettuce wraps: Empty drained tuna into a large bowl. Break up tuna into large chunks. Add 1/2 cup cilantro, 1/4 cup basil, bell pepper, onion, carrot, 2/3 of the green onions, and jalape\u00f1o pepper; gently mix to combine, being careful not to break tuna apart too much."
    },
    {
      "position": 3,
      "text": "Whisk sesame oil, sambal, sesame seeds, sugar, salt, pepper, lime juice, and garlic together in a small bowl. Pour dressing over tuna mixture and mix carefully."
    },
    {
      "position": 4,
      "text": "Spoon tuna mixture onto lettuce leaves and drizzle spicy mayo over top. Garnish with remaining green onions, cilantro, and basil."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "easy",

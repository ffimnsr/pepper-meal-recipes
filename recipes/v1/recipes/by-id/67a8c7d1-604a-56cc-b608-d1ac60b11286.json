  "schema_version": 1,
  "id": "67a8c7d1-604a-56cc-b608-d1ac60b11286",
  "slug": "tres-leches-milk-cake",
  "name": "Tres Leches (Milk Cake)",
  "recipe_type": "dessert",
  "brief_description": "This tres leches cake has a light sponge cake layer soaked in a sweet milk mixture, topped with whipped cream for a decadent Mexican dessert.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch baking pan."
    },
    {
      "position": 3,
      "text": "Sift flour and baking powder together; set aside."
    },
    {
      "position": 4,
      "text": "Beat sugar and butter together in a large bowl with an electric mixer until lighter in color and fluffy. Add eggs and vanilla; beat well. Add flour mixture, about 1/2 cup at a time, mixing until well blended."
    },
    {
      "position": 5,
      "text": "Pour batter into the prepared pan."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 30 minutes. Pierce cake all over with a fork; let cool to room temperature."
    },
    {
      "position": 7,
      "text": "Mix whole milk, condensed milk, and evaporated milk together in a bowl."
    },
    {
      "position": 8,
      "text": "Pour the whole milk, condensed milk, and evaporated milk mixture over the top of the cooled cake and allow to soak in."
    },
    {
      "position": 9,
      "text": "Whip cream, remaining 1 cup of sugar, and 1 teaspoon vanilla in a chilled glass or metal bowl with an electric mixer until thick."
    },
    {
      "position": 10,
      "text": "When milk mixture has soaked in, spread cream on top of the cake."
    },
    {
      "position": 11,
      "text": "Keep cake refrigerated until ready to serve. Sprinkle ground cinnamon over top of the cake before slicing. Enjoy!"
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

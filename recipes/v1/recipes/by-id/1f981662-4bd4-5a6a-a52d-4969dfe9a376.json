  "id": "1f981662-4bd4-5a6a-a52d-4969dfe9a376",
  "slug": "chilaquiles-iii",
  "name": "Chilaquiles III",
  "recipe_type": "breakfast",
  "brief_description": "One taste of this great Mexican breakfast dish made with crisp corn tortillas, eggs, and chile peppers, and you'll be hooked!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat the oil in a medium skillet over medium heat, and fry the tortillas until lightly browned and crisp."
    },
    {
      "position": 2,
      "text": "Mix the onion, tomato, and serrano chile peppers into the skillet. Season with salt and pepper. Continue to cook and stir until onions are tender."
    },
    {
      "position": 3,
      "text": "Stir the eggs into the skillet, and cook until firm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,

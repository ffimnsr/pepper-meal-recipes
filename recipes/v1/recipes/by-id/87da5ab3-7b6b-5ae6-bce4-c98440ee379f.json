  "id": "87da5ab3-7b6b-5ae6-bce4-c98440ee379f",
  "slug": "creamy-zucchini-skillet-pasta-recipe-12032989",
  "name": "Creamy Melted Zucchini Pasta",
  "recipe_type": "side",
  "brief_description": "Diced zucchini melts into pasta in this easy, creamy, and delicious dish made with plenty of zucchini and tender ditalini. The small pasta cooks quickly right in the skillet, making it ideal for a simple one-pot meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large deep skillet over medium-high heat. Add zucchini and onion and sprinkle with 1/2 teaspoon salt. Cook until onion softens, 2 to 3 minutes. Add basil and cook for 1 minute, stirring often, until vegetables begin to soften, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Add water and simmer until very tender, 7 to 9 minutes."
    },
    {
      "position": 3,
      "text": "Remove about half the zucchini mixture and liquid from the skillet and transfer it to a blender or food processor. Remove the cap from the top to allow steam to escape and cover loosely with a towel. Blend until smooth. Return mixture to the pan."
    },
    {
      "position": 4,
      "text": "Stir in pasta, remaining salt, and stock if using. Add water as necessary to just cover."
    },
    {
      "position": 5,
      "text": "Bring mixture to a simmer, and cook, stirring occasionally until pasta is al dente and mixture is creamy, about 11 to 13 minutes. Add additional water or stock if liquid has evaporated too much before the pasta is cooked."
    },
    {
      "position": 6,
      "text": "Stir in Parmesan cheese and pepper. Season to taste with salt. Serve topped with more basil, cheese, and pepper."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

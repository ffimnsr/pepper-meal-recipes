  "id": "894ac39e-4ba4-50d3-baca-3ce914173417",
  "slug": "fireball-pumpkin-pie",
  "name": "Fireball Pumpkin Pie",
  "recipe_type": "dessert",
  "brief_description": "With this Fireball pumpkin pie, enjoy a traditional holiday pumpkin pie with flavor that's been kicked up a notch with Fireball cinnamon whiskey.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Evenly pierce entire pie crust with a fork."
    },
    {
      "position": 3,
      "text": "Bake crust in the preheated oven until golden brown, about 12 minutes. Remove from the oven; increase oven temperature to 425 degrees F (220 degrees C)."
    },
    {
      "position": 4,
      "text": "Combine pumpkin pie filling, evaporated milk, sugar, whiskey, eggs, salt, ginger, cloves, and cinnamon in a large bowl; beat with an electric mixer until just blended. Pour into the pre-baked pie crust."
    },
    {
      "position": 5,
      "text": "Return to the preheated oven and bake pie for 15 minutes. Reduce oven temperature to 350 degrees F (175 degrees C) and continue baking until filling is set and no longer jiggles, and a toothpick inserted into the center comes out clean, about 45 minutes."
    },
    {
      "position": 6,
      "text": "Remove from the oven and let cool to room temperature before serving, about 2 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

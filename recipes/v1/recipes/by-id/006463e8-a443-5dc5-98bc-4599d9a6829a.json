  "id": "006463e8-a443-5dc5-98bc-4599d9a6829a",
  "slug": "ham-tetrazzini",
  "name": "Ham Tetrazzini",
  "recipe_type": "main",
  "brief_description": "Stir diced ham into a hearty Cheddar cheese sauce with cooked spaghetti, along with chopped pimento and parsley for color. Dinner's ready in about half an hour!",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add spaghetti and cook for 8 to 10 minutes or until al dente; drain (or use leftover pasta; see Cook's Note)."
    },
    {
      "position": 2,
      "text": "While pasta is cooking, melt butter in a saucepan over medium heat. Stir in onion; cook and stir until the onion has softened and turned translucent, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir in cream of mushroom soup, 1/2 cup water, and shredded cheese. Heat mixture until cheese melts, stirring often."
    },
    {
      "position": 4,
      "text": "Mix in the ham, cooked and drained pasta, chopped pimento, and chopped parsley to saucepan; stir to combine. Cook until mixture is heated through, then serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

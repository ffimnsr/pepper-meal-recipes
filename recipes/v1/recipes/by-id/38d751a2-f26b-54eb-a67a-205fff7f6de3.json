  "id": "38d751a2-f26b-54eb-a67a-205fff7f6de3",
  "slug": "adas-polow-persian-rice-and-lentils",
  "name": "Adas Polo (Persian Rice and Lentils)",
  "recipe_type": "side",
  "brief_description": "This adas polo is a Iranian pilaf cooked with a blend of saffron-scented rice and lentils and garnished with fried onions, raisins, and dates.",
  "cuisine": "Persian Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Place rice in a bowl, and cover with water. Soak rice for about 3 hours, and drain off water. Bring rice, 1/2 teaspoon salt, and 4 cups water to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until rice is partially cooked, about 10 minutes. Drain liquid from rice, and set rice aside."
    },
    {
      "position": 2,
      "text": "Bring 2 more cups of water and a pinch of salt to a boil in a saucepan, and stir in lentils. Bring to a boil, and cook over medium heat until tender, 15 to 20 minutes. Remove from heat."
    },
    {
      "position": 3,
      "text": "Heat 2 tablespoons of vegetable oil in a large skillet over medium heat, and fry onions, frequently stirring, until golden brown, about 20 minutes. Set onions aside. Dissolve saffron in 1/3 cup of hot water, and set aside."
    },
    {
      "position": 4,
      "text": "In a large nonstick pot with deep sides, heat 2 tablespoons of vegetable oil until shimmering, and spoon in half of rice to cover the bottom of the pot. Top rice with lentils, and cover lentils with remaining rice. Reduce heat to low, cover the pot, and cook until rice is completely tender and there is a golden brown, crusty layer of rice on the bottom of the pot, about 20 minutes. Pour saffron water over rice and lentils, cover, and allow to cook until absorbed, about 10 more minutes."
    },
    {
      "position": 5,
      "text": "To serve, spoon polo into a serving dish, and peel off and place pieces of crusty rice layer on top of polo. Decorate polo with dates, raisins, and fried onions."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

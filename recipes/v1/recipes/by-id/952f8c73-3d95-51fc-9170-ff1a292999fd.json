  "id": "952f8c73-3d95-51fc-9170-ff1a292999fd",
  "slug": "family-favorite-gluten-free-carrot-cake",
  "name": "Family-Favorite Gluten-Free Carrot Cake",
  "recipe_type": "dessert",
  "brief_description": "Whether eaten alone or frosted with a cream cheese frosting, this gluten-free carrot cake will be a hit with your family and friends.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking dish with cooking spray and line with parchment paper."
    },
    {
      "position": 2,
      "text": "Mix sugar, oil, applesauce, and eggs together in a large bowl until well blended. Stir in flour, cinnamon, baking soda, vanilla extract, and nutmeg; mix well. Stir in shredded carrots and pour batter into the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 40 to 45 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a4628710-ba0c-5f87-9294-769aac11611e",
  "slug": "thai-fried-rice-with-pineapple-and-chicken",
  "name": "Thai Fried Rice with Pineapple and Chicken",
  "recipe_type": "main",
  "brief_description": "This pineapple fried rice with chicken is a Thai street food recipe for a quick, curry-flavored meal made with crisp bacon, eggs, and green onions.",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a wok or large skillet over medium-high heat; cook and stir until crisp, about 10 minutes. Remove bacon with a slotted spoon onto a paper towel-lined plate; set aside. Reserve bacon drippings in the wok."
    },
    {
      "position": 2,
      "text": "Cook and stir shallots in bacon drippings over medium-high heat until fragrant and light brown, 1 to 2 minutes."
    },
    {
      "position": 3,
      "text": "Stir chicken into shallots and cook, without stirring, until browned on one side, 45 seconds to 1 minute; stir. Continue cooking until chicken is browned, about 1 minute. Add 2 teaspoons curry powder; stir until chicken is coated."
    },
    {
      "position": 4,
      "text": "Make a well in the center of chicken and pour oil into the center of the well; add egg yolks. Cook and stir egg yolks until set, 1 to 2 minutes. Add rice and stir, breaking up rice."
    },
    {
      "position": 5,
      "text": "Mix chile pepper, cilantro, soy sauce, remaining 2 teaspoons curry powder, fish sauce, and sugar into rice mixture; add shrimp and cook until shrimp is cooked through and pink, about 2 minutes. Fold pineapple, green onions, and bacon into rice mixture."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

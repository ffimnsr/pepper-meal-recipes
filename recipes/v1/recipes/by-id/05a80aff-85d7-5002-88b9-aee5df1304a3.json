  "id": "05a80aff-85d7-5002-88b9-aee5df1304a3",
  "slug": "french-breakfast-muffins",
  "name": "French Breakfast Muffins",
  "recipe_type": "dessert",
  "brief_description": "Tender, nutmeg-spiced muffins dipped in melted butter and cinnamon sugar for a sweet, simple breakfast treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 12 muffin cups or line with paper muffin liners."
    },
    {
      "position": 2,
      "text": "Stir flour, 1/2 cup sugar, baking powder, nutmeg, and salt together in a medium bowl. Make a well in the center."
    },
    {
      "position": 3,
      "text": "Stir egg, milk, and 1/3 cup melted butter together in a separate bowl. Pour into the flour mixture; stir until just moistened. Batter may be lumpy. Spoon batter into the prepared muffin cups."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven for 20 to 25 minutes. Meanwhile, combine remaining 1/4 cup sugar and cinnamon in a small bowl while muffins are baking."
    },
    {
      "position": 5,
      "text": "Dip tops of baked muffins in remaining 1/3 cup melted butter, then in the cinnamon-sugar mixture. Serve warm."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

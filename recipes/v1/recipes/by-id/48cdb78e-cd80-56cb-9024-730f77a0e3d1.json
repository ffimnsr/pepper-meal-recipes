  "id": "48cdb78e-cd80-56cb-9024-730f77a0e3d1",
  "slug": "shortcut-pierogies-recipe-11683671",
  "name": "Shortcut Pierogies",
  "recipe_type": "appetizer",
  "brief_description": "These quick and easy pierogies are topped with caramelized onions, sour cream, and bacon, a stylish appetizer for a dinner party or fun gathering of friends. This is a shortcut method using frozen pierogies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Trim the ends of the onions, cut in half lengthwise, and peel. Thinly slice the halves vertically from top to bottom."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over medium heat. Add onions to skillet, tossing until well coated. Stir until they start to soften, then reduce heat to medium-low. Cook until onions start to brown, 15 to 20 minutes, stirring frequently. If they start to stick to the skillet, add a little water."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat butter and oil in a large nonstick skillet over medium heat, add pierogies in a single layer, and cook for about 16 minutes or according to package directions, flipping halfway through. Season with salt and pepper."
    },
    {
      "position": 4,
      "text": "Transfer pierogies to a serving plate. Add a dollop of sour cream to each pierogi, top with caramelized onions and crumbled bacon. Sprinkle with Parmesan cheese and parsley, and serve with lemon wedges."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

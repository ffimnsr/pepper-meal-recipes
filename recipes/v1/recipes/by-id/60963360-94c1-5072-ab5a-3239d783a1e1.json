  "id": "60963360-94c1-5072-ab5a-3239d783a1e1",
  "slug": "cheesy-cornbread",
  "name": "Cheesy Cornbread",
  "recipe_type": "main",
  "brief_description": "This cheesy cornbread has corn kernels and shredded Cheddar to make traditional cornbread that much better.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F. Grease and flour 8x8-inch baking dish."
    },
    {
      "position": 2,
      "text": "Combine flour, cornmeal, sugar, baking powder, and salt in a large bowl. Mix eggs, milk, and melted Country Crock\u00ae Spread. Stir egg mixture into flour mixture just until moistened. Stir in corn and cheese. Pour into prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until toothpick inserted into center comes out clean, 40 to 45 minutes. Cool bread for 10 minutes then cut into 2-inch squares. Serve warm with Country Crock\u00ae Honey Butter Spread."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "4dc09f2b-14a1-59a8-a29f-f2739d1935cb",
  "slug": "fried-rice-with-lychees-koa-pad-lin-gee",
  "name": "Fried Rice with Lychees (Koa Pad Lin Gee)",
  "recipe_type": "dessert",
  "brief_description": "Sweet lychees and raisins add a pleasant sweetness to this delicious rice dish.",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Bring the rice and water to a boil in a saucepan over high heat. Reduce heat to medium-low, cover, and simmer until the rice is tender, and the liquid has been absorbed, 20 to 25 minutes. Once cooked, spread the rice into a shallow dish, and refrigerate until cold, or use 1 1/2 cups leftover cooked rice."
    },
    {
      "position": 2,
      "text": "Heat the oil in a wok or large skillet over medium-high heat. Stir in the garlic and cook a few seconds until fragrant, then stir in the carrots and onion, and continue cooking until the onion begins to soften. Add the cold rice, and cook and stir until hot. Pour in the soy sauce, soy seasoning, green onions, cashews, raisins, salt, and white pepper. Cook and stir until hot, then stir in the quartered lychees to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

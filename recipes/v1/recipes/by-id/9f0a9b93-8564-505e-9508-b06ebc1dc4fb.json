  "id": "9f0a9b93-8564-505e-9508-b06ebc1dc4fb",
  "slug": "spiced-cranberry-sauce",
  "name": "Spiced Cranberry Sauce",
  "recipe_type": "drink",
  "brief_description": "This spiced cranberry sauce recipe is simmered in orange juice and spiced with a cinnamon stick and a pinch of ground cloves, nutmeg, and allspice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat orange juice and water in a saucepan over medium heat until warm, about 3 minutes. Stir in sugar until dissolved, then stir in cinnamon, cloves, nutmeg, and allspice. Add cranberries; cook, stirring occasionally, until they pop, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Transfer sauce to a bowl; cover and refrigerate, 8 hours to overnight."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,

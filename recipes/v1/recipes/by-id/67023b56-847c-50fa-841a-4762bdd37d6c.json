  "id": "67023b56-847c-50fa-841a-4762bdd37d6c",
  "slug": "shortcrust-pastry-pate-brisee-recipe-7565344",
  "name": "Shortcrust Pastry",
  "recipe_type": "dessert",
  "brief_description": "Classic shortcrust pastry (p\u00e2te bris\u00e9e) that's easy to make in a food processor for buttery, tender dough, perfect for sweet or savory pies and tarts.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Pulse flour and salt together in a food processor. Add butter and pulse until mixture looks like coarse crumbs with pea-size pieces of butter remaining. Add water gradually, 1 tablespoon at a time, pulsing just until the dough begins to come together. Wrap and chill dough for 60 minutes or up to overnight."
    },
    {
      "position": 3,
      "text": "Roll dough to a 12-inch round on a lightly floured surface."
    },
    {
      "position": 4,
      "text": "Gently transfer to a 9-inch pie plate or 10-inch fluted tart pan with a removable bottom. Flute edges of pastry as desired for the pie plate or trim even with the rim of the tart pan."
    },
    {
      "position": 5,
      "text": "Chill the pie crust for 1 hour before baking as directed in your pie recipe."
    },
    {
      "position": 6,
      "text": "For fillings that don\u2019t require further baking, blind bake the crust first. To do this, line the chilled crust with foil or parchment paper and fill it with pie weights or dried beans. Bake at 400 degrees F (200 degrees C) for 30 to 35 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

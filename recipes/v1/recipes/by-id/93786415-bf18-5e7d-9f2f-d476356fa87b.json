  "id": "93786415-bf18-5e7d-9f2f-d476356fa87b",
  "slug": "sandwich-french-toast-casserole",
  "name": "Sandwich French Toast Casserole",
  "recipe_type": "breakfast",
  "brief_description": "Ham and Swiss cheese sandwiches are baked in a seasoned egg batter creating a breakfast casserole perfect for weekend mornings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray the inside of a 9x13-inch casserole dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Spread butter on one side of each bread slice; top each bread slice with 2 slices ham and 1 slice Swiss cheese. Arrange open-faced sandwiches in the prepared casserole dish, overlapping them to fit."
    },
    {
      "position": 3,
      "text": "Whisk milk, eggs, Worcestershire sauce, mustard powder, salt, and pepper together in a bowl; pour milk mixture over the open-faced sandwiches. Allow milk mixture to soak in for at least 15 minutes."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until eggs are set and casserole is cooked through, about 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

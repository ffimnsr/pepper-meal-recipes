  "slug": "cheese-filling",
  "name": "Cheese Filling",
  "recipe_type": "dessert",
  "brief_description": "This cream cheese filling is sweet, flavored with vanilla, and thickened with egg yolk for a creamy filling used in danishes, kolachkes, or cupcakes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat together cream cheese and sugar in a large bowl with an electric mixer until smooth and creamy. Beat in egg yolk and vanilla until well combined. Cover and chill in the refrigerator before using in pastries and baking them."
    }
  ],

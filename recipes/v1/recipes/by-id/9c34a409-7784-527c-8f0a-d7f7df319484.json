  "id": "9c34a409-7784-527c-8f0a-d7f7df319484",
  "slug": "turkey-meatloaf-muffins",
  "name": "Turkey Meatloaf Muffins",
  "recipe_type": "main",
  "brief_description": "Baking this savory turkey meatloaf in a muffin tin gives each serving an appealing crust, so no one will fight over the end pieces anymore!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray a muffin tin with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine ground turkey, Cheddar cheese, onion, bread crumbs, milk, eggs, Worcestershire sauce, garlic, salt, and pepper in a large bowl; mix well."
    },
    {
      "position": 3,
      "text": "Drop scoops of turkey mixture into the muffin tin using a large ice cream scoop."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, about 45 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "protein-balls-with-vanilla-protein-powder",
  "name": "Protein Balls with Vanilla Protein Powder",
  "recipe_type": "appetizer",
  "brief_description": "These easy, no-bake protein balls are packed with nutrients thanks to vanilla-flavored protein powder, almond butter, and an array of seeds and oats.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix oats, almond butter, quinoa, chia seeds, flax seeds, protein powder, cocoa nibs, and honey together in a bowl by hand."
    },
    {
      "position": 2,
      "text": "Roll into bite-sized balls and place on parchment paper."
    },
    {
      "position": 3,
      "text": "Refrigerate for at least 20 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,

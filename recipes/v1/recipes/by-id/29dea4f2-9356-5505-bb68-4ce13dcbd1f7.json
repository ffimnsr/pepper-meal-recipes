  "id": "29dea4f2-9356-5505-bb68-4ce13dcbd1f7",
  "slug": "buffalo-chicken-pimento-cheese-dip-recipe-12014091",
  "name": "Buffalo Chicken Pimento Cheese Dip",
  "recipe_type": "appetizer",
  "brief_description": "This Buffalo chicken pimento cheese combines two Southern favorites into one creamy, spicy appetizer! Perfect for game days and gatherings, this make-ahead dip can be served hot or cold with crackers, veggies, chips, and more.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Warm cream cheese in the microwave in a large bowl until softened, 30 to 60 seconds. Stir in mayonnaise, ranch dressing, hot sauce, Worcestershire sauce, smoked paprika, and garlic until smooth."
    },
    {
      "position": 2,
      "text": "Add in shredded chicken, diced pimentos, 3/4 cup Cheddar cheese, and 3/4 cup pepper Jack cheese. Mix until evenly combined, then taste and adjust for seasoning as needed."
    },
    {
      "position": 3,
      "text": "Transfer dip into a 8x8 inch (2-quart) casserole dish and sprinkle with remaining cheese."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the cheese has melted and is bubbling at the edges, 20 to 25 minutes."
    },
    {
      "position": 5,
      "text": "Set the oven to broil and cook until lightly browned on top, 2 to 3 minutes more. Let dip cool for 5 minutes, then garnish with scallions and crumbled blue cheese, if desired."
    },
    {
      "position": 6,
      "text": "Serve warm with tortilla chips, celery sticks, chopped veggies, or crackers."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,

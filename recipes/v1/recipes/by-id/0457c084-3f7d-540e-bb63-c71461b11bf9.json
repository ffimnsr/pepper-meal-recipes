  "id": "0457c084-3f7d-540e-bb63-c71461b11bf9",
  "slug": "baked-potato-soup-iii",
  "name": "Carol's Baked Potato Soup",
  "recipe_type": "soup",
  "brief_description": "This baked potato soup recipe with Cheddar cheese, green onions, crumbled bacon, and sour cream is easy to make, rich in flavor, and delicious!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Bake potatoes in preheated oven for 1 hour. Scoop out the inside of potatoes and set aside. Reserve skins for another recipe or discard."
    },
    {
      "position": 3,
      "text": "Melt butter in a large skillet over medium-low heat. Stir in flour to make a roux. Cook for about 1 minute, stirring continuously. Gradually stir in milk; increase heat to medium and continue to stir until thickened."
    },
    {
      "position": 4,
      "text": "Add potatoes, green onions, salt, ground black pepper, bacon, and cheese. Stir well and continue to cook for about 15 minutes, allowing the flavors to blend. Stir in sour cream until well blended. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "e1552a00-b006-5149-a200-878b6d3dbf47",
  "slug": "creamiest-ever-rice-pudding",
  "name": "Creamiest Ever Rice Pudding",
  "recipe_type": "dessert",
  "brief_description": "This recipe is so creamy and delicious, even those who don't like rice pudding will ask for more. A little time consuming, but well worth the effort.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Bring milk, Arborio rice, sugar, butter, and salt to a boil in a large saucepan over medium-high heat. Reduce heat and simmer, uncovered, stirring frequently until rice is very tender, about 1 hour. Remove from heat."
    },
    {
      "position": 2,
      "text": "Beat eggs in a bowl, and gradually stir in about 1 cup of the rice mixture with the beaten eggs, adding about 1/4 cup of the hot rice at a time. Return the egg mixture into the saucepan, and stir in the heavy cream and vanilla extract."
    },
    {
      "position": 3,
      "text": "Pour the rice pudding into a 3-quart dish, and sprinkle with cinnamon. Allow pudding to cool slightly, then cover and refrigerate until chilled, about 4 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "hard",

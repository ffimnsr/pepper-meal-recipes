  "slug": "ez-red-pesto-sauce",
  "name": "Red Pesto Sauce",
  "recipe_type": "side",
  "brief_description": "Red pesto, made with sun-dried tomatoes, Parmesan cheese, basil, pine nuts, and garlic, makes a quick and delicious sauce for pasta or chicken.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Blend basil leaves, sun-dried tomatoes, Parmesan cheese, olive oil, pine nuts, and garlic together in a blender until a smooth paste forms. Stir in lemon juice; season with salt and black pepper."
    }
  ],

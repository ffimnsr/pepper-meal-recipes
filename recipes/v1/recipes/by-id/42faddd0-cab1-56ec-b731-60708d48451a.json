  "id": "42faddd0-cab1-56ec-b731-60708d48451a",
  "slug": "greek-inspired-chicken-salad",
  "name": "Greek-Style Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "This creamy Greek chicken salad with cucumbers, red onions, Greek yogurt, tomatoes, and feta cheese is perfect for a light and refreshing summer meal.",
  "cuisine": "Greek Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Place cucumbers in a colander; set onto a plate. Toss cucumbers with 1 teaspoon salt. Let rest to draw about liquid, about 30 minutes. Pat dry with paper towels."
    },
    {
      "position": 2,
      "text": "Place red onion and 1 cup cold water in a bowl. Let soak until the strong onion flavor is weakened, 5 to 10 minutes. Drain and rinse."
    },
    {
      "position": 3,
      "text": "Combine cucumbers, red onions, Greek yogurt, Kalamata olives, dill, vinegar, lemon juice, garlic, lemon zest, oregano, and black pepper in a bowl. Fold in chicken, feta cheese, and tomatoes. Cover with plastic wrap; refrigerate salad for at least 1 hour."
    },
    {
      "position": 4,
      "text": "Stir salad and serve on lettuce leaves."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

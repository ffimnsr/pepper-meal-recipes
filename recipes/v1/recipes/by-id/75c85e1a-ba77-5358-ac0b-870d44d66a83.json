  "id": "75c85e1a-ba77-5358-ac0b-870d44d66a83",
  "slug": "easy-and-delicious-pumpkin-bread",
  "name": "Easy and Delicious Pumpkin Bread",
  "recipe_type": "dessert",
  "brief_description": "This pumpkin bread with vanilla pudding recipe includes a simple secret ingredient \u2014 vanilla pudding mix \u2014 which creates a delicious breakfast treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease two 8x4-inch loaf pans."
    },
    {
      "position": 2,
      "text": "Whisk eggs together in a large bowl. Add pumpkin pur\u00e9e and vegetable oil; whisk until smooth."
    },
    {
      "position": 3,
      "text": "Whisk flour, sugar, pudding mix, baking soda, cinnamon, and salt together in a separate bowl; stir into pumpkin mixture. Divide batter between the prepared loaf pans."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 75 to 80 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 15,

  "id": "337a6ead-66bf-5b0c-9167-e7019b0adc36",
  "slug": "baked-mac-and-cheese-with-sour-cream-and-cottage-cheese",
  "name": "Baked Mac and Cheese with Sour Cream and Cottage Cheese",
  "recipe_type": "main",
  "brief_description": "Baked macaroni and cheese with sour cream, cottage cheese, and mild and sharp Cheddar is a creamy, comforting, rich meal the whole family will enjoy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until cooked through but firm to the bite, 8 minutes; drain."
    },
    {
      "position": 3,
      "text": "Reserve 1/2 cup shredded mild Cheddar cheese; set aside."
    },
    {
      "position": 4,
      "text": "Mix together remaining mild Cheddar cheese, sharp Cheddar cheese, sour cream, cottage cheese, and egg in a bowl; season with salt and pepper. Stir cooked macaroni into cheese mixture. Pour macaroni mixture into the prepared baking dish; sprinkle with reserved 1/2 cup mild Cheddar cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese is melted and bubbling, about 40 minutes. Let cool for 10 minutes before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "85d3b97c-89c2-56b3-8f5e-9bbed5468b61",
  "slug": "chicken-cheese-ball",
  "name": "Chicken Cheese Ball",
  "recipe_type": "appetizer",
  "brief_description": "The easiest and tastiest cheese ball you have ever tried. It is made using cream cheese and canned chicken!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl, combine cream cheese, ranch dressing mix and chicken. Form the mixture into a ball."
    },
    {
      "position": 2,
      "text": "On a cutting board or a piece of wax paper, spread the chopped pecans. Roll the ball in the pecans until it is fully coated. Wrap the ball in plastic and chill for at least one hour."
    }
  ],

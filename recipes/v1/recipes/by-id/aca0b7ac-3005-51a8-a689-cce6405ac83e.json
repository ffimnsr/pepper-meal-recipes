  "id": "aca0b7ac-3005-51a8-a689-cce6405ac83e",
  "slug": "air-fryer-bacon",
  "name": "Air Fryer Bacon",
  "recipe_type": "breakfast",
  "brief_description": "Follow this recipe for air fryer bacon that comes out perfectly crisp every time. It takes about 15 minutes, and you'll have no mess in your kitchen.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 390 degrees F (200 degrees C) according to manufacturer's instructions."
    },
    {
      "position": 2,
      "text": "Lay bacon in the air fryer basket in a single layer; some overlap is okay."
    },
    {
      "position": 3,
      "text": "Fry for 8 minutes. Flip and continue cooking until bacon is crisp, about 7 minutes more."
    },
    {
      "position": 4,
      "text": "Transfer cooked bacon to a plate lined with paper towels to soak up excess grease."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

  "id": "707707ce-e975-5988-8613-3dc9089230f0",
  "slug": "black-bean-chili",
  "name": "Black Bean Chili",
  "recipe_type": "soup",
  "brief_description": "This vegetable chili features black beans, corn, mushrooms, tomatoes, bell pepper, and onion cooked with spices for an easy vegetarian and vegan dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large saucepan over medium-high heat. Saut\u00e9 tomatoes, bell pepper, onion, mushrooms, corn, and jalape\u00f1o until onion is translucent, about 10 minutes. Season with chili powder, cumin, and black pepper."
    },
    {
      "position": 3,
      "text": "Stir in black beans, broth, and salt; bring to a boil."
    },
    {
      "position": 4,
      "text": "Reduce heat to medium-low. Remove 1 1/2 cups chili to a food processor or blender; pur\u00e9e until smooth."
    },
    {
      "position": 5,
      "text": "Stir the bean mixture back into the soup. Serve hot by itself or over rice."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

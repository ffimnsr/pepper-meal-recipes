  "id": "1c124766-ec52-554b-8912-8723abd574aa",
  "slug": "cranberry-hibiscus-granola",
  "name": "Cranberry-Hibiscus Granola",
  "recipe_type": "dessert",
  "brief_description": "Cranberries and hibiscus petals add beautiful pops of pink to this nut and seed granola sweetened with maple syrup.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Pour oats, almonds, coconut, cashews, hazelnuts, sunflower seeds, and pumpkin seeds onto a rimmed baking sheet. Add maple syrup, oil, and salt; toss together until evenly coated."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven, tossing once, until golden and crisp, 25 to 30 minutes. Add cranberries and hibiscus petals and toss with a spoon to combine. Let cool."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,

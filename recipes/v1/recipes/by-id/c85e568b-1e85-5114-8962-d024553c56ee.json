  "id": "c85e568b-1e85-5114-8962-d024553c56ee",
  "slug": "high-protein-breakfast-muffins-recipe-11930095",
  "name": "High Protein Breakfast 'Muffins'",
  "recipe_type": "dessert",
  "brief_description": "These high-protein breakfast \u201cmuffins\u201d are little tasty bites made in a muffin tin, but they are not your usual flour-based muffins. Cottage cheese based, with oats, walnuts, and cranberries, they have just a touch of sweetness.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place dried cranberries in a microwave-safe container with enough water to cover. Microwave on High for 3 minutes. Drain cranberries and allow to cool until ready to use."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (180 degrees C) and spray a 12-cup muffin tin with nonstick cooking spray."
    },
    {
      "position": 3,
      "text": "Beat eggs in a large bowl until whites are incorporated, and stir in cottage cheese, milk, and maple syrup."
    },
    {
      "position": 4,
      "text": "Add rolled oats, cinnamon, drained cranberries, walnuts, and a pinch of salt. Stir until just blended. Divide the mixture evenly into greased muffin cups."
    },
    {
      "position": 5,
      "text": "Bake in the center of the preheated oven until edges are lightly browned and tops are firm, 25 to 27 minutes."
    },
    {
      "position": 6,
      "text": "Cool muffin tin on a rack for about 10 minutes, then use a small spatula to loosen the edges and remove from the pan. Allow muffins to cool completely on the rack. Serve slightly warm or at room temperature."
    },
    {
      "position": 7,
      "text": "Store any leftovers in the refrigerator in an airtight container for up to 5 days."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

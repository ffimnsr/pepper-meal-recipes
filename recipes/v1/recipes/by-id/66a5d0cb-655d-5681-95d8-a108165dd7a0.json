  "id": "66a5d0cb-655d-5681-95d8-a108165dd7a0",
  "slug": "easy-caramel-apple-crisp-pie-recipe-8716995",
  "name": "Easy Caramel Apple Crisp Pie",
  "recipe_type": "dessert",
  "brief_description": "This easy caramel apple crisp pie combines 2 of your favorite fall desserts\u2014apple pie and apple crisp. Serve topped with ice cream or whipped cream and a drizzle of more caramel.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Pour pie filling into crust."
    },
    {
      "position": 2,
      "text": "Heat caramel dip in a microwave on High until runny, about 20 seconds. Drizzle caramel over pie filling."
    },
    {
      "position": 3,
      "text": "Combine flour, brown sugar, oats, butter, cinnamon, and salt in a bowl and mix together with a fork until combined and crumbly. Scatter crumble mixture evenly over pie. Place pie on a rimmed baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until crust is golden brown and filling is bubbly around the edges, 35 to 45 minutes. Let stand for 20 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

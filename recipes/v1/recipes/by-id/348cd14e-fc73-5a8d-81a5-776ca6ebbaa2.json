  "id": "348cd14e-fc73-5a8d-81a5-776ca6ebbaa2",
  "slug": "easy-enchilada-casserole",
  "name": "Easy Enchilada Casserole",
  "recipe_type": "soup",
  "brief_description": "No stuffing or rolling necessary to make these enchiladas. Just mix together shredded chicken with sour cream, jack cheese, and soup; then layer with tortillas and salsa.",
  "cuisine": "Tex Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "In a medium bowl combine soup, chicken, sour cream, and green onions. Mix together. In another small bowl, combine salsa and green chile peppers; mix."
    },
    {
      "position": 3,
      "text": "Cover the bottom of the baking dish with 4 tortillas. Add 1/2 of chicken mixture, 1/2 of salsa mixture, and 1 1/2 cups of shredded cheese. Repeat layers. Add another layer of remaining 4 tortillas and top with remaining cup of cheese."
    },
    {
      "position": 4,
      "text": "Cover and bake in the preheated oven for 55 minutes. Uncover and bake for an additional 5 minutes, until cheese is melted on top. Let stand for 5 minutes before cutting."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "homemade-bloody-mary-mix",
  "name": "Homemade Bloody Mary Mix",
  "recipe_type": "drink",
  "brief_description": "Have this bloody mary mix on hand for Sunday morning brunch beverages as a better option than the store-bought variety.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Stir tomato juice, lime juice, pickled jalapeno pepper juice, vinegar, white sugar, Worcestershire sauce, horseradish, salt, pepper, cloves, onion powder, and garlic powder in a 2-quart pitcher."
    }
  ],
  "servings": 12,

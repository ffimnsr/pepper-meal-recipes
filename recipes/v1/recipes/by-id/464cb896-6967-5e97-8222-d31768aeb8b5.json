  "id": "464cb896-6967-5e97-8222-d31768aeb8b5",
  "slug": "dump-and-bake-lemon-chicken-recipe-12028638",
  "name": "Dump and Bake Lemon Chicken",
  "recipe_type": "main",
  "brief_description": "This dump and bake lemon chicken is an easy one-dish meal with tender chicken, white rice, and asparagus all baked together in a bright lemon garlic sauce. Finished with Parmesan cheese, it\u2019s a simple weeknight dinner that keeps prep quick and cleanup easy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Add rice and broth to the prepared dish. Stir in garlic, lemon juice and zest. Place chicken on top; season chicken with salt, pepper, onion powder, paprika, and oregano. Scatter asparagus over the top, and butter pats down the center of the dish. Pour cream evenly over the top, if using. Cover tightly with foil."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until chicken is no longer pink at the center and juices run clear, 45 to 50 minutes. Remove foil, sprinkle with Parmesan, and bake uncovered for 10 more minutes. Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

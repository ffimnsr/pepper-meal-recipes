  "id": "bdd47c18-7efa-5665-938a-42c4537d2af3",
  "slug": "italian-wedding-pasta-bake-recipe-8769355",
  "name": "Italian Wedding Pasta Bake",
  "recipe_type": "soup",
  "brief_description": "This Italian wedding pasta bake with veggies, meatballs, and cheese has all the flavors of Italian wedding soup with a crisp panko breadcrumb topping.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly coat a 3-quart rectangular baking dish with nonstick cooking spray."
    },
    {
      "position": 3,
      "text": "Bring a large pot of water to a boil. Add pasta and cook until almost tender, about 10 minutes; drain and transfer to a bowl."
    },
    {
      "position": 4,
      "text": "Heat 2 tablespoons butter and olive oil in the same pot over medium heat. Add onion, celery, and carrots. Cook, covered, until carrots are nearly tender, stirring occasionally, about 7 minutes."
    },
    {
      "position": 5,
      "text": "Add garlic and cook for 1 more minute."
    },
    {
      "position": 6,
      "text": "Sprinkle flour over the vegetable mixture; cook and stir for 1 minute."
    },
    {
      "position": 7,
      "text": "While stirring, slowly pour in broth. Bring mixture to a boil, stirring constantly. Continue to cook and stir until mixture is slightly thickened, 1 minute more."
    },
    {
      "position": 8,
      "text": "Stir in 1/2 cup Parmesan cheese."
    },
    {
      "position": 9,
      "text": "Add kale; cook and stir until kale is wilted, 1 minute."
    },
    {
      "position": 10,
      "text": "Add cooked pasta, meatballs, 2 tablespoons oregano, pepper, and salt to the pot; stir to combine. Transfer mixture to prepared baking dish."
    },
    {
      "position": 11,
      "text": "To make the topping: Melt remaining 2 tablespoons butter in a bowl. Add panko and stir to combine. Stir in remaining 1/4 cup Parmesan cheese. Sprinkle topping over the casserole."
    },
    {
      "position": 12,
      "text": "Bake in the preheated oven until golden and heated through, about 20 minutes."
    },
    {
      "position": 13,
      "text": "Let stand for 10 minutes before serving. Top with remaining 1 tablespoon oregano and the parsley."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

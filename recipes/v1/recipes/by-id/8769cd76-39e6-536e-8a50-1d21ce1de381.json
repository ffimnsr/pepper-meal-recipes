  "id": "8769cd76-39e6-536e-8a50-1d21ce1de381",
  "slug": "chocolate-graham-crust",
  "name": "Chocolate Graham Crust",
  "recipe_type": "dessert",
  "brief_description": "This quick and easy, homemade chocolate pie crust is made with just a few simple ingredients, including chocolate graham crackers and cinnamon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Crumble graham crackers in a food processor with sugar and cinnamon."
    },
    {
      "position": 3,
      "text": "Place butter in a microwave-safe bowl and melt in a microwave oven, about 1 minute. Add to the mixture in the food processor and blend until combined into the dough."
    },
    {
      "position": 4,
      "text": "Roll dough out into a crust and place into a pie plate."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 7 minutes. Let cool completely before filling, about 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

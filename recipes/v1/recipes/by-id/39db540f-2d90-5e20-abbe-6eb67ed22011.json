  "id": "39db540f-2d90-5e20-abbe-6eb67ed22011",
  "slug": "sweet-washington-cherry-pie",
  "name": "Sweet Washington Cherry Pie",
  "recipe_type": "dessert",
  "brief_description": "This sweet cherry Washington pie recipe is best when made with fresh, seasonal cherries from eastern Washington \u2014 home to the best cherries in the U.S.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine cherries, cherry juice, brown sugar, white sugar, flour, and almond extract in a large bowl until sugar has dissolved. Set aside while preparing pastry dough, about 15 minutes."
    },
    {
      "position": 3,
      "text": "Place bottom crust in a 9-inch pie plate; fill with cherry filling and dot with butter. Place top crust over filling; crimp edges to seal. Cut several steam vents in top crust with a paring knife. Cover pie edges with aluminum foil during the first 20 minutes of baking to prevent browning too quickly."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until filling is bubbling and thick, and crust is browned, 35 to 40 minutes. Cool before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,
  "difficulty": "hard",

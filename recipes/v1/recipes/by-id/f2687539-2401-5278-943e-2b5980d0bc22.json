  "id": "f2687539-2401-5278-943e-2b5980d0bc22",
  "slug": "frozen-banana-margaritas",
  "name": "Frozen Banana Margaritas",
  "recipe_type": "drink",
  "brief_description": "Make banana margaritas to be transported straight to vacation. This recipe is easy to make and tasty \u2014 a different flavor of a classic cocktail.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine bananas, banana liqueur, tequila, triple sec, lemon juice, and lime juice in the container of a blender. Add ice cubes until the mixture reaches the 6-cup line. Cover and blend until smooth."
    },
    {
      "position": 2,
      "text": "Pour into margarita glasses to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,

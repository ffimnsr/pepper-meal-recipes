  "id": "1a8c566e-4ded-5c21-9694-fd0544606f15",
  "slug": "hawaiian-style-kalua-pork-recipe-8661977",
  "name": "Hawaiian-Style Kalua Pork",
  "recipe_type": "main",
  "brief_description": "This Hawaiian-style kalua pork method is the one used by home cooks, to come as close as possible to cooking underground, which is what kalua means. Slow-roasting the pork wrapped in banana leaves makes for a truly amazing flavor.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Place pork in a large bowl and rub all over with liquid smoke. Sprinkle salt over meat, and rub in until evenly coated. Set aside."
    },
    {
      "position": 2,
      "text": "Place banana leaves on the counter, arranging them in a spiral, overlapping pattern, so once pork is placed on the leaves, they can be folded up and over to fully encase the meat."
    },
    {
      "position": 3,
      "text": "Place pork on the center of leaves, fat side down, and wrap the meat with the seams coming together at the top. Once wrapped, pick up and invert the entire package, seam side down, into a Dutch oven. Any extra banana leaves can be tucked in around the sides."
    },
    {
      "position": 4,
      "text": "Bake, covered, in the preheated oven for about 4 hours, or an instant-read thermometer inserted near the center reads 195 to 200 degrees F (91 to 93 degrees C)."
    },
    {
      "position": 5,
      "text": "Let pork rest in the Dutch oven for 30 to 60 minutes, then remove the meat to a bowl. Pull meat off the bone, and set bone aside. Add any and all cooking liquids and rendered fat into the bowl of pork. Use two forks to shred meat as finely as you like. Taste for seasoning; adjust with more salt or liquid smoke to taste."
    },
    {
      "position": 6,
      "text": "Arrange banana leaves in the pot to make a nest for the meat. Transfer shredded pork in and serve immediately."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 240,
  "preparation_time_minutes": 15,
  "rest_time_minutes": 30,

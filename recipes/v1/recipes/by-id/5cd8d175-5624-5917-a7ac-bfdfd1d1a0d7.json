  "id": "5cd8d175-5624-5917-a7ac-bfdfd1d1a0d7",
  "slug": "moms-basic-vegetable-beef-stew",
  "name": "Mom's Basic Vegetable Beef Stew",
  "recipe_type": "soup",
  "brief_description": "Mom's basic vegetable beef stew recipe is loaded with potatoes, onions, carrots, and celery for an easy, hearty, and warming meal for cold evenings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add enough oil to a large stockpot to thinly coat the bottom; heat over medium. Add 1 onion, carrots, garlic, bay leaf, red pepper flakes, Greek seasoning, rosemary, thyme, basil, Italian seasoning, salt, and black pepper; cook and stir until mixture begins to soften and brown, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Add tomatoes and ground beef, breaking beef apart with a wooden spoon; bring to a boil. Cook until beef is cooked through and carrots are tender, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Add potatoes, remaining 1 onion, and celery; cook until potatoes are tender, 15 to 20 minutes. Remove from heat; let sit before serving for 20 to 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,

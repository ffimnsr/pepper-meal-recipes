  "id": "bc0135b3-2c34-5fde-8aa9-b44ea26752b0",
  "slug": "pikliz-recipe-8655382",
  "name": "Pikliz",
  "recipe_type": "salad",
  "brief_description": "Pikliz is a Haitian pickled slaw with cabbage, bell peppers, carrots, and Scotch bonnet pepper that brightens up every dish.",
  "cuisine": "Caribbean",
  "instructions": [
    {
      "position": 1,
      "text": "Stuff cabbage, carrot, bell peppers, onion, scallions, Scotch bonnet pepper, allspice, peppercorn, cloves, and bay leaf into a mason jar with a lid until it's filled to the brim."
    },
    {
      "position": 2,
      "text": "Add vinegar, and lime juice and press down on the ingredients. Seal the jar and shake once."
    },
    {
      "position": 3,
      "text": "Refrigerate for 2 days for flavors to meld."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "40eb5229-8518-5a96-9428-4a073100a4d9",
  "slug": "white-sangria-with-berries",
  "name": "White Sangria with Berries",
  "recipe_type": "drink",
  "brief_description": "This white sangria made with berries and fresh peaches is an easy, summer-ready drink for any party or gathering.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix wine, brandy, and schnapps together in a large pitcher."
    },
    {
      "position": 2,
      "text": "Slice strawberries, raspberries, and peaches into medium chunks. Add to the wine mixture. Chill for a minimum of 3 to 4 hours."
    },
    {
      "position": 3,
      "text": "Pour in seltzer just prior to serving. Serve over ice with fruit added from the pitcher."
    }
  ],
  "servings": 8,

  "schema_version": 1,
  "id": "f6ebfb91-e1c2-5d89-9981-08e76e2a37e1",
  "slug": "leftover-ham-and-shrimp-slow-cooker-gumbo",
  "name": "Leftover Ham and Shrimp Slow Cooker Gumbo",
  "recipe_type": "soup",
  "brief_description": "Use leftover ham to make a slow cooker gumbo recipe with the help of pre-cooked shrimp, black beans, canned tomatoes, coconut milk, garlic, and spices.",
  "cuisine": "Creole",
  "instructions": [
    {
      "position": 1,
      "text": "Combine garlic, turmeric, chili powder, basil, and cayenne pepper in a small saucepan over medium heat; cook until aromatic, about 1 minute. Add butter; cook until melted. Add onion; cook until softened and translucent, about 5 minutes. Transfer mixture to a slow cooker, reserving as much butter in the saucepan as possible."
    },
    {
      "position": 2,
      "text": "Add shrimp to the saucepan; increase heat to medium-high. Saut\u00e9 until just firm, about 2 minutes; transfer mixture to the slow cooker. Add black beans, ham, ham bone, and tomatoes to the slow cooker; cover the slow cooker."
    },
    {
      "position": 3,
      "text": "Cook until ham is falling off the bone, on Low for 6 to 8 hours or High for 4 to 6 hours."
    },
    {
      "position": 4,
      "text": "Remove and discard ham bone. Stir in coconut milk; continue cooking on Low until coconut milk is warmed, about 30 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 280,
  "preparation_time_minutes": 15,

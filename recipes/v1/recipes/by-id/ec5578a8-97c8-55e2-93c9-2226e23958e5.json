  "id": "ec5578a8-97c8-55e2-93c9-2226e23958e5",
  "slug": "restaurant-style-chicken-nachos",
  "name": "Restaurant-Style Chicken Nachos",
  "recipe_type": "appetizer",
  "brief_description": "Chicken nachos are easy to make with your favorite tortilla chips, shredded chicken, salsa, tomato, and cheese for a great meal or snack to share!",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat oil in a deep 12-inch skillet over medium heat. Add white parts of the green onions and garlic; cook and stir until onions are just tender."
    },
    {
      "position": 3,
      "text": "Mix in shredded chicken and season to taste with salt and pepper; toss until well coated. Stir in salsa."
    },
    {
      "position": 4,
      "text": "Arrange tortilla chips on a large baking sheet. Spoon chicken mixture over tortilla chips; top with shredded cheese and tomato."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese has melted, about 10 minutes. Remove from heat and sprinkle with green onion tops before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

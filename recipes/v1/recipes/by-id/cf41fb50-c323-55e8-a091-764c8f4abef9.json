  "slug": "uncrustable-donuts-recipe-7563438",
  "name": "Uncrustable Donuts",
  "recipe_type": "appetizer",
  "brief_description": "Turn Uncrustables into PB&J donuts in 15 minutes with this recipe. Cinnamon sugar adds a nice, churro-like crunch to the outside, which perfectly complements the creamy center.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oil to 400 degrees F (200 degrees C) in a large saucepan over medium-high heat."
    },
    {
      "position": 2,
      "text": "Meanwhile, use a 1-inch cutter to cut a hole in the center of each Uncrustable. Press edges around the center of the hole to seal sandwich closed in the middle"
    },
    {
      "position": 3,
      "text": "Fry each sandwich in hot oil until browned, 8 to 10 seconds per side. Drain on paper towels."
    },
    {
      "position": 4,
      "text": "Stir together sugar and cinnamon on a plate; dredge donuts lightly in cinnamon sugar."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 1,
  "preparation_time_minutes": 10,

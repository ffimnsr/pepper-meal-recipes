{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "4d4852f1-77de-5974-91ed-7dbf1b49f8e1",
  "slug": "mexican-street-corn-chicken-rice-bowl-recipe-11955140",
  "name": "Mexican Street Corn Chicken Rice Bowl",
  "recipe_type": "side",
  "brief_description": "This Mexican street corn chicken rice bowl is a flavorful way to turn leftover chicken into an easy one-bowl meal. Spiced chicken and street corn are served over rice and topped with lime, cilantro, and pico de gallo for a fresh finish. Serve with warmed tortillas or crunchy chips on the side.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Warm avocado oil in a medium nonstick skillet over medium heat. When oil is hot, add chili powder, ground cumin, garlic powder, salt, and cayenne pepper. Stir spices in heated oil until fragrant, 2 to 3 minutes."
    },
    {
      "position": 2,
      "text": "Add chicken and toss gently to coat in oil and spice mix. Cook, stirring, until chicken is warmed through, about 4 minutes. Sprinkle lime juice over chicken, remove to a plate, and keep warm."
    },
    {
      "position": 3,
      "text": "For street corn, add corn kernels to the same skillet, and increase heat to medium-high. Cook until corn starts to pop and picks up a little color, 3 to 5 minutes."
    },
    {
      "position": 4,
      "text": "Place skillet-roasted corn in a bowl, and add red onion, 1/2 cup sour cream, mayonnaise, cotija cheese, chili powder, salt, pepper, and cayenne pepper, to taste."
    },
    {
      "position": 5,
      "text": "To assemble the bowls, spread each bowl with a bed of shredded lettuce. Add seasoned chicken, a serving of Mexican rice, and a serving of the street corn."
    },
    {
      "position": 6,
      "text": "Garnish with lime wedges, fresh cilantro, and pico de gallo."
    },
    {
      "position": 7,
      "text": "Place a dollop of sour cream in the center of each bowl, sprinkle with some additional cotija cheese, and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "traditional-mexican-guacamole",
  "name": "Traditional Mexican Guacamole",
  "recipe_type": "appetizer",
  "brief_description": "Authentic guacamole recipe made with traditional ingredients of avocados, tomatoes, lemon juice, cilantro, onion, and some spicy jalape\u00f1o for heat.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Mash avocados in a bowl until creamy."
    },
    {
      "position": 2,
      "text": "Mix tomatoes, onion, cilantro, lemon juice, and jalape\u00f1o pepper into mashed avocado until well combined. Season with salt and pepper."
    }
  ],
  "servings": 4,

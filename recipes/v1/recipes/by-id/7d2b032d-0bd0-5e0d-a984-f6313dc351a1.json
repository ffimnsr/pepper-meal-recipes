  "id": "7d2b032d-0bd0-5e0d-a984-f6313dc351a1",
  "slug": "rhubarb-custard-pie-iv",
  "name": "Rhubarb Custard Pie",
  "recipe_type": "dessert",
  "brief_description": "This rhubarb custard pie is made with fresh rhubarb, homemade custard, and baked in a prepared crust. It's a delicious spring dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Spread rhubarb evenly in unbaked pie shell."
    },
    {
      "position": 3,
      "text": "Combine sugar, flour, and nutmeg in a medium bowl; mix well. Add eggs and milk; beat until smooth. Pour egg mixture over rhubarb layer."
    },
    {
      "position": 4,
      "text": "Cover edges of pie shell with aluminum foil to prevent overbrowning. Bake in the preheated oven for 50 minutes. Remove foil; bake 10 minutes more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,

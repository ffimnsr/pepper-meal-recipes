  "id": "7469cbf5-328f-52c9-82d4-2d07ebd3c6b9",
  "slug": "miso-glazed-black-cod",
  "name": "Miso-Glazed Black Cod",
  "recipe_type": "main",
  "brief_description": "This recipe for miso-glazed black cod is Chef John's take on the dish made famous by Chef Nobu Matsuhisa. It's similar in taste with a lot less marinating.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Line a baking sheet with aluminum foil and lightly grease the foil with cooking spray."
    },
    {
      "position": 3,
      "text": "Whisk miso, water, mirin, sake, and brown sugar together in a small skillet over medium heat until mixture simmers and thickens slightly, 1 to 3 minutes. Remove from the heat and let cool completely, 3 to 5 minutes."
    },
    {
      "position": 4,
      "text": "Place cod fillets on the prepared baking sheet. Brush fillets all over with cooled miso mixture. Marinate at room temperature for 15 to 20 minutes."
    },
    {
      "position": 5,
      "text": "Broil in the preheated oven for 5 minutes. Turn the baking sheet 180 degrees and continue broiling until fish flakes easily with a fork, about 5 minutes more. Remove pin bones before serving."
    },
    {
      "position": 6,
      "text": "Serve with your favorite sides, enjoy!"
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

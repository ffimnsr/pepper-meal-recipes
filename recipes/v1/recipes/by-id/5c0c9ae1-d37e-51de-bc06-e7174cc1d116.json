  "id": "5c0c9ae1-d37e-51de-bc06-e7174cc1d116",
  "slug": "slow-cooker-enchiladas",
  "name": "Slow Cooker Enchiladas",
  "recipe_type": "soup",
  "brief_description": "This slow cooker enchiladas recipe layers tortillas with ground beef, taco seasoning, salsa, cream of mushroom soup, cream of chicken soups, and cheese.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Crumble ground beef into a large skillet over medium-high heat; cook and stir until evenly browned. Add water and taco seasoning; reduce heat to low and simmer 15 minutes."
    },
    {
      "position": 2,
      "text": "Combine salsa, cream of mushroom soup, and cream of chicken soup in a medium bowl. Reserve 3 cups cheese; stir remaining 1 cup cheese into salsa mixture."
    },
    {
      "position": 3,
      "text": "Place 1 layer tortillas to cover bottom of a slow cooker. Top with 1 layer ground beef mixture and 1 layer reserved cheese. Repeat layering with remaining tortillas, beef mixture, and cheese, ending with 1 layer tortillas, topped with remaining cheese. Cover slow cooker."
    },
    {
      "position": 4,
      "text": "Cook on High for 45 to 60 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

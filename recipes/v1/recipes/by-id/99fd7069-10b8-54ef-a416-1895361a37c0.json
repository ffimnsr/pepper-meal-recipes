  "id": "99fd7069-10b8-54ef-a416-1895361a37c0",
  "slug": "chef-johns-sausage-shrimp-jambalaya",
  "name": "Chef John's Sausage & Shrimp Jambalaya",
  "recipe_type": "soup",
  "brief_description": "Shrimp jambalaya with sausage is a comforting dish, stewed full of flavor, with rice cooked right in with the other ingredients for a hearty meal.",
  "cuisine": "Creole",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place butter and sausage in a large stockpot over medium heat; cook and stir until sausage begins to brown, 5 to 6 minutes."
    },
    {
      "position": 3,
      "text": "Stir in paprika, cumin, and cayenne; cook for 1 minute."
    },
    {
      "position": 4,
      "text": "Stir tomatoes, celery, green pepper, green onions, salt, and bay leaf into the sausage mixture."
    },
    {
      "position": 5,
      "text": "Add brown rice and stir to combine. Stir in chicken stock, bring it to a simmer, then turn heat to low. Cover and cook until rice is just tender, about 45 minutes."
    },
    {
      "position": 6,
      "text": "Stir in shrimp, replace lid and cook until shrimp are cooked through, about 5 minutes. Season with salt and black pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

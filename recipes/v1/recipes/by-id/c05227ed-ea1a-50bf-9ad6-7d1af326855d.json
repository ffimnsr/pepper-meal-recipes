  "id": "c05227ed-ea1a-50bf-9ad6-7d1af326855d",
  "slug": "honey-dijon-balsamic-vinaigrette",
  "name": "Honey Dijon Balsamic Vinaigrette",
  "recipe_type": "salad",
  "brief_description": "This honey mustard vinaigrette is an easy, delicious sauce with sweet and tangy flavor that makes a superb bread dip or all-purpose salad dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk olive oil, balsamic vinegar, mustard, honey, salt, and pepper together in a medium bowl until well combined."
    },
    {
      "position": 3,
      "text": "Pour vinaigrette into a clean screw-top jar or bottle. Seal with a tight-fitting lid. Shake well before serving."
    }
  ],
  "servings": 8,

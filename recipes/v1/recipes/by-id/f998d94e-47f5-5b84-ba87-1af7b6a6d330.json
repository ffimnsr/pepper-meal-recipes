  "id": "f998d94e-47f5-5b84-ba87-1af7b6a6d330",
  "slug": "gochujang-sauced-air-fryer-cauliflower-bites-recipe-8606780",
  "name": "Gochujang-Sauced Air Fryer Cauliflower Bites",
  "recipe_type": "appetizer",
  "brief_description": "These gochujang-spiced air fryer cauliflower bites are like hot wings for vegetarians. Chicken is replaced with cauliflower florets, but the sauce is still nice and spicy.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C) according to manufacturer\u2019s instructions. Toss cauliflower florets with oil and 1/2 teaspoon salt in a large bowl to coat."
    },
    {
      "position": 2,
      "text": "Working in batches if needed, arrange cauliflower bites in an even layer in air fryer basket. Cook, turning halfway through, until tender and browned, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, for sauce, stir together honey, gochujang, brown sugar, soy sauce, lemon juice, ginger, black pepper, and remaining 1/4 teaspoon salt in a small saucepan. Bring to a boil over medium heat. Reduce heat to low; simmer until sauce is glossy and thickened, about 5 minutes. Stir in green onions."
    },
    {
      "position": 4,
      "text": "Transfer hot cauliflower bites to a large bowl. Add 1/2 cup sauce; toss to coat. Serve immediately with remaining sauce and garnish with additional green onions."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

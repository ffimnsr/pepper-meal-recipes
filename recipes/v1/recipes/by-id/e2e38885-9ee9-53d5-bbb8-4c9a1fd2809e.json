  "id": "e2e38885-9ee9-53d5-bbb8-4c9a1fd2809e",
  "slug": "indian-tandoori-chicken",
  "name": "Tandoori Chicken",
  "recipe_type": "main",
  "brief_description": "This tandoori chicken is made with an authentic Indian recipe that marinates the chicken overnight in yogurt with the perfect blend of spices.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Remove and discard skin from chicken pieces. Cut slits into meat and place into a shallow dish. Season chicken on both sides with lemon juice and salt. Let sit for 20 minutes."
    },
    {
      "position": 3,
      "text": "Mix yogurt, onion, garlic, garam masala, ginger, and cayenne pepper together in a medium bowl until smooth, then stir in food coloring."
    },
    {
      "position": 4,
      "text": "Spread yogurt mixture over chicken, cover, and refrigerate for 6 to 24 hours (the longer the better)."
    },
    {
      "position": 5,
      "text": "When ready to cook, preheat an outdoor grill for medium-high heat and lightly oil the grate. Remove chicken from marinade. Discard remaining marinade."
    },
    {
      "position": 6,
      "text": "Cook chicken on the preheated grill until no longer pink and the juices run clear. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 7,
      "text": "Garnish with cilantro and lemon wedges."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

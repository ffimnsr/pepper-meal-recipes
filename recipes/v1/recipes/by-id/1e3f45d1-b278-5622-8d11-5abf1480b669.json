  "id": "1e3f45d1-b278-5622-8d11-5abf1480b669",
  "slug": "overnight-breakfast-bake-with-ham-cheese-and-croissants",
  "name": "Overnight Breakfast Bake with Ham, Cheese, and Croissants",
  "recipe_type": "breakfast",
  "brief_description": "This overnight breakfast bake with ham, cheese, and croissants will surely be a hit with the family.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spray an 8x8-inch baking pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Cut croissants into 1 inch cubes (about 4 cups, loosely packed) and spread out on the bottom of the prepared pan. Sprinkle evenly with cheese and ham."
    },
    {
      "position": 3,
      "text": "Combine eggs, milk, sour cream, Dijon mustard, salt, and pepper in a bowl. Beat the mixture until well blended using a wire whisk or an egg beater."
    },
    {
      "position": 4,
      "text": "Pour egg mixture evenly over the top of the croissants, cheese, and ham."
    },
    {
      "position": 5,
      "text": "Cover tightly with aluminum foil and place in the refrigerator for 8 hours."
    },
    {
      "position": 6,
      "text": "When ready to bake, set the dish out of the refrigerator on the counter, Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 7,
      "text": "Uncover casserole, place in the center of the preheated oven, and bake until the casserole is set, and a knife inserted into the middle of the casserole comes out clean, 45 to 55 minutes."
    },
    {
      "position": 8,
      "text": "Cut into serving pieces and garnish with chopped green onions."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

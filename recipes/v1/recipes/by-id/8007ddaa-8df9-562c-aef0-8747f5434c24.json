  "id": "8007ddaa-8df9-562c-aef0-8747f5434c24",
  "slug": "gnocchi-with-sage-butter-sauce",
  "name": "Gnocchi with Sage-Butter Sauce",
  "recipe_type": "main",
  "brief_description": "Gnocchi with sage-butter sauce, lots of garlic, black pepper, and Parmesan cheese makes a rich and delicious meat-free pasta main dish for two.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil over high heat. Add gnocchi pasta and cook until they float to the surface, 2 to 3 minutes; drain."
    },
    {
      "position": 3,
      "text": "Melt butter in a skillet over medium heat. Stir in garlic and cook until softened and golden brown, about 4 minutes."
    },
    {
      "position": 4,
      "text": "Stir in sage and salt. Add cooked gnocchi, 1/4 cup Parmesan cheese, and pepper; toss gently to combine."
    },
    {
      "position": 5,
      "text": "Sprinkle with 2 tablespoons Parmesan cheese to serve."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

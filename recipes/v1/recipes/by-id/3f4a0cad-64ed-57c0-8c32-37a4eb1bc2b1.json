  "id": "3f4a0cad-64ed-57c0-8c32-37a4eb1bc2b1",
  "slug": "philly-cheesesteak-smothered-tater-tots-recipe-8747185",
  "name": "Philly Cheesesteak Smothered Tater Tots",
  "recipe_type": "side",
  "brief_description": "These Philly cheesesteak smothered tater tots take the same steak, bell pepper, and cheese filling from the beloved sandwich, and serve it hot over crispy, golden baked tater tots.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a large baking sheet with foil; arrange tater tots on the sheet in a single layer."
    },
    {
      "position": 2,
      "text": "Bake in the preheated oven until golden, about 20 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, cook and stir onion, green pepper, and red pepper in a large skillet over medium-high heat for 5 minutes. Add beef, Worcestershire sauce, and steak seasoning. Cook until most of liquid has evaporated, about 6 minutes."
    },
    {
      "position": 4,
      "text": "Divide beef mixture over baked tater tots with a slotted spoon. Sprinkle shredded cheese over the top."
    },
    {
      "position": 5,
      "text": "Bake until cheese is melted and beginning to brown, about 5 minutes more."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

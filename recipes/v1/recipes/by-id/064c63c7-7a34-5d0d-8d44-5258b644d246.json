  "id": "064c63c7-7a34-5d0d-8d44-5258b644d246",
  "slug": "kozys-creamy-coconut-rice-pudding",
  "name": "Coconut Rice Pudding",
  "recipe_type": "dessert",
  "brief_description": "This coconut rice pudding made with coconut milk and coconut extract for extra coconut flavor. Try topping with toasted shredded coconut.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water and rice to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until rice is tender and liquid has been absorbed, 20 to 25 minutes."
    },
    {
      "position": 2,
      "text": "Combine rice, coconut milk, sugar, and salt in a pot; cook and stir until thickened and creamy, about 20 minutes."
    },
    {
      "position": 3,
      "text": "Beat milk and egg together in a bowl. Spoon 1 to 2 tablespoons rice mixture into milk mixture and beat to warm and temper milk mixture. Slowly pour milk mixture into rice mixture while constantly beating; cook, stirring constantly, until pudding is heated through, 2 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Remove pot from heat and stir coconut oil, vanilla extract, and coconut extract into pudding; refrigerate until chilled, about 1 hour. Garnish pudding with pineapple wedge, if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "b7af6ab5-a2e6-530b-a6c0-f25de717431a",
  "slug": "asian-pork-tenderloin",
  "name": "Asian Pork Tenderloin",
  "recipe_type": "main",
  "brief_description": "This Asian pork recipe features oven-roasted pork tenderloin in a marinade of soy sauce, garlic, ginger, chile paste, sesame oil, and brown sugar.",
  "cuisine": "World",
  "instructions": [
    {
      "position": 1,
      "text": "Place pork tenderloin in a shallow dish."
    },
    {
      "position": 2,
      "text": "Pour soy sauce, sesame oil, and Worcestershire sauce into a medium bowl. Whisk in green onions, garlic, brown sugar, chile paste, and pepper until combined. Pour sauce over tenderloin, turning meat a few times to coat. Cover the dish and marinate in the refrigerator for 8 hours to overnight."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 4,
      "text": "Transfer pork tenderloin with marinade into an aluminum foil-lined baking pan."
    },
    {
      "position": 5,
      "text": "Roast in the preheated oven until an instant-read thermometer inserted into the center reads at least 145 degrees F (63 degrees C), 25 to 30 minutes. Allow to stand 5 to 10 minutes before carving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,

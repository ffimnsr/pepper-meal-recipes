  "id": "d9dd1e53-3304-5894-9f16-7b8fb1657267",
  "slug": "koulas-best-ever-chicken-gyros",
  "name": "Best Ever Chicken Gyros",
  "recipe_type": "main",
  "brief_description": "Easy chicken gyros made under the broiler with a tangy marinade\u2014this quick, flavorful recipe is perfect for weeknight dinners and served in warm pita with yogurt.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Arrange chicken strips side by side in a broiling pan. Stir ketchup, olive oil, white wine vinegar, oregano, mustard powder, and curry powder together in a small bowl. Pour over chicken; let marinate while preheating the broiler."
    },
    {
      "position": 2,
      "text": "Broil uncovered with the meat about 6 inches from the heat source until chicken is cooked through and reaches 165 degrees F (74 degrees C), about 15 minutes. Avoid overcooking, as the chicken can become stringy and dry."
    },
    {
      "position": 3,
      "text": "Place hot chicken into pita pockets and spoon some of the juices from the pan over it. Top with salad greens and plain yogurt."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

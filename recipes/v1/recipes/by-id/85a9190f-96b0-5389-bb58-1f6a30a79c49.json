  "id": "85a9190f-96b0-5389-bb58-1f6a30a79c49",
  "slug": "fresh-cranberry-salsa",
  "name": "Fresh Cranberry Salsa",
  "recipe_type": "appetizer",
  "brief_description": "Brighten your holiday table with this fresh cranberry salsa. It's tart, sweet, and zesty with cucumber, celery, and jalape\u00f1o.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place cranberries into a food processor, and pulse until finely chopped. They should still have some texture."
    },
    {
      "position": 2,
      "text": "Transfer to a serving bowl; stir in sugar, orange liqueur, cucumber, celery and jalape\u00f1o. Let sit at room temperature for 15 minutes before serving to blend the flavors."
    }
  ],
  "servings": 8,

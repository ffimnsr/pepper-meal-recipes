  "schema_version": 1,
  "id": "99d3a535-80e7-5f69-b8cb-34c70e0dee9d",
  "slug": "chef-johns-baked-mushroom-risotto",
  "name": "Chef John's Baked Mushroom Risotto",
  "recipe_type": "side",
  "brief_description": "Take the guesswork out of risotto with this recipe where the rice is started on the stove, baked halfway through the process, then finished with cheese and chives on the stove.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt butter in large, oven-proof skillet over medium-high heat. Add mushrooms; season with salt, and cook and stir mushrooms until brown. They will begin browning after the moisture evaporates."
    },
    {
      "position": 3,
      "text": "Reduce heat to medium and stir in onion. Sprinkle with black pepper and cayenne pepper. Cook and stir until onions are translucent and soft."
    },
    {
      "position": 4,
      "text": "Pour rice into skillet and stir until each rice grain is coated with butter. Season with salt."
    },
    {
      "position": 5,
      "text": "Pour 1 cup chicken broth into the rice mixture. Raise heat to medium-high and cook, stirring rice until liquid is completely absorbed by the rice."
    },
    {
      "position": 6,
      "text": "Pour another cup chicken stock into the rice and stir until mixture comes to a simmer."
    },
    {
      "position": 7,
      "text": "Bake in preheated oven until grains are almost tender but still slightly firm, about 15 minutes. Transfer skillet to stovetop. Season with more salt, if necessary."
    },
    {
      "position": 8,
      "text": "Combine the remaining 1/2 cup chicken broth and cream; pour into the skillet. Cook on medium heat, stirring constantly until rice is tender, 1 or 2 minutes. Remove skillet from heat."
    },
    {
      "position": 9,
      "text": "Drizzle 2 tablespoons cream over rice. Add the grated Parmigiano-Reggiano and chives; stir. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

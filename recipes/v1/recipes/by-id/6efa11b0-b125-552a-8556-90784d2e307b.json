  "id": "6efa11b0-b125-552a-8556-90784d2e307b",
  "slug": "chef-johns-gazpacho",
  "name": "Chef John's Gazpacho",
  "recipe_type": "appetizer",
  "brief_description": "Gazpacho is an incredibly refreshing tomato and vegetable soup served cold for a delicious summer appetizer. Best made with fresh, super sweet tomatoes.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Combine diced tomatoes, cucumber, bell pepper, green onion, jalape\u00f1o, and garlic in a large bowl. Stir in salt, cumin, oregano, cayenne pepper, and black pepper."
    },
    {
      "position": 2,
      "text": "Place cherry tomatoes, olive oil, lime juice, balsamic vinegar, and Worcestershire sauce in a blender. Cover and pur\u00e9e until smooth."
    },
    {
      "position": 3,
      "text": "Pour pur\u00e9ed mixture through a strainer into the tomato-cucumber mixture; stir to combine."
    },
    {
      "position": 4,
      "text": "Place 1/3 of the tomato mixture into the blender. Cover, turn blender on, and pur\u00e9e until smooth. Return pur\u00e9ed mixture to the remaining tomato-cucumber mixture. Stir to combine. Cover and chill in the refrigerator for 2 hours."
    },
    {
      "position": 5,
      "text": "Season cold soup with salt and black pepper to taste. Ladle into bowls and top with basil."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "medium",

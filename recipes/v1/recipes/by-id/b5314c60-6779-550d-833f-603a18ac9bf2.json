  "id": "b5314c60-6779-550d-833f-603a18ac9bf2",
  "slug": "overnight-breakfast-casserole-recipe-8760120",
  "name": "Overnight Breakfast Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This overnight breakfast casserole is pretty and colorful, with a good balance of vegetables and sausage, tender eggs, and hash browns. It's easy to put together, and makes enough for a crowd.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Grease a 9x13 baking dish with cooking spray. Spread hash browns in the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Cook sausage over medium heat in a large skillet until starting to brown, about 2 minutes."
    },
    {
      "position": 4,
      "text": "Add bell peppers, onion, garlic, and oregano to skillet. Continue cooking until vegetables are tender and sausage is no longer pink, about 5 minutes. Add spinach; cook until wilted, about 1 minute."
    },
    {
      "position": 5,
      "text": "Spread vegetable and sausage mixture over hash browns in the baking dish. Sprinkle cheese over the top."
    },
    {
      "position": 6,
      "text": "Beat eggs, milk, mustard, salt, and pepper together in a bowl. Pour egg mixture over casserole. Cover and refrigerate 8 hours to overnight."
    },
    {
      "position": 7,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 8,
      "text": "Bake casserole, uncovered, in the preheated oven until a knife inserted in the center comes out clean, 50 to 60 minutes. Let stand 10 minutes before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

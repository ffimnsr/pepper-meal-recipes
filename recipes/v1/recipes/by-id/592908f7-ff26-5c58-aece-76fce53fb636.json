  "id": "592908f7-ff26-5c58-aece-76fce53fb636",
  "slug": "irish-soda-bread-with-buttermilk",
  "name": "Irish Soda Bread with Buttermilk",
  "recipe_type": "dessert",
  "brief_description": "Buttermilk, whole wheat flour, and oats star in this easy Irish soda bread recipe with sweet and savory variations for all occasions.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (191 degrees C). Line a cookie sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Mix flours, rolled oats, sugar, baking powder, baking soda, and salt in a medium bowl. Mix buttermilk and melted butter together in a small bowl."
    },
    {
      "position": 3,
      "text": "Make a small well in the flour mixture and pour in the buttermilk-butter mixture. Stir together with a wooden spoon until well combined."
    },
    {
      "position": 4,
      "text": "Turn the dough out on a generously floured surface and knead into a smooth, round loaf. Place on the cookie sheet and cut a shallow X into the top of the dough."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until top is golden brown, about 1 hour. Carefully tap the bottom of the loaf; it should sound hollow. Cool on a baking rack for at least 30 minutes before slicing."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

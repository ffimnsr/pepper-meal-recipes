  "id": "054a34f8-84fa-5ed5-a400-8f8d1c5b24d0",
  "slug": "wrapped-buffalo-chicken-bites",
  "name": "Wrapped Buffalo Chicken Bites",
  "recipe_type": "appetizer",
  "brief_description": "All the fixings for Buffalo chicken dip are wrapped in crescent roll dough and baked into appetizer bites perfect for watching the big game.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix cream cheese, hot sauce, ranch dressing, onion, garlic powder, and onion powder together in a bowl; fold in chicken."
    },
    {
      "position": 3,
      "text": "Roll crescent roll dough onto a work surface, pressing dough into a thin layer without tearing. Cut 3-inch pieces out of dough using a biscuit cutter. Spoon about 1 tablespoon of cream cheese mixture into the center of each dough piece. Pull dough over filling; crimp edges together using a fork."
    },
    {
      "position": 4,
      "text": "Arrange pockets on a baking sheet. Brush each pocket with butter and sprinkle with Cheddar cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown, about 15 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

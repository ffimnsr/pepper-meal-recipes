  "id": "0984bd44-2b02-5a01-ba72-aa3068b1ef45",
  "slug": "easy-lettuce-wraps",
  "name": "Easy Lettuce Wraps",
  "recipe_type": "appetizer",
  "brief_description": "These easy lettuce leaves are great for stir-fried pork. This fun recipe is bursting with Asian flavors.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine stir-fry sauce, sherry, and cornstarch; set aside."
    },
    {
      "position": 2,
      "text": "Stir-fry pork, onion, and garlic in a wok or large skillet over high heat until pork is no longer pink; drain excess fat. Add stir-fry sauce mixture; cook and stir until pork is evenly coated with sauce. Off heat, stir in cilantro and sesame oil."
    },
    {
      "position": 3,
      "text": "Serve desired amount of pork mixture in a lettuce leaf; wrap to enclose."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "541eafd8-52bb-583c-8946-f78a7b22b255",
  "slug": "hearty-minestrone-soup-instant-pot",
  "name": "Instant Pot Hearty Minestrone Soup",
  "recipe_type": "soup",
  "brief_description": "Make use of this hearty minestrone soup Instant Pot recipe to whip up a delicious dinner full of beef stew meat, lots of veggies, and gluten-free pasta.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a multi-functional pressure cooker (such as Instant Pot) on Saut\u00e9 mode. Add beef and onion; cook until beef is no longer pink on the outside, about 4 minutes. Add green beans, celery, carrot, garlic, oregano, dried basil, and black pepper to the Pot; stir to combine."
    },
    {
      "position": 2,
      "text": "Add broth, diced tomatoes, and crushed tomatoes to the Pot; stir to combine. Select Soup setting; close and lock the lid. Select High pressure according to manufacturer's instructions; set timer for 35 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 3,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Stir in kidney beans and pasta. Turn on Slow Cook mode; cook according manufacturer's instructions until vegetables and pasta are tender, about 10 minutes. Season with salt. Top servings with Parmesan cheese and fresh basil."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

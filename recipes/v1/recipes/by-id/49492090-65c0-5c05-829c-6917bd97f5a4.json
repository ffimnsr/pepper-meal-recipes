{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "49492090-65c0-5c05-829c-6917bd97f5a4",
  "slug": "lamb-braised-in-pomegranate",
  "name": "Lamb Braised in Pomegranate",
  "recipe_type": "drink",
  "brief_description": "Chef John braises lamb chops in pomegranate juice in this beautiful dish. Serve on polenta, potatoes, or rice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 2,
      "text": "Generously season lamb chops with salt and black pepper."
    },
    {
      "position": 3,
      "text": "Heat vegetable oil in a Dutch oven over high heat. Place lamb chops in Dutch oven and cook until browned on all sides, about 8 minutes. Transfer lamb to a plate and reduce heat to medium."
    },
    {
      "position": 4,
      "text": "Stir onion and a pinch of salt into the Dutch oven; cook until onions are slightly golden, about 3 minutes. Stir in garlic and cook for 30 seconds."
    },
    {
      "position": 5,
      "text": "Pour pomegranate juice into the Dutch oven and scrape any browned bits off of the bottom of the pot. Pour in balsamic vinegar, increase heat to high, and bring to a boil."
    },
    {
      "position": 6,
      "text": "Stir mint leaves, rosemary, and red pepper flakes into pomegranate juice mixture. Continue to boil until liquid is reduced by half, about 10 minutes. Return lamb and any accumulated juices to the Dutch oven, spoon pomegranate mixture over lamb, and cover."
    },
    {
      "position": 7,
      "text": "Cook in the preheated oven until lamb is fork tender, about 2 hours."
    },
    {
      "position": 8,
      "text": "Transfer lamb to a plate and set the Dutch oven on the stovetop over high heat. Bring pomegranate mixture to a boil; cook, skimming any fat that accumulates, until liquid is reduced by 1/3, about 5 minutes."
    },
    {
      "position": 9,
      "text": "Stir in honey and season with salt and black pepper. Return lamb to the Dutch oven; stir to combine. Garnish with pomegranate seeds, sliced mint leaves, and pumpkin seeds."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 150,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "schema_version": 1,
  "id": "8e8a3a34-c787-5adf-a10b-b093cbfed563",
  "slug": "chicken-asparagus-and-mushroom-skillet",
  "name": "Chicken, Asparagus, and Mushroom Skillet",
  "recipe_type": "main",
  "brief_description": "This chicken with asparagus and mushroom dish cooks quickly on the stove and boasts bright flavors of lemon, white wine, garlic, parsley, and basil.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter and olive oil in a skillet over medium-high heat. Stir garlic, lemon juice, wine, parsley, basil, salt, and oregano into hot butter-oil mixture."
    },
    {
      "position": 3,
      "text": "Add chicken; cook and stir until chicken is browned, about 3 minutes. Flip, reduce heat to medium and cook, stirring occasionally, until chicken is no longer pink inside, about 10 more minutes. An instant-read thermometer inserted into the center of chicken should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 4,
      "text": "Add asparagus; cook and stir until asparagus is bright green and starting to become tender, about 3 minutes."
    },
    {
      "position": 5,
      "text": "Stir in mushrooms and cook until they release their juices, about 3 more minutes."
    },
    {
      "position": 6,
      "text": "Serve hot over rice or pasta. Enjoy!"
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

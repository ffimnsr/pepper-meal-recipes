  "id": "8718f352-60e8-5bc7-8cc0-5e2d2929823a",
  "slug": "jiffy-jalapeno-cheese-cornbread-muffins-recipe-8711179",
  "name": "Jiffy Jalapeno Cheese Cornbread Muffins",
  "recipe_type": "side",
  "brief_description": "These Jiffy jalapeno cheese cornbread muffins add a lot of punch to convenient corn muffin mix. With pickled jalapenos, freshly grated Cheddar, creamed corn, and sour cream, they are moist, zingy, and savory.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease 12 standard muffin cups or line with paper liners."
    },
    {
      "position": 2,
      "text": "Combine muffin mix, milk, eggs, sour cream, creamed corn, pickled jalapenos, and cheese in a large bowl; stir to combine. Divide mixture among prepared muffin cups. Place a jalapeno slice on top of each muffin."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until browned around the edges and centers spring back lightly when touched, 17 to 20 minutes. Lightly press down the center of each muffin to flatten the top slightly right after taking them out of the oven. Serve topped with butter."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

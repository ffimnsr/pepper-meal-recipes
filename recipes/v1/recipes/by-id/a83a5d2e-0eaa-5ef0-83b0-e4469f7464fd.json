  "id": "a83a5d2e-0eaa-5ef0-83b0-e4469f7464fd",
  "slug": "yellow-pound-cake",
  "name": "Yellow Pound Cake",
  "recipe_type": "dessert",
  "brief_description": "Pound cakes do not need icing, and always taste great either way.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Separate the eggs. Beat the whites to stiff peaks, and reserve the yolks."
    },
    {
      "position": 2,
      "text": "In a large bowl, cream sugar and butter or margarine. Beat in egg yolks. Stir in milk and vanilla. Add flour, 1 cup at a time. Fold in stiffly beaten egg whites. Pour batter into well greased large tube pan."
    },
    {
      "position": 3,
      "text": "Bake for 90 minutes at 325 degrees F (165 degrees C)."
    }
  ],
  "servings": 14,

  "id": "e3aa8824-f3a1-5328-9213-68e8b98d1dd7",
  "slug": "caldo-de-pollo",
  "name": "Caldo de Pollo",
  "recipe_type": "soup",
  "brief_description": "Caldo de pollo is a simple but richly-flavored chicken soup that's packed with vegetables and seasoned with garlic and lots of fresh cilantro.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place chicken legs into a large stockpot; cover with water. Add minced garlic, salt, and garlic powder."
    },
    {
      "position": 3,
      "text": "Cover the pot; bring to a boil over high heat. Reduce to a simmer; cook until chicken meat falls off the bones, 1 to 2 hours."
    },
    {
      "position": 4,
      "text": "Stir in chicken bouillon cube until dissolved; add carrots, potatoes, zucchini, chayote, and white onion. Reduce heat to medium-low; simmer until carrots and potatoes are tender, 45 to 60 minutes."
    },
    {
      "position": 5,
      "text": "Stir chopped cilantro into soup; simmer for 5 minutes."
    },
    {
      "position": 6,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 110,

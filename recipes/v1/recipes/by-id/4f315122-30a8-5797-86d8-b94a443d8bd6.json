  "id": "4f315122-30a8-5797-86d8-b94a443d8bd6",
  "slug": "zucchini-bread",
  "name": "Zucchini Bread with Chocolate Chips",
  "recipe_type": "breakfast",
  "brief_description": "This zucchini bread with chocolate chips recipe yields two loaves studded with chocolate chips \u2014 vegetable oil, zucchini, and sour cream add moistness.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 9x5-inch loaf pans."
    },
    {
      "position": 2,
      "text": "Whisk flour, cinnamon, baking powder, and baking soda together in a large bowl; set aside."
    },
    {
      "position": 3,
      "text": "Beat sugar, oil, and eggs together in a separate large bowl with an electric mixer until well combined; fold in zucchini and sour cream. Stir in flour mixture until well combined; fold in chocolate chips. Divide batter between the prepared pans."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 40 to 60 minutes. Cool in the pans on a wire rack for 20 minutes."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "52d115ff-03df-575e-b292-7fb80803111d",
  "slug": "pumpkin-seed-granola",
  "name": "Pumpkin Seed Granola",
  "recipe_type": "dessert",
  "brief_description": "Delicious homemade pumpkin seed granola with toasted pumpkin seeds, oats, shredded coconut, and pumpkin pie spice sweetened with sugar-free syrup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Mix pumpkin seeds, oats, pumpkin puree, maple-flavored syrup, coconut, butter, pumpkin pie spice, cinnamon, and salt together in a bowl until well combined. Spread mixture evenly over the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven, stirring every 15 minutes, until desired crispness is reached, 30 to 45 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

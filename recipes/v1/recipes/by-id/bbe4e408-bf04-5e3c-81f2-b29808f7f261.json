  "id": "bbe4e408-bf04-5e3c-81f2-b29808f7f261",
  "slug": "spanish-rice",
  "name": "Spanish Rice",
  "recipe_type": "side",
  "brief_description": "Very easy, very good Spanish rice!",
  "cuisine": "Mexican Inspired Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "In a large skillet, combine oil, rice, onion, green pepper and salt and pepper until the rice is a light brown color. Remove skillet from stove."
    },
    {
      "position": 2,
      "text": "Mix tomatoes into the mixture. Pour in water (it should cover the entire mixture; use more if necessary). Return the skillet to the stovetop and bring the mixture to a full boil; salt and pepper to taste. When the mixture begins to boil, cover the skillet, and reduce heat to a simmer. Cook 12 to 15 minutes and never, I mean NEVER, remove the cover. After 12 to 15 minutes, turn stove off and let stand for another 12 to 15 minutes. DO NOT remove cover until the final 15 minutes has elapsed!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

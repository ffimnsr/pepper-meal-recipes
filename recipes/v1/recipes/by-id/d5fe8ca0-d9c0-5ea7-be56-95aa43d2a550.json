  "id": "d5fe8ca0-d9c0-5ea7-be56-95aa43d2a550",
  "slug": "vanilla-berry-parfaits",
  "name": "Vanilla Berry Parfaits",
  "recipe_type": "dessert",
  "brief_description": "Delicious and easy, this is a fabulous mix of berries and yogurt! If you like, you can make a thin layer of graham crackers or granola in each vanilla/berry layer. That gives it a little more crunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Cover the bottoms of two small glasses with a layer of yogurt. Cover layer with berries."
    },
    {
      "position": 3,
      "text": "Repeat until both glasses are full, ending with a fruit layer. Sprinkle with graham crackers and nutmeg."
    }
  ],
  "servings": 2,

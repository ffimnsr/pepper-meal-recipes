  "id": "062b4bed-8703-5069-9523-52a117eb576e",
  "slug": "butternut-squash-and-turkey-chili",
  "name": "Turkey and Butternut Squash Chili",
  "recipe_type": "soup",
  "brief_description": "This spicy butternut squash chili with ground turkey, tomatoes, green chilies, hominy, and beans is a delicious and hearty dinner for fall.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large pot over medium heat. Add onion and garlic; cook and stir for 3 minutes. Stir in turkey and cook until crumbly and no longer pink, about 5 to 7 minutes."
    },
    {
      "position": 3,
      "text": "Add butternut squash, chicken broth, green chilies, tomatoes, kidney beans, hominy, and tomato sauce; season with chili powder, cumin, and garlic salt."
    },
    {
      "position": 4,
      "text": "Bring to a simmer, then reduce heat to medium-low, cover, and simmer until the squash is tender, about 20 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

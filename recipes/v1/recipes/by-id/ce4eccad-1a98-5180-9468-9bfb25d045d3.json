  "id": "ce4eccad-1a98-5180-9468-9bfb25d045d3",
  "slug": "tuna-casserole-iii",
  "name": "Tuna Casserole III",
  "recipe_type": "soup",
  "brief_description": "Mushrooms soup, tuna and crushed potato chips. Quick and easy for students or busy moms and dads.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9-inch glass pie dish."
    },
    {
      "position": 2,
      "text": "In a mixing bowl, combine soup, tuna, and 1/4 of the potato chips. Mix thoroughly. Pour into the prepared pie dish. Cover the top with remaining potato chips."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until potato chips on top start to brown, 10 to 15 minutes. Cool before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

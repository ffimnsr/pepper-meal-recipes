  "id": "96662a58-d12e-5d5f-8af6-1c427f3bfdd6",
  "slug": "green-apple-salad-with-blueberries-feta-and-walnuts",
  "name": "Green Apple Salad With Blueberries, Feta, and Walnuts",
  "recipe_type": "salad",
  "brief_description": "Salad greens, Granny Smith apple, feta cheese, and walnuts are tossed in a blueberry balsamic dressing in this colorful fall fruit salad that's always a hit.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Make the salad: Layer salad greens, apple cubes, walnuts, feta cheese, cranberries, and green onions in a large bowl."
    },
    {
      "position": 2,
      "text": "Make the dressing: Combine vegetable oil, blueberries, olive oil, vinegar, and salt in a food processor or blender; pulse until well blended and smooth."
    },
    {
      "position": 3,
      "text": "Pour dressing over salad and toss until well combined. Chill for 30 minutes before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

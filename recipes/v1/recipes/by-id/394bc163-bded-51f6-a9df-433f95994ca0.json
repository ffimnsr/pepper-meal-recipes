  "id": "394bc163-bded-51f6-a9df-433f95994ca0",
  "slug": "ambrosia-salad-with-jell-o",
  "name": "Ambrosia Salad with Jell-O",
  "recipe_type": "salad",
  "brief_description": "Dyed delicious with Jell-O, this molded ambrosia salad with pineapple, walnuts, and marshmallow needs an overnight beauty rest in the fridge.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place whipped topping in a large bowl and stir until thawed and smooth."
    },
    {
      "position": 3,
      "text": "Add gelatin and mix well."
    },
    {
      "position": 4,
      "text": "Add pineapple with juice, walnuts, and marshmallows."
    },
    {
      "position": 5,
      "text": "Mix together and transfer into a mold of your choice. Refrigerate for 8 hours to overnight before unmolding."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

  "id": "9ae543ce-6798-5209-b95b-ad7b610d9967",
  "slug": "easiest-peanut-butter-fudge",
  "name": "Easiest Peanut Butter Fudge",
  "recipe_type": "dessert",
  "brief_description": "Peanut butter fudge made with creamy peanut butter, brown sugar, butter, milk, confectioners' sugar, and vanilla for a rich and creamy treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a medium saucepan over medium heat; stir in brown sugar and milk. Bring to a boil and boil for 2 minutes, stirring frequently."
    },
    {
      "position": 3,
      "text": "Remove the pot from heat; stir in peanut butter and vanilla."
    },
    {
      "position": 4,
      "text": "Place confectioners' sugar in a large mixing bowl. Pour in peanut butter mixture and beat with an electric mixer until smooth."
    },
    {
      "position": 5,
      "text": "Pour peanut butter mixture into an 8x8-inch dish."
    },
    {
      "position": 6,
      "text": "Chill until firm before slicing, about 1 hour."
    },
    {
      "position": 7,
      "text": "Enjoy!"
    }
  ],
  "servings": 32,

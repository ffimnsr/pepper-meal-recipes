  "id": "932ebea7-03a3-5ad2-aff5-34e0b29a29f1",
  "slug": "brads-killer-eggnog",
  "name": "Brad's Killer Eggnog",
  "recipe_type": "drink",
  "brief_description": "This delicious eggnog cocktail recipe uses real eggs, real cream, and plenty of rum for an oh-so-rich indulgence and extra holiday cheer.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat egg whites in a glass, metal, or ceramic bowl until foamy. Add 1 cup sugar gradually, continuing to beat until stiff peaks form. Lift your beater or whisk straight up: the egg whites will form sharp peaks."
    },
    {
      "position": 2,
      "text": "Beat egg yolks and remaining 1 cup sugar in a separate bowl until frothy and lightened in color."
    },
    {
      "position": 3,
      "text": "Fold egg whites into egg yolk mixture gently; pour into a large punch bowl or pitcher. Stir in rum, half-and-half, and milk."
    },
    {
      "position": 4,
      "text": "Top eggnog with nutmeg; serve with ice."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

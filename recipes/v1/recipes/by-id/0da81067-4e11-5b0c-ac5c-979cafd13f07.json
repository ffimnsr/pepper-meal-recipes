  "id": "0da81067-4e11-5b0c-ac5c-979cafd13f07",
  "slug": "chocolate-ricotta-mousse",
  "name": "Chocolate Ricotta Mousse",
  "recipe_type": "dessert",
  "brief_description": "This 4-ingredient chocolate ricotta mousse recipe with dark chocolate, ricotta cheese, honey, and vanilla is very rich and takes only minutes to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place chocolate in the top of a double boiler over simmering water. Stir frequently, scraping down the sides with a rubber spatula to avoid scorching, until chocolate is melted, about 5 minutes. Cool slightly."
    },
    {
      "position": 2,
      "text": "Combine melted chocolate, ricotta cheese, honey, and vanilla extract in a blender; blend until smooth. Pour into dessert cups or glasses; chill completely."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

  "id": "a9a0ac77-4251-56d7-95aa-eb1acf56bb08",
  "slug": "delicious-artichoke-dip",
  "name": "Delicious Artichoke Dip",
  "recipe_type": "appetizer",
  "brief_description": "This hot artichoke dip is the life of any party. Serve hot with celery, toasted bread or crackers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "In a medium-sized mixing bowl, stir together mayonnaise, sour cream, Parmesan cheese and onion. When these ingredients are combined, mix in artichoke hearts, lemon juice, salt and pepper. Transfer mixture to a shallow baking dish."
    },
    {
      "position": 3,
      "text": "Bake at 400 degrees F (200 degrees C) for 20 minutes, or until light brown on top."
    }
  ],
  "servings": 7,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,

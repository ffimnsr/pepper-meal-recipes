  "id": "2cb8d30e-d564-5acf-8a2d-c3ecc20d49e6",
  "slug": "bread-machine-focaccia",
  "name": "Bread Machine Focaccia",
  "recipe_type": "main",
  "brief_description": "It's simple to make bread machine focaccia dough, then brush it with oil, sprinkle it with fresh rosemary, and bake it until golden brown and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place water, 2 tablespoons olive oil, garlic, bread flour, 1 tablespoon rosemary, salt, and yeast into a bread machine in the order listed, or follow the order recommended by the manufacturer if different. Run Dough cycle. Remove dough from the machine after the cycle is done, about 90 minutes."
    },
    {
      "position": 2,
      "text": "Pat dough into a 9x13-inch baking pan or a 12-inch pizza pan. Use your fingers to dimple the dough every inch or so. Brush with remaining 2 tablespoons oil and sprinkle with remaining 1/2 tablespoon rosemary. Cover with plastic wrap and let rest while the oven preheats, about 15 minutes."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 4,
      "text": "Remove plastic wrap and bake focaccia in the preheated oven until golden brown, 20 to 25 minutes. Let cool for 5 minutes before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

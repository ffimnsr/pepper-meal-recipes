  "id": "d6d6b190-993b-5770-9167-3b4246ab224f",
  "slug": "shrimp-linguine",
  "name": "Shrimp Linguine",
  "recipe_type": "main",
  "brief_description": "This shrimp linguine recipe with parsley, basil, and thyme in a dreamy garlic and cream sauce is great for a family dinner and good enough for guests!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook linguine at a boil until tender yet firm to the bite, about 11 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, melt butter in a large skillet over medium heat. Add garlic, and saut\u00e9 briefly to release flavor. Add cream; heat just to boiling, stirring frequently. Reduce heat to low; stir in shrimp, parsley, basil, and thyme. Continue cooking until shrimp are just heated through; remove sauce from heat."
    },
    {
      "position": 3,
      "text": "Drain pasta and toss lightly with cream sauce. Add Parmesan cheese, salt, and pepper to taste; toss again and serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "aa8d57d9-18a1-528e-b57d-1ac3af1f3571",
  "slug": "easy-quiche",
  "name": "Easy Quiche",
  "recipe_type": "breakfast",
  "brief_description": "This easy quiche recipe is loaded with broccoli, ham, and cheese, and is totally crustless. It's perfect for breakfast, brunch, lunch, or dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 10-inch quiche dish."
    },
    {
      "position": 2,
      "text": "Beat milk, eggs, Parmesan cheese, baking mix, and butter together in a large bowl until well combined; batter will be lumpy. Stir in broccoli, Cheddar cheese, and ham."
    },
    {
      "position": 3,
      "text": "Pour into the prepared quiche dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until eggs are set and the top is golden brown, about 50 minutes,"
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

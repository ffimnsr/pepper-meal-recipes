  "slug": "vegan-keto-lemon-fat-bombs",
  "name": "Vegan Keto Lemon Fat Bombs",
  "recipe_type": "appetizer",
  "brief_description": "Make these tasty vegan fat bombs, made with lemon zest and coconut, ahead for a quick energy snack, and also for keto and raw diets!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Blend shredded coconut in a food processor until creamy, about 15 minutes. Add coconut oil, erythritol, lemon zest, and sea salt; blend until well combined. Fill mini muffin cups with mixture and chill in the fridge until set, about 30 minutes."
    }
  ],

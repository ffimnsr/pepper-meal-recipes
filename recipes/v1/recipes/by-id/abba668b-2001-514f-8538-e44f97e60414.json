  "id": "abba668b-2001-514f-8538-e44f97e60414",
  "slug": "apple-rhubarb-crisp",
  "name": "Apple Rhubarb Crisp",
  "recipe_type": "dessert",
  "brief_description": "This apple-rhubarb crisp pairs tangy rhubarb with sweet, fruity apples and tops it all off with a crumbly topping of brown sugar, butter, and oats.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Butter a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Mix apples, rhubarb, 1 cup white sugar, 1/4 cup flour, and 1 teaspoon cinnamon in a bowl until thoroughly combined. Spread fruit mixture into the bottom of the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Mix oats, remaining 1 \u00bd cups flour, and brown sugar in a separate bowl; cut in butter until crumbly. Spread evenly over fruit mixture."
    },
    {
      "position": 4,
      "text": "Mix 2 tablespoons white sugar with remaining 1/2 teaspoon cinnamon in a small bowl; sprinkle over oat topping."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until fruit is bubbling and thick and topping is golden brown, about 45 minutes. Let cool 10 to 15 minutes, then serve."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,

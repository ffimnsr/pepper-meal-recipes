  "slug": "bourbon-cream-and-coffee-martini-recipe-11942526",
  "name": "Bourbon Cream and Coffee Martini",
  "recipe_type": "appetizer",
  "brief_description": "This Bourbon cream and coffee martini is rich, sweet, dark, and complex, with bitter notes from coffee and a light hint of fruit from Chambord liqueur. Bourbon cream, made with real dairy, makes it smooth.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a cocktail shaker with ice."
    },
    {
      "position": 2,
      "text": "Add Bourbon cream, coffee, Chambord, and agave syrup to the cocktail shaker. Cover and shake until the outside of the shaker is frosted, about 30 seconds."
    },
    {
      "position": 3,
      "text": "Pour into a martini glass and serve."
    }
  ],
  "servings": 1,

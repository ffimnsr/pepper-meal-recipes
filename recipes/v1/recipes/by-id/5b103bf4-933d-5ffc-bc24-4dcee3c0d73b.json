  "slug": "willis-farm-applesauce",
  "name": "Willis Farm Applesauce",
  "recipe_type": "side",
  "brief_description": "This Willis Farm applesauce is a uniquely colored applesauce from Red Hots spicy cinnamon candies, adding extra flavor to this quick-and-easy recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine apples and water in a large pot over medium heat; bring to a simmer and cook for 5 minutes. Stir in cinnamon candies and sugar; return to a simmer and cook until candies melt, about 15 minutes. Set aside off heat until mixture cools, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Mash apple mixture with a potato masher until no large chunks remain."
    }
  ],
  "servings": 6,

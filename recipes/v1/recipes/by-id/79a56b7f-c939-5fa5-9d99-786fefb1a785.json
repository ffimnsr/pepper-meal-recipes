  "id": "79a56b7f-c939-5fa5-9d99-786fefb1a785",
  "slug": "dbs-caramel-popcorn-bacon-mix",
  "name": "DB's Caramel Popcorn Bacon Mix",
  "recipe_type": "dessert",
  "brief_description": "Caramel corn gets a salty twist with the addition of maple-coated bacon and pretzels creating a sweet and savory snack everyone will love.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Arrange bacon slices close together and slightly overlapping onto the prepared baking sheet. Drizzle bacon slices evenly with maple syrup."
    },
    {
      "position": 3,
      "text": "Place the baking sheet in the cold oven; set temperature to 400 degrees F (200 degrees C). Bake until bacon is crisp, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Transfer bacon slices to a paper towel-lined plate to cool. Crumble cooled bacon."
    },
    {
      "position": 5,
      "text": "Reduce oven temperature to 250 degrees F (120 degrees C). Line 2 baking sheets with aluminum foil."
    },
    {
      "position": 6,
      "text": "Lightly mix popcorn, rice cereal, wheat cereal, peanuts, pretzels, and crumbled bacon together in a large bowl. Transfer to the prepared baking sheets."
    },
    {
      "position": 7,
      "text": "Melt butter in a saucepan over medium heat; mix brown sugar, corn syrup, and salt into the melted butter. Cook, stirring constantly, until mixture begins to boil. Boil mixture, without stirring, for 4 minutes."
    },
    {
      "position": 8,
      "text": "Place popcorn mixture in the preheated oven to warm."
    },
    {
      "position": 9,
      "text": "Remove the butter mixture from heat and mix in vanilla extract and baking soda until caramel begins to foam. Drizzle caramel in a thin stream over popcorn mixture, tossing to evenly coat."
    },
    {
      "position": 10,
      "text": "Bake caramel corn in the oven, stirring every 15 minutes, until caramel coating is set, 1 hour. Let caramel corn cool completely before breaking into pieces."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 15,

  "id": "f17769b8-c41e-5d56-9f51-29b112e3275e",
  "slug": "badische-schupfnudeln-potato-noodles",
  "name": "Badische Schupfnudeln (Potato Noodles)",
  "recipe_type": "drink",
  "brief_description": "Traditional of southwestern Germany, this delicious homemade potato noodle goes well with all sorts of dishes.",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Place whole potatoes in their skins into a large pot of boiling water; boil for 25 to 30 minutes. Remove potatoes, and discard water. When cool enough to handle, peel potatoes, and place on a lightly floured surface. Mash potatoes with a rolling pin."
    },
    {
      "position": 2,
      "text": "Place mashed potatoes into a large bowl. Stir in flour, egg, parsley, salt, and nutmeg. Knead well to form a smooth dough. Then roll out the dough to a thickness of about 1/2 inch. Cut flattened dough into thin strips, about 1 1/2 inches long. Gently roll out the strips, or stretch them until the ends taper. Set aside for 15 minutes."
    },
    {
      "position": 3,
      "text": "In a large skillet, heat lard over medium heat. Place the potato strips into the skillet, and fry until golden brown on both sides."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

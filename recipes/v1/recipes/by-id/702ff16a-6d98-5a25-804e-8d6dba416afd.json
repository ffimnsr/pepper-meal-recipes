  "id": "702ff16a-6d98-5a25-804e-8d6dba416afd",
  "slug": "kolaches-ii",
  "name": "Kolaches",
  "recipe_type": "dessert",
  "brief_description": "This version of homemade kolaches flavors the dough with lemon extract, fills it with fruit preserves, and bakes it until golden brown.",
  "cuisine": "Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Combine shortening and sugar in a large bowl; beat until creamy. Stir in salt, scalded milk, egg yolks, and lemon extract. Let cool until lukewarm."
    },
    {
      "position": 2,
      "text": "Stir yeast into the lukewarm milk mixture; let stand until slightly foamy, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Add flour and mix until a soft dough forms. Add additional flour, 1 tablespoon at a time, if needed, until dough begins to pull away from the sides of the bowl. Dough will remain soft and slightly sticky. Cover and let rise in a warm place until doubled in size, about 1 hour."
    },
    {
      "position": 4,
      "text": "Divide dough into 36 portions and roll into smooth balls. Place on the prepared baking sheets about 2 inches apart. Let rise for 15 minutes."
    },
    {
      "position": 5,
      "text": "Press a deep indentation into the center of each dough ball and fill with fruit preserves. Chill for 15 minutes to help the kolaches hold their shape during baking."
    },
    {
      "position": 6,
      "text": "Meanwhile, preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until golden brown, 12 to 15 minutes."
    },
    {
      "position": 8,
      "text": "Cool on baking sheets for 5 minutes, then transfer to wire racks to cool completely."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

  "schema_version": 1,
  "id": "b8e277cb-ea9e-5bfc-a50c-b5afd2b57f44",
  "slug": "gluten-free-cheese-crackers",
  "name": "Gluten-Free Cheese Crackers",
  "recipe_type": "appetizer",
  "brief_description": "Gluten-free cheese crackers are made possible thanks to garbanzo bean flour, Cheddar-Monterey Jack cheese, and butter as the base ingredients.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Put Cheddar-Monterey Jack cheese in a bowl; add butter. Cover bowl and let sit until warmed to room temperature."
    },
    {
      "position": 3,
      "text": "Combine flour and paprika together in a separate bowl."
    },
    {
      "position": 4,
      "text": "Mix cheese and butter together using your hands. Slowly add flour mixture to cheese-butter mixture until dough holds together in a ball. Roll dough onto a work surface, about 1/8-inch thick. Cut dough into cracker shapes using cookie cutters or a knife; sprinkle salt over dough. Arrange dough pieces on a baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until crackers are crisp, 15 to 18 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

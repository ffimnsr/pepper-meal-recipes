  "id": "5ed0db30-6bcd-5def-a653-f91ef0910601",
  "slug": "pumpkin-baked-oatmeal-recipe-11837508",
  "name": "Pumpkin Baked Oatmeal",
  "recipe_type": "dessert",
  "brief_description": "This pumpkin baked oatmeal is delicious served warm with Greek yogurt dusted with cinnamon and a drizzle of maple syrup. It's like having pumpkin cake for breakfast, but much more nutritious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (180 degrees C). Grease a 9-inch (23cm) square cake pan with butter, oil, or cooking spray."
    },
    {
      "position": 2,
      "text": "Beat together milk, eggs, syrup, and pumpkin puree in a large bowl until well combined."
    },
    {
      "position": 3,
      "text": "Pour in oats, baking powder, pumpkin pie spice, vanilla, and salt; add pecans if using. Stir well. Pour into prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 30 to 35 minutes, until the center is just set and a toothpick comes out clean. Loosely cover with foil if browning too quickly."
    },
    {
      "position": 5,
      "text": "Serve on its own or with warm milk."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

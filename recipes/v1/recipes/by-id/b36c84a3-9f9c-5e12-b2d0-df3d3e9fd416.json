  "id": "b36c84a3-9f9c-5e12-b2d0-df3d3e9fd416",
  "slug": "potato-and-egg-casserole",
  "name": "Potato and Egg Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This potato and egg casserole is made with sliced potatoes and hard-boiled eggs layered in a rich sour cream sauce.",
  "cuisine": "Hungarian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of salted water to a boil. Add potatoes and cook until tender but still firm, about 15 minutes. Drain and let cool."
    },
    {
      "position": 3,
      "text": "While the potatoes are cooking, cover eggs in a saucepan and with cold water. Bring water to a boil, then immediately remove from heat. Cover and let eggs stand in hot water for 10 to 12 minutes. Remove eggs from hot water and place under cold running water to cool."
    },
    {
      "position": 4,
      "text": "Slice potatoes. Peel and slice eggs."
    },
    {
      "position": 5,
      "text": "Starting and ending with potatoes, layer potatoes and eggs in a 9x13-inch casserole dish, sprinkling each layer of eggs with seasoning salt."
    },
    {
      "position": 6,
      "text": "Cook and stir sour cream and margarine in a small saucepan over low heat until melted. Pour over casserole and sprinkle lightly with seasoning salt."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven for 30 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

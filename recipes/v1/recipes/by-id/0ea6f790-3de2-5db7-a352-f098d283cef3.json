  "id": "0ea6f790-3de2-5db7-a352-f098d283cef3",
  "slug": "sausage-egg-and-biscuit-breakfast-bundt-casserole-recipe-11844510",
  "name": "Sausage, Egg, and Biscuit Breakfast Bundt Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This sausage, egg, and biscuit breakfast Bundt casserole, a savory all-in-one breakfast in the festive ring shape of a Bundt pan, is a great answer to a chilly morning.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray a Bundt pan liberally with cooking spray. Set aside."
    },
    {
      "position": 2,
      "text": "Heat a skillet over medium-high heat. Crumble sausage into the skillet, and cook and stir until browned, about 5 minutes. Remove from heat and set aside."
    },
    {
      "position": 3,
      "text": "Whisk eggs and milk together in a large bowl. Cut each biscuit into quarters; add biscuits, hash browns, cheese, and green onion to eggs and stir gently to combine. Season with salt, pepper, and cayenne. Stir sausage gently into egg mixture."
    },
    {
      "position": 4,
      "text": "Pour mixture into the prepared pan. Cover with foil."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 20 minutes. Remove foil and bake until top is lightly browned and eggs are set, about 20 more minutes. Let the pan rest for about 5 minutes."
    },
    {
      "position": 6,
      "text": "Use a butterknife to loosen casserole from sides of pan. Invert onto a dinner plate, then slice to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

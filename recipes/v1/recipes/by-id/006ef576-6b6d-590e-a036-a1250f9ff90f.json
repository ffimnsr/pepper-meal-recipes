  "id": "006ef576-6b6d-590e-a036-a1250f9ff90f",
  "slug": "shrimp-scampi-bake",
  "name": "Shrimp Scampi Bake",
  "recipe_type": "drink",
  "brief_description": "This baked shrimp scampi recipe features shrimp baked in butter, garlic, lemon juice, and parsley with a bit of Dijon mustard to kick up the flavor.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients.Preheat oven to 450 degrees F (230 degrees C)"
    },
    {
      "position": 2,
      "text": "In a small saucepan over medium heat, combine the butter, mustard, lemon juice, garlic, and parsley. When the butter melts completely, remove from heat."
    },
    {
      "position": 3,
      "text": "Arrange shrimp in a shallow baking dish. Pour the butter mixture over the shrimp."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven for 12 to 15 minutes or until the shrimp are pink and opaque."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

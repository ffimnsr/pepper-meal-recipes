  "id": "62e59e77-0fc3-57a8-8b86-d3a52b25a2e3",
  "slug": "indonesian-spiced-rice",
  "name": "Indonesian Spiced Rice",
  "recipe_type": "side",
  "brief_description": "This colorful, spicy rice side dish is flavored with garlic, turmeric, cinnamon, and jalape\u00f1os. Pairs perfectly with lamb kabobs.",
  "cuisine": "Indonesian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large, heavy pan over medium heat. Stir in onion, jalape\u00f1os, and garlic. Saut\u00e9 until onion is translucent; about 6 to 8 minutes."
    },
    {
      "position": 2,
      "text": "Stir in turmeric and cinnamon. Add rice; cook and stir for 2 minutes. Mix in chicken broth, water, and bay leaf; bring to a boil. Reduce heat to low, cover, and cook for 20 minutes."
    },
    {
      "position": 3,
      "text": "Turn off the heat and let sit for 5 minutes. Garnish with chopped green onion."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

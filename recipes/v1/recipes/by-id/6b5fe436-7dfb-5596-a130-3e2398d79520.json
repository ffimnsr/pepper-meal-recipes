  "id": "6b5fe436-7dfb-5596-a130-3e2398d79520",
  "slug": "slow-cooker-potato-bacon-soup",
  "name": "Slow Cooker Potato-Bacon Soup",
  "recipe_type": "soup",
  "brief_description": "Try this easy slow cooker potato-bacon soup for a comforting, hearty meal that\u2019s sure to please on winter nights.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels; reserve drippings in the pan. Crumble 6 strips of bacon, saving 3 for garnish."
    },
    {
      "position": 2,
      "text": "Heat bacon drippings over medium-high heat. Cook onion in the hot drippings until soft, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Transfer potatoes, crumbled bacon, onions, and garlic powder to a slow cooker. Pour broth over the top. Cook on Low until potatoes are tender, about 6 hours."
    },
    {
      "position": 4,
      "text": "Whisk half-and-half and flour together in a bowl. Add to the slow cooker and whisk to mash up some of the potatoes. Stir in 3 cups of Cheddar-Monterey Jack cheese blend. Mix until cheese is melted and fully incorporated."
    },
    {
      "position": 5,
      "text": "Crumble remaining bacon. Top with remaining cheese, crumbled bacon, and chives before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 375,
  "preparation_time_minutes": 15,

  "slug": "waynesboroughs",
  "name": "Waynesboroughs",
  "recipe_type": "breakfast",
  "brief_description": "Savory and delicious sausage and egg filled burritos.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Boil the potatoes in a large saucepan until they are soft, but not mushy. Drain and return to the pan."
    },
    {
      "position": 2,
      "text": "In a large skillet, brown the sausage until there is no pink left. Drain and set aside."
    },
    {
      "position": 3,
      "text": "Coat a small skillet with vegetable cooking spray. Over medium heat, scramble the eggs."
    },
    {
      "position": 4,
      "text": "Mix potatoes, sausage and scrambled eggs thoroughly and place into the flour tortillas."
    }
  ],
  "servings": 10,

  "id": "203d4193-bd14-5be7-868e-657e223c5e90",
  "slug": "pomegranate-fizz-recipe-8724216",
  "name": "Pomegranate Fizz",
  "recipe_type": "appetizer",
  "brief_description": "This pomegranate fizz is a refreshing and vibrant mocktail that balances the tartness of pomegranate juice with the herbal notes of fresh basil, while a hint of agave adds a touch of natural sweetness. A splash of club soda adds a bubbly finish, making this drink light and effervescent.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a shaker, add basil leaves with lime juice and agave syrup and mash with a cocktail muddler. Add pomegranate juice to the shaker and shake well."
    },
    {
      "position": 2,
      "text": "Fill a glass with ice cubes and strain shaker contents into the glass. Top with club soda and garnish with lime wedge."
    }
  ],
  "servings": 1,

  "id": "1aaaea65-5d64-506d-8fce-5ddfc08a51c0",
  "slug": "gluten-free-waffles",
  "name": "Gluten-Free Waffles",
  "recipe_type": "breakfast",
  "brief_description": "Buckwheat and almond flours are the key ingredients in these gluten-free waffles that are crispy on the outside and soft and delicious on the inside.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a waffle iron according to manufacturer's instructions."
    },
    {
      "position": 2,
      "text": "Stir milk, buckwheat, almond flour, vegetable oil, eggs, baking powder, sugar, and salt together in a bowl until batter is smooth."
    },
    {
      "position": 3,
      "text": "Working in batches, ladle batter into preheated waffle iron and cook until waffles are golden and crisp, 3 to 5 minutes."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 10,

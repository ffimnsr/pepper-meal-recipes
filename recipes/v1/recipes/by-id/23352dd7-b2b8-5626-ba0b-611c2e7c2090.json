  "id": "23352dd7-b2b8-5626-ba0b-611c2e7c2090",
  "slug": "peanut-choc-scotch-fudge",
  "name": "Peanut Choc-Scotch Fudge",
  "recipe_type": "dessert",
  "brief_description": "Peanut butter, chocolate chips and butterscotch chips all make an appearance in this easy fudge.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Lightly grease a 9x13 inch dish."
    },
    {
      "position": 2,
      "text": "In a 2-quart saucepan over medium heat, combine butter, sugar and milk. Bring to a boil, stirring constantly. Heat to between 234 and 240 degrees F (112 to 116 degrees C), or until a small amount of syrup dropped into cold water forms a soft ball that flattens when removed from the water and placed on a flat surface. Remove from heat and stir in peanut butter, chocolate chips and butterscotch chips until melted. Stir in vanilla. Fold in marshmallow creme. Pour into prepared pan. Chill in refrigerator until firm."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

  "id": "3d6f70df-c9c3-5de1-8eb0-d1b04b75ea83",
  "slug": "tomato-salsa-without-onions",
  "name": "Tomato Salsa without Onions",
  "recipe_type": "appetizer",
  "brief_description": "This authentic-tasting chunky tomato salsa is made without onions. It has a wonderful smoky flavor thanks to roasted poblano pepper.",
  "cuisine": "Tex Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven\u2019s broiler."
    },
    {
      "position": 2,
      "text": "Place poblano pepper and garlic cloves on a medium baking sheet. Turning pepper frequently, broil at maximum distance from heat until browned, about 15 minutes."
    },
    {
      "position": 3,
      "text": "In a food processor, place roasted pepper, roasted garlic, tomatoes, cilantro, cumin, chili powder, and lime juice. Process using pulse setting until an evenly chunky texture is obtained. Chill until serving."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

  "id": "2ec9b2f2-5981-56cd-a40b-d01c419954dc",
  "slug": "oma-kieners-hazelnut-christmas-cookies",
  "name": "Oma Kiener's Hazelnut Christmas Cookies",
  "recipe_type": "dessert",
  "brief_description": "An inherited recipe, these buttery hazelnut cookies are a snap to make and simple to bake. Prepare the dough and refrigerate as a log, then slice into rounds, decorate with candy sprinkles, and bake. Easy!",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Beat butter, sugar, egg, and salt together in a mixing bowl until light and fluffy. Stir in flour and baking soda, and mix just until blended. Mix in hazelnuts."
    },
    {
      "position": 3,
      "text": "Turn dough out onto a lightly floured surface and shape into 2 1/2 inch log. Wrap snugly in wax paper, and refrigerate overnight."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease baking sheets. Unwrap, and cut the log into 1/8 inch thick slices."
    },
    {
      "position": 5,
      "text": "Place 2 inches apart on the prepared baking sheets. Brush tops with beaten egg and decorate with sprinkles, if desired."
    },
    {
      "position": 6,
      "text": "Bake in preheated oven until edges are lightly browned, 12 to 15 minutes. Cool on racks, and store in an airtight tin."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

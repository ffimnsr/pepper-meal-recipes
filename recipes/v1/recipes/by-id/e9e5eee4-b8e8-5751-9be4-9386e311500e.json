  "id": "e9e5eee4-b8e8-5751-9be4-9386e311500e",
  "slug": "sweet-beet-smoothie",
  "name": "Beet Smoothie",
  "recipe_type": "dessert",
  "brief_description": "This beet smoothie is a delicious blend of avocado, banana, fresh pineapple, apple, and beets for a naturally sweet, colorful, and refreshing drink.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Juice beets and green apples, including peels, in an electric juicer."
    },
    {
      "position": 2,
      "text": "Combine apple-beet juice, avocado, pineapple, banana, and ice in a high-speed blender; blend until smooth."
    }
  ],
  "servings": 2,

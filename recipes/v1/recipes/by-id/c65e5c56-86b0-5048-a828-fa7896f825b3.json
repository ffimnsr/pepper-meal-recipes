  "id": "c65e5c56-86b0-5048-a828-fa7896f825b3",
  "slug": "caramel-peanut-fudge",
  "name": "Caramel Peanut Fudge",
  "recipe_type": "dessert",
  "brief_description": "Chocolate, peanut butter, marshmallow fluff, and caramel -- all you need is a saucepan and a refrigerator for this multi-layered dessert.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Lightly grease a 9x13 inch dish."
    },
    {
      "position": 2,
      "text": "For the bottom layer: Combine 1 cup milk chocolate chips, 1/4 cup butterscotch chips and 1/4 cup creamy peanut butter in a small saucepan over low heat. Cook and stir until melted and smooth. Spread evenly in prepared pan. Refrigerate until set."
    },
    {
      "position": 3,
      "text": "For the filling: In a heavy saucepan over medium-high heat, melt butter. Stir in sugar and evaporated milk. Bring to a boil, and let boil 5 minutes. Remove from heat and stir in marshmallow creme, 1/4 cup peanut butter and vanilla. Fold in peanuts. Spread over bottom layer, return to refrigerator until set."
    },
    {
      "position": 4,
      "text": "For the caramel: Combine caramels and cream in a medium saucepan over low heat. Cook and stir until melted and smooth. Spread over filling. Chill until set."
    },
    {
      "position": 5,
      "text": "For the top layer: In a small saucepan over low heat, combine 1 cup milk chocolate chips, 1/4 cup butterscotch chips, and 1/4 cup peanut butter. Cook and stir until melted and smooth. Spread over caramel layer. Chill 1 hour before cutting into 1 inch squares."
    }
  ],
  "servings": 96,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

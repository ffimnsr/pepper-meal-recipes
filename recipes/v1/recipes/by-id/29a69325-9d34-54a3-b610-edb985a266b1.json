  "id": "29a69325-9d34-54a3-b610-edb985a266b1",
  "slug": "salmon-smash-burger-recipe-11771816",
  "name": "Salmon Smash Burgers",
  "recipe_type": "main",
  "brief_description": "These salmon smash burgers are a flavorful twist on the classic, featuring patties made from fresh salmon. Chopped fresh salmon is mixed with just four other ingredients.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Chop salmon or place in a food processor, and pulse a few times to chop."
    },
    {
      "position": 3,
      "text": "Combine salmon, egg, flour, dill, and burger seasoning in a bowl and mix gently."
    },
    {
      "position": 4,
      "text": "Scoop about 1 cup mixture and form into a ball for 4 to 5 balls."
    },
    {
      "position": 5,
      "text": "Heat 1 tablespoon oil in a large cast iron skillet or griddle over medium-high heat."
    },
    {
      "position": 6,
      "text": "Place balls in the skillet, leaving plenty of space to smash them. Using a burger press or spatula press each salmon ball to a thin layer. You may have to work in batches. Cook for 2 to 3 minutes per side."
    },
    {
      "position": 7,
      "text": "Serve as desired in burger buns with your favorite toppings."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "675aac9b-4019-5cbe-bbd2-2ccb715e3661",
  "slug": "thai-chicken-meatball-noodle-soup",
  "name": "Thai Chicken Meatball Noodle Soup",
  "recipe_type": "soup",
  "brief_description": "Enjoy a warm and aromatic bowl of chicken meatball soup with rice noodles infused with Thai flavors.",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a rimmed baking sheet with parchment paper; set aside."
    },
    {
      "position": 2,
      "text": "Combine ground chicken, bread crumbs, egg, soy sauce, ginger root, green onions, garlic, and red pepper flakes in a large bowl. Using a 2-teaspoon cookie scoop, shape the mixture into 1-inch balls and place on the lined baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until no longer pink in the center, about 12 minutes. Remove from the oven and set aside."
    },
    {
      "position": 4,
      "text": "Heat olive oil in a large pot over medium heat, and add curry paste. Cook until fragrant, 1 to 2 minutes. Add red onion and cook for 2 minutes. Add chicken stock, coconut milk, bok choy, cilantro, fish sauce, and honey; stir until well combined. Bring to a boil. Reduce heat to medium, add meatballs, and simmer until heated through, 6 to 8 minutes. Season with salt and pepper."
    },
    {
      "position": 5,
      "text": "Place rice noodles in a large bowl and cover with hot water. Set aside until noodles are softened, about 15 minutes. Drain well. Divide noodles evenly among bowls, ladling the soup and meatballs on top. Serve with a wedge of fresh lime for a little extra zing."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

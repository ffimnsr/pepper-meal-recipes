  "id": "9db2e368-0d99-564e-85a1-816eda4ef699",
  "slug": "raspberry-linzer-cookies",
  "name": "Linzer Cookies",
  "recipe_type": "dessert",
  "brief_description": "Sweet and soft Linzer cookies sandwiched with raspberry jam and dusted with confectioners' sugar make a delightful addition to your Christmas cookie tray.",
  "cuisine": "Austrian American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix flour, baking soda, salt, and cinnamon together in a bowl using a whisk."
    },
    {
      "position": 2,
      "text": "Beat white sugar and butter together with an electric mixer on high in a bowl until light and fluffy; add egg and almond extract. Beat until well blended."
    },
    {
      "position": 3,
      "text": "Gradually beat flour mixture into sugar-butter mixture until dough is soft. Divide dough into 2 equal balls and wrap each portion in plastic wrap. Chill dough in refrigerator for at least 1 hour."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line two baking sheets with parchment paper."
    },
    {
      "position": 5,
      "text": "Roll 1 dough ball into a 1/8-inch thick rectangle on a lightly floured surface; cut into 32 cookies using a square, star, or circular cookie cutter. Repeat with the second dough ball. Cut out the center of 32 cookies using a 1-inch square cookie cutter. Arrange all 64 cookies on the prepared baking sheets about 1 inch apart."
    },
    {
      "position": 6,
      "text": "Bake cookies in the preheated oven until edges are lightly browned, about 10 minutes. Cool on pans for 5 minutes before transferring cookies to wire racks to cool completely."
    },
    {
      "position": 7,
      "text": "Spread about 1/2 teaspoon raspberry jam into the center of each whole cookie. Sprinkle the cut-out cookies with confectioners' sugar; place 1 cut-out cookie atop each raspberry jam-topped cookie."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

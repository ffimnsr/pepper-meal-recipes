  "id": "39e99e4c-722b-59ad-ae36-c25554e29569",
  "slug": "hawaiian-macaroni-salad-recipe-11758576",
  "name": "Hawaiian Macaroni Salad",
  "recipe_type": "salad",
  "brief_description": "This Hawaiian macaroni salad may be the simplest version of mac salad ever, but it is also the one that always gets finished first and gets complimented the most. Uncomplicated yet surprisingly delicious, it is the best thing you can serve at a cookout alongside spicy barbecued meat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "If using red onion, place onion in a bowl with enough cold water to cover. Set aside to soak for 20 minutes; drain."
    },
    {
      "position": 2,
      "text": "Meanwhile, stir mayonnaise, cider vinegar, sugar, salt, and black pepper together in a large bowl. Stir in red onion immediately after draining. Stir in grated carrot; set aside."
    },
    {
      "position": 3,
      "text": "Bring a large pot of generously salted water to a rolling boil, and boil elbow macaroni until tender with a bite, about 5 minutes, or according to package directions. Pour into a strainer set in the sink. Run cold water over pasta until pasta is cooled to room temperature, about 30 seconds. Drain in the strainer for about 20 seconds."
    },
    {
      "position": 4,
      "text": "Pour macaroni into the bowl with dressing and mix well. Scrape down the sides of the bowl, cover salad with a sheet of plastic directly touching the surface, and refrigerate for at least 3 hours and preferably overnight."
    },
    {
      "position": 5,
      "text": "Remove salad from refrigerator and stir thoroughly. Adjust texture by stirring in a spoonful of mayonnaise, and about 1/4 cup water. Stir again, and add more mayonnaise and/or water as needed. Taste for salt and adjust if needed."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "0d06ce00-8d59-5b23-90f2-719a3f28a36a",
  "slug": "buttermilk-pound-cake-ii",
  "name": "Buttermilk Pound Cake",
  "recipe_type": "dessert",
  "brief_description": "This buttermilk pound cake is flavored with lemon and vanilla, then baked until golden for a simple dessert served with fresh berries or ice cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a 9- or 10-inch tube pan."
    },
    {
      "position": 2,
      "text": "Mix together flour, salt, and baking soda in a medium bowl. Set aside."
    },
    {
      "position": 3,
      "text": "Beat together sugar and butter in a large bowl with an electric mixer until light and fluffy. Add eggs one at time, beating well after each addition. Stir in lemon and vanilla extracts. Add flour mixture in batches, alternating with buttermilk, beating batter briefly after each addition. Pour batter into the prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cake begins to pull away from the sides of the pan, about 90 minutes; do not open the oven door until after 1 hour. Let cake cool in the pan for 10 minutes, then turn out onto a wire rack to cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

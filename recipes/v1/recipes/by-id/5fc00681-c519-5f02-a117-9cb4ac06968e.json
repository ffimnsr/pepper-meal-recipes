  "id": "5fc00681-c519-5f02-a117-9cb4ac06968e",
  "slug": "cheesy-pepper-jelly-bites-recipe-11834640",
  "name": "Cheesy Pepper Jelly Bites",
  "recipe_type": "appetizer",
  "brief_description": "These cheesy pepper jelly bites are hot, tangy, crisp, and buttery, an impressive appetizer that is pretty easy to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F and lightly grease a 24-cup mini muffin pan with nonstick spray."
    },
    {
      "position": 2,
      "text": "Unfold the puff pastry on a lightly floured surface and roll it just enough to smooth out the creases. Cut into 24 equal squares (4 across and 6 down works perfectly). Press 1 pastry square into each muffin cup."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until the pastry begins to puff and turn lightly golden, 10 to 12 minutes."
    },
    {
      "position": 4,
      "text": "Cut cream cheese into 24 small cubes. Gently press 1 cube into each puff pastry cup, then top with about 1 teaspoon of pepper jelly."
    },
    {
      "position": 5,
      "text": "Return the pan to the oven; bake until the pastry is golden and the cream cheese is warmed through, 8 to 10 minutes more."
    },
    {
      "position": 6,
      "text": "Let the bites cool in the pan for 5 to 10 minutes before removing. Sprinkle with thyme or chives and serve warm. Enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

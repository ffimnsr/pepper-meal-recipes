  "id": "36659fe1-5ae0-53a4-a6a2-3ffac8337c8c",
  "slug": "brined-turkey",
  "name": "Brined Turkey",
  "recipe_type": "main",
  "brief_description": "Soak your Thanksgiving centerpiece in heavily salted water with herbs to get your bird ready for roasting.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Bring 2 quarts water to a boil in a large pot; stir kosher salt and white sugar into the water to dissolve completely. Remove from heat and let cool somewhat before transferring to a large food-safe container large enough to hold the brine and turkey, but small enough to fit in your refrigerator. Pour 2 gallons cold water into the container; add rosemary sprigs, thyme sprigs, garlic, Allspice, and black pepper."
    },
    {
      "position": 2,
      "text": "Gently submerge turkey into the brine; refrigerate for 12 to 36 hours."
    },
    {
      "position": 3,
      "text": "Remove turkey from the brine and rinse both inside and outside thoroughly. Discard brine."
    }
  ],
  "servings": 16,

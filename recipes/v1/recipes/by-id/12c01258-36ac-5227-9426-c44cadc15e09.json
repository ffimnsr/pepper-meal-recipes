  "slug": "vinegar-based-bbq-sauce",
  "name": "Vinegar-Based BBQ Sauce",
  "recipe_type": "side",
  "brief_description": "This vinegar-based BBQ sauce made with brown sugar and hot pepper can be used to baste meat while grilling or add moisture and flavor to cooked meat.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together vinegar, brown sugar, kosher salt, red pepper flakes, and cayenne pepper in a small bowl until combined. Allow to sit at room temperature until flavors meld, 4 to 8 hours."
    }
  ],
  "servings": 10,

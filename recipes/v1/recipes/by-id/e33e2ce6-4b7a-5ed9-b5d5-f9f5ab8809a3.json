  "id": "e33e2ce6-4b7a-5ed9-b5d5-f9f5ab8809a3",
  "slug": "old-fashioned-rice-pudding-ii",
  "name": "Old-Fashioned Rice Pudding II",
  "recipe_type": "dessert",
  "brief_description": "This is a simple, plain rice pudding that will remind you of your grandmothers'! It's white rice baked with sugar, scalded milk and butter.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 2,
      "text": "In a 1 quart baking dish combine rice, salt and sugar. Stir in scalded milk and dot with butter."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 1 1/2 hours, or until rice is very tender and milk is thick and creamy. Stir gently with a fork every 15 minutes during the first hour."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 5,

  "id": "9d866d48-3128-5132-a054-d1f5f5f42875",
  "slug": "vegan-breakfast-sausage",
  "name": "Vegan Breakfast Sausage",
  "recipe_type": "breakfast",
  "brief_description": "TVP is the MVP in this easy, vegan take on breakfast sausage, loaded with flavor and pan-fried on the stovetop.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix TVP, vegetable broth, and flaxseed meal together in a large mixing bowl and let sit for 5 minutes. Add oats, yeast, flour, gluten, sage, black pepper, fennel seeds, garlic powder, thyme, smoked paprika, salt, and cayenne. Mix until well blended."
    },
    {
      "position": 2,
      "text": "Combine water, soy sauce, and maple syrup in a separate container and mix well. Add to the TVP mixture and combine into a slightly crumbly dough. Mix well to activate gluten and let dough sit for 5 minutes; dough should stiffen slightly and become less crumbly."
    },
    {
      "position": 3,
      "text": "Form into tablespoon-size balls and flatten slightly."
    },
    {
      "position": 4,
      "text": "Heat oil in a cast iron or nonstick frying pan over medium heat. Cook sausage patties in the hot oil until golden brown, about 5 minutes on each side."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

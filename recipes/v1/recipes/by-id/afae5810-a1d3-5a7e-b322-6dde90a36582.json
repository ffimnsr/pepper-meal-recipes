  "schema_version": 1,
  "id": "afae5810-a1d3-5a7e-b322-6dde90a36582",
  "slug": "orange-pumpkin-loaf",
  "name": "Orange Pumpkin Loaf",
  "recipe_type": "breakfast",
  "brief_description": "This moist orange pumpkin loaf combines whole orange, pumpkin, and walnuts for a flavorful fall treat. Perfect plain or with cream cheese spread.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5 inch loaf pan."
    },
    {
      "position": 2,
      "text": "Cut orange into wedges; remove and discard seeds. Pulse orange with peel in a food processor until finely ground; set aside."
    },
    {
      "position": 3,
      "text": "Cream sugar and butter together in a large bowl until smooth. Beat in eggs one at a time; stir in pumpkin, water, and ground orange."
    },
    {
      "position": 4,
      "text": "Mix flour, baking soda, salt, baking powder, cinnamon, and cloves together in another large bowl. Stir into sugar-butter mixture until just moistened. Fold in nuts and raisins. Spoon into the prepared loaf pan."
    },
    {
      "position": 5,
      "text": "Bake for 1 hour in the preheated oven, or until a toothpick inserted near the center comes out clean. Let stand 10 minutes, then remove from pan, and cool on a wire rack."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,

  "id": "6905ae4d-92e9-59ca-a3d2-5bbf91fcfd9d",
  "slug": "spinach-and-orzo-salad",
  "name": "Spinach and Orzo Salad",
  "recipe_type": "salad",
  "brief_description": "Orzo pasta is tossed with spinach, red onion, feta cheese, pine nuts, basil, olive oil and balsamic vinegar, creating a delicious, colorful cold salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add orzo and cook for 8 to 10 minutes or until al dente; drain and rinse with cold water. Transfer to a large bowl and stir in spinach, feta, onion, pine nuts, basil and white pepper. Toss with olive oil and balsamic vinegar. Refrigerate and serve cold."
    }
  ],

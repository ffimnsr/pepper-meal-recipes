  "id": "e8218478-5594-51b6-b9a0-ad77730b0d00",
  "slug": "sloppied-flank-steak-sandwiches",
  "name": "Sloppied Flank Steak Sandwiches",
  "recipe_type": "main",
  "brief_description": "A tangy, tomato-based sloppy joe sauce with brown sugar and apple cider vinegar makes a good sauce for chopped steak, too. Make it in a slow cooker, and pile it on toasted buns.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Sprinkle the beef flank steak with steak seasoning on both sides. Heat olive oil in a skillet over medium heat until the oil shimmers, and place the flank steak into the hot oil. Quickly brown the steak on both sides, about 5 minutes per side. Set the beef aside."
    },
    {
      "position": 2,
      "text": "Stir brown sugar, onion, red bell pepper, apple cider vinegar, Worcestershire sauce, tomato sauce, and tomato paste together in a slow cooker until the brown sugar dissolves. Place the flank steak into the slow cooker, immersing it in the sauce. Set the cooker on on High and cook 4 hours, or set on Low and cook 8 hours."
    },
    {
      "position": 3,
      "text": "To serve, shred the meat with 2 forks, or remove the meat, chop, and return to the sauce. Toast buns, and serve the sloppied steak on the toasted buns."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 245,
  "preparation_time_minutes": 10,

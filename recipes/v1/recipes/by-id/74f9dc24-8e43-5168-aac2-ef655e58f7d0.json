  "id": "74f9dc24-8e43-5168-aac2-ef655e58f7d0",
  "slug": "cherry-pepper-poppers",
  "name": "Stuffed Cherry Peppers",
  "recipe_type": "appetizer",
  "brief_description": "These stuffed cherry peppers are filled with prosciutto and provolone cheese for a delicious bite-sized Italian appetizer bursting with flavor.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Slice the tops off of the cherry peppers and carefully remove the seeds, keeping peppers whole. Wrap a cube of cheese with prosciutto, and stuff into a pepper. If there is still room inside the pepper, stuff in more prosciutto. Repeat with remaining peppers."
    },
    {
      "position": 2,
      "text": "Place all of the stuffed peppers into a 1 quart jar - or one that your peppers will all fit into, and sprinkle salt over them. Pour in enough olive oil to cover the peppers. Cover, and let stand for 1 hour before eating. Refrigerate leftovers."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 25,

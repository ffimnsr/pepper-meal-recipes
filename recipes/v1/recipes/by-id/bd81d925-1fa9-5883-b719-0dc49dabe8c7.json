  "id": "bd81d925-1fa9-5883-b719-0dc49dabe8c7",
  "slug": "chili-crisp-deviled-eggs-recipe-11941354",
  "name": "Chili Crisp Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "These chili crisp deviled eggs are creamy deviled eggs that get a bold, spicy upgrade with chili crisp, tangy rice vinegar, and a hint of mustard. Finished with a drizzle of extra chili crisp and fresh green onions, these bite-sized appetizers are rich, flavorful, and just a little fiery\u2014perfect for gatherings or snacking. I used Lao Gan Ma Spicy Chili Crisp, but feel free to use your favorite brand.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Halve eggs lengthwise and scoop egg yolks into a bowl; set egg whites aside. Mash yolks with a fork."
    },
    {
      "position": 2,
      "text": "Add mayonnaise, 1 teaspoon of chili crisp, rice vinegar, dry mustard, and salt to the egg yolks; combine well until smooth."
    },
    {
      "position": 3,
      "text": "Place yolk mixture into a small resealable bag and snip off a corner. Pipe mixture into egg whites. Top with remaining chili crisp and green onions. Refrigerate until ready to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,

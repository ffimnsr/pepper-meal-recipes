  "id": "66fdb836-bb62-5de5-842e-b808b46dcdff",
  "slug": "lasagna-flatbread",
  "name": "Lasagna Flatbread",
  "recipe_type": "main",
  "brief_description": "Give lasagna a quick and easy pizza makeover by baking sausage, ricotta, marinara sauce, and mozzarella on flatbreads.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine ricotta cheese, 1/2 of the mozzarella cheese, Parmesan cheese, egg, and Italian seasoning in a bowl."
    },
    {
      "position": 3,
      "text": "Cook sausage in a skillet over medium heat until no longer pink, 5 to 10 minutes; drain. Stir in marinara sauce."
    },
    {
      "position": 4,
      "text": "Spread 1/6 of the cheese mixture evenly on each flatbread; cover with sausage mixture. Top with remaining mozzarella cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese is melted and bubbly, 10 to 15 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

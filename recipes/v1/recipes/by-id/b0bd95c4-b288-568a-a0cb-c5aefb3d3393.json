  "id": "b0bd95c4-b288-568a-a0cb-c5aefb3d3393",
  "slug": "zucchini-feta-rolls",
  "name": "Zucchini-Feta Rolls",
  "recipe_type": "appetizer",
  "brief_description": "If you are looking for a special antipasto try these zucchini-feta rolls. They need to marinate in the refrigerator for 1 to 2 days, so they are a perfect appetizer to make ahead..",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 2 tablespoons olive oil in a large skillet and cook zucchini slices in batches until soft and lightly browned on both sides, 5 to 10 minutes. Add more olive oil as needed. Remove zucchini slices from skillet and drain on paper towels."
    },
    {
      "position": 2,
      "text": "Sprinkle zucchini slices with feta and roll up. Secure each roll with a tooth pick."
    },
    {
      "position": 3,
      "text": "Set zucchini rolls into a dish that is as deep as the rolls are high, and sprinkle with garlic, Italian herbs, and balsamic vinegar. Cover and marinate in the refrigerator for 1 to 2 days."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

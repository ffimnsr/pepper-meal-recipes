  "schema_version": 1,
  "id": "59a36992-8116-5fb2-8c8d-f97512ee4e6f",
  "slug": "spam-musubi",
  "name": "Spam Musubi",
  "recipe_type": "appetizer",
  "brief_description": "Spam musubi is a popular Hawaiian snack that's easy to make at home with slices of marinated seared Spam prepared sushi-style with rice and nori.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Soak uncooked rice in water to cover for 4 hours; drain and rinse."
    },
    {
      "position": 3,
      "text": "Bring 2 cups water to a boil in a medium saucepan. Add rice and stir. Reduce heat, cover, and simmer for 20 minutes."
    },
    {
      "position": 4,
      "text": "Remove pan from heat and stir in rice vinegar. Set aside to cool."
    },
    {
      "position": 5,
      "text": "Stir sugar, soy sauce, and oyster sauce together in a medium bowl until sugar is completely dissolved."
    },
    {
      "position": 6,
      "text": "Slice luncheon meat lengthwise into 10 slices, or to desired thickness, and marinate in sauce for 5 minutes."
    },
    {
      "position": 7,
      "text": "Heat oil in a large skillet over medium-high heat. Cook slices until lightly browned, about 2 minutes per side."
    },
    {
      "position": 8,
      "text": "Cut nori sheets in half and lay on a flat work surface."
    },
    {
      "position": 9,
      "text": "Place a rice press in the center of a sheet, and press rice tightly inside."
    },
    {
      "position": 10,
      "text": "Top with a slice of luncheon meat, and remove press."
    },
    {
      "position": 11,
      "text": "Wrap nori around rice, sealing edges with a small amount of water. (Rice may also be formed by hand in the shape of the meat slices and about 1-inch thick.)"
    },
    {
      "position": 12,
      "text": "Serve musubi warm or chilled."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "265a5431-4a9c-57fa-9052-6e624cb96a9c",
  "slug": "italian-pork-tenderloin",
  "name": "Italian Pork Tenderloin",
  "recipe_type": "main",
  "brief_description": "Fresh sage, sun-dried tomatoes, prosciutto, and cream give this pork tenderloin dish its rich flavor. It's absolutely wonderful and simple! Chopped ham can be used if prosciutto is unavailable.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat the oil in a skillet over medium-high heat. Saute the prosciutto, sage, parsley, sun-dried tomatoes, and onion 5 minutes, until onion is tender. Mix the pork strips into the skillet, and brown about 10 minutes, turning once."
    },
    {
      "position": 2,
      "text": "Stir the broth and heavy cream into the skillet, and season with salt and pepper. Bring to a boil. Reduce heat to low, and simmer 20 minutes, stirring occasionally, until pork reaches a minimum temperature of 145 degrees F (63 degrees C) and sauce is thickened."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "bang-bang-potato-salad-recipe-8650393",
  "name": "Bang Bang Potato Salad",
  "recipe_type": "salad",
  "brief_description": "This Bang Bang Potato Salad recipe puts a new spin on a classic side with this delicately spicy dressing tossed with tender spuds, hard-cooked eggs, celery, and scallions.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring water, potatoes, and 2 tablespoons salt to a boil in a large Dutch oven or medium pot over high heat. Reduce heat to medium-high and cook, stirring occasionally, until potatoes are just fork-tender, 6 to 8 minutes. Drain potatoes and place in a large bowl; gently toss with butter and remaining 1 teaspoon salt. Refrigerate, uncovered, until completely cool, about 45 minutes."
    },
    {
      "position": 3,
      "text": "Stir together mayonnaise, buttermilk, chili sauce, Thai chili sauce, and rice vinegar in a medium bowl until combined."
    },
    {
      "position": 4,
      "text": "Add eggs and celery to potatoes; gently stir mayonnaise mixture into potatoes until well combined; top with scallions and drizzle with Sriracha."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

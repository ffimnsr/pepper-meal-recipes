  "id": "2f14760d-8d4a-5b39-91d1-c044c544a871",
  "slug": "beef-enchiladas-ii",
  "name": "Beef Enchiladas with Flour Tortillas",
  "recipe_type": "main",
  "brief_description": "A simple and easy beef enchiladas recipe that comes together quickly. Ground beef and onion are wrapped in tortillas, topped with cheese, and baked.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cook ground beef and onion in a medium skillet over medium-high heat until beef is evenly browned and onion is tender."
    },
    {
      "position": 3,
      "text": "Prepare enchilada sauce according to package directions. Pour 1/4 cup of the sauce into the bottom of a 9x13-inch baking dish."
    },
    {
      "position": 4,
      "text": "Place an equal portion of the ground beef mixture and about 1 ounce of Cheddar cheese on each flour tortilla, reserving at least 1/2 cup of cheese. Then tightly roll the tortillas."
    },
    {
      "position": 5,
      "text": "Place rolled tortillas seam side down in the baking dish."
    },
    {
      "position": 6,
      "text": "Pour remaining sauce over the top of the enchiladas and sprinkle with remaining cheese and olives."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until the sauce is bubbly and cheese is thoroughly melted, about 20 minutes."
    },
    {
      "position": 8,
      "text": "Garnish to taste and serve with your favorite side. Enjoy!"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "81f2ed1c-f1c3-569a-9454-b36549703a0a",
  "slug": "grandmas-gingerbread-pancakes",
  "name": "Grandma's Gingerbread Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These easy gingerbread pancakes are made with molasses and spiced with ginger and cinnamon to taste just like gingerbread!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk flour, baking powder, baking soda, salt, ginger, and cinnamon in a bowl; set aside. Beat egg, vanilla, and molasses in a separate mixing bowl until smooth. Whisk in water until completely incorporated. Stir flour mixture into molasses mixture until just combined (a few lumps are okay)."
    },
    {
      "position": 2,
      "text": "Heat a lightly oiled griddle over medium-high heat. Drop batter by large spoonfuls onto the griddle, and cook until bubbles form and the edges are dry. Flip, and cook until browned on the other side. Repeat with remaining batter."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

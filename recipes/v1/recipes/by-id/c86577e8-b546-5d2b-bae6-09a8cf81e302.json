  "id": "c86577e8-b546-5d2b-bae6-09a8cf81e302",
  "slug": "reindeer-food",
  "name": "Reindeer Food",
  "recipe_type": "appetizer",
  "brief_description": "This easy \"reindeer food\" snack mix recipe is fun to make with crunchy cereal, pretzels, nuts, candies, and white chocolate \u2014 perfect for gifting!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cover a large area of counter space with waxed paper and tape it down."
    },
    {
      "position": 2,
      "text": "Mix pretzels, corn cereal, peanuts, and candy-coated milk chocolate pieces together in a large bowl."
    },
    {
      "position": 3,
      "text": "Melt white chocolate in the top of a double boiler over simmering water, stirring frequently and scraping down the sides with a rubber spatula to avoid scorching."
    },
    {
      "position": 4,
      "text": "Pour melted white chocolate over pretzel mixture; stir to evenly coat."
    },
    {
      "position": 5,
      "text": "Quickly transfer mixture to the prepared waxed paper and spread in a thin layer; let cool completely, at least 30 minutes."
    },
    {
      "position": 6,
      "text": "Break into pieces and store in an airtight container."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,

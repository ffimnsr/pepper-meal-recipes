  "id": "eb98fa5c-d23a-579e-8878-c64a4ae2f47a",
  "slug": "seafood-chowder",
  "name": "Seafood Chowder",
  "recipe_type": "soup",
  "brief_description": "This creamy seafood chowder with potatoes and corn is full of flavor thanks to 5 types of shellfish; shrimp, scallops, crab, clams, and calamari.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine cream cheese, 1/2 cup milk, and garlic in a large pot over low heat; cook and stir until blended, about 3 minutes."
    },
    {
      "position": 3,
      "text": "Mix in condensed soup, undrained corn, remaining 1 cup milk, potatoes, green onions, carrots, parsley, black pepper, and cayenne pepper."
    },
    {
      "position": 4,
      "text": "Simmer for 25 minutes, stirring occasionally, without letting the chowder boil."
    },
    {
      "position": 5,
      "text": "Add shrimp, scallops, crab, calamari, and clams; cook until seafood is opaque, about 10 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,

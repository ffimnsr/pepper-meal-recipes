  "id": "cea1aac5-2029-554c-99fe-fb4c36483e9e",
  "slug": "skillet-gnocchi-with-spinach-and-feta-recipe-12004681",
  "name": "Skillet Gnocchi With Spinach and Feta",
  "recipe_type": "side",
  "brief_description": "These skillet gnocchi with spinach and feta are a comforting lunch or dinner that's ready in less than 30 minutes. Golden on the outside and tender inside, the pan-fried gnocchi are tossed with spinach, feta, sun-dried tomatoes, and other flavor-packed ingredients for an easy, Mediterranean-inspired meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of salted water to a boil. Add gnocchi, and cook according to package directions, typically 2 minutes. Remove with a slotted spoon to a paper towel to drain."
    },
    {
      "position": 2,
      "text": "Melt butter and sun-dried tomato oil in a skillet over medium heat. Add gnocchi and fry for 3 to 5 minutes, turning regularly. Add wine or reserved pasta water, sun-dried tomatoes, olives, garlic granules, salt, and pepper, and cook for 2 additional minutes."
    },
    {
      "position": 3,
      "text": "Stir in spinach, and cook until it wilts, 1 to 2 minutes. Gently fold in feta cheese, and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

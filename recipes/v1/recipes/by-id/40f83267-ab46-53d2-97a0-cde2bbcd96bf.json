{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "40f83267-ab46-53d2-97a0-cde2bbcd96bf",
  "slug": "sausage-and-spinach-baked-ziti-recipe-7375475",
  "name": "Sausage and Spinach Baked Ziti",
  "recipe_type": "main",
  "brief_description": "This spinach and ricotta baked ziti with sausage is full of flavor and easy to put together.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Spray a 9x13-inch baking dish with cooking spray. Fill a large pot with lightly salted water and bring to a rolling boil. Stir in ziti and return to a boil. Cook pasta uncovered, stirring occasionally, until they just start to become tender, about 5 minutes. Drain pasta, reserving 1/2 cup pasta water."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat oil in a heavy skillet over medium heat and cook and stir Italian sausage, breaking up the meat as it cooks, until it is no longer pink, 5 to 7 minutes."
    },
    {
      "position": 4,
      "text": "Reserve 1/3 cup crushed tomatoes and pour remaining tomatoes into sausage. Stir in garlic, Italian seasoning, red pepper flakes, and spinach. Cook for 10 minutes."
    },
    {
      "position": 5,
      "text": "Combine ricotta, heavy cream, 4 ounces cubed mozzarella cheese, 4 ounces shredded Parmesan cheese, and garlic granules in a bowl. Season with salt."
    },
    {
      "position": 6,
      "text": "Add the cooked sausage mixture and ricotta mixture to the pasta and toss well. If mixture seems too thick, stir in reserved pasta water 2 tablespoons at a time."
    },
    {
      "position": 7,
      "text": "Spread the reserved 1/3 cup crushed tomatoes into the bottom of the casserole dish. Pour half of pasta in an even layer over tomatoes and top with 1/2 of the remaining mozzarella and Parmesan cheeses. Repeat with remaining pasta and cheese."
    },
    {
      "position": 8,
      "text": "Bake ziti in the preheated oven until cheese is lightly golden brown and pasta is heated through, 25 to 30 minutes. Garnish with chopped fresh basil."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 35,

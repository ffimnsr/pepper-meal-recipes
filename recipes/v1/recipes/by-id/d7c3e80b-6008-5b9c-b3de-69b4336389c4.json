  "id": "d7c3e80b-6008-5b9c-b3de-69b4336389c4",
  "slug": "triple-berry-crisp",
  "name": "Triple Berry Crisp",
  "recipe_type": "dessert",
  "brief_description": "This berry crisp recipe uses fresh raspberries, blackberries, and blueberries to make a juicy summer dessert with a buttery oat crumble topping.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Gently toss together blackberries, raspberries, blueberries, and white sugar in a large bowl; set aside."
    },
    {
      "position": 4,
      "text": "Combine flour, oats, brown sugar, cinnamon, and nutmeg in a separate large bowl. Cut in butter with 2 knives or a pastry blender until crumble mixture resembles coarse crumbs."
    },
    {
      "position": 5,
      "text": "Press 1/2 of the crumble into the bottom of a 9x13-inch pan."
    },
    {
      "position": 6,
      "text": "Cover with berry mixture. Sprinkle remaining crumble over berries."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until fruit is bubbly and the top is golden brown, 30 to 40 minutes."
    },
    {
      "position": 8,
      "text": "Serve with whipped cream. Enjoy!"
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,

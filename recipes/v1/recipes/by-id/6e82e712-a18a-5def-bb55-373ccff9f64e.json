  "id": "6e82e712-a18a-5def-bb55-373ccff9f64e",
  "slug": "sticky-fingers-salad-recipe-8696356",
  "name": "Sticky Fingers Salad",
  "recipe_type": "salad",
  "brief_description": "For this sticky fingers salad, crispy chicken strips are tossed in a hot and sweet sticky sauce, then added to a Romaine and tomato salad. It's delicious and so refreshing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Place chicken strips on a baking sheet."
    },
    {
      "position": 2,
      "text": "Bake chicken in the preheated oven until crispy, about 20 minutes. Alternatively, cook chicken strips according to package directions."
    },
    {
      "position": 3,
      "text": "Prepare chicken strips according to package directions, cooking until crispy. Cut chicken into bite-sized pieces."
    },
    {
      "position": 4,
      "text": "Meanwhile, prepare sauce. Combine butter, hot sauce, brown sugar and water in a medium saucepan. Bring mixture to a boil over medium-high heat, stirring occasionally. Reduce to a simmer and cook, stirring occasionally, until slightly thickened, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Divide lettuce, tomatoes, cheese, croutons and cranberries evenly among 4 dinner plates. Toss chicken with sauce and divide chicken among the four salads. Drizzle with ranch dressing and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

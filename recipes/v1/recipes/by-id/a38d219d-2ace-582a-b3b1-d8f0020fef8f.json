  "slug": "sangria-on-the-light-side",
  "name": "Sangria On The Light Side",
  "recipe_type": "drink",
  "brief_description": "Lots of citrus flavors and sliced fresh fruit make a refreshing red-wine sangria, and this recipe makes enough for a crowd.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In large pitcher or punch bowl, stir together juices, wine, and Sweet 'N Low until Sweet 'N Low dissolves; refrigerate until well chilled. Just before serving, add seltzer, orange wedges, lemon slices, and strawberry slices."
    }
  ],

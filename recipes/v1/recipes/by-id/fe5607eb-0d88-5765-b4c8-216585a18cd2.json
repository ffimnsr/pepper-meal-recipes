  "id": "fe5607eb-0d88-5765-b4c8-216585a18cd2",
  "slug": "loaded-biscuit-bomb-muffins-recipe-11845010",
  "name": "Loaded Biscuit Bomb Muffins",
  "recipe_type": "breakfast",
  "brief_description": "These loaded biscuit bomb muffins are filled with crisp bacon, Colby Jack cheese, and green onions, baked in muffin tins until fluffy and golden with a sprinkling of everything bagel seasoning.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line 16 wells of standard muffin tins with cupcake liners."
    },
    {
      "position": 2,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels; crumble when cool enough to handle."
    },
    {
      "position": 3,
      "text": "Carefully stretch each biscuit into a circle about 4 inches in diameter. Fill each one with 1 tablespoon bacon, 2 tablespoons cheese and 1 to 2 teaspoons green onions. Wrap edges of dough around fillings and pinch together to seal, forming a ball. Place each biscuit seam side down into prepared muffin tins."
    },
    {
      "position": 4,
      "text": "Brush the top of each biscuit with egg and sprinkle evenly with bagel seasoning."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden, 15 to 17 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

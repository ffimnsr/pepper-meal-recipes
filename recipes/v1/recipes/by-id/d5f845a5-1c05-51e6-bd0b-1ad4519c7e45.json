  "id": "d5f845a5-1c05-51e6-bd0b-1ad4519c7e45",
  "slug": "perfect-apple-chips",
  "name": "Perfect Apple Chips",
  "recipe_type": "appetizer",
  "brief_description": "Perfect for snacking on the go, these apple chips are soaked briefly in a lime mixture and sprinkled with sea salt.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 170 degrees F (77 degrees C). Line two baking sheets with parchment paper and lightly oil the paper."
    },
    {
      "position": 2,
      "text": "Stir lime juice, water, and sugar in a bowl until sugar is dissolved. Soak apple slices in lime juice mixture to combine flavors, 2 to 5 minutes. Drain and discard liquid."
    },
    {
      "position": 3,
      "text": "Arrange apple slices in a single layer about 1/8-inch apart on prepared baking sheets. Sprinkle with Fleur de Sel."
    },
    {
      "position": 4,
      "text": "Bake apples in the preheated oven until dried and crisp, about 4 hours. Cool completely before carefully peeling from the parchment."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 240,
  "preparation_time_minutes": 15,

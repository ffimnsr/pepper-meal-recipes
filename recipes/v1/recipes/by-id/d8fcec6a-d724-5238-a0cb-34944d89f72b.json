  "id": "d8fcec6a-d724-5238-a0cb-34944d89f72b",
  "slug": "crab-boil",
  "name": "Crab Boil",
  "recipe_type": "soup",
  "brief_description": "This classic crab boil with whole crab, fresh corn, sausage, onion, and red potatoes cooked in a seasoned broth makes a sensational seafood feast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Bring a large pot of water to a boil."
    },
    {
      "position": 2,
      "text": "Add potatoes, sausages, onions, corn, and seafood seasoning. Boil until potatoes are cooked through, about 30 minutes."
    },
    {
      "position": 3,
      "text": "Gently drop crabs into pot and boil until crabmeat is cooked through, at least 10 minutes."
    },
    {
      "position": 4,
      "text": "Drain and serve. Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,

  "id": "b63eafa5-b519-5cb4-9571-b621a202141a",
  "slug": "whipped-cream",
  "name": "Homemade Whipped Cream",
  "recipe_type": "dessert",
  "brief_description": "This whipped cream recipe shows you how to whisk heavy cream in an ice-cold bowl with confectioners' sugar to make a sweet cream that holds its shape.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Beat cream in a chilled glass or metal bowl with an electric mixer until frothy."
    },
    {
      "position": 3,
      "text": "Beat in confectioners' sugar and vanilla, continuing to beat, until soft peaks form."
    },
    {
      "position": 4,
      "text": "Enjoy!"
    }
  ],

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "a710c515-eb72-5d23-90f4-64d58014579e",
  "slug": "the-best-chicken-fried-steak",
  "name": "The Best Chicken Fried Steak",
  "recipe_type": "main",
  "brief_description": "This chicken fried steak recipe is a Southern favorite. It features crispy, breaded cube steaks drenched in a creamy gravy. It'll be a hit with everyone.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Place steaks between two sheets of heavy plastic on a solid, level surface; firmly pound with a meat mallet to a \u00bc-inch thickness."
    },
    {
      "position": 2,
      "text": "Place 2 cups flour in a shallow bowl."
    },
    {
      "position": 3,
      "text": "Combine baking powder, baking soda, 1 teaspoon pepper, and \u00be teaspoon salt in a separate shallow bowl; stir in buttermilk, egg, Tabasco, and garlic to combine."
    },
    {
      "position": 4,
      "text": "Heat shortening in a deep cast-iron skillet to 325 degrees F (165 degrees C). Place a wire rack over a sheet of parchment paper."
    },
    {
      "position": 5,
      "text": "Meanwhile, dredge 1 steak in flour to coat; shake off excess. Dip into buttermilk batter; lift up so excess batter drips back into the bowl. Dredge in flour again to coat both sides completely. Place breaded steak on the prepared wire rack. Repeat with remaining steaks."
    },
    {
      "position": 6,
      "text": "Fry steaks, in batches if necessary, until evenly golden brown, 3 to 5 minutes per side. Transfer steaks to a paper towel-lined plate to drain. Cover with foil to keep warm."
    },
    {
      "position": 7,
      "text": "Drain fat from the skillet, reserving \u00bc cup and as much solid remnants as possible."
    },
    {
      "position": 8,
      "text": "Place skillet over medium-low heat. Add reserved \u00bc cup oil; whisk in remaining \u00bc cup flour. Scrape the brown bits of food off the bottom of the skillet with a spatula."
    },
    {
      "position": 9,
      "text": "Stir in milk; increase heat to medium and bring gravy to a simmer. Cook, stirring often, until thick, 6 to 7 minutes. Season gravy with salt and black pepper."
    },
    {
      "position": 10,
      "text": "Transfer steaks to a platter; pour gravy over top."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

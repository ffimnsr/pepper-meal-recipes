  "id": "87215de3-a81d-5d17-a91f-bf854f2088bd",
  "slug": "lemon-panna-cotta",
  "name": "Lemon Panna Cotta",
  "recipe_type": "dessert",
  "brief_description": "Panna cotta, a classic Italian dessert, is flavored in this recipe with lemon zest and lemon juice. It's luscious, refreshing, and has a smooth and silky texture.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Place lemon juice in a small bowl and sprinkle the unflavored gelatin over it. Let stand for about 15 minutes until gelatin softens."
    },
    {
      "position": 2,
      "text": "Combine heavy cream, sugar, and 2 tablespoons lemon zest in a saucepan over medium-low heat; bring to a simmer. Whisk in gelatin mixture until dissolved. Remove from heat and stir in orange liqueur."
    },
    {
      "position": 3,
      "text": "Strain the cream mixture into a medium bowl and divide evenly among small glass bowls or ramekins."
    },
    {
      "position": 4,
      "text": "Place uncovered panna cottas into the refrigerator until set, at least 4 hours. If time permits, cover the bowls with plastic wrap and chill overnight."
    },
    {
      "position": 5,
      "text": "Garnish with remaining lemon zest before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

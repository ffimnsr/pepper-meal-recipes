  "slug": "jamocha-protein-shake-recipe-11853321",
  "name": "Jamocha Protein Shake",
  "recipe_type": "breakfast",
  "brief_description": "This jamocha protein shake with a protein boost from protein powder, high-protein milk, and vanilla frozen yogurt, is such a tasty copycat of the Arby's shake that it might just become a daily habit.",
  "cuisine": "American Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Combine espresso, protein powder, frozen yogurt, milk, cocoa powder, and vanilla extract in the jar of a blender; blend until smooth."
    },
    {
      "position": 2,
      "text": "Pour into a glass and top with whipped cream and a drizzle of chocolate syrup."
    }
  ],

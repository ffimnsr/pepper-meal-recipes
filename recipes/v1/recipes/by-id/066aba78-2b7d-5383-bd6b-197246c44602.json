  "id": "066aba78-2b7d-5383-bd6b-197246c44602",
  "slug": "fruit-salad-with-creamy-yogurt-dressing-recipe-11945491",
  "name": "Fruit Salad with Creamy Yogurt Dressing",
  "recipe_type": "salad",
  "brief_description": "This fruit salad with creamy yogurt dressing, made with brightly-colored seasonal fruit plus pineapple, looks and tastes fresh on any table. The dressing is a snap to whisk together.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "For dressing, combine Greek yogurt, orange juice concentrate, honey, and about 1 tablespoon reserved pineapple juice. Stir until well blended. Taste dressing and adjust; for sweeter dressing, add honey a teaspoon at a time. Add pineapple juice a tablespoon at a time for flavor or to loosen the dressing. Set aside."
    },
    {
      "position": 2,
      "text": "Combine pineapple, blueberries, strawberries, mango, banana, and kiwi in a bowl. Add in dressing, and toss."
    },
    {
      "position": 3,
      "text": "Place in a serving bowl or in individual bowls, garnish with mint leaves, if desired, and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

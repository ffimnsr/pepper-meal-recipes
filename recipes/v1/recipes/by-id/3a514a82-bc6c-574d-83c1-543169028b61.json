  "id": "3a514a82-bc6c-574d-83c1-543169028b61",
  "slug": "authentic-russian-salad-olivye",
  "name": "Authentic Russian Salad 'Olivye'",
  "recipe_type": "salad",
  "brief_description": "Authentic Russian salad recipe, aka olivye, made with boiled potatoes, carrot, and eggs mixed with pickles, ham, and peas in a mayonnaise dressing.",
  "cuisine": "Russian Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Bring a large pot of water to a boil."
    },
    {
      "position": 2,
      "text": "Add potatoes, bring to a boil, and cook for 5 to 10 minutes. Add carrots and whole eggs and continue boiling until potatoes are tender, 10 to 15 minutes."
    },
    {
      "position": 3,
      "text": "Drain and slightly cool mixture."
    },
    {
      "position": 4,
      "text": "Chop potatoes and carrot. Peel and chop eggs."
    },
    {
      "position": 5,
      "text": "Mix potatoes, carrot, eggs, pickles, peas, ham, and dill together in a large bowl."
    },
    {
      "position": 6,
      "text": "Stir in mayonnaise until salad is evenly coated."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

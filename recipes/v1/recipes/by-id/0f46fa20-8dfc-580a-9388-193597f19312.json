  "slug": "smores",
  "name": "S'mores",
  "recipe_type": "dessert",
  "brief_description": "S'mores are graham crackers with toasted marshmallows and chocolate that are prepared over an open flame for a deliciously simple camping treat!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat marshmallow over an open flame until it begins to brown and melt."
    },
    {
      "position": 3,
      "text": "Break graham cracker in half; sandwich chocolate between graham cracker and hot marshmallow. Allow marshmallow to cool a little before eating."
    }
  ],

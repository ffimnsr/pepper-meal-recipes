  "schema_version": 1,
  "id": "3b1fb249-41f4-5fea-b7c9-84b6f17df635",
  "slug": "roasted-leg-of-pork",
  "name": "Roasted Leg of Pork",
  "recipe_type": "main",
  "brief_description": "This succulent leg of pork is rubbed all over with seasoned olive oil and then oven-roasted to tender perfection. Each bite will melt in your mouth!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 430 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine olive oil, sage, garlic powder, onion powder, and salt in a small bowl."
    },
    {
      "position": 3,
      "text": "Rinse pork leg and pat dry with a paper towel. Rub seasoned olive oil all over pork leg."
    },
    {
      "position": 4,
      "text": "Slice onion and separate layers into rings. Place onion rings and garlic halves into the bottom of a roaster. Place pork on top of onion and garlic."
    },
    {
      "position": 5,
      "text": "Roast in the preheated oven for 40 minutes. Reduce oven temperature to 355 degrees F (180 degrees C) and continue roasting until an instant-read thermometer inserted into the center reads at least 145 degrees F (63 degrees C), about 1 hour 20 minutes more."
    },
    {
      "position": 6,
      "text": "Let pork rest for 5 minutes, then slice for serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

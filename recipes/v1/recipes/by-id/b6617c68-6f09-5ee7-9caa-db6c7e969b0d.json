  "id": "b6617c68-6f09-5ee7-9caa-db6c7e969b0d",
  "slug": "french-toast-ii",
  "name": "French Toast II",
  "recipe_type": "breakfast",
  "brief_description": "A simple French toast recipe that anyone can make. Use your favorite type of bread and serve with your favorite syrup.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large mixing bowl, beat the eggs. Add the milk, brown sugar and nutmeg; stir well to combine."
    },
    {
      "position": 2,
      "text": "Soak bread slices in the egg mixture until saturated."
    },
    {
      "position": 3,
      "text": "Heat a lightly oiled griddle or frying pan over medium high heat. Brown slices on both sides, sprinkle with cinnamon and serve hot."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,

  "id": "8a6bf999-a3b2-5eac-a772-41ec76ccf421",
  "slug": "sambusa",
  "name": "Sambusa",
  "recipe_type": "appetizer",
  "brief_description": "These Somalian sambusas feature spring roll wrappers filled with seasoned ground beef, onion, and leek for a popular fried, crispy Ramadan treat.",
  "cuisine": "East African African",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet over medium-low heat. Add onion, leek, and garlic; cook and stir until onion is transparent. Add ground beef; cook and stir until still slightly pink and about halfway done."
    },
    {
      "position": 3,
      "text": "Season with cumin, cardamom, salt, and pepper; mix well. Continue cooking until beef is browned and crumbly. Remove the skillet from heat."
    },
    {
      "position": 4,
      "text": "Mix flour and water together in a small bowl to make a thin paste. Using one wrapper at a time, fold into the shape of a cone."
    },
    {
      "position": 5,
      "text": "Fill cone with beef mixture, close the top, and seal with paste. Repeat until wrappers or filling are used up."
    },
    {
      "position": 6,
      "text": "Heat oil in a deep fryer or large saucepan to 365 degrees F (170 degrees C). There should be enough oil to submerge sambusas. Fry sambusas, a few at a time, in hot oil until golden brown."
    },
    {
      "position": 7,
      "text": "Remove to a paper towel-lined plate to drain."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

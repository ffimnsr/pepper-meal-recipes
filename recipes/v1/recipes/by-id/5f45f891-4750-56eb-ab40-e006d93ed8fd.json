  "id": "5f45f891-4750-56eb-ab40-e006d93ed8fd",
  "slug": "sheet-pan-greek-salad-nachos",
  "name": "Sheet Pan Greek Salad Nachos",
  "recipe_type": "salad",
  "brief_description": "These sheet pan Greek salad nachos come topped with chicken, olives, chickpeas, and a creamy yogurt sauce. Perfect for a party or easy dinner.",
  "cuisine": "Greek Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Toss together chickpeas, 2 teaspoons olive oil, 1/4 teaspoon kosher salt, and paprika on a small rimmed baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 15 minutes."
    },
    {
      "position": 4,
      "text": "While chickpeas bake, stir together tomatoes, cucumber, onion, parsley, lemon juice, 1 tablespoon plus 1 teaspoon olive oil, \u00bc teaspoon salt, 1 teaspoon vinegar, oregano, and 1/4 teaspoon pepper in a medium bowl; set aside."
    },
    {
      "position": 5,
      "text": "Stir together Greek yogurt, dill, garlic powder, remaining salt, remaining 1 teaspoon vinegar, remaining pepper, and 1 tablespoon olive oil. Set aside."
    },
    {
      "position": 6,
      "text": "Remove chickpeas from oven and set aside. Increase oven temperature to 450 degrees F (230 degrees C). Arrange pita chips on a large rimmed baking sheet. Top evenly with shredded chicken and feta cheese."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven just until the chicken is warmed through and the cheese begins to soften, about 4 minutes."
    },
    {
      "position": 8,
      "text": "Top nachos evenly with lettuce, chickpeas, tomato mixture, pepperoncini, and olives. Drizzle with yogurt sauce. Serve immediately."
    }
  ],
  "servings": 8,

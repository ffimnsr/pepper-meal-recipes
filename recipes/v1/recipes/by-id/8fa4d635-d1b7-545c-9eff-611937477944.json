  "schema_version": 1,
  "id": "8fa4d635-d1b7-545c-9eff-611937477944",
  "slug": "beef-enchilada-bake-recipe-8660926",
  "name": "Beef Enchilada Bake",
  "recipe_type": "main",
  "brief_description": "This beef enchilada bake with chili beans, bell pepper, and cheese is easy to assemble and bakes quickly enough to make a great family-friendly weeknight dinner.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium heat. Add olive oil, then add onions. Saut\u00e9 until onions just start to soften, 2 to 3 minutes. Add bell pepper; saut\u00e9 1 to 2 minutes. Add garlic and saut\u00e9 until fragrant, about 1 minute."
    },
    {
      "position": 3,
      "text": "Add ground beef; cook, breaking up beef with a spatula, until browned and crumbly, about 10 minutes. Drain any grease. Stir in chili beans. Season with salt, black pepper, and cumin. Stir in 1 cup enchilada sauce, reduce heat to medium-low, and simmer, uncovered, for 5 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, spread remaining enchilada sauce evenly in the bottom of a 10x8-inch baking dish."
    },
    {
      "position": 5,
      "text": "Using a sharp knife, carefully cut a straight edge off one side of the tortillas. Place 4 tortillas with the cut edge facing the sides of the dish."
    },
    {
      "position": 6,
      "text": "Spread half of the beef mixture over tortillas and top with 3 ounces cheese. Add another layer of tortillas, then beef mixture and 3 ounces cheese to create the second layer. Repeat layers ending with remaining cheese. Cover with foil."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven for 15 minutes. Remove foil; bake until cheese is lightly browned, 5 to 10 minutes more. Remove from the oven; allow to rest for 5 to 10 minutes before serving. Garnish with sour cream and chopped cilantro if desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

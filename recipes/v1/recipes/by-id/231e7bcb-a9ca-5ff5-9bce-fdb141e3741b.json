  "id": "231e7bcb-a9ca-5ff5-9bce-fdb141e3741b",
  "slug": "moms-favorite-baked-mac-and-cheese",
  "name": "Mom's Favorite Baked Mac and Cheese",
  "recipe_type": "main",
  "brief_description": "A creamy baked mac and cheese that is everything you want from a comforting, homemade, kid-pleasing mac and cheese recipe. Easy enough to make weekly.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt butter in a medium saucepan over medium heat. Saut\u00e9 onion for 2 minutes. Stir in flour and cook for 1 minute, stirring constantly."
    },
    {
      "position": 3,
      "text": "Then stir in milk, salt, mustard, and pepper. Cook, stirring frequently, until mixture boils and thickens."
    },
    {
      "position": 4,
      "text": "Meanwhile, bring a pot of lightly salted water to a boil. Add macaroni and cook until al dente, 8 to 10 minutes; drain."
    },
    {
      "position": 5,
      "text": "Add Cheddar and American cheeses to milk mixture; stir until cheese melts."
    },
    {
      "position": 6,
      "text": "Combine cheese sauce and macaroni in a 2-quart baking dish; mix well."
    },
    {
      "position": 7,
      "text": "Bake in preheated oven until hot and bubbly, about 30 minutes. Let cool 10 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

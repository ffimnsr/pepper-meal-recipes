  "id": "6d13cf91-ca32-54d5-8288-2250f72848e5",
  "slug": "easy-slow-cooker-tuna-casserole",
  "name": "Easy Slow Cooker Tuna Casserole",
  "recipe_type": "main",
  "brief_description": "This slow cooker tuna casserole with macaroni and mushrooms is creamy and cheesy with melt-in-your-mouth pasta.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spray a slow cooker with nonstick spray to coat."
    },
    {
      "position": 2,
      "text": "Combine milk, condensed soup, and garlic in the slow cooker. Stir in tuna, Cheddar cheese, then mushrooms. Add macaroni, season with salt and pepper, and stir to mix."
    },
    {
      "position": 3,
      "text": "Cover and cook on Low until pasta is very soft, 5 to 6 hours."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 300,
  "preparation_time_minutes": 10,

  "id": "9adbe3ad-29c4-5bbf-9993-413429d20b8d",
  "slug": "cold-gazpacho",
  "name": "Cold Gazpacho",
  "recipe_type": "soup",
  "brief_description": "There is nothing better than cold gazpacho on a hot summer day. Make sure you use really ripe tomatoes for this recipe--most of the flavor comes from them.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Set aside a few pieces of tomato, cucumber, and bell peppers for garnish."
    },
    {
      "position": 2,
      "text": "Combine remaining tomatoes, cucumber, and bell peppers with onion, jalapeno, and garlic in a food processor; process until all vegetable are finely chopped. Mix in olive oil, sherry vinegar, and salt."
    },
    {
      "position": 3,
      "text": "Cover and refrigerate until chilled, at least 1 hour."
    },
    {
      "position": 4,
      "text": "Season with pepper before serving and garnish with reserved tomatoes, cucumbers, and bell peppers."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,

  "slug": "easy-indian-curry-dip",
  "name": "Easy Indian Curry Dip",
  "recipe_type": "appetizer",
  "brief_description": "This easy mayo and sour cream dip is flavored with warm Indian spices like curry powder, turmeric, and cumin. It's perfect for serving with vegetable trays and assorted crackers.",
  "cuisine": "Indian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together mayonnaise, sour cream, curry powder, turmeric, onion, lemon juice, garlic salt, cumin, and cayenne in a bowl. Stir until well combined. Refrigerate for at least 30 minutes before serving."
    }
  ],
  "servings": 8,

  "id": "73625b8d-61d8-5e9d-8f40-8c3f7f224891",
  "slug": "shrimp-ceviche-baja-style",
  "name": "Shrimp Ceviche Baja Style",
  "recipe_type": "appetizer",
  "brief_description": "Baja-style shrimp ceviche includes so many delicious flavors, from celery and cilantro, to lime and jalapeno.",
  "cuisine": "U.S. Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Place shrimp in a single layer in a deep serving dish. Add a generous amount of salt and black pepper. Add lime juice and let sit until shrimp become white, about 30 minutes."
    },
    {
      "position": 2,
      "text": "Add onion and vinegar from the jalapeno peppers. Let sit 15 to 20 minutes more."
    },
    {
      "position": 3,
      "text": "Add jalapeno peppers, carrots, cucumber, celery, tomatoes, and cilantro. Let ceviche sit another 10 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 45,

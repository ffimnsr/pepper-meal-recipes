  "id": "f4cb0fb9-1045-5bc8-b423-21487cb25b5f",
  "slug": "grandmas-gingersnaps",
  "name": "Grandma's Gingersnaps",
  "recipe_type": "dessert",
  "brief_description": "A classic recipe for gingersnaps. These simple and quick cookies are easy to make and are a great last-minute treat that are a family-favorite.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Cream together 1 cup sugar and margarine until smooth. Beat in egg and molasses until well blended. Combine flour, baking soda, ginger, cinnamon, and salt; stir into molasses mixture to form a dough."
    },
    {
      "position": 3,
      "text": "Roll dough into 1-inch balls and roll the balls in remaining 1/2 cup sugar. Place cookies 2 inches apart onto ungreased cookie sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 8 to 10 minutes. Allow cookies to cool on the baking sheet for 5 minutes before removing to a wire rack to cool completely."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

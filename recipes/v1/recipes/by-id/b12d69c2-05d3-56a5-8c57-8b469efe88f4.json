  "id": "b12d69c2-05d3-56a5-8c57-8b469efe88f4",
  "slug": "a-pad-thai-worth-making",
  "name": "A Pad Thai Worth Making",
  "recipe_type": "main",
  "brief_description": "Make pad thai, the national noodle dish of Thailand, at home with this recipe. It can be adjusted to your taste to be as spicy or tart as you like.",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large bowl with hot tap water and place noodles in it to soak for 20 minutes."
    },
    {
      "position": 2,
      "text": "Stir together lime juice, chicken stock, fish sauce, lime juice, oyster sauce, sugar, and 2 teaspoons chile sauce in a small bowl. Set aside."
    },
    {
      "position": 3,
      "text": "Heat a wok or large skillet over high heat and add vegetable oil. When oil is hot, stir in garlic and cook for about 10 seconds. Add shrimp and chicken; cook, stirring constantly until shrimp is opaque and chicken is cooked through, 5 to 7 minutes."
    },
    {
      "position": 4,
      "text": "Move everything in the wok out to the sides and pour in eggs in the center. Cook and stir eggs until firm. Add noodles to the wok and pour in the sauce. Cook, stirring constantly, until noodles are tender. Add a bit more water if needed to finish cooking noodles."
    },
    {
      "position": 5,
      "text": "Stir in 3 cups bean sprouts, green onions, and remaining chile sauce. Remove from the heat and garnish with chopped peanuts. Taste for seasoning, adjusting the spice or lime juice if needed."
    },
    {
      "position": 6,
      "text": "Serve garnished with remaining 2 cups bean sprouts, fresh cilantro, and lime wedges on the side."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

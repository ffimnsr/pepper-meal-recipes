  "id": "316f3c87-1ec2-591e-bc4e-0bafec2eceeb",
  "slug": "easy-frozen-margaritas",
  "name": "Easy Frozen Margaritas",
  "recipe_type": "drink",
  "brief_description": "Enjoy this frozen margarita that's super simple to make with tequila, Cointreau, and frozen limeade for a quick and refreshing cocktail any time!",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Working in 2 batches, place 1 quart ice cubes in a blender. Add 1/2 can limeade, 6 ounces tequila and 2 tablespoons Cointreau. Blend at highest speed until drink is almost smooth. Pour into a pitcher and repeat with remaining ingredients. Store in the freezer."
    },
    {
      "position": 2,
      "text": "To salt the margarita glasses, pour a single layer of salt on a small plate. Moisten each glass rim with lime; dip each rim in the salt. Pour margaritas into each glass; garnish with lime. Serve immediately."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,

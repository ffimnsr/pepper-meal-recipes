  "id": "453c6099-2ceb-5e88-9b12-50f17850caa4",
  "slug": "okra-with-tomatoes",
  "name": "Stewed Okra with Tomatoes",
  "recipe_type": "side",
  "brief_description": "This stewed okra and tomatoes recipe is easy to make with 2 types of canned tomatoes for texture while garlic and cayenne turn up the heat!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Swirl olive oil in a skillet to cover the bottom; place over medium heat. Add onion, garlic, and cayenne pepper; cook and stir until fragrant, about 1 minute. Add green pepper and cook until tender, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir in frozen okra and cook for 5 minutes. Stir in both stewed and diced tomatoes, then season with salt and pepper. Reduce the heat to medium-low and simmer until all vegetables are heated through and tender, 5 to 7 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

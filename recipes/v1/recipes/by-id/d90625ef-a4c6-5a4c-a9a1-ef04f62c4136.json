  "id": "d90625ef-a4c6-5a4c-a9a1-ef04f62c4136",
  "slug": "maple-cider-slaw-with-air-fried-apples-and-potatoes-recipe-11793256",
  "name": "Maple-Cider Slaw with Air-Fried Apples and Potatoes",
  "recipe_type": "salad",
  "brief_description": "In this maple-cider slaw with air-fried apples and potatoes, crispy potatoes and tender apples complement a crunchy slaw tossed in a sweet, creamy dressing. While the potatoes and apples are in the air fryer, shred your cabbage and whisk up the dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) for 5 minutes. Toss potatoes with 2 teaspoons oil and 1/4 teaspoon each salt and pepper in a medium bowl. Transfer to air fryer basket. Cook for 8 minutes. Meanwhile, toss apples with 2 teaspoons oil in a bowl. Add to basket with potatoes; toss. Cook until potatoes are browned and tender, about 8 minutes more."
    },
    {
      "position": 2,
      "text": "For slaw, whisk together vinegar, maple syrup, remaining 1/4 cup oil and 1/4 teaspoon each salt and pepper in a large bowl. Add cabbage and toss to coat. Serve potatoes and apples with slaw."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

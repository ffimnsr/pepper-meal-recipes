  "id": "1008ed3b-dd61-506e-97d3-8a4775bc438a",
  "slug": "chantals-new-york-cheesecake",
  "name": "Chantal's New York Cheesecake",
  "recipe_type": "dessert",
  "brief_description": "This New York cheesecake recipe makes a rich, creamy, and smooth vanilla filling baked on a buttery graham cracker crust for an irresistible dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch springform pan."
    },
    {
      "position": 2,
      "text": "Mix graham cracker crumbs and melted butter together in a medium bowl until well combined."
    },
    {
      "position": 3,
      "text": "Press onto the bottom of the prepared pan to make a packed crust."
    },
    {
      "position": 4,
      "text": "Mix cream cheese and sugar together in a large bowl until smooth. Blend in milk, then mix in eggs, one at a time, until just combined."
    },
    {
      "position": 5,
      "text": "Add sour cream, flour, and vanilla; mix until smooth."
    },
    {
      "position": 6,
      "text": "Pour filling onto prepared crust. Bake in the preheated oven for 1 hour."
    },
    {
      "position": 7,
      "text": "Turn the oven off; let cheesecake cool in the oven with the door closed for 5 to 6 hours to prevent cracking. Chill in the refrigerator until serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,

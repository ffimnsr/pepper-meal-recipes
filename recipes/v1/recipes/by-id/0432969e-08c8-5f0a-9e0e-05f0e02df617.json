  "slug": "moms-best-waffles",
  "name": "Mom's Best Waffles",
  "recipe_type": "breakfast",
  "brief_description": "My mom makes the best waffles and I thought I'd share the recipe with the world!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, stir together flour, baking powder, sugar and salt. Add milk, eggs and oil; mix well."
    },
    {
      "position": 2,
      "text": "Spray preheated waffle iron with non-stick cooking spray. Pour mix onto hot waffle iron. Cook until golden brown."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

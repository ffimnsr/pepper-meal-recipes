  "id": "a2b8b97c-f52a-5047-a57f-417cd60df42e",
  "slug": "cranberry-brie-wreath-recipe-11839029",
  "name": "Cranberry Brie Wreath",
  "recipe_type": "appetizer",
  "brief_description": "This cranberry brie wreath is a real showpiece on your holiday table. It's sweet and savory all in one and so pretty decked out in holiday colors.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Freeze Brie until firm enough to slice easily, 30 minutes. Thinly slice Brie. Keep refrigerated until ready to assemble."
    },
    {
      "position": 3,
      "text": "Line an extra-large baking sheet with parchment paper. Trace a 6-inch round in the center of the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Unroll and separate crescent roll dough. Arrange crescent dough triangles with the short ends against the edge of the round, overlapping so you have a sun shape. One package of crescent rolls will complete the first layer, then the second package will be layered over the first, with the long ends alternating between the previous layer. Press dough lightly where it overlaps to seal."
    },
    {
      "position": 5,
      "text": "Spread mustard on the center of the ring, top with cranberry sauce, then the Brie and top with pecans."
    },
    {
      "position": 6,
      "text": "Take each crescent point, lift over the filling, and tuck under the bottom of the wreath."
    },
    {
      "position": 7,
      "text": "Brush water over the crescent dough. Sprinkle with poppy seeds."
    },
    {
      "position": 8,
      "text": "Bake until golden brown, about 20 minutes. Serve warm or at room temperature."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

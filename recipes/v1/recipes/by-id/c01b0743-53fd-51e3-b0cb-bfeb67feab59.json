  "id": "c01b0743-53fd-51e3-b0cb-bfeb67feab59",
  "slug": "baba-ghanoush",
  "name": "Baba Ghanoush",
  "recipe_type": "appetizer",
  "brief_description": "Baba ghanoush (or baba ganoush) is a smoky Middle Eastern roasted eggplant dip with garlic, tahini, and lemon that's easy to make for a delicious appetizer.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a baking sheet."
    },
    {
      "position": 2,
      "text": "Place eggplant on the prepared baking sheet, and pierce holes in the skin with a fork. Roast in the preheated oven, turning occasionally, until very soft and tender, 30 to 40 minutes. Set eggplant aside until cool enough to handle; slice in half and scoop flesh into a colander or fine mesh sieve over a bowl; drain for 5 minutes."
    },
    {
      "position": 3,
      "text": "Place eggplant, lemon juice, tahini, sesame seeds, and garlic in blender, and puree. Season with salt and pepper to taste."
    },
    {
      "position": 4,
      "text": "Transfer eggplant mixture to a medium size mixing bowl, and slowly mix in olive oil. Refrigerate the baba ghanoush until completely chilled before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

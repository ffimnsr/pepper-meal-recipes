  "id": "78145a3f-bf25-5907-8362-ba9cb7ff0b65",
  "slug": "easy-buffalo-chicken-dip",
  "name": "Easy Buffalo Chicken Dip",
  "recipe_type": "appetizer",
  "brief_description": "Converting the idea of Buffalo-style chicken wings to a dip that can be served with chips, crackers, or vegetables is the genesis of this recipe perfectly tailored to your next football-watching party or even Oscars night!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir together blue cheese salad dressing and cream cheese in a mixing bowl until smooth. Stir in chicken, Buffalo wing sauce, and blue cheese crumbles; pour chicken mixture into a baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until bubbling, 15 to 20 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

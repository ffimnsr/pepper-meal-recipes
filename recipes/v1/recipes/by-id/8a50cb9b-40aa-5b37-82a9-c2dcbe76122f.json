  "id": "8a50cb9b-40aa-5b37-82a9-c2dcbe76122f",
  "slug": "gourmet-mushroom-risotto",
  "name": "Gourmet Mushroom Risotto",
  "recipe_type": "side",
  "brief_description": "This creamy mushroom risotto with two types of mushrooms, Arborio rice, shallots, and white wine makes a rich and hearty Italian main dish or side.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Warm broth in a saucepan over low heat. Meanwhile, warm 2 tablespoons olive oil in a deep-sided large saucepan over medium-high heat. Add sliced portobello and white mushrooms; cook and stir until soft, about 3 minutes. Remove mushrooms and their liquid to a bowl; set aside."
    },
    {
      "position": 3,
      "text": "Add remaining 1 tablespoon olive oil to the saucepan. Stir in shallots and cook for 1 minute. Add rice; cook and stir until rice is coated with oil and pale, golden in color, about 2 minutes."
    },
    {
      "position": 4,
      "text": "Pour in wine, stirring constantly until wine is fully absorbed. Add \u00bd cup warm broth to the rice, and stir until the broth is absorbed."
    },
    {
      "position": 5,
      "text": "Continue adding broth, \u00bd cup at a time, stirring constantly, until the liquid is absorbed and the rice is tender, yet firm to the bite, about 15 to 20 minutes."
    },
    {
      "position": 6,
      "text": "Remove from heat. Stir in reserved mushrooms and their liquid, Parmesan cheese, butter, and chives; season with salt and pepper."
    },
    {
      "position": 7,
      "text": "Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

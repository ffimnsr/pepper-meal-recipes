{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "7d3bb8a8-a6a2-59e1-9785-442a5d0ae041",
  "slug": "pumpkin-cheesecake-cookies-recipe-7972485",
  "name": "Pumpkin Cheesecake Cookies",
  "recipe_type": "dessert",
  "brief_description": "Pumpkin cheesecake cookies stuffed with a deliciously creamy cheesecake filling are rolled in sugar and pumpkin pie spice for a fabulous fall treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Line one tray and one baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Beat cream cheese, powdered sugar, and 1/2 teaspoon vanilla in a medium bowl with an electric mixer on medium-high speed until thoroughly combined."
    },
    {
      "position": 3,
      "text": "Scoop cream cheese using a tablespoon or a well-rounded 2 teaspoon scoop (#70) onto the prepared tray. You should have 18 mounds. Freeze filling mounds until frozen solid, 1 hour."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spread canned pumpkin evenly out on a plate into a 4-inch square."
    },
    {
      "position": 5,
      "text": "Press pumpkin with a paper towel to extract excess moisture. Repeat blotting with a new paper towel, until very little moisture is being soaked up by the towel, about 6 times. Set aside."
    },
    {
      "position": 6,
      "text": "Stir flour, 2 teaspoons pumpkin pie spice, baking soda, and salt together in a medium mixing bowl; set aside."
    },
    {
      "position": 7,
      "text": "Beat butter with an electric mixer on medium to high speed in a large bowl for 30 seconds."
    },
    {
      "position": 8,
      "text": "Add brown sugar and 1/4 cup white sugar. Beat until combined, scraping sides of bowl occasionally."
    },
    {
      "position": 9,
      "text": "Add pumpkin, and remaining 1 teaspoon vanilla; beat until combined."
    },
    {
      "position": 10,
      "text": "Using a wooden spoon, stir in flour mixture."
    },
    {
      "position": 11,
      "text": "Mix remaining 1/4 cup white sugar and 1 teaspoon pumpkin pie spice together in a small bowl ."
    },
    {
      "position": 12,
      "text": "Use a 1 \u00bd tablespoon cookie scoop (#40) or rounded measuring tablespoon to portion cooking dough into 18 pieces."
    },
    {
      "position": 13,
      "text": "To shape each cookie, pat a portion of the dough into a 2 \u00bd- to 3-inch circle in the palm of your hand."
    },
    {
      "position": 14,
      "text": "Place a frozen ball of the cream cheese mixture into the middle of the cookie dough, pressing the dough around the filling, then rolling with your hands to form a ball."
    },
    {
      "position": 15,
      "text": "Roll ball in sugar and pumpkin pie spice mixture, then place on prepared baking sheet, about 3 inches apart. Repeat with remaining dough and filling. Bake the first batch in the preheated oven until cookies are set, about 12 minutes. (Chill shaped cookies while the first batch is baking.)"
    },
    {
      "position": 16,
      "text": "Let cookies cool briefly on the baking sheet."
    },
    {
      "position": 17,
      "text": "Transfer cookies to wire racks to cool completely. Place remaining cookies on parchment-lined baking sheet and bake and cool as directed."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 15,

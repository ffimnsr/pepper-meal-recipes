  "id": "07e744b6-d3ae-586b-bc2b-2bc41825cb17",
  "slug": "sensational-strawberry-shortcake",
  "name": "Sensational Strawberry Shortcake",
  "recipe_type": "dessert",
  "brief_description": "This sensational strawberry shortcake recipe makes a pretty layered strawberry dessert with sweetened cream that really hits the spot on a summer day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Lightly grease two 9-inch round cake pans. Set aside."
    },
    {
      "position": 2,
      "text": "Gently stir strawberries and \u00bd cup sugar together in a large bowl; chill."
    },
    {
      "position": 3,
      "text": "Combine flour, \u00bc cup sugar, baking powder, salt, and nutmeg in a large bowl; cut in butter with a knife or pastry blender until mixture resembles coarse crumbs. Whisk milk and egg yolks together in a medium bowl until well combined; stir into flour mixture until just moistened. Divide dough in half; pat into the prepared cake pans."
    },
    {
      "position": 4,
      "text": "Beat egg whites until stiff peaks form; spread evenly over dough in pans. Sprinkle with remaining \u00bc cup sugar."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden, 40 to 45 minutes. Cool 10 minutes; transfer to a wire rack to cool completely."
    },
    {
      "position": 6,
      "text": "Place 1 cake layer on a large serving plate; spread with \u00bd whipped cream, spoon \u00bd strawberries over cream. Repeat with remaining each 1 cake layer, \u00bd whipped cream, and \u00bd strawberries; garnish with mint."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

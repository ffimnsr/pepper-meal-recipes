  "id": "5b99fc1b-ea10-5a17-8dea-71e6f3b1a57a",
  "slug": "upside-down-cookies",
  "name": "Upside Down Cookies",
  "recipe_type": "dessert",
  "brief_description": "A festive layered cookie with cinnamon. Easy and delicious cookies!!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease a muffin pan."
    },
    {
      "position": 2,
      "text": "In a medium bowl, stir together flour, sugar, baking powder, and cream of tartar. Cut in shortening until mixture resembles coarse crumbs. Sprinkle on the milk, and stir to mix. Place dough on a floured surface and knead for about ten strokes. Too much kneading will toughen up the dough. Divide the dough in half."
    },
    {
      "position": 3,
      "text": "In a small bowl, mix together the brown sugar and cinnamon. On a floured surface, roll out 1/2 of the dough at a time to a 12x10 inch rectangle. Brush with the melted butter, and sprinkle the cinnamon mixture evenly over the dough. Cut the rectangle into 5 strips 12 x 2 inches each. Stack the strips on top of one another, and cut the stack into 2 inch squares. Place the squares, layered side down, into the muffin cups. Bake in the preheated oven for 10 to 12 minutes."
    },
    {
      "position": 4,
      "text": "In a small bowl, stir together the confectioners' sugar and milk until smooth. When cookies come out of the oven, drizzle the icing on."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,

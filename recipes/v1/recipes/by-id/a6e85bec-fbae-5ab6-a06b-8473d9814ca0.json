  "id": "a6e85bec-fbae-5ab6-a06b-8473d9814ca0",
  "slug": "philly-cheese-steak-soup",
  "name": "Philly Cheese Steak Soup",
  "recipe_type": "soup",
  "brief_description": "This Philly cheese steak soup combines everything you love about the sandwich in a creamy, hearty soup with roast beef, provolone cheese, peppers, and onion.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a large, heavy-bottomed pot or Dutch oven over medium heat. Add onion, bell pepper, and mushrooms; cook and stir until tender, about 5 minutes. Add flour; cook and stir until flour golden, about 5 minutes more."
    },
    {
      "position": 3,
      "text": "Gradually whisk in milk; bring to a simmer. Cook until thickened, stirring often, about 5 minutes. Reduce heat to medium-low. Add beef consomm\u00e9; season soup with salt and black pepper."
    },
    {
      "position": 4,
      "text": "Slowly stir in provolone cheese until melted, 3 to 5 minutes. Off heat, stir in roast beef."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

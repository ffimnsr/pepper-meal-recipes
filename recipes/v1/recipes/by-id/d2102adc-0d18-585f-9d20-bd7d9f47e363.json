  "slug": "cranberry-raspberry-sauce",
  "name": "Cranberry Raspberry Sauce",
  "recipe_type": "side",
  "brief_description": "This raspberry and cranberry sauce is enriched with red wine for a wonderful sauce that goes well with turkey at Thanksgiving or goose at Christmas.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Put cranberries, raspberries, Merlot, and sugar in a large saucepan. Bring to a boil, stirring occasionally. Use a whisk to mash cranberries. Reduce heat and simmer for 15 minutes."
    },
    {
      "position": 2,
      "text": "Serve hot or pour sauce into a container and refrigerate to serve cold."
    }
  ],

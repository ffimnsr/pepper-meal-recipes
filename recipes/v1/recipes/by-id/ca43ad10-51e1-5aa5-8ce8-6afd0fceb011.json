  "id": "ca43ad10-51e1-5aa5-8ce8-6afd0fceb011",
  "slug": "easy-mcgriddle-casserole-recipe-8623338",
  "name": "Easy McGriddle Casserole",
  "recipe_type": "dessert",
  "brief_description": "This easy McGriddle casserole combines complete pancake mix, bacon, and sausage into one easy bake\u2014sweet, savory and oh-so-good.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat. Cook and stir sausage in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain and discard grease. Set aside to cool slightly."
    },
    {
      "position": 3,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned and crisp, about 10 minutes. Drain bacon slices on paper towels. Crumble when cool enough to handle."
    },
    {
      "position": 4,
      "text": "Whisk together pancake mix and water until well combined. Stir in maple syrup. Add sausage, bacon, and cheese and fold the mixture together until well incorporated. Pour mixture into prepared baking dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until casserole is lightly browned, and a toothpick inserted near the center comes out clean, about 30 minutes."
    },
    {
      "position": 6,
      "text": "Spread butter over hot casserole and serve with extra syrup as desired."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

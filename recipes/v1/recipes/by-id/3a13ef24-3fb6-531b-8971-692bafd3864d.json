  "slug": "whole-wheat-zucchini-herb-bread",
  "name": "Whole Wheat Zucchini Herb Bread",
  "recipe_type": "main",
  "brief_description": "This whole wheat zucchini herb bread recipe creates a savory wheat loaf flecked with crunchy sesame seeds, fragrant rosemary, and deep green zucchini.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place water, oil, honey, zucchini, bread flour, wheat flour, basil, sesame seeds, salt, and yeast in the pan of a bread machine or follow the order recommended by the manufacturer if different."
    },
    {
      "position": 2,
      "text": "Run basic bread or normal cycle. Remove loaf from the machine after the cycle is done, about 3 hours."
    }
  ],

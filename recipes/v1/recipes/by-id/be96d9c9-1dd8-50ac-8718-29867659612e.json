  "id": "be96d9c9-1dd8-50ac-8718-29867659612e",
  "slug": "birthday-bones",
  "name": "Birthday Bones",
  "recipe_type": "dessert",
  "brief_description": "These cookies are great for your favorite furry friend. Every dog I have given these to loves them. It is nice to use doggie type cookie cutters, like bones or fire hydrants.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease cookie sheets. Stir together the flour and baking powder; set aside."
    },
    {
      "position": 2,
      "text": "In a medium bowl, mix together the peanut butter and milk. Stir in the flour mixture until well blended. Turn out dough onto a lightly floured surface and knead until smooth. Roll out to 1/4 inch thickness and cut into shapes using cookie cutters. Place 2 inches apart onto the prepared cookie sheets."
    },
    {
      "position": 3,
      "text": "Bake for 20 minutes in the preheated oven, or until lightly brown. Remove from cookie sheets to cool on wire racks."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

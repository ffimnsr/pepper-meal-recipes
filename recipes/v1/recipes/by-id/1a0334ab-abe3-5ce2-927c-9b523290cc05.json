  "id": "1a0334ab-abe3-5ce2-927c-9b523290cc05",
  "slug": "easy-rhubarb-pie",
  "name": "Easy Rhubarb Pie",
  "recipe_type": "dessert",
  "brief_description": "This easy rhubarb pie recipe has a sweet crumb topping and a tart custard filling--it's perfect for a special spring dessert.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix white sugar, 2 tablespoons flour, egg, and vanilla in a small bowl until combined."
    },
    {
      "position": 3,
      "text": "Place 3/4 cup flour, brown sugar, and butter in another small bowl; mix until crumbly."
    },
    {
      "position": 4,
      "text": "Place rhubarb into pie crust. Pour white sugar mixture over the rhubarb. Sprinkle with brown sugar mixture."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until filling is bubbly and crust is golden brown, 30 to 40 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "5c02cacb-bb10-5013-a3ac-367eb6b64e8f",
  "slug": "authentic-german-potato-salad",
  "name": "Authentic German Potato Salad",
  "recipe_type": "salad",
  "brief_description": "Bacon gives this warm German potato salad recipe a boost of flavor. Vinegar and sugar in the dressing are the perfect combination of salty and sweet.",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place potatoes in a large pot and add water to cover by at least 1 to 2 inches; bring to a boil. Cook until potatoes are easily pierced with a fork, about 10 minutes. Drain, and set aside to cool."
    },
    {
      "position": 3,
      "text": "While the potatoes are cooking, place bacon in a large, deep skillet over medium-high heat. Fry until browned and crisp, 10 to 12 minutes, turning as needed. Transfer bacon to a paper towel-lined plate and crumble when cool enough to handle. Leave bacon grease in the skillet."
    },
    {
      "position": 4,
      "text": "Cook onion in the bacon grease over medium heat until browned, 6 to 8 minutes. Add vinegar, sugar, water, salt, and pepper to the pan and bring to a boil."
    },
    {
      "position": 5,
      "text": "Once boiling, add potatoes, and 1/2 of the crumbled bacon. Cook until heated through, 3 to 4 minutes."
    },
    {
      "position": 6,
      "text": "Transfer warm potato salad to a serving dish and sprinkle remaining crumbled bacon over top. Garnish with parsley and serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

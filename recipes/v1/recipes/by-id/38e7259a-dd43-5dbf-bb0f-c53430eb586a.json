  "id": "38e7259a-dd43-5dbf-bb0f-c53430eb586a",
  "slug": "salmon-stir-fry-recipe-7644799",
  "name": "Salmon Stir-Fry",
  "recipe_type": "main",
  "brief_description": "You'll love this salmon stir-fry if you love veggies. It's loaded with broccoli and peppers, and tossed in hoisin sauce with delicious salmon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a cast iron skillet over medium-high heat. Season salmon with a sprinkle of salt and pepper."
    },
    {
      "position": 2,
      "text": "Cook salmon until fish flakes easily with a fork, 3 to 5 minutes on each side. Remove from skillet and set aside."
    },
    {
      "position": 3,
      "text": "Heat sesame oil in a wok or heavy skillet over high heat. Add red pepper, yellow pepper, onion, broccoli, garlic, and ginger paste, and cook and stir for 3 minutes."
    },
    {
      "position": 4,
      "text": "Stir in hoisin sauce and toss well. Add salmon, and flake it with a fork into chunks. Toss; remove from heat. Add carrots and serve over rice."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

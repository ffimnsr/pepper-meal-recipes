  "slug": "miso-soup-with-shiitake-mushrooms",
  "name": "Miso Soup with Shiitake Mushrooms",
  "recipe_type": "soup",
  "brief_description": "This delicious Japanese soup features with Shiitake mushrooms and tofu.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Heat vegetable broth to a boil in a saucepan. Add mushrooms; reduce heat to low, and simmer 4 minutes."
    },
    {
      "position": 2,
      "text": "Whisk miso paste and soy sauce together in a small bowl; stir into broth along with tofu and continue cooking 1 minute more. Divide soup among bowls; top with green onions to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,

  "id": "ac17223e-e5b0-58ee-ac0f-37c099fc6d07",
  "slug": "homemade-black-bean-veggie-burgers",
  "name": "Homemade Black Bean Veggie Burgers",
  "recipe_type": "main",
  "brief_description": "This black bean burger recipe with veggies and spices is easy to make and so flavorful \u2014 you'll never want to eat frozen veggie burgers again!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for high heat. Lightly coat a sheet of aluminum foil with cooking spray."
    },
    {
      "position": 2,
      "text": "Mash black beans in a medium bowl with a fork until thick and pasty."
    },
    {
      "position": 3,
      "text": "Finely chop bell pepper, onion, and garlic in a food processor. Stir chopped vegetables into mashed beans."
    },
    {
      "position": 4,
      "text": "Combine egg, chili powder, cumin, and chili sauce in a small bowl; stir into mashed bean mixture to combine. Mix in bread crumbs until mixture is sticky and holds together."
    },
    {
      "position": 5,
      "text": "Divide mixture into four patties; place on the prepared foil."
    },
    {
      "position": 6,
      "text": "Grill on the preheated grill for about 8 minutes on each side."
    },
    {
      "position": 7,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

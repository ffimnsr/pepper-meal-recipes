  "slug": "rice-cooker-rice-pudding",
  "name": "Rice Cooker Rice Pudding",
  "recipe_type": "dessert",
  "brief_description": "Cook rice pudding in a rice cooker in under 30 minutes with four simple ingredients: milk, rice, sugar, and cinnamon, then chill and serve it cold.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir 5 1/2 cups milk, rice, sugar, and cinnamon together in a rice cooker. Cover and cook for one cycle until tender and creamy, about 20 minutes. Stir in remaining 2 1/2 cups milk."
    },
    {
      "position": 2,
      "text": "Transfer to a bowl and let cool to room temperature, about 30 minutes. Cover and refrigerate for 1 to 2 hours before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,

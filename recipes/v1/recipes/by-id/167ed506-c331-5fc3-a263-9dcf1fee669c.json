  "id": "167ed506-c331-5fc3-a263-9dcf1fee669c",
  "slug": "spicy-chicken-jerky-in-the-air-fryer",
  "name": "Spicy Chicken Jerky in the Air Fryer",
  "recipe_type": "appetizer",
  "brief_description": "This spicy chicken jerky recipe is made in the air fryer and flavored with mojo criollo marinade and Cajun seasoning.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken strips, marinade, and Cajun seasoning in a resealable plastic bag. Refrigerate for 8 hours to overnight."
    },
    {
      "position": 2,
      "text": "Measure skewers to fit across the air fryer basket, slightly overlapping the edge. Trim off excess length."
    },
    {
      "position": 3,
      "text": "Preheat the air fryer to 180 degrees F (80 degrees C) for 10 minutes."
    },
    {
      "position": 4,
      "text": "Thread chicken strips onto skewers, leaving room in between each strip, while the air fryer is preheating."
    },
    {
      "position": 5,
      "text": "Air fry for 1 hour 15 minutes. Adjust cooking time as most air fryers have a maximum setting of 30 minutes. Rearrange the skewers during the reset time."
    },
    {
      "position": 6,
      "text": "Increase temperature to 200 degrees F (95 degrees C) and air fry for an additional 15 minutes."
    },
    {
      "position": 7,
      "text": "Remove strips to a paper towel-lined storage container. Seal. Allow to rest overnight before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "hard",

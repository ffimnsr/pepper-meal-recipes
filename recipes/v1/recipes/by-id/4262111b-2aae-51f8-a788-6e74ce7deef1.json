  "id": "4262111b-2aae-51f8-a788-6e74ce7deef1",
  "slug": "air-fryer-pakoras",
  "name": "Air Fryer Pakoras",
  "recipe_type": "appetizer",
  "brief_description": "These air fryer pakoras made with chopped cauliflower, potatoes, onion, chickpea flour, and spices are cooked with less oil for a crisp appetizer.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together cauliflower, chickpea flour, potatoes, water, red onion, salt, garlic, curry powder, coriander, cayenne pepper, and cumin in a large bowl until well combined. Set batter aside to rest for 10 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the air fryer to 350 degrees F (175 degrees C). Grease the basket of the air fryer with cooking spray."
    },
    {
      "position": 3,
      "text": "Spoon 2 tablespoons batter into the prepared basket and flatten. Repeat this as many times as the basket space allows without the pakoras touching. Mist the top of each pakora with cooking spray."
    },
    {
      "position": 4,
      "text": "Cook in the preheated air fryer for 8 minutes. Flip and cook for 8 more minutes. Transfer pakoras to a paper towel-lined plate. Repeat steps 3 and 4 with remaining batter."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

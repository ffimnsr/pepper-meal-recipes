  "schema_version": 1,
  "id": "0862aad2-cb05-5021-a258-36bb67f33fc2",
  "slug": "jalapeno-popper-chicken-baked-ziti",
  "name": "Jalapeno Popper Chicken Baked Ziti",
  "recipe_type": "main",
  "brief_description": "This mashup dish combines jalapeno poppers, chicken, and ziti in a creamy pasta sauce with 4 kinds of cheese in a nice departure from traditional baked ziti.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken breasts, chicken broth, salt, pepper, onion flakes, oregano, and garlic for shredded chicken in a medium slow cooker, making sure chicken is completely covered by broth."
    },
    {
      "position": 2,
      "text": "Cook until chicken is no longer pink in the center, on Low for 5 to 6 hours or on High for 3 to 4 hours."
    },
    {
      "position": 3,
      "text": "Thirty minutes before chicken is finished cooking, preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 4,
      "text": "Bring a large pot of lightly salted water to a boil. Add ziti and cook, stirring occasionally, until tender yet firm to the bite, about 11 minutes. Drain and set aside."
    },
    {
      "position": 5,
      "text": "While ziti is cooking, prepare filling: fry bacon, jalapenos, and onion in a small skillet over medium-high heat until onions are tender and bacon is browned, 5 to 7 minutes. Remove from the heat and transfer to a small mixing bowl with cream cheese, mozzarella, Parmesan, and mayonnaise; mix until well combined."
    },
    {
      "position": 6,
      "text": "Remove chicken from the slow cooker and place into a large bowl; use 2 forks to shred chicken into small pieces. Add cooked ziti and Alfredo sauce; mix well."
    },
    {
      "position": 7,
      "text": "Pour 1/2 of the chicken-ziti mixture into the prepared baking dish and sprinkle pepper Jack cheese in an even layer over top. Spread jalapeno popper filling evenly across the dish. Pour remaining chicken-ziti mixture into the dish, and sprinkle 1/2 cup mozzarella over top."
    },
    {
      "position": 8,
      "text": "Mix crushed crackers, Parmesan cheese, and butter for topping together in a small bowl; sprinkle over the pasta dish."
    },
    {
      "position": 9,
      "text": "Bake in the preheated oven until cheese is melted and just barely starts to turn golden, 25 to 30 minutes. Remove from the oven and serve immediately."
    }
  ],
  "servings": 12,

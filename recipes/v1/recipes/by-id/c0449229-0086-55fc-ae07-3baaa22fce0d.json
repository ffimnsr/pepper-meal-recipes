  "id": "c0449229-0086-55fc-ae07-3baaa22fce0d",
  "slug": "funky-frito-fruckies",
  "name": "Funky Frito Fruckies",
  "recipe_type": "dessert",
  "brief_description": "Anytime I can find a mixture of salt and chocolate, I jump on it. These cookies/candies are rich but wonderful. If you are not a big fan of chocolate, or want these a little less sweet, leave the chocolate off.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "In a greased 10 x 15 inch pan, place the corn chips."
    },
    {
      "position": 3,
      "text": "In a saucepan, bring the sugar and corn syrup to a boil over medium heat. Remove from heat and stir in the peanut butter until smooth."
    },
    {
      "position": 4,
      "text": "Pour the mixture over the chips and smooth level."
    },
    {
      "position": 5,
      "text": "Place the chocolate bars in a single layer over the hot mixture and wait a few minutes until the heat melts them and then smooth the chocolate out to form a thin layer."
    },
    {
      "position": 6,
      "text": "Allow to cool and then break into pieces."
    }
  ],
  "servings": 18,

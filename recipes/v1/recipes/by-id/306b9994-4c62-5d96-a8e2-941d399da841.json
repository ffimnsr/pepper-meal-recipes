  "slug": "whipped-feta-sandwich-recipe-7488575",
  "name": "Whipped Feta Sandwich",
  "recipe_type": "main",
  "brief_description": "This tasty whipped feta sandwich is loaded with fresh veggies. The feta spread is delicious in a sandwich, and also as a dip, or spread on crackers or crostini.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place feta, cream cheese, olive oil, and red wine vinegar in a food processor and process until smooth. Stir in black olives and green olives until well incorporated."
    },
    {
      "position": 2,
      "text": "Evenly spread the feta mixture on 2 slices of bread, and layer with butter lettuce, tomatoes, cucumber, and red onion. Top with the 2 remaining bread slices, and press down, making a sandwich. Slice the sandwiches and serve."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 0,

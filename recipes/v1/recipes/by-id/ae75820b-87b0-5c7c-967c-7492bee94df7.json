  "id": "ae75820b-87b0-5c7c-967c-7492bee94df7",
  "slug": "peanut-butter-fudge",
  "name": "Peanut Butter Fudge",
  "recipe_type": "dessert",
  "brief_description": "Evaporated milk, peanut butter and marshmallow creme are the signature ingredients in this fudge.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Grease an 8x8 inch dish."
    },
    {
      "position": 2,
      "text": "In a medium saucepan over medium heat, combine milk, sugar and butter. Bring to a rolling boil, and let boil 5 minutes. Remove from heat and stir in peanut butter, marshmallow creme and vanilla until well incorporated. Spread into prepared dish. Let cool completely before cutting into squares."
    }
  ],

  "slug": "party-punch-iv",
  "name": "Party Punch IV",
  "recipe_type": "drink",
  "brief_description": "Vodka mixed with pineapple juice, orange juice and lemon-lime soda has a great tasting, fruity flavor. A real crowd pleaser.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a punch bowl, combine pineapple juice concentrate, orange juice concentrate and vodka. Pour in lemon-lime soda. Float cherries and orange slices on top. Add ice before serving."
    }
  ],

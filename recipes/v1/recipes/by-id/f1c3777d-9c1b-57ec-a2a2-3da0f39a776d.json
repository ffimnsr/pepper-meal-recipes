  "id": "f1c3777d-9c1b-57ec-a2a2-3da0f39a776d",
  "slug": "crispy-buffalo-shrimp",
  "name": "Crispy Buffalo Shrimp",
  "recipe_type": "appetizer",
  "brief_description": "This baked crispy Buffalo shrimp recipe combines deep-fried shrimp with the flavors of buffalo wings and ranch dipping sauce for a crowd-pleasing appetizer.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a deep fryer or large saucepan to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk flour, lemon pepper seasoning, baking powder, salt, garlic powder, and cayenne pepper together in a bowl. Whisk eggs and milk together in a separate bowl."
    },
    {
      "position": 3,
      "text": "Pat shrimp dry with paper towels. Dip shrimp in egg mixture, then dredge in flour mixture to evenly coat. Transfer shrimp to a baking sheet in a single layer until ready to fry; sprinkle remaining flour to fully cover as needed."
    },
    {
      "position": 4,
      "text": "Carefully lower shrimp, in batches of 8 to 10, into the hot oil; fry until golden brown and cooked through on the inside, about 5 minutes. Transfer to a baking sheet lined with paper towels. Repeat with remaining shrimp."
    },
    {
      "position": 5,
      "text": "Toss shrimp with hot sauce in a large bowl until completely coated."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "9f9a37b9-c8bf-5201-9b5d-6dec637bf87f",
  "slug": "fat-free-refried-beans",
  "name": "Fat-Free Refried Beans",
  "recipe_type": "snack",
  "brief_description": "These fat-free refried beans are simple to make on the stovetop with pantry staples for a quick and delicious meal with tacos or as a snack spread.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Mash 2/3 cup beans in a small bowl to a smooth paste; set aside."
    },
    {
      "position": 2,
      "text": "Place remaining beans and water in a medium saucepan over medium heat. Cook at a simmer until heated through. Stir in garlic, pepper, salt, and liquid smoke."
    },
    {
      "position": 3,
      "text": "Stir bean paste into whole beans until well combined. Add onion and simmer until onion is slightly cooked, about 10 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

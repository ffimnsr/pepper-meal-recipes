  "id": "e58bb893-2654-534f-94f5-98ae6872e5ab",
  "slug": "instant-pot-roasted-brussels-sprouts",
  "name": "Instant Pot Roasted Brussels Sprouts",
  "recipe_type": "soup",
  "brief_description": "These Instant Pot Brussels sprouts are roasted with olive oil, onion, and broth until tender-crisp for a quick and delicious vegetable side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select Saut\u00e9 function. Heat olive oil in the pot; cook and stir onion in hot oil until translucent, about 2 minutes. Add Brussels sprouts and cook for 1 minute more. Sprinkle with salt and pepper; pour vegetable broth over Brussels sprouts. Close and lock the lid. Select high pressure according to manufacturer's instructions; set the timer for 3 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 2,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

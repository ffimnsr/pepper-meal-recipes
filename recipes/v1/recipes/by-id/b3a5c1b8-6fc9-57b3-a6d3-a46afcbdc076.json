  "id": "b3a5c1b8-6fc9-57b3-a6d3-a46afcbdc076",
  "slug": "no-fail-pie-crust-iii",
  "name": "Foolproof Pie Crust",
  "recipe_type": "dessert",
  "brief_description": "A rich pie crust recipe which you just can't mess up! All you need is flour, cold butter, an egg, and cold water to make 4 single crusts.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir flour and salt together in a large bowl. Cut in butter until mixture resembles pea-sized chunks."
    },
    {
      "position": 2,
      "text": "Place egg and vinegar in a measuring cup and add cold water to measure 1/2 cup of total liquid; pour into flour mixture and mix just until the dough can be made into a large ball."
    },
    {
      "position": 3,
      "text": "Divide dough into four equal portions. Wrap in plastic and store in the refrigerator."
    }
  ],
  "servings": 24,

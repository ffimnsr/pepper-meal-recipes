  "id": "a9d34561-a847-55e4-af63-ff2761df4706",
  "slug": "venison-gyros",
  "name": "Venison Gyros",
  "recipe_type": "main",
  "brief_description": "These venison gyros are made with strips of venison marinated in cumin, marjoram, and oregano for an interesting twist on the classic Greek sandwich.",
  "cuisine": "Greek Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk olive oil, cumin, garlic, vinegar, oregano, marjoram, rosemary, salt, and pepper together in a large glass or ceramic bowl. Add venison strips and toss to evenly coat. Cover the bowl with plastic wrap and marinate in the refrigerator for at least 2 hours."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat. Working in batches of 1/2 pound at a time, add venison and cook until browned on the outside and no longer pink on the inside, about 8 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C)."
    },
    {
      "position": 3,
      "text": "Pile onto warmed pitas to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

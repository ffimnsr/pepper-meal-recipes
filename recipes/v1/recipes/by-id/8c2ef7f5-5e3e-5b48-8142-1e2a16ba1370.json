  "id": "8c2ef7f5-5e3e-5b48-8142-1e2a16ba1370",
  "slug": "grilled-teriyaki-chicken-tenders",
  "name": "Grilled Teriyaki Chicken Tenders",
  "recipe_type": "main",
  "brief_description": "This recipe for marinated grilled chicken tenders has been passed down for generations, but updated to lower the sugar and sodium content.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Whisk soy sauce, water, vinegar, brown sugar, ginger, garlic, and Worcestershire sauce together in a bowl and pour into a 1-gallon resealable plastic bag. Add chicken tenders, coat with the marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator for at least 1 hour, or up to 4 hours."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Remove chicken from the marinade and shake off excess. Discard the remaining marinade."
    },
    {
      "position": 4,
      "text": "Place chicken on the grill and cook until no longer pink in the center and the juices run clear, 3 to 4 minutes per side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

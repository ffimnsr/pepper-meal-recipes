  "id": "7bfe45f5-c252-5abd-90ce-4bac8a6fc0b2",
  "slug": "french-fried-potatoes",
  "name": "French Fried Potatoes",
  "recipe_type": "drink",
  "brief_description": "These homemade French fries are soaked in a sugar solution before frying until crisp and golden for an easy, crowd-pleasing side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir together warm water and sugar in a medium bowl. Soak potatoes in the sugar mixture for 15 minutes."
    },
    {
      "position": 3,
      "text": "Remove potatoes from water and dry thoroughly on paper towels. Heat oil in a deep fryer to 375 degrees F (190 degrees C)."
    },
    {
      "position": 4,
      "text": "Fry potatoes in hot oil until golden, 5 to 6 minutes. Drain on paper towels and season with salt."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "e0d33540-85d8-584c-afcc-ec69de6d43e3",
  "slug": "kimchi-corned-beef",
  "name": "Kimchi Corned Beef",
  "recipe_type": "main",
  "brief_description": "Chef John introduces kimchi to Irish corned beef and cabbage, infusing braised vegetables and lean beef with bold, spicy flavors while adding some Seoul to St. Patrick's Day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour 1 jar of kimchi into a pot. Top with corned beef and cover with the second jar of kimchi. Pour in water. Cover and bring to a simmer over high heat. Reduce heat to low. Cook, covered, until fork-tender, 2 to 3 hours. Flip over the beef occasionally and drape kimchi back on top."
    },
    {
      "position": 2,
      "text": "Remove corned beef to a bowl. Bring kimchi mixture back to a simmer over high heat. Add potatoes, carrots, and celery. Cover, reduce heat to medium-low, and cook until almost tender, 20 to 25 minutes. Reduce heat to low and add beef back in. Cover and cook on low until meat is heated through, about 15 minutes. Taste the broth and add water as needed."
    },
    {
      "position": 3,
      "text": "Slice corned beef thinly and serve in a bowl with the vegetables; spoon some broth on top."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 165,
  "preparation_time_minutes": 20,

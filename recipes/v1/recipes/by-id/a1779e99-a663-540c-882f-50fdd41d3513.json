  "id": "a1779e99-a663-540c-882f-50fdd41d3513",
  "slug": "mediterranean-salmon-baked-in-parchment-recipe-8768509",
  "name": "Mediterranean Salmon Baked in Parchment",
  "recipe_type": "main",
  "brief_description": "This Mediterranean salmon baked in parchment is a lovely fish dish, ideal for a special occasion. It\u2019s served with a mushroom, roasted pepper, artichoke, and wine pan sauce.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Place each salmon fillet on a sheet of parchment."
    },
    {
      "position": 2,
      "text": "Melt 2 tablespoons butter and brush over salmon. Combine panko, pecans, garlic salt, and 1/2 teaspoon Greek seasoning in a small bowl and stir together. Evenly sprinkle over salmon fillets."
    },
    {
      "position": 3,
      "text": "Crimp and fold parchment around fillets to form a packet. Place packets on a rimmed baking tray."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until salmon flakes easily with a fork, about 25 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, for sauce, heat grapeseed oil in a skillet over medium heat. Add mushrooms and cook, stirring, for about 3 minutes. Stir in artichoke hearts, remaining 1/2 teaspoon Greek seasoning and pepper, and continue to cook and stir for about 6 minutes. Pour in white wine. Biring to a simmer and cook until liquid is reduced by half, about 10 minutes."
    },
    {
      "position": 6,
      "text": "Add roasted bell pepper, and cook, stirring, until peppers are warmed through, about 1 minute. Stir in remaining butter to melt, about 1 minute more."
    },
    {
      "position": 7,
      "text": "Carefully peel back parchment from salmon and ladle sauce over the salmon."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

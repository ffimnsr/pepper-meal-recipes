  "id": "e2ee22d1-c6b2-56a8-b96c-dec0b95876d4",
  "slug": "asparagus-salad-with-lemon-vinaigrette-recipe-11994883",
  "name": "Asparagus Salad with Lemon Vinaigrette",
  "recipe_type": "salad",
  "brief_description": "Fresh asparagus takes center stage in this crisp side dish with a vibrant lemon vinaigrette, creamy feta cheese, juicy tomatoes, and hard-boiled eggs. Bright, colorful, and packed with flavor, it\u2019s an easy upgrade to any meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine lemon juice, Dijon, and garlic in a small bowl. Add olive oil, and whisk until thoroughly combined. Season to taste with salt and freshly ground black pepper."
    },
    {
      "position": 2,
      "text": "Bring a large pot of water to a boil. Add asparagus, and cook for 1 minute. If your spears are thick, you can leave them in a little longer, just be sure to not overcook. They should be crisp to the bite."
    },
    {
      "position": 3,
      "text": "Drop asparagus into a bowl of ice water. Once completely cold, drain asparagus and diagonally slice the spears into 1-1/2 to 2 inch pieces. Place on a paper towel to dry."
    },
    {
      "position": 4,
      "text": "Combine asparagus, tomatoes, red onion, and feta in a large bowl. Drizzle the dressing over the salad, and gently toss until well coated. Serve with hard boiled egg wedges, if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 1,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "7c746967-1f3d-5117-ba28-1d25d4b713e3",
  "slug": "hoy-lai-pad-nam-prik-pow-clams-with-chili-paste-and-basil",
  "name": "Hoy Lai Pad Nam Prik Pow (Clams with Chili Paste and Basil)",
  "recipe_type": "appetizer",
  "brief_description": "Clams are cooked with chile oil and fresh Thai basil in this quick and easy recipe.",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large heavy-bottomed pan or wok over high heat; add the oil and wait 1 minute more. Mix garlic into the hot oil and cook until it just turns golden brown, about 1 minute. Add clams and chile paste; stir until clams are coated."
    },
    {
      "position": 2,
      "text": "Stir fish sauce, chiles, and sugar into clams; cook and stir until the clams have opened, 5 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Mix basil into clam mixture and cook until wilted, about 1 minute."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

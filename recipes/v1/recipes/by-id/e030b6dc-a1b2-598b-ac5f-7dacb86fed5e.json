  "id": "e030b6dc-a1b2-598b-ac5f-7dacb86fed5e",
  "slug": "vegetarian-mexican-lasagna",
  "name": "Vegetarian Mexican Lasagna",
  "recipe_type": "main",
  "brief_description": "Mexican-inspired ingredients are layered lasagna-style with a ricotta and spinach mixture between corn tortillas in this vegetarian baked dish.",
  "cuisine": "Tex Mex Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet over medium heat. Add onion, jalapenos, bell pepper, and garlic; cook and stir until onion is translucent, 5 to 7 minutes. Reduce heat to medium-low and add salsa, black beans, corn, chili powder, and cumin. Bring to a simmer; let simmer for 5 minutes."
    },
    {
      "position": 3,
      "text": "Combine 2 cups pepper Jack cheese, ricotta cheese, spinach, egg, salt, and pepper in a bowl."
    },
    {
      "position": 4,
      "text": "Place 6 corn tortillas in the bottom of the prepared baking dish. Add 1/2 of the vegetable mixture using a slotted spoon, followed by 1/2 of the cheese and spinach mixture. Add a layer of 6 tortillas and follow with remaining vegetables and remaining cheese mixture. Top with remaining tortillas. Spread enchilada sauce across the top and remaining pepper Jack cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese is melted and bubbly, 45 minutes to 1 hour."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "005b7611-7912-56e5-a38c-a6e39749c5d2",
  "slug": "egyptian-lentil-soup",
  "name": "Egyptian Lentil Soup",
  "recipe_type": "soup",
  "brief_description": "This aromatic and hearty lentil soup is spiced with cumin and coriander for a light, yet filling meal.",
  "cuisine": "Egyptian",
  "instructions": [
    {
      "position": 1,
      "text": "Place 3 cups water, lentils, tomato, carrot, onion, garlic, and chicken bouillon in a stockpot over medium heat; cook until vegetables and lentils are softened, 20 to 25 minutes. Remove from heat and cool to lukewarm."
    },
    {
      "position": 2,
      "text": "Blend vegetable and lentil mixture with an immersion blender until smooth. Stir 1 cup water, cumin, sea salt, pepper, and coriander into soup; heat over medium heat until warmed."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,

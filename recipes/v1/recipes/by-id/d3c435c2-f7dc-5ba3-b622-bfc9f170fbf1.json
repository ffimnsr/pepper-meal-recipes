{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "d3c435c2-f7dc-5ba3-b622-bfc9f170fbf1",
  "slug": "creamy-pasta-with-mushrooms-and-peas-recipe-8638085",
  "name": "Creamy Pasta with Mushrooms and Peas",
  "recipe_type": "main",
  "brief_description": "This creamy pasta with mushrooms and peas is such an easy dish to make, and it\u2019s packed with savory flavor.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of salted water to a boil. Add farfalle and cook until tender with a bite, about 11 minutes, stirring occasionally. Drain pasta, reserving 1/2 cup of pasta water to thin the sauce later if needed."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat a large skillet over medium heat. Add bacon; cook, turning occasionally, until crisp, 3 to 5 minutes. Transfer bacon to a paper towel to drain. When cool enough to handle, crumble and set aside. Remove bacon grease from skillet."
    },
    {
      "position": 3,
      "text": "Heat oil and butter in the skillet over medium heat; add mushrooms and onions. Cook until onions are translucent and the moisture in mushrooms is starting to evaporate, 3 to 5 minutes, stirring occasionally. Stir in garlic, and cook until fragrant, about 30 seconds."
    },
    {
      "position": 4,
      "text": "Reduce heat to low, stir in half-and-half, peas, and thyme. Bring to a gentle simmer, and cook until peas are heated through and sauce has started to thicken, 3 to 4 minutes. If sauce is too thick, add a little reserved pasta water to thin."
    },
    {
      "position": 5,
      "text": "Stir in lemon juice and season to taste with salt and pepper. Sprinkle with Parmesan cheese, garnish with crumbled bacon and chopped parsley, and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "c57375b0-5087-5d21-81cb-b1c0860b3252",
  "slug": "slow-cooker-hoisin-chicken-recipe-11881916",
  "name": "Slow Cooker Hoisin Chicken",
  "recipe_type": "main",
  "brief_description": "Use your slow cooker to make this easy hoisin chicken recipe at home. A flavorful, classic Chinese dish that i",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together hoisin sauce, soy sauce, honey, ginger, garlic, and crushed red pepper in a 3 1/2- to 4-quart slow cooker until well combined."
    },
    {
      "position": 2,
      "text": "Add chicken and stir to coat in the sauce."
    },
    {
      "position": 3,
      "text": "Cover and cook on Low 5 to 6 hours or on High 2 1/2 to 3 hours, until an instant-read thermometer inserted into the thickest part of the chicken thighs reads at least 165 degrees F ( 74 degrees C)."
    },
    {
      "position": 4,
      "text": "Stir together water and cornstarch in a small bowl. Stir cornstarch mixture into the slow cooker along with red bell pepper and sugar snap peas."
    },
    {
      "position": 5,
      "text": "Cover and cook on High for 15 minutes, or until the sauce has thickened slightly and vegetables are crisp-tender."
    },
    {
      "position": 6,
      "text": "Serve the chicken and vegetables over rice. Garnish with green onions and sesame seeds."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 315,
  "preparation_time_minutes": 15,

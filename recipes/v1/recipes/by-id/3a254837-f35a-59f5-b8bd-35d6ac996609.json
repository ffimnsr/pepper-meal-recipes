  "id": "3a254837-f35a-59f5-b8bd-35d6ac996609",
  "slug": "beef-and-beet-borscht",
  "name": "Beef and Beet Borscht",
  "recipe_type": "soup",
  "brief_description": "This beef borscht is Chef John's version of the Russian and Polish soup with beets and cabbage simmered in a homemade broth made from bone-in shank.",
  "cuisine": "Russian Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Cook beef shank in a large soup pot over high heat until browned, about 3 minutes per side. Add water, onion, carrots, celery, and bay leaf; bring to a simmer and cook until meat is tender and falling off the bone, about 4 hours. Strain broth and discard solids."
    },
    {
      "position": 2,
      "text": "Combine beef broth, beets, and cabbage in the same pot; cook, stirring occasionally, until beets are tender, about 30 minutes. Reduce heat to low; add vinegar, salt, and black pepper."
    },
    {
      "position": 3,
      "text": "Serve soup in bowls garnished with sour cream and dill."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 285,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

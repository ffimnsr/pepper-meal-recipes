  "id": "6843eabf-47dd-54b6-8aa7-a6c213430288",
  "slug": "orange-honey-garlic-chicken",
  "name": "Orange Honey Garlic Chicken",
  "recipe_type": "dessert",
  "brief_description": "This recipe covers chicken in a slightly sweet, slightly tangy, herbed honey garlic chicken marinade that will have you coming back for seconds.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "To make the marinade, combine soy sauce, honey, orange juice, garlic, oregano, pepper, and paprika. Mix all together and pour over chicken pieces. Refrigerate for 2 to 4 hours."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Remove chicken from refrigerator. Place chicken and marinade in a 9x13-inch baking dish and bake, uncovered, in preheated oven for 1 1/2 hours. Baste once."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 90,

  "id": "abaed9c4-688f-5adf-a963-46a4753fc8ea",
  "slug": "ultimate-turkey-brine",
  "name": "Simple Turkey Brine",
  "recipe_type": "main",
  "brief_description": "A simple turkey brine made with brown sugar and spices is the key to having a moist, juicy, and delicious Thanksgiving turkey to impress your family.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring water to a boil in a large stockpot."
    },
    {
      "position": 3,
      "text": "Stir in salt and brown sugar until dissolved; return to a boil."
    },
    {
      "position": 4,
      "text": "Add bay leaves, peppercorns, rosemary, thyme, and cloves. Reduce heat to medium-low and simmer for 15 to 20 minutes."
    },
    {
      "position": 5,
      "text": "Remove from the heat and let cool completely before using."
    },
    {
      "position": 6,
      "text": "Place thawed turkey into a large non-reactive container. Pour in cooled brine."
    },
    {
      "position": 7,
      "text": "Pour in enough cool water to cover turkey with liquid. Refrigerate 8 to 12 hours."
    },
    {
      "position": 8,
      "text": "Remove turkey from brine and let sit on counter for about 2 hours."
    },
    {
      "position": 9,
      "text": "Follow your favorite recipe to cook your turkey."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

  "id": "f9d53838-7153-545f-999f-b239bd68a997",
  "slug": "brown-sugar-bacon-waffles",
  "name": "Brown Sugar Bacon Waffles",
  "recipe_type": "breakfast",
  "brief_description": "These waffles with bacon and brown sugar are perfect for those lazy weekend mornings when you wake up late but still have time to cook breakfast!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray a baking sheet with cooking spray."
    },
    {
      "position": 2,
      "text": "Arrange bacon on the prepared baking sheet, and sprinkle with 2 tablespoons brown sugar. Bake in the preheated oven until bacon is crispy and brown sugar is caramelized, 10 to 15 minutes."
    },
    {
      "position": 3,
      "text": "Immediately remove bacon to a cutting board; cut into small pieces and set aside."
    },
    {
      "position": 4,
      "text": "Preheat a waffle iron."
    },
    {
      "position": 5,
      "text": "Whisk flour, 1/2 cup brown sugar, baking powder, baking soda, and salt together in a large bowl. Beat eggs, buttermilk, vegetable oil, and vanilla together in a separate bowl; fold wet mixture into flour mixture. Add bacon and stir, being careful to not over mix."
    },
    {
      "position": 6,
      "text": "Spray the preheated waffle iron with cooking spray. Ladle batter into waffle iron and cook until golden brown; serve hot."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

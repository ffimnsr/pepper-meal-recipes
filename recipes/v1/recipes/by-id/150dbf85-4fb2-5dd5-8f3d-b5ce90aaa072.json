  "id": "150dbf85-4fb2-5dd5-8f3d-b5ce90aaa072",
  "slug": "classic-beef-stuffed-peppers",
  "name": "Classic Beef Stuffed Peppers",
  "recipe_type": "main",
  "brief_description": "Stuffed red bell peppers are filled with savory beef and rice and baked with prepared spaghetti sauce for a hearty dish that doesn't need a lot of preparation.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of water to a boil. Reduce heat to medium; add bell peppers and cook until slightly softened, about 5 minutes. Drain and rinse with cold water."
    },
    {
      "position": 3,
      "text": "Combine 3 cups spaghetti sauce, eggs, rice, onion, Worcestershire sauce, salt, and black pepper together in a bowl. Crumble in ground beef; stir until thoroughly combined."
    },
    {
      "position": 4,
      "text": "Place peppers in a large baking dish, top-sides up; fill with beef mixture. Pour remaining 2 cups spaghetti sauce over peppers. Cover dish with aluminum foil."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until peppers tender, filling set, and an instant-read thermometer inserted into middle of peppers reads at least 160 degrees F (70 degrees C), 55 to 60 minutes. Top each pepper with 1 tablespoon cheese."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

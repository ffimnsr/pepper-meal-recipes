  "id": "b659ae7a-de00-52ae-830c-e575478f7449",
  "slug": "pie-crust-treats",
  "name": "Pie Crust Treats",
  "recipe_type": "dessert",
  "brief_description": "This is a fun rainy day treat for the kids to make. They might need a bit of help rolling the dough, but the rest will be a snap for small hands. The pastry is cut into fun shapes, spread with softened butter and sprinkled with cinnamon sugar. They 're in and out of the oven within ten minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)"
    },
    {
      "position": 2,
      "text": "Roll out pie crust to 1/8 inch thick. Spread butter or margarine to cover. Sprinkle sugar and cinnamon to completely cover pie crust."
    },
    {
      "position": 3,
      "text": "Using a ravioli cutter, cookie cutter or knife, cut dough into desired shapes."
    },
    {
      "position": 4,
      "text": "Bake at 350 degrees F (175 degrees C) for 8 to 10 minutes or until just browned."
    }
  ],
  "servings": 14,

  "id": "dd628a5e-2d65-5805-a5eb-13ea4833e122",
  "slug": "easy-baking-powder-drop-biscuits",
  "name": "Easy Baking Powder Drop Biscuits",
  "recipe_type": "breakfast",
  "brief_description": "This easy drop biscuit recipe is made with a handful of pantry and fridge staples. Whip up a batch while you make your favorite sausage gravy!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 450 degrees F (230 degrees C). Lightly grease a baking sheet."
    },
    {
      "position": 2,
      "text": "Mix flour, sugar, baking powder, and salt together in a large bowl. Cut in cold butter with a knife or pastry blender until the mixture resembles coarse crumbs."
    },
    {
      "position": 3,
      "text": "Stir in milk, a little at a time, until dough is moistened."
    },
    {
      "position": 4,
      "text": "Drop dough by heaping spoonfuls onto the prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden, 12 to 15 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

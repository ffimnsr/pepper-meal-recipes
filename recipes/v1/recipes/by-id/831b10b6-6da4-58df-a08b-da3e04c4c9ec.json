  "id": "831b10b6-6da4-58df-a08b-da3e04c4c9ec",
  "slug": "protein-waffles",
  "name": "Protein Waffles",
  "recipe_type": "breakfast",
  "brief_description": "The waffles you\u2019ll get from this recipe for healthy, protein-packed waffles are fluffy and delicious! Top \u2018em however you like your waffles topped!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a waffle iron according to manufacturer\u2019s instructions."
    },
    {
      "position": 2,
      "text": "Blend oats, cottage cheese, eggs, egg whites, honey, vanilla extract, and cinnamon in a blender until creamy."
    },
    {
      "position": 3,
      "text": "Ladle batter into preheated waffle iron according to manufacturer directions and cook the waffles until golden and crisp, about 5 minutes. Repeat until entire batch of batter is used."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

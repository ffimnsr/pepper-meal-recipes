  "id": "aaa707a5-9313-5f69-875c-d25bd768ff1a",
  "slug": "90-second-keto-bread-in-a-mug",
  "name": "90-Second Keto Bread in a Mug",
  "recipe_type": "breakfast",
  "brief_description": "Try keto bread is microwaved quickly and easily with only 5 ingredients in 90 seconds! This bread is so tasty and perfect for sandwiches and toast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Microwave butter in a microwave-safe mug until melted, about 15 seconds. Swirl the mug to coat with butter."
    },
    {
      "position": 2,
      "text": "Add almond flour, egg, baking powder, and salt to the mug; whisk until smooth."
    },
    {
      "position": 3,
      "text": "Microwave on high until set, about 90 seconds. Let cool for 2 minutes before slicing."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 2,

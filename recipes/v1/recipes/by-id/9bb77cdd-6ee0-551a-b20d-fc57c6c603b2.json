  "id": "9bb77cdd-6ee0-551a-b20d-fc57c6c603b2",
  "slug": "ham-chowder",
  "name": "Ham Chowder",
  "recipe_type": "soup",
  "brief_description": "Ham and bacon add a smoky taste, while cream gives this ham and potato chowder a rich texture. The recipe stars leeks, onions, garlic, rosemary, and carrots.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Heat stock in a large pot over medium heat; bring to a simmer. Stir in ham and 2 tablespoons rosemary."
    },
    {
      "position": 2,
      "text": "Cook bacon, stirring occasionally, in a large skillet over medium heat until crisp. Use a slotted spoon to transfer bacon to the pot. Discard 1/2 of the bacon grease; reserve remaining grease in the skillet."
    },
    {
      "position": 3,
      "text": "Return the skillet to medium heat. Stir in leeks, onions, green onions, and garlic; cook until tender, then add to the pot."
    },
    {
      "position": 4,
      "text": "Add potatoes, carrots, and remaining 2 tablespoons rosemary to the pot; simmer until vegetables are tender, about 20 minutes."
    },
    {
      "position": 5,
      "text": "Remove the pot from heat; stir in cream until incorporated."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,

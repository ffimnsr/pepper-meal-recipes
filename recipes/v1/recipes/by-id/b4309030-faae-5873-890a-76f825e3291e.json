  "id": "b4309030-faae-5873-890a-76f825e3291e",
  "slug": "vegan-black-bean-quesadillas",
  "name": "Vegan Black Bean Quesadillas",
  "recipe_type": "main",
  "brief_description": "These vegan black bean quesadillas replace the cheese with pur\u00e9ed great Northern beans, nutritional yeast, and spices for a Mexican-inspired meal.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Blend great Northern beans, 3/4 cup tomatoes, and garlic in a food processor until smooth. Add nutritional yeast, cumin, chili powder, salt, and cayenne pepper and blend until combined."
    },
    {
      "position": 2,
      "text": "Transfer bean mixture to a large bowl. Stir in black beans and remaining 1/4 cup tomatoes."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a large skillet over medium-high heat. Place a tortilla in hot oil. Spread about 1/4 cup filling over tortilla. Place another tortilla on top of filling; cook until filling is warmed, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Spray the top tortilla with cooking spray and flip quesadilla to cook the second side until lightly browned, 3 to 5 minutes. Repeat with remaining tortillas and filling."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

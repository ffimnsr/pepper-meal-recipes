  "slug": "worlds-easiest-bread-machine-pizza-dough",
  "name": "World's Easiest Bread Machine Pizza Dough",
  "recipe_type": null,
  "brief_description": "This pizza dough has cilantro, paprika, basil, and oregano for an herb-flavored crust.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Put the water, olive oil, sugar, sea salt, flour, garlic, oregano, basil, black pepper, cilantro, paprika, and dry yeast into the pan of a bread machine individually in order as listed. Select Dough cycle; press Start. Let dough rest 5 to 30 minutes before using; the longer it rests, the thicker the crust."
    }
  ],
  "servings": 4,

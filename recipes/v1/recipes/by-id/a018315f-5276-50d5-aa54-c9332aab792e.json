  "id": "a018315f-5276-50d5-aa54-c9332aab792e",
  "slug": "fresh-strawberry-upside-down-cake",
  "name": "Fresh Strawberry Upside-Down Cake",
  "recipe_type": "dessert",
  "brief_description": "This upside-down strawberry cake is so easy to make with boxed cake mix, strawberries, strawberry gelatin, and marshmallows for a fab summer dessert.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Spread crushed strawberries on the bottom of a 9x13-inch baking dish; sprinkle gelatin powder over strawberries, then top with mini marshmallows."
    },
    {
      "position": 3,
      "text": "Combine cake mix, water, eggs, and oil in a large bowl; beat with an electric mixer on low speed until moistened. Increase speed to medium and beat for 2 minutes. Pour batter on top of marshmallows."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 40 to 50 minutes."
    },
    {
      "position": 5,
      "text": "Cool cake in the pan for 15 minutes. Run a knife around edges, then turn out the cake onto a serving plate, strawberry side up. Store cake in the refrigerator."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,

  "id": "14bca645-5ecc-500b-8343-7e3c63a158da",
  "slug": "citrus-ceviche",
  "name": "Citrus Ceviche",
  "recipe_type": "appetizer",
  "brief_description": "My take on the classic Peruvian ceviche. The acidity of the citrus fruit 'cooks' the fish. A nice refreshing meal on a hot summer day. It's imperative to use only freshly caught fish!",
  "cuisine": "Peruvian South American American",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium non-reactive bowl combine the lemon juice, lime juice, ginger and olive oil. Add the bass and toss to coat. Cover and marinate in the refrigerator for about 2 hours. The flesh of the fish should be white and opaque."
    },
    {
      "position": 2,
      "text": "Add the cilantro, onion and avocado. Season to taste with salt and pepper, toss and serve with hard cooked egg wedges."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,

  "id": "92e0bff6-1f5a-51bd-a024-4ada71759aee",
  "slug": "healthier-banana-banana-bread",
  "name": "Healthier Banana Banana Bread",
  "recipe_type": "appetizer",
  "brief_description": "Moist and packed with banana flavor, the healthier version of this bread uses less butter and replaces it with non-fat yogurt.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x5-inch loaf pan."
    },
    {
      "position": 2,
      "text": "Whisk flour, baking soda, and salt together in a large bowl; set aside."
    },
    {
      "position": 3,
      "text": "Beat brown sugar, butter, and yogurt together in a separate large bowl with an electric mixer until light and fluffy. The mixture should be noticeably lighter in color. Add eggs, one at a time, beating well after each addition. Stir in mashed bananas until well blended; add to flour mixture and stir just to moisten. Transfer batter to prepared loaf pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 60 to 65 minutes. Let bread cool in pan for 10 minutes, then turn out onto wire rack to cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "e412ac5d-139d-5adf-b44a-4268edb7edb9",
  "slug": "beef-and-sausage-fried-wontons",
  "name": "Beef and Sausage Fried Wontons",
  "recipe_type": "appetizer",
  "brief_description": "Crispy rolled wonton wrappers are filled with an Asian spiced beef and sausage filling and fried to perfection. Delicious dipped in Asian sweet chile sauce.",
  "cuisine": "Asian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat the egg white and water together in a small bowl; set aside. Lightly mix the ground beef, sausage, 1 tablespoon sweet chile sauce, five-spice powder, garlic powder, green onion, and salt and pepper. Place about 1 teaspoonful of the meat mixture onto a wonton wrapper with one corner facing you. Fold in the left and right corners of the wrapper to slightly overlap the filling, then tightly roll the lower corner up to create a pocket around the filling. Continue rolling until just the tip of the remaining corner is visible; brush the corner with the egg white mixture to seal."
    },
    {
      "position": 2,
      "text": "Heat oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Fry the egg rolls in the hot oil in batches until golden brown, 3 to 5 minutes. Drain on a paper towel-lined plate. Serve with 1/2 cup of sweet chili sauce."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 40,
  "rest_time_minutes": null,
  "difficulty": "medium",

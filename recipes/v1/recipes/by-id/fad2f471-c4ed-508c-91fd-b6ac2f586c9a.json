  "id": "fad2f471-c4ed-508c-91fd-b6ac2f586c9a",
  "slug": "mango-pudding-flan-de-mango",
  "name": "Mango Pudding (Flan de Mango)",
  "recipe_type": "dessert",
  "brief_description": "Try this sweet, custard-like dessert for a real Latin American experience.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Fill a large, shallow baking pan with about 1 1/2 inches water."
    },
    {
      "position": 2,
      "text": "In an 8x13 inch aluminum baking pan over medium heat, mix the sugar and lemon juice. Cook and stir until caramelized. Remove from heat, and blend in mango, sweetened condensed milk, cornstarch, rum, evaporated milk, eggs, and salt."
    },
    {
      "position": 3,
      "text": "Set pan with the mango mixture into the pan with water. Place in the preheated oven, and bake 45 minutes, or until firm. Cool before turning out onto a platter."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

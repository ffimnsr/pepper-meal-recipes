  "id": "ffc70d6a-7e11-5d10-a6b0-64d58efb219a",
  "slug": "slow-cooker-vegetarian-minestrone",
  "name": "Slow Cooker Vegetarian Minestrone",
  "recipe_type": "soup",
  "brief_description": "This slow cooker minestrone soup features beans, veggies, pasta, and herbs that simmer all day in a rich, savory broth. Perfect for a cozy dinner!",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine broth, tomatoes, kidney beans, onion, carrots, celery, green beans, zucchini, garlic, parsley, oregano, salt, thyme, and pepper in a 6-quart slow cooker. Cover and cook on Low for 6 to 8 hours."
    },
    {
      "position": 3,
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until cooked through but firm to the bite, 8 minutes; drain."
    },
    {
      "position": 4,
      "text": "Stir macaroni and spinach into the slow cooker; cover and cook for 15 more minutes."
    },
    {
      "position": 5,
      "text": "Ladle into bowls and sprinkle with Parmesan cheese."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 390,
  "preparation_time_minutes": 20,

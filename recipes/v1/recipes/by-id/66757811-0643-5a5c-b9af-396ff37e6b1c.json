  "slug": "grandmas-slow-cooker-vegetarian-chili",
  "name": "Grandma's Slow Cooker Vegetarian Chili",
  "recipe_type": "soup",
  "brief_description": "Try this slow cooker vegetarian chili and you have a party in the making. The ingredients blend perfectly for a wonderful dish made easy in one pot.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Combine black bean soup, kidney beans, garbanzo beans, baked beans, tomatoes, corn, onion, bell pepper, and celery. Season with garlic, chili powder, parsley, oregano, and basil."
    },
    {
      "position": 3,
      "text": "Cook on High for at least 2 hours."
    }
  ],
  "servings": 8,

  "id": "3b5c326b-cae4-52a1-b2ed-6ac08618fa55",
  "slug": "buffalo-chicken-skillet",
  "name": "Buffalo Chicken Skillet",
  "recipe_type": "main",
  "brief_description": "Crispy chicken tenders are topped with Buffalo sauce and mozzarella cheese for a quick and easy skillet dinner sure to be a family favorite.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Season chicken with salt and black pepper. Set aside."
    },
    {
      "position": 2,
      "text": "Whisk eggs in a shallow bowl until smooth. Place panko in a separate shallow bowl."
    },
    {
      "position": 3,
      "text": "Dip chicken in eggs, then press into panko to coat."
    },
    {
      "position": 4,
      "text": "Heat 3 tablespoons oil in a large skillet over medium heat. Cook 1/3 of the breaded chicken in hot oil until crust is golden and center is no longer pink, about 4 minutes per side. Transfer to a paper towel-lined plate to drain. Repeat with remaining oil and breaded chicken in 2 batches."
    },
    {
      "position": 5,
      "text": "Return pan-fried chicken to the skillet. Pour wing sauce over chicken and sprinkle cheese on top. Reduce heat to low, cover, and cook until cheese is melted, about 5 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

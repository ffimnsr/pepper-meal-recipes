  "id": "e3dd7bbd-4ea2-51f8-8799-8bd24f69e9ea",
  "slug": "buttermilk-chess-pie",
  "name": "Buttermilk Chess Pie",
  "recipe_type": "dessert",
  "brief_description": "This buttermilk chess pie with its smooth custard filling and crunchy top is easy to make for a classic American dessert.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C.)"
    },
    {
      "position": 2,
      "text": "In a large bowl, combine sugar and flour. Beat in the eggs and buttermilk until blended. Stir in the melted butter and vanilla. Pour filling into the pie crust."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until filling is set, about 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,

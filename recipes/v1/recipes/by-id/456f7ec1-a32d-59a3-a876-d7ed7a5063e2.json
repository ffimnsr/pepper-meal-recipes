  "id": "456f7ec1-a32d-59a3-a876-d7ed7a5063e2",
  "slug": "broccoli-soup",
  "name": "Broccoli Soup",
  "recipe_type": "soup",
  "brief_description": "This creamy, smooth broccoli soup recipe is made with frozen broccoli, garlic, onion, and broth thickened with potatoes and seasoned with ground nutmeg.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large saucepan. Add onion and garlic; cook until tender."
    },
    {
      "position": 2,
      "text": "Add broccoli, chicken broth, and potato; bring to a boil. Reduce heat; simmer until vegetables are tender, about 15 minutes."
    },
    {
      "position": 3,
      "text": "Pur\u00e9e mixture with an immersion blender, or in a standard blender, until smooth. Reheat, if necessary; season with nutmeg, salt, and black pepper."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,

  "id": "26207d6e-87eb-546d-83db-1b20975a6a5c",
  "slug": "banana-waffles",
  "name": "Banana Waffles",
  "recipe_type": "breakfast",
  "brief_description": "Delicious banana waffles with the banana cooked inside for added flavor and texture. These make a great snack as well as breakfast or bunch.",
  "cuisine": "World",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the waffle iron."
    },
    {
      "position": 2,
      "text": "Sift together flour, baking powder, salt, and nutmeg in a large mixing bowl. Stir in milk and egg until mixture is smooth."
    },
    {
      "position": 3,
      "text": "Spray preheated waffle iron with nonstick cooking spray."
    },
    {
      "position": 4,
      "text": "Pour 2 tablespoons waffle batter onto the hot waffle iron. Place 2 banana slices on top of the batter and then spoon another 2 tablespoons batter on top of the banana. Cook until golden brown. Serve hot."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

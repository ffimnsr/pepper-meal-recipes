  "slug": "lemon-lime-soda-gelatin-salad",
  "name": "Lemon-Lime Soda Gelatin Salad",
  "recipe_type": "salad",
  "brief_description": "Lime gelatin is spruced up with bits of pineapple, cream cheese and pecans.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "In a large bowl, dissolve the gelatin and sugar in the boiling water. Add the cream cheese and whisk until the melted into small chunks."
    },
    {
      "position": 3,
      "text": "Add pineapple with juice, soda and nuts and stir until evenly combined. Chill until set."
    }
  ],

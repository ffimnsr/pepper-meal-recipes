  "id": "e6d4ebd2-c6ff-5b4a-894c-8ce169c68b2a",
  "slug": "black-bean-brownies",
  "name": "Black Bean Brownies",
  "recipe_type": "dessert",
  "brief_description": "Try this black bean brownie recipe for chocolaty brownies made without flour. Even brownie connoisseurs might not realize they're made with beans!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease an 8-inch square baking dish."
    },
    {
      "position": 3,
      "text": "Combine beans, sugar, cocoa powder, eggs, oil, instant coffee, vanilla, and salt in a blender; blend until smooth."
    },
    {
      "position": 4,
      "text": "Pour into the prepared baking dish. Sprinkle chocolate chips over the surface."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the top is dry and the edges start to pull away from the sides of the pan, about 30 minutes."
    },
    {
      "position": 6,
      "text": "Let cool to room temperature before cutting into 16 squares. Enjoy!"
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "4c7d4ae9-9d0c-58f0-acf3-7fefca9c97b2",
  "slug": "crispy-fried-chicken-skin",
  "name": "Crispy Fried Chicken Skin",
  "recipe_type": "appetizer",
  "brief_description": "Chicken cracklings are similar to pork rinds... A great way to use up chicken skins to make an easy keto snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken skins in a large stockpot. Cover with water. Bring to a boil and cook for 10 minutes. Drain and transfer to a cutting board. Using a sharp knife, scrape off excess fat and cut skin into 1/2-inch wide strips."
    },
    {
      "position": 2,
      "text": "Place skin on a baking sheet and refrigerate, uncovered, for at least 8 hours."
    },
    {
      "position": 3,
      "text": "Heat oil in a large stockpot to 350 degrees F (175 degrees C). Lower a handful of skins carefully into the hot oil. Fry until crisp, about 4 minutes. Transfer to a plate lined with paper towels to drain and sprinkle with salt. Repeat with remaining chicken skin."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,

  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "3cbd9ae3-168c-557c-9f0c-daa80b21326c",
  "slug": "chef-johns-mulligatawny-soup",
  "name": "Chef John's Mulligatawny Soup",
  "recipe_type": "soup",
  "brief_description": "Chef John's take on classic mulligatawny soup provides aromatic, comforting, hearty flavor thanks to chicken thighs, potatoes, veggies, and an array of spices.",
  "cuisine": "Indian Inspired Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter and oil in a soup pot over medium-high heat. Add chicken thighs and season with salt; let brown for 4 to 5 minutes. Flip and brown on opposite side, 4 to 5 minutes more."
    },
    {
      "position": 3,
      "text": "While chicken browns, combine curry powder, garam masala, cumin, black pepper, ground mustard, coriander, and cayenne in a small bowl."
    },
    {
      "position": 4,
      "text": "Remove browned chicken from the pot and transfer to a plate to cool enough to handle; roughly chop or shred."
    },
    {
      "position": 5,
      "text": "While chicken cools, reduce heat to medium and add spice blend to pot; cook and stir until fragrant, about 30 seconds. Add garlic and ginger; cook and stir until fragrant, about 1 minute. Add onions, carrots, and celery. Season with salt and cook, stirring, until onions turn translucent, 3 to 4 minutes."
    },
    {
      "position": 6,
      "text": "Stir in tomato paste and continue to cook for 3 minutes more."
    },
    {
      "position": 7,
      "text": "Stir in potatoes, tomatoes, and apples. Add red lentils, bay leaf, and tamarind paste."
    },
    {
      "position": 8,
      "text": "Pour in chicken broth, stir, and raise heat to high; add coconut cream. Bring to a simmer. Stir and reduce heat to medium-low. Let simmer, stirring occasionally, for about 30 minutes."
    },
    {
      "position": 9,
      "text": "Stir chopped chicken and any accumulated juices into the soup. Continue to let simmer, stirring occasionally, until vegetables are fully cooked, lentils are tender, and soup has thickened, 20 to 30 minutes more. Taste and adjust as needed."
    },
    {
      "position": 10,
      "text": "Serve in warm bowls topped with Greek yogurt, cilantro, and scallions. Sprinkle with red chili flakes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

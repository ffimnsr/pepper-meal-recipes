  "id": "5fdc169f-43f1-593b-bbd7-a5d563a65f6a",
  "slug": "copycat-cheesecake-factory-brown-bread-recipe-8721666",
  "name": "Copycat Cheesecake Factory Brown Bread",
  "recipe_type": "dessert",
  "brief_description": "This copycat Cheesecake Factory brown bread is a lovely moist bread with an even crumb and a sweet flavor. It\u2019s light brown from the cocoa and molasses. Tastes great with some softened salted butter spread on top.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk together warm water and 1 tablespoon honey in a bowl until combined. Sprinkle yeast over top and let stand until foamy, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Whisk together 2 \u00bd cups bread flour, whole wheat flour, cocoa powder, and salt in a large bowl."
    },
    {
      "position": 4,
      "text": "Add the yeast mixture, butter, 1/4 cup honey, and molasses. Mix with a wooden spoon until combined."
    },
    {
      "position": 5,
      "text": "Turn dough out onto a lightly floured surface. Knead 5 to 8 minutes until dough is smooth, and slightly tacky, adding 2 tablespoons of bread flour at a time to help work the dough."
    },
    {
      "position": 6,
      "text": "Form dough into a large ball and place in a greased bowl. Cover bowl and let rise in a warm place until doubled in size, about 1 1/2 hours."
    },
    {
      "position": 7,
      "text": "Punch dough down and turn out onto a lightly floured surface."
    },
    {
      "position": 8,
      "text": "Divide the dough into 4 equal sized pieces, and shape into small loaves, roughly 6 inches long and 2 inches wide."
    },
    {
      "position": 9,
      "text": "Line a large baking sheet with parchment paper. Pour cornmeal onto a plate and dip the bottoms of the loaves in the cornmeal to lightly coat."
    },
    {
      "position": 10,
      "text": "Arrange loaves on prepared baking sheet, leaving ample space in between. Lightly moisten tops of loaves with a little water; sprinkle tops with oats."
    },
    {
      "position": 11,
      "text": "Cover loaves loosely with greased plastic wrap and let rise in a warm place until nearly doubled in size, 45 to 60 minutes."
    },
    {
      "position": 12,
      "text": "Meanwhile, preheat the oven to 350 degrees F (175 degrees C). Remove plastic wrap from loaves and bake until loaves are golden brown and a thermometer inserted in the center of the loaves reads 190 degrees F (88 degrees C), 25 to 35 minutes."
    },
    {
      "position": 13,
      "text": "Transfer loaves to a wire rack to cool for at least 30 minutes before slicing and serving."
    }
  ],

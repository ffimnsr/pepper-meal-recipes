  "id": "f2949845-de5e-5087-84fb-60c058078db6",
  "slug": "one-pot-tortellini-bake",
  "name": "One Pot Tortellini Bake",
  "recipe_type": "main",
  "brief_description": "This delicious tortellini bake with tomato sauce and cheese is cooked all in one pot.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat a Dutch oven over medium-high heat. Add ground beef and cook until brown and crumbly, 5 to 10 minutes. Add Italian seasoning, salt, and granulated garlic; mix to combine."
    },
    {
      "position": 2,
      "text": "Stir in marinara sauce, diced tomatoes with liquid, water, and red wine until well combined. Reduce heat to low; add tortellini and cook until warmed through, about 10 to 15 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 4,
      "text": "Add cream cheese to tortellini mixture and stir gently to blend; sprinkle mozzarella cheese over the surface."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese is melted and golden brown, about 15 minutes. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

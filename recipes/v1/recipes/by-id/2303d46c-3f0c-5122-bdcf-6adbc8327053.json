  "id": "2303d46c-3f0c-5122-bdcf-6adbc8327053",
  "slug": "fresh-cherry-crisp",
  "name": "Fresh Cherry Crisp",
  "recipe_type": "dessert",
  "brief_description": "This fresh cherry crisp has a crunchy oatmeal topping and tastes amazing served warm with ice cream. A delicious way to use summer cherries!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine cherries, 1 \u00bd cups white sugar, and 4 tablespoons flour in a large bowl; pour into a 9x13-inch baking dish. Combine 1 \u00bd cups flour, oats, and brown sugar in a medium bowl; cut in butter and shortening until crumbly. Sprinkle over cherries."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until topping is golden brown, about 45 to 50 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

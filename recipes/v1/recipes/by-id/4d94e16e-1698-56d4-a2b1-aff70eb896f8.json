  "id": "4d94e16e-1698-56d4-a2b1-aff70eb896f8",
  "slug": "creamy-chocolate-frosting",
  "name": "Creamy Chocolate Frosting",
  "recipe_type": "dessert",
  "brief_description": "This milk chocolate frosting is a smooth and creamy, 5-ingredient chocolate buttercream that's simple to make and great for icing cake and cupcakes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Sift confectioners' sugar and cocoa powder into a medium bowl."
    },
    {
      "position": 3,
      "text": "Beat butter in a large bowl with an electric mixer until smooth and fluffy. Gradually beat in sugar mixture alternately with evaporated milk until well combined; blend in vanilla."
    },
    {
      "position": 4,
      "text": "Beat mixture on high speed until light and fluffy. Adjust consistency with more milk or sugar, if desired."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

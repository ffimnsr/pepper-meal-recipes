  "id": "586a7b47-325f-56ed-8ee3-991c18bb9518",
  "slug": "cheesy-kale-quiche",
  "name": "Cheesy Kale Quiche",
  "recipe_type": "breakfast",
  "brief_description": "Kale quiche with a generous amount of Cheddar cheese and bacon is always a favorite among family and friends.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Press pie crust into a pie plate."
    },
    {
      "position": 2,
      "text": "Place cream cheese in a microwave-safe bowl; heat in microwave until warmed, about 10 seconds. Stir cream cheese and milk together in a bowl; stir into beaten eggs. Stir Cheddar cheese into egg mixture; add kale and bacon. Pour egg mixture into the pie crust."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until top has golden brown spots and a toothpick inserted in the center comes out clean, about 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,

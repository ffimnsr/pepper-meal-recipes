  "id": "83eee831-e847-5722-b0b4-0f9962e1d260",
  "slug": "raspberry-thumbprint-cookies",
  "name": "Pecan Raspberry Thumbprint Cookies",
  "recipe_type": "dessert",
  "brief_description": "These pecan thumbprint cookies filled with raspberry jam are buttery and delicious any time of the year, but perfect for the holiday season.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat butter, shortening, and brown sugar in a large bowl with an electric mixer until smooth and creamy. Beat in egg yolks and vanilla until incorporated. Add flour 1 cup at a time, mixing briefly after each addition. Mix in salt."
    },
    {
      "position": 3,
      "text": "Beat egg whites lightly in a small bowl; transfer pecans to a shallow bowl. Pinch off and roll dough into 1-inch balls. Dip each dough ball in egg white, then roll in pecans to coat. Place cookies on an ungreased baking sheet. Use your thumb to form an indention on the top of each cookie and spoon a small amount of raspberry jam into the hollow."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until very lightly browned, 10 to 12 minutes."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

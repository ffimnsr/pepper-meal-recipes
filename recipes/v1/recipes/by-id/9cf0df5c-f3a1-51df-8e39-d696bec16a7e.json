{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "9cf0df5c-f3a1-51df-8e39-d696bec16a7e",
  "slug": "chicken-teriyaki-rice-bowls-recipe-7372857",
  "name": "Chicken Teriyaki Rice Bowls",
  "recipe_type": "main",
  "brief_description": "Everything in this grilled chicken teriyaki bowl is grilled--marinated chicken, pineapple, seasoned broccoli and red pepper--and served over rice.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Pour teriyaki marinade, horseradish, and chili oil into a resealable plastic bag. Add chicken, coat with the marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator, at least 4 hours."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Coat chicken in teriyaki marinade and cook on the prepared grill until no longer pink and juices run clear, 10 to 15 minutes per side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 4,
      "text": "Meanwhile place broccoli florets and red pepper strips in a large bowl. Drizzle with sesame oil and toss to coat. Add garlic powder, black pepper, salt, and crushed red pepper and toss to coat again."
    },
    {
      "position": 5,
      "text": "Place broccoli and red pepper strips in a grill basket and grill, turning occasionally, until tender-crisp, about 10 minutes."
    },
    {
      "position": 6,
      "text": "Grill pineapple until soft and heated through, 2 to 3 minutes per side."
    },
    {
      "position": 7,
      "text": "Slice pineapple and chicken into 1-inch cubes. In 4 separate bowls layer rice, chicken, pineapple, broccoli, and red peppers. Garnish each bowl with sliced green onions and sesame seeds. Drizzle extra teriyaki sauce over each bowl if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

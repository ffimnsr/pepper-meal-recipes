  "id": "cdb40f35-bf35-5d15-8b3c-044d3b766243",
  "slug": "old-fashioned-cranberry-relish",
  "name": "Old-Fashioned Cranberry Relish",
  "recipe_type": "side",
  "brief_description": "This Austrian recipe for cranberry relish uses a touch of orange-flavored liqueur.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Finely chop about half the cranberries with 1 orange in a food processor; scrape into a glass mixing bowl. Repeat process with remaining cranberries and orange."
    },
    {
      "position": 2,
      "text": "Finely chop walnuts in the food processor; add to cranberry mixture. Stir sugar and orange-flavored liqueur through the cranberry mixture."
    },
    {
      "position": 3,
      "text": "Cover bowl with plastic wrap; refrigerate at least 4 hours to overnight."
    }
  ],
  "servings": 12,

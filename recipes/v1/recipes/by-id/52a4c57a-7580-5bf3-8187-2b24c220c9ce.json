  "id": "52a4c57a-7580-5bf3-8187-2b24c220c9ce",
  "slug": "homemade-horseradish",
  "name": "Homemade Horseradish",
  "recipe_type": "appetizer",
  "brief_description": "This easy horseradish recipe shows you how to make prepared horseradish by simply blending fresh horseradish root with vinegar, salt, and sugar.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine horseradish, vinegar, sugar, and salt in the bowl of a food processor or blender; pulse until blended. Carefully remove the cover of the processor or blender, keeping your face away from the container."
    },
    {
      "position": 2,
      "text": "Cover and store horseradish in the refrigerator for up to one month."
    }
  ],
  "servings": 10,

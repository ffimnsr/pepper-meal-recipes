  "id": "c4b5e4fa-23f0-5c09-b6f7-45fa02b7a00e",
  "slug": "overnight-baked-oatmeal-recipe-8769199",
  "name": "Overnight Baked Oatmeal",
  "recipe_type": "dessert",
  "brief_description": "This overnight baked oatmeal has a tender, yet chewy texture, fun flavor combination ideas, and just the right amount of sweetness and spice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Grease a 2-quart rectangular baking dish."
    },
    {
      "position": 3,
      "text": "Whisk eggs, milk, maple syrup, brown sugar, vanilla, cinnamon, and salt together in the prepared dish."
    },
    {
      "position": 4,
      "text": "Stir in oats and amaranth. If desired, stir in flavor variation mix-ins (see below)."
    },
    {
      "position": 5,
      "text": "Cover and chill at least overnight or up to 3 days."
    },
    {
      "position": 6,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Uncover and stir to re-incorporate all of the ingredients."
    },
    {
      "position": 7,
      "text": "Bake, uncovered, until golden brown and the center is set, 45 to 55 minutes."
    },
    {
      "position": 8,
      "text": "Let stand 10 minutes before serving. Serve warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "healthy-blueberry-breakfast-smoothie",
  "name": "Healthy Blueberry Breakfast Smoothie",
  "recipe_type": "breakfast",
  "brief_description": "Wondering what to eat for your on-the-go breakfast? Make this healthy and delicious blueberry breakfast smoothie.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Blend blueberries, yogurt, orange juice, sugar, vanilla extract, and cinnamon together in a blender on low speed for 30 seconds; increase speed to high and blend until smooth, about 2 minutes. Add ice and blend on high until smooth, about 1 minute more."
    }
  ],

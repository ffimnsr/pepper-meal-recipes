  "id": "cf69ace1-873f-54bf-8717-b97e8b0b9816",
  "slug": "cabbage-fat-burning-soup",
  "name": "Cabbage Fat-Burning Soup",
  "recipe_type": "soup",
  "brief_description": "This weight-loss cabbage soup recipe uses tomatoes, bell peppers, carrots, onions, and chopped cabbage to make a filling, fat free, low-calorie soup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place celery, carrots, onions, cabbage, bell peppers, and green beans in a large soup pot."
    },
    {
      "position": 3,
      "text": "Add tomato juice, tomatoes, beef broth, and enough water to cover vegetables; add onion soup mix and stir to combine."
    },
    {
      "position": 4,
      "text": "Bring to a boil over medium heat; reduce heat to low and simmer until vegetables are tender, about 25 minutes."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,

  "slug": "mango-salsa",
  "name": "Mango Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This mango salsa recipe makes a spicy, refreshing, and colorful dip with ripe mangos, red bell pepper, green onion, jalape\u00f1o, cilantro, and lime juice.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients."
    },
    {
      "position": 2,
      "text": "Place mango, bell pepper, green onion, jalape\u00f1o, cilantro, lime juice, and lemon juice in a medium bowl."
    },
    {
      "position": 3,
      "text": "Stir ingredients until well combined. Cover the bowl; set aside at least 30 minutes before serving."
    },
    {
      "position": 4,
      "text": "Serve with chips."
    }
  ],
  "servings": 8,

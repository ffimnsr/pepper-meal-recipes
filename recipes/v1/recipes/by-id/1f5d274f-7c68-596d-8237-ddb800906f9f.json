  "id": "1f5d274f-7c68-596d-8237-ddb800906f9f",
  "slug": "baked-italian-chicken-rollatini-recipe-12062396",
  "name": "Baked Italian Chicken Rollatini",
  "recipe_type": "main",
  "brief_description": "These baked chicken rollatini are elegant breaded chicken rolls filled with ham and melty provolone cheese. But elegant doesn\u2019t mean difficult\u2014they can be assembled in just 15 minutes. Inspired by TikTok creator @kathyquad123, they\u2019re an easy dinner you\u2019ll want to add to your weekly rotation.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9x13-inch casserole dish. Pound chicken between 2 pieces of plastic to an even thickness of 1/4 inch. Season cutlets on one side evenly with salt and pepper."
    },
    {
      "position": 2,
      "text": "Pour oil into a shallow dish. Stir breadcrumbs and Parmesan cheese together in a separate shallow dish."
    },
    {
      "position": 3,
      "text": "Dip each cutlet in olive oil to coat both sides and allow any excess to drip off. Coat cutlet in breadcrumb mixture, pressing lightly to adhere crumbs if necessary."
    },
    {
      "position": 4,
      "text": "Place one slice of provolone cheese on each cutlet and top with a slice of ham. Roll cutlets tightly and secure with a toothpick. Place cutlets in the prepared pan. Sprinkle each cutlet with 2 to 3 teaspoons of leftover breadcrumb mixture and top with a half tablespoon butter over the toothpick. Pour broth and wine around the cutlets."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until crisp and golden brown and saucy is bubbling around the edges, 35 to 40 minutes. Remove toothpicks and serve chicken with pan sauce. Recipe inspired by @kathyquad123 on TikTok"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

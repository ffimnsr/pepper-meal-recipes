  "id": "1b24492b-d007-5ae3-9a55-17196a0c182b",
  "slug": "pressure-cooker-chili",
  "name": "Pressure Cooker Chili",
  "recipe_type": "soup",
  "brief_description": "This easy pressure cooker chili recipe is fast, flavorsome, and hearty. There's nothing quite as comforting as a bowl of hot chili on a cold day!",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Place ground beef in the pressure cooker over medium-high heat; cook until brown and crumbly, 8 to 10 minutes. Remove beef; drain off excess fat."
    },
    {
      "position": 2,
      "text": "Heat olive oil in the pressure cooker over medium heat; stir in onion, green pepper, and jalape\u00f1o. Cook and stir until onion has softened, about 3 to 4 minutes. Add garlic; cook and stir for about 30 seconds. Stir in browned beef, diced tomatoes, kidney beans, water, tomato paste, chili powder, brown sugar, cocoa powder, cumin, salt, and red pepper flakes."
    },
    {
      "position": 3,
      "text": "Lock the lid, bring the cooker up to pressure, reduce heat to maintain pressure, and cook for 8 minutes. Remove the cooker from the heat, and let the pressure reduce on its own, 5 to 10 minutes."
    },
    {
      "position": 4,
      "text": "When the pressure is fully released, remove the lid, stir the chili and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

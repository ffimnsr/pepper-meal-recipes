  "id": "deffb27a-e9f8-565a-88b2-2b88d24ef54b",
  "slug": "best-friend-doggie-biscuits",
  "name": "Best Friend Doggie Biscuits",
  "recipe_type": null,
  "brief_description": "This rolled, cut-out dog biscuit recipe makes yummy dog treats with a crunchy blend of cornmeal, flour, chicken stock, an egg, and chopped parsley.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a cookie sheet."
    },
    {
      "position": 2,
      "text": "In a large bowl, combine cornmeal, flour, and salt. In a separate bowl, beat egg with oil, then stir in chicken broth and parsley. Gradually stir wet ingredients into dry ingredients until combined and a soft dough forms."
    },
    {
      "position": 3,
      "text": "Lightly knead dough on a lightly floured surface and roll out to a thickness of 1/2 inch. Cut into desired shapes with cookie cutters. Place cookies 1 inch apart onto the prepared cookie sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until firm, about 15 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "e491f0c0-bcc9-5dac-94c6-3c5d814846f6",
  "slug": "amazing-chocolate-quinoa-cake",
  "name": "Amazing Chocolate Quinoa Cake!",
  "recipe_type": "dessert",
  "brief_description": "This quinoa chocolate cake, made without flour, is a delicious gluten-free dessert with double the chocolate in every bite from chips and cocoa powder.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a rectangular cake pan."
    },
    {
      "position": 2,
      "text": "Blend together quinoa, melted butter, eggs, milk, and vanilla in a blender until smooth."
    },
    {
      "position": 3,
      "text": "Combine sugar, cocoa powder, baking powder, baking soda, and salt in a large bowl. Stir quinoa mixture into sugar mixture until batter is well combined. Fold in chocolate chips and pecans until incorporated. Pour into the prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of cake comes out clean, 40 to 45 minutes. Place on a wire rack to cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,

  "id": "16679555-865f-5075-9905-88c2feab87fa",
  "slug": "peanut-butter-pie-balls",
  "name": "Peanut Butter Pie Balls",
  "recipe_type": "dessert",
  "brief_description": "The perfect mash-up of a pie, cookie bite, and candy, these no-bake peanut butter balls are great for holiday parties or potlucks.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix cream cheese, whipped topping, powdered sugar, peanut butter, and milk together in a bowl using an electric blender until well mixed, about 1 minute."
    },
    {
      "position": 2,
      "text": "Mix graham cracker crumbs and butter together in a bowl using a spoon."
    },
    {
      "position": 3,
      "text": "Roll peanut butter mixture into bite-sized balls; roll balls in graham cracker mixture until covered. Place balls on a baking sheet covered with wax paper. Freeze for 1 hour."
    },
    {
      "position": 4,
      "text": "Dip frozen bites into melted chocolate and return to wax paper. Freeze for 1 hour before serving."
    }
  ],
  "servings": 50,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 30,

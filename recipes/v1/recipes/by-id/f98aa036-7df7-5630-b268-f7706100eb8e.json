  "id": "f98aa036-7df7-5630-b268-f7706100eb8e",
  "slug": "spicy-cranberry-sauce",
  "name": "Spicy Cranberry Sauce",
  "recipe_type": "appetizer",
  "brief_description": "This spicy cranberry sauce with pineapple is good with turkey or spread over cream cheese for an appetizer--add more jalapeno peppers if you like more heat.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine pineapple tidbits, cranberry sauce, brown sugar, ginger, and salt in a saucepan; bring to a boil. Reduce heat and simmer, stirring often, until berries pop, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Remove from heat and mix in green onions and jalapeno peppers. Garnish with rosemary."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,

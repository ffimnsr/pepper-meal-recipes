  "id": "0ccd8385-7785-559c-9d7d-3b72ab05f8e7",
  "slug": "slow-cooker-beef-enchilada-casserole-recipe-11768128",
  "name": "Slow Cooker Beef Enchilada Casserole",
  "recipe_type": "main",
  "brief_description": "This slow cooker beef enchilada casserole is an easy, family-friendly dish. Taco-seasoned beef, pinto beans, and cheese cook with tortilla wedges for a comforting dinner.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Cook ground beef in a large skillet over medium-high heat until browned, about 7 minutes. Season with taco seasoning."
    },
    {
      "position": 2,
      "text": "Transfer beef mixture to the slow cooker. Add enchilada sauce, beans, green chilies, and onion, and stir to combine."
    },
    {
      "position": 3,
      "text": "Cover and cook on Low for 3 to 4 hours."
    },
    {
      "position": 4,
      "text": "Stir in 1/2 of the tortilla wedges and 1/2 of shredded cheese. Top with remaining tortilla wedges and cheese. Cover and cook on High until cheese is melted, about 30 minutes more."
    },
    {
      "position": 5,
      "text": "Garnish with cilantro, pico de gallo, and sour cream. Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 210,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

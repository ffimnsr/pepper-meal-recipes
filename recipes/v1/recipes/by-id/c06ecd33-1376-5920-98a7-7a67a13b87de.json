  "schema_version": 1,
  "id": "c06ecd33-1376-5920-98a7-7a67a13b87de",
  "slug": "lamb-borek",
  "name": "Lamb B\u00f6rek",
  "recipe_type": "main",
  "brief_description": "Crispy spirals of phyllo pastry are filled with spiced ground lamb, tomatoes, onion, currants, and pine nuts.",
  "cuisine": "Turkish",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a saucepan over medium-high heat. Add onion, salt, and lamb. Break up lamb into small crumbles. Cook, occasionally stirring, until most of the liquid evaporates, about 8 minutes. Toss in garlic, currants, pine nuts, cumin, coriander, cinnamon, paprika, black pepper, cayenne, and allspice. Cook and stir for 1 minute."
    },
    {
      "position": 2,
      "text": "Pour tomato sauce into lamb mixture. Add water, stir, and reduce heat to medium. Cook until lamb mixture dries up and you can stir it without seeing liquid on the bottom of the pan, 20 to 30 minutes. Turn off the heat and let cool completely before using."
    },
    {
      "position": 3,
      "text": "In the meantime, combine egg, yogurt, water, and butter in a bowl. Whisk together thoroughly."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Butter a round baking pan or sheet pan."
    },
    {
      "position": 5,
      "text": "Place 2 sheets of phyllo on your work surface. Keep remaining sheets covered with a damp towel. Sprinkle some egg wash lightly on top and spread using a pastry brush. Layer on 2 more sheets, one at a time, brushing some more egg wash over each."
    },
    {
      "position": 6,
      "text": "Line 1/3 of the lamb filling along one wide edge of the phyllo. Roll pastry up starting from filling side and place it against the edge of the pan. Brush more egg wash on top."
    },
    {
      "position": 7,
      "text": "Shape and fill 2 more rolls with remaining phyllo, most of the egg wash, and filling. Wrap rolls along and inside the first one, filling the pan, and brush with egg wash. Sprinkle sesame seeds on top."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until browned and crisp, 35 to 40 minutes. Let cool for 15 minutes."
    },
    {
      "position": 9,
      "text": "Combine yogurt, mint, lemon juice, and garlic for the yogurt sauce. Mix in enough water to achieve the desired consistency for dipping. Season with salt and cayenne. Cut b\u00f6rek into wedges and serve with yogurt sauce."
    }
  ],
  "servings": 8,

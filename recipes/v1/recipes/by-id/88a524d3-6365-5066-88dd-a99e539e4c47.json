  "id": "88a524d3-6365-5066-88dd-a99e539e4c47",
  "slug": "best-bobotie",
  "name": "Best Bobotie",
  "recipe_type": "main",
  "brief_description": "Bobotie is a South African dish made with ground beef seasoned with curry and topped with a rich milk and egg custard for an aromatic savory meal.",
  "cuisine": "African",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over medium-high heat. Cook onions in hot oil until soft, 2 to 3 minutes. Crumble ground beef into the skillet; cook and stir until brown, 8 to 10 minutes."
    },
    {
      "position": 3,
      "text": "Pour milk in a shallow dish. Soak bread in milk. Squeeze excess milk from bread and set milk aside."
    },
    {
      "position": 4,
      "text": "Add bread to beef mixture. Stir in raisins, chutney, curry powder, apricot jam, salt, and black pepper. Pour mixture into the prepared baking dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 1 hour."
    },
    {
      "position": 6,
      "text": "Whisk together reserved milk, egg, and a pinch of salt. Pour over top of beef mixture. Lay bay leaf on top of milk mixture."
    },
    {
      "position": 7,
      "text": "Continue baking until top is golden brown, 25 to 30 minutes. Remove bay leaf before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 95,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "a46ff717-623f-520f-9407-6578d109af37",
  "slug": "sour-cream-sugar-cookies-i",
  "name": "Sour Cream Sugar Cookies I",
  "recipe_type": "dessert",
  "brief_description": "This easy recipe makes both delightfully soft sugar cookies using sour cream and a heavenly cream cheese frosting.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Cream together 1 1/2 cups white sugar, butter or margarine, 1 teaspoon vanilla, and eggs. Add sour cream."
    },
    {
      "position": 2,
      "text": "Mix together 5 cups flour, 1/2 teaspoon salt, baking powder and baking soda. Gradually add to the egg-sugar mixture."
    },
    {
      "position": 3,
      "text": "Cover and chill dough for 1 hour."
    },
    {
      "position": 4,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 5,
      "text": "Roll out on lightly floured surface to 1/4 inch thick. Cut out cookies. Bake on lightly greased cookie sheet for 10 - 12 minutes."
    },
    {
      "position": 6,
      "text": "To Make Frosting: In small bowl, with mixer at medium speed, beat together the softened cream cheese and evaporated milk until smooth. Add 1 teaspoon vanilla, 1/8 teaspoon salt and confectioners' sugar. Beat until well blended. Color as desired and frost cooled cookies."
    }
  ],
  "servings": 30,

  "id": "62188eb8-4a10-509e-a369-c1742d2a59a9",
  "slug": "lemon-dill-chicken-cottage-cheese-meatballs-recipe-11961943",
  "name": "Lemon Dill Chicken Cottage Cheese Meatballs",
  "recipe_type": "salad",
  "brief_description": "These lemon-dill chicken cottage cheese meatballs are juicy, high-protein meatballs packed with flavor that stay incredibly tender thanks to a simple combination of cottage cheese and shredded zucchini. Fresh dill, garlic, and lemon zest give them a bright, herby kick, while Parmesan adds just the right savory depth. They're easy to throw together and are great over a salad, tucked into a pita, or served as an appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Place ground chicken into a large bowl. Add cottage cheese, zucchini, panko, 2 tablespoons Parmesan cheese, 2 tablespoons fresh dill, lemon zest, salt, granulated garlic, and pepper. Gently mix all ingredients together, just until combined."
    },
    {
      "position": 3,
      "text": "Using a small cookie scoop, form mixture into 26 to 28 meatballs and place on baking sheet. Spray meatballs lightly with olive oil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 18 to 20 minutes until an instant read thermometer inserted near the center reaches 165 degrees F (74 degrees C). Sprinkle with remaining Parmesan and dill before serving."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

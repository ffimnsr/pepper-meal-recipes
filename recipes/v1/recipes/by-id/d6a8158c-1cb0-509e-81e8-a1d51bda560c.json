  "id": "d6a8158c-1cb0-509e-81e8-a1d51bda560c",
  "slug": "restaurant-style-buffalo-chicken-wings",
  "name": "Restaurant-Style Buffalo Chicken Wings",
  "recipe_type": "appetizer",
  "brief_description": "Try this hot wings recipe for Buffalo chicken wings that taste just like those served at a popular restaurant chain. They're so easy to make at home with basic ingredients.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together flour, paprika, cayenne pepper, and salt in a large bowl."
    },
    {
      "position": 2,
      "text": "Place chicken wings in the bowl with flour mixture and toss until evenly coated. Transfer wings to a 9x13-inch glass baking dish and arrange in a single layer. Cover and refrigerate for 1 to 1 1/2 hours."
    },
    {
      "position": 3,
      "text": "Add about 1 inch oil to a deep, heavy skillet; heat to 375 degrees F (190 degrees C). (The oil should be just enough to cover wings entirely.)"
    },
    {
      "position": 4,
      "text": "Meanwhile, combine butter, hot sauce, pepper, and garlic powder in a separate small saucepan over low heat. Cook and stir until butter is melted and mixture is thoroughly blended. Remove from the heat and reserve for serving."
    },
    {
      "position": 5,
      "text": "Fry coated wings in the hot oil for 10 to 15 minutes, or until they begin to crisp and turn brown. Maintain the oil temperature while cooking. Remove cooked wings from hot oil and let drain on paper towels or a wire rack."
    },
    {
      "position": 6,
      "text": "Transfer wings to a platter and drizzle hot sauce over top; or mix wings and hot sauce in a bowl until coated."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

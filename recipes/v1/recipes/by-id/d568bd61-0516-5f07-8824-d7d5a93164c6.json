  "id": "d568bd61-0516-5f07-8824-d7d5a93164c6",
  "slug": "chorizo-stuffed-poblano-peppers",
  "name": "Chorizo Stuffed Poblano Peppers",
  "recipe_type": "appetizer",
  "brief_description": "When you think of stuffed peppers, you usually are thinking of bell peppers. This recipe fills poblano peppers with chorizo, rice, and taco sauce for a spicier version of a classic dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat oil in a skillet over medium-high heat. Add chorizo; cook and stir until completely browned and broken into small pieces, 7 to 10 minutes. Off heat; stir in rice, onion, 1/4 cup taco sauce, Cheddar, and cumin until evenly mixed."
    },
    {
      "position": 3,
      "text": "Fill pepper halves with chorizo mixture; place in a small casserole dish or pie plate. Drizzle remaining 2 tablespoons taco sauce over peppers. Pour water into bottom of dish; cover loosely with aluminum foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until peppers tender, about 1 hour."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

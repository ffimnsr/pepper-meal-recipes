{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "267bf229-a0fb-5ea5-bdaa-303a5c23b6ec",
  "slug": "korean-bbq-inspired-short-ribs",
  "name": "Korean BBQ-Inspired Short Ribs",
  "recipe_type": "main",
  "brief_description": "Korean BBQ ribs are incredibly easy to make and are a tasty filling in lettuce wraps with sticky white rice, perfect for parties and barbeques.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk vinegar, soy sauce, sriracha hot sauce, and olive oil together in a large bowl; add brown sugar and stir until dissolved. Mix green onions, garlic, black pepper, sesame seeds, ginger, and five-spice powder into vinegar mixture until marinade is evenly combined."
    },
    {
      "position": 2,
      "text": "Place short ribs in a large reseable bag and pour marinade over ribs; coat with the marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator for at least 3 hours."
    },
    {
      "position": 3,
      "text": "Preheat grill for medium heat and lightly oil the grate."
    },
    {
      "position": 4,
      "text": "Remove ribs from marinade and place on the grill; cook for 6 to 7 minutes. Flip ribs and spoon marinade over second side; cook until meat is no longer pink, 6 to 7 minutes more. Turn grill heat to high and cook ribs for 1 minute more per side. Remove ribs from heat and place on a plate; let rest for 5 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

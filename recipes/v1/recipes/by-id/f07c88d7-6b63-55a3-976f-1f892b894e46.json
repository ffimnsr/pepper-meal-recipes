  "id": "f07c88d7-6b63-55a3-976f-1f892b894e46",
  "slug": "angel-food-cake-i",
  "name": "Syd's Angel Food Cake",
  "recipe_type": "dessert",
  "brief_description": "This homemade angel food cake is super moist, soft, and oh-so airy! Make the perfect dessert by adding your favorite toppings to this cloud-like cake.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat egg whites until stiff peaks form. Mix in cream of tartar, vanilla extract, and almond extract."
    },
    {
      "position": 2,
      "text": "Sift together flour, sugar, and salt. Repeat five times."
    },
    {
      "position": 3,
      "text": "Gently fold flour mixture into beaten egg whites."
    },
    {
      "position": 4,
      "text": "Pour batter into an ungreased 10-inch tube pan."
    },
    {
      "position": 5,
      "text": "Place the pan in a cold oven. Turn the oven on and set it to 325 degrees F (165degrees C). Bake until cake is golden brown, about 1 hour."
    },
    {
      "position": 6,
      "text": "Invert the tube pan and let cake cool to room temperature before removing from the pan."
    },
    {
      "position": 7,
      "text": "Garnish with strawberries."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

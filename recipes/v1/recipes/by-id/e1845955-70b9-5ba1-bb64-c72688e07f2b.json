  "schema_version": 1,
  "id": "e1845955-70b9-5ba1-bb64-c72688e07f2b",
  "slug": "baklava-bundt-cake-recipe-11917295",
  "name": "Baklava Bundt Cake",
  "recipe_type": "dessert",
  "brief_description": "This baklava Bundt cake, with a topping made of honey and 3 kinds of nuts, is soaked in a honey syrup. It delivers all the flavors of baklava in a wonderfully moist and delicious cake.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Spray a 10-cup Bundt pan with a baking spray containing flour."
    },
    {
      "position": 2,
      "text": "To make the topping: Mix butter, honey, brown sugar, and salt together in a large bowl until smooth and well combined. Add almonds, walnuts, and pistachios; mix until evenly coated in the honey-butter mixture. Scoop the mixture into the prepared pan and spread into an even layer."
    },
    {
      "position": 3,
      "text": "To make the cake batter: Add butter, brown sugar, almond flour, orange zest, cinnamon, salt, and nutmeg to the same bowl; beat with an electric mixer on medium-high speed until light and fluffy, 3 to 5 minutes. Add eggs 1 at a time, beating well after each addition. Add Greek yogurt, milk, vanilla, and almond extract and beat until thoroughly incorporated. Add in flour and baking powder and beat until just combined. Pour batter over topping in the Bundt pan, and spread into an even layer."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of cake comes out clean, 40 to 45 minutes. Cool in the pan for 10 minutes, then invert onto a serving platter. If any nut topping sticks in the pan, simply scoop it out with a spoon and place it back onto the cake."
    },
    {
      "position": 5,
      "text": "Meanwhile, make the honey syrup: Combine honey, orange juice, water, white sugar, and salt in a saucepan over medium-low heat; stir frequently. Bring mixture to a boil, and boil for 5 minutes; keep stirring as mixture may try to bubble over. Remove pan from heat and stir in lemon juice. Set syrup aside to cool."
    },
    {
      "position": 6,
      "text": "Once cake has been removed from the pan, gradually pour honey syrup over the top of the cake a little at a time, allowing the cake to absorb it. Allow cake to cool completely before serving."
    }
  ],

  "id": "cfaa8fc8-e972-511a-b1a0-1d4d05bcda61",
  "slug": "neiman-marcus-tortilla-soup-recipe-11847346",
  "name": "Neiman Marcus Tortilla Soup",
  "recipe_type": "soup",
  "brief_description": "This Neiman Marcus tortilla soup, inspired by the famous department store soup, is super rich and comforting. That Velveeta doesn\u2019t miss\u2014it adds that melty creaminess that you don\u2019t get without it.",
  "cuisine": "Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large Dutch oven over medium heat until shimmering. Add red onion, bell pepper, celery, and carrot. Cook, stirring often, until softened, about 8 minutes. Add garlic and taco seasoning. Cook, stirring constantly, until fragrant, about 15 seconds."
    },
    {
      "position": 2,
      "text": "Add broth and picante sauce, scraping bottom to help dissolve any browned bits; bring to a boil over medium-high, then reduce to a simmer over medium-low. Cook, stirring occasionally, until flavors meld, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Reduce heat to low; stir in tortilla chips, cheese, cream, and salt; cook, stirring constantly until cheese is melted, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Stir in chicken and cilantro; cook, gently stirring occasionally, until heated through, 1 to 2 minutes."
    },
    {
      "position": 5,
      "text": "Divide between serving bowls; garnish with jalape\u00f1o (if using), tortilla chips, and cilantro."
    },
    {
      "position": 6,
      "text": "Serve and enjoy. Recipe developed by Tricia Manzanero Stuedeman"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

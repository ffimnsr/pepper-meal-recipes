  "id": "bc979c3c-a112-54f4-89de-45acb487fb06",
  "slug": "calamari-in-a-creamy-white-wine-sauce",
  "name": "Calamari in a Creamy White Wine Sauce",
  "recipe_type": "main",
  "brief_description": "This creamy and spicy calamari in white wine sauce over linguine pasta recipe features a divine white wine and basil cream sauce with cherry peppers.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook linguine at a boil until tender yet firm to the bite, 8 to 10 minutes; drain."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet over medium-high heat. Add garlic, cook and stir until golden brown. Add squid; cook until it turns white. Stir in white wine and cherry peppers; bring to a simmer and cook until wine is reduced by half, about 3 minutes."
    },
    {
      "position": 3,
      "text": "Stir cornstarch into cream in a small bowl, then add to simmering calamari mixture; season with basil, pepper flakes, salt, and black pepper. Stir until sauce is thickened."
    },
    {
      "position": 4,
      "text": "Add linguine to sauce; toss until evenly coated. Sprinkle with Parmesan cheese."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "mexican-oatmeal-recipe-8624357",
  "name": "Mexican Oatmeal",
  "recipe_type": "dessert",
  "brief_description": "This Mexican oatmeal made with milk, cinnamon, and vanilla is creamy, comforting, and sweet.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water and cinnamon stick to a boil in a saucepan. Reduce heat and simmer for 5 minutes."
    },
    {
      "position": 2,
      "text": "Add oats and cook for 1 minute. Add milk and cook until thickened, 1 to 2 minutes. Remove from heat. Stir in piloncillo, cinnamon, and vanilla."
    }
  ],

  "id": "ef88e521-1e14-58e3-bf7d-12b349772cc2",
  "slug": "french-toast-sticks",
  "name": "French Toast Sticks",
  "recipe_type": "breakfast",
  "brief_description": "Perfect for an on-the-go breakfast, these kid-friendly French toast sticks are as easy to make as they are delicious!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix eggs, powdered sugar, milk, maple syrup, brown sugar, and cinnamon together in a bowl with a fork until well blended."
    },
    {
      "position": 3,
      "text": "Dip each bread stick into the egg mixture."
    },
    {
      "position": 4,
      "text": "Coat a skillet with nonstick spray and heat over medium heat. Place sticks in the hot skillet and cook until brown, 2 to 3 minutes; turn over and cook until browned on other side, 2 to 3 minutes more."
    },
    {
      "position": 5,
      "text": "Repeat with the second batch."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

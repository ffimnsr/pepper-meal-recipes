  "id": "8b1a94c9-f3a8-53f2-a6eb-f0dd535dcd9a",
  "slug": "flamin-hot-cheetos-cheese-ball",
  "name": "Flamin' Hot Cheetos Cheese Ball",
  "recipe_type": "appetizer",
  "brief_description": "Coated in Cheetos powder, this cheese ball with a kick can be served with crackers, corn chips, or raw cut veggies.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Beat cream cheese, 1 cup Cheddar cheese, pepper Jack, mayonnaise, Worcestershire, hot sauce, parsley, onion powder, and garlic powder with an electric mixer on low speed until creamy, about 1 minute. Beat in remaining 1/2 cup Cheddar until just combined, about 15 seconds."
    },
    {
      "position": 2,
      "text": "Place a large piece of plastic wrap on a clean work surface. Place cheese mixture in the center of the plastic wrap. Pull up edges of the plastic wrap to shape the mixture into a ball. Refrigerate until firm, at least 1 hour or overnight."
    },
    {
      "position": 3,
      "text": "Crush snack chips and place in a shallow dish. Unwrap the cheese ball and roll in crushed chips, pressing gently to coat. Serve immediately."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

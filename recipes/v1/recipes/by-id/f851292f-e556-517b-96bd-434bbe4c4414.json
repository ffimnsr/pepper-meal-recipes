  "id": "f851292f-e556-517b-96bd-434bbe4c4414",
  "slug": "southern-fried-cabbage",
  "name": "Southern Fried Cabbage",
  "recipe_type": "side",
  "brief_description": "Fried cabbage with crispy bacon and onion \u2014 delicious! This recipe is quick and easy to make for a superb side dish to serve with your favorite roast.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a large pot over medium heat; add sliced bacon and season with salt and pepper. Cook until bacon is crisp, 5 to 7 minutes."
    },
    {
      "position": 3,
      "text": "Add cabbage, onion, and sugar; cook and stir continuously until cabbage and onion are tender, about 5 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,

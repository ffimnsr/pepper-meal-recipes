  "id": "2b124f07-b16e-5ef2-a14e-a85523990ce9",
  "slug": "copycat-onion-wrapped-flying-dutchman-recipe-8553215",
  "name": "Copycat Onion Wrapped Flying Dutchman",
  "recipe_type": "dessert",
  "brief_description": "This copycat onion wrapped flying Dutchman is essentially a cheeseburger served in an onion \"bun\" that is tender, crisp, and sweet, and pairs perfectly well with the richness of the meat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut 4 1/2 -inch thick slices from the center portion of the onion and discard the smaller ends for another use. Divide beef into 4 portions and form each portion into a very thin patty. Season patties with salt and pepper."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat. Working in batches, add 2 onion slices to the pan and cook, undisturbed, about 2 minutes. Add 2 patties and continue to cook until golden brown, 2 to 3 minutes. Flip onion and burger patties and continue to cook until golden brown pressing the burger as it cooks."
    },
    {
      "position": 3,
      "text": "Add 2 cheese slices to the top of one onion slice and both burger patties. Place one burger on the cheese-topped onion slice and top with the second burger patty. Place remaining onion slice over burger and press down. Flip burger and cook 1 to 2 more minutes. Remove from pan and set aside. Repeat with remaining onions, burger patties and cheese."
    },
    {
      "position": 4,
      "text": "Combine mayo, ketchup, mustard, and pickle relish in a small bowl and stir well. Serve with burgers."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

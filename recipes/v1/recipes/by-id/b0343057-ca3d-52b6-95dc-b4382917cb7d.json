  "id": "b0343057-ca3d-52b6-95dc-b4382917cb7d",
  "slug": "gnocchi-with-sausage-in-vodka-sauce",
  "name": "Gnocchi with Sausage in Vodka Sauce",
  "recipe_type": "main",
  "brief_description": "Quick, easy, and delicious, this gnocchi dish combines Italian sausage, spinach, and a cheesy vodka sauce.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Cook and stir sausage and onion in the hot skillet until browned and crumbly, 5 to 7 minutes. Stir in vodka sauce and enough tomato juice until you reached a desired consistency. Stir in mozzarella cheese and spinach."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook gnocchi in the boiling water until they float to the top, 2 to 4 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Transfer gnocchi to a plate, cover with sauce, and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

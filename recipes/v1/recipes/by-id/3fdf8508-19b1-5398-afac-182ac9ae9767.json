  "id": "3fdf8508-19b1-5398-afac-182ac9ae9767",
  "slug": "gluten-free-fried-oatmeal-bites",
  "name": "Gluten-Free Fried Oatmeal Bites",
  "recipe_type": "appetizer",
  "brief_description": "Chilled oatmeal bites are coated in egg and gluten-free flour, then pan-fried to golden deliciousness in this easy snack recipe that's sweet enough for a dessert alternative.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Bring water to a boil in a pot; reduce heat to low. Add almond milk and stir in oats. Add sugar, stirring vigorously. Stir in salt. Continue to simmer until oats have reached your desired consistency, 3 to 5 minutes. Remove from heat and let cool, 15 to 20 minutes."
    },
    {
      "position": 2,
      "text": "Transfer oats to a lidded container, cover, and chill in a refrigerator, 30 minutes to 2 hours."
    },
    {
      "position": 3,
      "text": "Whisk egg in a small bowl. Place gluten-free flour in a separate bowl."
    },
    {
      "position": 4,
      "text": "Scoop chilled oatmeal into medium-size balls."
    },
    {
      "position": 5,
      "text": "Heat oil in a skillet over medium-high heat."
    },
    {
      "position": 6,
      "text": "Place oatmeal balls into egg wash until completely covered. Place in flour; cover entirely. Use a slotted spoon to remove floured oatmeal balls; shake off excess flour."
    },
    {
      "position": 7,
      "text": "Place oatmeal balls into the hot oil and cook until golden brown, 3 to 4 minutes on each side."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "d34819db-5023-5273-bd1a-e1a7deb0d7ad",
  "slug": "caramelized-tennessee-onion-tortellini-recipe-11775835",
  "name": "Caramelized Tennessee Onion Tortellini",
  "recipe_type": "dessert",
  "brief_description": "For this caramelized Tennessee onion tortellini, sweet onions are baked until caramelized, combined with tortellini, and baked until bubby in a creamy sauce with plenty of cheese on top.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 3-quart baking dish."
    },
    {
      "position": 2,
      "text": "Add onions to the prepared baking dish and toss with olive oil. Sprinkle evenly with Cajun seasoning, paprika and oregano. Top with butter."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven, stirring every 20 to 30 minutes, until softened and caramelized, 1 to 1 1/2 hours."
    },
    {
      "position": 4,
      "text": "Meanwhile, bring a pot of salted water to a boil. Add tortellini and cook for 3 minutes; drain."
    },
    {
      "position": 5,
      "text": "Remove onions from oven; increase oven temperature to 400 degrees F (200 degrees C). Stir in French onion dip until well combined. Add tortellini and broth; stir until well combined. Top with Cheddar and Parmesan cheese."
    },
    {
      "position": 6,
      "text": "Return to the oven and bake until browned and bubbly, about 25 minutes. Sprinkle with parsley and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

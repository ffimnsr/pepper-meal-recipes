  "id": "e9cdec16-12ae-5366-926e-d348ca04aa0e",
  "slug": "rhubarb-gelatin-salad",
  "name": "Rhubarb Gelatin Salad",
  "recipe_type": "salad",
  "brief_description": "This easy rhubarb gelatin salad recipe is made with chopped fresh rhubarb, raspberry-flavored gelatin, and walnuts, and takes only 20 minutes to prep.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring rhubarb, sugar, and 2 tablespoons water to a boil in a saucepan over medium heat; cook until rhubarb is mushy and forms a sauce, about 15 minutes. Reserve 1 cup sauce; set aside remaining sauce for another use."
    },
    {
      "position": 2,
      "text": "Combine raspberry-flavored gelatin mix and reserved 1 cup hot rhubarb sauce in a bowl until gelatin is completely dissolved; stir in 1 cup cold water. Stir in apples and walnuts: pour into a serving bowl."
    },
    {
      "position": 3,
      "text": "Refrigerate salad until set, 2 to 4 hours. Garnish salad with whipped topping or creamy salad dressing."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 20,

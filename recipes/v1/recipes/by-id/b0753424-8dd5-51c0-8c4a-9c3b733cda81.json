  "id": "b0753424-8dd5-51c0-8c4a-9c3b733cda81",
  "slug": "shrimp-and-chicken-stir-fry-recipe-8643948",
  "name": "Shrimp and Chicken Stir-Fry",
  "recipe_type": "main",
  "brief_description": "This delicious shrimp and chicken stir fry is chock full of brightly-colored vegetables in a flavorful ginger-garlic sauce. Serve over rice or noodles.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Stir stock, sugar, Sriracha, soy sauce, ginger, granulated garlic, white pepper, and salt together in a small bowl for the sauce. Whisk in cornstarch until no lumps remain; set aside."
    },
    {
      "position": 2,
      "text": "Pat chicken strips dry with paper towels."
    },
    {
      "position": 3,
      "text": "Heat oil over medium-high heat in a large skillet or wok until oil shimmers. Add chicken and cook, stirring continually, until chicken is no longer pink at the center and juices run clear, 2 to 3 minutes. Place chicken on a plate; set aside."
    },
    {
      "position": 4,
      "text": "To the same pan, add onions, celery, mushrooms, bell peppers, snow peas, and broccoli florets, and cook, stirring frequently, until vegetables are barely tender, 2 to 4 minutes. Return chicken to pan."
    },
    {
      "position": 5,
      "text": "Stir sauce well, and slowly pour over chicken and veggies. Add shrimp; fully submerge shrimp in liquid."
    },
    {
      "position": 6,
      "text": "Bring to a boil and cook, stirring frequently, until shrimp turns pink, opaque, and curls into a \u201cC\u201d shape, 3 to 5 minutes. Add sesame oil to taste. Give the skillet mixture a final stir, and garnish with sliced scallions and sesame seeds."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

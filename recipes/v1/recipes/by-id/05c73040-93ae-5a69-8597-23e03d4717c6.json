  "id": "05c73040-93ae-5a69-8597-23e03d4717c6",
  "slug": "pickled-white-asparagus-cucumbers-and-peppers-recipe-11685995",
  "name": "Pickled White Asparagus, Cucumbers, and Peppers",
  "recipe_type": "salad",
  "brief_description": "These pickled white asparagus, cucumbers, and peppers are great on their own for pickle lovers, but can also be chopped and tossed with lettuce for a quick side salad to accompany steak.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Divide asparagus, bell pepper, cucumber, garlic, pickling spice, and peppercorns between 2 quart-size canning jars."
    },
    {
      "position": 2,
      "text": "Bring water, vinegar, salt, and sugar to a boil in a saucepan over high heat. Reduce heat and simmer for 5 minutes."
    },
    {
      "position": 3,
      "text": "Funnel mixture into jars. Screw on lids and let sit 1 hour or until sealed. Refrigerate for a minimum of 48 hours before serving. Store pickles in the refrigerator after opening."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

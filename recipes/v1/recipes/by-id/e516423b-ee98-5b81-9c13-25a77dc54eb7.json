  "id": "e516423b-ee98-5b81-9c13-25a77dc54eb7",
  "slug": "peach-cobbler-vi",
  "name": "Easy Southern Peach Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This Southern peach cobbler recipe is easy to make with canned or fresh peaches, brown sugar, and vanilla for a great tasting summer dessert.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 9x9-inch baking dish."
    },
    {
      "position": 2,
      "text": "Combine flour, brown sugar, white sugar, baking powder, salt, and vanilla in a large bowl. Pour milk into dry ingredients, and then stir in melted butter. Mix thoroughly."
    },
    {
      "position": 3,
      "text": "Pour mixture into prepared baking pan. Arrange peaches on top and sprinkle with cinnamon. Bake in preheated oven until golden brown, about 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

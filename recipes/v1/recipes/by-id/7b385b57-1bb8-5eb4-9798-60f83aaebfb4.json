  "schema_version": 1,
  "id": "7b385b57-1bb8-5eb4-9798-60f83aaebfb4",
  "slug": "gluten-free-lemon-coconut-poppy-seed-bars",
  "name": "Gluten Free Lemon Coconut Poppy Seed Bars",
  "recipe_type": "dessert",
  "brief_description": "These lemon coconut poppy seed bars made with applesauce and coconut flour are a gluten-free dessert everyone will love.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F. Line an 8-inch square metal, ceramic, or glass baking pan with 2 long pieces of aluminum foil, layering the pieces across one another and crimping the overhang over the sides of the pan."
    },
    {
      "position": 2,
      "text": "Make the crust: Whisk the coconut flour, almond flour, sugar, and salt together in a medium mixing bowl. Stir in the coconut, poppy seeds and lemon zest."
    },
    {
      "position": 3,
      "text": "Whisk the butter, applesauce, and egg yolk together in a small bowl, then stir into the crust."
    },
    {
      "position": 4,
      "text": "Press the crust evenly across the bottom of the prepared baking pan."
    },
    {
      "position": 5,
      "text": "Bake the crust for 10-15 minutes, or until the edges just start to brown. (Baking time will be slightly longer for ceramic and glass pans than for metal pans.)"
    },
    {
      "position": 6,
      "text": "While the crust bakes, make the filling: Whisk the eggs, lemon juice, lemon zest, and applesauce together in a medium mixing bowl until the eggs are well blended."
    },
    {
      "position": 7,
      "text": "Whisk in the sugar and cornstarch."
    },
    {
      "position": 8,
      "text": "Pour the filling over the baked crust and return the pan to the oven."
    },
    {
      "position": 9,
      "text": "Bake for 25-30 minutes more, until the filling is set."
    },
    {
      "position": 10,
      "text": "Cool in the pan on a wire rack for 5 minutes, then use the long edges of the foil to carefully lift the bars out of the pan and onto the rack."
    },
    {
      "position": 11,
      "text": "Cool to room temperature, then peel the foil off. Dust the bars with powdered sugar and sprinkle with poppy seeds, then cut into squares or longer bars."
    },
    {
      "position": 12,
      "text": "Bars can be made up to 3 days in advance and stored in the refrigerator in an airtight container."
    }
  ],

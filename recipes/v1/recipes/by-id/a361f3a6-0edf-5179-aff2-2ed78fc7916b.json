  "id": "a361f3a6-0edf-5179-aff2-2ed78fc7916b",
  "slug": "japanese-potato-salad-recipe-11949566",
  "name": "Japanese Potato Salad",
  "recipe_type": "salad",
  "brief_description": "This Japanese potato salad is a creamy-chunky potato salad with bites of ham and crunchy carrot and cucumber bits and a rice vinegar-Japanese mayo dressing. It's tangy and lightly sweet, with a wonderful texture.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Cover egg with 1 inch of water in a small saucepan. Bring to a full rolling boil. Cover, remove from heat, and let stand 15 minutes; drain. Transfer egg to a bowl of ice water until cool enough to handle, about 5 minutes. Peel and coarsely chop."
    },
    {
      "position": 2,
      "text": "Meanwhile, cook potatoes in enough boiling salted water to cover in a medium saucepan over medium heat until tender, 15 to 20 minutes; drain. Return potatoes to the saucepan."
    },
    {
      "position": 3,
      "text": "Sprinkle potatoes with vinegar, sugar, 1/2 teaspoon salt, and the pepper. Mash potatoes coarsely, leaving plenty of chunks (the potatoes will break down further as the salad is combined, so don\u2019t overdo it). Transfer potatoes to a large bowl and spread in an even layer up the sides of the bowl so they can cool quickly, about 30 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, thinly slice the cucumber using a mandoline. You should have 1 1/4 to 1 1/2 cups."
    },
    {
      "position": 5,
      "text": "Place cucumber in a colander set in the sink. Sprinkle with 1/8 teaspoon salt; toss to combine."
    },
    {
      "position": 6,
      "text": "Let stand 10 minutes. Place cucumber slices in a clean kitchen towel or paper towels; squeeze out excess water."
    },
    {
      "position": 7,
      "text": "When potatoes are cooled, add egg, cucumber, ham, mayonnaise, carrot, green onions, and mustard. Fold to combine. Cover and refrigerate 30 minutes before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "eb3673ea-f977-5198-b78c-dfc34835905a",
  "slug": "air-fryer-turkey-tenderloin-recipe-11866553",
  "name": "Air Fryer Turkey Tenderloin",
  "recipe_type": "main",
  "brief_description": "This air fryer turkey tenderloin for two is cooked to perfection, tender and juicy. With this simple recipe, you can get your turkey fix any time of the year",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the air fryer to 360 degrees F (180 degrees C)."
    },
    {
      "position": 2,
      "text": "Add onion powder, garlic powder, thyme, paprika, salt, and pepper to a small bowl. Stir until evenly combined."
    },
    {
      "position": 3,
      "text": "Place turkey tenderloin on a clean work surface. Brush all sides with olive oil. Sprinkle spice mixture on all sides of the tenderloin; press lightly into the meat to adhere."
    },
    {
      "position": 4,
      "text": "Place tenderloin in the basket of the air fryer. Cook for 10 minutes. Flip tenderloin over and cook 10 minutes more."
    },
    {
      "position": 5,
      "text": "Transfer tenderloin to a cutting board and let rest 10 minutes, then slice and serve."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": 10,
  "difficulty": "easy",

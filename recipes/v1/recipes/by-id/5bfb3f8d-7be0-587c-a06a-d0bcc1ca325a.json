  "name": "Cheese and Bacon Jalapeno Rellenos",
  "recipe_type": "appetizer",
  "brief_description": "Need a spicy, new starter? Our Cheese and Bacon Jalapeno Rellenos have an extra-creamy, extra exciting filling!",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oven to 375 degrees F."
    },
    {
      "position": 2,
      "text": "Combine all ingredients except peppers; spoon into peppers."
    },
    {
      "position": 3,
      "text": "Place, filled-sides up, on baking sheet."
    },
    {
      "position": 4,
      "text": "Bake 10 min. or until cheese is melted."
    }
  ],

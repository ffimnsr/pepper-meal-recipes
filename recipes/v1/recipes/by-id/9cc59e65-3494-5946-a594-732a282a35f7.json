  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "9cc59e65-3494-5946-a594-732a282a35f7",
  "slug": "sausage-gravy-kolaches-recipe-7510692",
  "name": "Sausage Gravy Kolaches",
  "recipe_type": "side",
  "brief_description": "Kolaches are originally from the Czech Republic and have fruit or cheese fillings. This savory sausage gravy version is popular in Texas.",
  "cuisine": "Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Combine \u00bd cup warm milk, 4 tablespoons melted butter, yeast, sugar, and 1 teaspoon salt in the bowl of a stand mixer fitted with the dough hook. Add 2 \u00bc cups flour and 1 egg; knead on low speed, stopping and scraping down the sides every so often in the beginning to make sure all the ingredients are incorporated, 3 to 5 minutes. Increase speed 1 notch once everything has come together; continue kneading until dough is very soft, very smooth, and slightly elastic, about 2 minutes."
    },
    {
      "position": 2,
      "text": "Transfer dough onto a work surface; knead for 1 minute. Shape into a smooth ball. Since the dough has butter in it, it won\u2019t be sticky."
    },
    {
      "position": 3,
      "text": "Lightly grease a bowl with butter; transfer dough ball to the prepared bowl. Cover the bowl; set aside in a warm spot until doubled in volume, about 90 minutes."
    },
    {
      "position": 4,
      "text": "Transfer dough to a work surface; punch down to de-gas. Shape into a ball; weigh on a digital scale. Divide dough into 8 even portions, weighing each to ensure dough portions are equal."
    },
    {
      "position": 5,
      "text": "Roll each portion into a smooth ball, using just enough flour to keep it from sticking. Press and flatten each dough ball into a disc about 3 \u00bd-inches wide and \u00bd-inch thick. Shape with your hands to make a small indention in middles."
    },
    {
      "position": 6,
      "text": "Transfer to a silicone baking mat-lined baking sheet. Cover and proof until almost doubled in size, 45 to 60 minutes."
    },
    {
      "position": 7,
      "text": "Meanwhile, melt 1 tablespoon butter in a skillet over medium-high heat. Add sausage; cook and break up sausage with a spoon until browned and crumbly, about 5 minutes. Sprinkle with 1 \u00bd teaspoons flour; cook and stir 1 to 2 minutes more. Set sausage aside to cool to room temperature."
    },
    {
      "position": 8,
      "text": "Combine cooled sausage, cream cheese, 4 green onions, 2 tablespoons milk, \u00bd beaten egg, sage, \u00bc teaspoon salt, black pepper, and cayenne pepper in a bowl into a thick paste with a spoon."
    },
    {
      "position": 9,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 10,
      "text": "Press a well into center of each kolache to place the filling using slightly damp fingertips. Be sure to leave no more that \u00be-inch un-pressed dough around outsides. Do not press all the way through dough to the baking sheet."
    },
    {
      "position": 11,
      "text": "Brush each kolache with remaining \u00bd egg wash. Divide sausage filling among kolache indentations."
    },
    {
      "position": 12,
      "text": "Bake in the preheated oven until golden brown, 20 to 25 minutes. Transfer to a wire rack and rest before serving, 10 to 15 minutes."
    },
    {
      "position": 13,
      "text": "Top with sliced green onions for garnish."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 45,

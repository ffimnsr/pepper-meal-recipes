  "id": "a0838478-7f0c-5da5-a065-814e37c31e1a",
  "slug": "oatmeal-peanut-butter-cookies-iii",
  "name": "Chewy Oatmeal Peanut Butter Cookies",
  "recipe_type": "dessert",
  "brief_description": "These are so close to the Girl Scout oatmeal peanut butter cookies that you won\u2019t know the difference!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat 1/2 cup butter, 1/2 cup peanut butter, white sugar, brown sugar, and vanilla in a large bowl until light and creamy. Add egg and beat until fully incorporated."
    },
    {
      "position": 3,
      "text": "Whisk flour, baking soda, baking powder, and salt together in a separate bowl. Add flour mixture to the peanut butter mixture and stir until just combined. Stir in oats until evenly incorporated."
    },
    {
      "position": 4,
      "text": "Drop dough by teaspoonfuls onto ungreased baking sheets. Flatten each mound with a fork to form 1/4-inch-thick cookies."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until edges are lightly browned and centers are set, about 10 minutes. Let cool on the baking sheets briefly before transferring to wire racks to cool completely."
    },
    {
      "position": 6,
      "text": "To make the filling: Cream 3 tablespoons butter with powdered sugar, 1/2 cup smooth peanut butter, and heavy whipping cream. Spread filling onto half of the cooled cookies, then top with the remaining cookies to form sandwiches."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

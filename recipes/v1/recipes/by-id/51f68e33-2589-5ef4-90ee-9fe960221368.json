  "id": "51f68e33-2589-5ef4-90ee-9fe960221368",
  "slug": "never-never-fail-pie-pastry",
  "name": "Never, Never Fail Pie Pastry",
  "recipe_type": "dessert",
  "brief_description": "This is the best pastry recipe with perfect flavor. There is no fear of over-kneading this dough that comes together using flour, lard, and more.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together flour, sugar, baking powder, and salt in a medium bowl. Cut in lard until mixture resembles a coarse meal."
    },
    {
      "position": 2,
      "text": "Whisk together water, egg yolk, vanilla, and vinegar in a separate bowl. Stir into flour mixture and knead dough briefly, just until smooth."
    },
    {
      "position": 3,
      "text": "Allow dough to rest for 15 minutes before rolling out."
    }
  ],
  "servings": 8,

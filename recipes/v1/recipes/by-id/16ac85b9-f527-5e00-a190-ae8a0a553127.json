  "id": "16ac85b9-f527-5e00-a190-ae8a0a553127",
  "slug": "vegetarian-kale-soup",
  "name": "Kale Soup",
  "recipe_type": "soup",
  "brief_description": "This kale soup is a hearty and comforting vegetarian meal loaded with fresh kale, veggies, and creamy white beans in a deliciously savory broth.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large soup pot over medium-high heat; cook onion and garlic until soft, 2 to 3 minutes. Stir in kale and cook until wilted, about 2 minutes."
    },
    {
      "position": 3,
      "text": "Stir in water, potatoes, beans, tomatoes, vegetable bouillon, parsley, and Italian seasoning."
    },
    {
      "position": 4,
      "text": "Bring to a boil, then reduce heat and simmer until potatoes are cooked through, about 25 minutes. Season with salt and pepper."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

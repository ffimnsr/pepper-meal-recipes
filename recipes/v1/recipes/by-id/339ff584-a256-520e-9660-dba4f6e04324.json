  "id": "339ff584-a256-520e-9660-dba4f6e04324",
  "slug": "autumn-sweet-potato-shepherds-pie",
  "name": "Autumn Sweet Potato Shepherd's Pie",
  "recipe_type": "dessert",
  "brief_description": "If you are looking for a variation on shepherd's pie, try this fall recipe with sweet potatoes, pumpkin, tomatoes, bell peppers, and ground turkey.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large oven-safe skillet over medium-high heat. Cook ground turkey until browned, about 5 minutes. Reduce heat to medium. Stir in onion, bell pepper, garlic, salt, pepper, oregano, cumin, ancho chile powder, and cinnamon. Cook, stirring occasionally, until onion and peppers have softened, about 5 minutes. Stir in tomatoes and pumpkin. Top with mashed sweet potatoes and sprinkle with smoked paprika."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until flavors are well combined and sweet potatoes are browned, about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "73436fb6-7526-5c3a-8c79-7618ec275cf5",
  "slug": "oregano-roasted-carrots-recipe-11727636",
  "name": "Oregano Roasted Carrots",
  "recipe_type": "dessert",
  "brief_description": "These oregano roasted carrots are a 3-ingredient side dish, ready in under half an hour. Roasting brings out the best in carrots, making them even sweeter.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a rimmed baking sheet with parchment."
    },
    {
      "position": 2,
      "text": "Add carrots, olive oil, oregano, salt, and pepper to a large bowl. Stir until evenly combined. Pour carrots onto the prepared pan, and spread out in an even layer."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 10 minutes. Toss and bake until tender, about 10 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,

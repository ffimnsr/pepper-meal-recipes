  "id": "43def7d3-3be8-5b14-b7e5-0ae7f7a01aec",
  "slug": "veggie-bulgur-salad-kisir",
  "name": "Veggie Bulgur Salad (Kisir)",
  "recipe_type": "salad",
  "brief_description": "This bulgur salad with tender cooked onions, tomatoes, bell peppers, fresh parsley, mint, and tangy pomegranate molasses make this side dish a standout.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Place bulgur in a bowl; stir in boiling water. Cover and let stand for 20 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat 2 tablespoons olive oil in a skillet over medium heat. Stir in chopped onion; cook and stir until onion has softened and turned translucent, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Drain bulgur and return it to the bowl. Add cooked onion, chopped tomatoes, cucumber, green and red bell peppers, green onions, parsley, mint, and red pepper flakes. Drizzle with 2 tablespoons olive oil, lemon juice, and pomegranate molasses. Toss gently until the salad is thoroughly combined. Serve immediately, or refrigerate until serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

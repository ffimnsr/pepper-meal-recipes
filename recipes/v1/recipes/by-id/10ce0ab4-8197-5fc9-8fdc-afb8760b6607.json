  "id": "10ce0ab4-8197-5fc9-8fdc-afb8760b6607",
  "slug": "bright-day-banana-muffins",
  "name": "Bright Day Banana Muffins",
  "recipe_type": "breakfast",
  "brief_description": "These low-fat, low-cholesterol, and high fiber banana muffins are quick and easy to make for a breakfast that will start you day off right!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line 12 muffin cups with paper liners."
    },
    {
      "position": 2,
      "text": "Mash bananas in a bowl until no lumps remain. Add brown sugar, egg whites, egg, and canola oil; mix thoroughly. Stir flour, oats, baking soda, salt, and baking powder into the batter until just combined."
    },
    {
      "position": 3,
      "text": "Fill muffin cup 2/3-full with batter."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, 20 to 25 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "bc1abf75-1516-524d-a6ba-adc41ca25cff",
  "slug": "its-chili-by-george",
  "name": "It's Chili by George!!",
  "recipe_type": "soup",
  "brief_description": "This hearty beef chili with tomato juice and beans is easy to make on the stove or in the slow cooker for a crowd-pleasing meal at the end of the day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain and discard grease."
    },
    {
      "position": 3,
      "text": "Transfer browned beef into a large pot over medium heat; stir in tomato juice, tomato sauce, kidney beans, pinto beans, onions, bell pepper, chili powder, cumin, salt, sugar, oregano, ground black pepper, and cayenne pepper."
    },
    {
      "position": 4,
      "text": "Bring to a boil; reduce heat to low and simmer for 1 1/2 hours."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 100,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "hard",

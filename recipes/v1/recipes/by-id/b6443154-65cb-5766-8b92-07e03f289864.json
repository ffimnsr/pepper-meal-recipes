  "id": "b6443154-65cb-5766-8b92-07e03f289864",
  "slug": "healthier-sweet-potato-pie-i",
  "name": "Healthier Sweet Potato Pie",
  "recipe_type": "dessert",
  "brief_description": "Classic sweet potato pie made healthier using a whole wheat crust and less sugar. With lots of spices, it tastes just as good as the original.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Boil sweet potato whole in skin in a small pot until done, 40 to 50 minutes. Drain, cool sweet potato with cold water, and remove skin."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Break sweet potato apart in a large bowl. Mix in butter and beat well with an electric mixer. Beat in sugar, milk, eggs, nutmeg, cinnamon, and vanilla extract on medium speed until mixture is smooth. Pour filling into unbaked pie crust."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until knife inserted in center comes out clean, 45 to 55 minutes. Pie will puff up like a souffle, then sink down as it cools."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 30,

  "id": "0ca676fc-2c9c-57bd-a0b3-e241a7cdb147",
  "slug": "grilled-panini-sandwich-without-a-panini-maker",
  "name": "Grilled Panini Sandwich Without a Panini Maker",
  "recipe_type": "main",
  "brief_description": "Learn how to make a panini using a regular grill pan if you don't have a panini press for a delicious Italian-style grilled ham and cheese sandwich.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spread mayonnaise onto one side of each bread slice. Layer ham, provolone cheese, and roasted red bell pepper onto one slice, then top with the remaining slice, mayonnaise-side down."
    },
    {
      "position": 2,
      "text": "Heat a grill pan over medium heat. Place sandwich onto the hot pan. Place another heavy pan onto the sandwich, then add two heavy cans to the top pan. Press down on the cans to compress the sandwich. Reduce the heat to medium and cook for 3 to 4 minutes. Flip the sandwich, replace the pan and cans, and cook until cheese is melted, 3 to 4 more minutes."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

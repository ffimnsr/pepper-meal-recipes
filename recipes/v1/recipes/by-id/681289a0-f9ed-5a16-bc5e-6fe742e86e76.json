  "id": "681289a0-f9ed-5a16-bc5e-6fe742e86e76",
  "slug": "coffee-brownies",
  "name": "Coffee Brownies",
  "recipe_type": "dessert",
  "brief_description": "These fudgy and extra-moist chocolaty brownies get a coffee kick from Kahlua and instant coffee granules, as well as an extra dose of chocolate with dark chocolate frosting.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Sift flour, salt, and baking soda together in a medium bowl. Set aside."
    },
    {
      "position": 3,
      "text": "Place chocolate squares in the top of a double boiler over simmering water. Stir frequently, scraping down the sides with a rubber spatula to avoid scorching, until chocolate is melted, about 5 minutes. Set aside."
    },
    {
      "position": 4,
      "text": "Cream butter in a large bowl with an electric mixer. Add sugar, brown sugar, eggs, coffee-flavored liqueur, vanilla extract, melted chocolate, coffee granules, and the flour mixture, one at a time, mixing well after each addition. Stir in chocolate morsels, followed by walnuts and pecans until thoroughly mixed. Pour batter into a 9x12-inch baking dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until top is dry and edges have started to pull away from the sides of the pan, about 25 minutes. Let cool, about 20 minutes. Spread frosting on top of cooled brownies."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

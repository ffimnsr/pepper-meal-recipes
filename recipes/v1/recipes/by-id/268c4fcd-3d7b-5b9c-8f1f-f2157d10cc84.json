  "id": "268c4fcd-3d7b-5b9c-8f1f-f2157d10cc84",
  "slug": "healthier-carrot-cake-iii",
  "name": "Healthier Carrot Cake",
  "recipe_type": "dessert",
  "brief_description": "This carrot cake recipe is made healthier by using less oil and sugar, but it's still packed with flavor. A favorite treat for picnics and parties.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch pan."
    },
    {
      "position": 2,
      "text": "Prepare the cake batter: Beat together eggs, oil, white sugar, and vanilla in a large bowl. Mix in flour, baking soda, baking powder, salt, and cinnamon. Stir in carrots. Fold in pecans. Pour into prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, 40 to 50 minutes. Let cool in pan for 10 minutes, then turn out onto a wire rack and cool completely."
    },
    {
      "position": 4,
      "text": "Make the frosting: Combine butter, Neufch\u00e2tel cheese, confectioners' sugar, and vanilla. Beat until mixture is smooth and creamy. Stir in chopped pecans."
    },
    {
      "position": 5,
      "text": "Spread frosting over completely cooled cake."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 40,

  "id": "09a6c3c0-6973-5597-b393-ea511aa09e0c",
  "slug": "air-fryer-nutella-stuffed-wontons",
  "name": "Air Fryer Nutella-Stuffed Wontons",
  "recipe_type": "dessert",
  "brief_description": "Wonton wrappers, Nutella, and your air fryer are all that\u2019s needed for these quick little stuffed wontons\u2014a great dessert or quick pick-me-up.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 325 degrees F (160 degrees C)."
    },
    {
      "position": 2,
      "text": "Arrange wonton wrappers on a clean work surface. Place about 1 teaspoon chocolate-hazelnut spread in the center of each wrapper. Moisten edges with water using a pastry brush or your finger. Fold each wrapper in half and gently press edges together to seal. Moisten the two outer corners and press them together. Place filled wontons on a clean plate and spray with cooking spray. Spray air fryer basket with cooking spray. Place wontons in the air fryer basket in a single layer, working in batches if needed."
    },
    {
      "position": 3,
      "text": "Air fry until light brown, about 4 minutes. Allow to cool slightly before eating."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

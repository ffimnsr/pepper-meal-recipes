{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "e28745db-20ff-54e0-9345-a157c0d2331f",
  "slug": "slow-cooker-vegetable-and-ground-turkey-soup-recipe-7371801",
  "name": "Slow Cooker Vegetable and Ground Turkey Soup",
  "recipe_type": "soup",
  "brief_description": "This ground turkey soup with tomatoes, zucchini, and carrots is great to make in the slow cooker. Serve over spinach leaves and top with Parmesan.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large skillet over medium heat. Add turkey, salt, and black pepper, and cook until turkey is browned, breaking up the turkey into rough 1/2-inch chunks with a wooden spoon, 5 to 7 minutes."
    },
    {
      "position": 2,
      "text": "Stir in garlic and cook until garlic is fragrant, about 1 minute. Place cooked turkey into a 5-quart slow cooker, and set the cooker to low."
    },
    {
      "position": 3,
      "text": "To the same skillet, add celery, carrots, and onion. Cook, stirring, until onions are translucent, 3 to 5 minutes; add onion mixture to the slow cooker. Pour chicken broth and diced tomatoes, with juices, into the slow cooker. Stir in Italian seasoning, cover the slow cooker, and cook on Low for 8 hours, or High for 4 hours."
    },
    {
      "position": 4,
      "text": "Halfway through the cooking time, stir in zucchini slices, replace the lid, and resume cooking."
    },
    {
      "position": 5,
      "text": "To serve, stir in lemon juice. Season with salt and ground black pepper. Tear up spinach leaves and put about 1/4 cup in the bottom of each soup bowl. Pour hot soup over spinach, stir, and serve. Garnish with shredded Parmesan cheese."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 480,

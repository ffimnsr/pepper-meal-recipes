  "id": "32d5d591-4035-5751-a074-0361314fec7a",
  "slug": "worlds-best-sweet-potato-pound-cake",
  "name": "World\u2019s Best Sweet Potato Pound Cake",
  "recipe_type": "dessert",
  "brief_description": "My family loves this fresh take on sweet potatoes, a much-loved holiday vegetable! Use any type of sweet potatoes you prefer. Enjoy the cake topped with whipped cream or a drizzle of glaze.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 10-inch Bundt or tube pan."
    },
    {
      "position": 2,
      "text": "Cream butter and Neufch\u00e2tel cream cheese in a stand mixer until creamy. Add brown and white sugar and continue to beat until fluffy. Add eggs one at a time, beating well after each addition. Mix in sweet potato puree until well incorporated."
    },
    {
      "position": 3,
      "text": "Combine cake flour, baking powder, baking soda, cinnamon, nutmeg, ginger, and salt in a bowl. Slowly add flour mixture to sweet potato mixture. Mix until well combined. Beat in vanilla extract. Pour batter into the prepared baking pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted in center comes out clean, 75 to 85 minutes. Let cool in the pan for 20 minutes, then turn out onto a wire rack and cool completely."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

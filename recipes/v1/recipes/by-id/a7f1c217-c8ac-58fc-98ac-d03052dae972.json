  "id": "a7f1c217-c8ac-58fc-98ac-d03052dae972",
  "slug": "double-tomato-bruschetta",
  "name": "Double Tomato Bruschetta",
  "recipe_type": "appetizer",
  "brief_description": "Bruschetta is a traditional Italian item in which small slices of bread are topped with such things as tomato, basil, and mozzarella cheese, as is the case in this delightful recipe.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven on broiler setting."
    },
    {
      "position": 2,
      "text": "In a large bowl, combine the roma tomatoes, sun-dried tomatoes, garlic, olive oil, vinegar, basil, salt, and pepper. Allow the mixture to sit for 10 minutes."
    },
    {
      "position": 3,
      "text": "Cut the baguette into 3/4-inch slices. On a baking sheet, arrange the baguette slices in a single layer. Broil for 1 to 2 minutes, until slightly brown."
    },
    {
      "position": 4,
      "text": "Divide the tomato mixture evenly over the baguette slices. Top the slices with mozzarella cheese."
    },
    {
      "position": 5,
      "text": "Broil for 5 minutes, or until the cheese is melted."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 7,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

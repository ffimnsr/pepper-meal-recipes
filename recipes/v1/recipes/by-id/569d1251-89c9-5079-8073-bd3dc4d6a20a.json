  "id": "569d1251-89c9-5079-8073-bd3dc4d6a20a",
  "slug": "coconut-macaroons-iii",
  "name": "Coconut Macaroons",
  "recipe_type": "dessert",
  "brief_description": "These coconut macaroons are super simple and easy to make with flaked coconut and condensed milk for the perfect chewy and delicious sweet treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line baking sheets with parchment paper or aluminum foil."
    },
    {
      "position": 3,
      "text": "Combine coconut, flour, and salt in a large bowl; stir in sweetened condensed milk and vanilla extract until mixture is evenly blended. Use your hands if needed to combine thoroughly."
    },
    {
      "position": 4,
      "text": "Drop coconut mixture onto the prepared baking sheets, about 1 inch apart, using a small ice cream scoop."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until tops are golden and lightly toasted, 12 to 15 minutes."
    },
    {
      "position": 6,
      "text": "Cool macaroons on baking sheets for 5 minutes, then transfer to wire racks to cool completely. Enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

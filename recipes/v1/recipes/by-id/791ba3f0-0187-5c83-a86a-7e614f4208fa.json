  "id": "791ba3f0-0187-5c83-a86a-7e614f4208fa",
  "slug": "spelt-pizza-dough",
  "name": "Spelt Pizza Dough",
  "recipe_type": null,
  "brief_description": "Try Chef John\u2019s spelt pizza dough recipe for a delightful alternative to traditional pizza dough that\u2019s high in protein with a deliciously nutty flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk 1 cup flour, water, honey, and yeast together in a bowl. Let stand until yeast softens and mixture is bubbly, about 20 minutes."
    },
    {
      "position": 2,
      "text": "Stir remaining 2 cups flour, olive oil, and salt into yeast mixture. Beat in a stand mixer fitted with a dough hook attachment, adding more flour as necessary, until a soft and tacky dough forms, 3 to 4 minutes. Place dough into an oiled mixing bowl, cover the bowl with a plate, and let rise until doubled in volume, 90 minutes."
    },
    {
      "position": 3,
      "text": "Punch dough down and transfer to a lightly floured work surface. Divide into four equal balls. Cover each ball and let rest until dough rises slightly, 30 to 45 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

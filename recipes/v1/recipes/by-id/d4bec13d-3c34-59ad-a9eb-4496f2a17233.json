  "id": "d4bec13d-3c34-59ad-a9eb-4496f2a17233",
  "slug": "spicy-turkey-sloppy-joes",
  "name": "Spicy Turkey Sloppy Joes",
  "recipe_type": "main",
  "brief_description": "This version of the all-American classic uses chile peppers to bring the heat and turkey in place of beef to bring the lean.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook and stir ground turkey, onions, green bell pepper, red bell pepper, serrano chile pepper, fresh chile pepper, and garlic in a large skillet over medium heat until the turkey is no longer pink, about 10 minutes. Drain fat from the turkey mixture."
    },
    {
      "position": 2,
      "text": "Stir ketchup, barbeque sauce, cider vinegar, brown sugar, mustard, Worcestershire sauce, Italian seasoning, onion powder, and black pepper into the turkey mixture. Bring the mixture to a boil, reduce heat to medium-low, and cook at a simmer until the vegetables are completely softened, about 20 minutes."
    },
    {
      "position": 3,
      "text": "Serve on split hamburger buns."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

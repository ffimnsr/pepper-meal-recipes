  "id": "4a99a53d-bada-55ee-81e2-051c6df8c74c",
  "slug": "refreshing-cucumber-watermelon-salad",
  "name": "Watermelon Cucumber Salad",
  "recipe_type": "salad",
  "brief_description": "This watermelon cucumber salad with fresh mint, feta, red onion, and lime juice is easy to make for a refreshing hit at any summer get-together.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix red onion with lime juice in a bowl; set aside to marinate at least 10 minutes. Stir olive oil into mixture."
    },
    {
      "position": 2,
      "text": "Toss watermelon, baby cucumbers, and feta cheese together in a large bowl. Pour red onion mixture over watermelon mixture; toss to coat. Sprinkle mint over the salad; toss and serve."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": null,

  "id": "8a527729-5977-5d38-b385-d86a572fc952",
  "slug": "eagle-brand-chocolate-truffles",
  "name": "Eagle Brand Chocolate Truffles",
  "recipe_type": "dessert",
  "brief_description": "These simple, yet rich homemade candies are every bit as delicious as truffles from a high-priced candy store. You can enjoy them any day or show someone you care about them with a gift from the heart and your kitchen! EAGLE BRAND makes it easy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt chocolate chips with sweetened condensed milk in large saucepan over low heat. Remove from heat; stir in vanilla."
    },
    {
      "position": 2,
      "text": "Pour into medium bowl. Cover and chill 2 to 3 hours or until firm."
    },
    {
      "position": 3,
      "text": "Shape into 1-inch balls; roll in desired coating and/or decorate with frosting and candies. Chill 1 hour or until firm."
    }
  ],
  "servings": 72,
  "cooking_time_minutes": 5,

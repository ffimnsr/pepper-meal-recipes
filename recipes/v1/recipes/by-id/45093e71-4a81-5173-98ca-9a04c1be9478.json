  "id": "45093e71-4a81-5173-98ca-9a04c1be9478",
  "slug": "cherry-cheesecake",
  "name": "Cherry Cheesecake",
  "recipe_type": "dessert",
  "brief_description": "This cherry cheesecake is a simple, no-bake recipe made with a sweet cream cheese filling in a graham crust topped with canned cherry pie filling.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place condensed milk, softened cream cheese, lemon juice, and vanilla into a mixing bowl; beat until well blended."
    },
    {
      "position": 3,
      "text": "Pour mixture into pie crust. Chill in the refrigerator for 5 hours; do not freeze."
    },
    {
      "position": 4,
      "text": "Pour cherry pie filling on top of pie; serve."
    }
  ],
  "servings": 12,

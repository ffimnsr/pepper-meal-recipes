  "id": "7ae89859-fb74-5c8c-b24a-2b50e7632049",
  "slug": "mediterranean-salmon-pasta-salad",
  "name": "Mediterranean Salmon Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "This quick and easy Mediterranean salmon pasta salad features penne, tomatoes, cucumbers, shallot, tender fish, and a lemon pepper-dill vinaigrette.",
  "cuisine": "Mediterranean Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add penne and cook, stirring occasionally, until tender yet firm to the bite, about 10 minutes. Drain, rinse in cold water, drain well, and place in a serving bowl."
    },
    {
      "position": 2,
      "text": "Top pasta with cucumber, tomatoes, and shallot. Break up salmon and sprinkle on top."
    },
    {
      "position": 3,
      "text": "Make vinaigrette: Whisk olive oil, vinegar, lemon juice, lemon-pepper seasoning, mustard, salt, and dill in a small bowl until well combined."
    },
    {
      "position": 4,
      "text": "Drizzle vinaigrette over the salad and toss gently to combine."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "98e6b6d6-093e-5244-99de-59545ed0910e",
  "slug": "amazingly-easy-irish-soda-bread",
  "name": "Amazingly Easy Irish Soda Bread",
  "recipe_type": "breakfast",
  "brief_description": "Irish soda bread is a quick bread to make with flour, buttermilk, and baking soda for a rich and tender loaf with a delicious crust.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a large baking sheet."
    },
    {
      "position": 2,
      "text": "Mix flour, softened butter, sugar, baking soda, baking powder, and salt together in a large bowl. Stir in 1 cup of buttermilk and egg."
    },
    {
      "position": 3,
      "text": "Turn dough out onto a lightly floured surface and knead slightly. Form dough into a round loaf and place on the prepared baking sheet. Note that the dough will be a little sticky."
    },
    {
      "position": 4,
      "text": "Combine melted butter with 1/4 cup buttermilk in a small bowl; brush loaf with this mixture. Use a sharp knife to cut an 'X' into the top of the loaf."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven until a toothpick inserted into the center of the loaf comes out clean, 45 to 50 minutes. Check for doneness after 30 minutes. You may continue to brush the loaf with the butter mixture while it bakes."
    },
    {
      "position": 6,
      "text": "Slice and enjoy!"
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

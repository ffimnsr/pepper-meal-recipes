  "id": "91caf7ed-465a-5b4f-b1d0-aa8ffa8b418e",
  "slug": "the-best-beef-tri-tip",
  "name": "The Best Beef Tri-Tip",
  "recipe_type": "main",
  "brief_description": "This tri-tip recipe from Chef John uses his foolproof method of cooking a spice-rubbed beef tri-tip roast low and slow until tender and flavorful.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients. Preheat the oven to 225 degrees F (110 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix salt, pepper, paprika, garlic powder, cayenne, dried rosemary, and fresh rosemary together in a small bowl."
    },
    {
      "position": 3,
      "text": "Place tri-tip in a baking pan. Season generously with the spice rub until both sides are completely covered."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until an instant-read thermometer inserted into the thickest part reads 130 degrees F (54 degrees C) for medium-rare, or until desired doneness, 1 1/2 to 2 hours. Flip meat over halfway."
    },
    {
      "position": 5,
      "text": "Cover pan with aluminum foil and let meat rest for 20 minutes. Remove tri-tip to a cutting board and cut into 2 pieces along where the grain changes direction. Slice meat across the grain and transfer to serving plates."
    },
    {
      "position": 6,
      "text": "Mix beef broth in with the pan drippings and drizzle over the slices."
    },
    {
      "position": 7,
      "text": "Serve and enjoy."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "hard",

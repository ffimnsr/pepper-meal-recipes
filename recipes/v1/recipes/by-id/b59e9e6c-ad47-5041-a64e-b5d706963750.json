  "id": "b59e9e6c-ad47-5041-a64e-b5d706963750",
  "slug": "shrimp-marinara-recipe-7972426",
  "name": "Shrimp Marinara",
  "recipe_type": "main",
  "brief_description": "Shrimp marinara hits all the right spots - tasty shrimp with homemade tomato sauce served over spaghetti. A quick and easy weeknight meal.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Prepare spaghetti according to package directions; drain and keep warm."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat oil over medium heat in a large skillet. Add shrimp and cook 2 to 3 minutes or until nearly opaque, turning once."
    },
    {
      "position": 4,
      "text": "Transfer shrimp to a plate. Add garlic and crushed red pepper to the skillet. Cook and stir until fragrant, about 1 minute."
    },
    {
      "position": 5,
      "text": "Stir in undrained tomatoes, tomato sauce, basil, balsamic vinegar, oregano, and salt. Bring to a boil. Reduce heat and simmer, uncovered, until thickened, 10 minutes."
    },
    {
      "position": 6,
      "text": "Return shrimp to skillet and simmer to heat through, about 1 minute. Serve over spaghetti, topped with additional fresh basil."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "280465c5-c76a-5b86-a5cd-054c142ae6bf",
  "slug": "chicken-pot-pie-i",
  "name": "4-Ingredient Chicken Pot Pie",
  "recipe_type": "soup",
  "brief_description": "This double-crust 4-ingredient chicken pot pie recipe is quick and easy to prep with chicken breasts, soup, and canned vegetables for a comfort meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Simmer chicken breasts with water in a large pot until no longer pink inside, about 15 minutes; dice chicken into bite-sized pieces."
    },
    {
      "position": 3,
      "text": "Meanwhile, line the bottom and sides of a 9-inch pie plate with 1 pie crust."
    },
    {
      "position": 4,
      "text": "Combine canned vegetables, condensed soup, and diced chicken in a large bowl until well mixed; pour into the prepared crust."
    },
    {
      "position": 5,
      "text": "Cover pie with remaining crust. Crimp the crust edges; cut slits in top crust."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until crust is golden brown, about 45 minutes."
    },
    {
      "position": 7,
      "text": "Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,

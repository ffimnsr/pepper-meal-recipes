  "id": "18909ac3-1a91-54e1-bca1-c4d67eec35ac",
  "slug": "easy-creamy-deviled-eggs",
  "name": "Easy Creamy Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "These creamy deviled eggs are made with a blend of Miracle Whip and wasabi mayonnaise for a modern update on a well-loved classic.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cover eggs in a saucepan with cold water. Bring water to a boil, then immediately remove from the heat. Cover and let eggs stand in hot water for 10 to 12 minutes."
    },
    {
      "position": 2,
      "text": "Remove eggs from hot water, cool under cold running water, and peel. Slice eggs in half lengthwise and set whites aside."
    },
    {
      "position": 3,
      "text": "Place egg yolks into a bowl with wasabi mayonnaise, salad dressing, relish, mustard, garlic salt, and pepper; mix to combine. Spoon mixture into egg whites and sprinkle paprika over top. Refrigerate until ready to serve."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "c60ed780-ebf7-57ee-9321-3be72b8223ab",
  "slug": "never-fail-gluten-free-pie-crust",
  "name": "Best Gluten-Free Pie Crust",
  "recipe_type": "dessert",
  "brief_description": "This flaky gluten-free pie crust is easy to make from scratch with butter, eggs, and gluten-free flour; it rolls out beautifully ready for your favorite filling.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place brown rice flour in a resealable plastic bag. Add butter to the bag one cube at a time, shaking to coat each cube evenly with flour. Seal bag and place in the freezer for 15 minutes."
    },
    {
      "position": 2,
      "text": "Whisk eggs and vinegar together in a small bowl. Place in the refrigerator."
    },
    {
      "position": 3,
      "text": "Pour gluten-free flour into a large bowl. Cut in cold flour-coated butter cubes with your fingers until mixture resembles pebbles with some large lumps of butter remaining. Stir in egg and vinegar mixture. Mix in water, 1 tablespoon at a time, until dough is no longer sticky and forms a ball."
    },
    {
      "position": 4,
      "text": "Wrap dough in plastic wrap; refrigerate until firm, about 30 minutes."
    },
    {
      "position": 5,
      "text": "Divide dough into 2 pieces and roll out to desired thickness on a lightly floured work surface."
    },
    {
      "position": 6,
      "text": "Fill and bake as directed in your pie recipe."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": null,

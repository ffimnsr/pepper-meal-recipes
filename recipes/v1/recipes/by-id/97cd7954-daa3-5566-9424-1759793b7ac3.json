  "id": "97cd7954-daa3-5566-9424-1759793b7ac3",
  "slug": "wendys-easy-blackberry-cobbler",
  "name": "Wendy's Easy Blackberry Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This simple blackberry cobbler is topped with cake mix and butter for an easy way to use those abundant blackberries found in the hot summer months!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Combine blackberries, sugar, cinnamon, and nutmeg in a bowl until evenly blended. Spread evenly into the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Place cake mix in a separate bowl. Mix in butter until crumbly; sprinkle evenly over top of berries."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the mixture is bubbly, and the topping is golden brown, 40 to 45 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

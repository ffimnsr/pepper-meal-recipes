  "id": "19fd1d1d-0674-551e-8593-a1dee06650c5",
  "slug": "how-to-make-perfect-polenta",
  "name": "How to Make Perfect Polenta",
  "recipe_type": "side",
  "brief_description": "Creamy polenta is a perfect pairing for all kinds of meats, stews, and sauces. Learn how to make perfect polenta with Chef John's easy, cheesy recipe.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring water and salt to a boil in a large saucepan; pour polenta slowly into boiling water, whisking constantly until there are no lumps."
    },
    {
      "position": 3,
      "text": "Reduce heat to low and simmer, whisking often, until polenta starts to thicken, about 5 minutes. Polenta mixture should still be slightly loose. Cover and cook for 30 minutes, whisking every 5 to 6 minutes. When polenta is too thick to whisk, stir with a wooden spoon. Polenta is done when texture is creamy and the individual grains are tender. Cooking time will depend on the polenta grind."
    },
    {
      "position": 4,
      "text": "Turn off heat and gently stir 2 tablespoons butter into polenta until butter partially melts; mix 1/2 cup Parmigiano-Reggiano cheese into polenta until cheese has melted. Cover and let stand for 5 minutes to thicken."
    },
    {
      "position": 5,
      "text": "Stir polenta and transfer to a serving bowl. Top polenta with remaining 1 tablespoon butter and about 1 tablespoon freshly grated Parmigiano-Reggiano cheese for garnish."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

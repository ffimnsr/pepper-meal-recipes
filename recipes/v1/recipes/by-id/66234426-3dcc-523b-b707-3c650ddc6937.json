  "id": "66234426-3dcc-523b-b707-3c650ddc6937",
  "slug": "scandinavian-sweetheart-waffles",
  "name": "Scandinavian Sweetheart Waffles",
  "recipe_type": "dessert",
  "brief_description": "Heart-shaped waffles sweetened with vanilla sugar and topped with jam or berries and whipped cream are a traditional tasty treat throughout Scandinavia.",
  "cuisine": "Norwegian",
  "instructions": [
    {
      "position": 1,
      "text": "Place egg yolks into a large mixing bowl with white sugar; beat until light and frothy. Mix in vanilla sugar and water until evenly combined; stir in 1/2 of the melted butter, 1/2 of the buttermilk, and 1/2 of the flour. When mixture is smooth, mix in remaining butter, buttermilk, flour, cardamom, and salt; beat again until smooth."
    },
    {
      "position": 2,
      "text": "In a separate bowl, beat egg whites with an electric mixer until they form stiff peaks; gently fold egg whites into batter, incorporating as much volume as possible."
    },
    {
      "position": 3,
      "text": "Preheat a waffle iron according to the manufacturer's directions."
    },
    {
      "position": 4,
      "text": "Spoon about 1/3 cup of batter into the preheated waffle iron, close the lid, and cook until the waffle is golden brown, about 5 minutes. Remove waffle to a plate. If using a heart-shaped iron, break the waffle into individual hearts to serve. Repeat with remaining batter."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

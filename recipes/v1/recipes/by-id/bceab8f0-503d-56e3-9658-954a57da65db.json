  "id": "bceab8f0-503d-56e3-9658-954a57da65db",
  "slug": "party-beans",
  "name": "Party Beans",
  "recipe_type": "side",
  "brief_description": "This is probably the best baked bean recipe that I have come across. Three kinds of beans are baked with ground round and bacon. I use a 5 quart casserole dish.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large skillet over medium heat, cook bacon until crisp. Drain, crumble, and set aside. In the same skillet, cook and crumble the ground round until evenly browned. Drain."
    },
    {
      "position": 3,
      "text": "In a large deep casserole dish or Dutch oven, combine the bacon, beef, baked beans, white beans, and butter beans. Stir in the brown sugar, barbeque sauce, and onion soup mix until well blended."
    },
    {
      "position": 4,
      "text": "Bake, uncovered, for 1 hour in the preheated oven."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

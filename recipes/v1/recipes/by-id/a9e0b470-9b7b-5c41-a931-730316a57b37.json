  "id": "a9e0b470-9b7b-5c41-a931-730316a57b37",
  "slug": "hawaiian-haystacks",
  "name": "Hawaiian Haystacks",
  "recipe_type": "main",
  "brief_description": "Hawaiian haystacks are a great way to layer leftover rice, chicken, pineapple, and Cheddar cheese for a tropical weeknight dinner.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a skillet over medium heat; cook and stir chicken in the hot oil until no longer pink in the center, 5 to 7 minutes. Add chicken broth; simmer until slightly reduced, about 5 minutes. Mix cream of mushroom soup, basil, and parsley into chicken mixture until smooth; cook until warmed, about 5 minutes. Transfer chicken sauce to a small bowl."
    },
    {
      "position": 2,
      "text": "Spread cooked rice onto a serving platter; top with chicken sauce. Layer pineapple, green bell pepper, Cheddar cheese, tomatoes, chow mein noodles, almonds, green onions, and coconut, respectively, onto chicken sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

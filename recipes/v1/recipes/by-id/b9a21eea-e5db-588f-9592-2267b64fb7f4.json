  "slug": "apple-strawberry-and-banana-smoothie-recipe-7568897",
  "name": "Apple, Strawberry, and Banana Smoothie",
  "recipe_type": "appetizer",
  "brief_description": "Start your day off right with a quick and nutritious apple smoothie, ready in minutes. This breakfast smoothie has a nice combination of fruit and is slightly sweet, creamy, and satisfying.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place almond milk, apple, strawberries, banana, and yogurt in a blender, being sure the milk goes in first. Process until smooth, occasionally scraping down the sides of the blender with a rubber spatula, if necessary."
    },
    {
      "position": 2,
      "text": "Pour into serving glasses and serve immediately."
    }
  ],
  "servings": 2,

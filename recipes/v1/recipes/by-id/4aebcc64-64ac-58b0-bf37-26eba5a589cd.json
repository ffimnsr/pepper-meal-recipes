  "id": "4aebcc64-64ac-58b0-bf37-26eba5a589cd",
  "slug": "snert-dutch-split-pea-soup",
  "name": "Snert (Dutch Split Pea Soup)",
  "recipe_type": "soup",
  "brief_description": "Split peas simmered with gammon, pork belly, and smoked sausage make for a thick and hearty soup, known as snert in the Netherlands.",
  "cuisine": "Dutch",
  "instructions": [
    {
      "position": 1,
      "text": "Place gammon in a large pot; cover with cold water and bring to a boil. Add split peas and pork belly; simmer for 10 minutes. Skim off any foam that rises to the surface of the water."
    },
    {
      "position": 2,
      "text": "Transfer gammon and pork belly to a plate using a slotted spoon. Strain split peas through a sieve, discarding water."
    },
    {
      "position": 3,
      "text": "Place gammon, split peas, and pork belly back into the pot; cover with fresh water. Bring to a boil; reduce heat and simmer gently until gammon and pork belly are tender, 2 to 3 hours."
    },
    {
      "position": 4,
      "text": "Transfer gammon and pork belly to a plate using a slotted spoon; cool until easily handled, about 10 minutes. Remove gammon from the bone and slice. Slice the meatiest parts off the pork belly."
    },
    {
      "position": 5,
      "text": "Stir the chopped meat back into the pot. Add celeriac, leeks, onions, and carrot; simmer until softened, about 15 minutes. Add whole sausage link; simmer until heated through, 10 to 15 minutes. Remove sausage link and slice into small pieces; stir back into the soup."
    },
    {
      "position": 6,
      "text": "Sprinkle celery leaves, salt, and pepper over soup. Simmer until celery leaves are warmed through, 1 to 2 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 166,
  "preparation_time_minutes": 30,

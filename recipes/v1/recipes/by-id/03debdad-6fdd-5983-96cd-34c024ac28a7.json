  "schema_version": 1,
  "id": "03debdad-6fdd-5983-96cd-34c024ac28a7",
  "slug": "baked-corned-beef-and-cabbage",
  "name": "Dutch Oven Corned Beef and Cabbage",
  "recipe_type": "main",
  "brief_description": "This corned beef and cabbage is perfectly seasoned and cooked with potatoes and carrots in a Dutch oven until fork-tender for a tasty Irish feast.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Place beef brisket, peppercorns, garlic powder, onion, bay leaves, and salt in a 6-quart Dutch oven; fill pan with water to cover everything completely. Bring to a boil and cook for 20 minutes. Skim off any residue that floats to the top; reduce heat to a simmer and cook for 2 to 3 hours, until meat can be pulled apart with a fork."
    },
    {
      "position": 2,
      "text": "Add cabbage, potatoes, and carrots, pressing them down into the liquid. Simmer for an additional 15 minutes or until the potatoes are tender. Skim off any fat that comes to the surface. Stir in butter and parsley; remove the pot from heat."
    },
    {
      "position": 3,
      "text": "Remove meat from the pot and place onto a serving dish; let rest for 15 minutes. Transfer vegetables to a bowl and keep warm. Slice meat on the diagonal against the grain. Serve meat on a platter and spoon juices over meat and vegetables."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 180,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "expert",

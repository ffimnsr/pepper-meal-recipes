  "id": "5d7d01e0-38b4-5d12-b85e-2cac087dd305",
  "slug": "grandmas-pepper-slaw",
  "name": "Grandma\u2019s Pepper Slaw",
  "recipe_type": "salad",
  "brief_description": "Grandma\u2019s sweet and sour cabbage and bell pepper slaw recipe couldn\u2019t be simpler to make. Try it as a side for burgers, hot dogs, roast pork, or beef.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Toss cabbage and bell pepper together in a large bowl; season liberally with salt. Stir; allow to sit 45 minutes. Drain; return to the bowl."
    },
    {
      "position": 2,
      "text": "Bring sugar and vinegar to a boil in a saucepan; immediately remove from heat. Stir into cabbage mixture; stir in celery seeds. Chill completely before serving."
    }
  ],

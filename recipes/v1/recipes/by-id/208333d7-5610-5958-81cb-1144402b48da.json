  "id": "208333d7-5610-5958-81cb-1144402b48da",
  "slug": "simple-savory-quinoa",
  "name": "Simple Savory Quinoa",
  "recipe_type": "side",
  "brief_description": "This savory quinoa recipe makes a great vegetarian side dish when quinoa combines with celery, carrots, and turmeric.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a saucepan over medium heat. Stir in celery, carrots, onion, and garlic. Cook and stir until onion has softened and turned translucent, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir in vegetable stock, quinoa, basil, and turmeric. Bring to a simmer, then reduce heat to low. Cover and simmer until quinoa is tender and liquid is absorbed, 25 to 30 minutes."
    },
    {
      "position": 3,
      "text": "Stir in lime juice and season with salt."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

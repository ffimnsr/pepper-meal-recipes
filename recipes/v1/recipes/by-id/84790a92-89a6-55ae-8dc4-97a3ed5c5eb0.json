  "id": "84790a92-89a6-55ae-8dc4-97a3ed5c5eb0",
  "slug": "jalapeno-cornbread-muffins-recipe-7643020",
  "name": "Jalape\u00f1o Cornbread Muffins",
  "recipe_type": "snack",
  "brief_description": "These jalapeno cornbread muffins bring Tex-Mex spices and flavors together with delicious southern Kentucky cornbread.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C) and grease the cups of a 12-muffin tin."
    },
    {
      "position": 2,
      "text": "Place 1/4 cup butter in a small skillet and melt. When butter is melted, add onion and minced jalape\u00f1o and cook, stirring occasionally, 3 to 5 minutes. Set aside to cool."
    },
    {
      "position": 3,
      "text": "In a mixing bowl, combine beaten eggs and buttermilk, stirring briskly to combine."
    },
    {
      "position": 4,
      "text": "In a separate bowl, whisk together cornmeal, flour, taco seasoning, salt, and baking soda."
    },
    {
      "position": 5,
      "text": "When the onions and jalape\u00f1os have cooled to room temperature, combine with egg and buttermilk mixture, stirring briskly."
    },
    {
      "position": 6,
      "text": "Add wet ingredients to dry ingredients, stirring until dry ingredients are just moistened and there are no lumps. Pour batter evenly into prepared muffin cups. Place a slice of jalape\u00f1o on top of each muffin."
    },
    {
      "position": 7,
      "text": "Bake in the center of the preheated oven until browned and a toothpick inserted into the middle of the muffin comes out clean, about 25 minutes. If it does not come out clean, bake about 5 minutes more and test again."
    },
    {
      "position": 8,
      "text": "Cool in the pan on a rack, about 5 minutes. Serve warm."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

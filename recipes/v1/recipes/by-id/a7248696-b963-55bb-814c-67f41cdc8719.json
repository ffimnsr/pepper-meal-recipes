  "id": "a7248696-b963-55bb-814c-67f41cdc8719",
  "slug": "scandinavian-style-rice-porridge",
  "name": "Scandinavian-Style Rice Porridge",
  "recipe_type": "dessert",
  "brief_description": "This Scandinavian-style rice porridge recipe slowly cooks rice in milk and butter for extra-creamy, tender results. Cardamom and cinnamon add extra flavor.",
  "cuisine": "Scandinavian",
  "instructions": [
    {
      "position": 1,
      "text": "Crush cardamom seeds with a rolling pin until very fine; place in a deep heavy pan. Add milk, rice, and 1 cup butter; cook over medium heat, while slowly stirring, for 90 minutes. Reduce heat if necessary to prevent milk from boiling or overheating. Stir in sugar; continue cooking until thickens, about 15 minutes more."
    },
    {
      "position": 2,
      "text": "Pour rice mixture into a serving bowl. Add 3 tablespoons butter on top; let melt. Dust with cinnamon. Serve warm or cold."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 105,

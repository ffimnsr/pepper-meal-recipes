  "id": "8b044180-943a-52fc-bd80-d8b64c2bafe1",
  "slug": "rumchata-pudding-shots",
  "name": "RumChata Pudding Shots",
  "recipe_type": "dessert",
  "brief_description": "These RumChata pudding shots are made with rum cream liqueur and chocolate pudding mix and are delicious to serve after dinner as an adult dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix milk, rum cream liqueur, and pudding mix together in a bowl until thickened."
    },
    {
      "position": 3,
      "text": "Gently stir whipped topping into the pudding mixture."
    },
    {
      "position": 4,
      "text": "Spoon into disposable shot cups and place on a plate."
    },
    {
      "position": 5,
      "text": "Freeze until chilled and set, at least 3 hours."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": null,

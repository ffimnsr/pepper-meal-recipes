  "id": "c2f63a0d-4ebd-5a12-9581-598c3e0b327d",
  "slug": "parmesan-risotto",
  "name": "Parmesan Risotto",
  "recipe_type": "appetizer",
  "brief_description": "This Parmesan risotto made with Arborio rice, garlic, white wine, and freshly grated Parmesan cheese makes a rich and creamy Italian appetizer or side.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil and butter in a large pan over medium-high heat until butter is melted. Reduce heat to medium-low; add shallot and garlic. Cook and stir until shallots are translucent but not brown, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Pour in rice and stir until rice is coated in oil and has started to toast, about 5 minutes. Pour in wine and let it simmer until mostly evaporated, then stir in 1\u20443 of the boiling vegetable broth; continue stirring until the rice has absorbed the liquid and turned creamy. Repeat this process twice more, stirring constantly. Stirring in the broth should take 15 to 20 minutes in all. When finished, the rice should be tender yet firm to the bite. You may not need all the vegetable stock."
    },
    {
      "position": 3,
      "text": "Remove from heat. Stir in grated Parmesan cheese, parsley, salt, and white pepper until well combined. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

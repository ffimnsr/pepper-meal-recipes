  "id": "c5ce3bc1-d21e-5a6e-8b5e-84b2ab5a7725",
  "slug": "miso-butter-mashed-sweet-potatoes-recipe-11853585",
  "name": "Miso Butter Mashed Sweet Potatoes",
  "recipe_type": "dessert",
  "brief_description": "These miso butter mashed sweet potatoes take a turn away from the overly sweet side. You just might be surprised when you take your first bite, and find a subtle savory note. They\u2019re perfect for holiday entertaining or an easy weeknight meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Put potatoes in a large pot of salted water over medium-high heat, and bring to a boil. Reduce heat; simmer until tender, and easily pierced with a fork, about 15 minutes. Drain, and put potatoes back into the pot."
    },
    {
      "position": 2,
      "text": "Add warm half-and-half and butter and mash with a potato masher or electric mixer until creamy and smooth, adding more half-and-half if needed. Stir in the miso, garlic, soy sauce, and lemon juice until well incorporated."
    },
    {
      "position": 3,
      "text": "Garnish with chopped parsley or thyme, and serve immediately."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

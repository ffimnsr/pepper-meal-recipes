  "id": "ebda8de8-9341-53b5-9b76-a5e4276d9772",
  "slug": "cherry-blueberry-pie",
  "name": "Cherry Blueberry Pie",
  "recipe_type": "dessert",
  "brief_description": "Cherry-blueberry pie is a fruity and delicious dessert that goes beyond the usual pie in a double-crusted treat that uses an easy-to-follow recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Press one of the pie crusts into a 9-inch pie plate. Stir together 1/2 cup sugar, cornstarch, and cinnamon in a large bowl. Stir in cherry pie filling and blueberries. Spoon into pie crust. Top with second crust and press the edges to seal. Flute edges or press with the tines of a fork. Whisk together egg white and water in a cup with a fork. Brush over the top of the pie, then sprinkle with 2 teaspoons sugar."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until crust is golden brown, 45 to 55 minutes. Cover the edges of the crust with aluminum foil if they appear to be getting too dark. Cool for at least 2 hours to allow the filling to set before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "b9c42b77-82fb-5613-9d33-26f20a26cb10",
  "slug": "honey-garlic-chicken-rice-casserole-recipe-11817448",
  "name": "Honey Garlic Chicken Rice Casserole",
  "recipe_type": "main",
  "brief_description": "In this honey garlic chicken rice casserole the honey flavor really comes through in the sauce. Serve on top of rice and a vegetable like roasted broccoli or Brussels' sprouts.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Season chicken with salt and pepper. Heat oil in a 10-inch skillet over medium-high heat. Add half of the chicken to the skillet and cook until browned, about 5 minutes. Using a slotted spoon, remove chicken from skillet and set aside. Repeat with remaining chicken."
    },
    {
      "position": 3,
      "text": "Add white and pale green parts of green onions (about 2/3 cup) and garlic to the skillet. Cook until softened, 1 to 2 minutes."
    },
    {
      "position": 4,
      "text": "Add rice and chili powder to skillet. Cook and stir 1 minute to coat rice in oil."
    },
    {
      "position": 5,
      "text": "Add broth, honey, soy sauce, and lemon juice to skillet. Stir to dissolve honey. Bring to a boil."
    },
    {
      "position": 6,
      "text": "Return chicken to skillet. Reduce heat and simmer, covered, until rice is tender, about 20 minutes."
    },
    {
      "position": 7,
      "text": "Garnish with some of the green parts of green onion."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

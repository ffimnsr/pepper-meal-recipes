  "id": "08100735-34b9-51a2-becc-b026d976ec9b",
  "slug": "crispy-tater-caesar-salad-recipe-8628372",
  "name": "Crispy Tater Caesar Salad",
  "recipe_type": "salad",
  "brief_description": "This crispy tater Caesar salad is for you if you love fries in a salad. Crispy smashed tater tot croutons, a doctored-up bottled Caesar dressing, and crispy chicken cutlets join Romaine lettuce and Parmesan in this meal in a bowl.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Set 2 shelves near the center of the oven. Spray a baking pan with cooking spray; place frozen chicken filets on the pan."
    },
    {
      "position": 2,
      "text": "Bake in the preheated oven on the lower-center shelf until hot and crisp, about 20 minutes, turning filets over halfway through heating time. When cool enough to handle, cut filets into bite-sized pieces."
    },
    {
      "position": 3,
      "text": "Meanwhile, line a large rimmed baking sheet with parchment paper, and add tater tots in an even layer."
    },
    {
      "position": 4,
      "text": "Bake on upper-center shelf in the preheated oven until tots are soft and slightly baked, 8 to 10 minutes. Remove from oven. Spray cooking spray on the bottom of a cup. Smash each tater tot into a flat disk with cup."
    },
    {
      "position": 5,
      "text": "Return to the oven; bake until golden brown and crispy, 15 to 20 minutes. Remove from oven again, and sprinkle with 1/2 cup Parmesan cheese."
    },
    {
      "position": 6,
      "text": "Bake again until cheese is melted, about 1 minute. Set aside to cool, about 5 minutes."
    },
    {
      "position": 7,
      "text": "Meanwhile, whisk Caesar dressing, lemon juice, anchovy paste, garlic, 1/4 teaspoon black pepper, and salt together in a bowl until smooth."
    },
    {
      "position": 8,
      "text": "Toss together lettuce, chicken, remaining 1/2 cup Parmesan cheese and remaining 1/4 teaspoon black pepper until well combined. Pour half the dressing into salad mix and toss until evenly coated. Add cooled tater tots and toss until well combined."
    },
    {
      "position": 9,
      "text": "Transfer to a serving platter, drizzle with white balsamic vinegar, and garnish with more Parmesan cheese. Serve immediately. Recipe developed by Amanda Stanfield"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,

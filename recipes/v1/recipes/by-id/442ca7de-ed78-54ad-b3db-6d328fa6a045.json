{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "442ca7de-ed78-54ad-b3db-6d328fa6a045",
  "slug": "teriyaki-chicken-cordon-bleu",
  "name": "Teriyaki Chicken Cordon Bleu",
  "recipe_type": "main",
  "brief_description": "Chicken thighs are pounded thin and marinated in your favorite teriyaki sauce, then rolled into delicious bundles with ham and cheese. The panko bread crumbs add a nice crunch.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place the chicken thighs between two sheets of heavy plastic (resealable freezer bags work well) on a solid, level surface. Firmly pound the chicken with the smooth side of a meat mallet to a thickness of 1/2-inch."
    },
    {
      "position": 2,
      "text": "Whisk together the teriyaki sauce and chili sauce in a bowl, and pour into a resealable plastic bag. Add the chicken, coat with the marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator for 18 to 24 hours."
    },
    {
      "position": 3,
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking dish with butter-flavored cooking spray."
    },
    {
      "position": 4,
      "text": "Remove the chicken from the marinade, and shake off excess. Discard the remaining marinade. Lay each chicken thigh flat, then layer a slice of ham on each thigh followed by the string cheese. Roll up each chicken thigh around the string cheese and ham, and secure each roll with a toothpick.. Repeat with the remaining chicken."
    },
    {
      "position": 5,
      "text": "Spray each bundle with the butter-flavored cooking spray. Pour panko flakes onto a dish, then roll the bundles into the crumbs and place on prepared baking dish. Lightly spray the bundles once more."
    },
    {
      "position": 6,
      "text": "Bake the chicken bundles until no longer pink in the center and the juices run clear, 35 to 40 minutes. An instant-read thermometer inserted into the center of the chicken should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

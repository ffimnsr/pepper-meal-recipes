  "id": "ca15ee86-433d-5160-9375-2d14f705a60f",
  "slug": "cream-cheese-filled-pumpkin-muffins",
  "name": "Cream Cheese Filled Pumpkin Muffins",
  "recipe_type": "breakfast",
  "brief_description": "This cream cheese-filled pumpkin muffins recipe is a straightforward recipe with a mix of spices like cinnamon, allspice, nutmeg, cardamom, and ginger.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin or line cups with paper liners."
    },
    {
      "position": 2,
      "text": "Whisk flour, cinnamon, pumpkin pie spice, nutmeg, ginger, salt, baking soda, allspice, cloves, and cardamom together in a bowl."
    },
    {
      "position": 3,
      "text": "Beat brown sugar and eggs together in a large bowl with an electric mixer until smooth. Beat in pumpkin pur\u00e9e and 1/2 cup plus 2 tablespoons vegetable oil until combined. Beat in flour mixture until just incorporated."
    },
    {
      "position": 4,
      "text": "Spoon batter into the prepared muffin cups, filling each about 1/2 full. Spoon about 1 teaspoon cream cheese into center of each muffin cup; poke it down into middle of batter. Sprinkle sunflower seeds over muffin tops."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden and tops spring back when lightly pressed, about 25 minutes. Cool muffins in tin for 5 minutes, then transfer to a rack to cool completely. Be careful; the cream cheese stays hot for a while."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "sauerkraut-relish",
  "name": "Sauerkraut Relish",
  "recipe_type": "dessert",
  "brief_description": "Pungent sauerkraut is pepped up with crunchy red and green peppers, bits of celery and onion and a sweet, vinegary dressing.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl, mix together the sauerkraut, green peppers, red peppers, celery, onion, vinegar and sugar. Refrigerate 8 hours or overnight before serving."
    }

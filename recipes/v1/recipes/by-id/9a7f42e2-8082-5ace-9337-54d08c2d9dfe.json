  "id": "9a7f42e2-8082-5ace-9337-54d08c2d9dfe",
  "slug": "pressure-cooker-potato-salad",
  "name": "Pressure Cooker Potato Salad",
  "recipe_type": "salad",
  "brief_description": "Using your pressure cooker, this classic potato salad is ready to chill in the refrigerator in less than half an hour.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes in pressure cooker with water. Cook on high pressure 3 minutes. If potatoes are larger, cook for 4 minutes. Let steam release for 3 minutes. Then quickly release pressure and open cooker. Peel and dice potatoes when they are cool enough to handle."
    },
    {
      "position": 2,
      "text": "Alternate layers of potatoes, onion, and celery in a large bowl. Season each layer with salt and pepper. Top with the chopped egg and sprinkle with dill."
    },
    {
      "position": 3,
      "text": "Mix together the mayonnaise, mustard, and cider vinegar in a small bowl. Gently fold the mayonnaise mixture into the potatoes. Chill at least one hour before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

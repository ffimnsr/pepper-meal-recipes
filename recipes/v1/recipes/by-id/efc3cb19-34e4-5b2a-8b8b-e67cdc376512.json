  "id": "efc3cb19-34e4-5b2a-8b8b-e67cdc376512",
  "slug": "chorizo-breakfast-burritos",
  "name": "Chorizo Breakfast Burritos",
  "recipe_type": "breakfast",
  "brief_description": "This breakfast burrito with chorizo sausage, onions, scrambled eggs, and cheese rolled up in a warm flour tortilla is the perfect cure for a hangover.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Generously coat a large frying pan with cooking spray. Cook and stir chorizo in the prepared pan over medium-high heat until well browned and crumbled. Add onion and chile pepper; continue cooking, stirring occasionally, until onion is tender."
    },
    {
      "position": 2,
      "text": "Beat eggs in a medium bowl and add to chorizo mixture. Reduce heat to medium-low; continue cooking and stirring until eggs are scrambled and no longer runny."
    },
    {
      "position": 3,
      "text": "Warm flour tortillas in the microwave for 30 seconds. Spoon chorizo-egg mixture into the middle of each tortilla and top with shredded Cheddar cheese. Roll up like a burrito."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

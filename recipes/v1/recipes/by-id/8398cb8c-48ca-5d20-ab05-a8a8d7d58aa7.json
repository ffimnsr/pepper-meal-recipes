  "id": "8398cb8c-48ca-5d20-ab05-a8a8d7d58aa7",
  "slug": "grilled-bbq-meatloaf",
  "name": "Grilled BBQ Meatloaf",
  "recipe_type": "dessert",
  "brief_description": "This savory beef and pork meatloaf has a sweet barbecue sauce topping. It's grilled right on the grates, with no pan, for a smoky flavor--but of course you can also bake it in the oven.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for medium heat, and scrape the grates clean. Spray grates with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "In a bowl, mix together the ground beef, ground pork, bread crumbs, onion, egg, Worcestershire sauce, garlic, tarragon, sea salt, and black pepper. Divide the mixture in half, and form 2 loaves, each about 4 inches in diameter and 6 inches long. In a small bowl, mix the barbecue sauce with ketchup until well combined."
    },
    {
      "position": 3,
      "text": "Place each meatloaf directly on the prepared grill grates, then spread each with about 3 tablespoons of barbecue sauce mixture; grill until the loaves reach an internal temperature of at least 160 degrees F (73 degrees C), about 1 hour."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

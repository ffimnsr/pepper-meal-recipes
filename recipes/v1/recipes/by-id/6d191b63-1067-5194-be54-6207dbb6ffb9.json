  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "6d191b63-1067-5194-be54-6207dbb6ffb9",
  "slug": "cinnamon-roll-bunnies",
  "name": "Cinnamon Roll Bunnies",
  "recipe_type": "breakfast",
  "brief_description": "These cinnamon roll bunnies are made with refrigerated dough and raisins. They are an easy 2-ingredient baked treat for an Easter brunch or baby shower.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Unroll 1 cinnamon roll dough and cut in half. Roll 1 half to form the \"body.\" Rotate roll so the outer end of roll is facing downward; this will form the bunny's \"front legs.\" Cut off 1/3 of the remaining dough and roll it up to form the \"tail.\" Roll up the last 2/3 of the dough to about the halfway point to form the \"head.\" Slice through remaining unrolled portion and fan out the pieces to form the \"ears.\""
    },
    {
      "position": 3,
      "text": "To attach the \"tail\" and \"head\" to the \"body\", rub away any cinnamon coating, wet dough, and press the pieces together. Spread out the \"ears\" and pinch them at the tips to shape. Transfer the \"bunny\" to the prepared baking sheet by carefully lifting with a spatula or scraper. Repeat with remaining rolls."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, 15 to 18 minutes. Slide parchment paper with \"bunnies\" onto a wire rack to cool slightly."
    },
    {
      "position": 5,
      "text": "Spread glaze onto warm \"bunnies,\" following the pattern of the swirls and ears. Press a raisin into the center of the swirl on the head to form the \"eyes.\""
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

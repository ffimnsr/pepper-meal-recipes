  "id": "b851c1bf-64aa-563f-81cd-5c4d472f21cb",
  "slug": "crab-and-swiss-omelet",
  "name": "Crab and Swiss Omelet",
  "recipe_type": "breakfast",
  "brief_description": "An easy and delicious crab omelet recipe made with Dungeness crab, mushrooms, and Swiss cheese. The perfect fancy breakfast.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large nonstick skillet over medium-high heat. Stir in mushrooms, and cook until tender, about 5 minutes. Using a slotted spoon, transfer mushrooms to a plate. Remove skillet from heat."
    },
    {
      "position": 2,
      "text": "In a small bowl, beat egg yolks and milk to blend. In a separate bowl, beat egg whites with a dry beater until soft peaks form. Fold yolk mixture into whites."
    },
    {
      "position": 3,
      "text": "Return skillet to medium-high heat. When butter sizzles, pour egg mixture into skillet. Sprinkle mushrooms and crab meat evenly over the top. Cook until omelet begins to set, about 3 minutes. Sprinkle with Swiss cheese. Using a large spatula, fold omelet over, forming semicircle. Cover skillet; cook until omelet puffs and is cooked through, about 3 minutes. Slide omelet onto a large plate."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "slug": "how-to-make-rice-balls-onigiri",
  "name": "How to Make Rice Balls (Onigiri)",
  "recipe_type": "appetizer",
  "brief_description": "Perfect for parties or picnics, Japanese onigiri (rice balls) are easy to make with Japanese rice, seaweed, and your favorite sushi toppings.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Combine rice and water in a heavy-bottomed pot with a tight-fitting lid. Soak for 20 to 30 minutes. Cover and bring to a boil over medium heat. Once water is boiling, reduce heat to low and cook until water is completely absorbed, 12 to 13 minutes. Remove from the heat; keep covered and steam for another 10 minutes. Remove lid and cool to room temperature, about 20 minutes."
    },
    {
      "position": 2,
      "text": "Wet your hands and form small amounts of rice into triangle shapes if possible, or round balls. Wrap each onigiri with a strip of nori. Season with salt and garnish with sesame seeds and seaweed flakes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

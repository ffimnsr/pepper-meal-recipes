  "id": "03904d4e-263f-538b-a5b4-8ff840e76c0d",
  "slug": "paleo-maryland-crab-cakes",
  "name": "Paleo Maryland Crab Cakes",
  "recipe_type": "appetizer",
  "brief_description": "This Maryland crab cake recipe uses uses nutty almond flour for the breading.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk egg, mayonnaise, seafood seasoning, Dijon, Worcestershire sauce, hot sauce, lemon juice, and pepper together in a bowl."
    },
    {
      "position": 2,
      "text": "Place crabmeat into a separate bowl; add mayonnaise mixture and gently mix with your hands to combine. Mix in 1/4 cup almond flour, bell pepper, green onion, and parsley. Form mixture into six round cakes."
    },
    {
      "position": 3,
      "text": "Dredge each cake in remaining 1/3 cup almond flour and place onto a parchment-lined sheet pan. Cover and refrigerate for at least 1 hour."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 5,
      "text": "Bake crab cakes, uncovered, in the preheated oven until golden brown, 15 to 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,

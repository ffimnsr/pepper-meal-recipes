  "id": "483333d5-6e40-591d-aba1-a168210faf68",
  "slug": "bacon-and-egg-tacos",
  "name": "Bacon and Egg Tacos",
  "recipe_type": "breakfast",
  "brief_description": "This is a quick and easy recipe for bacon and egg breakfast tacos using flour tortillas. Serve with salsa on the side for a crowd-pleasing brunch!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Whisk eggs together in a bowl; stir in bacon."
    },
    {
      "position": 2,
      "text": "Melt butter in a skillet over medium heat. Add egg mixture; cook and stir until eggs are completely set, 2 to 3 minutes. Stir in American cheese, salt, and pepper."
    },
    {
      "position": 3,
      "text": "Wrap tortillas in damp paper towels; microwave until warmed through, 30 seconds to 1 minute."
    },
    {
      "position": 4,
      "text": "Spoon 1/4 cup egg mixture into the center of each tortilla; fold sides to cover. Serve with salsa."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 3,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

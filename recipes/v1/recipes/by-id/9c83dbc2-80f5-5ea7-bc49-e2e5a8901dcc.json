  "id": "9c83dbc2-80f5-5ea7-bc49-e2e5a8901dcc",
  "slug": "rhubarb-applesauce",
  "name": "Rhubarb Applesauce",
  "recipe_type": "side",
  "brief_description": "Rhubarb applesauce combines apple cider, ground cinnamon, and fresh rhubarb for a spiced, tart twist to traditional applesauce\u2014and it is easy to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine apples, rhubarb, apple cider, sugar, and cinnamon in a large saucepan. Cover and cook over medium heat for 20 minutes."
    },
    {
      "position": 2,
      "text": "Transfer to a large bowl; beat with an electric mixer on medium-high speed until smooth and all chunks are gone. Serve warm."
    }
  ],

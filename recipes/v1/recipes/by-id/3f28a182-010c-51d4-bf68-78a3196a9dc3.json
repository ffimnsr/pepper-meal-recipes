  "schema_version": 1,
  "id": "3f28a182-010c-51d4-bf68-78a3196a9dc3",
  "slug": "stuffed-mushroom-dip-recipe-8706348",
  "name": "Stuffed Mushroom Dip",
  "recipe_type": "appetizer",
  "brief_description": "This Stuffed Mushroom Dip is a fun new take on the classic stuffed mushroom appetizer. It uses all the same signature elements, from savory sausage to creamy cheese to buttery breadcrumbs, but in an easy-to-share format. Here's how to make Stuffed Mushroom Dip.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat oven to 375 degrees F (190 degrees C) with rack in top third position. Grease an 8- x 8-inch baking dish with cooking spray. Set aside"
    },
    {
      "position": 2,
      "text": "Melt butter in a large skillet over medium-high. Add breadcrumbs and stir until evenly coated in melted butter and fragrant, about 2 minutes. Transfer to a small bowl and set aside; wipe skillet clean."
    },
    {
      "position": 3,
      "text": "Return skillet to medium-high heat. Add sausage and cook, stirring often, breaking it up into bite-size pieces with a wooden spoon, until browned and almost cooked through, 2 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Add mushrooms, garlic, black pepper, and salt; cook, stirring occasionally, until the mushrooms are soft and excess moisture has evaporated, 12 to 15 minutes. Remove from heat."
    },
    {
      "position": 5,
      "text": "Stir sour cream, cream cheese, parsley, 1/4 cup of the mozzarella cheese, and 1/4 cup of the Parmesan cheese into mushroom mixture until fully combined and smooth. Transfer to prepared baking dish, spreading into an even layer."
    },
    {
      "position": 6,
      "text": "Sprinkle remaining 1/2 cup of mozzarella cheese and remaining 1/4 cup Parmesan cheese evenly over the top. Top with reserved breadcrumbs."
    },
    {
      "position": 7,
      "text": "Bake in preheated oven until cheese is melted and the edges are bubbling, about 12 minutes. Increase oven temperature to broil (do not remove baking dish from oven), and broil until bread crumbs are deeply browned, 1 to 2 minutes. Remove from oven, garnish with parsley, and serve with crostini. Recipe developed by Amanda Holstein"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,

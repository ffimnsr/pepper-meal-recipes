  "id": "7f3bc438-cb79-5b91-9601-c548370ffb92",
  "slug": "spicy-gingerbread-overnight-oats",
  "name": "Spicy Gingerbread Overnight Oats",
  "recipe_type": "breakfast",
  "brief_description": "Soak oats overnight with warm spices, molasses, flax, and Greek yogurt to make these gingerbread overnight oats, a tangy breakfast perfect for cold months.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine milk, oats, yogurt, brown sugar, flaxseed meal, molasses, vanilla extract, cinnamon, ginger, salt, nutmeg, cloves, and allspice in a glass container."
    },
    {
      "position": 2,
      "text": "Refrigerate mixture 8 hours to overnight. Top with raisins and walnuts just before serving."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,

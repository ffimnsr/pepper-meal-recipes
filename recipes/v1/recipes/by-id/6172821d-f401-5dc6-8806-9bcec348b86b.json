  "id": "6172821d-f401-5dc6-8806-9bcec348b86b",
  "slug": "summer-fruit-tart-from-almond-breeze",
  "name": "Summer Fruit Tart from Almond Breeze\u00ae",
  "recipe_type": "dessert",
  "brief_description": "Bring summertime flavor anywhere with this easy mixed berry tart with almondmilk vanilla custard.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "To make custard whisk egg, corn starch and maple syrup together in a pan. Slowly whisk in almond milk over medium heat. Bring to a boil, whisking continuously, remove from heat and cool 5 minutes."
    },
    {
      "position": 2,
      "text": "Pour custard into tart crust and top with fruit."
    },
    {
      "position": 3,
      "text": "Refrigerate 30 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,

  "id": "b5938ee6-0a70-52b6-be6b-5b7ee9bbe81b",
  "slug": "veggie-pate",
  "name": "Veggie Pate",
  "recipe_type": "appetizer",
  "brief_description": "Sandwiches and crackers will be transformed into savory wonders by this flavorful spread filled with vegetables, herbs and spices.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease an 8x8 inch baking dish."
    },
    {
      "position": 2,
      "text": "In a food processor, blend sunflower seeds, whole wheat flour, nutritional yeast, salt, vegetable oil, lemon juice, potato, carrot, onion, celery, garlic, water, thyme, basil, sage, savory, pepper and dry mustard. Process the mixture until almost smooth."
    },
    {
      "position": 3,
      "text": "Transfer mixture to the baking dish. Bake in the preheated oven 1 hour, or until bubbly and lightly browned."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

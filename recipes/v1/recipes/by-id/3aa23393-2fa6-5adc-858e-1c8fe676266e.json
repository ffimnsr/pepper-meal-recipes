  "id": "3aa23393-2fa6-5adc-858e-1c8fe676266e",
  "slug": "4-ingredient-cookie-cobbler-recipe-11855147",
  "name": "Grab Just 4 Ingredients to Make This Cozy Cookie Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This 4-ingredient apple cookie cobbler is the easiest version of fruit cobbler ever made. Apple pie filling, topped with sugar cookie dough and dusted with cinnamon sugar, bakes into a delicious treat. Try it with any fruit pie filling.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C) and lightly grease the sides of a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Pour pie filling into the bottom of the dish. Break apart cookie dough into 10 to 12 smaller pieces and flatten them very slightly. Place them randomly over the top of the pie filling, covering as much of the top as possible, leaving some parts of pie filling uncovered."
    },
    {
      "position": 3,
      "text": "Stir together sugar and cinnamon in a small bowl and sprinkle mixture evenly over the top of cookie dough."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until lightly browned and bubbly, for 30 to 35 minutes. Serve with vanilla ice cream if desired."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 5,

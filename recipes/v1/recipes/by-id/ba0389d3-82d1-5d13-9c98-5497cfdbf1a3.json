  "id": "ba0389d3-82d1-5d13-9c98-5497cfdbf1a3",
  "slug": "air-fryer-lamb-chops-recipe-11694499",
  "name": "Air Fryer Lamb Chops",
  "recipe_type": "main",
  "brief_description": "These air fryer lamb chops marinate with minced fresh herbs, then cook to perfection in the air fryer in under 10 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine olive oil, lemon zest and juice, salt, pepper, garlic, oregano, mint, rosemary, and parsley in a large resealable plastic bag. Gently squeeze contents inside the bag to mix."
    },
    {
      "position": 2,
      "text": "Add lamb chops, squeeze out as much air as possible, reseal the bag, and marinate in the refrigerator for at least 2 hours, or up to 4 hours. Turn the bag after each hour, to marinate both sides of the chops."
    },
    {
      "position": 3,
      "text": "When ready to cook, preheat the air fryer to 400 degrees F (200 degrees C), or according to manufacturer's instructions."
    },
    {
      "position": 4,
      "text": "Add lamb chops to the air fryer in a single layer and air fry for 3 1/2 minutes."
    },
    {
      "position": 5,
      "text": "Turn chops and continue to air fry an additional 3 minutes. Test for doneness with an instant read thermometer. 120 degrees F (49 degrees C) is rare, 130 degrees F (54 degrees C) is medium, and 145 degrees F (63 degrees C) is medium well. Add time in 1-minute increments to achieve desired doneness."
    },
    {
      "position": 6,
      "text": "Tent with foil and allow to rest for 5 to 10 minutes before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": 10,
  "difficulty": "medium",

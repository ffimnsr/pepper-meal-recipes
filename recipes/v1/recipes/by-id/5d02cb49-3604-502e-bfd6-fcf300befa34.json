  "slug": "zombie-lips",
  "name": "Zombie Lips",
  "recipe_type": "appetizer",
  "brief_description": "Make these fun Halloween snacks with just three ingredients: apple, peanut butter, and cheesy fish crackers!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Core apple and cut into 8 slices. Spread 1 tablespoon peanut butter on 1 side of an apple slice. Press fish crackers tail-first into peanut butter to form teeth. Repeat with another apple slice and gently put on top of first slice to form a mouth. Repeat with remaining apple slices."
    }
  ],
  "servings": 4,

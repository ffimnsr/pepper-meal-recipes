  "slug": "potluck-ambrosia-recipe-11977607",
  "name": "Potluck Ambrosia",
  "recipe_type": "salad",
  "brief_description": "This potluck ambrosia comes together in minutes but needs to chill in the fridge for at least 1 hour. Perfect for any gatherings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine crushed pineapple, pineapple tidbits, maraschino cherries, oranges, optional mandarins, and coconut in a large bowl. Stir in sour cream and whipped topping and fold in marshmallows. Chill at least 1 hour before serving."
    }
  ],

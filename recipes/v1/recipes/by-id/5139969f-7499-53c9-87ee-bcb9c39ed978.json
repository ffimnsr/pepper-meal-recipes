  "slug": "easy-pumpkin-sausage-pancakes-recipe-11781759",
  "name": "Easy Pumpkin Sausage Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These easy pumpkin sausage pancakes are a fall breakfast treat! Fully cooked sausage patties are dipped in pumpkin pancake batter, then griddled until golden, and served with syrup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add pancake mix, pumpkin, and milk to a bowl and stir until well combined."
    },
    {
      "position": 2,
      "text": "Heat a nonstick skillet over medium heat. Working in batches, dip each sausage patty into pancake batter, and cook in the skillet until golden, 3 to 4 minutes per side."
    },
    {
      "position": 3,
      "text": "Serve immediately with syrup or refrigerate until ready to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,

  "id": "4801da4a-82e3-58c0-810e-42f2781c720b",
  "slug": "tortilla-wrap-taco-pizza-recipe-11897762",
  "name": "Tortilla Wrap Taco Pizza",
  "recipe_type": "main",
  "brief_description": "This tortilla wrap taco pizza begins with a quickly-sauteed mix of beans and ground beef. Filled tortilla halves are folded to look like pizza slices, and baked together in a round pan.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat a nonstick skillet over medium-high heat. Add beef and cook, crumbling with a spoon, until well browned and crumbled, 7 to 10 minutes. Stir in beans, taco seasoning, and 1/2 cup water. Cook until well combined and remove from heat."
    },
    {
      "position": 3,
      "text": "Cut each tortilla in half. Place about 1/2 cup beef mixture onto the center of each tortilla half and top with 1 tablespoon cheese. Fold each end of the tortilla over the filling so that it creates a triangular shape with a point at the bottom. Repeat with remaining tortillas and filling until you have 8 triangles."
    },
    {
      "position": 4,
      "text": "Arrange tortilla triangles in a circle in a round baking dish or pie plate and top with remaining cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese is bubbly and tortillas are toasted around the edges, about 15 minutes."
    },
    {
      "position": 6,
      "text": "Top with green onions and diced tomato and serve with desired toppings."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

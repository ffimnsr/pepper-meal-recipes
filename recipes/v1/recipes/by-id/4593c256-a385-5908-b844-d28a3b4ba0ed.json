  "id": "4593c256-a385-5908-b844-d28a3b4ba0ed",
  "slug": "simple-smoked-pork-butt",
  "name": "Simple Smoked Pork Butt",
  "recipe_type": "main",
  "brief_description": "Use this method for smoked pork butt seasoned with a simple brown sugar BBQ rub for tender, juicy, fall-apart meat every time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut a few slashes in a crosshatch pattern across the fat cap of the pork butt. Rub mustard on top. Massage BBQ rub into the meat, getting it into the cuts. Wrap with plastic wrap and refrigerate, 8 hours to overnight."
    },
    {
      "position": 2,
      "text": "Preheat a smoker to 250 degrees F (120 degrees C). Add wood chips according to manufacturer's instructions."
    },
    {
      "position": 3,
      "text": "Place pork butt on rack, with a drip pan underneath to minimize the mess. Smoke until internal temperature of meat reaches 200 to 203 degrees F (93 to 95 degrees C), 10 to 16 hours, depending on size of pork butt and outside temperature."
    },
    {
      "position": 4,
      "text": "Remove pork butt from smoker, wrap in foil, and let rest for 1 hour. Remove bone and shred pork."
    }
  ],
  "servings": 20,

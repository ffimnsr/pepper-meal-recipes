  "id": "d5c906b2-f43b-51f3-ba95-5ed9d1231ad7",
  "slug": "slow-cooker-lentil-soup-with-bacon",
  "name": "Slow Cooker Lentil Soup with Bacon",
  "recipe_type": "soup",
  "brief_description": "Perfect for lunch or dinner on a cold, wet day, this slow cooker lentil soup with bacon is simple to prepare and requires just a few ingredients.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Rinse lentils well under cold running water. Drain and transfer to a slow cooker. Pour in water until water level is twice as high as lentils. Add bay leaf and set slow cooker to High."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat onion and bacon in a skillet over medium heat. Cook until bacon is crispy, 5 to 10 minutes. Season with garlic powder and transfer bacon-onion mixture to the slow cooker."
    },
    {
      "position": 3,
      "text": "Cook on High until lentils are tender, about 5 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 305,
  "preparation_time_minutes": 10,

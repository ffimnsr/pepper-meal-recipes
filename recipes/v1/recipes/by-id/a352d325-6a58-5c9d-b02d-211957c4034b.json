  "id": "a352d325-6a58-5c9d-b02d-211957c4034b",
  "slug": "louisiana-yam-apple-medley",
  "name": "Louisiana Yam-Apple Medley",
  "recipe_type": "dessert",
  "brief_description": "Using canned yams and apples with a sweet mixture of pecans, sugar, and cinnamon makes a tasty side dish.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix the yams and apples, and place into the bottom of a 2-quart casserole dish. Stir the pecans, sugar, and cinnamon together in a bowl; scatter over the yams and apples. Drizzle the margarine over the mixture."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until the topping begins to brown, basting 1 or 2 times while cooking, about 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,

  "id": "ec1c0e45-a907-56cb-89e5-ba07bfbbe9ad",
  "slug": "mini-berry-pavlovas",
  "name": "Mini Berry Pavlovas",
  "recipe_type": "dessert",
  "brief_description": "Pavlova is a wonderful meringue-based dessert named after the Russian ballerina, Anna Pavlova. Garnished with whipped cream and fresh berries, it's a wonderful gluten-free treat.",
  "cuisine": "Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 275 degrees F (135 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Make meringue: Beat egg whites in a glass, metal, or ceramic bowl on medium speed with an electric mixer until soft peaks form, about 3 minutes. Slowly add sugar, cornstarch, and cream of tartar and continue beating on high speed until stiff, glossy peaks form, 3 to 5 minutes. Add vanilla and salt and beat until combined, about 30 seconds."
    },
    {
      "position": 3,
      "text": "Scoop meringue with a spring-hinged scoop onto the prepared baking sheet and shape into individual rounds about 3 inches in diameter. Use the back of a spoon to create an indentation in the center of each meringue."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until meringue is dry to the touch, about 1 hour 15 minutes. Transfer the parchment with meringues to a wire rack and allow to cool. Once cool to the touch, remove meringues from parchment and place directly on the rack to cool completely, about 1 hour."
    },
    {
      "position": 5,
      "text": "When ready to serve, top each meringue with whipped cream and garnish with fresh berries."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

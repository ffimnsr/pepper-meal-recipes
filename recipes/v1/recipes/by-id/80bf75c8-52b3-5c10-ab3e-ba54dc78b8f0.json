  "id": "80bf75c8-52b3-5c10-ab3e-ba54dc78b8f0",
  "slug": "empire-biscuits",
  "name": "Empire Biscuits",
  "recipe_type": "dessert",
  "brief_description": "This shortbread cookie is a traditional Scottish recipe. These are round cookies sandwiched with jam and topped off with a delicious icing and a cherry.",
  "cuisine": "Scottish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large bowl, cream together the butter and sugar until smooth. Gradually stir in the flour until well blended. On a lightly floured surface, roll the dough out to 1/4 inch thickness. Cut into rounds using a cookie cutter."
    },
    {
      "position": 3,
      "text": "Bake for 8 to 10 minutes in the preheated oven. Allow cookies to cool on baking sheet for 5 minutes before removing to a wire rack to cool completely. Sandwich one teaspoon of jam between two cookies. Repeat with remaining cookies. In a medium bowl, gradually stir the milk into the confectioners' sugar until the icing is of a spreadable consistency. Spread on top of the sandwiched cookies. Top each cookie with half of a cherry while the icing is still wet."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "d25b0c6f-3ec6-56cb-87fd-27a278297e50",
  "slug": "heathers-cilantro-black-bean-and-corn-salsa",
  "name": "Heather's Cilantro, Black Bean, and Corn Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This black bean and corn salsa is an easy dip to make with 2 types of corn, canned black beans, tomatoes, avocado, and lime for a colorful party snack.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir black beans, yellow and white corn, tomatoes, cilantro, green onions, red onion, bell pepper, and garlic together in a large bowl."
    },
    {
      "position": 3,
      "text": "Gently mix in lime juice and avocado."
    },
    {
      "position": 4,
      "text": "Drizzle with olive oil to serve."
    }
  ],
  "servings": 72,
  "cooking_time_minutes": null,

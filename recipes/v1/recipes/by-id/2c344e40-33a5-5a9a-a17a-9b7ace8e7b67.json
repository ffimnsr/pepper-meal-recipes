  "id": "2c344e40-33a5-5a9a-a17a-9b7ace8e7b67",
  "slug": "flourless-banana-pancakes",
  "name": "Flourless Banana Pancakes",
  "recipe_type": "dessert",
  "brief_description": "This banana pancake recipe with egg, ground flax seed, and vanilla is cooked in coconut oil for a quick and easy gluten-free, paleo breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together mashed banana and beaten eggs in a large bowl until smooth. Add ground flax seed and vanilla; mix until batter is well combined."
    },
    {
      "position": 2,
      "text": "Heat coconut oil in a large skillet over medium-low heat. Scoop batter, about 1/4 cup per pancake, onto the skillet and cook until the centers start to bubble, about 30 seconds. Flip pancakes and continue cooking until the bottoms are lightly browned, 1 to 2 minutes more. Repeat with remaining batter."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

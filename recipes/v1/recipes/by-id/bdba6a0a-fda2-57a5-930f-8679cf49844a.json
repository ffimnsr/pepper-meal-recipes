  "id": "bdba6a0a-fda2-57a5-930f-8679cf49844a",
  "slug": "easy-feta-stuffed-mushrooms",
  "name": "Easy Feta-Stuffed Mushrooms",
  "recipe_type": "appetizer",
  "brief_description": "Perfect to serve as either a party appetizer or side dish, these stuffed mushrooms filled with a tangy feta and spinach mixture are easy to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a baking sheet with cooking spray."
    },
    {
      "position": 2,
      "text": "Gently remove stems from mushroom caps. Dice stems and place in a bowl. Place caps on the prepared baking sheet with the open sides up."
    },
    {
      "position": 3,
      "text": "Heat 1 teaspoon oil in a skillet over low heat. Add spinach and cook until wilted, about 2 minutes."
    },
    {
      "position": 4,
      "text": "Add wilted spinach to the diced mushroom caps, along with feta cheese, garlic, and parsley. Mix until well combined."
    },
    {
      "position": 5,
      "text": "Scoop spinach mixture and fill each mushroom. Drizzle mushrooms with remaining 1 1/2 teaspoons."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown, about 20 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

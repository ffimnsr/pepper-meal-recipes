  "id": "2628daa5-96dc-57e4-9058-c86434dc3a92",
  "slug": "cathys-amazing-fish-chowder",
  "name": "Cathy’s Amazing Fish Chowder",
  "recipe_type": "soup",
  "brief_description": "This chowder can be made with any white fish, such as haddock or cod. It is comfort food that’s easy to make, wonderful to eat, and delicious served with crackers and cornbread.",
  "cuisine": "New England",
  "instructions": [
    {
      "position": 1,
      "text": "Cook bacon in a large stockpot over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain on a paper towel-lined plate; crumble and set aside. Drain bacon grease, reserving about 1 tablespoon in the pot."
    },
    {
      "position": 2,
      "text": "Add onion to reserved bacon grease; cook and stir over medium heat until tender, about 5 minutes. Add potatoes and fill the pot with just enough water to cover. Bring to a boil and cook until potatoes are almost tender, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Add fish, evaporated milk, whole milk, and butter; bring to a boil. Reduce heat to low and simmer for 30 minutes. Season with salt and pepper."
    },
    {
      "position": 4,
      "text": "Ladle chowder into bowls and top with crumbled bacon."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

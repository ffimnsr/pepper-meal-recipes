  "id": "587bb3c5-1eb2-5f08-9446-1a53af4a52fc",
  "slug": "anise-biscotti",
  "name": "Anise Biscotti",
  "recipe_type": "dessert",
  "brief_description": "Delicious, with a hint of licorice flavor. You can store these in an airtight container for over a month.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F. Line 2 cookie sheets with parchment paper or foil."
    },
    {
      "position": 2,
      "text": "In large mixing bowl, beat sugar and butter until light and fluffy. Add eggs one at a time, beating well after each addition. Combine brandy, anise extract and vanilla in a small bowl or measuring cup. In a medium bowl, combine flour, baking powder and salt. Alternately add dry ingredients and brandy mixture to the butter mixture, beginning and ending with the dry ingredients. Stir in the almonds and aniseed."
    },
    {
      "position": 3,
      "text": "Drop dough by spoonfuls onto prepared sheet, forming two 2 x 13-inch long strips on each sheet. Smooth dough into logs with moistened fingertips."
    },
    {
      "position": 4,
      "text": "Bake about30 to 35 minutes or until golden and firm to the touch. Place cookie sheets on racks and cool completely. Reduce the oven temperature to 300 degrees F."
    },
    {
      "position": 5,
      "text": "Cut cooled logs on the diagonal into 3/4-inch thick slices using a serrated knife. Place slices on cookie sheets."
    },
    {
      "position": 6,
      "text": "Bake for about 20 minutes, turning after 10 minutes, until dry and slightly brown. Remove to a rack and cool."
    }
  ],
  "servings": 60,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,

  "id": "8f64b1e6-80dc-570d-9a2c-3daab7faa3ba",
  "slug": "chocolate-protein-balls",
  "name": "Chocolate Protein Balls",
  "recipe_type": "appetizer",
  "brief_description": "An easy protein ball recipe using chocolate protein powder, peanut butter, oats, and seeds. These energy balls are perfect for after-school snacking.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine oats, peanut butter, honey, chocolate, flax seeds, chia seeds, and protein powder in a bowl until evenly mixed. Cover the bowl with plastic wrap; refrigerate at least 30 minutes."
    },
    {
      "position": 2,
      "text": "Scoop chilled mixture into balls. Keep cold until serving."
    },
    {
      "position": 3,
      "text": "Enjoy!"
    }
  ],
  "servings": 10,

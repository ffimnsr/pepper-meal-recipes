  "schema_version": 1,
  "id": "e28ff5a2-9a3e-58f3-8af2-4f26812a5b2c",
  "slug": "whole-wheat-pumpkin-bread",
  "name": "Whole Wheat Pumpkin Bread",
  "recipe_type": "breakfast",
  "brief_description": "This whole wheat pumpkin bread recipe is nicely spiced with cloves, cinnamon, and nutmeg and has crunchy walnuts and plump, juicy raisins in each bite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x5-inch loaf pan."
    },
    {
      "position": 2,
      "text": "Place raisins in a small bowl; cover with boiling water by 1 inch. Set aside until raisins are plump and rehydrated, 3 to 4 minutes; drain, reserving \u2153 cup soaking water in a separate bowl."
    },
    {
      "position": 3,
      "text": "Combine whole wheat flour, all-purpose flour, cinnamon, baking soda, baking powder, salt, cloves, and nutmeg in a large bowl. Combine pumpkin, sugar, eggs, reserved soaking water, and oil in a separate bowl; stir into flour mixture until just moistened. Fold in walnuts and raisins. Pour batter into the prepared loaf pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 50 to 55 minutes. Cool in the pan for 15 minutes, then remove from the pan and transfer loaf to a wire rack to cool completely."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

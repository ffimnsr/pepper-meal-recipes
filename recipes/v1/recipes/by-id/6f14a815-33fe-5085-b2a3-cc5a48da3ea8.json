  "slug": "easy-chocolate-bundt-cake-glaze",
  "name": "Easy Chocolate Bundt Cake Glaze",
  "recipe_type": "dessert",
  "brief_description": "This chocolate glaze for Bundt cake is simple to make and uses only three ingredients. Great over ice cream or on your favorite dessert as well.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine sweetened condensed milk and chocolate chips in a saucepan over medium heat. Cook, stirring constantly, until the chips are melted and the mixture is smooth. Do not allow it to bubble."
    },
    {
      "position": 2,
      "text": "Remove from heat and stir in vanilla. Cool slightly before drizzling over cake."
    }
  ],

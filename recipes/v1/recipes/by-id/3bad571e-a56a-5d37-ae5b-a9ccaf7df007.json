{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "3bad571e-a56a-5d37-ae5b-a9ccaf7df007",
  "slug": "pizza-bianca-with-prosciutto-recipe-7559275",
  "name": "Pizza Bianca with Prosciutto",
  "recipe_type": "main",
  "brief_description": "Grilling pizza allows for a beautiful crisp crust, and this pizza bianca with mozzarella and prosciutto will also be finished before most pizzerias could deliver.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a gas grill with all burners on High for 10 to 15 minutes."
    },
    {
      "position": 2,
      "text": "Shape pizza dough into an 8 to 10-inch disc. Brush dough with olive oil."
    },
    {
      "position": 3,
      "text": "Reduce the flame on half the grill burners to Low, to create areas of direct and indirect heat."
    },
    {
      "position": 4,
      "text": "Carefully place dough onto the grill over direct heat. Close the cover. Grill dough until bottom is just barely cooked and shows char marks, 1 to 3 minutes."
    },
    {
      "position": 5,
      "text": "Turn crust ninety degrees (do not flip dough over). Grill until crust shows light grill marks, 1 to 3 minutes."
    },
    {
      "position": 6,
      "text": "Carefully remove par-grilled dough from the grill. Spread ricotta over dough; sprinkle with salt and Italian seasoning. Place cheese on top, add prosciutto evenly over cheese."
    },
    {
      "position": 7,
      "text": "Return pizza to the grill over indirect heat; grill until cheese is melted, about 3 minutes. Carefully remove pizza from the grill."
    },
    {
      "position": 8,
      "text": "Preheat the oven\u2019s broiler."
    },
    {
      "position": 9,
      "text": "Broil pizza until cheese is golden, about 5 minutes. Sprinkle torn basil on top of pizza. Allow pizza to rest for a few minutes before cutting into wedges."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,

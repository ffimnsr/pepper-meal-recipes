  "id": "a17eafb4-48da-54a7-9dc4-36daf706a09d",
  "slug": "vegan-mushroom-ceviche",
  "name": "Vegan Mushroom Ceviche",
  "recipe_type": "appetizer",
  "brief_description": "This vegan mushroom ceviche is made with white mushrooms, carrots, tomatoes, and onion. It can be served as a dip or as a tostada topping.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large skillet over medium heat. Add garlic and cook for 10 seconds. Stir in mushrooms and season with salt; cook until soft, about 8 minutes. Remove from heat."
    },
    {
      "position": 2,
      "text": "Place mushrooms in a large bowl and add tomatoes, carrots, onion, cilantro, serrano pepper, and jalapeno pepper."
    },
    {
      "position": 3,
      "text": "Combine lime juice, tomato juice, ketchup, and pickle juice in a second bowl. Pour over mushroom mixture and let stand for 20 minutes. Serve garnished with avocado slices."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

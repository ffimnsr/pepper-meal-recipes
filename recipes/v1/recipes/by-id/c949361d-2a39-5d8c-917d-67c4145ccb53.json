  "id": "c949361d-2a39-5d8c-917d-67c4145ccb53",
  "slug": "arroz-rojo-mexican-red-rice",
  "name": "Arroz Rojo (Mexican Red Rice)",
  "recipe_type": "side",
  "brief_description": "This Mexican red rice with garlic and jalape\u00f1o is a deliciously savory tomato-flavored rice that makes an authentic side dish for Mexican meals.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Grate tomatoes into a bowl using a box grater; discard tomato skins."
    },
    {
      "position": 2,
      "text": "Heat vegetable oil in a heavy skillet over medium-high heat. Add onion; cook and stir until tender, about 5 minutes. Stir in garlic and cook until fragrant, about 1 minute."
    },
    {
      "position": 3,
      "text": "Stir in rice and cook, stirring often, until rice is lightly toasted, about 3 more minutes. Stir in grated tomato, chicken broth, and tomato sauce; bring mixture to a boil."
    },
    {
      "position": 4,
      "text": "Stir in jalape\u00f1o pepper, cilantro, and salt; reduce heat to low. Cover the skillet and simmer until liquid has been absorbed, about 15 minutes. Do not lift the cover while rice is cooking."
    },
    {
      "position": 5,
      "text": "Turn off the heat; let rice stand, covered, for 8 minutes. Fluff with a fork before transferring rice to a serving dish."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

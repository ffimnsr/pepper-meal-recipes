  "id": "ca48078c-a176-5cb1-be11-df993cb5d27a",
  "slug": "signature-pumpkin-pie",
  "name": "Signature Pumpkin Pie",
  "recipe_type": "dessert",
  "brief_description": "This pumpkin pie will be your signature dish this Thanksgiving! It's easy to make with condensed milk, eggs, spices, and canned pure pumpkin.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (218 degrees C). Place pie crust on a large foil-lined baking sheet."
    },
    {
      "position": 2,
      "text": "Mix together pumpkin, condensed milk, eggs, and pumpkin pie spice in a large bowl until smooth. Pour into crust."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 15 minutes. Reduce oven temperature to 350 degrees F (175 degrees C). Continue baking for 40 more minutes or until a knife inserted 1 inch from crust comes out clean. Cool completely on a wire rack. Serve with vanilla whipped cream."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 5,

  "slug": "cold-buffalo-chicken-dip",
  "name": "Cold Buffalo Chicken Dip",
  "recipe_type": "appetizer",
  "brief_description": "Skip the slow cooker and serve this cold Buffalo chicken dip, complete with blue cheese, bacon, and jalapeno, at your next party or potluck instead.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Dice cooked chicken tenders. Transfer to a large bowl and add mayonnaise, sour cream, Buffalo sauce, blue cheese, bacon, green onions, and jalapeno. Stir to combine."
    },
    {
      "position": 2,
      "text": "Allow to come together/thicken in the refrigerator for 1 hour before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

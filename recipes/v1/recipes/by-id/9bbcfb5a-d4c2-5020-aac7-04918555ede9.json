  "id": "9bbcfb5a-d4c2-5020-aac7-04918555ede9",
  "slug": "chicken-shepherds-pie",
  "name": "Chicken Shepherd's Pie",
  "recipe_type": "main",
  "brief_description": "This is not your typical Shepherd 's Pie. Chicken takes the place of ground beef, a whole head of roasted garlic is mashed into the potatoes, and the thyme and rosemary add a perfect touch. And there 's lots of cheese.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "To prepare roasted garlic: Cut head of garlic in half and drizzle with olive oil. Wrap in foil and bake at 400 degrees F (200 degrees C) for 45 minutes."
    },
    {
      "position": 2,
      "text": "Reduce oven temperature to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Peel, chop and boil potatoes until tender. Drain, then mash potatoes. Add butter, milk and roasted garlic and mix in. Set aside."
    },
    {
      "position": 4,
      "text": "Arrange chicken evenly in the bottom of a casserole dish, then sprinkle with spices, then layer peppers, corn and all but 1/4 cup cheese. Spread mashed potatoes on top, sealing everything in. Sprinkle with remaining cheese."
    },
    {
      "position": 5,
      "text": "Bake at 350 degrees F (175 degrees C) for 25 minutes or until brown around edges."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,

  "id": "9d6eefb6-1f93-5603-8ba0-329ba5e594d3",
  "slug": "balsamic-chicken-and-mushrooms-recipe-11940656",
  "name": "Balsamic Chicken and Mushrooms",
  "recipe_type": "main",
  "brief_description": "This balsamic chicken and mushrooms has bold balsamic flavor, balanced with honey and mustard. The chicken is moist, and tender, with succulent mushrooms bathed in zippy sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a 12-inch skillet over medium heat."
    },
    {
      "position": 2,
      "text": "Season chicken with 1/4 teaspoon salt and 1/4 teaspoon pepper. Add chicken to skillet. Cook until chicken is no longer pink in the center and lightly browned, turning once halfway through, 6 minutes. Remove chicken from skillet; keep warm."
    },
    {
      "position": 3,
      "text": "Add mushrooms to skillet. Cook until mushrooms are browned and their juices have evaporated, about 4 minutes."
    },
    {
      "position": 4,
      "text": "Stir in garlic. Cook and stir until fragrant, 1 minute."
    },
    {
      "position": 5,
      "text": "Add broth, vinegar, honey, mustard, and thyme to the skillet. Bring to a boil, stirring to scrape up browned bits with a wooden spoon. Reduce heat and simmer until liquid is reduced by half, about 4 minutes."
    },
    {
      "position": 6,
      "text": "Whisk butter into sauce until incorporated. Season with remaining 1/4 teaspoon salt and 1/4 teaspoon pepper."
    },
    {
      "position": 7,
      "text": "Return chicken to skillet, cover and heat through until a thermometer inserted into the thickest portion registers 165 degrees F (74 degrees C), 3 to 4 minutes."
    },
    {
      "position": 8,
      "text": "Garnish with additional fresh thyme."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "aeb08ad4-4b3d-5aee-9cf9-b5b13d246ed3",
  "slug": "apple-butter-snickerdoodles",
  "name": "Apple Butter Snickerdoodles",
  "recipe_type": "dessert",
  "brief_description": "Apple butter gives this snickerdoodle recipe a unique flavor twist that complements the buttery richness and cinnamon warmth of the classic cookie.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk flour, cream of tartar, baking soda, salt, \u00bc teaspoon cinnamon, and nutmeg together in a bowl until combined."
    },
    {
      "position": 2,
      "text": "Beat 1 \u00bd cups sugar and butter together in a bowl until creamy; stir in egg and vanilla extract until incorporated. Stir in apple butter until well combined. Stir in \u00bd flour mixture until combined; stir in remaining \u00bd flour mixture until no dry flour clumps remain. Cover the bowl with plastic wrap; refrigerate dough, 2 to 24 hours."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line 2 baking sheets with parchment paper."
    },
    {
      "position": 4,
      "text": "Combine remaining \u00bc cup sugar and 2 tablespoons cinnamon in a shallow bowl or pie plate. Drop tablespoonfuls of dough into cinnamon-sugar mixture; roll into balls, coating well. Place coated dough balls 1 inch apart onto the prepared baking sheets."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until edges are just set, about 10 minutes. Cool cookies on the baking sheets for 5 minutes before transferring to a wire rack to cool completely."
    }
  ],
  "servings": 46,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

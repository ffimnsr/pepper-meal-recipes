  "id": "e935d899-aa55-562b-9a67-c42551f42dd1",
  "slug": "one-pan-dirty-spaghetti-recipe-11930383",
  "name": "One-Pan Dirty Spaghetti",
  "recipe_type": "main",
  "brief_description": "Here's a method for making dirty spaghetti in one pan, which not only means fewer dishes, but the pasta absorbs more flavor than if boiled separately. Andouille, Worcestershire sauce, and lots of vegetables and seasonings make it really dirty, meaning really flavorful. Here, the term 'flavor bomb' is an understatement.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add oil to a deep skillet with a tight fitting lid and set over medium-high heat. Add ground beef, and cook, stirring, for 3 or 4 minutes, breaking the meat up into small crumbles while doing so."
    },
    {
      "position": 2,
      "text": "Once ground beef is browned, add onion, bell peppers, celery, and andouille sausage, and cook, stirring, for 2 more minutes. Season with onion powder, garlic powder, paprika, cumin, oregano, thyme, cayenne, black pepper, and salt, and cook, stirring, for 1 to 2 minutes more. Pour in broth and bring to a simmer."
    },
    {
      "position": 3,
      "text": "Break spaghetti in half and add to the pan. Distribute spaghetti as evenly as possible and cover the pan tightly. Cook on medium-high for 2 minutes. Uncover and give everything a stir. Repeat this process of uncovering, stirring, and covering every 2 minutes or so, until pasta is cooked to your desired doneness."
    },
    {
      "position": 4,
      "text": "Turn off the heat and drizzle in Worcestershire sauce, plus another pinch of salt if needed. Stir to combine, and serve in bowls topped with green onions."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

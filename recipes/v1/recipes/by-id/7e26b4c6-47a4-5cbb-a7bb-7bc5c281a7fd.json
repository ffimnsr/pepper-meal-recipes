{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "7e26b4c6-47a4-5cbb-a7bb-7bc5c281a7fd",
  "slug": "tiramoussa-semifreddo-frozen-italian-coffee-dessert",
  "name": "Tiramoussa Semifreddo \u2013 Frozen Italian Coffee Dessert",
  "recipe_type": "dessert",
  "brief_description": "This semifreddo has all the flavors of tiramisu and is the perfect dessert to serve after a holiday meal.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine egg yolks, instant dark roast coffee, marsala wine, and sugar in a metal bowl and whisk together until smooth."
    },
    {
      "position": 3,
      "text": "Place bowl in the top of a double boiler over lightly simmering water. Whisk constantly until mixture thickens and drippings from the whisk form ribbons on the surface that are visible for 1/2 second to 1 second, about 10 minutes. If you are \"brave\", you can set the bowl directly over medium-low heat and thicken the egg cream that way, but you have to be careful so you don't end up with scrambled eggs. This last method is slightly faster and will take about 6 to 7 minutes."
    },
    {
      "position": 4,
      "text": "Beat egg whites in a glass, metal, or ceramic bowl until foamy. Gradually add salt and continue to beat until stiff peaks form. Set aside."
    },
    {
      "position": 5,
      "text": "Beat heavy cream in a chilled glass or metal bowl with an electric mixer until medium-stiff peaks form."
    },
    {
      "position": 6,
      "text": "Using a spatula, fold in egg yolk mixture until combined."
    },
    {
      "position": 7,
      "text": "Add half of the egg whites and fold in until combined. Then fold in remaining egg whites until well combined."
    },
    {
      "position": 8,
      "text": "Transfer mixture into small 4 ounce jam jars and close with lids. Freeze for 4 hours or overnight."
    },
    {
      "position": 9,
      "text": "Garnish and enjoy!"
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,

  "id": "2d8e6302-15e0-5285-8450-954af83e9eac",
  "slug": "authentic-chicken-adobo",
  "name": "Authentic Chicken Adobo",
  "recipe_type": "main",
  "brief_description": "This authentic chicken adobo recipe is a delicious Filipino dish. The chicken is marinated in vinegar and soy sauce, then cooked with garlic and spices.",
  "cuisine": "Filipino Asian Latin",
  "instructions": [
    {
      "position": 1,
      "text": "Combine vinegar, soy sauce, \u00bd chopped garlic, bay leaves, garlic powder, 1 \u00bd teaspoons annatto powder, and black pepper in a large bowl. Add chicken, stir to coat, cover the bowl with plastic wrap, and marinate in the refrigerator for at least 4 hours."
    },
    {
      "position": 2,
      "text": "Remove chicken from marinade, shake off excess, and pat dry. Reserve remaining marinade."
    },
    {
      "position": 3,
      "text": "Heat 2 tablespoons vegetable oil in a large skillet over medium-high heat. Add chicken; cook until brown, about 4 minutes per side. Off heat, set skillet aside."
    },
    {
      "position": 4,
      "text": "Heat remaining 1 tablespoon vegetable oil in a small skillet over medium heat. Add remaining \u00bd chopped garlic; cook and stir until brown, about 3 minutes. Add remaining 1 \u00bd teaspoons annatto powder, reduce heat, and simmer, about 3 minutes."
    },
    {
      "position": 5,
      "text": "Pour annatto mixture over chicken; add reserved marinade. Bring to a simmer, cover, and cook until chicken is tender, about 45 minutes. Uncover; cook until sauce has reduced slightly, about 10 minutes more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 90,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

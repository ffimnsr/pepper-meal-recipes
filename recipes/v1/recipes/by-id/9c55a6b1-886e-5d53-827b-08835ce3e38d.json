  "id": "9c55a6b1-886e-5d53-827b-08835ce3e38d",
  "slug": "spanish-garlic-shrimp-gambas-al-ajillo",
  "name": "Spanish Garlic Shrimp (Gambas al Ajillo)",
  "recipe_type": "appetizer",
  "brief_description": "Gambas al ajillo are a classic Spanish tapas dish of juicy shrimp in garlic-infused olive oil with smoky paprika and sherry that cooks in minutes.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place shrimp in a large bowl and season with paprika and kosher salt; mix well to coat."
    },
    {
      "position": 3,
      "text": "Slice garlic into thin slices. Heat oil in a skillet over medium heat; add garlic and cook until golden, about 2 minutes."
    },
    {
      "position": 4,
      "text": "Add shrimp and increase heat to high. Toss and turn shrimp with tongs until starting to curl but still undercooked, about 2 minutes."
    },
    {
      "position": 5,
      "text": "Pour in sherry. Cook, stirring continuously, until sauce comes up to a boil and shrimp is cooked through, about 1 minute more."
    },
    {
      "position": 6,
      "text": "Remove from heat. Stir in parsley."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "850a6f41-a62b-59ff-9576-28d081c20b3c",
  "slug": "frittata-with-leftover-greens",
  "name": "Frittata with Leftover Greens",
  "recipe_type": "breakfast",
  "brief_description": "For this frittata with leftover greens recipe, leftover greens, such as Swiss chard, spinach, or kale, are perfect in this lovely breakfast frittata.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Set an oven rack in the upper third of the oven and preheat the oven's broiler."
    },
    {
      "position": 2,
      "text": "Beat eggs and egg whites together in a mixing bowl until smooth. Whisk in parsley, 1/4 teaspoon salt, and 1/4 teaspoon black pepper until evenly blended; set aside."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a 10-inch cast-iron skillet over medium heat. Add onion, remaining 1/4 teaspoon salt, and remaining 1/4 teaspoon black pepper; cook and stir until onion softens and turns translucent, about 5 minutes. Stir in tomatoes; cook 1 minute. Add cooked Swiss chard; cook and stir until heated through. Pour in egg mixture, cover, and cook until edges of eggs are set, about 5 minutes. Uncover; sprinkle with Parmesan cheese."
    },
    {
      "position": 4,
      "text": "Cook in the preheated broiler until cheese is golden brown and center of frittata has set, about 2 minutes. Let stand before serving, 3 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

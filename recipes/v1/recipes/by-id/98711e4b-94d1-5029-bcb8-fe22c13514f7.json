  "id": "98711e4b-94d1-5029-bcb8-fe22c13514f7",
  "slug": "creamy-chicken-tortellini-soup",
  "name": "Creamy Chicken Tortellini Soup",
  "recipe_type": "soup",
  "brief_description": "Using canned cream of chicken as a base, you can have a quick and simple pot of tortellini soup by adding the pasta, more cooked chicken, and spinach.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a saucepan of water to a boil. Cook chicken in boiling water until no longer pink in the center, 7 to 10 minutes; drain."
    },
    {
      "position": 2,
      "text": "Bring chicken broth to a boil in a soup pot; add cheese tortellini, reduce heat to medium-low, and cook until tortellini are cooked through and firm to the bite, about 8 minutes. Stir chicken, cream of chicken soup, half-and-half, spinach, thyme, and black pepper with the tortellini; bring to a simmer and continue cooking until hot, 7 to 10 minutes. Serve hot."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,

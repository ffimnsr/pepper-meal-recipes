  "id": "504b5e09-42f2-5c6d-ab7f-c838cd3e7a9c",
  "slug": "zucchini-scallion-frittata-cups",
  "name": "Zucchini Scallion Frittata Cups",
  "recipe_type": "breakfast",
  "brief_description": "These portion-controlled, protein-packed portable egg, zucchini, and scallion cups are excellent for on-the-go lifestyles.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Prepare 12 muffin cups with cooking spray."
    },
    {
      "position": 2,
      "text": "Whisk egg whites, eggs, and half-and-half together in a bowl. Stir zucchini, green onion, and cheese into egg mixture; pour into prepared muffin cups."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until set in the middle, 30 to 35 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

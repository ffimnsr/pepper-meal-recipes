  "id": "e4fda900-c82e-5c1b-8501-31c89a09d2ed",
  "slug": "harissa-roasted-carrots-recipe-11861187",
  "name": "Harissa Roasted Carrots",
  "recipe_type": "dessert",
  "brief_description": "Harissa roasted carrots are a quick, vibrant side dish made by tossing rainbow carrots with olive oil, harissa, honey, and salt, then roasting until tender and lightly caramelized. The subtle heat of the harissa and the sweetness of the honey create a bold, balanced flavor, finished with a touch of fresh parsley.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Stir olive oil, harissa, honey, and salt together in a large bowl."
    },
    {
      "position": 3,
      "text": "Trim and peel carrots. If carrots are larger than 3/4-inch in diameter, cut in half lengthwise. Toss carrots in harissa mixture until coated. Spread carrots in a single layer on the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Roast in the preheated oven for about 20 to 25 minutes, flipping halfway. The carrots should be tender with some caramelized edges. Transfer to a serving dish and garnish with parsley."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

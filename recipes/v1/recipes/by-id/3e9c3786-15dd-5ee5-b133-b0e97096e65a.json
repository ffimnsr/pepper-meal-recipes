  "id": "3e9c3786-15dd-5ee5-b133-b0e97096e65a",
  "slug": "swedish-apple-pie",
  "name": "Swedish Apple Pie",
  "recipe_type": "dessert",
  "brief_description": "This juicy apple pie has a crumble topping consisting of pecans, cinnamon and sugar. The pecan topping makes this pie different from most traditional apple pies.",
  "cuisine": "Swedish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9 inch pie pan with margarine."
    },
    {
      "position": 2,
      "text": "Fill 2/3 of the pan with sliced apples. Sprinkle with cinnamon and 1 teaspoon sugar."
    },
    {
      "position": 3,
      "text": "In a medium bowl, mix 1 cup sugar with the melted margarine. Stir in pecans, flour, egg and salt. Mix well. Spread mixture over the apples."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven for 65 minutes, or until golden brown."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

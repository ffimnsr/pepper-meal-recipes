  "schema_version": 1,
  "id": "365fe325-c951-5f03-b1a9-6fd1e363a9ce",
  "slug": "fettuccine-alfredo-with-chicken",
  "name": "Fettuccine Alfredo with Chicken",
  "recipe_type": "main",
  "brief_description": "This fettuccine Alfredo has creamy sauce, succulent chicken, perfectly al dente pasta, and a sprinkle of fresh herbs... All that's missing is the waiter and the check.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Cook fettuccine at a boil until tender yet firm to the bite, about 8 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat large nonstick skillet sprayed with cooking spray on medium-high heat. Add chicken; cook, stirring occasionally, until chicken is done, 5 to 7 minutes. Remove from the skillet."
    },
    {
      "position": 3,
      "text": "Mix broth and flour into the same skillet. Stir in Neufch\u00e2tel cheese, 2 tablespoons Parmesan, garlic powder, and pepper; cook, whisking constantly, until mixture boils and thickens, about 2 minutes. Stir in chicken."
    },
    {
      "position": 4,
      "text": "Place cooked fettuccine in a large serving bowl. Add chicken mixture; toss to coat. Sprinkle with remaining 1 tablespoon Parmesan."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

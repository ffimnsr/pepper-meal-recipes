  "id": "c72e9698-bb45-5684-8ace-36944d1be1c0",
  "slug": "moms-mexican-cornbread",
  "name": "Mom's Mexican Cornbread",
  "recipe_type": "side",
  "brief_description": "This cornbread is filled with ground beef, cream-style corn, cheese, and jalapeno peppers.",
  "cuisine": "Mexican Inspired American Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 9X12-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium heat. Add ground beef; cook and stir until no longer pink. Set aside."
    },
    {
      "position": 3,
      "text": "Whisk cornmeal, salt, and baking soda together in a large bowl. Stir in corn, milk, Cheddar cheese, onion, jalape\u00f1os, and egg. Stir in browned beef; pour into the prepared baking dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, about 1 hour."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

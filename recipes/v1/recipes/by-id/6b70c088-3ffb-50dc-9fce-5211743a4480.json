  "id": "6b70c088-3ffb-50dc-9fce-5211743a4480",
  "slug": "best-ever-chocolate-chip-cookies-iii",
  "name": "Best Ever Chocolate Chip Cookies",
  "recipe_type": "dessert",
  "brief_description": "This chocolate chip cookie recipe is made without brown sugar and may be the best you\u2019ve ever tasted. Be prepared to share the recipe with friends.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Sift flour, baking soda, and salt together into a bowl."
    },
    {
      "position": 3,
      "text": "Beat butter and sugar together in a large bowl with an electric mixer until smooth. Add eggs, one at a time, mixing well after each addition. Stir in vanilla. Gradually mix in dry ingredients until a soft dough forms. Stir in chocolate chips, white chocolate chips, and walnuts until incorporated. Drop dough by spoonfuls onto ungreased baking sheets, spacing about 2 inches apart."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until light golden brown, 8 to 11 minutes. Remove from the oven and cool on the baking sheets for 5 minutes before removing to a wire rack to cool completely."
    }
  ],
  "servings": 42,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

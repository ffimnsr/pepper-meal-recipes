  "id": "0558f1b7-10d0-574d-9ab8-3b4c32a6f3eb",
  "slug": "crispy-lemon-feta-potato-salad-recipe-11768345",
  "name": "Crispy Lemon Feta Potato Salad",
  "recipe_type": "salad",
  "brief_description": "This crispy lemon feta potato salad is a hybrid between smashed potatoes and a vinegary warm potato salad\u2014absolutely delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place potatoes in a large saucepan. Fill with enough water to cover potatoes. Bring to a boil, then reduce heat to medium-low. Cook potatoes until tender but not mushy, 10 to 15 minutes. Drain potatoes in a colander. Transfer to a bowl. Let cool and dry out a little, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a 10x15-inch baking sheet with foil. Drizzle cooled potatoes with 2 tablespoons olive oil and sprinkle with salt and pepper; toss to coat."
    },
    {
      "position": 4,
      "text": "Place potatoes in a single layer on the prepared baking sheet. Use a potato masher or the heel of your hand to lightly press down on potatoes to crush them."
    },
    {
      "position": 5,
      "text": "Bake potatoes until just beginning to crisp on the bottoms, 20 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, whisk remaining 2 tablespoons olive oil, lemon juice, garlic, and Greek seasoning in a small bowl until well combined. Spoon the oil mixture over each smashed potato."
    },
    {
      "position": 7,
      "text": "Return potatoes to the oven and continue baking until bottoms are crispy, about 10 minutes more."
    },
    {
      "position": 8,
      "text": "Transfer crispy potatoes to a shallow serving bowl and add the feta cheese, green onion, and parsley; gently toss to combine. Serve warm with lemon wedges."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

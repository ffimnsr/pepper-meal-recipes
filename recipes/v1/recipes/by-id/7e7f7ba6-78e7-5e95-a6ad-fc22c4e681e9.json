  "id": "7e7f7ba6-78e7-5e95-a6ad-fc22c4e681e9",
  "slug": "orange-party-cake-i",
  "name": "Orange Party Cake",
  "recipe_type": "dessert",
  "brief_description": "This orange party cake recipe is from my grandmother in Tennessee. She made it for my family on every visit for 25 years. I make it for my family now.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 10-inch Bundt pan."
    },
    {
      "position": 2,
      "text": "Stir gelatin mix and cake mix together in a medium bowl. Add eggs, oil, water, and vanilla; beat with an electric mixer on high speed for 3 minutes. Pour batter into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 35 to 40 minutes. Be careful not to overbake. Cool for 15 minutes in the pan before inverting onto a wire rack to cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,

  "id": "01dd0761-8e73-5bd1-a6ae-a75036ede815",
  "slug": "mexican-street-corn-inspired-bean-salad-recipe-12010504",
  "name": "Mexican Street Corn-Inspired Bean Salad",
  "recipe_type": "salad",
  "brief_description": "This Mexican street corn-inspired bean salad is coated in a creamy lime-and-chili dressing and made hearty with black beans. It\u2019s a novel bean salad with elote flavors and a snap to put together.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together mayonnaise, lime juice, garlic powder, cumin, and chili-lime seasoning in a large bowl until smooth."
    },
    {
      "position": 2,
      "text": "Add black beans, corn, red onion, jalape\u00f1o, cotija cheese, and 1/3 cup cilantro. Gently stir until well coated."
    },
    {
      "position": 3,
      "text": "Garnish with additional chopped jalape\u00f1os and cilantro. Serve immediately, or cover and refrigerate up to 3 days before serving. Recipe developed by Jaelyn Luong"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

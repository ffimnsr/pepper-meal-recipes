  "slug": "marinated-feta",
  "name": "Marinated Feta",
  "recipe_type": "appetizer",
  "brief_description": "Never be unprepared for guests with this quick and flavorful marinated feta appetizer that blends olive oil with fresh seasonings and peppers.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place a layer of olives, sage, garlic, chile pepper, rosemary, bell pepper, sesame-ginger seasoning, pepperoncini pepper, and oregano into the bottom of a container. Add a layer of feta cheese. Repeat layering with remaining ingredients."
    },
    {
      "position": 2,
      "text": "Pour olive oil into the container to cover feta mixture completely. Cover and refrigerate until serving."
    }
  ],
  "servings": 6,

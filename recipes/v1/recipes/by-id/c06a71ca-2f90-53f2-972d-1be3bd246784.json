{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "c06a71ca-2f90-53f2-972d-1be3bd246784",
  "slug": "cheesy-chicken-zucchini-casserole-recipe-8630175",
  "name": "Cheesy Chicken Zucchini Casserole",
  "recipe_type": "main",
  "brief_description": "This cheesy chicken zucchini casserole builds on leftover chicken and zucchini, aided by some aromatics and a tasty cheese sauce. It\u2019s then topped off with buttery cracker crumbs for a little crunch, and flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray the bottom and sides of a 3 1/2-quart baking dish with butter flavor cooking spray."
    },
    {
      "position": 2,
      "text": "Combine cracker crumbs and melted butter in a medium mixing bowl. Sprinkle 1/2 cup of the buttered crumbs in the bottom of the dish. Reserve remaining crumbs for the topping."
    },
    {
      "position": 3,
      "text": "Layer chopped chicken evenly on top of crumbs."
    },
    {
      "position": 4,
      "text": "In a large, non-stick skillet, melt 1 tablespoon unsalted butter over medium heat. When butter sizzles, add sliced zucchini and diced onions. Cook, tossing and stirring, until vegetables just begin to soften, 3 to 4 minutes. Add garlic, salt, and pepper, and cook just until garlic is fragrant, an additional 30 seconds."
    },
    {
      "position": 5,
      "text": "Layer cooked vegetables evenly over chopped chicken in the casserole dish."
    },
    {
      "position": 6,
      "text": "To make cheese sauce, melt remaining 3 tablespoons butter in the same skillet over medium heat. Stir in flour, mixing until all the flour is coated in butter, and cook about 1 minute, stirring continuously."
    },
    {
      "position": 7,
      "text": "While stirring, gradually pour in milk, making sure to flatten any lumps. Continue to stir, until the sauce begins to thicken and bubble, 1 to 2 minutes."
    },
    {
      "position": 8,
      "text": "Remove the skillet from the heat; stir in Old English Cheese Spread until melted and well blended. Adjust seasonings, if necessary. Pour sauce over vegetables, top with remaining buttered crumbs."
    },
    {
      "position": 9,
      "text": "Bake in the center of the preheated oven until the casserole is bubbly and lightly browned, 30 to 40 minutes. Allow to cool about 5 minutes, and serve warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "f278c83d-c64a-517f-8ac0-372e4ec63fa8",
  "slug": "grandmas-yorkshire-pudding",
  "name": "Grandma's Yorkshire Pudding",
  "recipe_type": "side",
  "brief_description": "These are delicious Yorkies! Very easy, too! Serve Yorkshire pudding with roast beef or pork, as this recipe requires meat drippings.",
  "cuisine": "English",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (220 degrees C). Place about a tablespoon of beef drippings into each cup of a 6-cup muffin tin."
    },
    {
      "position": 2,
      "text": "Whisk eggs in a medium bowl until well-blended. Stir in milk, flour, and salt. Fill the muffin cups about halfway."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 15 minutes, then reduce the oven temperature to 350 degrees F (175 degrees C) and bake for an additional 15 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

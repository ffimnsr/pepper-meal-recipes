{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "be526da7-aedd-56e1-91d6-b26df29a8491",
  "slug": "easy-st-louis-style-pork-ribs-on-gas-grill",
  "name": "Easy St. Louis-Style Pork Ribs on Gas Grill",
  "recipe_type": "main",
  "brief_description": "This St. Louis-style pork ribs on gas grill recipe steams the ribs for maximum moisture, then bastes them with BBQ sauce for fall-off-the-bone results.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor gas grill for indirect heat, and lightly oil the grate. Heat one side of the grill to 300 degrees F (150 degrees C)."
    },
    {
      "position": 2,
      "text": "Fill a small metal container with water. Cover with aluminum foil; make several slits in the foil. Place on the preheated side of the grill."
    },
    {
      "position": 3,
      "text": "Place ribs, bone-side up, on the unheated side of the grill; close the grill. Cook for 1 1/2 hours. Flip ribs and continue cooking until meat shrinks back from bones, about 1 1/2 hours more."
    },
    {
      "position": 4,
      "text": "Baste ribs with barbecue sauce. Transfer to heated side of the grill; cook for 2 minutes with the lid closed. Flip and baste second side with sauce. Cook for 2 minutes with lid closed. Flip and baste first side again with more sauce. Cook for 2 minutes with lid closed."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 190,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "expert",

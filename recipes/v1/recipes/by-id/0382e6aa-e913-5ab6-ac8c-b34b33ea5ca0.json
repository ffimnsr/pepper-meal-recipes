  "slug": "copycat-taco-bell-taco-meat-recipe-12024717",
  "name": "Copycat Taco Bell Taco Meat",
  "recipe_type": "salad",
  "brief_description": "This copycat Taco Bell taco meat delivers the familiar flavor of the fast food favorite right from your own kitchen. Seasoned with homemade Taco Bell copycat seasoning, it\u2019s perfect for tacos, enchiritos, taco salads, burritos, nachos, and just about any other drive-thru dish you can think of.",
  "cuisine": "American Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "Place meat in a deep skillet over medium-high heat. Add just enough water to reach about halfway up the sides of the skillet. Use a potato masher to break up the meat in the water into very small pieces. Bring to a boil and cook until meat is browned and water has reduced to about 1 cup, about 10 minutes."
    },
    {
      "position": 2,
      "text": "Add taco seasoning and stir until well combined. Reduce heat to a simmer and cook, stirring occasionally, until saucy and slightly thickened, about 5 minutes. Remove from heat and keep warm until ready to serve."
    }
  ],
  "servings": 8,

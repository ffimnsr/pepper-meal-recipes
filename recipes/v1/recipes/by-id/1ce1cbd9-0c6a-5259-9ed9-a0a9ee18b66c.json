  "schema_version": 1,
  "id": "1ce1cbd9-0c6a-5259-9ed9-a0a9ee18b66c",
  "slug": "chile-garlic-bbq-salmon",
  "name": "Chile Garlic BBQ Salmon",
  "recipe_type": "drink",
  "brief_description": "Whole salmon gets a spicy Asian treatment, with soy sauce, ginger, hot chili sauce, brown sugar, and lime juice. Bundled up in foil and cooked on the grill, it's perfect for summer-time get togethers.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Prepare outdoor grill for high heat."
    },
    {
      "position": 2,
      "text": "Trim the tail and fins off of the salmon. Make several shallow cuts across the salmon's skin. Place salmon on 3 large, slightly overlapping sheets of aluminum foil."
    },
    {
      "position": 3,
      "text": "In a bowl, stir together soy sauce, chile sauce, ginger, and garlic. Mix in lime juice, lime zest, and brown sugar. Spoon sauce over the salmon."
    },
    {
      "position": 4,
      "text": "Fold the foil over the salmon, and crimp the edges to seal."
    },
    {
      "position": 5,
      "text": "If using hot coals, move them to one side of the grill. Place the fish on the side of the grill that does not have coals directly underneath it, and close the lid. If using a gas grill, place the fish on one side, and turn off the flames directly underneath it; close the lid. Cook for 25 to 30 minutes. Remove to a serving platter, and pour any juices that may have collected in the foil over the top of the fish. Sprinkle with green onions."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

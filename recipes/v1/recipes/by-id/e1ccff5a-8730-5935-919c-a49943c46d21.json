  "id": "e1ccff5a-8730-5935-919c-a49943c46d21",
  "slug": "pumpkin-nut-muffins",
  "name": "Pumpkin Nut Muffins",
  "recipe_type": "breakfast",
  "brief_description": "This quick and easy pumpkin nut muffin recipe features buttermilk for subtle tang and a touch of ginger and molasses for a rich complexity of flavors.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 12-cup muffin tins or line cups with paper liners."
    },
    {
      "position": 2,
      "text": "Whisk flour, baking soda, baking powder, cinnamon, nutmeg, and ginger together on wax paper."
    },
    {
      "position": 3,
      "text": "Beat sugar, pumpkin pur\u00e9e, buttermilk, melted butter, eggs, molasses, and vanilla extract together in a bowl; stir in flour mixture until just moistened. Fold in pecans."
    },
    {
      "position": 4,
      "text": "Divide batter among the prepared muffin cups, filling each almost to the top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, 20 to 25 minutes. Cool in the tins for 5 minutes, before transferring muffins to a wire rack to cool. Serve warm."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "406bcd9a-e2b3-5854-8bb4-9087b77bf743",
  "slug": "mustard-sauce-for-corned-beef",
  "name": "Mustard Sauce for Corned Beef",
  "recipe_type": "dessert",
  "brief_description": "This tangy, sweet mustard sauce for corned beef is super easy to prepare with basic pantry ingredients to complete your St. Patrick's Day meal.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a saucepan over low heat; remove from heat."
    },
    {
      "position": 2,
      "text": "Whisk brown sugar, white sugar, mustard, egg, salt, and pepper together in a medium bowl. Whisk in vinegar until well combined. Stir mixture into melted butter in the saucepan."
    },
    {
      "position": 3,
      "text": "Stir sauce over medium heat until boiling. Reduce heat and simmer for 3 minutes more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

  "id": "7a2c31c2-1969-568f-9bce-b8e320a93801",
  "slug": "butter-rich-spritz-butter-cookies",
  "name": "Butter Rich Spritz Butter Cookies",
  "recipe_type": "dessert",
  "brief_description": "This butter-rich spritz butter cookies recipe makes a large batch of melt-in-your-mouth cookies to decorate with colored sugar for any holiday.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Sift flour and salt together; set aside."
    },
    {
      "position": 2,
      "text": "Beat confectioners' sugar and butter together in a medium bowl with an electric mixer until light and fluffy."
    },
    {
      "position": 3,
      "text": "Stir in egg yolks, vanilla extract, and almond extract."
    },
    {
      "position": 4,
      "text": "Gradually blend in sifted flour mixture."
    },
    {
      "position": 5,
      "text": "Fill a cookie press with dough; press cookies about 1 \u00bd inches apart onto an ungreased cookie sheet. Decorate with colored sugar or sprinkles, if desired."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until edges are just set and bottoms are light golden, 6 to 8 minutes. Let cool on the baking sheet briefly before transferring to a wire rack to cool completely."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "fbc2cfe5-e3ab-54e2-b67b-669987ffa12e",
  "slug": "garlic-butter-grilled-cheese-hotdog-recipe-11763786",
  "name": "Garlic Butter Grilled Cheese Hot Dog",
  "recipe_type": "main",
  "brief_description": "These garlic butter grilled cheese hot dogs are all about the buns. First brushed with garlic butter, skillet-toasted, and added to the skillet again over shredded cheese until melted, these buns are the bomb.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Score hot dogs, brush with garlic butter, and place on a baking sheet."
    },
    {
      "position": 2,
      "text": "Bake hot dogs in the preheated oven until nicely browned, 6 to 8 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, brush insides of hot dog buns with garlic butter; toast buns in a large skillet over medium heat until golden brown. Set aside."
    },
    {
      "position": 4,
      "text": "In the same skillet, lay down 1/4 cup cheese and place a bun face down on top of cheese. Cook undisturbed until cheese is melted. Remove from skillet and repeat with remaining buns."
    },
    {
      "position": 5,
      "text": "Place hot dogs in prepared buns and serve immediately."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

  "id": "6c918fd5-ea96-50a0-8afa-b7316b6cbd8a",
  "slug": "apple-cider-doughnuts",
  "name": "Apple Cider Doughnuts",
  "recipe_type": "breakfast",
  "brief_description": "This apple cider doughnuts recipe makes old-fashioned cider doughnuts dusted with cinnamon-sugar for a perfect treat that's delicious any time of year.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix 1 cup sugar and 1 tablespoon cinnamon together in a resealable plastic bag."
    },
    {
      "position": 2,
      "text": "Bring apple cider to a boil in a medium saucepan; cook, stirring occasionally, until cider has reduced to 1/2 cup, about 20 minutes. Remove from heat and cool."
    },
    {
      "position": 3,
      "text": "Whisk 1 cup flour, remaining 1 cup sugar, baking powder, 2 teaspoons cinnamon, and salt together in a large bowl."
    },
    {
      "position": 4,
      "text": "Mix butter, eggs, egg yolk, and cider together in a medium bowl until smooth; stir into flour mixture. Stir remaining 2 3/4 cups flour into mixture until a smooth dough forms; refrigerate for 10 minutes."
    },
    {
      "position": 5,
      "text": "Heat oil in a large pot or deep fryer to 375 degrees F (190 degrees C)."
    },
    {
      "position": 6,
      "text": "Turn dough onto a well-floured surface; pat dough to 1/2-inch thickness with floured fingers. Cut dough with a doughnut cutter or 2 round cookie cutters (1 large and 1 small). Gather scraps and re-pat dough to cut out as many doughnuts as possible."
    },
    {
      "position": 7,
      "text": "Fry doughnuts, in batches, until they rise to the surface and begin to brown, 2 to 3 minutes. Flip; continue frying until brown, about 1 1/2 minutes more."
    },
    {
      "position": 8,
      "text": "Remove doughnuts with a slotted spoon to a paper towel-lined plate; cool, about 1 minute. Toss in reserved bag of cinnamon sugar."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,

  "id": "f08ef2dd-f99d-5582-ab7f-6f0bd64acb3a",
  "slug": "cuban-style-sliders-recipe-7254949",
  "name": "Cuban-Style Sliders",
  "recipe_type": "appetizer",
  "brief_description": "These Cuban-style sliders are filled with honey mustard, ham, Swiss cheese, and pickles on Hawaiian rolls. Topped with a cornichon they will surely hit the spot!",
  "cuisine": "Caribbean",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Holding your knife parallel to the cutting board, halve Hawaiian rolls horizontally. Put roll bottoms in a 2-quart rectangular baking dish."
    },
    {
      "position": 3,
      "text": "Spread cut sides of roll bottoms and tops with honey mustard. On roll bottoms, layer deli ham, sliced Swiss cheese, and dill pickle slices. Replace roll tops. Brush roll tops with butter and sprinkle with poppy seeds. Cover baking dish"
    },
    {
      "position": 4,
      "text": "Bake, covered, in the preheated oven for 15 minutes. Remove cover and continue baking uncovered until filling is hot and roll tops are lightly browned, 10 to 15 minutes more."
    },
    {
      "position": 5,
      "text": "Remove from oven and let cool for 5 minutes."
    },
    {
      "position": 6,
      "text": "Cut into individual sliders. Attach 1 cornichon on top of each slider with a toothpick."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

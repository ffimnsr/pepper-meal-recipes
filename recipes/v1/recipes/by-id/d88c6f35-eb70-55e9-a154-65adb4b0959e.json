  "id": "d88c6f35-eb70-55e9-a154-65adb4b0959e",
  "slug": "hungarian-lentil-soup",
  "name": "Hungarian Lentil Soup",
  "recipe_type": "soup",
  "brief_description": "A lentil soup recipe with onions, garlic, carrots, celery, tomatoes, paprika and bay leaves to flavor this comforting dish that is easy to make.",
  "cuisine": "Hungarian Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large stockpot. Saut\u00e9 onions until they are glossy. Stir in carrots, celery, garlic, and paprika, and saut\u00e9 for 10 minutes."
    },
    {
      "position": 2,
      "text": "Stir in chicken stock, tomatoes, lentils, bay leaves, salt, and pepper. Stir well, then add wine and bring the mixture to a boil. Slowly reduce the heat and cook for 1 hour on low to medium heat; or until lentils are tender."
    },
    {
      "position": 3,
      "text": "Sprinkle soup with Parmesan and parsley before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "65bfa095-0093-51fd-94b2-c6c422568766",
  "slug": "french-onion-soup-gratinee",
  "name": "French Onion Soup Gratin\u00e9e",
  "recipe_type": "soup",
  "brief_description": "Looking for the best French onion soup recipe? This rich and tasty, cheese-topped onion gratin\u00e9e soup recipe is about as good as it gets!",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large pot over medium-high heat. Stir in red onions, sweet onions, and salt. Cook, stirring frequently, until onions are caramelized and almost syrupy, about 35 minutes."
    },
    {
      "position": 2,
      "text": "Stir in chicken broth, beef broth, red wine, and Worcestershire sauce. Bundle parsley, thyme, and bay leaf with kitchen twine; add to the pot. Simmer over medium heat for 20 minutes, stirring occasionally. Remove and discard herb bundle. Reduce heat to low; stir in vinegar and season with salt and pepper. Cover soup and keep warm over low heat while you prepare the toast."
    },
    {
      "position": 3,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Arrange bread slices on a baking sheet and broil, turning once, until well toasted on both sides, about 3 minutes. Remove from heat; do not turn off the broiler."
    },
    {
      "position": 4,
      "text": "Arrange 4 large oven-safe bowls or crocks on a rimmed baking sheet. Fill each bowl 2/3 full with hot soup. Top each bowl with 1 slice of toasted bread, 2 slices Gruy\u00e8re cheese, and 1/4 of the Asiago cheese. Sprinkle a little bit of paprika over the top of each one."
    },
    {
      "position": 5,
      "text": "Cook under the hot broiler until bubbly and golden brown, about 5 minutes. Cheese will cascade over the sides of the crock and form a beautifully melted crusty seal as it melts."
    },
    {
      "position": 6,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

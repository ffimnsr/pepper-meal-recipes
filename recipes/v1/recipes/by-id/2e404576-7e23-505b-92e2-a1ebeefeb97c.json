  "id": "2e404576-7e23-505b-92e2-a1ebeefeb97c",
  "slug": "winter-fruit-salad-with-lemon-poppyseed-dressing",
  "name": "Winter Fruit Salad with Poppyseed Dressing",
  "recipe_type": "salad",
  "brief_description": "A wonderful winter fruit salad with apple, pear, cranberries, cashews, and shredded Swiss cheese tossed in a sweet-tangy lemon and poppyseed dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine sugar, lemon juice, onion, mustard, and salt in a food processor or blender; process until well blended. With machine still running, add oil in a slow, steady stream until mixture is thick and smooth. Add poppy seeds, and process just a few seconds more to mix."
    },
    {
      "position": 2,
      "text": "Toss romaine lettuce, shredded Swiss cheese, cashews, dried cranberries, apple, and pear together in a large serving bowl. Pour dressing over salad just before serving, and toss to coat."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 25,

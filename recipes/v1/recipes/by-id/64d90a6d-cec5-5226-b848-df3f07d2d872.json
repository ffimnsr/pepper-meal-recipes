  "slug": "mango-gazpacho",
  "name": "Mango Gazpacho",
  "recipe_type": "soup",
  "brief_description": "Serve this intriguing variation of gazpacho at your next summer gathering.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Process mangoes, orange juice and oil in a blender or food processor until pureed. Transfer to a medium bowl, along with remaining ingredients. Season with salt and pepper to taste. Refrigerate until ready to serve. (Can be made several hours before serving.)"
    }
  ],

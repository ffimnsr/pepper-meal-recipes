  "slug": "pool-hall-coleslaw",
  "name": "Pool Hall Coleslaw",
  "recipe_type": "dessert",
  "brief_description": "Pool room slaw is a sweet recipe for cooked coleslaw that is good on hamburgers, hot dogs, and vegetables.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a large stock pot, combine vinegar, mustard, white sugar, and brown sugar. Season with turmeric, salt, black pepper, and red pepper flakes. Stir to dissolve sugar and bring to a boil."
    },
    {
      "position": 2,
      "text": "Add cabbage, carrots, peppers, and onions. Return to a boil, then reduce the heat to medium-low and simmer for 20 to 25 minutes, frequently stirring."
    }
  ],
  "servings": 96,

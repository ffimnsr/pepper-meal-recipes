  "id": "103a29c9-7e02-5734-a707-292e4b784bcb",
  "slug": "grilled-garlic-bread",
  "name": "Grilled Garlic Bread",
  "recipe_type": "appetizer",
  "brief_description": "Skip the oven and grill this savory garlic bread instead for a quick and easy appetizer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a grill to high heat."
    },
    {
      "position": 2,
      "text": "Mix together butter, garlic, Parmesan cheese, and pepper in a bowl."
    },
    {
      "position": 3,
      "text": "Spread the butter mixture generously on the baguette slices."
    },
    {
      "position": 4,
      "text": "Place slices on the preheated grill and cook until butter is melted and bread is lightly brown, about 30 seconds."
    },
    {
      "position": 5,
      "text": "Sprinkle with parsley and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "slug": "seafood-stuffed-mushrooms",
  "name": "Seafood Stuffed Mushrooms",
  "recipe_type": "appetizer",
  "brief_description": "You chill this seafood medley for an hour before stuffing--flavors intensify and ingredients hold together nicely.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl combine the cream cheese, green onions, crab, shrimp, dip mix, garlic powder, salt and pepper. Mix all together and chill mixture for about 1 hour. Spoon mixture into clean mushroom caps to stuff and serve."
    }
  ],

  "id": "50161403-9f25-5c29-ad31-faacccb163fe",
  "slug": "tiramisu-icebox-cake-recipe-11949518",
  "name": "Tiramisu Icebox Cake",
  "recipe_type": "dessert",
  "brief_description": "This tiramisu icebox cake is easy, creamy, and just sweet enough. The graham crackers soften nicely, and the coffee and mascarpone are well balanced. It's an easy, no-bake dessert for hot summer nights.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine mascarpone, powdered sugar, and 1 teaspoon vanilla in a large bowl. Beat with an electric mixer on medium speed until fluffy, about 1 minute. Add cream. Beat until soft peaks form. Set aside."
    },
    {
      "position": 2,
      "text": "Combine coffee and remaining 1 teaspoon vanilla in a shallow bowl or pie plate. Working with one cracker sheet at a time, quickly dip each graham cracker into the coffee mixture, allowing excess to drip off."
    },
    {
      "position": 3,
      "text": "Arrange 8 1/2 dipped crackers in an even layer in a 9x13-inch baking dish, breaking crackers as needed to fit the dish."
    },
    {
      "position": 4,
      "text": "Spread 1 1/2 cups mascarpone mixture evenly over the crackers. Repeat layers of dipped crackers and mascarpone mixture 4 times to create 5 total cracker and mascarpone layers, ending with mascarpone mixture on top."
    },
    {
      "position": 5,
      "text": "Cover and chill 4 hours to overnight or until well-chilled."
    },
    {
      "position": 6,
      "text": ".Let stand 10 minutes at room temperature before serving. Dust generously with cocoa powder just before slicing and serving Recipe developed by Ashley Sandoval"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,

  "id": "119b6117-66e5-57ec-a988-927dda3fce42",
  "slug": "pizza-rice-bake-recipe-8744154",
  "name": "Pizza Rice Bake (Pizzaiola Rice)",
  "recipe_type": "main",
  "brief_description": "This Pizzaiola Rice, or Pizza Rice Bake, spins classic pizza flavors into a comforting, cheesy casserole. Made with marinara-infused rice, melted mozzarella, and crispy pepperoni, this easy bake is a fun, flavorful twist on a favorite. Here's how to make our Pizza Rice Bake.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all Ingredients. Spray an 8-inch broiler-safe baking dish with cooking spray, and set aside."
    },
    {
      "position": 2,
      "text": "Melt butter in a large saucepan over medium heat. Add garlic and crushed red pepper and cook, stirring often, until garlic is lightly browned and aromatic, about 1 minute. Add rice, and cook, stirring occasionally until lightly toasted, about 3 minutes."
    },
    {
      "position": 3,
      "text": "Stir in stock, salt, pepper, and 1 1/2 cups marinara sauce. Bring to a boil over medium heat, reduce heat to medium-low, and simmer, covered, stirring every few minutes, until rice is almost fully cooked through, 18 to 20 minutes"
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (175 degrees C);"
    },
    {
      "position": 5,
      "text": "Remove from heat, stir in Parmesan cheese and remaining 1/2 cup marinara, until evenly combined."
    },
    {
      "position": 6,
      "text": "Transfer rice mixture to the prepared baking dish, spreading it into an even layer."
    },
    {
      "position": 7,
      "text": "Top evenly with pepperoni and mozzarella."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until cheese is melted, about 10 minutes. With baking dish still in the oven, increase oven temperature to broil; broil until cheese is just golden brown, 2 to 5 more minutes."
    },
    {
      "position": 9,
      "text": "Remove from the oven and garnish with basil. Recipe developed by Amanda Holstein"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

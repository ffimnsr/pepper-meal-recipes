  "id": "b7b4b5a9-edce-54bd-be4d-fabbf169dd33",
  "slug": "cream-cheese-fruit-salad",
  "name": "Cream Cheese Fruit Salad",
  "recipe_type": "salad",
  "brief_description": "This creamy fruit salad is quick and easy to make for any summer occasion with canned, fresh, and dried fruits, cream cheese, and whipped topping.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat cream cheese and sugar together in a large bowl with an electric mixer. Mix in whipped topping on high speed until incorporated."
    },
    {
      "position": 2,
      "text": "Fold in pineapple, fruit cocktail, bananas, apple, coconut, pecans, raisins, and cherries."
    },
    {
      "position": 3,
      "text": "Transfer to a serving bowl, cover, and chill for at least 1 hour before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "8cea21d3-c1dd-58cf-9388-9d4dba4b3851",
  "slug": "quick-and-easy-mango-margaritas",
  "name": "Quick and Easy Mango Margaritas",
  "recipe_type": "drink",
  "brief_description": "This quick and easy mango margarita recipe is a breeze to make by blending ice, mango nectar, tequila, margarita mix, and lime for a refreshing cocktail.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine ice, margarita mix, tequila, and mango nectar in a blender; squeeze \u00bd lime into blender. Blend until smooth."
    },
    {
      "position": 3,
      "text": "Cut remaining \u00bd lime into wedges. Pour \u00bc to \u00bd inch sugar onto a small, shallow plate. Moisten rims of 4 glasses with 1 lime wedge; dip moistened glass rims into sugar."
    },
    {
      "position": 4,
      "text": "Divide margarita among sugar-rimmed glasses; garnish with lime wedges."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

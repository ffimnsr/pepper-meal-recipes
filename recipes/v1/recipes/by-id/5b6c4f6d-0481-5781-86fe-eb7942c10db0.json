  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "5b6c4f6d-0481-5781-86fe-eb7942c10db0",
  "slug": "venison-pot-pie",
  "name": "Venison Pot Pie",
  "recipe_type": "main",
  "brief_description": "Venison joins vegetables and a thick and savory red wine gravy in this family-friendly venison pot pie that's easy to make and full of flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9-inch, deep-dish pie plate."
    },
    {
      "position": 2,
      "text": "Season venison in a bowl with garlic powder, onion powder, salt, and pepper. Add flour and toss to coat."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a medium saucepan over medium heat. Add onion and garlic; saut\u00e9 until soft and translucent, 5 to 7 minutes. Increase the heat to high and add venison. Stir venison to quickly brown, 1 to 2 minutes; don't overcook \u2014 it should still be rare inside when taken out of the pan. Transfer venison to a large bowl."
    },
    {
      "position": 4,
      "text": "Pour red wine and Worcestershire sauce into the pan and bring to a boil while scraping the browned bits of food off the bottom of the pan with a wooden spoon. Cook until liquid has reduced and the pan is almost dry, 10 to 15 minutes. Reduce the heat to low and stir in beef broth."
    },
    {
      "position": 5,
      "text": "Dissolve cornstarch in water in a small bowl; pour into the pan, whisking constantly. Bring to a simmer and cook until thickened, about 5 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Add potatoes, carrots, and celery and cook, uncovered, for 2 minutes. Drain in a colander and immediately immerse vegetables into a bowl of ice water for several minutes to stop the cooking process. Drain."
    },
    {
      "position": 7,
      "text": "Add drained vegetables to venison along with corn and peas; mix until thoroughly combined."
    },
    {
      "position": 8,
      "text": "Whisk egg and milk together in a small bowl for egg wash and set aside."
    },
    {
      "position": 9,
      "text": "Line the prepared pie dish with one pastry, trimming the edges if needed. Place venison mixture into pie crust and pour gravy over top. Spread mushrooms over the surface and cover with remaining pastry. Brush with egg wash and cut vents in the top."
    },
    {
      "position": 10,
      "text": "Bake in the preheated oven until crust is golden brown and filling is bubbling, 45 minutes to 1 hour. If the edges of the crust are getting too dark, cover them with aluminum foil until the center crust has caught up."
    },
    {
      "position": 11,
      "text": "Let cool for 5 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 40,

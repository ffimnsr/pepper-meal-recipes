  "id": "dbf4d1bd-ab82-5210-bd0a-b8dd39e9a32f",
  "slug": "chicken-tostadas",
  "name": "Chicken Tostadas",
  "recipe_type": "main",
  "brief_description": "Taco-seasoned chicken, refried beans, veggies, and cheese top these easy Mexican-inspired tostadas that pack tons of crispy crunch and delicious flavor.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Place chicken into a frying pan over medium heat. Sprinkle with taco seasoning and cook until no longer pink in the center and juices run clear, 5 to 7 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 3,
      "text": "Spread a thin layer of refried beans onto each tostada shell; sprinkle each with Mexican cheese. Divide cooked chicken on top of cheese layer. Sprinkle tomato, red onion, and bell pepper evenly on top of each tostada. Place tostadas on a baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until crispy, 10 to 15 minutes."
    },
    {
      "position": 5,
      "text": "Remove tostadas from the oven. Sprinkle with cilantro and spread salsa and sour cream on top."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

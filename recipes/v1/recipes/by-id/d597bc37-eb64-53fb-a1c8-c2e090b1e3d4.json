  "id": "d597bc37-eb64-53fb-a1c8-c2e090b1e3d4",
  "slug": "pumpkin-popovers",
  "name": "Pumpkin Popovers",
  "recipe_type": "breakfast",
  "brief_description": "Fluffy pumpkin popovers are a delightful and colorful addition to the holiday brunch or dinner table; serve with whipped cream.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Butter 4 custard dishes or muffin cups."
    },
    {
      "position": 2,
      "text": "Beat milk and eggs together in a bowl using an electric mixer until smooth; mix in pumpkin and oil. Beat flour, brown sugar, pumpkin pie spice, and salt into pumpkin mixture until batter is smooth. Pour batter into the prepared custard cups, filling each halfway."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until tops are lightly browned, 20 to 25 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "50074384-8985-533d-9c67-a44b163e81e2",
  "slug": "jackies-special-meatloaf",
  "name": "Jackie\u2019s Special Meatloaf",
  "recipe_type": "main",
  "brief_description": "Ground beef, ketchup, and Japanese bread crumbs (panko) are mixed with a couple of eggs and some seasonings to yield an easy, delicious meatloaf.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a baking pan."
    },
    {
      "position": 2,
      "text": "Place the ground beef, eggs, panko, and 1/2 cup ketchup in a large bowl. Mix by hand, and season with salt-free seasoning blend, garlic powder, onion powder, salt, and pepper. Form into a loaf shape, and place on the prepared baking pan. Drizzle with remaining 1/4 cup ketchup."
    },
    {
      "position": 3,
      "text": "Bake 1 hour in the preheated oven, to an internal temperature of 160 degrees F (70 degrees C)."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

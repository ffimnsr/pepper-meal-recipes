  "id": "4e10a23d-ea29-5d74-954b-5c477d6705ab",
  "slug": "chocolate-pecan-pie-iii",
  "name": "Ruth's Chocolate Pecan Pie",
  "recipe_type": "dessert",
  "brief_description": "This pecan pie is thick, gooey, and full of sweet, buttery pecans. Unsweetened cocoa adds just a hint of chocolate flavor to this popular pie.",
  "cuisine": "U.S. Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "In a heavy saucepan, combine melted margarine, corn syrup, sugar, and cocoa. Cook over low heat, stirring constantly, until sugar dissolves. Stir in vanilla, salt, and eggs until well combined. Stir in 1/2 of the pecans; mix well. Pour into pastry shell and top with remaining pecans."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 325 degrees F (165 degrees C) for 55 minutes. Let cool before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,

  "slug": "3-ingredient-potato-soup-recipe-8744734",
  "name": "3-Ingredient Potato Soup",
  "recipe_type": "soup",
  "brief_description": "This 3-ingredient potato soup is a shortcut recipe, perfect for Sunday prep for weekday lunches. Using O\u2019Brien potatoes with onion and bell pepper means lots of flavor with no chopping. Top with leftover crumbled bacon, chives, or cheese.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring frozen potatoes and water to a boil in a large stock pot. Stir in bouillon base and cook for 15 minutes."
    },
    {
      "position": 2,
      "text": "Reduce heat to medium. Whisk in gravy mix. Cook 5 minutes. Turn heat off and let stand until slightly thickened, about 10 minutes."
    }
  ],

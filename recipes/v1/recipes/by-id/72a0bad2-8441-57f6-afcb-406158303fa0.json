  "schema_version": 1,
  "id": "72a0bad2-8441-57f6-afcb-406158303fa0",
  "slug": "orzo-asparagus-salad-recipe-11967457",
  "name": "Orzo Asparagus Salad",
  "recipe_type": "salad",
  "brief_description": "This orzo asparagus salad is a fresh, colorful way to enjoy asparagus. Tender orzo, lightly saut\u00e9ed asparagus, stuffed olives, carrots, and tomatoes are tossed in a creamy lemon vinaigrette for a bright, flavor-packed side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "For salad dressing, combine 2 tablespoons olive oil, white wine vinegar, lemon juice, parsley, garlic, Italian seasoning, and Dijon mustard in a small bowl. Stir rapidly with a fork or whisk, until well blended."
    },
    {
      "position": 2,
      "text": "Stir in mayonnaise. Taste; season with salt and pepper. Stir in sugar, to taste. Refrigerate dressing until the salad is ready to be tossed."
    },
    {
      "position": 3,
      "text": "Heat 2 tablespoons olive oil in a large, nonstick skillet over medium-high heat. When oil is hot, add asparagus pieces and cook, stirring frequently, for 3 to 4 minutes. Asparagus should be bright green and still crunchy. Remove from the skillet and set aside."
    },
    {
      "position": 4,
      "text": "Melt butter in the same skillet; turn heat down to medium-low. Add orzo and stir to coat completely in the melted butter. Cook and stir continuously until orzo is a light, golden brown, about 4 minutes."
    },
    {
      "position": 5,
      "text": "Add broth, stir, and bring to a boil. Cover, reduce heat to a simmer, and cook about 15 minutes. Remove the cover for the last five minutes, to assure that the water cooks away. Stir occasionally, to allow evaporation."
    },
    {
      "position": 6,
      "text": "Remove orzo from the skillet and place in a bowl; drizzle with remaining 2 tablespoons olive oil, stir to coat the pasta, and refrigerate for about 15 minutes."
    },
    {
      "position": 7,
      "text": "Meanwhile, for salad, combine asparagus, olives, cherry tomatoes, carrots, feta cheese, and red onion in a bowl."
    },
    {
      "position": 8,
      "text": "Stir in cooled orzo and salad dressing, and toss to combine. Garnish with fresh parsley and serve cold."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,

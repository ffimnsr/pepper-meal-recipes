  "id": "464c4b2b-8b5a-5e27-9ad9-a8c13fd2bf30",
  "slug": "how-to-cook-tandoori-chicken",
  "name": "Tandoori Chicken",
  "recipe_type": null,
  "brief_description": "Classic Indian tandoori chicken marinated in yogurt and warm spices, then grilled until charred and juicy. A flavorful main course perfect with rice or naan.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, combine all of the ingredients except for the chicken and olive oil. Mix thoroughly."
    },
    {
      "position": 2,
      "text": "Put the chicken in the bowl and coat with the mixture."
    },
    {
      "position": 3,
      "text": "Marinate for 8 to 10 hours."
    },
    {
      "position": 4,
      "text": "Remove the chicken from the marinade and brush with olive oil."
    },
    {
      "position": 5,
      "text": "Grill over medium-high heat, turning occasionally, until the chicken is cooked through and slightly charred, about 15 to 18 minutes."
    },
    {
      "position": 6,
      "text": "Transfer to a serving plate and garnish with sliced onions, carrots, and cucumber."
    },
    {
      "position": 7,
      "text": "Serve warm and enjoy."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 18,

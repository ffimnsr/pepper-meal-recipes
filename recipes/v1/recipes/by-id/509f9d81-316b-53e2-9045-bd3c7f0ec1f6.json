  "id": "509f9d81-316b-53e2-9045-bd3c7f0ec1f6",
  "slug": "vegan-gingerbread-cookies-with-soy-milk",
  "name": "Vegan Gingerbread Cookies with Soy Milk",
  "recipe_type": "dessert",
  "brief_description": "Gingerbread cookies are made vegan and dairy-free with the use of soy milk and vegan shortening in this quick dessert recipe.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease 3 baking sheets."
    },
    {
      "position": 2,
      "text": "Mix shortening, brown sugar, white sugar, and soy milk together in a bowl using an electric mixer. Add molasses and blend until smooth."
    },
    {
      "position": 3,
      "text": "Combine flour, ginger, baking soda, baking powder, and cinnamon in a separate bowl. Pour into the bowl with the shortening mixture; mix dough by hand until thoroughly combined."
    },
    {
      "position": 4,
      "text": "Pour 1/3 cup sugar into a shallow bowl. Roll dough into balls and roll in sugar to coat. Place on the prepared baking sheets about 1 inch apart and flatten slightly."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden and set, 12 to 14 minutes. Let cookies cool completely on the baking sheet."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

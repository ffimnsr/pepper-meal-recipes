{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "6e5ec039-1803-571f-9545-d7ab7f923217",
  "slug": "marzipan-christmas-kringle-juleskringle",
  "name": "Juleskringle (Marzipan Christmas Kringle)",
  "recipe_type": "breakfast",
  "brief_description": "This marzipan Christmas kringle is perfect for the holidays. Filled with almond paste and topped with sliced almonds, it's traditionally baked in a pretzel shape.",
  "cuisine": "Scandinavian",
  "instructions": [
    {
      "position": 1,
      "text": "Make the bread: Stir milk and sugar together in a small bowl. Sprinkle yeast over top and let stand for 10 minutes to dissolve. Stir in cream."
    },
    {
      "position": 2,
      "text": "Stir together flour, sugar, salt, and cardamom in a separate bowl. Cut in butter with 2 knives or a pastry blender until texture is coarse and mealy. Add yeast mixture and stir until well blended. Pat into a ball, flatten slightly, and wrap in plastic wrap. Refrigerate for 12 to 24 hours."
    },
    {
      "position": 3,
      "text": "When ready to bake, make the filling: Mix almond paste, almonds, sugar, cinnamon, and almond extract with an electric mixer in a large bowl until evenly blended. It may be crumbly."
    },
    {
      "position": 4,
      "text": "Roll chilled dough into a 2x24-inch rectangle. Spread filling over dough to within 2 inches of each side. Roll up into a tube. Cover the work surface with sugar and roll dough tube into sugar until thoroughly coated."
    },
    {
      "position": 5,
      "text": "Roll and stretch dough tube out into a 40-inch-long rope. Place onto a parchment-lined baking sheet and form into a pretzel shape."
    },
    {
      "position": 6,
      "text": "Brush dough with egg white and sprinkle with almonds. Cover loosely with a towel and let rise for 45 minutes."
    },
    {
      "position": 7,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 8,
      "text": "Bake kringle in the preheated oven until golden brown, 25 to 30 minutes. Cut into slices to serve."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 50,

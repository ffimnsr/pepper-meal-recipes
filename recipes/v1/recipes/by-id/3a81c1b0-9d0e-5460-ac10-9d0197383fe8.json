  "id": "3a81c1b0-9d0e-5460-ac10-9d0197383fe8",
  "slug": "sugar-pie-iv",
  "name": "Sugar Pie IV",
  "recipe_type": "dessert",
  "brief_description": "Sugar pie made with brown sugar, cream and pecans.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). In a medium bowl, mix together brown sugar and flour; set aside."
    },
    {
      "position": 2,
      "text": "In a large bowl, whisk together the cream, egg, corn syrup and vanilla. Stir in brown sugar mixture until blended. Fold in the pecans."
    },
    {
      "position": 3,
      "text": "Pour filling into pie crust. Bake in preheated oven for 30 to 40 minutes, or until golden brown."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 40,

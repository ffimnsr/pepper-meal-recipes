  "id": "fc5b7a6f-81ff-519d-88c5-89c208efbea6",
  "slug": "chicken-broccoli-hash-brown-casserole-recipe-11950003",
  "name": "Chicken Broccoli Hash Brown Casserole",
  "recipe_type": "main",
  "brief_description": "This chicken broccoli hash brown casserole is pure comfort food, like funeral potatoes turned into a main dish with the addition of broccoli and chicken. It\u2019s nicely creamy and familiar, with a golden, crunchy onion and crushed-cracker top.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Combine hash browns, broccoli, chicken, cheese, soup, milk, onion, sour cream, chicken bouillon granules and black pepper in an extra-large bowl. Mix until evenly combined. Transfer to the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Combine crushed crackers and French-fried onions in a small bowl. Add melted butter and stir to coat the crumb mixture. Sprinkle evenly over the casserole."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until heated through and the topping is golden brown, 50 to 55 minutes. Serve warm. Recipe developed by Jaelyn Luong"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "5dc70684-5975-501d-b7ee-266b475cb252",
  "slug": "chicken-ramen-noodle-soup-with-honey-sriracha-crackers",
  "name": "Chicken Ramen Noodle Soup with Honey Sriracha Crackers",
  "recipe_type": "soup",
  "brief_description": "This comforting chicken ramen noodle soup is served with homemade honey Sriracha crackers for crunch and extra flavor.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a Dutch oven over medium heat. Add carrot, celery, and onion. Cook until crisp-tender, about 5 minutes. Add ginger and garlic. Cook 1 minute more. Add broth, soy sauce, basil, oregano, and pepper. Bring to a boil. Reduce heat and simmer, covered, until carrots are just tender about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir in cooked chicken and ramen noodles. Simmer, uncovered, until noodles are tender, 3 to 5 minutes. Stir in lime juice. Ladle soup into bowls. Sprinkle with lime zest and, if you like, additional basil and oregano leaves, and serve with Honey-Sriracha Crackers."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a 10x15-inch baking pan with foil."
    },
    {
      "position": 4,
      "text": "Heat canola oil and butter in a large saucepan over medium heat until butter is melted, 1 to 2 minutes. Whisk in honey, Sriracha, and 1 1/2 teaspoons of the reserved ramen seasoning packet. Bring to a boil. Remove from heat and stir in oyster crackers. Toss together until evenly coated."
    },
    {
      "position": 5,
      "text": "Transfer crackers to the prepared pan and spread to an even layer."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven, stirring once, until light golden and crisp, 8 to 10 minutes. Remove from heat and cool completely (crackers will continue to crisp as they cool). Store crackers in an airtight container at room temperature up to 2 weeks."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

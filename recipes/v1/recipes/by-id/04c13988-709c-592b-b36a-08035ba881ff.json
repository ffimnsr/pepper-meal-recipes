  "id": "04c13988-709c-592b-b36a-08035ba881ff",
  "slug": "captains-mojito",
  "name": "Captain's Mojito",
  "recipe_type": "drink",
  "brief_description": "This spiced rum mojito made with cranberry juice and spiced rum makes a cocktail fitting for Thanksgiving or any time. It's your new favorite drink!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place mint leaves, lime wedges, and ice into a cocktail shaker; mash well with a cocktail muddler. Pour in simple syrup, lime juice, rum, cranberry juice, and soda water. Cover and shake until the outside of the shaker has frosted. Strain into a chilled glass to serve."
    }
  ],

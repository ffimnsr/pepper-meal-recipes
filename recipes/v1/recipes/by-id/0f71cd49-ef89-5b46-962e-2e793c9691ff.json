  "id": "0f71cd49-ef89-5b46-962e-2e793c9691ff",
  "slug": "savory-monkey-bread",
  "name": "Savory Monkey Bread",
  "recipe_type": "breakfast",
  "brief_description": "This savory version of monkey bread is flavored with onion, parsley, and dill.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Stir melted butter, parsley, onion, and dill together in a bowl. Dunk biscuit halves into the butter mixture to coat; arrange into a tube-cake pan."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until dough is cooked through and golden brown on top, about 30 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 30,

  "id": "04ee089a-3621-5bf8-85b4-888b65337a71",
  "slug": "filet-mignon-with-rich-balsamic-glaze",
  "name": "Filet Mignon with Rich Balsamic Glaze",
  "recipe_type": "main",
  "brief_description": "This is the best filet mignon recipe that includes a rich red wine-balsamic sauce. Perfect for an elegant steak dinner for two in just 15 minutes!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients."
    },
    {
      "position": 2,
      "text": "Sprinkle both sides of steaks with pepper and salt."
    },
    {
      "position": 3,
      "text": "Heat a nonstick skillet over medium-high heat. Sear steaks in the hot pan until browned, about 1 minute per side."
    },
    {
      "position": 4,
      "text": "Reduce heat to medium-low, and pour in balsamic vinegar and red wine. Cover and cook for 4 minutes. Flip steaks and baste with sauce; cover and cook for 4 minutes longer."
    },
    {
      "position": 5,
      "text": "Remove steaks to two warmed plates. Spoon a tablespoon of glaze over each steak and serve immediately."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

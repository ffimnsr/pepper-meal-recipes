  "id": "15b8e81a-1416-5a57-8f87-76e359c760e9",
  "slug": "air-fryer-honey-mustard-salmon-bites-recipe-11680825",
  "name": "Air Fryer Honey Mustard Salmon Bites",
  "recipe_type": "appetizer",
  "brief_description": "These air fryer honey mustard salmon bites are quick and easy to make in the air fryer. Honey mustard and salmon are so delicious together\u2014these bites will be a hit at your next party.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat an air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine salmon, oil, paprika, salt, and pepper in a small mixing bowl. Toss to combine. Place seasoned salmon in the basket of the air fryer."
    },
    {
      "position": 3,
      "text": "Air fry for 4 minutes."
    },
    {
      "position": 4,
      "text": "Using a basting brush, lightly brush honey mustard over salmon pieces. Stick a toothpick in each bite."
    },
    {
      "position": 5,
      "text": "Air fry until fish flakes easily with a fork, about 4 minutes more."
    },
    {
      "position": 6,
      "text": "Transfer to a serving plate and serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

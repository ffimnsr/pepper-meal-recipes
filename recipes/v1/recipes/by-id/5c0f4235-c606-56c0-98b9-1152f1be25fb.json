  "id": "5c0f4235-c606-56c0-98b9-1152f1be25fb",
  "slug": "easy-leg-of-lamb",
  "name": "Roast Boneless Leg of Lamb",
  "recipe_type": "main",
  "brief_description": "This leg of lamb recipe roasts boneless lamb with lots of whole garlic cloves and fresh rosemary until perfectly tender, juicy, and full of flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Cut 20 deep slits evenly spaced around the leg of lamb without cutting the netting. Stuff one garlic clove into each slit."
    },
    {
      "position": 3,
      "text": "Rub garlic powder over lamb. Slice rosemary sprigs; place under the netting evenly around lamb. Transfer lamb to a roasting pan."
    },
    {
      "position": 4,
      "text": "Roast lamb in the preheated oven until pink and juicy in the center for medium, about 2 to 2 \u00bd hours. An instant-read thermometer inserted into the center should read 130 degrees F (54 degrees C)."
    },
    {
      "position": 5,
      "text": "Remove from the oven and cover with aluminum foil; lest rest until thermometer reads 135 degrees F (57 degrees C) before carving, about 20 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 10,

  "id": "15d48c8d-9ea8-5395-a2c5-cf6a05917dce",
  "slug": "oregon-fall-salad",
  "name": "Oregon Fall Salad",
  "recipe_type": "salad",
  "brief_description": "Hazelnuts, apples, and sharp Cheddar combine with mixed salad greens and an apple cider vinaigrette to make a hearty Oregon fall salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk olive oil, cider vinegar, sea salt, and black pepper together in a large bowl until dressing is smooth. Pour salad greens into bowl and toss in dressing to coat."
    },
    {
      "position": 2,
      "text": "Cook and stir hazelnuts in a skillet over medium heat until lightly browned, 4 to 7 minutes. Transfer hazelnuts to a work surface and roughly chop."
    },
    {
      "position": 3,
      "text": "Layer apple slices, Cheddar cheese, and hazelnuts atop dressed greens."
    }
  ],
  "servings": 2,

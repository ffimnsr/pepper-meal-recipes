  "id": "0d0fe391-620d-56a6-8c46-3be91145f85c",
  "slug": "barbarian-beef",
  "name": "Barbarian Beef",
  "recipe_type": "main",
  "brief_description": "Simple to the point of primitive, Chef John's barbarian-style beef is cooked right on the coals and topped with a chile sauce that our ancestors could also have made.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Season both sides of beef generously with salt. Let sit at room temperature, flipping halfway through, for 30 minutes."
    },
    {
      "position": 2,
      "text": "Burn a bed of charcoal until coals are glowing red and ashy white on the surface, rearranging coals as needed."
    },
    {
      "position": 3,
      "text": "Place the beef right on top of the coals. Cook, flipping over halfway, about 4 minutes per side. Continue cooking until the internal temperature of the meat reaches 120 degrees F (49 degrees C) for medium-rare, 1 to 2 minutes more per side. Transfer beef to a plate. Let rest while making the sauce."
    },
    {
      "position": 4,
      "text": "Place garlic, chile pepper, rosemary, and kosher salt in a mortar. Crush into a paste using a pestle. Stir in vinegar and oil."
    },
    {
      "position": 5,
      "text": "Slice beef thinly and spoon the sauce on top."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "13888a9a-92de-5238-9021-d79c073985dd",
  "slug": "barbs-broccoli-cauliflower-salad",
  "name": "Barb's Broccoli-Cauliflower Salad",
  "recipe_type": "salad",
  "brief_description": "This broccoli-cauliflower salad has a delicious flavor thanks to the addition of bacon bits, sunflower seeds, red onion, and a creamy dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels; crumble."
    },
    {
      "position": 2,
      "text": "Combine bacon, cauliflower, broccoli, sunflower seeds, and onion in a large bowl."
    },
    {
      "position": 3,
      "text": "Whisk salad dressing, sugar, and vinegar together in a jug until blended. Pour over cauliflower mixture and toss to coat."
    },
    {
      "position": 4,
      "text": "Refrigerate salad and allow to chill before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

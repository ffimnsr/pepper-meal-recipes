{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "05cde0b2-73f3-5ec2-82d6-d005ffb6573b",
  "slug": "pork-tenderloin-with-apples-and-onions",
  "name": "Pork Tenderloin with Apples and Onions",
  "recipe_type": "main",
  "brief_description": "This pork tenderloin with apples and onions is roasted in a skillet in the oven for an easy and flavorful main dish that's great for busy weeknights.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Trim silver skin from pork tenderloins; pat dry using paper towels. Rub 2 teaspoons vegetable oil over tenderloins, then rub with sea salt."
    },
    {
      "position": 3,
      "text": "Heat 1 tablespoon vegetable oil in a large, oven-proof skillet over medium heat until it shimmers. Cook tenderloins in hot oil, rotating to brown all sides, about 10 minutes. Transfer pork to a large plate."
    },
    {
      "position": 4,
      "text": "Add remaining 1 tablespoon vegetable oil to any drippings in the skillet. Cook apples and onions in hot oil, stirring occasionally, until onions turn translucent, about 5 minutes; add more oil if the skillet gets dry. Season with 1 teaspoon thyme and black pepper; stir gently to combine. Remove from heat."
    },
    {
      "position": 5,
      "text": "Use a pastry brush to spread Dijon mustard evenly over tenderloins. Sprinkle with remaining 2 teaspoons thyme. Nestle tenderloins into the skillet with apple mixture."
    },
    {
      "position": 6,
      "text": "Roast, uncovered, in the preheated oven until an instant-read thermometer inserted into the center of tenderloins reads at least 145 degrees F (63 degrees C), about 15 minutes. Remove the skillet from the oven and transfer pork to a large platter. Cover with aluminum foil and let rest."
    },
    {
      "position": 7,
      "text": "Meanwhile, pour chicken stock into a saucepan and cook over medium-high heat until reduced by half, 8 to 10 minutes. Pour into the skillet with apple mixture. Cook over medium-high heat until boiling, about 5 minutes; stir in butter until melted."
    },
    {
      "position": 8,
      "text": "Slice pork and serve over apple mixture."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

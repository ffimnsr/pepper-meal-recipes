  "id": "43968e2a-6ff8-5b6b-a7a5-4acb2d15e7d8",
  "slug": "sour-cream-waffles",
  "name": "Sour Cream Waffles",
  "recipe_type": "breakfast",
  "brief_description": "These waffles substitute sour cream and yogurt for milk. The inspiration came about one morning when there was no milk in the house.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "In a bowl, mix together water, sour cream, yogurt, and vinegar."
    },
    {
      "position": 2,
      "text": "Sift flour into a separate, large bowl; stir in baking powder, baking soda, and salt."
    },
    {
      "position": 3,
      "text": "Add sour cream mixture and eggs to flour mixture; blend until smooth."
    },
    {
      "position": 4,
      "text": "Cook on a lightly greased waffle iron until golden brown; lift off with a fork."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

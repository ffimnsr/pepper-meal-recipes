  "slug": "abc-pudding-avocado-banana-chocolate-delight",
  "name": "ABC Pudding - Avocado, Banana, Chocolate Delight",
  "recipe_type": "dessert",
  "brief_description": "This raw and vegan pudding is made with avocado, banana, and cocoa powder pureed for a creamy and refreshing treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place avocados, bananas, and cocoa powder in a blender; puree until smooth."
    },
    {
      "position": 2,
      "text": "Pour pudding into serving bowls and sprinkle additional cocoa powder on top for garnish."
    },
    {
      "position": 3,
      "text": "Chill in refrigerator for texture and flavor to develop, at least 1 hour."
    }
  ],

  "id": "0c6a5cc3-bf1b-5172-83d1-b65c869db774",
  "slug": "chewy-no-bake-granola-bars",
  "name": "Chewy No-Bake Granola Bars",
  "recipe_type": "appetizer",
  "brief_description": "These no-bake granola bars without peanut butter can be made at home to taste just like store-bought for an after-school snack or on-the-go breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Mix rolled oats, steel-cut oats, rice cereal, dried fruit, and almonds together in a large bowl."
    },
    {
      "position": 3,
      "text": "Melt butter in a saucepan over medium heat; add brown sugar, honey, and vanilla. Whisk until sugar is completely dissolved, about 2 minutes. Pour over oat mixture; stir to combine."
    },
    {
      "position": 4,
      "text": "Spread oat mixture into the prepared baking dish. Press chocolate chips into the top. Refrigerate until chilled, about 1 hour."
    },
    {
      "position": 5,
      "text": "Sliced chilled granola mixture into 24 bars."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "slug": "chicken-salad-with-apples-grapes-and-walnuts",
  "name": "Chicken Salad with Apples, Grapes, and Walnuts",
  "recipe_type": "salad",
  "brief_description": "This chicken salad with apples, crunchy walnuts, and red grapes features a yogurt-based mayo dressing. A tasty recipe for leftover grilled chicken.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Toss together chicken, apples, walnuts, red onion, celery, and lemon juice in a large bowl."
    },
    {
      "position": 2,
      "text": "Whisk together yogurt, salad dressing, and mayonnaise in a small bowl; pour over chicken mixture and stir to coat. Gently fold in grapes."
    }
  ],

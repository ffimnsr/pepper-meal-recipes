  "id": "141eb5e8-2447-56d2-a023-25db9a1667df",
  "slug": "slow-cooker-chicken-quesadillas",
  "name": "Slow Cooker Chicken Quesadillas",
  "recipe_type": "main",
  "brief_description": "These cheesy quesadillas are filled with tender chicken simmered in the slow cooker with red enchilada sauce and taco seasoning. Perfect for picky eaters!",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine enchilada sauce, water, and taco seasoning in a slow cooker. Cut chicken breasts in half lengthwise and add to the slow cooker. Cook on Low until chicken is tender, 4 to 5 hours."
    },
    {
      "position": 2,
      "text": "Remove chicken and shred using 2 forks. Return chicken to sauce in the slow cooker; mix well."
    },
    {
      "position": 3,
      "text": "Spoon some of the chicken mixture onto a tortilla. Sprinkle some of the cheese on top. Cover with another tortilla."
    },
    {
      "position": 4,
      "text": "Heat a large nonstick skillet over medium heat. Slide quesadilla into the hot skillet. Cook until browned on both sides, 2 to 4 minutes, flipping halfway through. Repeat with remaining tortillas, chicken, and cheese."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 255,
  "preparation_time_minutes": 10,

  "id": "bd25ab47-74f6-5685-8e35-a986bf81501a",
  "slug": "homemade-energy-bars",
  "name": "Homemade Energy Bars",
  "recipe_type": "appetizer",
  "brief_description": "This tasty homemade energy bar recipe is packed with rolled oats, bran, sunflower seeds, and dried cranberries, making for a wholesome on-the-go snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine oats, cranberries, sunflower seeds, chocolate chips, sesame seeds, oat bran, flax seeds, cinnamon, and salt in a large bowl. Stir in peanut butter, honey, and oil until well combined. Press mixture firmly into a 9x13-inch baking pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden, 12 to 15 minutes. Cool for 5 minutes. Chill in the refrigerator for 10 minutes."
    },
    {
      "position": 4,
      "text": "Slice chilled bars into twenty 2x3-inch squares. Wrap in plastic wrap and refrigerate."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "82b0d8ed-875c-5209-8dab-0623b852e740",
  "slug": "pancit-molo-filipino-wonton-soup",
  "name": "Pancit Molo (Filipino Wonton Soup)",
  "recipe_type": "soup",
  "brief_description": "Rather than noodles, this Filipino pancit soup includes yummy wontons full of pork, prawns, and water chestnuts, plus chicken and bok choy.",
  "cuisine": "Filipino",
  "instructions": [
    {
      "position": 1,
      "text": "Mix pork, shrimp, water chestnuts, salt, and pepper together in a large bowl. Reserve 1/3 of the filling mixture for soup. Wrap about 1 tablespoon of remaining filling in a wonton wrapper. Repeat until all filling is used up."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large pot over medium-high heat. Add onion and garlic; saut\u00e9 until onion is translucent, about 5 minutes. Stir in chicken and reserved filling. Mix well. Add chicken broth; season with salt and pepper. Bring to a boil. Drop filled wontons into soup one by one. Boil until wontons float to the top, 3 to 5 minutes. Add bok choy; boil until tender, about 2 minutes more. Garnish with green onions."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "medium",

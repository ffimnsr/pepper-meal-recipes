  "slug": "big-batch-italian-greyhound-cocktail-recipe-11733271",
  "name": "Big Batch Italian Greyhound Cocktail",
  "recipe_type": "appetizer",
  "brief_description": "This big batch Italian greyhound cocktail is made with gin, Aperol, and grapefruit juice, a refreshingly bitter and sweet combination that will please everyone at the party.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Combine grapefruit juice, gin, Aperol, and simple syrup in a jug and seal tightly. Lightly shake jug to mix. Refrigerate until ready to serve."
    },
    {
      "position": 2,
      "text": "Lightly shake and serve over ice; garnish with a rosemary sprig."
    }
  ],
  "servings": 8,

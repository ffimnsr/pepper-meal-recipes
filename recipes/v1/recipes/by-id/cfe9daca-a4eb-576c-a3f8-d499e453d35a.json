  "id": "cfe9daca-a4eb-576c-a3f8-d499e453d35a",
  "slug": "a-simply-perfect-roast-turkey",
  "name": "A Simply Perfect Roast Turkey",
  "recipe_type": "main",
  "brief_description": "This simply perfect roast turkey recipe is all you need for the holidays \u2014 it\u2019s seasoned with just salt and pepper and basted with rich turkey stock.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Place a rack in the lowest position of the oven."
    },
    {
      "position": 2,
      "text": "Remove turkey neck and giblets; pat dry with paper towels. Place breast-side up, on a rack in a large roasting pan."
    },
    {
      "position": 3,
      "text": "Loosely fill cavity with stuffing. Rub skin with butter; season with salt and pepper."
    },
    {
      "position": 4,
      "text": "Pour 2 cups of turkey stock into the roasting pan."
    },
    {
      "position": 5,
      "text": "Loosely tent turkey with aluminum foil; roast for 2 \u00bd hours, basting with pan juices every 30 minutes. When drippings evaporate, add remaining stock to the pan, 1 to 2 cups at a time."
    },
    {
      "position": 6,
      "text": "Remove foil and continue roasting until a meat thermometer inserted in thickest part of thigh reads 165 degrees F (75 degrees C), about 1 \u00bd hours more."
    },
    {
      "position": 7,
      "text": "Let stand for 20 to 30 minutes before carving."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 240,

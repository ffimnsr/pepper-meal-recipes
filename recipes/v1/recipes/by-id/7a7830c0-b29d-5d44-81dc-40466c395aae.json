  "id": "7a7830c0-b29d-5d44-81dc-40466c395aae",
  "slug": "banana-oat-muffins",
  "name": "Banana Oat Muffins",
  "recipe_type": "dessert",
  "brief_description": "These oatmeal banana muffins make a deliciously sweet, healthy breakfast and are made with bananas and rolled oats. They're a tasty grab-and-go treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (205 degrees C). Line a 12-cup muffin tin with paper liners."
    },
    {
      "position": 2,
      "text": "Combine flour, oats, sugar, baking powder, soda, and salt in a medium bowl; set aside."
    },
    {
      "position": 3,
      "text": "Beat egg lightly in a large bowl. Whisk in milk, oil, and vanilla."
    },
    {
      "position": 4,
      "text": "Stir in mashed bananas."
    },
    {
      "position": 5,
      "text": "Add the flour mixture and stir until just combined."
    },
    {
      "position": 6,
      "text": "Spoon batter into the prepared muffin cups, filling each 3/4 full."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, 18 to 20 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "84e64b21-8c39-58d6-a456-6c00b23c00d5",
  "slug": "big-batch-espresso-martinis-recipe-11781701",
  "name": "Big Batch Espresso Martinis",
  "recipe_type": "appetizer",
  "brief_description": "Try these big batch espresso martinis that are stored in your freezer. Sweet coffee liqueur, smooth vodka and fresh brewed espresso combine in this delicious martini variation.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Pour out 1 \u00bc cups of the vodka bottle. Reserve poured-out vodka for another use."
    },
    {
      "position": 3,
      "text": "Pour 1/2 of the remaining vodka from the bottle into a small saucepan and warm over low heat for 1 to 2 minutes (do not boil). Remove from heat and immediately whisk in the espresso powder until fully dissolved and no lumps remain. Allow the mixture to cool for 5-10 minutes before proceeding."
    },
    {
      "position": 4,
      "text": "Add the cooled vodka espresso mixture, coffee liquor, simple syrup, and a pinch of sea salt to the vodka bottle. Cap and shake gently to mix."
    },
    {
      "position": 5,
      "text": "Freeze for at least 4 hours before serving . Note: mixture will not fully freeze due to the alcohol content."
    },
    {
      "position": 6,
      "text": "To serve, fill a cocktail shaker with ice and add 3 ounces of the mixture. Dilute with \u00bd ounce water per individual serving. Shake vigorously for 15 to 20 seconds. Strain into a chilled martini or coupe glass. Garnish with 3 coffee beans or a dusting of espresso powder, if desired."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,

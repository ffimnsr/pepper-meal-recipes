  "id": "d8630e1e-48e9-5a3d-97bd-d2a2149a61e3",
  "slug": "monkey-bread-made-easy",
  "name": "Monkey Bread Made Easy",
  "recipe_type": "breakfast",
  "brief_description": "Baking monkey bread in individual muffin cups cuts down baking time and evens out the portion sizes. It's a fast and easy treat that kids love, made with refrigerated biscuit dough, brown sugar, and cinnamon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Spray 8 muffin cups with cooking spray."
    },
    {
      "position": 2,
      "text": "In a bowl, stir together 1 tablespoon of cinnamon and the white sugar until evenly blended. Remove the biscuits from the packages, and cut into quarters. Drop a few biscuit pieces at a time into the sugar mixture, and coat thoroughly. Distribute the coated biscuit pieces among the prepared muffin tins (4 to 5 pieces per cup)."
    },
    {
      "position": 3,
      "text": "Place butter, brown sugar, and the remaining 1 tablespoon cinnamon in a microwave-safe glass or ceramic bowl, and microwave a few seconds until the butter has melted. Stir to blend, and drizzle about 2 tablespoons of the butter mixture over each cup."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the tops of the muffins are crispy and brown, about 20 minutes. Allow to cool for about 10 minutes before removing from pan."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

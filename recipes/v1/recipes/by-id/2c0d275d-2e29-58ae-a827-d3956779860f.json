{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "2c0d275d-2e29-58ae-a827-d3956779860f",
  "slug": "peruvian-alfajores-with-manjar-blanco",
  "name": "Peruvian Alfajores with Manjar Blanco",
  "recipe_type": "dessert",
  "brief_description": "Alfajores are shortbread cookie sandwiches filled with a luscious homemade caramel, aka manjar blanco. This Peruvian version features a hint of pisco!",
  "cuisine": "Peruvian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat white sugar and butter together in a large bowl using an electric mixer until creamy. Add cornstarch, flour, eggs, pisco, vanilla extract, and baking powder. Mix gently until combined."
    },
    {
      "position": 3,
      "text": "Turn dough out onto a clean work surface and knead by hand until smooth. Add water as needed. Divide in half, refrigerate 1 portion, and leave the other out."
    },
    {
      "position": 4,
      "text": "Coat your work surface with powdered sugar. Roll dough out to 1/4-inch thickness and cut into 2-inch rounds with a cookie cutter or shot glass. Place rounds close together on a baking sheet. Prick each cookie twice with a fork."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 10 minutes; cookies should still be white and soft, not crispy, and will firm up as they cool. Repeat with remaining cookie dough."
    },
    {
      "position": 6,
      "text": "Pour condensed milk, evaporated milk, and brown sugar into a saucepan over medium-low heat. Stir constantly until filling approaches the consistency of thick caramel, 20 to 30 minutes. Remove from heat; mixture will firm up as it cools to room temperature, about 30 minutes."
    },
    {
      "position": 7,
      "text": "Pour confectioners' sugar into a shallow bowl. Spread about 1/2 tablespoon of the filling over cooled cookies. Attach every two cookies together to make the alfajores. Roll alfajores in confectioners' sugar."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 60,
  "rest_time_minutes": null,
  "difficulty": "hard",

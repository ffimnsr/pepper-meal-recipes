  "id": "9739f45e-60dc-5fc6-ac43-823e544c792b",
  "slug": "cream-cheese-biscuits-recipe-8687110",
  "name": "Cream Cheese Biscuits",
  "recipe_type": "dessert",
  "brief_description": "These cream cheese biscuits are tender, fluffy, and slightly sweet, with a hint of tangy buttermilk, and they are very delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Whisk together flour, sugar, baking powder, salt, and baking soda in a large bowl until combined. Add butter and cream cheese and mix in with a pastry cutter or two forks until mixture is crumbly and resembles a coarse meal."
    },
    {
      "position": 3,
      "text": "Pour in the 1 1/2 cups buttermilk and gently stir until mixture resembles a shaggy, slightly sticky dough."
    },
    {
      "position": 4,
      "text": "Turn dough onto a lightly floured work surface and knead a few times to combine. Lightly coat hands and rolling pin with flour; gently pat and roll dough to 3/4-inch-thickness, adding more flour as needed to keep dough from sticking."
    },
    {
      "position": 5,
      "text": "Use a 3-inch biscuit cutter, dipping biscuit cutter in flour between cuts, to cut into 12 biscuits, rerolling dough scraps once. Place biscuits onto prepared baking sheet about 3/4-inch apart. Brush tops of biscuits with remaining 1 tablespoon buttermilk."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown, 15 to 17 minutes. Serve warm. Recipe developed by Catherine Jessee"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "26b13237-312a-5d75-a072-61310ec399df",
  "slug": "easy-slow-cooker-creamy-chicken-chili",
  "name": "Easy Slow Cooker Creamy Chicken Chili",
  "recipe_type": "soup",
  "brief_description": "Chicken breasts, cream cheese, ranch, and RO*TEL\u00ae tomatoes come together in this easy, contest-winning chili that lets the slow cooker do the work.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken breasts in the bottom of a slow cooker. Pour cannellini beans, black beans, corn, and tomatoes over the chicken in order listed. Sprinkle ranch dressing mix, chili powder, cumin, and onion powder on top. Place cream cheese on top. Cook on Low until chicken is fork-tender, 6 to 8 hours."
    },
    {
      "position": 2,
      "text": "Remove chicken breasts and shred with two forks or cut into bite-sized chunks. Stir chicken back into the slow cooker; mix chili thoroughly."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 360,

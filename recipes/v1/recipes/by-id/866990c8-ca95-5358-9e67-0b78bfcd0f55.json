  "slug": "dairy-free-vanilla-frosting",
  "name": "Dairy-Free Vanilla Frosting",
  "recipe_type": "dessert",
  "brief_description": "This dairy-free frosting recipe flavored with vanilla is perfect for any vegan cake or cookie decorating you have coming up for any occasion.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients"
    },
    {
      "position": 2,
      "text": "Beat confectioners' sugar and dairy-free margarine together using an electric mixer on low speed."
    },
    {
      "position": 3,
      "text": "Add water to increase creaminess if needed. Add vanilla."
    },
    {
      "position": 4,
      "text": "Increase speed to high and continue to mix until frosting is stiff. Refrigerate until ready to use."
    }
  ],
  "servings": 16,

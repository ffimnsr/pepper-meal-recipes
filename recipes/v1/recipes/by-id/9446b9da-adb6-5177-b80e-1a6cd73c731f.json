  "id": "9446b9da-adb6-5177-b80e-1a6cd73c731f",
  "slug": "eggnog-flavored-rice-pudding",
  "name": "Eggnog-Flavored Rice Pudding",
  "recipe_type": "dessert",
  "brief_description": "Turn leftover cooked rice into a rich and creamy special occasion dessert with this eggnog-flavored rice pudding recipe with vanilla extract and nutmeg.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine eggnog, rice, vanilla extract, nutmeg, and salt in a saucepan; cook and stir over medium heat until bubbling, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Whisk half-and-half and egg together in a heatproof bowl; whisk in some of the hot eggnog mixture, whisking quickly to avoid scrambling the egg. Pour the mixture back into the saucepan; cook and stir until pudding is thick, about 5 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,

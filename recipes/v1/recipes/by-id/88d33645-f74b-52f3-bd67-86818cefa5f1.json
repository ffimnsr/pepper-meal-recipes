  "id": "88d33645-f74b-52f3-bd67-86818cefa5f1",
  "slug": "healthier-apple-crisp-ii",
  "name": "Healthier Apple Crisp",
  "recipe_type": "dessert",
  "brief_description": "A classic apple crisp is made healthier by using unpeeled apples, less sugar, whole wheat instead of white flour, and adding crunchy walnuts.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degree C)."
    },
    {
      "position": 2,
      "text": "Place sliced apples in a 9x13-inch pan. Mix white sugar, 1 tablespoon flour, and ground cinnamon together; sprinkle over apples. Pour water evenly over all."
    },
    {
      "position": 3,
      "text": "Combine oats, 1 cup flour, brown sugar, baking powder, baking soda, walnuts and melted butter together. Crumble evenly over the apple mixture."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden and crisp on top, about 45 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

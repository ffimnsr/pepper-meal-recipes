  "id": "229a0dd8-a667-5e47-b23a-6364847f9659",
  "slug": "sour-cream-mushroom-dip",
  "name": "Sour Cream Mushroom Dip",
  "recipe_type": "appetizer",
  "brief_description": "The earthy flavor of mushrooms brings this spinach and Cheddar cheese dip to life.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat the butter in a skillet over medium heat. Stir in the mushrooms and onion; cook and stir until the mushrooms have softened and the onion is translucent, about 7 minutes. Stir in the spinach, parsley, garlic salt, and pepper. Continue cooking until the spinach has wilted, about 3 minutes. Remove from heat and stir in 1/2 cup of Cheddar cheese. Cool for 5 minutes. Stir in the sour cream, then spread mixture into an 8x8-inch baking dish. Sprinkle 1 cup of Cheddar cheese on top."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until the cheese has melted, about 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "4155f4a5-00a3-534d-aa4f-2d1200acd688",
  "slug": "blackberry-jam",
  "name": "Blackberry Jam",
  "recipe_type": "dessert",
  "brief_description": "This blackberry jam recipe is made with fresh, juicy berries for a sweet, fruity spread to slather over toast or spoon over ice cream or yogurt.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mash blackberries in a saucepan with a potato masher."
    },
    {
      "position": 3,
      "text": "Stir in sugar until juices are released. Remove 1 tablespoon blackberry juice from the saucepan; mix with cornstarch in a small bowl. Stir cornstarch mixture back into the saucepan."
    },
    {
      "position": 4,
      "text": "Bring blackberries to a boil; cook, stirring often, until jam has thickened, about 15 minutes."
    },
    {
      "position": 5,
      "text": "Stir in cinnamon and allspice. Remove saucepan from the heat and allow jam to cool, 30 to 45 minutes."
    },
    {
      "position": 6,
      "text": "Transfer jam to a bowl, cover, and refrigerate until chilled. Stir in lemon juice before serving."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

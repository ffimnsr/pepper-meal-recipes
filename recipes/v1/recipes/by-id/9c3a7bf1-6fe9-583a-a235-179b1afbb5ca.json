  "id": "9c3a7bf1-6fe9-583a-a235-179b1afbb5ca",
  "slug": "deviled-egg-dip-recipe-11843709",
  "name": "Deviled Egg Dip",
  "recipe_type": "appetizer",
  "brief_description": "This deviled egg dip is made without peeling a single egg! Instead, they're cracked into a loaf pan, baked in a water bath, and then blended with everything you expect to flavor a deviled egg. Serve this dip with crackers or toasted bread.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Lightly grease a loaf pan with cooking spray. Crack eggs into the pan and set the loaf pan inside a 9x13-inch baking dish. Add enough water to the baking dish to come up high enough on the loaf pan to be level with the eggs inside."
    },
    {
      "position": 2,
      "text": "Bake eggs in the preheated oven until fully set, 25 to 28 minutes. Remove from water bath and let cool for 10 minutes."
    },
    {
      "position": 3,
      "text": "Add eggs to a food processor and process until finely chopped. Add mayonnaise, cream cheese, mustard, pickle relish, Worcestershire, Cajun seasoning, and white parts of green onion. Reserve green part of green onion for garnish. Process until very smooth, 1 to 2 minutes."
    },
    {
      "position": 4,
      "text": "Transfer dip to a bowl, cover, and refrigerate for at least 2 hours. Top with reserved green onions, sprinkle with paprika, and top with chopped olives. Serve with crackers or toasted bread."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

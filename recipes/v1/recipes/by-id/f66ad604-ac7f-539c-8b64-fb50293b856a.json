  "id": "f66ad604-ac7f-539c-8b64-fb50293b856a",
  "slug": "cranberry-orange-cookies",
  "name": "Cranberry Orange Cookies",
  "recipe_type": "dessert",
  "brief_description": "These cranberry orange cookies are soft, buttery, delicious treats filled with tart cranberries and crunchy walnuts, topped with a sweet orange glaze.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Make the cookies: Cream butter, white sugar, and brown sugar in a mixing bowl until smooth. Beat in egg until well blended. Mix in orange juice and zest."
    },
    {
      "position": 3,
      "text": "Whisk together flour, baking soda, and salt in a separate bowl. Stir flour mixture into the butter mixture until combined. Mix in cranberries and walnuts until evenly distributed."
    },
    {
      "position": 4,
      "text": "Drop dough by rounded tablespoonfuls 2 inches apart onto ungreased cookie sheets."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven, switching racks halfway through, until edges are golden, 12 to 14 minutes. Transfer cookies to wire racks to cool completely."
    },
    {
      "position": 6,
      "text": "Meanwhile, make the glaze: Mix together confectioners' sugar, orange juice, and zest in a small bowl until smooth."
    },
    {
      "position": 7,
      "text": "Spread glaze over the tops of the cooled cookies; let stand until set."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

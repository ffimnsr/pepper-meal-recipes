  "id": "7f353f36-e981-5951-956c-26bb864b1aaa",
  "slug": "korean-cucumber-salad",
  "name": "Korean-Style Cucumber Salad",
  "recipe_type": "salad",
  "brief_description": "Vinegar and red pepper flakes add tangy snap to this cucumber, carrot, green onion, and sesame seed salad. It goes beautifully with bulgogi (Korean barbequed beef).",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl, stir together vinegar, black pepper, and red pepper flakes."
    },
    {
      "position": 2,
      "text": "Heat oil in a saucepan over medium-high heat. Stir in sesame seeds, and reduce heat to medium. Cook until seeds are brown, about 5 minutes. Remove seeds with a slotted spoon, and stir into vinegar mixture. Mix in cucumber, green onions, and carrot. Cover and refrigerate, at least 5 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,

  "id": "baa00310-4f60-529a-a1f2-75960e110c12",
  "slug": "slow-cooker-italian-beef-for-sandwiches",
  "name": "Slow Cooker Italian Beef",
  "recipe_type": "main",
  "brief_description": "This Italian beef is perfect for sandwiches and easy to make in a slow cooker to guarantee the most tender and juicy results. So simple, yet so tasty!",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, salad dressing mix, oregano, basil, parsley, onion salt, garlic powder, bay leaf, salt, and black pepper in a saucepan. Stir well, and bring to a boil."
    },
    {
      "position": 2,
      "text": "Place rump roast in a slow cooker; pour hot herb mixture over the meat."
    },
    {
      "position": 3,
      "text": "Cover and cook on Low for 10 to 12 hours, or on High for 4 to 5 hours."
    },
    {
      "position": 4,
      "text": "Remove bay leaf; shred beef with a fork and serve with some of the hot gravy."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 245,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

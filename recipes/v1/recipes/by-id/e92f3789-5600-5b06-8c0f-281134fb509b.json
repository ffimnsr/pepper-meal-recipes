  "id": "e92f3789-5600-5b06-8c0f-281134fb509b",
  "slug": "instant-pot-whole-chicken",
  "name": "Instant Pot Whole Chicken",
  "recipe_type": "main",
  "brief_description": "Cook a whole chicken in the Instant Pot; in only 35 minutes and you'll have tender, juicy chicken to add to many dishes or sauces.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place celery, carrots, and onion in the bottom of a multi-functional pressure cooker (such as Instant Pot\u00ae). Pat chicken dry and place on top of the vegetables. Sprinkle chicken evenly with salt, pepper, and paprika."
    },
    {
      "position": 2,
      "text": "Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 25 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 3,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Remove chicken and let stand for 5 minutes before cutting or shredding."
    },
    {
      "position": 4,
      "text": "Strain solids from the cooking liquid, if desired. Set to Saute, and reduce by half for a flavorful sauce."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

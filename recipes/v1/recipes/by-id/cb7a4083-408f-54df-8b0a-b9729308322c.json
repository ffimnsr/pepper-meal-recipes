  "id": "cb7a4083-408f-54df-8b0a-b9729308322c",
  "slug": "veggie-samosas",
  "name": "Veggie Samosas",
  "recipe_type": "appetizer",
  "brief_description": "These vegetarian samosas made with a simple homemade dough pack plenty of heat with their spicy potato and mixed vegetable filling.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a saute pan over medium heat. Add onion; cook for 1 minute. Add garlic, curry, ginger, cumin, salt, red pepper flakes, coriander, cayenne pepper, celery seed, tarragon, and cinnamon. Cook until fragrant, 1 to 2 minutes more. Add potatoes and mixed vegetables. Cook, stirring constantly, for 3 minutes."
    },
    {
      "position": 2,
      "text": "Pour broth into the potato mixture. Reduce heat to medium-low. Cook, stirring occasionally, until potatoes are tender and broth is mostly absorbed, 12 to 15 minutes."
    },
    {
      "position": 3,
      "text": "Place flour in a medium bowl. Make a well in the center; add salt, oil, and water, in that order. Mix into a stiff dough, roll into a ball, and wrap in plastic wrap. Set aside for 30 minutes."
    },
    {
      "position": 4,
      "text": "Divide dough into 8 balls. Roll each ball into a 10-inch circle. Cut each circle in half, moisten the edges, and shape each half into a cone around your finger. Fill dough with 1 to 2 tablespoons of the vegetable mixture. Pinch edges shut."
    },
    {
      "position": 5,
      "text": "Heat oil in a large saucepan or deep-fryer. Deep-fry samosas in batches until lightly browned, 2 to 3 minutes. Serve hot."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 50,
  "rest_time_minutes": null,
  "difficulty": "medium",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "56dc2903-7d7e-5ce3-8766-59c9af1a7a93",
  "slug": "zucchini-roll-lasagna-on-turkey-bolognese-recipe-8689910",
  "name": "Zucchini Roll Lasagna on Turkey Bolognese",
  "recipe_type": "main",
  "brief_description": "Chef John's incredible zucchini roll lasagna doesn't contain any pasta. Instead, thin zucchini strips are rolled around a 3-cheese filling and baked over a savory turkey Bolognese. The presentation is truly next-level.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "For cheese filling: Place ricotta, Parmigiano Reggiano, mozzarella, egg, black pepper, salt, cayenne, and parsley in a bowl, and stir together until combined; refrigerate until needed."
    },
    {
      "position": 2,
      "text": "For Bolognese: Heat olive oil over medium-high heat in a large nonstick skillet, and add Italian turkey sausage, onions, and a pinch of salt. Cook, breaking up the sausage with a spatula, until browned and broken into small crumbles, 5 to 7 minutes."
    },
    {
      "position": 3,
      "text": "Stir in marinara sauce, water, and cream and bring to a simmer. Reduce heat to medium-low and simmer, stirring occasionally, for at least 10 to 15 minutes. Sauce can be cooked longer, adding small amounts of water as needed to maintain consistency."
    },
    {
      "position": 4,
      "text": "Transfer sauce into a 13x9-inch baking dish and set aside."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 6,
      "text": "For zucchini rolls: trim ends of zucchini with a knife and then use a vegetable peeler to make lengthwise strips. For best results, use only the largest, widest center-cut pieces. You can also place two thinner pieces overlapped side-by-side. You will need to make a total of 30 zucchini rolls."
    },
    {
      "position": 7,
      "text": "Lay out zucchini strips on a work surface. Spread each strip with about 2 rounded teaspoons of cheese mixture and roll up."
    },
    {
      "position": 8,
      "text": "Place filled strips on top of sauce in the baking dish in a 5x6 pattern. Scatter grated Parmigiano Reggiano and grated mozzarella evenly over the top, and drizzle with olive oil."
    },
    {
      "position": 9,
      "text": "Bake in the preheated oven until sauce is bubbling, and cheese has started to brown, 45 to 60 minutes. Let rest for 5 to 10 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": 10,

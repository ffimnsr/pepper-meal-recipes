  "id": "631fba78-22d2-5be2-b7b3-f0c1537c8ab5",
  "slug": "strawberry-bruschetta",
  "name": "Strawberry Bruschetta",
  "recipe_type": "appetizer",
  "brief_description": "This strawberry bruschetta recipe creates a delicious variation on the popular tomato-based version, especially when the sugar topping caramelizes.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 2,
      "text": "Spread thin layer butter on each bread slice; arrange slices in a single layer on a large baking sheet."
    },
    {
      "position": 3,
      "text": "Broil under the preheated broiler until lightly toasted, 1 to 2 minutes. Divide strawberries among toast pieces; sprinkle with sugar."
    },
    {
      "position": 4,
      "text": "Broil under the preheated broiler until sugar caramelizes, 3 to 5 minutes. Serve immediately."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

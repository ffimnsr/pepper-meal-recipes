  "id": "6daaff4a-1b9f-5bf7-be6d-e528e4b2df22",
  "slug": "caprese-orzo-pesto-salad-recipe-11744879",
  "name": "Caprese Orzo Pesto Salad",
  "recipe_type": "salad",
  "brief_description": "Orzo, pesto and caprese ingredients come together in this refreshing salad. Delicious as a light dinner or a simple side dish for just about anything, and don\u2019t forget backyard BBQ\u2019s and potlucks.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine pesto, lemon juice, olive oil, and balsamic vinegar in a small bowl. Stir until well combined, season with salt and pepper, and set dressing aside."
    },
    {
      "position": 2,
      "text": "Bring a medium pot of salted water to a boil. Add orzo, and cook until tender yet still firm to the bite, 8 to 10 minutes. Drain pasta, and transfer to a medium bowl."
    },
    {
      "position": 3,
      "text": "Stir dressing into pasta, and allow it to sit for 5 to 10 minutes to allow flavors meld."
    },
    {
      "position": 4,
      "text": "Gently fold in tomatoes, mozzarella, cucumbers, and peas."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

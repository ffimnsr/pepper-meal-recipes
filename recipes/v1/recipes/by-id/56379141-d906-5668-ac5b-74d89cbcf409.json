  "id": "56379141-d906-5668-ac5b-74d89cbcf409",
  "slug": "roast-beef-sliders",
  "name": "Roast Beef Sliders",
  "recipe_type": "main",
  "brief_description": "This roast beef sliders recipe starts with provolone, mushrooms, peppers, and onion layered onto buns, brushed with seasoned melted butter, and then baked.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Slice buns in half vertically, leaving buns attached as a sheet. Peel off attached top sheet buns and set aside; place attached bottom sheet buns in the prepared dish. Layer roast beef and cheese across buns."
    },
    {
      "position": 3,
      "text": "Heat oil in a small skillet over medium-high heat. Add onion, bell pepper, and mushrooms; cook until soft, about 5 minutes. Spread onion mixture over beef and cheese; place top sheet buns on top."
    },
    {
      "position": 4,
      "text": "Combine melted butter, garlic powder, adobo seasoning, and Italian seasoning; brush on tops of buns, pouring any extra over sides."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cheese starts to melt, about 15 minutes. Separate each bun into a sandwich using a serrated knife. Serve hot."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

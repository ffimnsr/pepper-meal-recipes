  "id": "778d8b99-d320-5663-88aa-75f59f508a85",
  "slug": "easy-grilled-shrimp-fajitas",
  "name": "Easy Grilled Shrimp Fajitas",
  "recipe_type": "main",
  "brief_description": "Quick and easy shrimp fajitas on the grill. Don't forget your favorite toppings, such as guacamole, salsa, and sour cream.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Place bell pepper strips, onion, and jalape\u00f1o slices into a large bowl. Add 2 teaspoons fajita seasoning and olive oil. Stir until evenly combined."
    },
    {
      "position": 3,
      "text": "Place shrimp in a separate bowl. Add remaining 1/2 teaspoon fajita seasoning and lime juice. Gently stir until evenly combined."
    },
    {
      "position": 4,
      "text": "Place vegetable mixture in a grill basket and cook in the preheated grill for 10 minutes. Stir in shrimp and grill for 5 minutes more. Remove the basket from the grill."
    },
    {
      "position": 5,
      "text": "Place tortillas on the grill and toast for 2 minutes. Divide filling between tortillas and serve hot."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

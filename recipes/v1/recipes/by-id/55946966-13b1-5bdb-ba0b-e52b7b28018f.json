  "id": "55946966-13b1-5bdb-ba0b-e52b7b28018f",
  "slug": "creole-chitterlings-chitlins",
  "name": "Creole Chitterlings (Chitlins)",
  "recipe_type": "soup",
  "brief_description": "Boiled chitlins are a favorite soul food dish. In this recipe, they pick up lots of flavor as they simmer for several hours in a flavorful broth.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Clean chitterlings by removing all specks and any pieces of fat with specks on them. Rinse in several changes of salted water."
    },
    {
      "position": 3,
      "text": "Place cleaned chitterlings into a large pot and fill with enough water to cover; bring to a boil over medium-high heat. Drain, rinse, and return to the pot. Fill again with enough water to cover."
    },
    {
      "position": 4,
      "text": "Add whole onions, potato, and celery stalks, plus chopped bell pepper, vinegar, garlic, salt, bay leaf, Creole seasoning, and red pepper flakes to the pot. Bring to a boil over medium-high heat, then cover and simmer over medium heat for 3 to 4 hours; chitterlings should appear clear to white in color."
    },
    {
      "position": 5,
      "text": "Use a slotted spoon to transfer chitterlings to a cutting board. Cut into 1-inch pieces. Discard onions, potato, celery, and bay leaf. Pour out most of the cooking liquid, then return chitterlings to the pot."
    },
    {
      "position": 6,
      "text": "Cook over medium heat until chitterlings are heated through, 2 to 3 minutes."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 210,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

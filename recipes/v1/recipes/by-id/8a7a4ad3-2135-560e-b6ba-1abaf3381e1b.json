  "id": "8a7a4ad3-2135-560e-b6ba-1abaf3381e1b",
  "slug": "sweet-potato-country-dumplings-recipe-11836928",
  "name": "Sweet Potato Country Dumplings",
  "recipe_type": "dessert",
  "brief_description": "These sweet potato country dumplings are an easy-to-make dessert dumpling: crescent roll dough is wrapped around sweet potato patties, and baked in a sweet cinnamon sauce.",
  "cuisine": "American Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Separate crescent dough triangles and cut each in half lengthwise to make 16 thinner strips of dough. Wrap each dough piece around 1 potato piece and place in the prepared baking dish."
    },
    {
      "position": 3,
      "text": "In a small saucepan, whisk milk, 1 1/4 cups sugar, salt, and cornstarch together until well combined. Add butter and bring to a simmer over medium-high heat, stirring constantly. Simmer until thickened, about 3 minutes. Remove from heat and pour mixture over sweet potato dumplings."
    },
    {
      "position": 4,
      "text": "Stir remaining sugar and cinnamon together in a small bowl and sprinkle evenly over dumplings."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until browned and bubbly, 30 to 35 minutes. Let stand for 5 to 10 minutes before serving."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

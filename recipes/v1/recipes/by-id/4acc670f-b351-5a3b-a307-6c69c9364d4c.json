  "schema_version": 1,
  "id": "4acc670f-b351-5a3b-a307-6c69c9364d4c",
  "slug": "cherry-tomato-sauce-with-penne",
  "name": "Cherry Tomato Pasta Sauce",
  "recipe_type": "dessert",
  "brief_description": "Chef John's cherry tomato pasta sauce with garlic and oregano is naturally sweet, flavorful, and quick to make from scratch while your pasta boils.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cherry tomatoes, oil, garlic, salt, and black pepper in a saucepan over medium-low heat. Cook and stir until garlic is just toasted, 2 to 3 minutes."
    },
    {
      "position": 2,
      "text": "Pour chicken broth into tomato mixture; bring to a simmer and cook until tomatoes start to collapse and burst, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil; add penne and cook, stirring occasionally, until tender yet firm to the bite, about 8 to 11 minutes. Drain."
    },
    {
      "position": 4,
      "text": "Stir oregano and red pepper flakes into pasta sauce; puree with a stick blender until smooth."
    },
    {
      "position": 5,
      "text": "Add penne to tomato sauce; stir until pasta is well coated with sauce. Stir in cheese and season with salt and pepper. Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

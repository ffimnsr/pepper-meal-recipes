  "id": "c1a2d55e-a478-5e57-a82e-d485052c096a",
  "slug": "campfire-queso-recipe-7567853",
  "name": "Campfire Queso",
  "recipe_type": "appetizer",
  "brief_description": "We tried the smoked queso trend from TikTok and stirred in taco-bar toppers. For a less indulgent, vegan take, try the stir-together salsa instead. It\u2019s got everything but the meat and dairy.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a 10-inch cast-iron skillet on a grill grate over a fire. You can also preheat an outdoor grill to medium-high heat (375 degrees F to 400 degrees F (190 degrees C to 200 degrees C)) ."
    },
    {
      "position": 2,
      "text": "Add beef, sausage, onion, bell pepper, and jalape\u00f1o to the skillet. Cook, stirring to break up lumps, until meat is browned, about 8 minutes. Pour off grease. Stir in tomatoes with green chiles, cheese product, cream cheese, pepper Jack, beans, and corn. Cover skillet with foil and cook for 8 minutes."
    },
    {
      "position": 3,
      "text": "Uncover skillet; continue cooking, stirring occasionally, until cheese is melted and bubbly, 2 minutes more."
    },
    {
      "position": 4,
      "text": "Top with avocado, sour cream, and cilantro. Serve with tortilla chips."
    }
  ],
  "servings": null,

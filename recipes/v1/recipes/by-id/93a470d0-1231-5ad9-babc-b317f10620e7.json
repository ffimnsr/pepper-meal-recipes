  "id": "93a470d0-1231-5ad9-babc-b317f10620e7",
  "slug": "french-onion-soup-vii",
  "name": "French Onion Soup VII",
  "recipe_type": "soup",
  "brief_description": "Onions are caramelized in butter, then combined with broth and white wine for a quick and simple onion soup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large pot over medium heat. Saute onions until deep brown, about 20 minutes. Stir in broth and wine, using a wooden spoon to scrape the bottom of the pot. Season with salt and pepper. Cook until heated through."
    },
    {
      "position": 2,
      "text": "Preheat oven on broiler setting. Ladle soup into heatproof serving bowls. Top each bowl with a slice of bread, and sprinkle with cheese. Place under a hot broiler until cheese is melted and slightly browned."
    }
  ],
  "servings": 6,

  "id": "c524df78-b9d9-58cd-98d6-3c8f2d8ab238",
  "slug": "baked-pumpkin-cheesecake-oatmeal-recipe-11837847",
  "name": "Baked Pumpkin Cheesecake Oatmeal",
  "recipe_type": "dessert",
  "brief_description": "This baked pumpkin cheesecake oatmeal, made with pumpkin puree and warm pie spices, has a cheesecake swirl that takes it to a whole new level. Serve warm, with an extra drizzle of maple syrup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Butter a 9x9-inch square pan."
    },
    {
      "position": 2,
      "text": "For oatmeal, in a large bowl, whisk together pumpkin, milk, yogurt, olive oil, egg, maple syrup, vanilla, pumpkin pie spice, cinnamon, and salt until thoroughly smooth and combined. Stir in oats and baking powder until incorporated. Pour mixture into the prepared pan."
    },
    {
      "position": 3,
      "text": "For cheesecake swirl, beat cream cheese in a bowl with an electric mixer until smooth. Add in 1/4 cup yogurt, 2 tablespoons maple syrup, 1 teaspoon vanilla, lemon juice, and pinch of salt and beat until smooth and combined."
    },
    {
      "position": 4,
      "text": "Place dollops of cheesecake swirl over pumpkin oatmeal. Use a butter knife to swirl cheesecake in a few times."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until oatmeal looks set, 40 to 50 minutes. Allow mixture to cool slightly before serving."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "8de755a9-3ade-5ad7-970f-d31304769f12",
  "slug": "blueberry-baked-oats-recipe-11691600",
  "name": "Blueberry Baked Oats",
  "recipe_type": "dessert",
  "brief_description": "These blueberry baked oats are a tasty high-protein breakfast with a subtle dessert vibe. A blender mix with eggs, oats, and cottage cheese bake with blueberries on top in individual servings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Spray 4 (6 to 8 ounce) oven-proof glass dishes with cooking spray."
    },
    {
      "position": 2,
      "text": "Meanwhile combine cottage cheese, eggs, agave syrup, vanilla, oats, baking powder, and pudding mix in the jar of a high powered blender. Blend on high for 1 minute. Divide batter evenly between prepared dishes. Sprinkle blueberries on top."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until set, about 25 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

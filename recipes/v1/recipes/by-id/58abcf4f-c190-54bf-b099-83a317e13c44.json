  "id": "58abcf4f-c190-54bf-b099-83a317e13c44",
  "slug": "chinese-braised-spare-ribs",
  "name": "Chinese Braised Spare Ribs",
  "recipe_type": "main",
  "brief_description": "Tender pork spareribs swimming in a fragrant ginger soy sauce served over rice make a satisfying meal.",
  "cuisine": "Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of water to a boil, then add the spareribs, and cook uncovered for 3 to 5 minutes. Drain in a colander and set aside."
    },
    {
      "position": 2,
      "text": "Heat the vegetable oil in a skillet over high heat. Stir in the ginger, green onions, and cinnamon; cook and stir until fragrant. Stir in the spareribs and cook for 3 to 5 minutes. Pour in the water, soy sauce, sugar, and rice wine. Season with salt and pepper. Bring the mixture to a boil, then reduce heat to low and cover. Simmer until the spareribs are tender, about 1 hour."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 75,

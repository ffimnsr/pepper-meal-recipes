  "slug": "absolutely-fabulous-greekhouse-dressing",
  "name": "Absolutely Fabulous Greek Salad Dressing",
  "recipe_type": "salad",
  "brief_description": "This Greek salad dressing is easy to make with red wine vinegar, olive oil, and the perfect amount of seasonings to liven up salads, veggies, or any dish.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix olive oil, garlic powder, oregano, basil, pepper, salt, onion powder, and Dijon-style mustard together in a very large container. Pour in vinegar slowly while mixing vigorously until well blended. Store tightly covered at room temperature."
    },
    {
      "position": 3,
      "text": "Pour over salad and enjoy!"
    }
  ],
  "servings": 120,

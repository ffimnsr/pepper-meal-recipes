  "id": "5db4838a-ddfd-56ca-a668-113c39098abe",
  "slug": "broccoli-rice",
  "name": "Broccoli Rice",
  "recipe_type": "side",
  "brief_description": "This broccoli rice is simply seasoned with garlic and lemon to make a delicious low-carb replacement for rice in stir-fries, tacos, or grain bowls.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place 1/2 of the broccoli florets in a food processor; pulse about 20 times until broccoli looks like grains of rice. Repeat with remaining broccoli florets."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet over medium-low heat. Add onion; cook and stir until softened, about 3 minutes. Stir in garlic; cook for 30 seconds. Stir in broccoli rice, salt, and pepper. Reduce heat to low and cook, covered, until broccoli has softened, about 5 minutes. Pour lemon juice on top."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

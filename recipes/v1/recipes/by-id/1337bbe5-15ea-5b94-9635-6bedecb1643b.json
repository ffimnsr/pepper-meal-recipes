  "id": "1337bbe5-15ea-5b94-9635-6bedecb1643b",
  "slug": "zucchini-crisp",
  "name": "Zucchini Crisp",
  "recipe_type": "dessert",
  "brief_description": "Topped with a sweet brown sugar-oat mixture, this zucchini crisp recipe flavored with lemon juice, cinnamon, and nutmeg tastes just like an apple crisp.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Combine zucchini, sugar, lemon juice, cinnamon, and nutmeg in a large bowl; transfer to the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Combine brown sugar, oats, and flour in a separate bowl; cut in margarine until mixture resembles coarse crumbs. Sprinkle crumb mixture over zucchini mixture."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bubbly and zucchini is tender, 40 to 45 minutes."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,

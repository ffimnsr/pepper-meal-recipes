  "id": "b60ad40a-0c30-5b5f-abea-b6fb0ea11862",
  "slug": "soy-sauce-compound-butter-recipe-12035128",
  "name": "Soy Sauce Compound Butter",
  "recipe_type": "side",
  "brief_description": "Add a salty, umami punch to butter with this soy sauce compound butter recipe. Try it over grilled steak or pork chops.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine soy sauce, brown sugar, the white and 2 tablespoons of the pale green parts of the green onions, and garlic in a small saucepan."
    },
    {
      "position": 2,
      "text": "Bring to a boil, stirring to dissolve sugar. Reduce heat to medium-low; simmer, uncovered, until mixture is reduced and slightly thickened, about 6 minutes. Transfer to a bowl and let cool to room temperature, about 20 minutes."
    },
    {
      "position": 3,
      "text": "Add butter, remaining chopped green parts of green onions, and crushed red pepper to the cooled soy sauce mixture. Whisk until evenly combined."
    },
    {
      "position": 4,
      "text": "Shape into a log and wrap in plastic wrap. Chill until firm, about 2 hours."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "e03e9ed1-2fb6-561e-ba5a-8f52291104d4",
  "slug": "sweet-potato-cranberry-bake",
  "name": "Sweet Potato Cranberry Bake",
  "recipe_type": "dessert",
  "brief_description": "The Thanksgiving staples, yams and cranberries, come together to make a sweet and tart side dish.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine cranberries, orange slices, sugar, pecans, orange juice, cinnamon, nutmeg, and mace in a 2-quart baking dish."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until cranberries soften, about 30 minutes. Stir yams into cranberry mixture and continue baking until heated through, about 15 minutes more."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 45,

  "id": "69c93df2-8bbd-5871-9bc4-63576f2bceff",
  "slug": "one-pan-oven-mac-and-cheese",
  "name": "One-Pan Oven Mac and Cheese",
  "recipe_type": "side",
  "brief_description": "This one-pan oven mac and cheese combines four types of cheese with a rich, creamy sauce--it's a crowd-pleasing side that's ready in just under an hour.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place blocks of Fontina and sharp Cheddar cheeses in the center of an ungreased, 9-inch square baking dish. Pour pasta into the dish, spreading evenly around the cheese. Pour half-and-half directly on top of the pasta and stir until evenly coated. Sprinkle with salt and pepper, then top with shredded white Cheddar and mozzarella cheeses, spreading evenly."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 25 minutes. Pull the dish out of the oven, stir in milk, and mix until noodles, cheese, and sauce are evenly combined. Return to the oven and cook until golden and bubbly, about 25 minutes more."
    },
    {
      "position": 4,
      "text": "Stir and serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

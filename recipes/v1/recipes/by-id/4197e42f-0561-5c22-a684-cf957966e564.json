  "id": "4197e42f-0561-5c22-a684-cf957966e564",
  "slug": "cyndis-shrimp-fajitas",
  "name": "Cyndi's Shrimp Fajitas",
  "recipe_type": "main",
  "brief_description": "Marinated shrimp, vegetables, and cheese enclosed in flour tortillas. I love making these fajitas...and my friends love it when I make them.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl, combine the Worcestershire, lime juice, soy sauce, and chile powder. Add the shrimp and marinate 15 minutes."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet over medium heat. Cook the zucchini, onion, and corn for 10 minutes or until the vegetables are tender. Cover to keep warm and set aside."
    },
    {
      "position": 3,
      "text": "In a separate skillet heat olive oil over medium heat. Add the shrimp and cook for 3 to 5 minutes, until the shrimp are pink. Combine the shrimp and the vegetables. Place shrimp and vegetable mixture in tortillas; sprinkle with the Monterey Jack cheese and cilantro."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

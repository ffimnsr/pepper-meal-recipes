  "id": "21f59775-5bbc-5141-83f9-2f1008845bb9",
  "slug": "lemon-chess-pie-i",
  "name": "Lemon Chess Pie I",
  "recipe_type": "dessert",
  "brief_description": "The recipe has been handed down in the family, and temperatures were for a wood stove. I've adjusted them over the years, and it seems to work fine!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine eggs, sugar, cornmeal, melted butter, milk, and lemon juice in a large bowl. Mix until sugar is dissolved, but do not beat. Pour filling into unbaked pie shell."
    },
    {
      "position": 3,
      "text": "Bake at 425 degrees F (220 degrees C) for 10 minutes. Reduce temperature to 350 degrees F (175 degrees C), and continue to bake until set, about 45 minutes more. Serve at room temperature."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 10,

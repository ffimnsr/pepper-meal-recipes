  "id": "606dd678-4934-51fd-9db5-5961713ffa62",
  "slug": "lamb-patties",
  "name": "Lamb Patties",
  "recipe_type": "main",
  "brief_description": "Deliciously spiced ground lamb, stuffed into puff pastry pockets and baked to perfection. Makes a good finger food.",
  "cuisine": "World",
  "instructions": [
    {
      "position": 1,
      "text": "In a large pot, combine the ground lamb, onion, chilies, soy sauce and Worcestershire sauce. Season with ginger and garlic pastes, white pepper, cinnamon, cardamom and cloves. Cook, stirring occasionally, over medium heat until the meat is evenly browned and the onions are tender, about 15 minutes. Mix in cilantro, cover and set aside."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lay sheets of puff pastry out on a lightly floured surface. Cut each one into 9 squares and roll out to 1/4 inch thickness. Spoon about 1 1/2 tablespoons of the meat mixture into the center of each square. Brush the edge with water, fold corner over to form a triangle, and press to seal. Do not overstuff the triangles, or they will burst in the oven. Place the patties onto a foil lined baking sheet leaving at least an inch between each one. Brush the tops lightly with beaten egg."
    },
    {
      "position": 3,
      "text": "Bake for 12 to 15 minutes in the preheated oven, or until golden brown all over. Serve hot for best flavor."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

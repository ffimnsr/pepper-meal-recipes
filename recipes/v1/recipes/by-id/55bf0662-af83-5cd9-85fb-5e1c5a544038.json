  "id": "55bf0662-af83-5cd9-85fb-5e1c5a544038",
  "slug": "slow-cooker-beef-tips-with-mushroom-gravy-recipe-11694515",
  "name": "Slow Cooker Beef Tips with Mushroom Gravy",
  "recipe_type": "main",
  "brief_description": "These slow cooker beef tips with mushroom gravy make a comforting meal with very little effort. Flavorful pantry ingredients simmer in the slow cooker together with beef, for a rich gravy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine beef tips, tomato paste, garlic powder, onion powder, Cantanzaro herbs, salt, and pepper in a 6- to 7-quart slow cooker. Stir until beef is coated in tomato paste and seasonings. Pour beef bone broth over everything."
    },
    {
      "position": 2,
      "text": "Cover the slow cooker and cook until beef is tender, 4 hours on High or 6 to 8 hours on Low. 30 minutes before the end time, add the sliced mushrooms."
    },
    {
      "position": 3,
      "text": "Place cornstarch in a small bowl and ladle 1/4 cup of the hot broth from the slow cooker into the bowl. Use a small whisk or fork to mix the cornstarch into the liquid until dissolved."
    },
    {
      "position": 4,
      "text": "Pour cornstarch slurry into the mixture in the slow cooker and mix until incorporated. Set slow cooker to High, cover, and cook until for 30 minutes or until liquid is thickened."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 270,
  "preparation_time_minutes": 10,

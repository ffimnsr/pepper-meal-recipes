  "id": "835ee675-c932-515f-a034-fdebd63d27a0",
  "slug": "chicken-avocado-and-bacon-lettuce-wrap",
  "name": "Chicken, Avocado, and Bacon Lettuce Wrap",
  "recipe_type": "appetizer",
  "brief_description": "This recipe uses leftover rotisserie chicken to create an easy and delicious bacon lettuce wrap with avocado, onion, and tomato.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels, reserving grease in skillet."
    },
    {
      "position": 2,
      "text": "Add chicken to skillet and stir to coat with bacon drippings. Season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Mash avocado in a bowl and season with lemon juice, garlic, salt, and pepper. Add tomato and onion to taste."
    },
    {
      "position": 4,
      "text": "Divide cooked bacon, chicken, and avocado spread between lettuce leaves and wrap up."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "c9b96ecb-ed59-593f-8569-3d085366bf0a",
  "slug": "blackberry-jalapeno-jelly",
  "name": "Blackberry Jalape\u00f1o Jelly",
  "recipe_type": "dessert",
  "brief_description": "This blackberry jalape\u00f1o jelly recipe is made with fresh, minced jalape\u00f1o peppers and sugar, making a sweet and spicy condiment for your cheeseboard.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Inspect 5 half-pint jars for cracks and rings for rust, discarding any defective ones. Immerse in simmering water until jelly is ready. Wash new, unused lids and rings in warm soapy water."
    },
    {
      "position": 2,
      "text": "Combine \u00bd cup sugar and pectin in a bowl; transfer to a saucepan."
    },
    {
      "position": 3,
      "text": "Stir blackberry juice, green jalape\u00f1o, and red jalape\u00f1o into pectin mixture; bring to a boil over medium-high heat. Add remaining 3 \u00bd cups sugar; return to a rolling boil until sugar has fully dissolved, about 1 minute. Off heat, stir to remove bubbles and foam, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Pack jelly into hot, sterilized jars, filling to within \u00bc inch of tops. Run a clean knife or thin spatula around insides of jars to remove any air bubbles. Wipe rims with a moist paper towel to remove any residue. Top with lids and screw rings on tightly."
    },
    {
      "position": 5,
      "text": "Place a rack in the bottom of a large stockpot and fill halfway with water. Bring to a boil and lower jars 2 inches apart into the boiling water using a holder. Pour in more boiling water to cover jars by at least 1 inch. Bring to a rolling boil, cover, and process for 10 minutes or according to your local extension."
    },
    {
      "position": 6,
      "text": "Remove jars from the stockpot and let rest, several inches apart, for 12 to 24 hours. Press centers of lids with a finger to ensure lids do not move up or down. Remove rings for storage and store in a cool, dark area. Refrigerate jelly after seal is broken."
    }
  ],
  "servings": 72,
  "cooking_time_minutes": 25,

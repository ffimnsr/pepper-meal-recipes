  "id": "241c090f-08fc-5b3f-8706-fd7b22f312b8",
  "slug": "souvlaki",
  "name": "Souvlaki",
  "recipe_type": "main",
  "brief_description": "Delicious souvlaki skewers made with marinated pork, onions, and bell peppers cooked on a grill until succulent, tender, and full of Greek flavor.",
  "cuisine": "Greek",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix oil, soy sauce, lemon juice, garlic, and oregano together in a large glass bowl."
    },
    {
      "position": 3,
      "text": "Add pork, onions, and bell peppers, and stir until coated. Cover and refrigerate for 2 to 3 hours."
    },
    {
      "position": 4,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate."
    },
    {
      "position": 5,
      "text": "Remove pork and vegetables from marinade and shake off excess; thread onto skewers. Discard remaining marinade."
    },
    {
      "position": 6,
      "text": "Cook on the preheated grill, turning frequently, until pork is no longer pink in the middle, 10 to 15 minutes. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C)."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

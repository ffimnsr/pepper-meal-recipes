  "id": "6e026092-9370-54ba-a38d-35932fc74458",
  "slug": "evies-rhubarb-pie-with-oatmeal-crumble",
  "name": "Evie's Rhubarb Pie with Oatmeal Crumble",
  "recipe_type": "dessert",
  "brief_description": "Evie's easy rhubarb pie with oatmeal crumble recipe features fresh rhubarb mixed with sugar, tapioca, and butter, and topped with a cinnamon oat crumble.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Place crust in a 9-inch pie plate; set aside."
    },
    {
      "position": 2,
      "text": "Toss rhubarb, 1 \u00bd cups sugar, and tapioca together in a large bowl until evenly combined; drizzle with 1 \u00bd tablespoons melted butter and toss again to coat. Pour rhubarb mixture into pie crust; set aside."
    },
    {
      "position": 3,
      "text": "Combine oats, remaining \u00bc cup sugar, flour, remaining 1 tablespoon melted butter, and cinnamon in a small bowl until evenly blended; sprinkle over rhubarb mixture."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 15 minutes. Reduce the oven temperature to 325 degrees F (165 degrees C). Continue baking until rhubarb is fork-tender, about 30 minutes more. Cool to room temperature before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

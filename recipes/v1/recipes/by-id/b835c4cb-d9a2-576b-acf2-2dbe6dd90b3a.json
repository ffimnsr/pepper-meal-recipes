  "id": "b835c4cb-d9a2-576b-acf2-2dbe6dd90b3a",
  "slug": "instant-pot-mushroom-stew",
  "name": "Instant Pot Mushroom Stew",
  "recipe_type": "soup",
  "brief_description": "Two types of mushrooms provide meaty texture in this hearty vegetarian Instant Pot stew that's loaded with tons of veggies and stewed tomatoes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot), add butter, and select Saut\u00e9 function. Add onions, carrots, and celery; saut\u00e9 until onions are translucent, 5 to 7 minutes. Season with salt and pepper and remove to a bowl."
    },
    {
      "position": 2,
      "text": "Add chopped and sliced baby bella mushrooms, white mushrooms, and wine to the pot; sweat mushrooms until soft and alcohol has cooked off, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Stir in 1/2 teaspoon salt, Cajun seasoning, paprika, thyme, sage, and red pepper flakes. Add stewed tomatoes with juice, tomato paste, soy sauce, Worcestershire sauce, and garlic. Simmer until heated through, 3 to 4 minutes. Add onion mixture back to the pot and stir to combine."
    },
    {
      "position": 4,
      "text": "Add potatoes, kidney beans, peas, lima beans, parsley, and bay leaves; stir until combined and bay leaves are submerged. Close and lock the lid. Select high pressure according to manufacturer's instructions; set the timer for 8 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 5,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, 15 minutes. Release remaining pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Stir in sour cream, followed by cornstarch if thickening is needed."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "medium",

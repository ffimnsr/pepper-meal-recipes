  "id": "a6cb5dcd-5736-5de0-a592-d0416128277b",
  "slug": "savory-corn-muffins",
  "name": "Savory Corn Muffins",
  "recipe_type": "main",
  "brief_description": "This recipe yields a bread that's moist and savory and tastes distinctly of corn. Unlike many corn muffins, these stay moist, thanks to canned creamed corn.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Adjust oven rack to middle position and heat oven to 450 degrees. Put a 12-cup muffin tin (with standard-sized molds of 12-cup capacity) in oven to heat while preparing batter."
    },
    {
      "position": 2,
      "text": "Microwave creamed corn in a 1-quart Pyrex-type measuring cup to a full boil (or in a medium saucepan over medium heat). Stir in 1 cup of the cornmeal to make a very thick, pasty mush. If the mush is not stiff, microwave an additional 30 seconds or so. Whisk in buttermilk, then eggs and finally butter."
    },
    {
      "position": 3,
      "text": "Mix remaining cornmeal with flour, sugar, salt, baking powder and soda in a medium bowl. Pour wet ingredients into dry and stir until just combined."
    },
    {
      "position": 4,
      "text": "Remove muffin tin from oven; coat with non-stick cooking spray. Divide batter evenly among cups (a spring-action ice cream scoop works well)."
    },
    {
      "position": 5,
      "text": "Bake until golden brown on sides and bottom, about 15 minutes. Turn onto a wire rack; let cool 5 minutes. Serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": null,

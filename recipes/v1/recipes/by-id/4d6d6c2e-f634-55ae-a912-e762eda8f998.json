  "id": "4d6d6c2e-f634-55ae-a912-e762eda8f998",
  "slug": "potato-leek-and-sauerkraut-soup-recipe-11890144",
  "name": "Potato, Leek and Sauerkraut Soup",
  "recipe_type": "soup",
  "brief_description": "In this potato, leek, and sauerkraut soup, kielbasa and vegetables combine, resulting in a rich, tart, and velvety soup. Serve with crusty bread if desired.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large soup pot over medium-high heat. Add kielbasa and cook for 3 minutes. Add leek, celery, and potatoes to the pot and cook 2 minutes more."
    },
    {
      "position": 2,
      "text": "Add thyme, crushed red chili, and broth. Bring to a boil, reduce heat to low, cover, and cook for 30 minutes."
    },
    {
      "position": 3,
      "text": "Uncover; stir in sauerkraut and half-and-half. Cook 5 minutes more. Ladle into serving bowls and garnish with scallions."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,

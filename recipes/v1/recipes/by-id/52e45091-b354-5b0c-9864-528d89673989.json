  "id": "52e45091-b354-5b0c-9864-528d89673989",
  "slug": "spicy-sausage-and-peppers-over-rice",
  "name": "Spicy Sausage and Peppers Over Rice",
  "recipe_type": "main",
  "brief_description": "I whipped up this turkey sausage, bell pepper, and brown rice dish for my boyfriend one night, and he loved it! It's so simple, even he can make it!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour brown rice and water into a small saucepan. Bring to a simmer over medium-high heat, then reduce heat to medium-low, cover, and simmer until rice is tender, about 40 minutes."
    },
    {
      "position": 2,
      "text": "Preheat a skillet over medium-high heat. Add turkey sausage, and cook until well browned on the outside, and no longer pink on the inside. Remove cooked sausage, then stir in garlic and onion. Cook for a few minutes until the onion softens and begins to turn translucent. Add green pepper and cook for 2 minutes."
    },
    {
      "position": 3,
      "text": "Pour in half of the vegetable stock along with the tomatoes and pimiento. Season to taste with red pepper flakes, Cajun seasoning, and pepper. Cook until the liquid has almost completely evaporated. Stir in sausage with remaining vegetable broth, and simmer until all is hot. Serve sausage mixture over brown rice."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "37dcb699-9837-54f8-8895-a5c2e1c4b2e6",
  "slug": "bread-and-butter-pickle-deviled-eggs",
  "name": "Bread and Butter Pickle Deviled Eggs",
  "recipe_type": "appetizer",
  "brief_description": "This is a deviled egg recipe that uses bread and butter pickles and honey mustard.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Halve eggs lengthwise. Carefully remove yolks to a small bowl and mash with a fork; add mayonnaise, pickles, honey mustard, and black pepper. Blend the mixture until smooth."
    },
    {
      "position": 2,
      "text": "Scoop yolk mixture into egg halves; garnish with paprika. Keep refrigerated until ready to serve."
    }
  ],
  "servings": 12,

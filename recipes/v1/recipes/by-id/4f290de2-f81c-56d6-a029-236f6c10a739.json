  "id": "4f290de2-f81c-56d6-a029-236f6c10a739",
  "slug": "tomato-chicken-parmesan",
  "name": "Tomato Chicken Parmesan",
  "recipe_type": "main",
  "brief_description": "A double cheese effect, as Parmesan-coated chicken swims in a pool of pasta sauce with a blanket of melted Monterey Jack over all.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Pour beaten eggs into a shallow dish or bowl. In another shallow dish or bowl, mix together the grated Parmesan cheese and bread crumbs. Dip chicken breasts into beaten egg, then into bread crumb mixture to coat."
    },
    {
      "position": 3,
      "text": "In a large skillet, heat oil over medium high heat. Add coated chicken and saute for about 8 to 10 minutes each side, or until chicken is cooked through and juices run clear."
    },
    {
      "position": 4,
      "text": "Pour tomato sauce into a lightly greased 9x13 inch baking dish. Add chicken, then place a slice of Monterey Jack cheese over each breast, and bake in the preheated oven for 20 minutes or until cheese is completely melted."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

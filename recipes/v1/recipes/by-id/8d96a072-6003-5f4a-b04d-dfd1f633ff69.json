  "schema_version": 1,
  "id": "8d96a072-6003-5f4a-b04d-dfd1f633ff69",
  "slug": "2-ingredient-dough-air-fryer-blueberry-bagels",
  "name": "2-Ingredient Dough Air Fryer Blueberry Bagels",
  "recipe_type": "breakfast",
  "brief_description": "Use the trendy 2-ingredient dough to make these blueberry bagels in your air fryer for a special treat!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place blueberries in a small bowl, and pour boiling water over them. Let sit for 5 minutes, and drain"
    },
    {
      "position": 2,
      "text": "Add flour, yogurt, and blueberries to a large stand mixer bowl. Using the dough hook, mix at low speed for about 3 minutes. If you're using a KitchenAid mixer, use speed 3. Dough will be crumbly."
    },
    {
      "position": 3,
      "text": "Transfer the dough to a lightly floured surface. Divide the dough into 4 equal balls, pressing, stretching, and rolling into ropes that are about 8 inches long, 3/4-inch thick. Connect the ends pinching into a bagel shape with hole in the middle."
    },
    {
      "position": 4,
      "text": "Preheat an air fryer to 280 degrees F (137 degrees C) for about 3 minutes. Combine the egg and water, and brush on each bagel, then sprinkle with cinnamon sugar. Line the air fryer basket with a parchment liner or lightly spray with cooking spray."
    },
    {
      "position": 5,
      "text": "Place the bagels in the basket not touching, and cook until golden brown, 15 to 16 minutes. Don't crowd the basket, and cook in two batches if necessary. Your time may vary depending on the size and brand of your air fryer."
    },
    {
      "position": 6,
      "text": "Remove the bagels to a rack, and cool for about 10 minutes before slicing."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

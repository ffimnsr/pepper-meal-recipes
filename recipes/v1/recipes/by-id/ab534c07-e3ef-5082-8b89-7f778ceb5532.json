  "id": "ab534c07-e3ef-5082-8b89-7f778ceb5532",
  "slug": "soy-butter-pasta-with-chicken-recipe-11694681",
  "name": "Soy Butter Pasta with Chicken",
  "recipe_type": "main",
  "brief_description": "This soy butter pasta with chicken has a simple sauce made from Parmesan cheese, garlic, ginger, and soy sauce, and is topped with toasted breadcrumbs, green onions, and cilantro.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of salted water to a boil. Add pasta to the boiling water and cook until barely tender with a bite, 8 to 10 minutes, or about 1 minute less than recommended time. Drain and set aside."
    },
    {
      "position": 2,
      "text": "Meanwhile, in a saucepan, melt 1 tablespoon butter. Add panko, kosher salt, and pepper flakes. Stir frequently until breadcrumbs are a nice, soft golden brown, about 3 minutes. Remove breadcrumbs to a small bowl; set aside. Wipe out the saucepan and return to the stovetop."
    },
    {
      "position": 3,
      "text": "Melt remaining butter in the saucepan. Add garlic paste and ginger paste and cook for a few seconds. Pour in soy sauce; season with black pepper. Stir, then slowly add in the Parmesan cheese, stirring to prevent clumping. Add chicken to the sauce and cook until heated through, about 3 minutes."
    },
    {
      "position": 4,
      "text": "Add pasta to the sauce, mix thoroughly, and season with salt or pepper. Serve in bowls with green onion, cilantro, and breadcrumbs on top."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 15,

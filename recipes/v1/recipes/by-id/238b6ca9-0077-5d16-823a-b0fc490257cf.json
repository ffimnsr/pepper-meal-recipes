  "id": "238b6ca9-0077-5d16-823a-b0fc490257cf",
  "slug": "chicken-piccata-iii",
  "name": "Chicken Piccata III",
  "recipe_type": "main",
  "brief_description": "This spin on the original features the addition of mushrooms and artichokes in the lemony sauce.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "In a shallow bowl, mix together flour, paprika, and salt and pepper. Dredge chicken pieces in the seasoned flour."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over medium heat, and saute chicken until light golden brown (about 45 seconds each side). Remove chicken from skillet, and set aside."
    },
    {
      "position": 3,
      "text": "To skillet, add mushrooms, lemon juice, and chicken stock. Simmer until a smooth, light sauce develops. Season with garlic powder. Return chicken to the skillet, and simmer until chicken is no longer pink and juices run clear. Stir in artichoke hearts, and remove from heat."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

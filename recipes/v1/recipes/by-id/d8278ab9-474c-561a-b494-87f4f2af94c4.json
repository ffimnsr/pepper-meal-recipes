  "schema_version": 1,
  "id": "d8278ab9-474c-561a-b494-87f4f2af94c4",
  "slug": "best-grilled-pork-chops",
  "name": "Best Grilled Pork Chops",
  "recipe_type": "main",
  "brief_description": "These grilled pork chops are easy to prep with a really simple soy, garlic, and lemon pepper marinade that adds loads of flavor to the pork.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix water, soy sauce, vegetable oil, lemon-pepper seasoning, and garlic in a deep bowl; add pork chops and toss to coat. Marinate in the refrigerator for at least 2 hours."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Remove pork chops from the marinade and shake off excess; discard the remaining marinade."
    },
    {
      "position": 4,
      "text": "Cook the pork chops on the preheated grill until no longer pink in the center, 5 to 6 minutes per side. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C)."
    },
    {
      "position": 5,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

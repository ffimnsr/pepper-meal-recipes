  "id": "81d920eb-6faa-595e-a55b-cec16a3796ad",
  "slug": "texas-cowboy-baked-beans",
  "name": "Texas Cowboy Baked Beans",
  "recipe_type": "dessert",
  "brief_description": "Not your usual baked beans! Green chiles and hot pepper sauce give zest to these eat-'em up sweet-and-hot baked beans.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "In a skillet over medium heat, brown the ground beef until no longer pink; drain fat, and set aside."
    },
    {
      "position": 2,
      "text": "In a 3 1/2 quart or larger slow cooker, combine the ground beef, baked beans, green chiles, onion and barbeque sauce. Season with brown sugar, garlic powder, chili powder and hot pepper sauce. Cook on HIGH for 2 hours, or low for 4 to 5 hours."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 120,

  "id": "597dc9c4-7d46-5510-8e74-90b451e081a3",
  "slug": "strawberry-cottage-cheese-ice-cream-recipe-12005775",
  "name": "The 4-Ingredient No-Churn Strawberry Ice Cream We Can\u2019t Stop Making",
  "recipe_type": "dessert",
  "brief_description": "This strawberry cottage cheese ice cream is a creamy, protein-packed alternative to traditional ice cream that\u2019s easy to make at home. Fresh strawberries add bright flavor, and you can easily substitute your favorite summer berries.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add cottage cheese, honey, 1 cup diced strawberries, and vanilla extract to a blender. Blend until creamy. Stir in remaining berries, then pour into a freezer-safe container."
    },
    {
      "position": 2,
      "text": "Freeze until firm, about 4 hours. Let it sit on the counter for 30 minutes to soften before serving. Garnish with whole berries and dust with graham cracker crumbles."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,

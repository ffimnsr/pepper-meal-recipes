  "id": "70dd64ad-370a-51b9-842b-f9552960418b",
  "slug": "spinach-feta-frittata",
  "name": "Spinach-Feta Frittata",
  "recipe_type": "breakfast",
  "brief_description": "This spinach and feta frittata is great for breakfast or lunch. Cherry tomatoes are a great side with it but fresh melon and other fruit would also be delicious with it.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt butter in a 10-inch, oven-proof skillet over medium heat. Add onions and cook until they start to turn translucent, about 2 minutes. Stir in potatoes and spinach, and remove from heat. Sprinkle with feta cheese."
    },
    {
      "position": 3,
      "text": "Stir beaten eggs, heavy cream, paprika, salt, and pepper together in a bowl until well blended. Pour egg mixture over the cheese and vegetables."
    },
    {
      "position": 4,
      "text": "Place skillet in the preheated oven and bake until eggs are set and the top is lightly browned, 20 to 25 minutes. Remove from the oven and allow to cool slightly. Serve warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

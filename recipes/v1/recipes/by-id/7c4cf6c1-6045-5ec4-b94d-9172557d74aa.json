  "id": "7c4cf6c1-6045-5ec4-b94d-9172557d74aa",
  "slug": "mushrooms-with-a-soy-sauce-glaze",
  "name": "Mushrooms with a Soy Sauce Glaze",
  "recipe_type": "side",
  "brief_description": "These mushrooms with soy sauce and garlic glaze are so quick and easy to make. They are simply delicious with pork chops, steak, or salmon!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a skillet over medium heat. Add mushrooms; cook and stir until mushrooms have softened and released their liquid, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir in garlic; continue to cook and stir for 1 minute. Stir in soy sauce; cook until liquid has evaporated, about 4 minutes."
    },
    {
      "position": 3,
      "text": "Season with pepper."
    },
    {
      "position": 4,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

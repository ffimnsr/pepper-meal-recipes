  "id": "c09addea-e0ce-53a6-98cc-be2b595aa3c1",
  "slug": "dark-honey-pecan-granola",
  "name": "Dark Honey Pecan Granola",
  "recipe_type": "breakfast",
  "brief_description": "Honey, pecans, flax seeds, and coconut flakes combine with rolled oats in this recipe that makes a big batch of dark, deep-flavored granola.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Line a 13x17-inch baking dish with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine oats, pecan halves, coconut flakes, and flax seeds in the prepared baking dish; mix well."
    },
    {
      "position": 3,
      "text": "Combine honey, white sugar, coconut oil, and salt in a large microwave-safe bowl. Microwave on high until mixture starts to bubble, 2 to 3 minutes. Whisk until honey and coconut oil are well-combined. Stir in vanilla extract."
    },
    {
      "position": 4,
      "text": "Pour honey mixture over oat mixture in the baking dish; stir until evenly distributed."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven, stirring every 15 minutes, until oats are a deep golden brown, about 1 hour 15 minutes. Allow to cool, about 1 hour. Break oat clusters apart before serving."
    }
  ],
  "servings": 96,
  "cooking_time_minutes": 77,
  "preparation_time_minutes": 10,

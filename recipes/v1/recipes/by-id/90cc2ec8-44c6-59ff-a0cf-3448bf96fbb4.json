  "id": "90cc2ec8-44c6-59ff-a0cf-3448bf96fbb4",
  "slug": "best-ever-classic-banana-bread",
  "name": "Best Ever Classic Banana Bread",
  "recipe_type": null,
  "brief_description": "This classic banana bread recipe is made with ripe bananas and a dairy-free spread instead of butter. The finished loaf is incredibly moist and delicious.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan with 1 teaspoon dairy-free spread."
    },
    {
      "position": 2,
      "text": "Mix mashed bananas, 1 cup dairy-free spread, brown sugar, eggs, and vanilla together in a large bowl with a wooden spoon until well combined. Stir in flour, baking soda, cinnamon, and salt until blended. Spoon into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 60 to 70 minutes. Cool in the pan for 20 minutes, then remove to a wire rack to finish cooling."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

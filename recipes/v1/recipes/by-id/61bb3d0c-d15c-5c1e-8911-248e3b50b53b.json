  "id": "61bb3d0c-d15c-5c1e-8911-248e3b50b53b",
  "slug": "local-kine-wontons",
  "name": "Local Kine Wontons",
  "recipe_type": "appetizer",
  "brief_description": "These wontons filled with cream cheese and imitation crab are a favorite recipe from Hawaii. Serve them with a variety of Asian-style sauces for dipping.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large, heavy saucepan to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix cream cheese, crabmeat, water chestnuts, green onions, and soy sauce together in a medium bowl."
    },
    {
      "position": 3,
      "text": "Place about 1 teaspoon cream cheese mixture in the center of each wonton wrapper. Fold into wrappers into triangles and seal the edges with moistened fingers."
    },
    {
      "position": 4,
      "text": "Working in small batches, fry wontons in the hot oil until golden brown, 3 to 4 minutes. Remove with a slotted spoon and drain on paper towels."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,

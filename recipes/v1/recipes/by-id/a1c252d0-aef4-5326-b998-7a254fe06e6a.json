  "id": "a1c252d0-aef4-5326-b998-7a254fe06e6a",
  "slug": "new-orleans-chocolate-bourbon-pecan-pie",
  "name": "New Orleans Chocolate Bourbon Pecan Pie",
  "recipe_type": "dessert",
  "brief_description": "This pecan pie is a decadent blend of buttery, bourbon-accented caramelized filling and crunchy pecans for a rich, New Orleans bayou country dessert.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat sugar, corn syrup, bourbon, eggs, melted butter, and salt together in a mixing bowl until smooth and creamy. Fold in pecans and chocolate chips. Pour mixture into pie crust. If desired, cover the edges of pie with aluminum foil strips to prevent excessive browning."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until the center is set, about 50 minutes. Cool before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,

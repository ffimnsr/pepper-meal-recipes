  "id": "399d312d-8767-5217-9749-0aaa0b57cfdf",
  "slug": "balsamic-grilled-zucchini",
  "name": "Perfect Grilled Zucchini",
  "recipe_type": "side",
  "brief_description": "Grilled zucchini, seasoned and brushed with olive oil and balsamic, cooks perfectly on the grill until just tender, golden, and charred for an easy summer side.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill for medium-low heat and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Brush zucchini with olive oil. Sprinkle Italian seasoning, garlic powder, and salt over zucchini."
    },
    {
      "position": 4,
      "text": "Cook on the preheated grill until charred and beginning to turn golden brown, 3 to 4 minutes per side. Brush balsamic vinegar over zucchini and continue cooking 1 minute more."
    },
    {
      "position": 5,
      "text": "Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

  "id": "1baed10e-8049-55af-8c21-b534c1e2083c",
  "slug": "air-fryer-hoisin-salmon-recipe-11834713",
  "name": "Air Fryer Hoisin Salmon",
  "recipe_type": "dessert",
  "brief_description": "This air fryer hoisin salmon delivers tender, flaky fish with a glaze of hoisin, garlic, and gingers\u2014sweet, savory, and ready in minutes. Quick to make, fancy enough to impress.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the air fryer to 390 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "In a small bowl, whisk together hoisin sauce, soy sauce, rice vinegar, sesame oil, garlic, and ginger."
    },
    {
      "position": 3,
      "text": "Pat salmon dry and season with salt and pepper. Brush the glaze over the top and sides."
    },
    {
      "position": 4,
      "text": "Spray the basket of the air fryer with cooking spray and place salmon fillets skin-side down. Cook in the preheated air fryer for 8 minutes. Remove from the air fryer and let rest for 2 minutes; garnish with green onions."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": 5,
  "difficulty": "easy",

  "id": "2c832ad9-f1ad-512a-a05c-1859633251a5",
  "slug": "raspberry-jam-without-pectin",
  "name": "Raspberry Jam without Pectin",
  "recipe_type": "breakfast",
  "brief_description": "Canning raspberry jam doesn\u2019t get easier than this beginner-friendly, 3-ingredient recipe that skips the pectin and yields a huge batch of tasty jam.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Bring raspberries to a boil in a very large pot. Cook for 4 minutes. Add sugar and lemon juice; stir well. Bring back to a boil, stirring constantly. Cook for another 4 minutes."
    },
    {
      "position": 3,
      "text": "Remove pot from heat and divide jam into sterilized jars, leaving 1/4-inch of space at the top. Wipe the rims of the jars with a moist paper towel to remove any food residue. Top with lids, and screw on rings."
    },
    {
      "position": 4,
      "text": "Place a rack in the bottom of a large stockpot and fill halfway with water. Bring to a boil, then carefully lower the jars into the pot using a holder, leaving a 2-inch space between the jars. Pour in more boiling water if necessary until the water level is at least 1 inch above the tops of the jars. Bring the water to a full boil, cover the pot, and process for 10 minutes."
    },
    {
      "position": 5,
      "text": "Remove the jars from the stockpot and let rest, several inches apart, for 8 hours. Store in a cool, dark area."
    }
  ],
  "servings": 56,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,

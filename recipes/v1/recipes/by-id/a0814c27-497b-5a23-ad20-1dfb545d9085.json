  "id": "a0814c27-497b-5a23-ad20-1dfb545d9085",
  "slug": "deep-fried-mushrooms",
  "name": "Deep-Fried Mushrooms",
  "recipe_type": "appetizer",
  "brief_description": "Try fried mushrooms the next time you need a party appetizer. A basic batter turns button mushrooms into mouthwatering morsels that everyone will love.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir flour and garlic salt together in a medium bowl. Mix in water and egg until smooth."
    },
    {
      "position": 3,
      "text": "Heat oil in a large deep skillet over medium-high heat until a drop of batter will sizzle and float to the top."
    },
    {
      "position": 4,
      "text": "Working in small batches, dip mushrooms into batter and fry in hot oil until golden brown, 3 to 5 minutes. Remove with a slotted spoon and drain on paper towels."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

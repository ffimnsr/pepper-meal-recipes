  "id": "e999bec5-37e8-5a7b-9eca-968c001c91eb",
  "slug": "dr-pepper-sheet-cake-recipe-11815332",
  "name": "Dr Pepper Sheet Cake",
  "recipe_type": "dessert",
  "brief_description": "This Dr Pepper sheet cake is a moist chocolate cake made from scratch with Dr Pepper flavors in both the base and the glaze. The perfect treat for all Dr Pepper fans!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C) and grease a 9x13-inch baking pan."
    },
    {
      "position": 2,
      "text": "For cake, stir together sugar, flour, cocoa powder, baking powder, baking soda and salt in a large bowl."
    },
    {
      "position": 3,
      "text": "Add eggs, Dr. Pepper\u00ae, milk, oil and vanilla. Beat with an electric mixer for 2 minutes on medium speed."
    },
    {
      "position": 4,
      "text": "Stir in the boiling water. The batter will be thin."
    },
    {
      "position": 5,
      "text": "Transfer batter to prepared pan. Bake until a toothpick inserted in the center comes out clean, 30 to 35 minutes."
    },
    {
      "position": 6,
      "text": "Let the cake cool in the pan on a wire rack for at least 30 minutes."
    },
    {
      "position": 7,
      "text": "For glaze, combine butter, cocoa powder and 3 tablespoons Dr. Pepper\u00ae in a medium saucepan. Cook and stir over medium high heat until mixture is boiling. Remove from heat."
    },
    {
      "position": 8,
      "text": "Whisk in powdered sugar until well blended, smooth, and creamy, about 2 minutes. Stir in the remaining 2 tablespoons Dr. Pepper to make a smooth glaze."
    },
    {
      "position": 9,
      "text": "Pour glaze over cooled cake and let set for 1 hour before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

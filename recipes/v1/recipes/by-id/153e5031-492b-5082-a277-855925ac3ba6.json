  "id": "153e5031-492b-5082-a277-855925ac3ba6",
  "slug": "slow-cooker-sausage-tortellini-soup-recipe-8762313",
  "name": "Slow Cooker Sausage Tortellini Soup",
  "recipe_type": "salad",
  "brief_description": "This slow cooker sausage tortellini soup will be a family favorite. Tasty and filling, it\u2019s hard to beat. Serve with warm, crusty bread and a green salad.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Cook sausage in a nonstick skillet over medium-high heat; stir frequently and break up meat with a spatula into lima bean-sized pieces, until browned, about 5 minutes. Use a slotted spoon to remove sausage from skillet; add to a 6-quart slow cooker."
    },
    {
      "position": 2,
      "text": "Add chopped onion and celery to the same skillet; cook and stir until vegetables begin to soften, 3 to 5 minutes. Add minced garlic and cook, stirring, about 30 seconds."
    },
    {
      "position": 3,
      "text": "Pour vegetable mixture into the slow cooker. Add tomatoes with juices; break tomatoes into bite-sized pieces. Add chicken stock or broth, stir to distribute evenly, cover, and cook on Low 7 or 8 hours, or on High 3 to 4 hours."
    },
    {
      "position": 4,
      "text": "About halfway through the cooking process, season with salt and pepper, and add Italian herb seasoning blend."
    },
    {
      "position": 5,
      "text": "About 30 minutes before serving, turn slow cooker to High, add tortellini and kale, and adjust seasoning. Cover and cook until tortellini is tender, about 30 minutes."
    },
    {
      "position": 6,
      "text": "Serve warm, and garnish with grated Parmesan cheese."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 480,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

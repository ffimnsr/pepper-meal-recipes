  "id": "b7dcae92-af4b-54ac-bf76-bba00e1e6c31",
  "slug": "seafood-gumbo-stock",
  "name": "Seafood Gumbo Stock",
  "recipe_type": "soup",
  "brief_description": "Roasted shrimp shells are simmered all day in water seasoned with whole cloves, bay leaf, garlic, and vegetables in this seafood stock recipe to use as a base for gumbos.",
  "cuisine": "Creole",
  "instructions": [
    {
      "position": 1,
      "text": "Bake shrimp shells at 375 degrees F (190 degrees C) until dried and starting to brown on edges."
    },
    {
      "position": 2,
      "text": "In an 8-quart pot, combine water, carrots, onions, celery, bay leaves, garlic, parsley, cloves, pepper, basil, thyme, and shrimp shells. Bring slowly to a boil."
    },
    {
      "position": 3,
      "text": "Reduce heat, and cook 5 to 7 hours. Replace water as needed, 2 or 3 times, by pouring more water down the inside of the pot."
    },
    {
      "position": 4,
      "text": "Remove stock from heat and strain. Press all liquid from shells and vegetables, then discard them."
    },
    {
      "position": 5,
      "text": "Return liquid to heat, and reduce to 2 to 3 quarts, or to taste."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 455,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

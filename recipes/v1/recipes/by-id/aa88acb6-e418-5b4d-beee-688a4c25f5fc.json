  "id": "aa88acb6-e418-5b4d-beee-688a4c25f5fc",
  "slug": "air-fryer-shrimp-fried-rice-recipe-7555952",
  "name": "Air Fryer Shrimp Fried Rice",
  "recipe_type": "side",
  "brief_description": "This shrimp fried rice is so deliciously savory, nobody will believe you made it with an air fryer",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Remove the basket insert from air fryer. Preheat the air fryer to 400 degrees F (200 degrees C) for 5 minutes."
    },
    {
      "position": 2,
      "text": "Add oil to the basket holder to coat; add onion, carrot, and 1/2 teaspoon of the salt, and stir to combine. Cook for 5 minutes. Add eggs; cook until partially set, about 3 minutes."
    },
    {
      "position": 3,
      "text": "Add shrimp, rice, peas, soy sauce, vinegar, pepper, and remaining salt to egg mixture; stir to combine. Cook for 10 minutes. Stir mixture, sprinkle with sesame seeds, if desired, and cook until heated throughout and crisp, 10 to 15 minutes more. Drizzle with Sriracha mayonnaise, and sprinkle with scallions."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

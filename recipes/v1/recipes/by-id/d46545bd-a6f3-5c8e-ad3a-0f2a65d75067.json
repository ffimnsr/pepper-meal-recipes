  "slug": "chicken-zoodle-soup-in-a-jar-recipe-8364198",
  "name": "Chicken Zoodle Soup in a Jar",
  "recipe_type": "soup",
  "brief_description": "We developed this chicken zoodle soup in a jar, inspired by recipes on TikTok for soup in a jar. It's a great make-ahead meal that you can make year round.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together chicken stock base, garlic, dried rosemary, ground sage, and black pepper in a small bowl. Divide mixture evenly among 3 microwave-safe pint-size canning jars with lids."
    },
    {
      "position": 2,
      "text": "Layer evenly with chicken, spiralized zucchini, carrot, celery, and sweet onion. Chill, covered, up to 5 days. To serve, see \u201cHeat and Eat\u201d, below. Season with pepper."
    }
  ],
  "servings": 3,

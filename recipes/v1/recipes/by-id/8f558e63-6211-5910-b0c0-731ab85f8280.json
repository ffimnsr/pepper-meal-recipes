  "id": "8f558e63-6211-5910-b0c0-731ab85f8280",
  "slug": "holiday-turkey-brine",
  "name": "Holiday Turkey Brine",
  "recipe_type": "soup",
  "brief_description": "Vegetable broth, Worcestershire sauce, apples, and onions combine in this trouble-free brine that is bound to liven up any holiday turkey.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Combine vegetable broth, sea salt, brown sugar, peppercorns, rosemary, sage, and thyme in a large stockpot. Bring to a boil, stirring frequently until salt and sugar dissolve. Remove from heat and let cool to room temperature."
    },
    {
      "position": 2,
      "text": "Pour the water, broth mixture, and apple cider vinegar into a 5-gallon bucket; stir until brine is combined. Add the apples, onion, Worcestershire sauce, and garlic to the brine mixture."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

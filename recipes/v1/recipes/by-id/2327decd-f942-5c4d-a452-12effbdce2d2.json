  "id": "2327decd-f942-5c4d-a452-12effbdce2d2",
  "slug": "butternut-soup",
  "name": "Butternut Soup",
  "recipe_type": "soup",
  "brief_description": "This butternut squash soup is made in the microwave and seasoned with nutmeg, cloves, and cinnamon for a super easy satisfying winter soup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine squash, onions, and butter in a large microwave-safe bowl. Cover and microwave on high for 4 minutes; peel squash."
    },
    {
      "position": 2,
      "text": "Stir in broth and cook on high until squash is tender, about 20 to 25 minutes."
    },
    {
      "position": 3,
      "text": "Transfer squash mixture into a blender; cover and hold the lid down with a potholder and pulse a few times before leaving on to blend. Transfer pureed mixture back into the microwave-safe bowl."
    },
    {
      "position": 4,
      "text": "Add cream, salt, and pepper; microwave on high until heated through, about 3 to 4 minutes. Season with nutmeg, cloves and cinnamon to taste."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

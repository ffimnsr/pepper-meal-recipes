  "id": "38b9623a-9dc7-5cc8-b9c6-b8658625f01f",
  "slug": "black-magic-cake",
  "name": "Black Magic Cake",
  "recipe_type": "dessert",
  "brief_description": "This chocolate cake recipe with dark roast coffee, buttermilk, and cocoa bakes up spongy and moist for a delicious and decadent black magic dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Grease and flour two 9-inch round cake pans or one 9x13-inch dish."
    },
    {
      "position": 3,
      "text": "Combine sugar, flour, cocoa, baking soda, baking powder, and salt in a large bowl. Make a well in the center. Pour coffee, buttermilk, oil, eggs, and vanilla into the well. Beat for 2 minutes on medium speed. Batter will be thin."
    },
    {
      "position": 4,
      "text": "Pour into the prepared pans."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, 30 to 40 minutes."
    },
    {
      "position": 6,
      "text": "Cool for 10 minutes, then remove from the pans and finish cooling on a wire rack."
    },
    {
      "position": 7,
      "text": "Fill and frost as desired."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "creamy-orange-fudge",
  "name": "Creamy Orange Fudge",
  "recipe_type": "dessert",
  "brief_description": "White chocolate, cream cheese, confectioners' sugar and orange extract are the only ingredients in this easy, no-cook orange-flavored fudge.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Beat cream cheese into melted chocolate until well blended. Beat in confectioner's sugar until mixture is smooth. Stir in orange extract. Spread in an 8x8 inch dish and let set before cutting into squares. Store in refrigerator."
    }
  ],
  "servings": 12,

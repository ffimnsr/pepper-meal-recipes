  "id": "13565ab5-c659-51dd-9245-0c29e05b24fa",
  "slug": "sausage-potato-and-kale-soup",
  "name": "Sausage, Potato and Kale Soup",
  "recipe_type": "soup",
  "brief_description": "This sausage and kale soup combines pork sausage, nutritious kale, and potatoes to give a hearty, rich, bold flavor to a creamy Italian-inspired soup.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat a large soup pot over medium-high heat. Crumble sausage into the pot; cook and stir until browned, about 10 minutes. Drain and discard grease."
    },
    {
      "position": 3,
      "text": "Stir half-and-half, potatoes, chicken broth, milk, onion, oregano, and pepper flakes into sausage, and bring to a boil. Reduce heat to low and simmer until potatoes are tender, about 30 minutes."
    },
    {
      "position": 4,
      "text": "Season with black pepper. Stir in kale; simmer until kale is tender, 10 to 15 more minutes."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,

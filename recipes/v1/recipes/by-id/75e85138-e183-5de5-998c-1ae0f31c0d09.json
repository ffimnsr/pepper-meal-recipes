  "schema_version": 1,
  "id": "75e85138-e183-5de5-998c-1ae0f31c0d09",
  "slug": "basic-babka",
  "name": "Babka",
  "recipe_type": "dessert",
  "brief_description": "Babka is a Jewish braided bread made with a sweet and enriched yeast dough. This recipe uses a cinnamon-walnut filling for a delicious addition to brunch.",
  "cuisine": "Polish",
  "instructions": [
    {
      "position": 1,
      "text": "Stir white sugar, 1/4 cup butter, and salt into hot milk in a small bowl until butter is melted and mixture is lukewarm. In the work bowl of a stand mixer fitted with a paddle, sprinkle yeast over warm water; stir to dissolve."
    },
    {
      "position": 2,
      "text": "Stir milk mixture into yeast mixture. Add 2 eggs and 2 \u00bd cups of the flour; beat on high until combined. With mixer on low, add remaining 2 cups flour, 1/2 cup at a time."
    },
    {
      "position": 3,
      "text": "Switch to the dough hook; mix until dough leaves sides of bowl, about 5 minutes. Set dough in a large, lightly greased bowl, turning dough to coat top. Cover with a towel and let rise in a warm spot until doubled, about 1 hour."
    },
    {
      "position": 4,
      "text": "Prepare walnut filling while dough rises. Lightly beat 3 eggs in a large bowl. Stir in brown sugar, 1/3 cup melted butter, cinnamon, and vanilla extract. Fold in walnuts."
    },
    {
      "position": 5,
      "text": "Punch dough down. Turn dough out onto a large, lightly floured surface, cover with the bowl, and let rest 10 minutes. Line three 9x5-inch loaf pans with parchment paper, leaving a 2-inch overhang on long sides."
    },
    {
      "position": 6,
      "text": "Divide dough into thirds; roll each third out to a 12-inch square on a lightly floured surface. Spoon 1/3 of the walnut filling onto each dough square and spread to within 1/2 inch of the edges. Roll up each square tightly as for a jelly roll. Pinch ends and seams closed to seal. With your palms, roll logs back and forth until uniformly round."
    },
    {
      "position": 7,
      "text": "With a sharp knife or dough scraper, cut 1 log in half lengthwise to form 2 striped strands. Working quickly, twist strands loosely together with cut sides facing out, making 2 or 3 wide, horizontal twists. Fit into one of the prepared pans, patting back any loose filling and tucking ends under, if needed. It might look like a mess now, but it comes out beautifully!"
    },
    {
      "position": 8,
      "text": "Repeat with remaining logs and pans. Cover pans with a towel and let rise in a warm spot until doubled in size, about 1 hour. Loaves should not rise above top edges of pans."
    },
    {
      "position": 9,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Brush loaf tops with remaining 2 tablespoons melted butter."
    },
    {
      "position": 10,
      "text": "Bake loaves until puffed, well browned, and a thermometer inserted in centers registers 200 degrees F (93 degrees C), 35 to 45 minutes. Tent with foil if tops brown before loaves are done. Cool in pans for 10 minutes, then use parchment to lift from pans and transfer to a wire rack."
    },
    {
      "position": 11,
      "text": "Cool completely, about 1 hour. Glaze if desired, then slice crosswise to serve."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 30,

  "id": "d9ff29fe-9432-57b0-b9e4-6b9176027c99",
  "slug": "chef-johns-lemon-bars",
  "name": "Chef John's Lemon Bars",
  "recipe_type": "dessert",
  "brief_description": "These shortbread crust lemon bars are Chef John's recipe for intensely flavored custard atop a crisp, sweet, buttery cookie layer reminiscent of pie.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Set an oven rack to the middle position and preheat the oven to 350 degrees F (175 degrees C). Lightly grease an 8x8-inch baking dish."
    },
    {
      "position": 2,
      "text": "Make crust: Use the back of a spatula or wooden spoon to mash flour and butter in a large bowl until thoroughly combined. Mix in confectioners' sugar, vanilla, and salt until mixture resembles slightly crumbly cookie dough. Moisten your fingers with a little water and press dough into the bottom of the prepared baking dish. Use a fork to prick holes all over crust."
    },
    {
      "position": 3,
      "text": "Bake on the middle rack in the preheated oven until edges are barely golden brown, about 22 minutes. Set aside."
    },
    {
      "position": 4,
      "text": "Make custard: Beat together eggs and egg yolks in a medium bowl until combined. Whisk in white sugar and flour until smooth. Add lemon juice and zest; whisk for 2 minutes. Pour over warm crust."
    },
    {
      "position": 5,
      "text": "Bake on the center rack until custard is set and the top has a thin white sugary crust, about 25 minutes. Let cool completely before cutting into bars."
    },
    {
      "position": 6,
      "text": "Dip a knife into very hot water, then run the blade around the edges and cut into 16 squares. Dust bars with confectioners' sugar."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

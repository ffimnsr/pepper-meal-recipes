  "id": "f01b81c1-07ea-573a-a394-c8d4fc33ff56",
  "slug": "pasta-with-spinach-and-chickpeas",
  "name": "Chickpea Pasta with Spinach",
  "recipe_type": "main",
  "brief_description": "This quick chickpea pasta dish with spinach, tomatoes, and garlic is flavored with fresh herbs and topped with cheese for a delicious vegetarian meal.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of water with 2 teaspoons salt to a boil. Cook pasta at a boil until tender yet firm to the bite, about 10 to 11 minutes. Drain, reserving 1/2 cup of the cooking water."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat olive oil in a large skillet over medium heat. Cook and stir garlic in hot oil until fragrant, about 1 minute. Increase heat to medium-high and add spinach, tomatoes, and chickpeas; cook and stir until spinach begins to wilt, 1 to 2 minutes more."
    },
    {
      "position": 4,
      "text": "Season spinach mixture with remaining teaspoon sea salt, marjoram, black pepper, and red pepper flakes. Reduce heat to low. Stir drained pasta with spinach mixture to evenly coat."
    },
    {
      "position": 5,
      "text": "Add extra olive oil or reserved pasta water to achieve preferred level of moisture in the dish. Top with grated Pecorino Romano cheese."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

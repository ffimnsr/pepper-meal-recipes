  "id": "e887bb37-cf75-5dd4-a33f-2b7044c8f705",
  "slug": "barley-shrimp-and-corn-salad",
  "name": "Barley, Shrimp, and Corn Salad",
  "recipe_type": "salad",
  "brief_description": "A lightly seasoned oil and lemon juice dressing perfectly accents the flavors of this salad made with barley, shrimp, and red and green bell peppers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine barley and water in a saucepan. Bring to a boil. Cover, reduce heat, and simmer for approximately 35 minutes."
    },
    {
      "position": 2,
      "text": "Transfer barley to a large bowl, and toss with shrimp, corn, bell peppers, green onions, thyme, and lemon zest."
    },
    {
      "position": 3,
      "text": "In a small bowl, whisk together lemon juice and oil. Season with salt and pepper. Pour dressing over barley salad, and toss to combine."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 30,

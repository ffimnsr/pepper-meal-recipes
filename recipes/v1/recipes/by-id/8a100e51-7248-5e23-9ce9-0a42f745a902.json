  "id": "8a100e51-7248-5e23-9ce9-0a42f745a902",
  "slug": "turmeric-golden-milk-with-turmeric-paste",
  "name": "Turmeric Golden Milk with Turmeric Paste",
  "recipe_type": "drink",
  "brief_description": "A homemade golden turmeric paste is heated with almond milk, spices, and coconut oil to make this soothing drink you can sip before bedtime.",
  "cuisine": "Indian Inspired Asian",
  "instructions": [
    {
      "position": 1,
      "text": "To make the turmeric paste: Combine 1/2 cup water, turmeric, and pepper in a small saucepan over low heat. Cook, stirring constantly, until thickened, 7 to 9 minutes. Stir in 1 teaspoon water and continue cooking until thickened into a paste, 7 to 9 minutes. Allow to cool completely, 15 to 20 minutes. Store turmeric paste in an airtight glass jar in the refrigerator."
    },
    {
      "position": 2,
      "text": "To make turmeric milk: Whisk almond milk, 1 teaspoon of the homemade turmeric paste, coconut oil, ginger, and cinnamon in a saucepan. Place over low heat until hot, about 5 minutes. Remove from heat; stir in honey. Strain milk mixture into 2 mugs."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

  "id": "7c3b7cfa-cc67-517b-aacf-b75975d5e699",
  "slug": "boudreauxs-zydeco-stomp-gumbo",
  "name": "Boudreaux's Zydeco Stomp Gumbo",
  "recipe_type": "soup",
  "brief_description": "Tantalize your taste buds with a bowl of this tasty gumbo filled with chicken, pork, shrimp and spicy Cajun flavor!",
  "cuisine": "Southwestern",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a medium skillet over medium high heat, and cook chicken until no longer pink and juices run clear. Stir in sausage, and cook until evenly browned. Drain chicken and sausage, and set aside."
    },
    {
      "position": 2,
      "text": "In a large, heavy saucepan over medium heat, blend olive oil and flour to create a roux. Stir constantly until browned and bubbly. Mix in garlic, and cook about 1 minute."
    },
    {
      "position": 3,
      "text": "Gradually stir chicken broth and beer into the roux mixture. Bring to a boil, and mix in celery, tomatoes, sweet onion, diced tomatoes with green chile peppers, red chile peppers, parsley, and Cajun seasoning. Reduce heat, cover, and simmer about 40 minutes, stirring often."
    },
    {
      "position": 4,
      "text": "Mix chicken, sausage, and shrimp into the broth mixture. Cook, stirring frequently, about 20 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 60,
  "rest_time_minutes": null,

  "id": "9d3333ec-4316-5f7c-9092-639a99c364ba",
  "slug": "clamato-shrimp-ceviche-style",
  "name": "Clamato Shrimp \"Ceviche\" Style",
  "recipe_type": "appetizer",
  "brief_description": "This cool and delicious shrimp ceviche with Clamato recipe is perfect for warm summer days and is sure to be a hit at your next outdoor gathering.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "In a bowl, combine shrimp, onion, jalape\u00f1o, cucumber, and cilantro."
    },
    {
      "position": 2,
      "text": "Add lime juice and Clamato; toss to mix well."
    },
    {
      "position": 3,
      "text": "Chill in the refrigerator for 30 minutes."
    },
    {
      "position": 4,
      "text": "Serve cold with tostadas (hard tortillas) or soda crackers."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

  "id": "279b8883-9bb0-5253-9d1a-f14ddfef5198",
  "slug": "quick-and-easy-pineapple-fried-rice",
  "name": "Easy Pineapple Fried Rice",
  "recipe_type": "side",
  "brief_description": "This pineapple fried rice recipe stir-fries ginger, garlic, and fresh pineapple with sesame oil, soy sauce, and white rice for a light and tasty side dish.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a wok or large skillet over medium heat. Cook and stir onion in hot oil for about 1 minute. Add ginger and garlic; cook, stirring constantly, for 1 minute."
    },
    {
      "position": 2,
      "text": "Increase heat to medium-high; add pineapple, red bell pepper, and peas. Cook, stirring constantly, for 3 to 4 minutes. Stir in rice and soy sauce; cook until sauce is well incorporated, 1 to 2 minutes. Stir in sesame oil and remove from heat."
    },
    {
      "position": 3,
      "text": "Garnish with green onion and sesame seeds before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

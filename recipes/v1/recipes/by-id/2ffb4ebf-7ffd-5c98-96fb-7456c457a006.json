  "id": "2ffb4ebf-7ffd-5c98-96fb-7456c457a006",
  "slug": "air-fryer-oven-taco-shells",
  "name": "Air Fryer Oven Taco Shells",
  "recipe_type": "main",
  "brief_description": "Crisp up corn tortillas in your air fryer in just a few minutes the next time you forget to buy hard taco shells. The best part is there's no oil needed.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place an upside-down mini muffin pan into the air fryer basket. Bend tortillas like taco shells and position them in the indents of the muffin pan to hold the shape."
    },
    {
      "position": 3,
      "text": "Air fry on the lowest rack of the preheated air fryer until golden brown and crispy, about 3 minutes. Remove the muffin pan from the air fryer basket. Flip tortillas and place directly into the basket; air fry until the bottom sides are crispy and golden brown, about 1 minute."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

  "id": "6ddb3138-e81a-5afc-baf2-6cc1bfb0120b",
  "slug": "peanut-butter-potato-candy",
  "name": "Peanut Butter Potato Candy",
  "recipe_type": "dessert",
  "brief_description": "Classic potato candy made from mashed potatoes and confectioners' sugar with a layer of peanut butter rolled into the middle for a sweet fudgy treat!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine mashed potatoes, milk, vanilla extract, and salt in a bowl."
    },
    {
      "position": 2,
      "text": "Stir confectioners' sugar into potato mixture until a dough consistency is reached. Refrigerate dough until chilled, about 1 hour."
    },
    {
      "position": 3,
      "text": "Sprinkle some confectioners' sugar on a cutting board or waxed paper."
    },
    {
      "position": 4,
      "text": "Roll dough into a large rectangular shape on prepared surface."
    },
    {
      "position": 5,
      "text": "Spread enough peanut butter on top layer of dough to cover."
    },
    {
      "position": 6,
      "text": "Roll dough into a jelly roll shape; refrigerate roll for 1 hour. Slice dough into pinwheels."
    },
    {
      "position": 7,
      "text": "Serve and enjoy."
    }
  ],
  "servings": 20,

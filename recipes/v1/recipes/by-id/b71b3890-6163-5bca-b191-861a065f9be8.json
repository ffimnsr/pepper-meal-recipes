  "id": "b71b3890-6163-5bca-b191-861a065f9be8",
  "slug": "holiday-only-mashed-potatoes",
  "name": "Holiday-Only Mashed Potatoes",
  "recipe_type": "side",
  "brief_description": "These simple mashed potatoes with heavy cream are rich with butter and cream for the perfect side dish during the holidays or any special celebration.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place potatoes into a large pot with enough water to cover; bring to a boil. Cook until fork tender, about 20 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Add butter to potatoes in the pot. Mash using a potato masher, ricer, or mixer until smooth. Gradually beat in heavy cream until well combined. Season with salt and pepper. Serve hot."
    }
  ],

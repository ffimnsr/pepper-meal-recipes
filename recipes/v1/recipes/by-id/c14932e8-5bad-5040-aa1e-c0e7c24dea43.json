  "id": "c14932e8-5bad-5040-aa1e-c0e7c24dea43",
  "slug": "moms-cajun-hush-puppies",
  "name": "Mom's Cajun Hush Puppies",
  "recipe_type": "appetizer",
  "brief_description": "With their crispy golden crusts and tender, fluffy interiors, Mom's recipe for Cajun hush puppies are tasty little delights. Serve with tartar sauce.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk flour, cornmeal, sugar, Parmesan cheese, baking powder, salt, and black pepper together in a large bowl; stir in onions, bell peppers, cream-style corn, whole kernel corn, eggs, and pimentos until combined."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat oil in a deep fryer or large saucepan to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Carefully drop tablespoon-sized balls of batter into the hot oil in batches of 6 to 8. Fry until hush puppies are golden brown, about 5 minutes. Transfer hush puppies to a paper towel-lined plate with a slotted spoon to drain. Repeat with remaining batter."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 20,

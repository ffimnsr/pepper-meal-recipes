  "id": "1533889a-2432-5ccc-a6fc-63f41938ead1",
  "slug": "sweet-curry-pumpkin-seeds",
  "name": "Sweet Curry Pumpkin Seeds",
  "recipe_type": "appetizer",
  "brief_description": "In this quick and easy recipe, pumpkin seeds are coated with curry powder and cinnamon sugar for a sweet and spicy snack with a crunch.",
  "cuisine": "Indian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine pumpkin seeds, brown sugar, cinnamon, and curry powder in a bowl. Add vegetable oil gradually, until lightly coated. Spread seeds evenly on a baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 10 minutes. Remove the sheet from the oven and flip the seeds. Continue baking, flipping seeds every 10 minutes, until crunchy and golden brown, 20 to 30 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

  "id": "b3b54d24-a411-5a82-80ac-d8cf5192e165",
  "slug": "addictive-sweet-potato-burritos",
  "name": "Sweet Potato Burritos",
  "recipe_type": "dessert",
  "brief_description": "This sweet potato burrito recipe is made with kidney beans and Cheddar cheese and flavored with tantalizing spices for a hearty vegetarian breakfast.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat oil in a medium skillet. Cook and stir onion and garlic in hot oil until onion is soft. Mash beans into onion mixture. Gradually stir in water; heat until warm, 2 to 3 minutes. Remove from heat and stir in soy sauce, chili powder, mustard, cumin, and cayenne pepper."
    },
    {
      "position": 3,
      "text": "Divide bean mixture and mashed sweet potatoes evenly between warm tortillas; top with cheese. Fold tortillas, burrito-style, around fillings and place on a baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until warmed through, about 12 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

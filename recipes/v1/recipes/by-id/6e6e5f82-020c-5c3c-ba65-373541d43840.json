  "slug": "crunchy-chocolate-chip-peanut-butter-snack-bites",
  "name": "Crunchy Chocolate Chip Peanut Butter Snack Bites",
  "recipe_type": "appetizer",
  "brief_description": "These peanut and chocolate chip snack bites are simple and easy to make. They're loaded with flavor and crunch, and they look just like cookie dough!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together oats, peanut butter, honey, peanuts, and chocolate chips in a medium bowl until blended. Refrigerate for 20 to 30 minutes."
    },
    {
      "position": 2,
      "text": "Roll into twenty 1-inch balls, using about 2 tablespoons for each one."
    }
  ],

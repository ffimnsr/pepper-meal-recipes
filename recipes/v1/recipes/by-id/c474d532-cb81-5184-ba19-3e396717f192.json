  "id": "c474d532-cb81-5184-ba19-3e396717f192",
  "slug": "buffalo-chicken-dip",
  "name": "Buffalo Chicken Dip",
  "recipe_type": "appetizer",
  "brief_description": "Buffalo chicken dip made with 5 simple ingredients in your slow cooker. This creamy, cheesy, zesty hot dip tastes just like Buffalo chicken wings!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat chicken and hot pepper sauce in a skillet over medium heat until heated through, 3 to 5 minutes. Stir in cream cheese and ranch dressing. Cook and stir until well blended and warm, 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Mix in 1/2 of the Cheddar cheese, and transfer the mixture to a slow cooker. Sprinkle the remaining cheese over top."
    },
    {
      "position": 4,
      "text": "Cover and cook on Low until dip is hot and bubbly, about 35 minutes."
    },
    {
      "position": 5,
      "text": "Serve warm with celery sticks and crackers for dipping."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

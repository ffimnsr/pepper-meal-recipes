  "id": "94dd3ec8-3bb4-5497-b75c-2d1acd7817b0",
  "slug": "parmesan-crusted-chicken",
  "name": "Parmesan Crusted Chicken",
  "recipe_type": "main",
  "brief_description": "This Parmesan-crusted chicken with mayo is the simplest and most savory way to dress up chicken breasts for a tasty supper that's ready in 30 minutes!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix mayonnaise and Parmesan cheese together in a medium bowl until well combined."
    },
    {
      "position": 3,
      "text": "Arrange chicken breasts on a baking sheet. Evenly top with mayonnaise mixture, then sprinkle with bread crumbs to coat."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden on top and chicken is cooked through, about 20 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,

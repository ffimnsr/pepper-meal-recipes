  "id": "6170e5ca-532a-524a-b236-14bea18232e8",
  "slug": "rosemary-infused-watermelon-lemonade",
  "name": "Rosemary-Infused Watermelon Lemonade",
  "recipe_type": "drink",
  "brief_description": "This rosemary-infused watermelon lemonade recipe makes a cool lemonade. It also makes a great martini served in a sugar-rimmed glass with a lemon garnish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water and sugar to a boil in a small saucepan over high heat. Stir in rosemary; steep for 1 hour. Pour syrup through a mesh strainer into a blender; discard rosemary."
    },
    {
      "position": 2,
      "text": "Add 6 cups watermelon and 1 cup lemon juice to the blender; blend until smooth. Transfer to a large pitcher."
    },
    {
      "position": 3,
      "text": "Place remaining 6 cups watermelon and remaining 1 cup lemon juice in the blender; blend until smooth. Stir into the pitcher. Serve over ice."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

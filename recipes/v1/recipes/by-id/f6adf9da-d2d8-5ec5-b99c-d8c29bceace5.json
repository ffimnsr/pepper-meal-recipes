  "id": "f6adf9da-d2d8-5ec5-b99c-d8c29bceace5",
  "slug": "fried-pickle-chicken-casserole-recipe-11922279",
  "name": "Fried Pickle Chicken Casserole",
  "recipe_type": "main",
  "brief_description": "This fried pickle chicken casserole is as satisfying as fried pickles and fried chicken but it is much easier to make. Puckery pickles and shredded chicken breast bake in a creamy sauce under a crisp, buttery panko coating.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Mix together panko breadcrumbs, butter and 1 tablespoon ranch seasoning mix from the packet in a bowl. Set aside."
    },
    {
      "position": 2,
      "text": "In a second large bowl combine chicken, cream of chicken soup, sour cream, remaining ranch seasoning packet, pickles, and pickle juice."
    },
    {
      "position": 3,
      "text": "Spread chicken mixture evenly into a greased 9x9-inch baking dish. Sprinkle cheese over chicken mixture and top with panko mixture."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bubbly and breadcrumbs are golden brown, 20 to 25 minutes."
    },
    {
      "position": 5,
      "text": "Allow the dish to cool for 10 minutes before topping with fresh dill. Serve over rice or mashed potatoes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

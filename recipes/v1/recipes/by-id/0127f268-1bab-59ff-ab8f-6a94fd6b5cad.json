  "id": "0127f268-1bab-59ff-ab8f-6a94fd6b5cad",
  "slug": "indian-shrimp-curry",
  "name": "Indian Shrimp Curry",
  "recipe_type": "main",
  "brief_description": "This shrimp curry features tender prawns in a richly flavored coconut-tomato sauce that's delicious served over hot cooked rice for an easy dinner.",
  "cuisine": "Indian Inspired Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat peanut oil in a large skillet over medium heat; cook and stir onion in hot oil until translucent, about 5 minutes. Remove the skillet from heat and allow to cool slightly, about 2 minutes."
    },
    {
      "position": 3,
      "text": "Add garlic, turmeric, ginger, cumin, paprika, and chile powder to onion in the skillet; stir over low heat to bloom spices, about 30 seconds. Stir in tomatoes, coconut milk, and salt. Bring to a boil for 1 minute, then reduce heat and simmer, stirring occasionally, for 10 minutes."
    },
    {
      "position": 4,
      "text": "Stir in shrimp and cilantro; simmer until shrimp is warmed through, about 1 minute."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

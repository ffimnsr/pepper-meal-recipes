  "id": "4fb2b7b6-ea32-5af2-9961-f867e9d248cd",
  "slug": "salt-and-pepper-skillet-fries",
  "name": "Salt and Pepper Skillet Fries",
  "recipe_type": "appetizer",
  "brief_description": "Pan fry potatoes in a skillet with hot olive oil and butter to make simple and delicious fries seasoned with sea salt and coarse black pepper.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil and butter in a skillet over medium heat."
    },
    {
      "position": 2,
      "text": "Cook and stir potato strips in hot oil mixture until browned on all sides, 20 to 25 minutes."
    },
    {
      "position": 3,
      "text": "Transfer fries to a paper towel-lined plate; season with sea salt and cracked black pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,

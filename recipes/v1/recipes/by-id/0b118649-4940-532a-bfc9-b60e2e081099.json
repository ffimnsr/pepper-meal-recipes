{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "0b118649-4940-532a-bfc9-b60e2e081099",
  "slug": "tuscan-flank-steak",
  "name": "Tuscan Flank Steak",
  "recipe_type": "main",
  "brief_description": "Flavorful flank steak is marinated for several hours in a marinade of lemon zest, olive oil, rosemary, and garlic, then grilled to perfection.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Combine 1/2 cup chopped fresh rosemary, garlic, 1/3 cup olive oil, 1/4 cup lemon juice, black pepper, 1/2 teaspoon red pepper flakes, and 1/2 teaspoon salt in a blender or food processor. Blend until smooth and set marinade aside."
    },
    {
      "position": 2,
      "text": "Pierce the steak with a fork 20 to 30 times. Place in a shallow baking dish. Pour marinade over steak and flip to coat both sides. Cover and refrigerate for 4 to 8 hours."
    },
    {
      "position": 3,
      "text": "Combine 1/3 cup olive oil, 3 tablespoons lemon juice, lemon zest, 1 teaspoon minced rosemary, 1/8 teaspoon red pepper flakes, and a pinch of salt in a jar. Cover and shake the dressing to combine. Shake again before using."
    },
    {
      "position": 4,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate."
    },
    {
      "position": 5,
      "text": "Remove steak from marinade; scrape off any chunks of marinade. Discard used marinade. Season steak with salt and black pepper."
    },
    {
      "position": 6,
      "text": "Place steak on the preheated grill and cook until browned on the outside and red on the inside, about 6 to 8 minutes per side. Place 2 tablespoons of the olive oil-lemon juice dressing in a small bowl. Use rosemary sprig to baste the steak while it cooks. An instant-read thermometer inserted into the center of a steak should read 125 degrees F (52 degrees C) for rare."
    },
    {
      "position": 7,
      "text": "Remove steak to a platter and allow to rest about 6 minutes before slicing. Cut in half lengthwise, then into 1/4-inch-thick slices at an angle against the grain. Drizzle with additional dressing."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 14,
  "preparation_time_minutes": 20,

  "slug": "mandarin-orange-gelatin-salad",
  "name": "Mandarin Orange Gelatin Salad",
  "recipe_type": "salad",
  "brief_description": "A friend taught me to make this years ago - without a recipe. It is very quick and easy. The sweet, creamy salad is great as a cool, refreshing side dish or dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix thawed frozen whipped topping, mandarin oranges, cottage cheese, and orange-flavored gelatin mix in a large bowl. Chill for 2 to 3 hours before serving."
    }
  ],

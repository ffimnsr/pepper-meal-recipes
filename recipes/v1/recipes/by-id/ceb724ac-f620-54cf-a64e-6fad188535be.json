  "id": "ceb724ac-f620-54cf-a64e-6fad188535be",
  "slug": "almost-white-castle-hamburgers",
  "name": "Almost White Castle Hamburgers",
  "recipe_type": "main",
  "brief_description": "A copycat White Castle sliders recipe. These little hamburger sliders are easy to make using 7 simple ingredients and are perfect for a large crowd.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine ground chuck, bread crumbs, egg, onion soup mix, water, and black pepper in a bowl; press into a 10x15-inch jelly roll pan. Prick holes through the chuck mixture for ventilation while cooking."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until browned and cooked through, about 10 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C). Drain excess grease."
    },
    {
      "position": 4,
      "text": "Cut chuck mixture into squares the size of the rolls. Place 1 chuck patty in each roll."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

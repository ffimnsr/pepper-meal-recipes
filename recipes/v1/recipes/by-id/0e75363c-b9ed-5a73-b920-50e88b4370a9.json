  "id": "0e75363c-b9ed-5a73-b920-50e88b4370a9",
  "slug": "gingerbread-cookies-without-molasses",
  "name": "Gingerbread Cookies without Molasses",
  "recipe_type": "dessert",
  "brief_description": "This recipe for gingerbread cookies uses no molasses but still produces a beautifully crisp, gingerbread cookie that's perfect decorating or eating as is.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine butter and sugar in a large bowl; beat with an electric mixer until smooth and creamy. Add egg and beat until light and fluffy. Mix in corn syrup and orange peel until well combined."
    },
    {
      "position": 3,
      "text": "Sift together flour, cinnamon, ginger, cloves, and salt in a separate bowl; stir into creamed butter mixture until blended. Shape dough into several balls, wrap in plastic wrap, and place in the refrigerator until thoroughly chilled, at least 1 hour."
    },
    {
      "position": 4,
      "text": "Working in batches, place one ball of chilled dough on a floured surface and roll to 1/4-inch thickness. Cut out cookies with desired cookie cutters and place on ungreased cookie sheets. Repeat with remaining dough."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until edges are firm, 8 to 10 minutes. Cool on the baking sheet for 1 minute before removing to a wire rack to cool completely."
    }
  ],
  "servings": 60,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

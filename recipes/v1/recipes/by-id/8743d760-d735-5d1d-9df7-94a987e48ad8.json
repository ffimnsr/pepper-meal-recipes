  "id": "8743d760-d735-5d1d-9df7-94a987e48ad8",
  "slug": "rotisserie-chicken-enchiladas-recipe-11714107",
  "name": "Rotisserie Chicken Enchiladas",
  "recipe_type": "main",
  "brief_description": "These easy rotisserie chicken enchiladas come together quickly with purchased salsa verde, cheese, corn tortillas, and flavorful shredded chicken.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Set a strainer over a bowl and pour salsa into strainer. Strain out excess liquid until 1 1/2 cups salsa remains. Discard liquid."
    },
    {
      "position": 2,
      "text": "Heat oil over medium-low heat in a large nonstick skillet. Place 2 tortillas in the warm oil, heat for about 1 minute, then turn and repeat on the other side. Place warmed tortillas in a single layer on a work surface, and repeat with remaining tortillas. Wipe out the skillet with clean paper towels, and place skillet over low heat."
    },
    {
      "position": 3,
      "text": "Place about 2 tablespoons shredded chicken across the center of each tortilla. Add about 1 tablespoon chopped onion, and 1 tablespoon cheese on top of chicken. Reserve extra cheese for later use."
    },
    {
      "position": 4,
      "text": "Roll up each enchilada; place in the skillet, seam side down."
    },
    {
      "position": 5,
      "text": "Pour salsa over enchiladas, and sprinkle with remaining cheese. Cover and heat enchiladas gently until cheese is melted, 3 to 5 minutes."
    },
    {
      "position": 6,
      "text": "Top with dollops or sour cream, and garnish with fresh cilantro sprigs and lime wedges."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

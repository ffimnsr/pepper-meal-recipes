  "name": "Easy Banana Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "Learn how to make banana ice cream by simply blending frozen bananas and milk for a quick and easy dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine frozen bananas and 1/4 cup skim milk in a blender; blend for 30 seconds. Add remaining 1/4 cup milk and blend on high speed until smooth, about 30 seconds more."
    }

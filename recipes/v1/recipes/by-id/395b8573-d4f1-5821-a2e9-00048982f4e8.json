  "id": "395b8573-d4f1-5821-a2e9-00048982f4e8",
  "slug": "new-york-style-pizza-dough",
  "name": "New York-Style Pizza Dough",
  "recipe_type": "main",
  "brief_description": "New York-style pizza dough is easy to prepare when you are having cravings for the city's famous culinary delight. Plan to make dough the night before you need it!",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, 1/2 cup flour, yeast, and sugar in a bowl; stir well and let sit until mixture is foamy and bubbling, about 20 minutes."
    },
    {
      "position": 2,
      "text": "Stir 2 cups flour, 2 tablespoons olive oil, and salt into yeast mixture using a wooden spoon until dough holds together; turn onto a lightly floured work surface."
    },
    {
      "position": 3,
      "text": "Coat the inside of a large bowl with 2 1/2 teaspoons olive oil."
    },
    {
      "position": 4,
      "text": "Knead dough, adding small amounts of flour as needed, until soft and slightly sticky, about 10 minutes."
    },
    {
      "position": 5,
      "text": "Form dough into a ball and place in the prepared bowl; drizzle about 1/2 teaspoon olive oil over dough and spread to coat entire ball. Cover bowl with a clean kitchen towel and place in a warm area of the kitchen until dough is doubled in size, about 2 hours."
    },
    {
      "position": 6,
      "text": "Punch dough down and place in a large resealable plastic bag; refrigerate 8 hours to overnight. When ready to use, remove dough from refrigerator and bring to room temperature before using."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

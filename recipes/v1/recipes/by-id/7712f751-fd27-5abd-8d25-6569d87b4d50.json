  "id": "7712f751-fd27-5abd-8d25-6569d87b4d50",
  "slug": "holiday-green-gelatin-salad",
  "name": "Holiday Green Gelatin Salad",
  "recipe_type": "salad",
  "brief_description": "A vintage gelatin salad that's a longstanding holiday favorite in many families, this lime and lemon salad mixes crushed pineapple with pecans, cottage cheese and mayonnaise in a sweet creamy-crunchy combination.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large measuring pitcher, mix reserved pineapple juice and enough water to yield 2 cups. Pour into a pot and bring to a boil. Add the lime and lemon gelatin mixes and stir until completely dissolved."
    },
    {
      "position": 2,
      "text": "Stir the mayonnaise and evaporated milk together in a mixing bowl. Stir in the gelatin mixture until completely blended. Mix in the crushed pineapple, cottage cheese, and pecans. Pour the gelatin mixture into a serving bowl. Refrigerate at least 4 hours or overnight."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

  "id": "26d0e327-3f04-59ab-872a-c7b96c32dc5c",
  "slug": "figs-with-caramelized-onions-and-goat-cheese",
  "name": "Figs with Caramelized Onions and Goat Cheese",
  "recipe_type": "appetizer",
  "brief_description": "For your next party, impress your guests with this delectable appetizer made with dried Mission figs, goat cheese, and caramelized onions.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat a skillet over medium heat; add oil. Add onion; cook and stir until onion has softened and turned translucent, about 5 minutes. Reduce heat to low and continue cooking and stirring until onion is very tender and dark brown, about 40 minutes more. Remove from heat and cool."
    },
    {
      "position": 2,
      "text": "While the onion is cooling, cut the figs lengthwise into 1/4-inch rounds."
    },
    {
      "position": 3,
      "text": "Layer 1/4 teaspoon goat cheese, 1/4 teaspoon caramelized onions, and 1 or 2 fig slices on each cracker."
    }
  ],
  "servings": 40,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

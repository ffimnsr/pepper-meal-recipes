{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "ee2a01ad-75fd-55f6-bd1a-316482f90e7a",
  "slug": "yam-and-turnip-stew-with-mini-biscuits",
  "name": "Yam and Turnip Stew with Mini-Biscuits",
  "recipe_type": "soup",
  "brief_description": "A hearty fall stew with little sunflower seed and Parmesan biscuits to put on top instead of dumplings.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk the flour and baking powder together in a mixing bowl. Cut the margarine into the flour mixture with a knife or pastry blender until the mixture resembles fine crumbs. Fold the sunflower seeds and Parmesan cheese into the mixture. Add most of the milk and mix to a firm dough."
    },
    {
      "position": 3,
      "text": "Turn the dough out onto a lightly floured surface and lightly roll to a thickness of 3/8 inch. Cut into 2-inch rounds and arrange on a baking sheet. Brush the tops of the biscuits with the remaining milk."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the biscuits are lightly browned and no longer wet in the middle, about 20 minutes. Set aside."
    },
    {
      "position": 5,
      "text": "Heat the oil in a large pot over medium-high heat; cook and stir the onion, carrots, turnips, yam, celery, and broccoli in the hot oil until the vegetables are soft, about 10 minutes. Season with the coriander, oregano, basil, salt, and pepper; add the tomatoes and vegetable broth. Simmer the mixture until hot and the liquid has reduced slightly, about 20 minutes. Serve in bowls topped with the mini-biscuits."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

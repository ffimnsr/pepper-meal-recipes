  "id": "b3dee79e-8bbc-5e96-9899-dfc37742b149",
  "slug": "strawberry-rhubarb-pie",
  "name": "Grandma's Strawberry Rhubarb Pie",
  "recipe_type": "dessert",
  "brief_description": "This easy strawberry rhubarb pie recipe features a sweet-tart filling in a homemade crust that bakes up golden and flaky. Serve with vanilla ice cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine flour and salt in a large bowl. Pour oil into a 1 cup-sized measuring cup and top with milk; do not mix. Pour oil-milk mixture over flour; blend with a fork until dough forms. Divide dough into 2 balls."
    },
    {
      "position": 3,
      "text": "Place 1 ball on a sheet of waxed paper. Top with another sheet of waxed paper and roll out large enough to fit a 9-inch pie plate. Repeat with remaining dough ball. Peel the top paper off of one of the crusts and flip dough into the pie plate. Peel off the paper and press dough in. Set aside remaining dough for top crust."
    },
    {
      "position": 4,
      "text": "Mix together rhubarb, strawberries, sugar, tapioca, nutmeg, and salt in a large bowl until fruit is well coated; pour into prepared crust in the pie plate. Cover with top crust; trim and flute the edges to seal, then cut several slits in top crust to allow steam to escape."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 20 minutes. Reduce oven temperature to 375 degrees F (190 degrees C) and continue to bake for 20 more minutes. Let pie cool before cutting."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

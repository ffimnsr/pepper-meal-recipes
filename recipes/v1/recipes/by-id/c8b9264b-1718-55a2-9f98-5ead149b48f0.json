  "id": "c8b9264b-1718-55a2-9f98-5ead149b48f0",
  "slug": "grandmas-tuna-casserole",
  "name": "Grandma's Tuna Casserole",
  "recipe_type": "snack",
  "brief_description": "Ridged potato chips add nice texture to this grandma's tuna casserole that's cooked in the microwave for convenience, but with an option for cooking in the oven, too.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until tender yet firm to the bite, 7 to 9 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Mix cooked noodles with tuna, sour cream, 1/4 cup milk, onion soup mix, Worcestershire sauce, garlic powder, seasoned salt, salt, and pepper. Taste and adjust seasonings as desired."
    },
    {
      "position": 3,
      "text": "Lay 1/2 of the butter across the bottom of a 2-quart, microwave-safe casserole dish. Crush potato chips, then sprinkle 1/4 of the crushed chips over the bottom and press to flatten."
    },
    {
      "position": 4,
      "text": "Spread the tuna-noodle mixture in a single layer over the crushed chips. Layer with 1/2 of the mozzarella, 2/3 of the remaining chips, followed by the remaining butter, chips, milk, and mozzarella."
    },
    {
      "position": 5,
      "text": "Microwave on high until casserole is hot and cheese is melted, about 10 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

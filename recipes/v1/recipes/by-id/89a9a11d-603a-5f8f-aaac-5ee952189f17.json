  "schema_version": 1,
  "id": "89a9a11d-603a-5f8f-aaac-5ee952189f17",
  "slug": "red-wine-marinated-beef-stew",
  "name": "Red Wine-Marinated Beef Stew",
  "recipe_type": "soup",
  "brief_description": "Beef stew meat is marinated in red wine to produce tender, rich results that take this veggie-packed stew to new heights.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Marinate the beef in red wine in a 9x13-inch glass baking dish in the refrigerator for at least 3 hours, turning the meat over halfway through marinating time."
    },
    {
      "position": 2,
      "text": "Remove beef from the wine and pat dry with paper towels. Reserve the wine."
    },
    {
      "position": 3,
      "text": "Heat 2 tablespoons oil in a large Dutch oven over medium-high heat. Season beef on all sides with salt and pepper. Brown in the hot oil, about 2 minutes on each side. Remove meat, drain the pot, and add bacon. Cook until semi-crisp and browned, about 5 minutes. Drain bacon grease but do not wipe the pot clean."
    },
    {
      "position": 4,
      "text": "Drizzle remaining oil into the pot and add potatoes, carrots, green beans, celery, and garlic. Cook and stir for 3 minutes. Pour reserved wine, beef broth, and tomatoes into the pot, scraping up the browned bits that cling to the bottom with a wooden spoon. Add rosemary and sage. Return the meat to the pot and bring the liquid to a boil. Cover, reduce heat, and let simmer until meat is very tender and no longer pink, 3 to 3 1/2 hours, adding mushrooms during the last 1 hour of cooking time."
    },
    {
      "position": 5,
      "text": "Combine tapioca and cold water in a bowl. Mix into the stew to thicken as desired."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 200,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "expert",

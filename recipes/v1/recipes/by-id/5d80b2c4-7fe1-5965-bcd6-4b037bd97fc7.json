  "id": "5d80b2c4-7fe1-5965-bcd6-4b037bd97fc7",
  "slug": "quick-and-easy-peach-cobbler",
  "name": "Quick and Easy Peach Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This quick and easy, 5-ingredient peach cobbler recipe comes together and bakes to sweet perfection in minutes\u2014serve it warm with vanilla ice cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk self-rising flour, sugar, and milk together in a bowl until well combined and no lumps remain."
    },
    {
      "position": 3,
      "text": "Pour melted butter into a 2-quart baking dish (or a 9- or 10-inch cast-iron skillet); pour flour-milk mixture over top."
    },
    {
      "position": 4,
      "text": "Carefully pour peaches and syrup into the skillet; spread peaches evenly around the skillet using a spatula."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the crust turns golden brown, 30 to 45 minutes."
    },
    {
      "position": 6,
      "text": "Cool cobbler for about 10 minutes to ensure it sets for easy serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

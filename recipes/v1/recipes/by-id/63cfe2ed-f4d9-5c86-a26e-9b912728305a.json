  "id": "63cfe2ed-f4d9-5c86-a26e-9b912728305a",
  "slug": "air-fryer-salt-and-vinegar-pumpkin-seeds",
  "name": "Air Fryer Salt and Vinegar Pumpkin Seeds",
  "recipe_type": "appetizer",
  "brief_description": "This air fryer salt and vinegar pumpkin seeds recipe is so easy to make with just three simple ingredients: pumpkin seeds, white vinegar, and salt.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour vinegar over pumpkin seeds in a large bowl; let soak for at least 1 hour. Drain; stir in salt."
    },
    {
      "position": 2,
      "text": "Preheat an air fryer to 300 degrees F (150 degrees C). Place seeds in the basket; cook for 30 minutes, shaking the basket every 10 minutes."
    },
    {
      "position": 3,
      "text": "Transfer seeds to a paper-towel-lined plate; let sit 5 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,

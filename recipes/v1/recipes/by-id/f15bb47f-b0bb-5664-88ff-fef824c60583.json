  "id": "f15bb47f-b0bb-5664-88ff-fef824c60583",
  "slug": "copycat-panera-strawberry-poppyseed-chicken-salad-recipe-11927959",
  "name": "Copycat Panera Strawberry Poppyseed Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "Add this fresh take on Panera\u2019s best-loved entr\u00e9e salad to your lunchtime routine. If you like, to reduce added sugars choose canned mandarins and pineapple packed in 100 percent juice and omit the sugar in the dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Prep Dressing: Drain mandarin oranges and pineapple chunks, reserving 1 tablespoon juice from each can. Pour reserved juice into a bowl ; use otherwise or discard. Set aside oranges and pineapple. To the reserved juice, add mayonnaise, vinegar, sugar, mustard, poppy seeds, dried minced onion, salt, and dry mustard; whisk to combine."
    },
    {
      "position": 2,
      "text": "Make Salad: Put romaine in a large bowl. Top with half of the dressing; toss to coat. Add strawberries, blueberries, pecans, and reserved drained oranges and pineapple. Divide salad among 4 serving plates; top evenly with chicken. Serve with remaining dressing. Recipe developed by Barrett Heald"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,

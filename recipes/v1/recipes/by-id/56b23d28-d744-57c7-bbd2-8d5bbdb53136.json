  "slug": "blue-lagoon-margaritas",
  "name": "Blue Lagoon Margarita",
  "recipe_type": "drink",
  "brief_description": "This blue lagoon margarita made with blue curacao, tequila, and pineapple juice is a delicious, tropical margarita that stands out from the crowd.",
  "cuisine": "American Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Place ice into a blender; pour in sour mix, pineapple juice, tequila, blue curaçao, and lime juice. Cover and blend until the mixture is smooth. Pour into chilled glasses."
    }
  ],

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "97e1b9f6-4700-5e83-804e-5759ee0c467d",
  "slug": "grits-a-ya-ya",
  "name": "Grits a Ya Ya",
  "recipe_type": "side",
  "brief_description": "Grits a ya ya brings bacon, spinach, and mushrooms together with jumbo shrimp in a creamy sauce \u2014 served over a platter of smoked Gouda cheese grits.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Prepare the grits: Bring chicken stock to a boil in a saucepan over high heat."
    },
    {
      "position": 2,
      "text": "Slowly pour grits into stock while stirring constantly. Reduce heat to low; simmer until grits are tender and thick, 15 to 20 minutes, stirring occasionally."
    },
    {
      "position": 3,
      "text": "Stir in heavy cream to thin out the grits. Stir in Gouda cheese and butter until melted and smooth."
    },
    {
      "position": 4,
      "text": "While grits are cooking, make the shrimp sauce: Place bacon in a large, deep skillet over medium heat; cook until bacon fat is rendered, about 3 minutes."
    },
    {
      "position": 5,
      "text": "Stir in shallot and garlic; cooking and stirring until shallots are tender, about 5 minutes."
    },
    {
      "position": 6,
      "text": "Pour in white wine and stir in butter, cooking and stirring until butter has melted."
    },
    {
      "position": 7,
      "text": "Drop shrimp in the skillet; cook and stir until they are bright pink on the outside and the meat is no longer transparent in the center, about 3 minutes."
    },
    {
      "position": 8,
      "text": "Stir in spinach, mushrooms, and green onions; cook and stir until the spinach wilts, about 2 minutes more."
    },
    {
      "position": 9,
      "text": "Remove shrimp with a slotted spoon."
    },
    {
      "position": 10,
      "text": "Stir in heavy cream to the sauce. Simmer until the cream is reduced by about a third, about 10 minutes. Season with hot sauce, salt, and pepper. Return shrimp to the skillet to heat through."
    },
    {
      "position": 11,
      "text": "Serve shrimp with sauce over the prepared grits."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

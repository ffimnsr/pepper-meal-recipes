  "id": "dc98d41f-94d9-5477-a865-ce6be2703b03",
  "slug": "homemade-sauerkraut",
  "name": "Homemade Sauerkraut",
  "recipe_type": "side",
  "brief_description": "This sauerkraut recipe is easy to make in just 30 minutes using this quick method for a deliciously tangy, crunchy side dish or topping for hot dogs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, \u00bd cup vinegar, and onion in a pot over high heat. Add cabbage, salt, celery seeds, onion powder, garlic powder, and black pepper, then pour remaining \u00bd cup vinegar over top."
    },
    {
      "position": 2,
      "text": "Cover and bring to a boil. Reduce the heat and simmer for 3 minutes."
    },
    {
      "position": 3,
      "text": "Stir cabbage. Cover; continue cooking, stirring occasionally, until cabbage is tender and wilted, 10 to 15 minutes more."
    },
    {
      "position": 4,
      "text": "Serve ane enjoy."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

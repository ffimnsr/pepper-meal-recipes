  "id": "df126991-b4e0-539f-90c7-f25ea22945b6",
  "slug": "all-natural-strawberry-lemonade",
  "name": "All Natural Strawberry Lemonade",
  "recipe_type": "drink",
  "brief_description": "This homemade strawberry lemonade is easy to make in a blender with just ripe strawberries, lemon juice, and sugar for a refreshing summer drink.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place strawberries in a blender; top with 2 tablespoons sugar. Pour 1 cup water over sugared strawberries; blend until completely smooth."
    },
    {
      "position": 3,
      "text": "Transfer strawberry juice into a large pitcher; stir in remaining 6 cups water, lemon juice, and 1 cup sugar until well blended. Taste and add more sugar if desired; chill before serving."
    }
  ],
  "servings": 12,

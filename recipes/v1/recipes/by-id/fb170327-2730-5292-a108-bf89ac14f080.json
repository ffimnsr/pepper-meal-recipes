  "id": "fb170327-2730-5292-a108-bf89ac14f080",
  "slug": "harissa-chicken-meatballs-recipe-8649926",
  "name": "Harissa Chicken Meatballs",
  "recipe_type": "appetizer",
  "brief_description": "These baked harissa chicken meatballs are spicy and delicious. They make a good appetizer with a lemon yogurt dipping sauce, or serve them in a grain bowl with roasted veggies.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine ground chicken, breadcrumbs, egg, harissa, garlic powder, salt, cumin, paprika, and black pepper in a large bowl. Mix gently with a fork or damp hands just until thoroughly combined. Shape the mixture into approximately 24 meatballs; place on the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until cooked through and lightly browned, 15 to 20 minutes. Sprinkle with mint. Serve hot with your favorite side dish or dipping sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "59d0edf3-befb-54e1-b7a6-e07467ef97a1",
  "slug": "honey-and-molasses-gingersnaps",
  "name": "Honey and Molasses Gingersnaps",
  "recipe_type": "dessert",
  "brief_description": "Full of holiday flavor thanks to honey and molasses, these easy baked gingersnap cookies make a great gift or party dessert.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line 2 large baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine flour, 1 1/2 teaspoons cinnamon, ginger, baking soda, and salt in a bowl."
    },
    {
      "position": 3,
      "text": "Beat white sugar, butter, and egg together in a large bowl with an electric mixer at medium speed until fluffy, about 2 minutes. Add molasses and honey and beat for 1 minute. Slowly beat in flour mixture to combine."
    },
    {
      "position": 4,
      "text": "Combine turbinado sugar and remaining 1 1/2 teaspoons cinnamon in a shallow bowl."
    },
    {
      "position": 5,
      "text": "Roll dough into balls using a rounded teaspoon. Roll each in cinnamon-sugar mixture and place on the prepared baking sheets."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden, about 10 minutes. Cool for 1 minute, then transfer to wire racks to finish cooling."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,

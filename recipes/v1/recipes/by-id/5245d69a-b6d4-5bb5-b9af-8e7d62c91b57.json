  "id": "5245d69a-b6d4-5bb5-b9af-8e7d62c91b57",
  "slug": "banana-bread-mug-cake-in-a-minute",
  "name": "Banana Bread Mug Cake in a Minute",
  "recipe_type": "dessert",
  "brief_description": "Turn that ripe banana on your counter into Chef John's decadent banana bread mug cake in just a minute with this easy recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine ripe banana, brown sugar, white sugar, salt, baking powder, baking soda, melted butter, milk, and vanilla in a mixing bowl; use a potato masher to mash the mixture into a smooth puree. Add flour and mix until just combined. Stir in walnuts and chocolate chips until evenly mixed."
    },
    {
      "position": 2,
      "text": "Transfer batter evenly into two lightly buttered coffee mugs or cups. Tap a few times on a towel to settle everything down and ensure there are no air pockets."
    },
    {
      "position": 3,
      "text": "Microwave cups, one at a time, until a toothpick comes out clean, about 1 minute."
    },
    {
      "position": 4,
      "text": "Let cool before serving."
    },
    {
      "position": 5,
      "text": "Optional: Garnish each with banana slices and dust with sugar. Brulee the tops with a blowtorch."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 2,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

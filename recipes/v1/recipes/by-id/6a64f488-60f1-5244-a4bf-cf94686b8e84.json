  "id": "6a64f488-60f1-5244-a4bf-cf94686b8e84",
  "slug": "pumpkin-curry-with-white-fish-recipe-11775430",
  "name": "Pumpkin Curry with White Fish",
  "recipe_type": "main",
  "brief_description": "This pumpkin curry with white fish uses canned pumpkin and coconut milk to create a silky base for a veggie-packed curry. Use a firm white fish, such as halibut or cod.",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a very large skillet over medium heat. Add onion and carrot; cook, stirring occasionally, until softened, 3 to 4 minutes. Add bell pepper and jalape\u00f1o; cook, stirring occasionally, until softened, about 3 minutes."
    },
    {
      "position": 2,
      "text": "Add curry paste, ginger, and garlic; cook and stir until fragrant, about 30 seconds. Add coconut milk, pumpkin, maple syrup, and fish sauce; bring to a boil over high heat. Reduce heat to medium and simmer, uncovered, stirring occasionally, until thickened, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Arrange halibut in skillet. Simmer, covered, 3 to 5 minutes or until opaque and an instant-read thermometer inserted into thickest portion registers 145 degrees F (63 degrees C). Top with cilantro. Serve with rice and lime wedges. Garnish with pepitas."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "3-ingredient-pancakes-recipe-11894382",
  "name": "3-Ingredient Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These 3-ingredient pancakes are so tasty! They're light and fluffy and super easy to make - they'll be your new favorite way to make simple and quick pancakes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine eggs, cottage cheese, and flour in a blender. Blend until smooth."
    },
    {
      "position": 2,
      "text": "Heat a nonstick skillet or griddle over medium heat. Coat with nonstick spray. Drop 3-tablespoon portions of batter onto the skillet. Cook until edges are set, 1 to 2 minutes. Carefully turn and cook until bottoms are browned, 1 to 2 minutes."
    },
    {
      "position": 3,
      "text": "Serve with desired toppings, e.g. maple syrup, jam, fresh berries, or powdered sugar."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 10,

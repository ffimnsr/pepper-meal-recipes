  "id": "5a8a571d-3612-5fe5-a248-c9e30ed28fc3",
  "slug": "beef-bulgogi-with-dipping-sauce",
  "name": "Beef Bulgogi with Dipping Sauce",
  "recipe_type": "main",
  "brief_description": "Make this beef bulgogi with soy-sesame dipping sauce in under an hour for a complete Korean barbeque dish that'll knock your chopsticks off!",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Mix 1/4 cup soy sauce, green onions, 3 tablespoons sugar, vegetable oil, garlic, sesame oil, and 1 teaspoon sesame seeds together in a bowl. Add beef to the marinade. Let sit until flavors are well absorbed, at least 30 minutes."
    },
    {
      "position": 2,
      "text": "Prepare dipping sauce: Mix 6 tablespoons soy sauce, vinegar, 2 teaspoons sesame seeds, ginger root, paprika, cayenne pepper, and 1 pinch sugar together in a separate bowl."
    },
    {
      "position": 3,
      "text": "Heat a skillet over medium-high heat. Cook and stir beef until firm and lightly browned, 8 to 10 minutes. Serve with dipping sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 8,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

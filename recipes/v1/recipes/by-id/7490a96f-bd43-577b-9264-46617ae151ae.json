  "id": "7490a96f-bd43-577b-9264-46617ae151ae",
  "slug": "oven-fresh-seasoned-potato-wedges",
  "name": "Oven-Fresh Seasoned Potato Wedges",
  "recipe_type": "side",
  "brief_description": "Potato wedges baked in the oven, seasoned with Parmesan, garlic powder, and onion powder. They're easy to make for a tasty side and sure to be a hit!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients and preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Place potatoes, Parmesan cheese, olive oil, onion powder, garlic powder, salt, and pepper into a resealable plastic bag. Seal the bag, then shake until potatoes are evenly coated with seasoning."
    },
    {
      "position": 3,
      "text": "Spread potatoes on a baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until potatoes are easily pierced with a fork, about 25 minutes."
    },
    {
      "position": 5,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

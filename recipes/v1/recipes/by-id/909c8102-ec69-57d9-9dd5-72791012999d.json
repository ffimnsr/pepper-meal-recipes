  "schema_version": 1,
  "id": "909c8102-ec69-57d9-9dd5-72791012999d",
  "slug": "toasted-pumpkin-seeds-with-sugar-and-spice",
  "name": "Toasted Pumpkin Seeds with Sugar and Spice",
  "recipe_type": "appetizer",
  "brief_description": "This toasted pumpkin seeds with sugar and spice recipe is candied, then tossed with pumpkin pie spice, sugar, and salt. Easy to make and hard to mess up.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 250 degrees F (120 degrees C)."
    },
    {
      "position": 2,
      "text": "Spread pumpkin seeds on a baking sheet in a single layer."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven, stirring occasionally, until dry and toasted, about 45 minutes. Larger seeds may take longer."
    },
    {
      "position": 4,
      "text": "Combine 2 tablespoons white sugar, pumpkin pie spice, and salt in a medium bowl. Set aside."
    },
    {
      "position": 5,
      "text": "Heat oil in a large skillet over medium-high heat. Add toasted pumpkin seeds; sprinkle with remaining \u00bc cup sugar. Cook and stir with a wooden spoon until sugar melts, about 45 seconds."
    },
    {
      "position": 6,
      "text": "Pour candied pumpkin seeds into bowl with spiced sugar; stir until coated. Cool completely before serving. Store in an airtight container at room temperature."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "0127d0b0-e5ac-5bb4-90b2-49b85cb4a6cd",
  "slug": "peach-cobbler-i",
  "name": "Favorite Peach Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This peach cobbler recipe features fresh sliced fruit tossed with melted butter and sugar, topped with an easy cinnamony batter that bakes up tender.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Pour melted butter into the bottom of a 9x13-inch baking dish. Add peaches and 2 tablespoons sugar; toss until evenly coated."
    },
    {
      "position": 3,
      "text": "Stir together flour, 1 cup sugar, milk, cinnamon, baking powder, and salt in a large bowl until well combined; spoon batter over peaches."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the top is golden brown, about 45 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

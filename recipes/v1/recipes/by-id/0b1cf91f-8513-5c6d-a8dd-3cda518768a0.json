  "id": "0b1cf91f-8513-5c6d-a8dd-3cda518768a0",
  "slug": "beet-salad-with-goat-cheese",
  "name": "Beet Salad with Goat Cheese",
  "recipe_type": "salad",
  "brief_description": "A spectacular beet salad with crunchy candied walnuts and creamy goat cheese served on a bed of baby greens with a orange-balsamic dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place beets into a saucepan; add enough water to cover. Bring to a boil, then cook for 20 to 30 minutes, until tender. Drain and cool, then cut into cubes."
    },
    {
      "position": 2,
      "text": "While beets are cooking, place walnuts in a skillet over medium-low heat. Heat until warm and starting to toast. Stir in maple syrup; cook and stir until evenly coated, then remove from heat and set aside to cool."
    },
    {
      "position": 3,
      "text": "To make the dressing: Whisk orange juice concentrate, balsamic vinegar, and olive oil together in a small bowl."
    },
    {
      "position": 4,
      "text": "Place a large helping of baby greens onto each of four salad plates, divide candied walnuts equally and sprinkle over greens. Place equal amounts of beets over greens and top with pieces of goat cheese. Drizzle dressing over each salad."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

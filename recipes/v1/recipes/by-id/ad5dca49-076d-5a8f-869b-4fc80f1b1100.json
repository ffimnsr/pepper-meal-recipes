  "id": "ad5dca49-076d-5a8f-869b-4fc80f1b1100",
  "slug": "pork-pie",
  "name": "Pork Pie",
  "recipe_type": "main",
  "brief_description": "This pork pie recipe includes ground beef in the meaty filling mixed with mashed potatoes and lightly seasoned with nutmeg for a French Canadian dish.",
  "cuisine": "New England French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat. Cook and stir pork and beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain and discard grease."
    },
    {
      "position": 3,
      "text": "Mix together cooked meat, mashed potatoes, nutmeg, salt, and pepper in a large bowl until well combined."
    },
    {
      "position": 4,
      "text": "Line a 9-inch pie dish with 1 pastry crust. Spoon meat mixture into crust. Cover with second pastry crust; seal and flute the edges. Brush top crust with beaten egg white. Shield the edges with aluminum foil to prevent crust from burning."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 30 minutes. Remove aluminum foil and continue baking until edges brown, about 15 minutes more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,

  "id": "d6b8e732-95e0-5e5d-889f-542eca9c7347",
  "slug": "roasted-rhubarb-salmon-recipe-11730724",
  "name": "Roasted Rhubarb Salmon",
  "recipe_type": "main",
  "brief_description": "Chef John's roasted rhubarb salmon, thick-cut fillets are topped with a tangy, citrusy rhubarb sauce, then roasted to marry the flavors of tart rhubarb with succulent salmon.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine rhubarb, light green and white parts of green onion, butter, lime juice, rice vinegar, honey, 1/2 teaspoons salt, and cayenne in a saucepan, and bring to a simmer over medium-high heat. Cook, stirring occasionally, until mixture becomes a chunky sauce, 3 to 4 minutes. Remove from heat and set aside until needed,"
    },
    {
      "position": 2,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 3,
      "text": "Oil a baking dish large enough to fit salmon pieces, spaced 1 or 2 inches apart. Place salmon in and season generously with remaining 1 teaspoon kosher salt."
    },
    {
      "position": 4,
      "text": "Spoon rhubarb mixture over the top of each piece of salmon, covering the surface, and then spoon any remaining sauce in between."
    },
    {
      "position": 5,
      "text": "Roast in the preheated oven until an instant read thermometer inserted into thickest part of salmon reaches 125 to 130 degrees F (50 to 54 degrees C). 15 to 20 minutes. Garnish with thinly sliced green onion tops, and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

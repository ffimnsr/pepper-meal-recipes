  "id": "4a3b757e-d6ba-5916-b5cd-ced0ec52f483",
  "slug": "coconut-bon-bons",
  "name": "Coconut Bonbons",
  "recipe_type": "dessert",
  "brief_description": "These coconut bonbons are little balls of joy made with flaked coconut, sweetened condensed milk, and melted chocolate. Perfect for any occasion!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix butter, confectioners' sugar, and sweetened condensed milk together in a medium bowl; mix in coconut."
    },
    {
      "position": 3,
      "text": "Roll dough into 1 inch balls; refrigerate until set, about 1 hour."
    },
    {
      "position": 4,
      "text": "Melt chocolate and shortening over a double boiler, stirring occasionally until smooth. Remove from heat when melted, and stir to make sure the shortening is fully incorporated."
    },
    {
      "position": 5,
      "text": "Use toothpicks to hold the balls and dip them in the melted chocolate. Set on wax paper to dry."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 30,

  "id": "31ca0e9a-db23-55fa-acd1-de48fe0dc567",
  "slug": "gnocchi-with-cherry-tomato-sauce",
  "name": "Gnocchi with Cherry Tomato Sauce",
  "recipe_type": "dessert",
  "brief_description": "This gnocchi with cherry tomato sauce recipe features a sweet, fresh, spicy sauce made with cherry tomatoes, canned crushed tomatoes, and dried chiles.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large saucepan over medium heat. Add onion, garlic, and chile pepper; cook until onion has softened and turned translucent, about 5 minutes. Increase heat to medium-high; stir in cherry tomatoes. Cook until tomatoes start to break down and begin to make a sauce, about 5 minutes. Stir in crushed tomatoes; bring to a simmer, then reduce heat to medium-low and cook for 10 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil over high heat. Cook gnocchi in the boiling water until they float to the top, 2 to 3 minutes. Gently transfer gnocchi to a serving dish using a strainer or slotted spoon."
    },
    {
      "position": 3,
      "text": "Stir basil and olives into simmering sauce; cook 1 minute. Pour sauce over gnocchi. Sprinkle servings with Parmesan cheese."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "6961147a-6508-5c43-8a01-2929487cb93c",
  "slug": "moroccan-shabbat-fish",
  "name": "Moroccan Shabbat Fish",
  "recipe_type": "main",
  "brief_description": "This Moroccan Shabbat fish recipe bakes tilapia with tomatoes, red bell pepper, paprika, cayenne, and fresh parsley for a flavorful family meal.",
  "cuisine": "Israeli",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Layer thinly sliced red peppers and tomatoes in the bottom of a baking dish. Arrange tilapia fillets on top."
    },
    {
      "position": 3,
      "text": "Whisk water, oil, paprika, bouillon granules, cayenne, salt, and pepper together in a bowl; pour over tilapia, then sprinkle with parsley."
    },
    {
      "position": 4,
      "text": "Cover the baking dish with aluminum foil and bake in the preheated oven until vegetables are tender and tilapia flakes easily with a fork and reaches an internal temperature of 145 degrees F (65 degrees C), about 30 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

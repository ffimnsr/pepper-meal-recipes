  "id": "383f1eea-0d1b-5ef7-9aa5-4b402286174d",
  "slug": "chicken-fajita-skillet-casserole-recipe-8701199",
  "name": "Chicken Fajita Skillet Casserole",
  "recipe_type": "main",
  "brief_description": "This chicken fajita skillet casserole is a one-pot dinner made in a skillet using convenient rotisserie chicken, peppers, and pantry staples.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat oil in a large, oven-proof skillet over medium-high heat. Add peppers and onions and cook, undisturbed, 5 minutes or until browned. Add chili powder, cumin, garlic powder, salt and pepper and continue cooking until vegetables are soft, stirring often, 1 to 2 minutes. Remove vegetables from the pan and set aside."
    },
    {
      "position": 3,
      "text": "Add butter to the pan and melt over moderate heat. Whisk in flour and cook for 1 minute, stirring constantly. Add in tomatoes and broth and cook until thick and creamy, stirring constantly, about 3 minutes. Stir in chicken and beans. Top chicken mixture with 1 cup cheese. Spread reserved peppers and onions evenly over the cheese and top with chips and remaining cheese."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bubbly and lightly browned on top, about 15 minutes. Serve with desired toppings."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "6786c468-9956-521f-8540-a463f83c9c83",
  "slug": "peach-basil-sangria",
  "name": "Peach-Basil Sangria",
  "recipe_type": "drink",
  "brief_description": "This quick and easy peach-basil sangria recipe is a unique take on sangria. It's refreshing and satisfying, you'll want to sip on it all summer long.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine \u00bd peach nectar, basil leaves, sugar, and lemon juice in a saucepan; bring to a simmer, crushing basil leaves with the back of a spoon to release their flavor, until sugar is melted. Cool."
    },
    {
      "position": 2,
      "text": "Strain basil mixture into an ice-filled pitcher. Add wine and remaining \u00bd peach nectar; stir."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

  "id": "e25dcf2d-5330-555e-a526-cf5f0b23a9e0",
  "slug": "mini-cheesecakes",
  "name": "Ginny\u2019s Mini Cheesecakes",
  "recipe_type": "dessert",
  "brief_description": "Muffin tins are lined with paper baking cups and a vanilla wafer \u201ccrust,\u201d then filled with a lemony cheesecake batter and baked. Top with your favorite fruit pie filling, if desired.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Line muffin tins with 12 paper baking cups. Place a vanilla wafer in each one."
    },
    {
      "position": 3,
      "text": "In a medium mixing bowl beat cream cheese until fluffy. Add eggs, lemon juice, and sugar. Beat until smooth and thoroughly combined."
    },
    {
      "position": 4,
      "text": "Fill each baking cup 2/3 full with cream cheese mixture."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven for 15 to 17 minutes. Cool on a rack. Top with fruit pie filling or topping of your choice."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

  "id": "eb6083ae-27fa-5ace-bcbb-d124d530843e",
  "slug": "crab-cheese-fondue",
  "name": "Crab Cheese Fondue",
  "recipe_type": "appetizer",
  "brief_description": "Fresh snow crab is added to a decadent white wine cheese fondue that everyone will love at your next party or potluck.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Melt cream cheese and wine together in an electric fondue pot or saucepan over low heat, stirring constantly until smooth, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Toss Swiss cheese with cornstarch in a bowl to coat. Stir into wine mixture with crabmeat, milk, Worcestershire, and parsley until the cheese is smooth and crab is heated thoroughly, 5 to 10 minutes. Transfer to a fondue pot if not using already, or chafing dish; keep warm."
    }
  ],
  "servings": 8,

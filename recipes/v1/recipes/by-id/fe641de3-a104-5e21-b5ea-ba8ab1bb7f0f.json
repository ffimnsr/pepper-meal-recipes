  "id": "fe641de3-a104-5e21-b5ea-ba8ab1bb7f0f",
  "slug": "cheesy-ham-and-hash-brown-casserole",
  "name": "Cheesy Ham and Hash Brown Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This ham and hash brown casserole is a family-friendly dish made with hash brown potatoes and ham in a creamy sauce for a yummy, lazy day breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Mix together hash browns, condensed soup, sour cream, Cheddar cheese, and ham in a bowl until well combined."
    },
    {
      "position": 3,
      "text": "Spread evenly into the prepared dish. Sprinkle with Parmesan cheese."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until bubbly and lightly brown, about 1 hour."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

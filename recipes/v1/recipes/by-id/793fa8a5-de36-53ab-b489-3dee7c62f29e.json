  "slug": "quick-cabbage-and-chicken-meatballs-recipe-8401790",
  "name": "Quick Cabbage and Chicken Meatballs",
  "recipe_type": "main",
  "brief_description": "This quick cabbage and chicken meatballs is a one-skillet meal with ingredients that are easy to find and plenty of veggies. It's easy to make, clean up is easy, and it stores and reheats well.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt 1 tablespoon butter in a large skillet over medium heat. Add meatballs and onion, and cook, stirring occasionally, just until onions become soft and translucent, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir in cabbage, the remaining 1 tablespoon butter, marinara, Creole seasoning, black pepper, and red pepper flakes. Stirring frequently, cook until cabbage is tender with a bite, about 3 minutes, or longer if you prefer more tender cabbage."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

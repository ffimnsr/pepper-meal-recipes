  "id": "10fa0b75-80fc-5dcc-8aa6-1d4eeb4d01df",
  "slug": "zucchini-coffee-cake-recipe-7554364",
  "name": "Zucchini Coffee Cake",
  "recipe_type": "dessert",
  "brief_description": "You won't taste the zucchini in this delicious coffee cake. A great way to sneak some veggies into your diet.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat oven to 350 degrees F (175 degrees C). Line a 9x13-inch pan with foil and coat with cooking spray."
    },
    {
      "position": 2,
      "text": "Using large holes of a box grater, shred zucchini. (You should have 2 cups packed.) Transfer zucchini to a clean kitchen towel. Roll up; squeeze out as much moisture as possible."
    },
    {
      "position": 3,
      "text": "Stir together flour, baking powder, and salt in a bowl."
    },
    {
      "position": 4,
      "text": "In a large bowl, beat 1 cup softened butter with an electric mixer until light and fluffy."
    },
    {
      "position": 5,
      "text": "Gradually beat in sour cream, then white sugar."
    },
    {
      "position": 6,
      "text": "Beat in eggs, 1 at a time."
    },
    {
      "position": 7,
      "text": "Stir in zucchini and vanilla."
    },
    {
      "position": 8,
      "text": "Fold in flour mixture with a spatula, mixing just until incorporated."
    },
    {
      "position": 9,
      "text": "Spread batter into prepared pan."
    },
    {
      "position": 10,
      "text": "Stir together pecans, brown sugar, and cinnamon in a bowl. Stir in 2 tablespoons melted butter until crumbly."
    },
    {
      "position": 11,
      "text": "Sprinkle topper over cake batter."
    },
    {
      "position": 12,
      "text": "Bake until a toothpick inserted into center of cake comes out clean, 35 to 40 minutes. Let cool in pan 10 minutes before serving."
    }
  ],
  "servings": 12,

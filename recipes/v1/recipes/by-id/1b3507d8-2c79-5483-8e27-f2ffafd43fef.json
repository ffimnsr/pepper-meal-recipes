  "id": "1b3507d8-2c79-5483-8e27-f2ffafd43fef",
  "slug": "loaded-reuben-totchos",
  "name": "Loaded Reuben Totchos",
  "recipe_type": "appetizer",
  "brief_description": "When are appetizers more than just starters? When totchos get a Reuben makeover, that's when!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a baking sheet with foil."
    },
    {
      "position": 2,
      "text": "Spread potato nuggets on prepared baking sheet. Bake until golden brown, 28 to 32 minutes."
    },
    {
      "position": 3,
      "text": "Top potato nuggets with corned beef, sauerkraut, Swiss cheese, and Colby and Monterey Jack cheese. Bake until cheese is melted, 5 to 8 minutes."
    },
    {
      "position": 4,
      "text": "Drizzle with Thousand Island dressing and mustard. Sprinkle with green onion and caraway seeds."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,

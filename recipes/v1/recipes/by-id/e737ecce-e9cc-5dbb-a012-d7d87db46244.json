  "id": "e737ecce-e9cc-5dbb-a012-d7d87db46244",
  "slug": "tofu-salad",
  "name": "Tofu Salad",
  "recipe_type": "salad",
  "brief_description": "Delicious tofu salad featuring firm tofu marinated in a ginger, soy, and sesame mixture, tossed with blanched snow peas, cabbage, carrots, and peanuts.",
  "cuisine": "Asian Inspired Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Make the tofu: Whisk chili sauce, soy sauce, sesame oil, garlic, and ginger together in a large bowl. Add tofu and toss to coat. Cover and marinate for 1 hour in the refrigerator."
    },
    {
      "position": 2,
      "text": "When the tofu is almost finished marinating, bring a pot of water to a boil. Add snow peas and blanch for 1 to 2 minutes. Transfer with a slotted spoon to a bowl of cold water. Drain and blot dry."
    },
    {
      "position": 3,
      "text": "Make the salad: Combine snow peas, cabbage, carrots, and peanuts in a bowl. Add tofu and marinade and toss gently to combine."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

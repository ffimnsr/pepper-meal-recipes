  "id": "cf6d507c-1aca-51b5-94ce-a4cb8bd150f6",
  "slug": "peanut-butter-and-jelly-overnight-oats",
  "name": "Peanut Butter and Jelly Overnight Oats",
  "recipe_type": "breakfast",
  "brief_description": "These overnight oats with peanut butter and strawberry jelly are very easy to make, full of flavor, and everyone will love them. This is the perfect take-along breakfast!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Whisk together almond milk, oats, 1/4 cup peanut butter, chia seeds, maple syrup, and salt in a bowl. Cover and refrigerate, 8 hours to overnight."
    },
    {
      "position": 2,
      "text": "Before serving, stir in strawberry preserves, remaining peanut butter, and more maple syrup if needed. Top with sliced strawberries and slivered almonds."
    }
  ],
  "servings": 4,

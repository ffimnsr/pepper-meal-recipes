  "slug": "slow-cooker-pork-tenderloin-and-potatoes",
  "name": "Slow Cooker Pork Tenderloin and Potatoes",
  "recipe_type": "main",
  "brief_description": "The entire family will love this moist pork tenderloin cooked in the slow cooker with melt-in-your-mouth potatoes and baby carrots.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place pork in the slow cooker and sprinkle with garlic. Arrange potatoes, carrots, and bouillon cubes around pork. Add water."
    },
    {
      "position": 2,
      "text": "Cover and cook on Low until pork is slightly pink in the center and potatoes are tender, about 4 hours. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C)."
    }
  ],

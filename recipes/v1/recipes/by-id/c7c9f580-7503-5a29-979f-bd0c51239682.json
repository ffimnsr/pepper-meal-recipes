  "id": "c7c9f580-7503-5a29-979f-bd0c51239682",
  "slug": "no-bake-cranberry-pecan-energy-balls",
  "name": "No-Bake Cranberry-Pecan Energy Balls",
  "recipe_type": "appetizer",
  "brief_description": "Searching for a no-bake energy bar recipe? Try these easy energy balls made with peanut butter, oats, and almond flour for a great pick-me-up between meals.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix oats, almond flour, chocolate chips, flax seed, and chia seeds together in a large bowl. Add cranberries, pecans, peanut butter, honey, and vanilla and mix with your hands (you may want to wear gloves)."
    },
    {
      "position": 2,
      "text": "Roll dough into twenty four 1 1/2-inch balls and place in resealable bags. Store in the refrigerator for up to 4 to 5 days, or freeze until ready to use."
    }
  ],
  "servings": 24,

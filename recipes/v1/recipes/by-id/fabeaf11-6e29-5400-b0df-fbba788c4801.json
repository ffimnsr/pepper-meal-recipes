  "id": "fabeaf11-6e29-5400-b0df-fbba788c4801",
  "slug": "best-ever-texas-caviar",
  "name": "Best-Ever Texas Caviar",
  "recipe_type": "salad",
  "brief_description": "This cowboy caviar recipe for Texas salad is made with beans, corn, bell peppers, and chiles in garlic vinaigrette for a delicious party appetizer.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix together black beans, pinto beans, white corn, green chiles, red and green bell peppers, red onion, jalape\u00f1o pepper, and cilantro in a large bowl."
    },
    {
      "position": 3,
      "text": "Combine rice vinegar, olive oil, sugar, and garlic powder in a pan. Bring to a boil, then remove from heat. Let cool for at least 10 minutes."
    },
    {
      "position": 4,
      "text": "Pour dressing over bean mixture; toss to coat."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 25,

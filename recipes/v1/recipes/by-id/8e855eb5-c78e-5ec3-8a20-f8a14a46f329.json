  "id": "8e855eb5-c78e-5ec3-8a20-f8a14a46f329",
  "slug": "veggie-pizza",
  "name": "Veggie Pizza",
  "recipe_type": "main",
  "brief_description": "This veggie pizza is made from crescent dough and a creamy garlicky cheese spread loaded with fresh, crunchy veggies for an easy take on a favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Spray a 15x10-inch pan with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Press crescent roll dough into the prepared jelly roll pan to form a crust. Let stand 5 minutes. Pierce with a fork."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until dough is fully cooked and golden brown, about 10 minutes. Let cool completely."
    },
    {
      "position": 4,
      "text": "Combine sour cream, cream cheese, ranch seasoning mix, dill, and garlic salt in a medium mixing bowl. Spread the cream cheese mixture on top of cooled crust."
    },
    {
      "position": 5,
      "text": "Arrange broccoli, radish, onion, bell pepper, carrot, and celery on top of the cream cheese mixture."
    },
    {
      "position": 6,
      "text": "Cover and let chill, 1 to 2 hours. Cut chilled pizza into 16 squares to serve."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

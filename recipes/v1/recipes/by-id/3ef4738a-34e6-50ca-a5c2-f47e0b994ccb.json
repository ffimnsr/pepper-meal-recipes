  "id": "3ef4738a-34e6-50ca-a5c2-f47e0b994ccb",
  "slug": "turkey-giblet-gravy",
  "name": "Turkey Giblet Gravy",
  "recipe_type": "side",
  "brief_description": "This turkey giblet gravy is made with gizzards, giblets, and flavorsome pan drippings to make the most delicious gravy for your Thanksgiving meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine turkey giblets, neck, and 4 cups water in a saucepan; bring to a boil. Reduce heat to low and simmer until broth is reduced to 3 cups, about 1 hour."
    },
    {
      "position": 3,
      "text": "Strain broth and reserve 1/2 cup giblets."
    },
    {
      "position": 4,
      "text": "Combine strained broth and turkey drippings in a saucepan over medium heat. Whisk together 1/2 cup cold water and cornstarch in a small bowl until smooth; pour into broth mixture in the saucepan and bring to a boil."
    },
    {
      "position": 5,
      "text": "While broth is coming to a boil, finely chop giblets."
    },
    {
      "position": 6,
      "text": "Reduce heat to low; stir giblets and hard-cooked egg into gravy."
    },
    {
      "position": 7,
      "text": "Simmer until gravy is thickened, about 5 minutes. Season with salt and black pepper."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

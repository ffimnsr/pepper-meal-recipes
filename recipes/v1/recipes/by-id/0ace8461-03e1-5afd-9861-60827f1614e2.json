  "id": "0ace8461-03e1-5afd-9861-60827f1614e2",
  "slug": "homemade-english-muffins",
  "name": "Homemade English Muffins",
  "recipe_type": "breakfast",
  "brief_description": "Made with bread flour for the typical chewy texture that you know and love, this homemade English muffins recipe is the perfect addition to breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place flour in a large bowl. Sprinkle yeast on one side of flour and salt on other side. Add milk, sugar, butter, and egg; stir to make a soft dough."
    },
    {
      "position": 2,
      "text": "Turn dough out onto a lightly floured surface; knead until soft, smooth, and stretchy, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Place dough into a large oiled bowl. Cover and let rise in a warm place until doubled in volume, about 1 hour."
    },
    {
      "position": 4,
      "text": "Deflate dough; divide into 16 pieces. Press each dough piece into English muffin rings; sprinkle both sides with semolina. Let rest 30 minutes."
    },
    {
      "position": 5,
      "text": "Preheat a griddle to 400 degrees F (200 degrees C) or a heavy skillet over low heat. Cook muffins on the preheated griddle or skillet until an instant-read thermometer inserted into centers reaches 200 F (93 degrees C), 7 to 10 minutes per side."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": 30,
  "difficulty": "medium",

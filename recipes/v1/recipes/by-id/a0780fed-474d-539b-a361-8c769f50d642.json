  "slug": "purple-and-gold-margarita",
  "name": "Purple and Gold Margarita",
  "recipe_type": "dessert",
  "brief_description": "Enjoy this dark purple margarita made with gold tequila, raspberry liqueur, and sweet and sour mix when you're hosting your next cocktail party.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Pour salt onto a small plate. Moisten the rim of a margarita glass on a damp towel and press into the salt."
    },
    {
      "position": 2,
      "text": "In a cocktail mixer full of ice, combine tequila, sweet and sour mix, and raspberry liqueur. Shake vigorously and strain into the salt-rimmed glass."
    }
  ],

  "id": "a1f674bd-3211-5492-b699-47e7b170f572",
  "slug": "sheet-pan-moroccan-chicken-tagine-recipe-12034757",
  "name": "Sheet Pan Moroccan Chicken Tagine",
  "recipe_type": "main",
  "brief_description": "Dupe tagine-style cooking on a sheet pan by first crisping up the chicken thighs under the broiler then baking them under foil with bold spices and veggies for ultimate tenderness.",
  "cuisine": "Moroccan",
  "instructions": [
    {
      "position": 1,
      "text": "Set oven rack about 6 inches from the heat source and preheat the broiler. Lightly oil a 13x18-inch rimmed sheet pan."
    },
    {
      "position": 2,
      "text": "Arrange chicken on the prepared pan. Sprinkle with salt. Broil until browned, turning halfway through, 10 to 12 minutes. Remove from the oven. Carefully move the oven rack to the center of the oven. Reduce oven temperature to 325 degrees F (162 degrees C)."
    },
    {
      "position": 3,
      "text": "Arrange chickpeas, onion, olives, apricots, and preserved lemon around chicken on baking sheet. Whisk together broth, tomato paste, honey, cumin, paprika, turmeric, ginger, and cinnamon in a small bowl. Pour over mixture on the pan. Cover tightly with foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 30 to 35 minutes, or until an instant-read thermometer inserted into thickest parts of chicken registers 170 degrees F (76 degrees C). Serve with couscous and garnish with almonds and mint."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

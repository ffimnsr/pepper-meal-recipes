  "id": "37098c13-4fe1-5808-80e6-bced08cfe41d",
  "slug": "basic-corn-muffins",
  "name": "Basic Corn Muffins",
  "recipe_type": "side",
  "brief_description": "This super-quick corn muffin recipe can easily be dressed up by adding shredded cheese, jalapenos, blueberries, or whatever add-ins you want to try!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a muffin pan or line with paper muffin liners."
    },
    {
      "position": 2,
      "text": "Mix cornmeal, flour, sugar, baking powder, and salt together in a large bowl, mix together"
    },
    {
      "position": 3,
      "text": "Add egg, oil, and milk; stir gently to combine."
    },
    {
      "position": 4,
      "text": "Spoon batter into prepared muffin cups."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into a muffin comes out clean, about 15 to 20 minutes."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

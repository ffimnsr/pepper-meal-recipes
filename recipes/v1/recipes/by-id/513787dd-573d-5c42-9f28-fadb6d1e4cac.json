  "schema_version": 1,
  "id": "513787dd-573d-5c42-9f28-fadb6d1e4cac",
  "slug": "beef-pot-roast",
  "name": "Beef Pot Roast",
  "recipe_type": "main",
  "brief_description": "Make chuck roast in the oven with this easy, one-pot recipe for the ultimate melt-in-your-mouth pot roast that cooks for 2 hours until fork-tender.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 3,
      "text": "Heat a Dutch oven or heavy pot over medium-high heat. Add oil, then sear meat in the center of the pan for 4 minutes. Turn meat over with tongs; sear for 3 to 4 minutes on each side. Remove meat from the pot."
    },
    {
      "position": 4,
      "text": "Arrange onion, garlic, and 1 bay leaf in the bottom of the pan; sprinkle with salt and pepper. Return meat to the pan, place remaining bay leaf on top of meat, and cover."
    },
    {
      "position": 5,
      "text": "Cook in the preheated oven for 30 minutes. Reduce heat to 300 degrees F (150 degrees C) and continue cooking until tender, about 1 \u00bd hours more. An instant-read thermometer inserted in the thickest part of the roast should read 145 degrees F (65 degrees C)."
    },
    {
      "position": 6,
      "text": "Transfer roast to a platter and let rest for 10 to 15 minutes. Slice and top with gravy."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "expert",

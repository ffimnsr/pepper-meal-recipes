  "slug": "awesome-slow-cooker-pot-roast",
  "name": "Awesome Slow Cooker Pot Roast",
  "recipe_type": "soup",
  "brief_description": "This Lipton onion soup pot roast made in a slow cooker simmers in a cream of mushroom soup gravy until tender for an easy, warm, and hearty dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix condensed soup, water, and dry onion soup mix in a slow cooker. Place pot roast in the slow cooker and coat with soup mixture."
    },
    {
      "position": 2,
      "text": "Cook on Low for 8 to 9 hours or High for 3 to 4 hours."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 180,

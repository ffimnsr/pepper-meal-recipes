  "slug": "instant-pot-quinoa-recipe-7494907",
  "name": "Instant Pot Quinoa",
  "recipe_type": "side",
  "brief_description": "This recipe for making quinoa in the Instant Pot is fast, healthy and easy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine quinoa and chicken broth in a 6-quart multi-functional pressure cooker (such as Instant Pot\u00ae). Close and lock the lid. Select high pressure according to manufacturer\u2019s instructions; set timer for 1 minute. (Yes, just 1 minute!) Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 3,
      "text": "Release pressure using the natural-release method according to manufacturer\u2019s instructions, about 15 minutes."
    },
    {
      "position": 4,
      "text": "Fluff with a fork. Serve and enjoy."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,

  "id": "c5706e1a-bb82-563f-a5c3-08eb3d8f0d72",
  "slug": "kafta",
  "name": "Kafta (BBQ)",
  "recipe_type": "main",
  "brief_description": "The yummiest preparation mixture for ground beef EVER! I have made this Lebanese meat for all of my friends and family and have HAD to leave the recipe with everyone! The mixture can be used for everything: meatballs, meatloaf, BBQ skewers, and hamburgers.",
  "cuisine": "Lebanese Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for high heat. If using wooden skewers, soak in water."
    },
    {
      "position": 2,
      "text": "In a large bowl, mix together the ground beef, onion, parsley, cayenne, allspice, salt and pepper until evenly blended. Divide into 6 portions, and press around one end of the skewers to form a log shape approximately 1 inch thick and 6 inches long."
    },
    {
      "position": 3,
      "text": "Grill for 10 to 15 minutes, turning occasionally, until meat is no longer pink."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "404cc925-9b1b-53bf-ba52-b4f9d70f09a1",
  "slug": "challah-i",
  "name": "Challah Bread",
  "recipe_type": "dessert",
  "brief_description": "This challah recipe makes a beautiful braided Jewish egg bread with yeast that's sweetened with honey and topped with poppy seeds.",
  "cuisine": "Kosher",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Pour warm water into a large bowl; sprinkle yeast over water. Let stand until yeast softens and begins to form a creamy foam, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Beat in honey, oil, 2 eggs, and salt. Add flour, 1 cup at a time, beating after each addition until dough has pulled together."
    },
    {
      "position": 4,
      "text": "Turn it out onto a lightly floured surface and knead until smooth and elastic."
    },
    {
      "position": 5,
      "text": "Place dough in a large, lightly-oiled bowl and turn to coat."
    },
    {
      "position": 6,
      "text": "Cover with a towel and let rise in a warm place until doubled in volume, about 1 \u00bd hours."
    },
    {
      "position": 7,
      "text": "Punch down dough and turn onto a lightly floured surface. Divide in half and knead each half for 5 minutes or so, adding flour as needed to keep it from getting sticky."
    },
    {
      "position": 8,
      "text": "Divide each half into thirds and roll into a long snake about 1 \u00bd inches in diameter."
    },
    {
      "position": 9,
      "text": "Pinch the ends of the three snakes together firmly and braid from middle. Either leave as a braid or form into a round braided loaf by bringing ends together, curving the braid into a circle, and pinching ends together."
    },
    {
      "position": 10,
      "text": "Grease two baking trays and place the finished braid or round on each. Cover with a towel and let rise for about 1 hour. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 11,
      "text": "Beat the remaining egg and brush a generous amount over each braid; sprinkle with poppy seeds."
    },
    {
      "position": 12,
      "text": "Bake in preheated oven until golden brown, about 40 minutes. Cool on a wire rack for at least one hour before slicing."
    },
    {
      "position": 13,
      "text": "Serve and enjoy!"
    }
  ],

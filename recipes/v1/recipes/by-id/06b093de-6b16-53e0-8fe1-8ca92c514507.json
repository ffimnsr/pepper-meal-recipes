  "id": "06b093de-6b16-53e0-8fe1-8ca92c514507",
  "slug": "sauteed-sweet-plantains-tajaditas-dulces-de-platano",
  "name": "Saut\u00e9ed Sweet Plantains (Tajaditas Dulces de Platano)",
  "recipe_type": "dessert",
  "brief_description": "Platanos or plantains are cooking bananas and are very popular in South America and the Caribbean. This easy dish adds a nice sweetness to any meal.",
  "cuisine": "Latin American",
  "instructions": [
    {
      "position": 1,
      "text": "Round up all your ingredients, and heat peanut oil and butter in a large skillet over medium-high heat until butter begins to sizzle."
    },
    {
      "position": 2,
      "text": "Gently toss plantain slices with brown sugar, then place into hot oil. Fry until plantains begin to turn golden brown, then turn over, and continue frying until caramelized, about 2 minutes per side."
    },
    {
      "position": 3,
      "text": "Drain plantains on a paper towel-lined plate and sprinkle with salt before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "d81304b5-601a-5a65-ab4e-5f56c77ac4da",
  "slug": "italian-biscotti",
  "name": "Italian Biscotti",
  "recipe_type": "dessert",
  "brief_description": "A traditional biscotti recipe. Great for dunking in coffee or tea.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F ( 165 degrees C )."
    },
    {
      "position": 2,
      "text": "In a large bowl, cream the butter and sugar together. Add eggs one at a time; beat until fluffy. Stir in the anise and vanilla extracts. Sift together the flour, baking powder, and salt; Add them to the egg mixture along with the chopped almonds. Stir with a spoon and as the dough comes together, Knead by hand."
    },
    {
      "position": 3,
      "text": "Divide the dough into 4 parts. Roll each piece into a log about 15 inches long. Place logs onto cookie sheets, 2 to a sheet, the long way. Flatten the logs out until they are about 3 inches wide with a slight hump going down the middle. Bake for 25 to 30 minutes in the preheated oven, loaves should be firm. Cut the loaves into diagonal slices 1/2 inch wide, place the slices onto the cookie sheets and return to the oven. Toast on one side, then turn them over to do the other side. This will take about 7 to 10 minutes."
    }
  ],
  "servings": 30,

  "id": "170d9189-e4ac-5c50-a304-3824589788da",
  "slug": "best-big-fat-chewy-chocolate-chip-cookie",
  "name": "Best Big, Fat, Chewy Chocolate Chip Cookie",
  "recipe_type": "dessert",
  "brief_description": "These chewy chocolate chip cookies are big, fat, and delicious. Make your own bakery-style, soft chocolate chip cookies with this easy recipe.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C). Grease cookie sheets or line with parchment paper."
    },
    {
      "position": 2,
      "text": "Sift flour, baking soda, and salt together; set aside."
    },
    {
      "position": 3,
      "text": "Beat brown sugar, melted butter, and white sugar with an electric mixer in a large bowl until smooth."
    },
    {
      "position": 4,
      "text": "Beat in egg, egg yolk, and vanilla until light and creamy; add flour mixture and stir until dough is just combined."
    },
    {
      "position": 5,
      "text": "Stir in chocolate chips."
    },
    {
      "position": 6,
      "text": "Drop spoonfuls of dough 3 inches apart onto the prepared baking sheets."
    },
    {
      "position": 7,
      "text": "Bake cookies in the preheated oven until edges are golden, about 15 to 17 minutes."
    },
    {
      "position": 8,
      "text": "Cool on the cookie sheets briefly before transferring them to a wire rack to cool completely."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

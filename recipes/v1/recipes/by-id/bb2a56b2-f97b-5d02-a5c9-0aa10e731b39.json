  "id": "bb2a56b2-f97b-5d02-a5c9-0aa10e731b39",
  "slug": "egg-free-brownies",
  "name": "Egg-Free Brownies",
  "recipe_type": "dessert",
  "brief_description": "Did you know you can make brownies without eggs? These chocolate brownies are a delicious treat and can be made vegan by using plant-based butter.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch pan."
    },
    {
      "position": 3,
      "text": "Combine water and 1/3 cup flour in a heavy saucepan over medium heat; cook, whisking constantly, until thick. Transfer mixture to a large mixing bowl and set aside to cool, 15 to 20 minutes."
    },
    {
      "position": 4,
      "text": "Melt butter in a small saucepan over medium heat. Mix in cocoa until smooth; remove from the heat and let cool, about 15 minutes."
    },
    {
      "position": 5,
      "text": "Combine remaining 2 cups flour, baking powder, and salt in a small bowl, set aside. Add sugar and vanilla to cooled flour-water mixture; mix with an electric mixer until well combined."
    },
    {
      "position": 6,
      "text": "Add cocoa mixture and mix until incorporated. Add dry flour mixture and stir until just blended; fold in walnuts."
    },
    {
      "position": 7,
      "text": "Spread evenly in the prepared pan."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 20 to 25 minutes. Cool before cutting into 20 squares."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,

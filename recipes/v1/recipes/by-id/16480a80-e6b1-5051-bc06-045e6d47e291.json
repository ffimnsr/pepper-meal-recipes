  "id": "16480a80-e6b1-5051-bc06-045e6d47e291",
  "slug": "copycat-dave-s-hot-chicken-sandwich-recipe-11947103",
  "name": "Copycat Dave\u2019s Hot Chicken Sandwich",
  "recipe_type": "main",
  "brief_description": "This copycat Dave's hot chicken sandwich brings the hot Nashville sandwich home. Marinated chicken is fried until crunchy, and seasoned liberally at every step. Serve it on a bun with sauce, coleslaw, and pickles.",
  "cuisine": "Southern Copycat",
  "instructions": [
    {
      "position": 1,
      "text": "For marinade, mix flour and water together in a large bowl to create a thick marinade. Season with onion powder, garlic powder, chili powder, smoked paprika, Old Bay, and honey. Add chicken pieces and coat thoroughly. Cover and refrigerate for 1 hour or overnight."
    },
    {
      "position": 2,
      "text": "For coating, combine flour, cornstarch, Old Bay, onion powder, garlic powder, smoked paprika, and chili powder in a separate bowl."
    },
    {
      "position": 3,
      "text": "Remove chicken from the marinade, letting excess drip off. Dredge each piece of chicken in the flour mixture until fully coated. Place on a wire rack and let rest for 5 minutes before frying."
    },
    {
      "position": 4,
      "text": "Heat oil in a deep fryer or skillet to 340 degrees F (171 degrees C). Fry chicken in batches for 8 to 10 minutes, until golden and an instant-read thermometer inserted near the center reads at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 5,
      "text": "For post-cooking seasoning, mix smoked paprika, chili powder, onion powder, brown sugar, and cayenne pepper together in a bowl."
    },
    {
      "position": 6,
      "text": "Divide seasoning mixture in half. Pour 1 cup hot oil into one half and stir. Dip each fried chicken piece into the oil-spice mixture, transfer to a plate, then sprinkle the remaining dry seasoning evenly over the top until fully coated."
    },
    {
      "position": 7,
      "text": "For sauce, mix mayonnaise, ketchup, honey mustard, and garlic powder together in a bowl until smooth."
    },
    {
      "position": 8,
      "text": "Toast buns lightly if desired. Spread sauce on both bun halves; add fried chicken, coleslaw, and pickles. Close and serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 60,

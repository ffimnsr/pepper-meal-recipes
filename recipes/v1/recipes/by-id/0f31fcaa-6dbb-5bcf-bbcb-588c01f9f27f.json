  "id": "0f31fcaa-6dbb-5bcf-bbcb-588c01f9f27f",
  "slug": "sheet-pan-chicken-pot-pie-recipe-11796924",
  "name": "Sheet Pan Chicken Pot Pie",
  "recipe_type": "main",
  "brief_description": "This sheet pan chicken pot pie is an easy dish to make with a puff pastry top, and creamy chicken and vegetables below, for a comforting dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat butter in a large deep skillet over medium heat. Add onion and celery and cook until tender, about 4 minutes"
    },
    {
      "position": 3,
      "text": "Sprinkle onion mixture with salt, pepper, and garlic powder and cook for 1 minute. Add flour and cook, stirring constantly, about 1 minute. Whisk in broth and cream and bring mixture to a simmer, stirring often. Cook, stirring occasionally, about 5 minutes. Mix in chicken and vegetables and cook 2 minutes. Adjust seasoning if necessary and remove from heat."
    },
    {
      "position": 4,
      "text": "Lightly grease a rimmed baking sheet. Pour chicken mixture into the prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Lighty roll pastry sheets to fit the baking sheet if needed. Lay pastry on top of baking sheet to cover chicken mixture."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown and bubbly, 25 to 30 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

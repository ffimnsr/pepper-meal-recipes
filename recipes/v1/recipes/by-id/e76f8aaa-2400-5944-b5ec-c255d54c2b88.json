  "id": "e76f8aaa-2400-5944-b5ec-c255d54c2b88",
  "slug": "cranberry-salad",
  "name": "Sweet and Creamy Cranberry Salad",
  "recipe_type": "salad",
  "brief_description": "This creamy cranberry fruit salad recipe is reminiscent of a Waldorf salad and contains cranberries, apples, marshmallows, nuts, and yogurt.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chopped cranberries and sugar in a large, nonreactive bowl. Toss well. Cover and refrigerate for 3 hours."
    },
    {
      "position": 2,
      "text": "After 3 hours, stir apples, marshmallows, and pecans into cranberries. Combine yogurt and whipped topping; fold into cranberry salad. Serve immediately."
    }
  ],

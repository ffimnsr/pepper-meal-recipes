  "id": "1cb4070d-05d3-532d-af8c-75ec9ded7cf2",
  "slug": "peach-and-blackberry-cobbler",
  "name": "Peach and Blackberry Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This peach and blackberry cobbler recipe makes a fruity dessert with a cakey texture. You'll taste sweet, juicy peaches and blackberries in every bite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix peaches, blackberries, 1/4 cup sugar, lemon juice, and cinnamon in a large bowl."
    },
    {
      "position": 3,
      "text": "Pour melted butter into a 9x13-inch glass baking dish, tilting to coat the bottom and sides evenly."
    },
    {
      "position": 4,
      "text": "Whisk flour, remaining 1 cup sugar, baking powder, and salt in another large bowl; mix in milk, stirring until just moist. Pour batter into the prepared baking dish; distribute fruit mixture evenly over batter."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown, about 45 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

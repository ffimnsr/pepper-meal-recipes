  "id": "4522c751-4ecc-501e-90ee-35b557b7b828",
  "slug": "chicken-chilaquiles-verdes",
  "name": "Chicken Chilaquiles Verdes",
  "recipe_type": "breakfast",
  "brief_description": "Chilaquiles verdes is a very delicious Mexican breakfast dish with fried tortillas and green salsa. This recipe includes chicken for a great weeknight dinner.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chicken breast, 1/2 of the salsa verde, chicken broth, onion, chili powder, cumin, cayenne, salt, and pepper in a slow cooker. Cook until chicken is cooked through on Low for 6 hours or High for 3 hours."
    },
    {
      "position": 2,
      "text": "Remove chicken from sauce and shred in a bowl with 2 forks. Return to the slow cooker and mix to combine with sauce."
    },
    {
      "position": 3,
      "text": "Place a large skillet over medium heat; add olive oil and heat until it starts to shimmer. Add tortilla triangles to the hot oil and cook, flipping every minute, until golden, about 8 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Add shredded chicken, slow cooker sauce, and remaining salsa verde to tortillas. Mix and heat until everything is warmed through."
    },
    {
      "position": 5,
      "text": "Meanwhile, stir sour cream and enough milk together so it can be drizzled."
    },
    {
      "position": 6,
      "text": "Remove tortilla mixture from the heat. Sprinkle cotija cheese on top and garnish with cilantro; drizzle with thinned sour cream mixture."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 370,
  "preparation_time_minutes": 15,

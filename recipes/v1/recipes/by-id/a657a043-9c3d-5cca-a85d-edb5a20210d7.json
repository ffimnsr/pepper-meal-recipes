  "id": "a657a043-9c3d-5cca-a85d-edb5a20210d7",
  "slug": "healthier-sloppy-joes-ii",
  "name": "Healthier Sloppy Joes",
  "recipe_type": "main",
  "brief_description": "For healthier Sloppy Joes that are loaded with flavor, just add two carrots and two cloves of garlic, then serve it up on a whole wheat bun.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Add beef, carrots, onion, bell pepper, and garlic; cook and stir until beef is browned and crumbly, about 10 minutes. Drain off liquids."
    },
    {
      "position": 2,
      "text": "Mix in ketchup, brown sugar, and mustard until thoroughly combined. Reduce the heat to low and simmer until sauce has thickened, about 30 minutes. Season with salt and pepper."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,

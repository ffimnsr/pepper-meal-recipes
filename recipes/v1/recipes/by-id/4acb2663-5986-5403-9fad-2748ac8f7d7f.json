  "id": "4acb2663-5986-5403-9fad-2748ac8f7d7f",
  "slug": "berry-nut-and-seed-crunch",
  "name": "Berry Nut and Seed Crunch",
  "recipe_type": "salad",
  "brief_description": "Glazed walnuts are tossed with dried cranberries and seeds for a hearty snack or crunchy addition to hot cereal or salads.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Heat brown sugar in a saucepan over medium-low heat until melted; stir in walnuts and sesame seeds until walnuts are coated with sugar and sesame seeds. Transfer coated walnuts to the prepared baking sheet; set aside until cooled."
    },
    {
      "position": 3,
      "text": "Mix coated walnuts, pumpkin seeds, sunflower seeds, and cranberries together in a bowl."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

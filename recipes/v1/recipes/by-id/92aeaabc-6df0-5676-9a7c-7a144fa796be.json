  "id": "92aeaabc-6df0-5676-9a7c-7a144fa796be",
  "slug": "red-fruity-pie",
  "name": "Red Fruity Pie",
  "recipe_type": "dessert",
  "brief_description": "A sweet and sour mix of cherries and raspberries topped with crunchy oats all within a delicate graham cracker crust.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "In a saucepan, combine the raspberries, cherries and sugar. Cook over medium heat until soft. Remove from the heat and set aside. In a separate bowl, mix together the oats, brown sugar, cinnamon and melted butter."
    },
    {
      "position": 3,
      "text": "Use a slotted spoon to spoon the fruit into the pie crust. Try not to add too much juice. Sprinkle the oat mixture over the top."
    },
    {
      "position": 4,
      "text": "Bake for 10 minutes in the preheated oven, or until oats are toasted and crisp."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

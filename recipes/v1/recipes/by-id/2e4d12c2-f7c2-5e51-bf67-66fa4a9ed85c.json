  "id": "2e4d12c2-f7c2-5e51-bf67-66fa4a9ed85c",
  "slug": "sushi-bake",
  "name": "Sushi Bake",
  "recipe_type": "appetizer",
  "brief_description": "This easy sushi bake recipe features imitation crab, shiitake mushrooms, furikake, and fish roe in casserole form. It\u2019s a guaranteed winner at any party.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Soak shiitake mushrooms in hot water until soft, 5 to 10 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, set an oven rack about 6 inches from the heat source and preheat the oven\u2019s broiler. Lightly grease a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 3,
      "text": "Spread rice in the prepared baking dish; sprinkle furikake evenly over the top."
    },
    {
      "position": 4,
      "text": "Drain mushrooms and squeeze out excess water. Mix mushrooms, imitation crabmeat, mayonnaise, sour cream, kamaboko, and tobiko together in a large bowl until well combined. Spread over furikake."
    },
    {
      "position": 5,
      "text": "Broil in the preheated oven until lightly browned on top, about 15 minutes. Remove from the oven and slice into 24 portions while in the baking dish."
    },
    {
      "position": 6,
      "text": "Spoon a generous portion onto a sheet of seasoned seaweed, wrap loosely, and enjoy immediately."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

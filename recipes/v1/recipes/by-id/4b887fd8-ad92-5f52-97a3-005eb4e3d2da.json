  "id": "4b887fd8-ad92-5f52-97a3-005eb4e3d2da",
  "slug": "fresh-fruit-tart-with-mascarpone",
  "name": "Fresh Fruit Tart with Mascarpone",
  "recipe_type": "dessert",
  "brief_description": "Golden tart crusts are filled with a cream cheese and mascarpone mixture before they're topped with fresh fruit and a citrusy, sweet glaze.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease 2 tart pans."
    },
    {
      "position": 2,
      "text": "Make crust: Blend together flour, butter, and sugar in a large bowl using an electric mixer until combined. Divide mixture evenly and press into the bottoms of the prepared tart pans."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden brown, 12 to 15 minutes. Let cool completely."
    },
    {
      "position": 4,
      "text": "While crusts are cooling, make filling: Beat together cream cheese, mascarpone cheese, sugar, vanilla, nutmeg, and cinnamon in a medium bowl using an electric mixer until light and fluffy. Spread mixture over cooled crusts."
    },
    {
      "position": 5,
      "text": "Add topping: Arrange strawberries, blackberries, and kiwis over filling in desired design."
    },
    {
      "position": 6,
      "text": "Make glaze: Mix together sugar and cornstarch in a small saucepan. Pour in water and lemon juice. Cook over medium heat until clear and thick, about 2 minutes. Let glaze cool completely."
    },
    {
      "position": 7,
      "text": "Glaze the entire top of each tart gently using a pastry brush."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

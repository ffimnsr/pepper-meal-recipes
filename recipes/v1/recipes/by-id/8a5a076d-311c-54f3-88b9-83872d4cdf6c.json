  "id": "8a5a076d-311c-54f3-88b9-83872d4cdf6c",
  "slug": "yeast-dumplings",
  "name": "Yeast Dumplings",
  "recipe_type": "soup",
  "brief_description": "An old-fashioned, heavier-style dumpling made with yeast, eggs, butter, sugar, and flour, this version will remind you of your grandmother's dumplings. It's perfect for chicken soup or chicken and biscuits.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place milk and butter in a small saucepan, and simmer over medium heat until butter melts. Remove from the heat and allow to cool."
    },
    {
      "position": 2,
      "text": "Dissolve the yeast in the warm water placed in a small bowl. Set aside."
    },
    {
      "position": 3,
      "text": "Combine the eggs, sugar, and salt in a large mixing bowl, and mix until thoroughly blended. Gradually stir in the flour, alternating with milk and yeast mixtures. Gather the dough into a ball. Cover the bowl with a cloth, and let the dough rest 20 minutes."
    },
    {
      "position": 4,
      "text": "Pour the chicken broth into a large pot. Bring broth to a boil over medium-high heat."
    },
    {
      "position": 5,
      "text": "Meanwhile, sprinkle flour over a clean board or countertop. Turn the dough out onto the board and knead lightly until smooth and satiny, about 3 minutes. Add a little more flour if the dough is sticky. Roll out the dough to be about 1/2 inch thick. Use a butter knife to cut dough into 2 inch wide strips, and place strips into the boiling broth. Dumplings will initially sink, then rise to the surface when cooked, about 10 minutes. Remove dumplings from the broth with a slotted spoon, and drain on a plate."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": 20,
  "difficulty": "medium",

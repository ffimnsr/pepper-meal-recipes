  "id": "2a023a44-6256-554b-b46e-8363184b3d78",
  "slug": "grilled-halloumi-with-herbed-berry-salsa",
  "name": "Grilled Halloumi with Herbed Berry Salsa",
  "recipe_type": "appetizer",
  "brief_description": "Fresh grilled halloumi is topped with a vibrant berry salsa made with blueberries, red currants, fresh herbs, and habanero for a sweet-spicy appetizer or light lunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place blueberries and red currants into a mixing bowl. Add 2 tablespoons mint, 2 tablespoons cilantro, marjoram, habanero, olive oil, agave syrup, and juice of 1 lime. Mix until combined and set aside."
    },
    {
      "position": 2,
      "text": "Heat a nonstick griddle over medium-high heat. Cook cashews until browned, stirring often to keep from burning, 8 to 10 minutes. Transfer cashews to a plate and set aside. Reduce heat to medium and brown halloumi cheese slices until golden brown, 2 to 3 minutes per side."
    },
    {
      "position": 3,
      "text": "Arrange halloumi slices on a serving plate, top with berry salsa mixture and remaining 1 tablespoon mint and cilantro. Chop cashews and spread on top of halloumi. Garnish with lime wedges from remaining lime. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "c1d03641-e72f-5aca-84b0-283b75c1c8c3",
  "slug": "simple-roasted-lamb-breast-recipe-8662926",
  "name": "Simple Roasted Lamb Breast",
  "recipe_type": "main",
  "brief_description": "This simple roasted lamb breast, bathed in a lightly seasoned oil and then slow-roasted, is tender, juicy, and flavorful.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Whisk olive oil, rosemary. parsley, paprika, garlic powder, salt, and pepper together in a small bowl."
    },
    {
      "position": 2,
      "text": "Place lamb breast in a roasting pan fat side up. Brush seasoned oil on all sides of the breast."
    },
    {
      "position": 3,
      "text": "Bake, covered, in the preheated oven until an instant-read thermometer inserted near the center reads 145 degrees F (63 degrees C), about 2 hours. Remove from the oven; let rest for 30 minutes. Cut each breast in half and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 10,
  "rest_time_minutes": 30,

  "id": "6777dd45-c7b0-5f6f-ad8c-375c32fd76e8",
  "slug": "old-fashioned-creamed-goldenrod-eggs-recipe-11901685",
  "name": "Old Fashioned Creamed Goldenrod Eggs",
  "recipe_type": "breakfast",
  "brief_description": "These old fashioned creamed goldenrod eggs are warm and creamy, served over toast, and finished with grated egg yolk, crispy bacon crumbles, and green onions.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut eggs in half and separate yolks from whites. Chop egg whites and set aside. Set yolk halves aside."
    },
    {
      "position": 2,
      "text": "Melt butter in a saucepan over medium-high heat. Whisk in flour and cook, stirring constantly, 1 minute. Whisk in milk and cream and bring mixture to a boil, stirring constantly. Reduce heat to a simmer. Add hot sauce and salt and pepper to taste. Simmer, stirring often, 3 to 5 minutes. Add chopped egg whites and cook until heated through."
    },
    {
      "position": 3,
      "text": "Divide creamed eggs over toast. Use a microplane to grate egg yolks evenly over the top or crumble finely with fingers over the top. Top with green onions, crumbled bacon, and more hot sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "965c5573-e666-5594-8e16-b1d068f803bf",
  "slug": "easy-cherry-brownies-recipe-11787233",
  "name": "Easy Cherry Brownies",
  "recipe_type": "dessert",
  "brief_description": "These easy cherry brownies are perfect for those times when you get a craving for chocolaty, fudge-y brownies, and you want them quick and easy. There are some fabulous brownie mixes out there, and when you add fresh cherries and nuts, you\u2019re in for a special treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line an 8x8-inch pan with parchment paper, leaving an overhang on two sides for easy removal, and spray with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine oil, water, egg, and vanilla extract in a large bowl. Stir in brownie mix until well combined. Gently fold in cherries and pecan nuts. Spread out batter evenly in the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, and the edges start to pull away from the sides of the pan, 44 to 48 minutes."
    },
    {
      "position": 4,
      "text": "Cool completely in the pan. Lift out of the pan using the parchment paper, cut, and serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

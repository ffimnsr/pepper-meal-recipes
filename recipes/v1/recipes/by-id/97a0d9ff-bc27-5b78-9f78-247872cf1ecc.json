  "id": "97a0d9ff-bc27-5b78-9f78-247872cf1ecc",
  "slug": "sheet-pan-chicken-tandoori-recipe-12034772",
  "name": "Sheet Pan Chicken Tandoori",
  "recipe_type": "main",
  "brief_description": "In this chicken tandoori a sheet pan is used instead of a traditional tandoor. Baking and broiling the chicken will result in golden brown chicken thighs with a rich caramelized flavor.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Remove and discard skin from chicken thighs. Cut several deep slits into each thigh and place chicken thighs in a resealable plastic bag set in a shallow dish."
    },
    {
      "position": 2,
      "text": "Whisk together yogurt, lime juice, 3 teaspoons Tandoori Masala Spice Mix, and the Kashmiri chili powder in a small bowl. Pour over chicken thighs. Seal bag and turn to coat."
    },
    {
      "position": 3,
      "text": "Marinate chicken in refrigerator for at least 1 hour or up to 24 hours."
    },
    {
      "position": 4,
      "text": "Preheat oven to 375 degrees Fahrenheit. Line a 13x18-inch rimmed sheet pan with foil. Remove chicken from marinade, discarding marinade. Arrange chicken on prepared pan. Season chicken with 1/4 teaspoon salt."
    },
    {
      "position": 5,
      "text": "In a large bowl, toss together potatoes, cauliflower, onion, oil, and remaining 1 teaspoon Tandoori Masala Spice Mix and 1/4 teaspoon salt. Add to pan, spreading evenly."
    },
    {
      "position": 6,
      "text": "Roast in the preheated oven until vegetables are tender and an instant-read thermometer inserted into thickest parts of chicken registers 175 degrees F (79 degrees C), 45 to 55 minutes."
    },
    {
      "position": 7,
      "text": "Set oven rack about 6 inches from heat source and preheat broiler. Broil chicken and veggies until lightly charred, turning halfway through, 4 to 6 minutes. Garnish with cilantro and serve with naan and/or rice."
    }
  ],
  "servings": 4,

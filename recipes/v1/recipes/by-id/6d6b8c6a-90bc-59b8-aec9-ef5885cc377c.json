  "id": "6d6b8c6a-90bc-59b8-aec9-ef5885cc377c",
  "slug": "georges-salmon-pepper-pate",
  "name": "George's Salmon-Pepper Pate",
  "recipe_type": "appetizer",
  "brief_description": "Turn leftover salmon into an easy pate that's blended with Greek yogurt and dill, chilled for an hour, and layered with pepper jelly over French bread.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Blend salmon, Greek yogurt, salt, and dill weed together in a food processor until creamy and smooth. Refrigerate pate until set, at least 1 hour."
    },
    {
      "position": 2,
      "text": "Butter each slice of bread and toast in the toaster oven, about 4 minutes. Spread salmon pate over bread; spread pepper jelly on top."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,

  "slug": "microwave-quesadilla",
  "name": "Microwave Quesadilla",
  "recipe_type": "appetizer",
  "brief_description": "Quesadillas cook great in the microwave and are the perfect dorm room snack or budget meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place 1 tortilla on a microwave-safe plate. Sprinkle cheese all over tortilla. Top with remaining tortilla."
    },
    {
      "position": 2,
      "text": "Microwave until cheese is melted, 30 to 45 seconds."
    }
  ],
  "servings": 2,

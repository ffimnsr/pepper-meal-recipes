  "slug": "easy-guacamole",
  "name": "Easy Guacamole",
  "recipe_type": "appetizer",
  "brief_description": "This easy guacamole recipe is quick to make and delicious to eat! Try it if you\u2019re learning how to make guac or simply need to whip up some to share.",
  "cuisine": "World",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mash avocado in a medium serving bowl."
    },
    {
      "position": 3,
      "text": "Stir in onion, tomato, and garlic."
    },
    {
      "position": 4,
      "text": "Season with lime juice and salt and pepper to taste."
    },
    {
      "position": 5,
      "text": "Cover and chill guacamole for 30 minutes to allow flavors to blend."
    }
  ],

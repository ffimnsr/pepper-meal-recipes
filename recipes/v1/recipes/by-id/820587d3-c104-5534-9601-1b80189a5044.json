  "id": "820587d3-c104-5534-9601-1b80189a5044",
  "slug": "jamaican-jerk-chicken",
  "name": "Jamaican Jerk Chicken",
  "recipe_type": "main",
  "brief_description": "This jerk chicken recipe features chunks of white meat marinated in fiery habanero and spices, then grilled until tender, perfect for summer parties.",
  "cuisine": "Jamaican Caribbean",
  "instructions": [
    {
      "position": 1,
      "text": "Place chicken in a medium bowl. Cover with water and lime juice. Set aside."
    },
    {
      "position": 2,
      "text": "Place oil, allspice, thyme, black pepper, salt, brown sugar, ginger, and nutmeg in a blender; blend until well combined. Add onions, green onions, habanero peppers, and garlic; blend until almost smooth."
    },
    {
      "position": 3,
      "text": "Pour most of the blended marinade mixture into the bowl with chicken, reserving a small amount to use as a basting sauce while cooking. Stir chicken until well coated. Cover the bowl and marinate in the refrigerator for at least 2 hours."
    },
    {
      "position": 4,
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate."
    },
    {
      "position": 5,
      "text": "Cook chicken slowly on the preheated grill, turning frequently and basting often with reserved marinade mixture, until no longer pink in the center and the juices run clear. An instant-read thermometer inserted into the center of chicken should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

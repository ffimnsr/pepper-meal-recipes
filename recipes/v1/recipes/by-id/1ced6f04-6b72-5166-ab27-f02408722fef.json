  "id": "1ced6f04-6b72-5166-ab27-f02408722fef",
  "slug": "chef-johns-mushroom-gravy",
  "name": "Chef John's Best Mushroom Gravy",
  "recipe_type": "side",
  "brief_description": "This rich mushroom gravy is made from scratch with mushrooms, beef stock, and thyme for a delicious gravy on mashed potatoes, meatloaf, or any roast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Heat butter in a saucepan over medium heat until it foams. Stir in mushrooms and season with salt. Simmer until liquid evaporates, about 20 minutes."
    },
    {
      "position": 3,
      "text": "Stir in flour; cook and stir for 5 minutes. Add 1 cup of beef stock, stirring briskly until incorporated, then pour in the remaining stock and mix thoroughly."
    },
    {
      "position": 4,
      "text": "Season with black pepper and thyme. Reduce heat to medium-low and simmer until thickened, stirring often, about 30 minutes."
    },
    {
      "position": 5,
      "text": "Serve and enjoy."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 5,

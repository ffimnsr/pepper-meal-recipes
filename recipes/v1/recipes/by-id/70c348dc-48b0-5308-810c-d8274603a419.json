  "id": "70c348dc-48b0-5308-810c-d8274603a419",
  "slug": "chef-johns-loco-moco",
  "name": "Chef John's Loco Moco",
  "recipe_type": "main",
  "brief_description": "This loco moco is Chef John's version of Hawaiian comfort food made with a juicy burger patty covered in gravy, topped with a fried egg over rice.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Season patties with salt, pepper, and cayenne; set aside."
    },
    {
      "position": 2,
      "text": "Whisk together beef stock, soy sauce, Worcestershire sauce, cornstarch, ketchup, sugar, and sesame oil in a bowl; set aside."
    },
    {
      "position": 3,
      "text": "Melt 1 teaspoon butter in a skillet over medium-high heat. Cook patties in the hot skillet until the bottoms are nicely browned, about 5 minutes. Flip patties; add green onions and cook until both beef and onions are browned, 4 to 5 minutes. Remove patties and most of green onions to a plate."
    },
    {
      "position": 4,
      "text": "Pour beef stock mixture into the skillet. Stir, scraping up browned bits from the bottom, until thickened, about 2 minutes. Reduce heat to low and reserve gravy until needed."
    },
    {
      "position": 5,
      "text": "Melt remaining butter in another skillet over medium heat. Add eggs to the skillet and fry side-by-side until whites are set and yolks are still runny."
    },
    {
      "position": 6,
      "text": "Divide rice between 2 serving bowls. Place patties over rice, spoon gravy on top, and add fried eggs."
    },
    {
      "position": 7,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

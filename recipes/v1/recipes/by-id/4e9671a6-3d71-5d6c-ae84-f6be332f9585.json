  "name": "Cheesy Ramen Noodles",
  "recipe_type": "main",
  "brief_description": "Melting cheese in ramen makes a quick and delicious cheap meal with instant ramen noodles and American cheese when you're on a budget.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring water to a boil in a saucepan. Add ramen noodles and cook until tender, about 2 minutes."
    },
    {
      "position": 3,
      "text": "Pour out water, then stir in seasoning packet and cheese until well blended."
    }

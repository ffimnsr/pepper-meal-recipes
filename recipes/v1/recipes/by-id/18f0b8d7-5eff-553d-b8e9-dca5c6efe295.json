{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "18f0b8d7-5eff-553d-b8e9-dca5c6efe295",
  "slug": "butternut-vegetable-soup",
  "name": "Butternut Vegetable Soup",
  "recipe_type": "soup",
  "brief_description": "A thick, creamy butternut and bean soup is loaded with colorful, tasty vegetables - potatoes, onion, carrots, and and kale. Serve with crusty bread.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat vegetable oil in a large Dutch oven over medium heat. Add onion and garlic; cook and stir until onion softened and translucent, about 5 minutes. Add butternut squash and carrots; cook and stir until squash begins to brown, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Stir in broth, red potatoes, salt, pepper, and thyme; bring to a boil. Reduce heat and simmer until vegetables tender, about 45 minutes. Stir in kale and great Northern beans; simmer until kale is tender, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Add 3 cups soup to a blender, filled no more than halfway (you may have to do this in two batches). Cover and hold down lid with a folded kitchen towel, pulse a few times before leaving on to pur\u00e9e. Return pur\u00e9ed soup to Dutch oven, leave remaining soup chunky. Alternately, you can use an immersion blender and partially pur\u00e9e soup in the Dutch oven."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "52270cbf-62a5-5ce9-9c8c-802f2f176c98",
  "slug": "4-ingredient-creamy-tomato-soup-for-two-recipe-8735178",
  "name": "4-Ingredient Creamy Tomato Soup for Two",
  "recipe_type": "soup",
  "brief_description": "This 4-ingredient creamy tomato soup for two blends roasted onion with canned tomatoes and cream. It could not be any tastier.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Roughly quarter the onion half, and separate the pieces. Place onion pieces on a baking tray. Open the can of diced tomatoes. Carefully drizzle some of the liquid onto the onion."
    },
    {
      "position": 3,
      "text": "Roast onions in the preheated oven until soft, about 25 minutes. Place onions and tomatoes in a high-powered blender, such as a Vitamix. Cover tightly and blend on high for 40 seconds."
    },
    {
      "position": 4,
      "text": "Melt butter in a saucepan over medium heat. Carefully pour in the tomato mixture, and cook, stirring occasionally until hot, about 3 minutes. Stir in 3 tablespoons cream."
    },
    {
      "position": 5,
      "text": "Ladle soup into bowls, and drizzle remaining cream over each serving."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

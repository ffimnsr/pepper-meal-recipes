  "id": "5f46f8ac-a246-5da1-b7a0-0c07a801568f",
  "slug": "tuna-tomato-noodle-casserole",
  "name": "Tuna-Tomato Noodle Casserole",
  "recipe_type": "soup",
  "brief_description": "Chili powder and Worcestershire give eye-opening flavor to an easy tomato soup and Cheddar cheese sauce. Combine with tuna, sauteed onions and cooked noodles, then bake with a sprinkling of Cheddar cheese over the top.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Cook noodles in a pot of boiling water until done. Drain."
    },
    {
      "position": 2,
      "text": "In a large skillet, saute onion in oil. Add undiluted soup, chili powder, salt, and Worcestershire sauce. Simmer 5 minutes. Mix in noodles, 1 cup cheese, and tuna. Spoon into a greased 1 quart casserole dish."
    },
    {
      "position": 3,
      "text": "Bake at 350 degrees F (175 degrees C) for 30 minutes. While still hot, sprinkle with remaining 1/4 cup cheese."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

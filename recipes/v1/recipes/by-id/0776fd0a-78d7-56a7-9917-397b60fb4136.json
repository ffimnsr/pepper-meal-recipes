  "id": "0776fd0a-78d7-56a7-9917-397b60fb4136",
  "slug": "hearty-multigrain-seeded-bread",
  "name": "Hearty Multigrain Seeded Bread",
  "recipe_type": "breakfast",
  "brief_description": "This bread with hemp seeds is made with whole wheat flour, millet, flax, chia, and oats for a delicious, light, textured loaf perfect for sandwiches.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix together warm water and sugar in a small bowl until sugar is dissolved; stir in yeast. Set aside until a creamy foam starts to form, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Combine bread flour, whole wheat flour, coconut oil, and salt in a food processor; pulse 4 times. Add chia seeds, wheat germ, flax seeds, millet, 1 tablespoon hemp seeds, 1 tablespoon sunflower seeds, and 1 tablespoon oats; pulse until incorporated."
    },
    {
      "position": 3,
      "text": "Pour yeast mixture over flour mixture in the food processor; process until a dough ball forms, about 1 minute."
    },
    {
      "position": 4,
      "text": "Turn dough into a well-oiled large bowl and cover with a damp towel; allow to rise in a warm area until doubled in size, about 1 hour."
    },
    {
      "position": 5,
      "text": "Punch dough down and knead a few times. Form dough into an oblong shape and place in a greased loaf pan. Lightly press remaining 1 tablespoon hemp seeds, 1 tablespoon sunflower seeds, and 1 tablespoon oats onto the top of loaf. Cover with a damp towel and let rise in a warm area for 30 minutes."
    },
    {
      "position": 6,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until cooked through and crust is lightly browned, about 30 minutes. Cool bread in the pan for 5 minutes before transferring to a wire rack to cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

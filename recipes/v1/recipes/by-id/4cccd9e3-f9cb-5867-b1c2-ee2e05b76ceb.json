  "id": "4cccd9e3-f9cb-5867-b1c2-ee2e05b76ceb",
  "slug": "spicy-ground-beef-cabbage-wraps-with-peanut-sauce",
  "name": "Spicy Ground Beef Cabbage Wraps with Peanut Sauce",
  "recipe_type": "appetizer",
  "brief_description": "An Asian-inspired ground beef filling is wrapped in cabbage with a spicy, creamy peanut sauce in this easy recipe that's perfect as an appetizer or main dish.",
  "cuisine": "Asian Inspired American Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk peanut butter, soy sauce, sambal oelek, rice vinegar, ginger, garlic, and red pepper flakes for sauce together in a small bowl. Whisk in small amount of water slowly until well combined and you reach your desired consistency. Set aside."
    },
    {
      "position": 2,
      "text": "Heat a medium skillet over medium heat. Brown the ground beef, green onions, and garlic for about 5 minutes. Stir in rice vinegar, sambal oelek, cardamom, ginger, cinnamon, salt, and pepper. Reduce heat and simmer for 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Divide the ground beef mixture evenly among the 12 cabbage leaves. Top each with a dollop of the peanut sauce, a squeeze of a lime wedge, and sprinkle with peanuts. Fold up the sides of the leaves and serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

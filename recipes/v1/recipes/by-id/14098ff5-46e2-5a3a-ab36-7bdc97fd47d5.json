  "id": "14098ff5-46e2-5a3a-ab36-7bdc97fd47d5",
  "slug": "coconut-cream-pie-dirty-soda-recipe-11989375",
  "name": "Coconut Cream Pie Dirty Soda",
  "recipe_type": "dessert",
  "brief_description": "Chef John's coconut cream pie dirty soda turns the beloved dessert into a creamy, fizzy drink packed with rich coconut flavor. Made with homemade toasted coconut syrup, cream soda, and a splash of half-and-half, this refreshing treat is finished with whipped cream and toasted coconut for a sip that tastes just like a slice of coconut cream pie.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Toast coconut flakes in a saucepan over medium heat until lightly golden brown. Add water and sugar, stir to combine, and bring to a simmer. Reduce heat to medium-low, and simmer for 20 to 25 minutes."
    },
    {
      "position": 2,
      "text": "Remove from heat and allow coconut mixture to cool for about 15 minutes. Strain through a fine mesh strainer into a bowl. Add coconut extract, and a very small pinch of salt. Transfer coconut cream pie syrup into a smaller container, and store in the fridge until needed."
    },
    {
      "position": 3,
      "text": "To make each dirty soda, fill a glass with ice. Pour in 4 ounces of cream soda. Fill the glass the rest of the way with sparkling water, leaving a half inch unfilled at the top. Pour in 3 to 4 tablespoons of the coconut cream pie syrup, and stir everything with a spoon for a few seconds. Top off with a splash of half and half, Garnish with a dollop of whipped cream and toasted coconut flakes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,

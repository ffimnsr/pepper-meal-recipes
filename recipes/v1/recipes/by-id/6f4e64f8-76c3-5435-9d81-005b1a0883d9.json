  "id": "6f4e64f8-76c3-5435-9d81-005b1a0883d9",
  "slug": "cast-iron-pork-chops-recipe-7643514",
  "name": "Cast Iron Pork Chops - The Secret to the Best Pork Chops Is Your Cast Iron Skillet",
  "recipe_type": "main",
  "brief_description": "These cast iron pork chops only need a few ingredients to come out perfectly. Serve with potatoes and vegetables for a whole meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Take chops out of the refrigerator and let stand at room temperature for 30 minutes before cooking."
    },
    {
      "position": 2,
      "text": "If there is a fat cap on the sides of the chops, make a few vertical slits through them, so the chops will not curl as they cook."
    },
    {
      "position": 3,
      "text": "Blot chops dry with paper towels, and sprinkle both sides with salt and pepper."
    },
    {
      "position": 4,
      "text": "Heat a 12-inch cast iron skillet over medium-high heat for 3 minutes. Add oil. Add chops and cook 2 minutes. Turn and cook 2 minutes more."
    },
    {
      "position": 5,
      "text": "Add butter and garlic to the skillet."
    },
    {
      "position": 6,
      "text": "Place rosemary sprigs atop each chop. Tilt skillet to allow melted butter and oil to pool on one side."
    },
    {
      "position": 7,
      "text": "Spoon butter and garlic mixture over chops occasionally while cooking 2 minutes. Remove rosemary, turn chops, replace rosemary and cook, basting chops occasionally, cooking 2 to 3 minutes more or until chops are 140 degrees F (60 degrees C) in the center when tested with an instant-read thermometer."
    },
    {
      "position": 8,
      "text": "Remove chops from skillet and place on a cutting board or serving platter."
    },
    {
      "position": 9,
      "text": "Tent with foil and let stand 5 minutes before serving. Temperature will rise to 145 degrees F (62 degrees C) upon standing."
    },
    {
      "position": 10,
      "text": "Garnish with chopped rosemary."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

  "slug": "ground-beef-and-potato-tostadas",
  "name": "Ground Beef and Potato Tostadas",
  "recipe_type": "main",
  "brief_description": "Tostadas are a great quick meal for the whole family. Adding potato to ground beef makes the tostadas more filling.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Crumble beef in a large skillet and cook over medium-high heat until the fat has started to render, about 2 minutes. Stir in potatoes and cook for 10 minutes. Stir in taco seasoning and cook for 2 minutes more."
    },
    {
      "position": 2,
      "text": "Divide beef mixture, lettuce, olives, and Mexican cheese blend among the tostada shells."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,

  "id": "2fc5898d-d658-504b-9a89-276d0ddc0d50",
  "slug": "sarahs-applesauce",
  "name": "Sarah's Homemade Applesauce",
  "recipe_type": "dessert",
  "brief_description": "This applesauce recipe is easy to make from scratch with apples, sugar, and cinnamon for a delicious topping on pancakes, ice cream, or pork chops.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine apples, water, sugar, and cinnamon in a saucepan; cover and cook over medium heat until apples are soft, stirring occasionally, 15 to 20 minutes."
    },
    {
      "position": 3,
      "text": "Allow apple mixture to cool, then mash with a fork or potato masher until reaches desired consistency."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,

  "id": "f51775ba-2cb3-5903-bda3-7c6667b68bde",
  "slug": "quinoa-tabbouleh",
  "name": "Quinoa Tabbouleh",
  "recipe_type": "salad",
  "brief_description": "Quinoa tabbouleh made with tender quinoa grains, tomatoes, cucumber, carrots, green onions and parsley is a delicious and refreshing summer salad.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water to a boil in a medium saucepan; add quinoa and a pinch of salt. Reduce heat to low, cover and simmer for 15 minutes. Allow to cool to room temperature; fluff with a fork."
    },
    {
      "position": 2,
      "text": "Meanwhile, combine olive oil, sea salt, lemon juice, tomatoes, cucumber, green onions, carrots, and parsley in a large bowl; stir in cooled quinoa."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

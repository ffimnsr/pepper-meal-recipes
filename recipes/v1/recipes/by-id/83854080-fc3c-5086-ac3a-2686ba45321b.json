  "id": "83854080-fc3c-5086-ac3a-2686ba45321b",
  "slug": "my-moms-sausage-and-rice-casserole",
  "name": "My Mom's Sausage and Rice Casserole",
  "recipe_type": "soup",
  "brief_description": "A delicious sausage and rice casserole with almonds, onions, peppers and dry chicken noodle soup mix. Try it! You'll like it!",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "In a Dutch-oven over medium heat, brown the sausage with the onion, celery and bell pepper; drain. Pour in rice, hot water, and soup mix. Stir until any lumps of soup have melted. Top with almonds. Cover and bake in a preheated oven for 1 1/2 hours."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 90,

  "id": "8661f906-571c-5b11-b976-8a02243eb1cc",
  "slug": "quick-super-delicious-zuppa-toscana",
  "name": "Quick Super-Delicious Zuppa Toscana",
  "recipe_type": "soup",
  "brief_description": "If you love the Zuppa Toscana at your local Olive Garden\u00ae, you'll love this recipe for rich soup packed with Italian sausage, potatoes, and kale.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook and stir Italian sausage and red pepper flakes in a Dutch oven over medium-high heat until sausage is browned and crumbly, 10 to 15 minutes. Transfer sausage mixture to a bowl."
    },
    {
      "position": 2,
      "text": "Stir bacon into the same Dutch oven and cook over medium heat until bacon is crisp, about 10 minutes. Drain fat, leaving a few tablespoons of drippings in the Dutch oven."
    },
    {
      "position": 3,
      "text": "Stir onion and garlic into bacon; cook and stir until onions are soft and translucent, about 5 minutes. Pour chicken broth into bacon mixture; bring to a boil. Stir potatoes and kale into broth; cook until potatoes are tender and soup is flavorful, about 15 minutes."
    },
    {
      "position": 4,
      "text": "Stir sausage and heavy whipping cream into soup, reduce heat to medium, and cook until soup is heated through, about 5 minutes more."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "83f44d46-2161-585c-8e64-3b53d04d121e",
  "slug": "air-fryer-egg-rolls",
  "name": "Air Fryer Egg Rolls",
  "recipe_type": "appetizer",
  "brief_description": "Avoid deep-frying by cooking these Southwestern egg rolls in an air fryer and achieving the same crispiness!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix corn, beans, spinach, jalapeno Jack cheese, Cheddar cheese, green chiles, green onions, salt, cumin, and chili powder together in a large bowl for the filling."
    },
    {
      "position": 2,
      "text": "Lay an egg roll wrapper at an angle. Use your finger to lightly moisten all 4 edges with water. Place about 1/4 cup of the filling in the center of the wrapper. Fold 1 corner over filling and tuck in the sides to form a roll. Repeat with remaining wrappers and mist each egg roll with cooking spray."
    },
    {
      "position": 3,
      "text": "Preheat an air fryer to 390 degrees F (199 degrees C). Place egg rolls in the basket, making sure they are not touching; cook in batches if necessary. Fry for 8 minutes; flip and cook until skins are crispy, about 4 minutes more."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

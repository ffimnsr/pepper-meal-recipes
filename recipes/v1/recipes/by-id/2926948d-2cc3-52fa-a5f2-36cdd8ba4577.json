  "id": "2926948d-2cc3-52fa-a5f2-36cdd8ba4577",
  "slug": "gruyere-and-prosciutto-breakfast-casserole-recipe-11806244",
  "name": "Gruyere and Prosciutto Breakfast Casserole",
  "recipe_type": "breakfast",
  "brief_description": "In this Gruyere and prosciutto breakfast casserole, everything bagel seasoning adds elegant flavor without adding effort. It's a great use for leftover ciabatta rolls.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Lightly spray a medium-sized casserole dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Line the bottom of the casserole dish with bread cubes. Sprinkle 1 teaspoon everything seasoning over bread cubes; distribute shallot and prosciutto evenly over bread."
    },
    {
      "position": 3,
      "text": "Whisk eggs, cream, milk and about 3/4 cup Gruyere cheese in a bowl; season with salt and pepper."
    },
    {
      "position": 4,
      "text": "Pour egg mixture over the casserole. Spread evenly to cover all the bread. Sprinkle with remaining Gruyere and everything seasoning."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the top begins to brown, 20 to 30 minutes. Let stand for 5 minutes before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

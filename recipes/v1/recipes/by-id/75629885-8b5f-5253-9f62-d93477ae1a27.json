{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "75629885-8b5f-5253-9f62-d93477ae1a27",
  "slug": "herb-crusted-rack-of-lamb",
  "name": "Herb-Crusted Rack of Lamb",
  "recipe_type": "main",
  "brief_description": "This Dijon mustard and herb-crusted rack of lamb is easy to prepare and impressive enough to serve for a special occasion or for Easter dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients."
    },
    {
      "position": 2,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line a rimmed baking sheet with foil and place a wire rack on top."
    },
    {
      "position": 3,
      "text": "Combine bread crumbs, parsley, 1 tablespoon olive oil, garlic, mint, rosemary, 1/4 teaspoon salt, and lemon zest in the bowl of a food processor. Process until well combined, about 45 seconds. Transfer to a shallow dish and set aside."
    },
    {
      "position": 4,
      "text": "Heat remaining 2 tablespoons olive oil in a large cast iron skillet over medium-high. Pat lamb dry with paper towels. Season with black pepper and remaining 1/2 teaspoon salt."
    },
    {
      "position": 5,
      "text": "Add lamb to skillet and cook until browned on all sides, 4 to 5 minutes total."
    },
    {
      "position": 6,
      "text": "Brush the lamb with mustard, then dip and roll into prepared bread crumb mixture to coat, pressing gently to adhere."
    },
    {
      "position": 7,
      "text": "Place lamb on the prepared rack, meat side up, with the bones pointed towards the middle of the rack."
    },
    {
      "position": 8,
      "text": "Roast in the preheated oven until an instant-read thermometer registers 125 degrees F (52 degrees C) for medium-rare, about 20 minutes, or to desired degree of doneness. Tent loosely with foil and let rest for 10 minutes before slicing in between the bones. Serve immediately."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": 10,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "fafa8c3b-48c1-5cac-89f7-c916690a6a96",
  "slug": "peanut-butter-snickerdoodles",
  "name": "Peanut Butter Snickerdoodles",
  "recipe_type": "dessert",
  "brief_description": "Combine the best of both worlds with these peanut butter cookies rolled in cinnamon sugar like snickerdoodles are.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine peanut butter, 1 cup white sugar, brown sugar, butter, and shortening in a large bowl. Beat with an electric mixer until creamy. Stir in vanilla extract. Beat in eggs."
    },
    {
      "position": 3,
      "text": "Sift flour, cream of tartar, 1 1/2 teaspoons cinnamon, baking soda, baking powder, and salt together in a separate bowl. Gradually add to the egg mixture and mix well."
    },
    {
      "position": 4,
      "text": "Mix 1/4 cup sugar and 2 teaspoons cinnamon together in a shallow bowl. Roll dough into 1-inch balls, roll in cinnamon-sugar, and place on a baking sheet. Flatten each ball slightly with the bottom of a drinking glass, or by making a criss-cross pattern with the tines of a fork."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until slightly browned, about 8 minutes. Do not overbake. Transfer to a wire rack to cool."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 8,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

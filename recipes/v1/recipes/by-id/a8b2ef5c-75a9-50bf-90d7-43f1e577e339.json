  "id": "a8b2ef5c-75a9-50bf-90d7-43f1e577e339",
  "slug": "awesome-red-wine-pot-roast",
  "name": "Awesome Red Wine Pot Roast",
  "recipe_type": "main",
  "brief_description": "This awesome red wine pot roast recipe slow cooks beef chuck roast in the oven with red wine, basil, marjoram, thyme, potatoes, carrots, and onions.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Evenly sprinkle roast with flour; set aside. Heat canola oil in an oven-proof Dutch oven over medium-high heat. Add roast; brown on all sides, about 10 minutes total. Off heat, pour in water and wine; season with basil, salt, marjoram, thyme, and black pepper. Arrange onion slices on top roast."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven, covered, for 3 hours. Add pearl onions, potatoes, and carrots. Add additional water if roast looks dry. Continue baking, covered, until roast easily pulls apart with a fork, about 1 hour more."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 255,

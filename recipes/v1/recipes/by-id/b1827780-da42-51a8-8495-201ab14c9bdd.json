  "id": "b1827780-da42-51a8-8495-201ab14c9bdd",
  "slug": "mushroom-cheddar-soup-recipe-11816690",
  "name": "Mushroom Cheddar Soup",
  "recipe_type": "appetizer",
  "brief_description": "This mushroom Cheddar soup, comforting and hearty, is a full-flavored mix of earthy mushrooms and luscious cheeses. It\u2019s deliciously rich and creamy, and is just as good for dinner parties as it is for busy weeknight dinners all year round.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large saucepan over medium heat. Add mushrooms and shallots, and saute until mushrooms have softened, 3 to 5 minutes. Stir in garlic, and cook for about 30 seconds."
    },
    {
      "position": 2,
      "text": "Add flour and stir constantly for about 2 minutes. Gradually pour in chicken broth, half-and-half, and sherry. Bring to a simmer, stirring often."
    },
    {
      "position": 3,
      "text": "Reduce heat to low, stirring occasionally until soup starts to slightly thicken, about 10 minutes. Add Cheddar and Boursin, and stir just until cheese has melted. Season with salt and pepper."
    },
    {
      "position": 4,
      "text": "Sprinkle with parsley to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

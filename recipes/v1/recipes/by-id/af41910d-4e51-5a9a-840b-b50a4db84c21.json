  "id": "af41910d-4e51-5a9a-840b-b50a4db84c21",
  "slug": "sauteed-shrimp-over-polenta",
  "name": "Sauteed Shrimp over Polenta",
  "recipe_type": "side",
  "brief_description": "Sauteed shrimp mingles with red peppers, plum tomatoes, and onion over a bed of creamy polenta in this easy weeknight dinner recipe.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat 2 cups chicken stock and half-and-half until nearly boiling. Add polenta and stir constantly until no clumps remain, 3 to 4 minutes. Reduce heat and simmer until tender and thickened, 20 to 30 minutes. Add additional stock or water if polenta is too thick."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over medium-high heat. Add tomatoes, bell pepper, onion, and garlic. Saute for 3 to 5 minutes. Add 1/2 cup chicken stock, oregano, thyme, and ancho chile powder. Simmer until vegetables reach desired texture, 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, stir Parmesan cheese into the polenta. Add shrimp to the vegetable mixture; cook until pink and heated through, 3 to 5 minutes more. Spoon polenta onto serving plates and top with shrimp mixture."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

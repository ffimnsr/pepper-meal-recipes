  "schema_version": 1,
  "id": "3f9d5a4d-1add-5611-84e2-1b93bb64bea4",
  "slug": "two-ingredient-pizza-dough",
  "name": "Two-Ingredient Pizza Dough",
  "recipe_type": "main",
  "brief_description": "This 2-ingredient pizza dough is super simple to make with just self-rising flour and Greek yogurt for a tender, crisp crust in less than 30 minutes.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 500 degrees F (260 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix flour and Greek yogurt together in a bowl to form a dough; transfer to a work surface floured with self-rising flour."
    },
    {
      "position": 3,
      "text": "Knead dough, adding more flour as needed to keep dough from being too sticky, about 8 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Spray a 12-inch pizza pan with cooking spray and spread dough to the edges of the pan."
    },
    {
      "position": 5,
      "text": "Bake pizza crust in preheated oven for 5 to 7 minutes; add your favorite toppings and return to the preheated oven."
    },
    {
      "position": 6,
      "text": "Bake until crust is lightly browned, 5 to 7 minutes more."
    },
    {
      "position": 7,
      "text": "Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

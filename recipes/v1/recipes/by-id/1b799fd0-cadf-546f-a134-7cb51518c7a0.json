  "id": "1b799fd0-cadf-546f-a134-7cb51518c7a0",
  "slug": "vegetarian-borscht",
  "name": "Vegetarian Borscht",
  "recipe_type": "soup",
  "brief_description": "This vegetarian borscht recipe is a rustic, hearty classic Eastern European dish originating from Ukraine made with earthy beets, potatoes, and lentils.",
  "cuisine": "Ukrainian American Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Combine beets and vinegar in a small skillet over low heat: cook and stir until soft, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat oil in a large skillet over low heat. Add onion; cook and stir for 2 minutes. Add carrots; cook, stirring occasionally, until soft, about 10 minutes. Set aside."
    },
    {
      "position": 3,
      "text": "Bring water to a simmer in a large saucepan. Add lentils and cabbage; cook 10 minutes. Add potatoes; cook 10 minutes more. Stir in beets and onion mixture; season with salt and black pepper."
    },
    {
      "position": 4,
      "text": "Add tomato paste; simmer until vegetables are tender, about 10 minutes. Serve soup with sour cream and dill."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

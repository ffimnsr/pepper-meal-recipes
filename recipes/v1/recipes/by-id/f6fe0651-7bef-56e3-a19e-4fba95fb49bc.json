  "id": "f6fe0651-7bef-56e3-a19e-4fba95fb49bc",
  "slug": "sloppy-joe-sandwiches",
  "name": "Sloppy Joe Sandwiches",
  "recipe_type": "dessert",
  "brief_description": "This sloppy joe recipe is quick and inexpensive. In addition to putting it on rolls, try this slightly sweet beef mixture over rice, biscuits, or baked potatoes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat and stir in ground beef and onion. Cook and stir until beef is crumbly, evenly browned, and no longer pink, about 10 minutes. Drain and discard any excess grease. Stir in ketchup, water, brown sugar, Worcestershire sauce, mustard, vinegar, chili powder, garlic powder, onion powder, and salt."
    },
    {
      "position": 2,
      "text": "Bring beef mixture to a boil over high heat. Reduce heat to low; cover and simmer until sauce has thickened, 30 to 40 minutes. Serve on buns."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 5,

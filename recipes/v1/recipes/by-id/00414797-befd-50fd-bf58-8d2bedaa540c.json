  "id": "00414797-befd-50fd-bf58-8d2bedaa540c",
  "slug": "quinoa-with-veggies",
  "name": "Quinoa with Veggies",
  "recipe_type": "side",
  "brief_description": "I love quinoa and I wanted to make something that was flavorful and filling. The vegetables can be changed to your liking!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water, quinoa, and 1 pinch salt to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until quinoa tender, about 20 minutes. Drain in mesh strainer; set aside"
    },
    {
      "position": 2,
      "text": "Meanwhile, heat olive oil in a saucepan over medium heat. Stir in garlic; cook until softens and aroma mellows, about 2 minutes. Add bell pepper and corn; cook until pepper softens, about 5 minutes. Season with oregano, cumin, salt, and black pepper; cook 1 minute more, then stir in cooked quinoa and green onions. Serve hot or cold."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

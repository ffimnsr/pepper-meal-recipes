  "id": "bbe7b6a8-a79a-5a91-a5bc-c5d57893f3a5",
  "slug": "oven-fries",
  "name": "Oven Fries",
  "recipe_type": "side",
  "brief_description": "Couldn't be simpler or more tasty. Cut potatoes are coated with oil, sugar, salt and red pepper flakes, and then baked. They emerge crusty and nippy on the outside and all potato on the inside.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 450 degrees F (230 degrees C). Line a baking sheet with foil, and coat well with vegetable cooking spray. Scrub potatoes well and cut into 1/2 inch thick fries."
    },
    {
      "position": 2,
      "text": "In a large mixing bowl, toss potatoes with oil, sugar, salt and red pepper. Spread on baking sheet in one layer."
    },
    {
      "position": 3,
      "text": "Bake for 30 minutes in the preheated oven, until potatoes are tender and browned. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,

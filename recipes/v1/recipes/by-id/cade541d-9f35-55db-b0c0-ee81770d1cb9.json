  "id": "cade541d-9f35-55db-b0c0-ee81770d1cb9",
  "slug": "easy-cajun-jambalaya",
  "name": "Easy Cajun Jambalaya",
  "recipe_type": "soup",
  "brief_description": "Chicken breast and kielbasa are sauteed with green pepper, onion celery and garlic, then stewed with chicken stock and rice. This version is lightly spiced, in response to those a little more sensitive to pepper.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large pot over medium-high heat. Add chicken and kielbasa; saut\u00e9 until lightly browned, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir in onion, bell pepper, celery, and garlic. Season with cayenne, onion powder, salt, and pepper; cook and stir until onion is tender and translucent, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Add rice and stir in chicken stock and bay leaves. Bring to a boil; reduce heat, cover, and simmer for 20 minutes, or until rice is tender. Stir in Worcestershire sauce and hot pepper sauce."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

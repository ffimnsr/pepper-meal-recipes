  "id": "04fd4e22-9454-5382-8ed7-299fb69612a4",
  "slug": "my-best-clam-chowder",
  "name": "My Best Clam Chowder",
  "recipe_type": "soup",
  "brief_description": "This creamy clam chowder is loaded with delicious clams, potatoes, and carrots in a savory broth with a splash of red wine vinegar for extra flavor.",
  "cuisine": "New England American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes, carrots, celery, and onion into a large skillet; pour in clam juice and add enough water to cover. Cook and stir over medium-low heat until vegetables are tender."
    },
    {
      "position": 2,
      "text": "Meanwhile, melt butter in a large, heavy saucepan over medium heat. Whisk in flour until smooth. Whisk in cream and stir constantly until thick and smooth. Stir in vegetable mixture with any juices until just heated through."
    },
    {
      "position": 3,
      "text": "Stir in clams just before serving to prevent them from overcooking. When clams are heated through, stir in vinegar and season to taste with salt and pepper."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "air-fryer-dilly-roasted-japanese-eggplant-and-squash-recipe-11800571",
  "name": "Air Fryer Dilly-Roasted Japanese Eggplant and Squash",
  "recipe_type": "side",
  "brief_description": "This air fryer dilly-roasted Japanese eggplant and squash recipe is great when you have abundant Japanese eggplant and summer squash in my garden. No need to peel Japanese eggplant, and feel free to use either zucchini or yellow squash.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place eggplant and squash rounds into a large mixing bowl. Add salad dressing and dill. Toss until evenly combined."
    },
    {
      "position": 3,
      "text": "Place veggie mixture into the basket of the air fryer. Cook 4 minutes, shake, and cook 4 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

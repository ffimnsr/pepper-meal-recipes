  "id": "b941576f-fcf6-52f1-b82b-e030d4dcdc07",
  "slug": "grilled-corn-on-the-cob",
  "name": "Grilled Corn on the Cob",
  "recipe_type": "dessert",
  "brief_description": "Grilled corn on the cob with butter wrapped in foil and cooked until tender and delicious is the easiest way to serve sweet corn all summer long!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for high heat and lightly oil grate."
    },
    {
      "position": 2,
      "text": "Peel back corn husks and remove silk."
    },
    {
      "position": 3,
      "text": "Place 1 tablespoon butter, salt and pepper on each piece of corn. Close husks."
    },
    {
      "position": 4,
      "text": "Wrap each ear of corn tightly in aluminum foil."
    },
    {
      "position": 5,
      "text": "Cook on the preheated grill, turning occasionally, until tender, about 30 minutes."
    },
    {
      "position": 6,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

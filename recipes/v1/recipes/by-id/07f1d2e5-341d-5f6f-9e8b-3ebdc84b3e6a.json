  "id": "07f1d2e5-341d-5f6f-9e8b-3ebdc84b3e6a",
  "slug": "easy-butternut-squash-and-pear-soup",
  "name": "Easy Butternut Squash and Pear Soup",
  "recipe_type": "soup",
  "brief_description": "Roasted butternut squash, pears, onions, and tomatoes are blended together into an aromatic soup in this easy recipe fit for a fall day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Place butternut squash, onions, pears, tomatoes, and carrot in a large roasting pan. Drizzle olive oil on top. Season with pepper and nutmeg."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven until squash is easily pierced with a knife, 1 to 2 hours. Cool until squash is easily handled, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Scoop flesh out of the squash with a spoon; place in a pot. Discard peel. Transfer roasted onions, pears, tomatoes, and carrot to the pot. Add 1 cup chicken stock. Puree mixture with an immersion blender until smooth."
    },
    {
      "position": 5,
      "text": "Stir remaining 1 1/2 cups chicken stock into the pot. Heat soup until warmed through, about 10 minutes. Season with salt."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

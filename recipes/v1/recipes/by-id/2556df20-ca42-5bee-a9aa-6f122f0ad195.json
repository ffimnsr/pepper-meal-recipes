  "id": "2556df20-ca42-5bee-a9aa-6f122f0ad195",
  "slug": "bruschetta-with-shallots",
  "name": "Bruschetta with Shallots",
  "recipe_type": "appetizer",
  "brief_description": "Shallots are the special ingredient in this easy, filling bruschetta. The tomato mixture tastes best when prepared ahead of time and chilled for approximately 1 hour.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, toss together the roma tomatoes, minced garlic, shallots, basil, lemon juice, salt, pepper and 1/3 cup olive oil."
    },
    {
      "position": 2,
      "text": "Place the slivered garlic and 1/4 cup olive oil in small saucepan over medium heat. Slowly cook and stir 2 to 3 minutes. Discard garlic."
    },
    {
      "position": 3,
      "text": "Toast the bread slices, and brush with the olive oil heated with garlic. Top slices with the roma tomato mixture."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

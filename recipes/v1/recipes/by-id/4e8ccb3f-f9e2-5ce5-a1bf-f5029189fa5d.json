  "slug": "5-ingredient-peanut-butter-cottage-cheese-mousse-recipe-11780529",
  "name": "5-Ingredient Peanut Butter Cottage Cheese Mousse",
  "recipe_type": "dessert",
  "brief_description": "This 5-ingredient peanut butter cottage cheese mousse, a blender mousse that you can make in minutes, is very satisfying when you want a sweet treat on the healthier side.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place cottage cheese, peanut butter, honey, peanut butter powder, vanilla, and salt in a food processor and process until smooth."
    },
    {
      "position": 2,
      "text": "Pour or scoop into 4 small glasses or 4 large shot glasses. Refrigerate for at least 15 minutes for flavors to develop."
    }
  ],
  "servings": 4,

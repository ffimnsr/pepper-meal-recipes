{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "b892a167-8f21-5e3c-8b74-43f5ad3b6ac3",
  "slug": "firecracker-chicken-meatballs-recipe-11785511",
  "name": "Firecracker Chicken Meatballs",
  "recipe_type": "appetizer",
  "brief_description": "These firecracker chicken meatballs give a big punch of flavor with a spicy, sweet, savory firecracker sauce. They\u2019re perfect for bite-size appetizers, game day snacks, or a main dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 475 degrees F (245 degrees C). Line a large baking sheet with foil, and lightly spray with cooking spray."
    },
    {
      "position": 2,
      "text": "Stir egg, jalape\u00f1o, soy sauce, onion powder, ginger, garlic, and pepper together in a large bowl. Add ground chicken and breadcrumbs, and gently mix just until just combined."
    },
    {
      "position": 3,
      "text": "Form into meatballs using a 2-tablespoon cookie scoop; shape with wet hands. Place on the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until no longer pink at the center, 8 to 10 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (71 degrees C)."
    },
    {
      "position": 5,
      "text": "Meanwhile, for firecracker sauce, combine hot sauce, brown sugar, soy sauce, vinegar, Worcestershire, and red pepper flakes in a saucepan over medium-high heat. Bring to a boil, then reduce heat to a simmer. Cook for about 5 minutes, stirring occasionally, then remove from heat to cool. The sauce will thicken slightly as it cools."
    },
    {
      "position": 6,
      "text": "Dip each meatball into sauce or brush each meatball with sauce, return to the baking sheet, and cook for an additional 1 to 2 minutes."
    },
    {
      "position": 7,
      "text": "Drizzle or brush with additional sauce as desired, sprinkle with chopped parsley, and serve. Serve remaining sauce on the side for dipping."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

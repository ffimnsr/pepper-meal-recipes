  "id": "82b7a0ec-54f3-569c-9643-06db135f50aa",
  "slug": "southwestern-pasta-salad",
  "name": "Southwestern Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "Flavorsome Southwest pasta salad with rotini, corn, black beans, red and green bell pepper, tomatoes, cilantro, and a zesty lime and chili dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook until al dente, about 8 to 10 minutes; drain."
    },
    {
      "position": 2,
      "text": "Combine oil, lime juice, chili powder, cumin, salt, and garlic in a large bowl. Stir in pasta; set aside to cool to room temperature, stirring occasionally."
    },
    {
      "position": 3,
      "text": "Stir in corn, beans, green pepper, red pepper and 1/2 of the cilantro leaves. Spoon onto a platter and garnish with tomatoes and remaining cilantro. Serve chilled or at room temperature."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

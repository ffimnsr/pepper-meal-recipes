  "id": "ae979538-d19c-5b4a-92dc-c0b28576fc85",
  "slug": "easy-slow-cooker-chicken-and-dumplings",
  "name": "Easy Slow Cooker Chicken and Dumplings",
  "recipe_type": "soup",
  "brief_description": "Slow cooker chicken and dumplings are so easy with this recipe that calls for refrigerated biscuit dough, cooked to perfection for the best comfort food.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk water, poultry seasoning, salt, and black pepper together in a bowl; add chicken to the bowl and turn to coat."
    },
    {
      "position": 2,
      "text": "Pour 1/2 of the chicken broth into a slow cooker; add chicken and poultry seasoning mixture. Layer onion, carrots, and celery, respectively, over chicken. Dot butter over vegetables; pour both condensed soups and remaining broth over vegetables, then sprinkle rosemary on top."
    },
    {
      "position": 3,
      "text": "Cook on High for 3 \u00bd to 4 \u00bd hours. Remove chicken from slow cooker and shred with two forks; return chicken to slow cooker. Add biscuit dough pieces to the chicken mixture. Cook on High for 1 \u00bd hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 300,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "expert",

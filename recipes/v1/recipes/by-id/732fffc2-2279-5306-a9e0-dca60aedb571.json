  "id": "732fffc2-2279-5306-a9e0-dca60aedb571",
  "slug": "high-protein-sheet-pan-pasta-bake-recipe-11871461",
  "name": "High Protein Sheet Pan Pasta Bake",
  "recipe_type": "main",
  "brief_description": "This high protein sheet pan pasta bake has the bubbly, crunchy edges of a baked pasta, but as a sheet pan dinner takes less oven time. Lean beef, high protein pasta, and cottage cheese make it very satisfying and nutritious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Lightly grease a rimmed baking sheet with olive oil."
    },
    {
      "position": 2,
      "text": "Cook meat in large skillet over medium-high heat until fat is rendered and meat is brown and crumbled. Add onion, 1/2 teaspoon salt, 1/4 teaspoon pepper and 1/4 teaspoon garlic powder, and cook until softened."
    },
    {
      "position": 3,
      "text": "Stir in sauce and bring to a simmer. Simmer for 10 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, bring a large pot of salted water to a boil, and cook pasta until tender with a bite, according to package directions. Drain and stir pasta into sauce. Spread mixture onto prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Stir cottage cheese and 1 cup Italian cheese together with remaining salt, pepper, and garlic powder. Dollop cheese mixture over pasta mixture and spread remaining Italian cheese over the top."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until bubbly and lightly browned and crisp around the edges, 20 to 25 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

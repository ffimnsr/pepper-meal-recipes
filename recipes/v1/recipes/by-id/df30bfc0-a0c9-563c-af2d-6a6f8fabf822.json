  "name": "No-Peek Beef Stew",
  "recipe_type": "soup",
  "brief_description": "This no-peek beef stew is made in a slow cooker with condensed soup, mushrooms, and red wine for a delicious meal to come home to after a busy day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place beef stew meat, condensed French onion soup, condensed cream of mushroom soup, mushrooms, and dry red wine into a slow cooker. Cover and cook on Low for 8 hours."
    }
  ],

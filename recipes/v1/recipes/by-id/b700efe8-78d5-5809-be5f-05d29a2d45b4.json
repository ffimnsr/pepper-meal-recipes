  "id": "b700efe8-78d5-5809-be5f-05d29a2d45b4",
  "slug": "vegan-spinach-dip-with-artichokes",
  "name": "Vegan Spinach Dip with Artichokes",
  "recipe_type": "appetizer",
  "brief_description": "Made with vegan alternatives, this spinach artichoke dip is great for parties. Serve warm with crackers or toasted baguette slices.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine vegan cream cheese and coconut yogurt in a bowl and stir to combine. Mix in spinach, vegan Parmesan, garlic, and Italian seasoning. Fold in artichoke hearts and season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Grease the bottom and sides of an 8x8-inch oven-safe baking dish with olive oil. Pour in spinach mixture and spread out evenly. Top with vegan mozzarella."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cheese is beginning to brown, about 25 minutes. Remove from oven and serve warm."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

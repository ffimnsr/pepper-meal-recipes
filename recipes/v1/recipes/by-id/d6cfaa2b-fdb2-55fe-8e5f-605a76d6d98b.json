  "id": "d6cfaa2b-fdb2-55fe-8e5f-605a76d6d98b",
  "slug": "sausage-mushroom-quiche",
  "name": "Sausage Mushroom Quiche",
  "recipe_type": "breakfast",
  "brief_description": "This sausage and mushroom quiche recipe has a creamy parsley and Parmesan cheese filling. It's hearty, tasty, and perfect for brunch, lunch, or dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place pie crust in a 9-inch pie plate; set aside. Snip off mushroom stems; cut large mushrooms in half."
    },
    {
      "position": 3,
      "text": "Crumble sausage into a large skillet; add mushrooms. Cook on medium-high heat until sausage is browned and all liquid from mushrooms has evaporated. Drain and discard grease. Stir parsley into sausage mixture."
    },
    {
      "position": 4,
      "text": "Beat eggs in a large bowl; whisk in half-and-half, Parmesan cheese, and salt; stir in sausage mixture until well blended. Pour egg mixture into the prepared pie crust."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until crust is well browned and the filling is set, 25 to 30 minutes. Let stand briefly before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

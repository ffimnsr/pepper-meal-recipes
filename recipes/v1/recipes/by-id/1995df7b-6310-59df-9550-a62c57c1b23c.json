  "id": "1995df7b-6310-59df-9550-a62c57c1b23c",
  "slug": "puffy-taco-shells",
  "name": "Puffy Taco Shells",
  "recipe_type": "main",
  "brief_description": "These taco shells puff up when fried so you can fill them with your favorite fixings.",
  "cuisine": "Southwestern Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Mix masa harina, salt, and 1/2 cup plus 2 tablespoons water together in a bowl using your fingertips until dough forms and pulls away from the sides, 2 or 3 minutes. Form into a firm, flattened ball and divide into 8 equal portions. Roll each portion into a ball. Keep dough balls covered with a damp paper towel as you fry them, one at a time."
    },
    {
      "position": 2,
      "text": "Place dough ball between 2 sheets of plastic or a split open zip top bag. Flatten to form a small circle about 1/8 to 3/16 inch thick."
    },
    {
      "position": 3,
      "text": "Heat oil in a skillet over medium-high heat. When oil is hot, slide in the first circle. Very carefully baste hot oil over the top of the shell with a spoon to keep oil circulating over the top surface. When shell has puffed (after about 15 seconds), cook another few seconds and flip it over and cook another 30 seconds. Remove with a slotted spoon and drain on paper towels. Repeat for each shell."
    },
    {
      "position": 4,
      "text": "When shells are still warm and pliable, gently push down puffed tops to create room for the fillings and slightly crease the shells for folding."
    },
    {
      "position": 5,
      "text": "Fill with your favorite taco fixings and serve while shells are still warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 3,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "bc700adc-d3c6-5526-a588-dccebf8e05a1",
  "slug": "instant-pot-teriyaki-chicken-thighs",
  "name": "Instant Pot\u00ae Teriyaki Chicken Thighs",
  "recipe_type": "main",
  "brief_description": "This easy Instant Pot\u00ae recipe for chicken thighs in teriyaki sauce is perfect for a school night or whenever you need a quick dinner!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot\u00ae) and select Saute function. Pour in olive oil and warm until hot. Add chicken thighs and brown on both sides, 3 to 5 minutes per side."
    },
    {
      "position": 2,
      "text": "Meanwhile, combine brown sugar, soy sauce, honey, apple cider vinegar, ginger, and garlic in a bowl for the marinade. Pour marinade over chicken thighs in the pot and bring to a simmer; cook for 2 minutes and scrape browned bits off bottom of pot. Turn off Saute mode. Close and lock the lid."
    },
    {
      "position": 3,
      "text": "Select high pressure according to manufacturer\u2019s instructions; set timer for 10 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Release pressure using the natural-release method according to manufacturer\u2019s instructions, 10 to 40 minutes. Unlock and remove the lid."
    },
    {
      "position": 5,
      "text": "Stir cold water and cornstarch together in a small bowl. Remove chicken thighs from Instant Pot\u00ae and transfer to a plate."
    },
    {
      "position": 6,
      "text": "Select Saute function. Pour cornstarch mixture into the remaining sauce in the pot. Cook until sauce has thickened, 2 to 3 minutes. Turn off Saute mode. Pour some of the sauce over teriyaki thighs and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

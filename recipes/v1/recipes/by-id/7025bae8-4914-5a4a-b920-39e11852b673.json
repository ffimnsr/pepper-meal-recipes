  "id": "7025bae8-4914-5a4a-b920-39e11852b673",
  "slug": "eggless-french-toast",
  "name": "Eggless French Toast",
  "recipe_type": "breakfast",
  "brief_description": "Eggless French toast is ready in minutes for a yummy breakfast. Even if everyone at your table eats eggs, they won't notice they're missing from this dish!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk milk, cinnamon, and vanilla together in a shallow bowl until well combined."
    },
    {
      "position": 2,
      "text": "Melt butter in a large skillet over medium heat."
    },
    {
      "position": 3,
      "text": "Gently press two bread slices into milk mixture until lightly coated on both sides (do not soak)."
    },
    {
      "position": 4,
      "text": "Cook coated slices in melted butter until golden brown and somewhat firm, 5 to 8 minutes per side. Repeat for remaining bread slices."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,

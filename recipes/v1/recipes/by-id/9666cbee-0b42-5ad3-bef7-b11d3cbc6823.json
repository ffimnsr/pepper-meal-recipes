  "id": "9666cbee-0b42-5ad3-bef7-b11d3cbc6823",
  "slug": "cheesecake-pancakes-recipe-7970170",
  "name": "Cheesecake Pancakes",
  "recipe_type": "dessert",
  "brief_description": "These cheesecake pancakes topped with strawberries will definitely take your breakfast game up a few notches.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "To make the topping: Combine strawberries and jam in a small saucepan. Bring to a simmer; set aside."
    },
    {
      "position": 3,
      "text": "To make the cream cheese swirl: Combine cream cheese, 3 tablespoons sugar, milk, and vanilla in a small bowl. Beat with an electric mixer until smooth."
    },
    {
      "position": 4,
      "text": "Transfer cream cheese mixture to a pastry bag or a resealable plastic bag with a corner snipped off."
    },
    {
      "position": 5,
      "text": "To make the pancake batter: Combine flour, remaining 2 tablespoons sugar, baking powder, baking soda, and salt in a large bowl."
    },
    {
      "position": 6,
      "text": "Combine egg, buttermilk, and oil in a medium bowl."
    },
    {
      "position": 7,
      "text": "Add egg mixture all at once to the flour mixture. Stir just until moistened (batter should be slightly lumpy)."
    },
    {
      "position": 8,
      "text": "Heat an extra-large nonstick skillet or griddle over medium heat. Coat with cooking spray. Pour 1/3 cup portions of batter onto the skillet. Reduce heat to medium-low."
    },
    {
      "position": 9,
      "text": "Cook until bottoms are golden brown and edges are slightly dry and bubbles form at the edges of the pancakes, 2 to 3 minutes."
    },
    {
      "position": 10,
      "text": "Pipe a swirl of cream cheese onto each pancake starting from the center."
    },
    {
      "position": 11,
      "text": "Coat the uncooked side of the pancakes with cooking spray."
    },
    {
      "position": 12,
      "text": "Turn and cook 2 to 3 minutes more on the other side. Repeat with remaining batter and cream cheese mixture."
    },
    {
      "position": 13,
      "text": "Serve with strawberry topping and sprinkle with graham cracker crumbs or dust with powdered sugar."
    }
  ],
  "servings": 10,

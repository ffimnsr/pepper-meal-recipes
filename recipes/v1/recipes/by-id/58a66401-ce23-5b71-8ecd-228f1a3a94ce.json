  "id": "58a66401-ce23-5b71-8ecd-228f1a3a94ce",
  "slug": "cranberry-jalapeno-dip-recipe-8732450",
  "name": "Cranberry Jalapeno Dip",
  "recipe_type": "appetizer",
  "brief_description": "This cranberry jalapeno dip is tart, sweet and spicy all together and has a festive color\u2014a perfect appetizer for the holidays!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place cranberries, green onion whites, jalape\u00f1o, lime juice, cilantro, honey and salt in a food processor; pulse until just finely chopped and combined."
    },
    {
      "position": 3,
      "text": "Place in a fine mesh strainer over a bowl and set aside."
    },
    {
      "position": 4,
      "text": "Meanwhile in a medium bowl combine cream cheese, sour cream, and heavy cream. Beat with an electric mixer until fluffy and combined."
    },
    {
      "position": 5,
      "text": "Spread cream cheese mixture on a serving platter and top with strained cranberry mixture. Sprinkle flaky salt on top and garnish with green onion greens. If desired drizzle with additional honey. Serve with crackers or pita chips."
    }
  ],
  "servings": 16,

  "id": "43e64c5a-94fb-53e7-bfdf-a62bba12dbac",
  "slug": "eggnog-waffles",
  "name": "Eggnog Waffles",
  "recipe_type": "breakfast",
  "brief_description": "Eggnog is the star ingredient in these crispy golden waffles that are ready in under 30 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix flour, baking powder, baking soda, and salt together in a bowl. Add eggnog, eggs, and butter; mix well."
    },
    {
      "position": 2,
      "text": "Preheat a waffle iron according to manufacturer's instructions. Pour 1/4 of the batter into the preheated iron and cook until waffle is crisp and golden, about 5 minutes. Repeat with remaining batter."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,

  "slug": "stacked-tomato-and-burrata-salad",
  "name": "Stacked Tomato and Burrata Salad",
  "recipe_type": "salad",
  "brief_description": "Chef John\u2019s gorgeous twist on caprese salad features rich, creamy Burrata cheese (not mozzarella!) sandwiched between juicy, fresh tomato slices.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Place a tomato slice onto a plate and season with sea salt and black pepper. Spread Burrata cheese over tomato slice, top with torn basil leaves, and drizzle with olive oil. Repeat the layering process with remaining ingredients, finishing with a tomato slice."
    }
  ],

  "id": "c535e348-a188-509e-8f3d-f80fd385b951",
  "slug": "magaricz",
  "name": "Magaricz",
  "recipe_type": "appetizer",
  "brief_description": "Chopped eggplant, red and green bell peppers, onions, and carrots, slowly cooked on the stovetop in olive oil will make your kitchen smell like heaven. A wonderful dip for rye--or your favorite bread or crackers.",
  "cuisine": "Russian Eastern European Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Place eggplant in a colander, lightly salt, and leave to drain for about 45 minutes."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a large skillet over medium high heat. Add eggplant, red and green bell peppers, onion, and carrot; stir to coat. Reduce heat to low, and cook for 40 minutes, stirring occasionally, or until mixture resembles the consistency of coarse jam. Season to taste with salt and red pepper flakes."
    },
    {
      "position": 3,
      "text": "Cover, and chill at least 1 hour. Serve chilled as a condiment with your favorite bread or crackers."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,

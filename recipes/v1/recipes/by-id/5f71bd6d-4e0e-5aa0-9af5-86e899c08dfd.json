  "schema_version": 1,
  "id": "5f71bd6d-4e0e-5aa0-9af5-86e899c08dfd",
  "slug": "make-ahead-spinach-and-mozzarella-breakfast-strata",
  "name": "Make-Ahead Spinach and Mozzarella Breakfast Strata",
  "recipe_type": "breakfast",
  "brief_description": "Spinach, shredded mozzarella, and Italian bread stars in this easy make-ahead breakfast strata that's prepped and refrigerated overnight for a quick morning meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a medium skillet over medium heat. Add onion and saute until soft, about 5 minutes. Add herbes de Provence, salt, and pepper; continue to cook for 1 minute more. Stir in spinach, remove from heat, and set aside."
    },
    {
      "position": 2,
      "text": "Spray the inside of a 3-quart (9x13-inch) baking dish with cooking spray. Layer the bottom of the dish with 1/3 of the bread cubes. Top with 1/3 of the spinach mixture and 1/3 mozzarella cheese. Repeat these layers twice more with remaining bread, spinach mixture, and cheese."
    },
    {
      "position": 3,
      "text": "Combine eggs, milk, salt, and pepper in a medium bowl. Whisk together until blended. Pour evenly over the bread and spinach layered in the baking dish. Cover with plastic wrap and chill for at least 8 hours, up to 1 day."
    },
    {
      "position": 4,
      "text": "Remove from the refrigerator 30 minutes before baking to allow pan to get to room temperature."
    },
    {
      "position": 5,
      "text": "Meanwhile, preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 6,
      "text": "Bake, uncovered, in the preheated oven until puffed, golden brown, and cooked through, 45 to 55 minutes. Let stand at least 5 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

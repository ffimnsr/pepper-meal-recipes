  "id": "a0ab2e77-4382-546f-b628-87037d6612cf",
  "slug": "watermelon-caprese-appetizer",
  "name": "Watermelon Caprese Appetizer",
  "recipe_type": "salad",
  "brief_description": "Watermelon, mozzarella cheese, and basil appetizer skewers are drizzled with olive oil and balsamic vinegar in this fun twist on a caprese salad.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Trim basil leaves into small circles about 1 inch in diameter."
    },
    {
      "position": 2,
      "text": "Thread watermelon and mozzarella cheese on toothpicks, sandwiching a basil leaf in between. Arrange on a serving plate."
    },
    {
      "position": 3,
      "text": "Pour olive oil and balsamic vinegar over toothpicks. Sprinkle salt and black pepper on top."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,

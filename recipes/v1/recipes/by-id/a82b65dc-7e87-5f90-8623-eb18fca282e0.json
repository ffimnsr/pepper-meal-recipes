  "slug": "dipping-sauce-for-artichokes",
  "name": "Dipping Sauce for Artichokes",
  "recipe_type": "appetizer",
  "brief_description": "This quick dipping sauce for artichokes has just mayonnaise, garlic, basil, lemon juice, and Worcestershire sauce.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix the mayonnaise and garlic together in a small bowl. Add the lemon juice and basil; whisk until thoroughly combined. Beat the Worcestershire sauce into the mixture. Serve immediately, or chill until serving."
    }
  ],
  "servings": 2,

  "id": "51c5a251-c42f-5539-99bd-feeca017cc24",
  "slug": "bacon-broccoli-salad-with-raisins-and-sunflower-seeds",
  "name": "Bacon Broccoli Salad with Raisins and Sunflower Seeds",
  "recipe_type": "salad",
  "brief_description": "This smoky, crunchy broccoli salad has a tangy and sweet mayonnaise-based dressing. It's sure to be a family favorite.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels and crumble."
    },
    {
      "position": 2,
      "text": "Toss bacon, broccoli, raisins, sunflower seeds, and onion together in a large bowl."
    },
    {
      "position": 3,
      "text": "Whisk mayonnaise, sugar, sweetener, and vinegar in another bowl until smooth. Pour over broccoli mixture and toss to coat. Refrigerate until ready to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,

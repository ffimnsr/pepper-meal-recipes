  "id": "47a4094f-195b-55cc-9d94-e44618f71098",
  "slug": "french-crepes",
  "name": "French Cr\u00eapes",
  "recipe_type": "dessert",
  "brief_description": "These French cr\u00eapes are thin, delicate, and delicious for breakfast or dessert. Fill as you like with fresh berries, jam, or chocolate spread.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Sift flour, sugar, and salt into a bowl; set aside. Beat eggs and milk together in a large bowl with an electric mixer."
    },
    {
      "position": 3,
      "text": "Beat in flour mixture until smooth; stir in melted butter."
    },
    {
      "position": 4,
      "text": "Lightly grease a griddle or frying pan; heat over medium-high heat. Pour or scoop the batter onto the griddle, using approximately 2 tablespoons for each cr\u00eape."
    },
    {
      "position": 5,
      "text": "Immediately rotate the skillet to spread batter out in a thin layer. Cook until the top of the cr\u00eape is no longer wet and the bottom has turned light brown, 1 to 2 minutes."
    },
    {
      "position": 6,
      "text": "Shake the pan or loosen with a spatula; turn or flip it over and cook until other side has turned light brown, about 1 minute more. Repeat with remaining batter."
    },
    {
      "position": 7,
      "text": "Serve with your choice of fillings or toppings, and enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

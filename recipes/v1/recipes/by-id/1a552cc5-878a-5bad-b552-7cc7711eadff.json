  "slug": "2-minute-cheese-quesadillas",
  "name": "2-Minute Cheese Quesadillas",
  "recipe_type": "snack",
  "brief_description": "Make a cheese quesadilla in the microwave with flour tortillas and shredded Cheddar cheese for a quick and easy snack every kid will love!",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place one flour tortilla onto a large microwave-safe plate."
    },
    {
      "position": 3,
      "text": "Sprinkle with Cheddar, then top with remaining tortilla."
    },
    {
      "position": 4,
      "text": "Microwave on high until cheese is melted, about 1 minute. Slice like a pizza to serve."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,

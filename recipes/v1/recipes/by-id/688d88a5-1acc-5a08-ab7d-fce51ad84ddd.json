  "id": "688d88a5-1acc-5a08-ab7d-fce51ad84ddd",
  "slug": "french-chocolate-cake",
  "name": "French Chocolate Cake",
  "recipe_type": "dessert",
  "brief_description": "This classic French sponge cake is a dense cake that is delicious when dusted with confectioners' sugar and served with lightly sweetened whipped cream or a fruit coulis. Cut it into 10 generous pieces.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Generously grease a 9-inch springform cake tin. Dust with a little sugar, and tap out excess."
    },
    {
      "position": 2,
      "text": "Set aside 3 tablespoons of sugar. Place chocolate, butter, and remaining sugar in a large, heavy-based pan. Cook over moderate heat until chocolate and butter have melted, and sugar has dissolved. Remove the pan from heat. Stir in vanilla, and leave mixture to cool slightly."
    },
    {
      "position": 3,
      "text": "Beat egg yolks into chocolate mixture one at a time, beating well after each addition. Stir in flour."
    },
    {
      "position": 4,
      "text": "In a scrupulously clean, grease-free, and large bowl, beat egg whites until foamy. Add cream of tartar and salt, and beat to stiff peaks. Sprinkle reserved sugar over egg whites, and beat until stiff and glossy. Use a whisk or spatula to fold 1/3 of egg whites into chocolate mixture, then carefully fold in remaining whites. Carefully pour batter into the prepared tin, and tap the tin gently to release air bubbles."
    },
    {
      "position": 5,
      "text": "Bake until well risen and a skewer inserted into center of the cake comes out clean, for about 45 minutes to 1 hour. Check cake after 30 minutes; if cake appears to rise unevenly, rotate after 30 to 35 minutes. If cake starts to crack or become too brown, place a piece of foil lightly over top. Transfer cake to a wire cooling rack, and remove the sides of the springform tin. Cool completely, and then remove the base. Do not attempt to remove cake before it's completely cooled as this cake is very fragile."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "hard",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "c6b6f56b-01d6-5f18-9c83-aa5f8e807e3b",
  "slug": "tiramisu-cheesecake",
  "name": "Tiramisu Cheesecake",
  "recipe_type": "dessert",
  "brief_description": "This tiramisu cheesecake has a layer of coffee liqueur-soaked ladyfingers, baked with a decadent, creamy coffee filling, topped with grated chocolate.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place a pan of water on the lowest oven rack."
    },
    {
      "position": 2,
      "text": "To make the crust: Crush ladyfingers into fine crumbs. Place crumbs into a bowl with melted butter and coffee-flavored liqueur; stir until evenly combined. Press into the bottom of a 9-inch springform pan."
    },
    {
      "position": 3,
      "text": "To make the filling: Beat cream cheese, mascarpone cheese, and sugar in a large bowl with an electric mixer until very smooth, 2 to 3 minutes. Scrape down the sides of the bowl and mix in coffee-flavored liqueur. Add flour and eggs; mix on low speed just until smooth. If batter seems too thick, mix in heavy cream. Pour batter over the crust."
    },
    {
      "position": 4,
      "text": "Bake on the center rack of the preheated oven until just set, 40 to 45 minutes."
    },
    {
      "position": 5,
      "text": "Open the oven door, turn off the heat, and leave cheesecake to cool on the center rack for 20 minutes."
    },
    {
      "position": 6,
      "text": "Remove from the oven, transfer to a wire rack to cool completely, about 30 more minutes."
    },
    {
      "position": 7,
      "text": "Refrigerate for at least 3 hours, or overnight."
    },
    {
      "position": 8,
      "text": "Just before serving, grate semisweet chocolate over the top."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

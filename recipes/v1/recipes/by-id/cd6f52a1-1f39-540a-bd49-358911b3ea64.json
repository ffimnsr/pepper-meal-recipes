  "slug": "maple-and-brown-sugar-oatmeal",
  "name": "Maple and Brown Sugar Oatmeal",
  "recipe_type": "breakfast",
  "brief_description": "Recreate maple and brown sugar oatmeal packets from scratch using this super quick and easy recipe that beats store-bought oatmeal any day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring water to a boil in a small pot. Add oats and cook, stirring, for 1 minute."
    },
    {
      "position": 3,
      "text": "Remove from heat and stir in brown sugar and maple syrup. Let sit until desired thickness is reached, 2 to 3 minutes."
    }
  ],

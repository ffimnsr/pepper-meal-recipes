  "id": "604546e7-57d1-5f74-8ffa-e924a9295672",
  "slug": "chive-pesto",
  "name": "Chive Pesto",
  "recipe_type": "side",
  "brief_description": "This chive pesto is a creamy blend of fresh garlic chives, fresh and dried basil, dried oregano, garlic powder, cream cheese, and extra-virgin olive oil.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pulse garlic chives in the bowl of a food processor until finely chopped. Add fresh basil; pulse until finely chopped. Pour olive oil in slowly, with the processor running, until smooth. Add garlic powder, oregano, dried basil, salt, and black pepper; pulse until blended. Add cream cheese; pulse until blended."
    },
    {
      "position": 2,
      "text": "Transfer pesto to a bowl; cover. Chill until flavors combine, about 15 minutes."
    }
  ],
  "servings": 12,

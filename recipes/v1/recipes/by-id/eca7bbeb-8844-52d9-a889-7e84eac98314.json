  "id": "eca7bbeb-8844-52d9-a889-7e84eac98314",
  "slug": "florentine-cookies",
  "name": "Easy Florentine Cookies",
  "recipe_type": "dessert",
  "brief_description": "This easy Florentine cookie recipe includes a creamy milk chocolate filling that elevates a delicate oat cookie into the ultimate sandwich cookie.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line 2 cookie sheets with aluminum foil."
    },
    {
      "position": 2,
      "text": "Melt butter in a large saucepan. Remove from heat and mix in oats, sugar, flour, corn syrup, milk, vanilla, and salt until well combined. Drop by level teaspoonfuls 3 inches apart onto the prepared cookie sheets. Spread cookies out thin with a rubber spatula."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden brown, 5 to 7 minutes. Cool on the cookie sheets."
    },
    {
      "position": 4,
      "text": "Meanwhile, place chocolate chips in the top of a double boiler over simmering water. Stir frequently, scraping down the sides with a rubber spatula to avoid scorching, until chocolate is melted and smooth, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Peel foil from cookies. Spread melted chocolate on 1/2 of the cookies. Top with the remaining cookies."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

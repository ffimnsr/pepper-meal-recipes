  "slug": "strawberry-mango-mesclun-salad",
  "name": "Strawberry Mango Mesclun Salad",
  "recipe_type": "salad",
  "brief_description": "Mango, strawberries, and sweetened dried cranberries are a vibrant addition to mixed greens tossed with an oil and balsamic vinegar dressing.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place sugar, oil, salt, and vinegar in a jar with a lid. Seal the jar and shake vigorously to mix."
    },
    {
      "position": 2,
      "text": "In a large bowl, mix salad greens, sweetened dried cranberries, strawberries, mango, and onion. To serve, toss with dressing and sprinkle with almonds."
    }
  ],

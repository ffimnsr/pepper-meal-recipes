{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "41707016-b440-5e00-8535-d64bfbcdb6a5",
  "slug": "garlic-butter-parmesan-chicken-meatloaf-recipe-11796238",
  "name": "Garlic Butter Parmesan Chicken Meatloaf",
  "recipe_type": "main",
  "brief_description": "Ground chicken, Italian chicken sausage, cheese, breadcrumbs, and parsley combine in this quick and chicken meatloaf that\u2019s drizzled with a garlic-butter glaze. One tasty dish you\u2019ll be making over and over again.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Lightly grease a loaf pan."
    },
    {
      "position": 2,
      "text": "Combine 6 cloves garlic, onion, egg, egg yolk, half and half, 2 tablespoons parsley and 1/4 cup grated Parmesan in a bowl; mix until well combined. Add ground chicken, sausage, 1 teaspoon salt, and pepper; mix until combined. Fold in breadcrumbs until evenly mixed and form into a loaf shape."
    },
    {
      "position": 3,
      "text": "Transfer mixture into the prepared pan and sprinkle the top evenly with 1 1/2 tablespoons Parmesan cheese."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the internal temperature reaches 165 degrees F (73 degrees C), 35 to 40 minutes. Let rest while the sauce is prepared."
    },
    {
      "position": 5,
      "text": "Meanwhile, heat 1 tablespoon olive oil in a small saucepan over medium-high heat. Add remaining 2 cloves garlic and cook until fragrant, about 1 minute. Pour in wine and broth and bring to a boil. Reduce heat and simmer until reduced by about 3/4 (you should have about 1/3 cup remaining)."
    },
    {
      "position": 6,
      "text": "Turn off heat and gradually whisk in cubed butter. Stir in remaining Parmesan cheese and parsley. Season with remaining salt and crushed red pepper flakes."
    },
    {
      "position": 7,
      "text": "Slice meatloaf and serve drizzled with garlic butter sauce."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

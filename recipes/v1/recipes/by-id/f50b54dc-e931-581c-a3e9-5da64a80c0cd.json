  "id": "f50b54dc-e931-581c-a3e9-5da64a80c0cd",
  "slug": "eggless-tofu-spinach-quiche",
  "name": "Eggless Tofu Spinach Quiche",
  "recipe_type": "breakfast",
  "brief_description": "This eggless quiche is made with blended tofu and milk instead of eggs, plus spinach, garlic, onion, Cheddar, and Swiss.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Blend tofu, milk, salt, and pepper in a blender until smooth, adding more milk if necessary."
    },
    {
      "position": 3,
      "text": "Combine spinach, Cheddar, Swiss, onion, and garlic in a medium bowl. Add tofu mixture and mix until well combined; pour into pie crust."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until set in the center and golden brown on top, about 30 minutes. Let stand for 5 minutes before cutting into six generous slices."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

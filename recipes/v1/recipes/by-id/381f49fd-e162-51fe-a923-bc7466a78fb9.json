  "id": "381f49fd-e162-51fe-a923-bc7466a78fb9",
  "slug": "slow-cooker-jambalaya-vegan",
  "name": "Slow Cooker Jambalaya (Vegan)",
  "recipe_type": "soup",
  "brief_description": "This slow-cooker jambalaya (vegan) recipe uses seitan, vegan sausage, celery, onion, bell pepper, and Cajun seasoning for an easy weeknight jambalaya.",
  "cuisine": "American Cajun Creole",
  "instructions": [
    {
      "position": 1,
      "text": "Drizzle olive oil into a 4-quart slow cooker. Add tomatoes with juice, celery, seitan, sausage, vegetable broth, onion, bell pepper, garlic, miso paste, Cajun seasoning, thyme, and oregano to the slow cooker."
    },
    {
      "position": 2,
      "text": "Cover slow cooker. Cook on Low for 4 hours. Add rice to the slow cooker. Cover slow cooker. Cook on High until rice is cooked through, about 30 minutes more. Garnish with parsley."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 270,
  "preparation_time_minutes": 25,

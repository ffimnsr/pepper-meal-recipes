  "slug": "beetroot-relish",
  "name": "Beetroot Relish",
  "recipe_type": "side",
  "brief_description": "A delicious and colorful side dish, especially good served with lamb or other grilled meats.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large pot, combine the beets, onion, red bell pepper, celery, sugar, and cauliflower. Season with salt, mustard seed, and celery seed, then stir in vinegar. Bring to a boil, then reduce heat to low."
    },
    {
      "position": 2,
      "text": "Simmer, stirring occasionally, until vegetables are tender, about 20 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,

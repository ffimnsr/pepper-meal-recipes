  "id": "790a2152-ad62-50e3-897a-5572c89851c9",
  "slug": "white-wine-and-apple-sangria",
  "name": "White Wine and Apple Sangria",
  "recipe_type": "drink",
  "brief_description": "This sangria recipe, featuring white wine, apples, peaches, and lemon, is easy to customize with different wines, fruit, and herbs. Perfect for summer!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir apple juice and sugar together in a pitcher until sugar dissolves. Add wine, apples, peaches, lemon slices, and brandy."
    },
    {
      "position": 2,
      "text": "Cover and chill until ready to serve, 1 to 24 hours."
    },
    {
      "position": 3,
      "text": "Gently stir in club soda before serving over ice. Garnish with fresh thyme sprigs."
    }
  ],
  "servings": 8,

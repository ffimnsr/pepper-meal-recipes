  "id": "5e549fdb-3ce0-5ad9-a902-f651d54c106d",
  "slug": "big-batch-freezer-margaritas-recipe-11710790",
  "name": "Big Batch Freezer Margaritas",
  "recipe_type": "drink",
  "brief_description": "Making a big batch of freezer margaritas couldn't be easier. The margaritas are frozen right inside the tequila bottle.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Pour 1 1/4 cups tequila from the bottle and reserve for another use."
    },
    {
      "position": 2,
      "text": "Add lime juice, triple sec, agave, and salt to the bottle of tequila and place top on the bottle. Tilt bottle to lightly shake mixture until agave has been well incorporated."
    },
    {
      "position": 3,
      "text": "Place bottle in the freezer for at least 8 hours or until ready to serve."
    },
    {
      "position": 4,
      "text": "To serve, add 1 cup ice to a shaker or glass and top with about 1/2 cup of margarita mix. Shake mixture or pour margarita between two glasses until well blended and slightly frothy. Serve immediately with more ice if desired. This step is important to balance the taste through slight dilution from the ice."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

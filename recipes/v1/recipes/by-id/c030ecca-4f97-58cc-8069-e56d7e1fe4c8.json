  "slug": "creamy-chicken-ramen-soup-with-dill",
  "name": "Creamy Chicken Ramen Soup with Dill",
  "recipe_type": "soup",
  "brief_description": "Try this quick and easy creamy chicken ramen soup when you're not in the mood for cooking.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water to a boil in a saucepan. Break up noodles and toss into boiling water. Cook until tender, about 3 minutes. Stir in chicken, sour cream, seasoning packet, and dill. Simmer until heated through. Serve garnished with green onions."
    }
  ],

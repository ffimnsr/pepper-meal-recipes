  "id": "6c4a2efc-00fc-5ed0-b931-6ae1a19dbab4",
  "slug": "spanish-rice-bake",
  "name": "Spanish Rice Bake",
  "recipe_type": "dessert",
  "brief_description": "Ground beef, fresh onion, green bell pepper, tomatoes and rice are simmered in a sweet-hot sauce then baked with Cheddar and garnished with fresh cilantro.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Brown the ground beef in a large skillet over medium-high heat. Drain excess fat and transfer beef to a large pot over medium low heat.. Stir in the onion, green bell pepper, tomatoes, water, rice, chile sauce, salt, brown sugar, cumin, Worcestershire sauce and ground black pepper."
    },
    {
      "position": 3,
      "text": "Let this simmer for about 30 minutes, stirring occasionally, then transport this to a 2-quart casserole dish. Press down firmly and sprinkle with the shredded Cheddar cheese."
    },
    {
      "position": 4,
      "text": "Bake at 375 degrees F (190 degrees C) for 10 to 15 minutes, or until cheese is melted and bubbly. Garnish with chopped fresh cilantro."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "e2c53ab3-a326-5f7e-bcef-5803d586ac54",
  "slug": "chicken-club-pasta-salad",
  "name": "Club Chicken Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "This chicken pasta salad with crispy bacon, juicy tomatoes, tender chicken, and corkscrew pasta tossed in a creamy dressing is simple and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook pasta in the boiling water, stirring occasionally, until tender yet firm to the bite, about 10 to12 minutes. Drain and rinse under cold water."
    },
    {
      "position": 3,
      "text": "Whisk Italian-style dressing and mayonnaise together in a large bowl."
    },
    {
      "position": 4,
      "text": "Stir in pasta, chicken, bacon, tomatoes, cheese, celery, green bell pepper, and avocado until evenly coated."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

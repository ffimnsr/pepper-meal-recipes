  "id": "47e84727-88f8-5fc6-9120-f6d87acb35ed",
  "slug": "bacon-cheddar-jalapeno-poppers",
  "name": "Bacon Cheddar Jalapeno Poppers",
  "recipe_type": "appetizer",
  "brief_description": "Quick & easy! Only 3 ingredients required: bacon, a block of Cheddar cheese and jalapeno peppers. The men in my family are crazy about these yummy treats. In fact, my husband often eats them as a meal!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the broiler."
    },
    {
      "position": 2,
      "text": "Cut Cheddar cheese into 12 slices long enough to fit inside the jalapeno halves. Insert cheese slices into the halves. Wrap the jalapeno halves with the bacon slices, securing with a toothpick, if necessary. Place on a medium baking sheet."
    },
    {
      "position": 3,
      "text": "Broil 5 to 10 minutes, or until the bacon is evenly brown."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

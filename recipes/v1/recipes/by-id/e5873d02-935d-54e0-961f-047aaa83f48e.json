  "id": "e5873d02-935d-54e0-961f-047aaa83f48e",
  "slug": "nancys-boiled-gazpacho",
  "name": "Nancy's Boiled Gazpacho",
  "recipe_type": "soup",
  "brief_description": "Nancy's boiled gazpacho recipe makes a cold soup that includes beef bouillon and tomato juice, stirred into a colorful combination of fresh veggies.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Simmer tomato juice in a medium saucepan over medium-high heat; stir in bouillon cubes until dissolved, about 5 minutes. Off heat, add tomato, cucumber, onion, bell pepper, vinegar, oil, celery, Worcestershire sauce, and hot sauce. Cover soup; chill in the refrigerator before serving, 6 to 8 hours."
    }
  ],
  "servings": 6,

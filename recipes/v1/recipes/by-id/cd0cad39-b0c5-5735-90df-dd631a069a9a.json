  "id": "cd0cad39-b0c5-5735-90df-dd631a069a9a",
  "slug": "quick-and-easy-hush-puppies",
  "name": "Quick and Easy Hush Puppies",
  "recipe_type": "appetizer",
  "brief_description": "These quick and easy hush puppies use corn muffin mix and are nicely spiced with garlic and onion powder.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Mix corn muffin mix, salt, garlic powder, onion powder, black pepper, and cayenne pepper in a bowl until blended."
    },
    {
      "position": 2,
      "text": "Stir eggs and evaporated milk into dry ingredients until moistened."
    },
    {
      "position": 3,
      "text": "Stir cream-style corn into mixture to make a moist batter. Let batter stand while oil heats."
    },
    {
      "position": 4,
      "text": "Heat oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C)."
    },
    {
      "position": 5,
      "text": "Gently drop a teaspoon of batter at a time into the hot oil, staying as close to the oil as possible to avoid splattering. Fry hush puppies until golden brown, about 3 minutes per batch."
    },
    {
      "position": 6,
      "text": "Remove hush puppies with a slotted spoon and place on a paper towel-lined plate to drain. Sprinkle with salt if desired."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 15,

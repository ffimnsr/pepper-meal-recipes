  "id": "b21bee42-cb2d-5ce5-b603-c0bb4a27f7d2",
  "slug": "blue-ribbon-sugar-cookies",
  "name": "Blue Ribbon Sugar Cookies",
  "recipe_type": "dessert",
  "brief_description": "A light, crispy but tender sugar cookie loaded with flavor. These cookies are especially requested at Christmas. They're easy and definitely a crowd-pleaser.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Sift together the flour, cream of tartar, baking soda and salt; set aside."
    },
    {
      "position": 3,
      "text": "In a large bowl, cream together the butter, oil, confectioners' sugar and white sugar until well blended. Stir in the eggs, vanilla and lemon extracts. Gradually mix in the dry ingredients until well blended."
    },
    {
      "position": 4,
      "text": "Roll the dough into walnut sized balls. Place the cookies 2 inches apart onto the cookie sheet. Flatten cookies to 1/8 inch thickness using the bottom of a glass dipped in sugar. Colored sugar may be used if you do not plan to frost cookies later."
    },
    {
      "position": 5,
      "text": "Bake for 9 to 12 minutes in the preheated oven, or until the edges are golden brown. Allow cookies to cool on baking sheet for 5 minutes before removing to a wire rack to cool completely."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "b6acd0c4-4b86-5330-be67-6462362525fe",
  "slug": "grilled-cheese-sandwich",
  "name": "Grilled Cheese Sandwich",
  "recipe_type": "soup",
  "brief_description": "Learn how to make a grilled cheese sandwich in a nonstick pan with buttered bread and sliced Cheddar; serve with tomato soup for a comforting classic.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat a nonstick skillet over medium heat. Generously butter one side each bread slice."
    },
    {
      "position": 3,
      "text": "Place 1 slice bread, butter-side down, in the hot skillet; top with 1 slice cheese."
    },
    {
      "position": 4,
      "text": "Place 1 slice bread, butter-side up, on top cheese."
    },
    {
      "position": 5,
      "text": "Cook until lightly browned on one side; flip and continue cooking until cheese is melted."
    },
    {
      "position": 6,
      "text": "Repeat with remaining bread and cheese slices. Serve and enjoy!"
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

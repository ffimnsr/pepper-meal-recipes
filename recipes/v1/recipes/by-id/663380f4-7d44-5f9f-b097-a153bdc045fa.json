  "id": "663380f4-7d44-5f9f-b097-a153bdc045fa",
  "slug": "stuffed-portobello-mushrooms-with-spinach-and-feta",
  "name": "Stuffed Portobello Mushrooms with Spinach and Feta",
  "recipe_type": "appetizer",
  "brief_description": "Stuffed portobello mushroom caps loaded with spinach, fresh tomatoes, and feta cheese are perfect for a vegetarian lunch or dinner, or a side dish alongside any meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line two 9x13-inch baking pans with parchment paper."
    },
    {
      "position": 2,
      "text": "Place 2 mushroom caps in each prepared baking pan. Place 2 tablespoons feta cheese in each cap, then top with 1/4 cup spinach and 2 more tablespoons feta. Layer tomato slices over top, sprinkle with garlic, and season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 30 minutes."
    },
    {
      "position": 4,
      "text": "Drizzle with balsamic vinegar just before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "105b54f2-aa3e-5edd-bb12-da84b448d5ec",
  "slug": "passion-fruit-margarita-recipe-7499354",
  "name": "Passion Fruit Margarita",
  "recipe_type": "appetizer",
  "brief_description": "In this passion fruit margarita, bold tropical flavors take center stage.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Sprinkle salt onto a plate. Moisten the rim of a glass with lime wedge and press the moistened rim into the salt; fill the glass with ice."
    },
    {
      "position": 2,
      "text": "Fill a cocktail shaker half-full with ice. Add passion fruit juice, tequila, triple sec, and lime juice to the shaker. Seal and shake vigorously until outside is frosted, 10 to 15 seconds. Strain mixture into the glass and stir. Garnish with lime wedge."
    }
  ],
  "servings": 1,

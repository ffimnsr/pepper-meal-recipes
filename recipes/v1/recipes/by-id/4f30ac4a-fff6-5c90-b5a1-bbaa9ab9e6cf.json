  "id": "4f30ac4a-fff6-5c90-b5a1-bbaa9ab9e6cf",
  "slug": "crispy-egg-salad-recipe-11869439",
  "name": "Crispy Egg Salad",
  "recipe_type": "salad",
  "brief_description": "This crispy egg salad is unlike any egg salad you've ever had\u2014crispy on the outside, creamy on the inside, with a little bit of heat. If you're a fan of a spicy dill flavor profile, feel free to add dill pickle relish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk mayonnaise, Sriracha, pepper Jack cheese, and green onion together in a bowl until evenly combined. Gently fold in chopped egg; season with salt and pepper."
    },
    {
      "position": 2,
      "text": "Heat a large nonstick skillet over medium-high heat. Lightly spray skillet with non-stick cooking spray."
    },
    {
      "position": 3,
      "text": "Place 1/4 of egg salad in the skillet. Lightly smash egg salad down with a spatula. Cook for 1 minute. Flip mixture over and cook 1 minute more. Transfer the patty to a plate immediately. Repeat with remaining egg salad."
    },
    {
      "position": 4,
      "text": "Serve on buns or toast; top with sliced avocados."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

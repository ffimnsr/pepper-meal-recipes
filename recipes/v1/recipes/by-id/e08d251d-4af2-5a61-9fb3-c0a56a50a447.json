{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "e08d251d-4af2-5a61-9fb3-c0a56a50a447",
  "slug": "sloppy-joe-shepherd-s-pie-recipe-8711666",
  "name": "Sloppy Joe Shepherd\u2019s Pie",
  "recipe_type": "main",
  "brief_description": "Sloppy Joe shepherd's pie is a perfect mashup of 2 classic dinner dishes. The meat mixture is rich and savory and topped with cheesy mashed potatoes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat oil in a 12-inch cast iron skillet over medium-high heat. Add garlic; cook, stirring constantly, until fragrant, about 1 minute. Add ground chuck; cook, stirring to crumble beef into small pieces, until browned, about 6 minutes. Remove from heat; spoon drippings into a small bowl. Let drippings cool, then discard."
    },
    {
      "position": 3,
      "text": "Add onion to skillet; cook over medium, stirring often, until onions have softened, about 3 minutes. Stir in water, bouillon, sugar, mustard, and pepper until well combined. Stir in crushed tomatoes, ketchup, and Worcestershire sauce until well combined. Bring to a simmer over medium-high; cook, stirring occasionally, until sauce is slightly thickened and glossy, 2 to 3 minutes. Remove from heat."
    },
    {
      "position": 4,
      "text": "Spoon mashed potatoes over beef mixture in skillet and gently spread into an even layer to cover beef completely."
    },
    {
      "position": 5,
      "text": "Sprinkle evenly with cheeses."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until potatoes are heated through and cheese is melted, about 10 minutes. Increase oven temperature to broil; do not remove skillet. Broil until cheese is lightly browned, 4 to 5 minutes. Let stand 5 minutes; garnish with chives, and serve. Recipe developed by Giovanna Vazquez"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "5f8d8d83-2922-5d8c-998f-1a5e19bc179a",
  "slug": "indian-style-sheekh-kabab",
  "name": "Indian-Style Seekh Kebab",
  "recipe_type": "salad",
  "brief_description": "These spicy lamb seekh kebabs are seasoned with green chili paste, spices, mint, cilantro, and ginger. Delicious with a salad, mint chutney, and naan.",
  "cuisine": "Indian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Mix ground lamb, onions, mint, cilantro, ginger paste, and chile paste together in a large bowl. Season with cumin, coriander, paprika, salt, and cayenne. Cover and chill in the refrigerator for 2 hours. Soak skewers in cold water."
    },
    {
      "position": 2,
      "text": "Divide lamb mixture into 8 equal portions; mold portions onto skewers to form a sausage shape. Refrigerate skewers until you are ready to grill."
    },
    {
      "position": 3,
      "text": "Preheat an outdoor grill for high heat and brush the grate liberally with oil."
    },
    {
      "position": 4,
      "text": "Cook skewers on the preheated grill, turning frequently, until nicely browned on all sides and meat is no longer pink in the center, about 10 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (71 degrees C)."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

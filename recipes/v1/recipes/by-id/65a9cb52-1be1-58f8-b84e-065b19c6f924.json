{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "65a9cb52-1be1-58f8-b84e-065b19c6f924",
  "slug": "mushroom-burger-casserole-recipe-11953831",
  "name": "Mushroom Burger Casserole",
  "recipe_type": "side",
  "brief_description": "This mushroom burger casserole is so hearty; it can satisfy the biggest appetite. With sliced mushrooms, ground beef, Swiss cheese, and Tater Tots on both top and bottom, this is the mushroom Swiss burger of casserole dreams. Serve with dill pickle chips on the side for the true burger experience.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Coat a medium oval baking dish with cooking spray. Place half the Tater Tots in the dish; mash them gently to cover the bottom of the dish."
    },
    {
      "position": 3,
      "text": "Par-bake in the preheated oven for about 10 minutes. Tater tot crust will not be fully cooked."
    },
    {
      "position": 4,
      "text": "Meanwhile, heat a medium to large cast iron skillet over medium heat. Add hamburger and onion; cook and stir, using a spatula to break up the meat, for 5 minutes. Add mushrooms and continue to cook until meat is browned and vegetables are soft, about 5 minutes more. Drain grease if necessary."
    },
    {
      "position": 5,
      "text": "Add ketchup, Worcestershire sauce, mustard, garlic powder, salt, and pepper. Cook until bubbly."
    },
    {
      "position": 6,
      "text": "Transfer mixture into dish; spread evenly over Tater Tot crust. Top evenly with Swiss cheese slices, then distribute remaining tater tots evenly over cheese."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until casserole is bubbly and Tots are golden brown, about 30 minutes. Let cool for 5 minutes before serving."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

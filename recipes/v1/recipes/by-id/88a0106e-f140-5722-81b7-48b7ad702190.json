  "slug": "crunchy-radish-and-two-bean-salad-recipe-11686923",
  "name": "Crunchy Radish and Two-Bean Salad",
  "recipe_type": "salad",
  "brief_description": "In this crunchy radish and two-bean salad, rainbow chard, sugar snap peas, and carrots hold their texture when tossed with a creamy stir-together yogurt dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "For dressing, whisk together yogurt, oil, lemon zest and juice, honey, salt, pepper, paprika, and cumin in a small bowl."
    },
    {
      "position": 2,
      "text": "In a large bowl, stir together cannellini and kidney beans, chard, snap peas, radishes, quinoa, carrot, feta, onion, and dill. Add dressing; toss to coat. Chill, covered, at least 30 minutes, or up to 4 days."
    }
  ],
  "servings": 6,

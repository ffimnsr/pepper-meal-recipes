  "id": "9b48ab59-ce07-55c9-9f99-e55f300b6ba7",
  "slug": "pumpkin-pie-with-truvia-natural-sweetener",
  "name": "Pumpkin Pie with Truvia\u00ae Natural Sweetener",
  "recipe_type": "dessert",
  "brief_description": "This traditional favorite is sweetened with the natural goodness of Truvia\u00ae natural sweetener. This pie has 80% less sugar and contains 30% fewer calories* than a full sugar pie.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 400 degrees F."
    },
    {
      "position": 2,
      "text": "Roll out pastry on floured surface 1 inch larger than inverted 9-inch pie pan."
    },
    {
      "position": 3,
      "text": "Ease pastry into pan; flute and trim edge."
    },
    {
      "position": 4,
      "text": "Mix pumpkin, evaporated milk, and eggs on medium speed until well blended; add additional ingredients; mix well."
    },
    {
      "position": 5,
      "text": "Pour mixture into prepared pastry shell."
    },
    {
      "position": 6,
      "text": "Bake for 35 to 40 minutes or until knife inserted into center comes out clean."
    },
    {
      "position": 7,
      "text": "Cool on wire rack."
    },
    {
      "position": 8,
      "text": "Top with whipped topping, if desired."
    }
  ],
  "servings": 8,

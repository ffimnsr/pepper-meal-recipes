  "id": "ee07e002-e2ca-567b-aaed-e654d2acf094",
  "slug": "almond-flour-brownies",
  "name": "Almond Flour Brownies",
  "recipe_type": "dessert",
  "brief_description": "These almond flour brownies are easy to make in one bowl for a fudgy, gluten-free, and grain-free version of chocolate brownies everyone will love!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix almond flour, agave nectar, walnuts, eggs, cocoa powder, coconut oil, and vanilla extract together in a bowl; spread into an 8-inch square baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until edges of brownies begin to pull from sides of dish, about 30 minutes. Let brownies cool slightly before slicing, about 5 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

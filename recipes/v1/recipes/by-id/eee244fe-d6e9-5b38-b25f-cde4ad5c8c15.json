  "id": "eee244fe-d6e9-5b38-b25f-cde4ad5c8c15",
  "slug": "one-pot-tuscan-shrimp-and-orzo-recipe-8763377",
  "name": "One Pot Tuscan Shrimp and Orzo",
  "recipe_type": "main",
  "brief_description": "This one pot Tuscan shrimp and orzo is hearty yet elegant, every bite bursting with Tuscan-inspired flavors. It\u2019s comfort food with a sophisticated twist, perfect for a special dinner or a cozy night in.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a Dutch oven over medium heat. Add shallots, and cook until translucent, 3 to 5 minutes. Add garlic, and stir until fragrant, about 45 seconds."
    },
    {
      "position": 3,
      "text": "Add in orzo; cook and stir until orzo is lightly toasted, about 1 minute. Stir in tomato paste and Cantanzaro herbs; season with salt and pepper."
    },
    {
      "position": 4,
      "text": "Pour in 3 cups vegetable broth and whipping cream. Stir remaining 1 cup broth into Greek yogurt; pour into the Dutch oven. Stir in sundried tomatoes."
    },
    {
      "position": 5,
      "text": "Cook orzo, uncovered, stirring constantly, over medium heat until orzo is just tender with a bite, 15 to 20 minutes."
    },
    {
      "position": 6,
      "text": "Stir shrimp and fresh spinach into cooked orzo, and cook until shrimp is pink and opaque and spinach is wilted, about 4 minutes. Taste; season with salt and pepper."
    },
    {
      "position": 7,
      "text": "Remove from heat; serve immediately with fresh basil. Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

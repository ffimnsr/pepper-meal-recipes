  "id": "7ce8f710-136c-5c7c-b04c-c7a5a8790226",
  "slug": "passover-matzo-lasagna",
  "name": "Passover Matzo Lasagna",
  "recipe_type": "main",
  "brief_description": "This lasagna made with matzo sheets instead of lasagna noodles, cottage cheese, mozzarella, and marinara sauce is easy to prep for a tasty Passover dish.",
  "cuisine": "Jewish American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Soak matzo sheets in a large bowl of hot water until tender, about 30 seconds; drain."
    },
    {
      "position": 3,
      "text": "Combine eggs, cottage cheese, and 1/2 of the mozzarella cheese in a bowl. Pour 1/2 cup of marinara sauce on the bottom of a 9x13-inch baking pan. Place 2 matzo sheets over the sauce, then pour another layer of sauce over matzo. Spread 1/2 of the cheese mixture on top, then another layer of sauce. Continue layering until all the matzo sheets are used, finishing with a layer of sauce. Sprinkle the remaining mozzarella cheese over the top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until cheese is melted and sauce is bubbly, about 30 to 40 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

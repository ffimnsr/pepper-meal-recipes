  "schema_version": 1,
  "id": "4605baff-fc4c-53d0-81cc-ac01ecaf93d4",
  "slug": "authentic-mexican-enchiladas",
  "name": "Authentic Mexican Enchiladas",
  "recipe_type": "main",
  "brief_description": "This Mexican enchiladas recipe is the real thing. Corn tortillas are dipped in homemade sauce, fried, and filled with queso fresco and more favorites.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Snap tops off of dried chiles and place in a saucepan with enough water to cover. Bring to a boil and simmer for 15 minutes. Drain water and place chiles into a food processor or blender with garlic and salt. Pur\u00e9e until smooth. Press sauce through a strainer and set aside."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over medium heat. Soak each tortilla in the sauce, then place in the hot oil. Turn over almost immediately and fry for about 5 seconds on the other side. Remove to a plate that is lined with paper towels, stacking them on top of each other to keep them pliable for filling."
    },
    {
      "position": 3,
      "text": "Take one fried tortilla at a time and fill with about 2 tablespoons queso fresco. Roll up and place seam side down on a plate. Place three of these on each plate."
    },
    {
      "position": 4,
      "text": "Top tortillas in the following order: Start with a layer of sour cream, then a small handful of lettuce, three tomato slices, 2 more tablespoons queso fresco, and 1 tablespoon green onions."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "medium",

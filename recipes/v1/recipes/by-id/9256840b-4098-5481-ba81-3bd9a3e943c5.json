  "id": "9256840b-4098-5481-ba81-3bd9a3e943c5",
  "slug": "deconstructed-spam-musubi",
  "name": "Deconstructed Spam Musubi",
  "recipe_type": "side",
  "brief_description": "Make a deconstructed Spam musubi bowl and enjoy the tasty trio of rice, Spam, and seaweed with a fork and knife, since not everyone owns a musubi maker!",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Mix sugar, soy sauce, and oyster sauce together in a resealable gallon-sized bag. Add Spam and seal the bag; turn the bag, gently squeezing to coat Spam. Marinate for at least 1 hour."
    },
    {
      "position": 2,
      "text": "Bring water to a boil; add rice. Return to a boil, then reduce the heat to low and simmer until liquid is absorbed and rice is tender, about 15 minutes. Stir vinegar into rice until combined."
    },
    {
      "position": 3,
      "text": "When the rice is almost finished cooking, heat a skillet over medium-high heat. Add Spam and marinade. Cook, stirring frequently, until Spam is browned and marinade is absorbed, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Stir rice and seaweed together in a bowl; add luncheon meat and mix well."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

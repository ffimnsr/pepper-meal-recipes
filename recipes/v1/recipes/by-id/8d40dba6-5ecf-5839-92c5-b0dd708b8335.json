  "id": "8d40dba6-5ecf-5839-92c5-b0dd708b8335",
  "slug": "shrimp-and-feta-cheese-pasta",
  "name": "Shrimp and Feta Cheese Pasta",
  "recipe_type": "main",
  "brief_description": "Shrimp is cooked in garlic and white wine, then tossed with pasta and feta in a fresh tomato sauce.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a medium skillet over medium heat, heat 2 tablespoons olive oil. Cook shrimp, garlic and white wine for 5 minutes, or until shrimp is pink. Remove shrimp with slotted spoon and set aside."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain."
    },
    {
      "position": 3,
      "text": "While pasta is cooking, cook tomatoes with remaining 1 tablespoon oil, oregano and basil over medium heat in wine mixture until tender, 10 minutes."
    },
    {
      "position": 4,
      "text": "Toss hot pasta with shrimp, tomato sauce and feta. Feta will melt slightly. Serve."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

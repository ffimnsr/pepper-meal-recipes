  "id": "08df68c5-44d4-5b45-aede-b6913337488a",
  "slug": "italian-hamburger-steaks-recipe-11835393",
  "name": "Italian Hamburger Steaks",
  "recipe_type": "salad",
  "brief_description": "These Italian hamburger steak come out really nice and moist. Serve with garlic bread and a crunchy salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat oven to 375 degrees F (190 degrees C)"
    },
    {
      "position": 2,
      "text": "Beat egg lightly in a large bowl. Stir in bread crumbs. Add 1/3 cup marinara sauce, the onion, garlic, Italian seasoning, salt, and crushed red pepper; stir to combine. Add ground beef; mix lightly until combined."
    },
    {
      "position": 3,
      "text": "Shape into six oval patties that are 4-inches long and 1-inch thick."
    },
    {
      "position": 4,
      "text": "Heat oil in a 12-inch oven-going skillet over medium-high. Add patties to skillet. Cook until browned, 2 minutes on each side. Remove skillet from heat."
    },
    {
      "position": 5,
      "text": "Spoon remaining 2/3 cup marinara over the patties. Top with cheese."
    },
    {
      "position": 6,
      "text": "Bake in the skillet until cheese melts and patties are done when tested with an instant-read thermometer, (165 degrees F or 74 degrees C) about 15 minutes. Garnish with basil, if desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

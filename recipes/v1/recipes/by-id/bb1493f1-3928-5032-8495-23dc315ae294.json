  "id": "bb1493f1-3928-5032-8495-23dc315ae294",
  "slug": "chili-shepherd-s-pie-recipe-11791554",
  "name": "Chili Shepherd's Pie",
  "recipe_type": "main",
  "brief_description": "This chili shepherd's pie features ground beef and homemade mashed potatoes.",
  "cuisine": "Scottish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Place potatoes in a large saucepan with enough salted water to cover. Bring to a boil. Reduce heat and simmer until potatoes are tender, about 20 minutes; drain and return to saucepan."
    },
    {
      "position": 3,
      "text": "Add butter and let stand for 2 minutes. Mash until smooth."
    },
    {
      "position": 4,
      "text": "Add sour cream, milk, salt and pepper; mash until combined."
    },
    {
      "position": 5,
      "text": "Fold in 3/4 cup Cheddar cheese and green onion."
    },
    {
      "position": 6,
      "text": "Meanwhile, cook ground beef in a large saucepan until browned, about 8 minutes; drain fat. Add chili and corn; heat until it comes to a simmer, about 5 minutes."
    },
    {
      "position": 7,
      "text": "Add chili mixture to the prepared baking dish."
    },
    {
      "position": 8,
      "text": "Spoon mashed potatoes over the chili and smooth to an even layer. Sprinkle with remaining 1/4 cup Cheddar cheese."
    },
    {
      "position": 9,
      "text": "Bake until hot and bubbly, about 15 minutes. Garnish with additional green onions."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

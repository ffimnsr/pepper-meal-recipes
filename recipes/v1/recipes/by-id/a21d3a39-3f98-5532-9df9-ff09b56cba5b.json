{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "a21d3a39-3f98-5532-9df9-ff09b56cba5b",
  "slug": "gochujang-pork-belly-bites-recipe-11784193",
  "name": "Gochujang Pork Belly Bites",
  "recipe_type": "appetizer",
  "brief_description": "These gochujang pork belly bites are sweet and spicy, crispy and crunchy, and absolutely delicious. Whether you finish them with the gochujang sauce in the air fryer, or just dip them in the sauce at the end, they are irresistibly good.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place pork belly pieces in the basket in a single layer, not touching. Air fry for 8 to 9 minutes; turn over and air fry for 6 to 7 minutes more."
    },
    {
      "position": 3,
      "text": "Meanwhile, for sauce, stir gochujang, soy sauce, hot honey, and ginger together in a medium bowl."
    },
    {
      "position": 4,
      "text": "Remove pork belly from air fryer basket; toss in sauce to coat. Return to the air fryer and fry until bites begin to char at the edges, 8 to 11 minutes more. (Alternately, you can use sauce only for dipping; in this case, continue to fry without removing bites, until they begin to char, 6 to 7 minutes.)"
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

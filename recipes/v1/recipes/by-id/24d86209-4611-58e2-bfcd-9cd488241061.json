  "id": "24d86209-4611-58e2-bfcd-9cd488241061",
  "slug": "shrimp-grilled-cheese-sandwich-recipe-11810409",
  "name": "Shrimp Grilled Cheese Sandwich",
  "recipe_type": "main",
  "brief_description": "This shrimp grilled cheese sandwich features garlic butter-sauteed shrimp encased in melted Cheddar and Colby Jack cheese, in a hot toasted sandwich.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place a large skillet over medium heat. Add 1 teaspoon butter. Add shrimp. Sprinkle shrimp with garlic granules."
    },
    {
      "position": 2,
      "text": "Cook until shrimp are pink, opaque, and slightly curled into a loose \u201cC\u201d shape, 1 to 2 minutes per side, depending on size. Remove shrimp to a cutting board and chop roughly."
    },
    {
      "position": 3,
      "text": "Spread a thin layer of softened butter on 1 side of each bread slice. Place bread buttered side down in the same skillet. Place a slice of Colby Jack cheese on bread, top with shrimp pieces. Place Cheddar cheese slice on top of shrimp. Place remaining bread slice on top of sandwich, buttered side up. Cook until bread is golden on the bottom, 2 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Carefully turn sandwich over with a spatula. Cook the other side until golden and cheese is fully melted, 2 to 3 minutes. If cheese is not melted by the time sandwich is golden, cover the skillet for 30 to 60 seconds."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,

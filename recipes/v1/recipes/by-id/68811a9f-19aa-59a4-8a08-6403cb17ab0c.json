  "id": "68811a9f-19aa-59a4-8a08-6403cb17ab0c",
  "slug": "simply-the-best-chicken-waldorf-salad",
  "name": "Simply The Best Chicken Waldorf Salad",
  "recipe_type": "salad",
  "brief_description": "A version of popular Waldorf salad made with chicken breasts, roasted walnuts, apple, dried cranberries, and grapes is served in a light mayonnaise and yogurt dressing.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Spread chopped walnuts onto a baking sheet."
    },
    {
      "position": 3,
      "text": "Roast walnuts in the preheated oven until they are fragrant and browned, 3 to 5 minutes. Remove and let cool."
    },
    {
      "position": 4,
      "text": "Lightly toss chicken with grape halves, cranberries, apple, walnuts, and onion in a salad bowl. Whisk mayonnaise, vanilla yogurt, and lemon juice in a separate bowl. Pour dressing over salad and toss again to coat."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,

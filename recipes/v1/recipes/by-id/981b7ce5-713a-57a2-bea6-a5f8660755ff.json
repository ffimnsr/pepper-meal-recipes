  "id": "981b7ce5-713a-57a2-bea6-a5f8660755ff",
  "slug": "easy-strawberry-brownies-recipe-11696682",
  "name": "Easy Strawberry Brownies",
  "recipe_type": "dessert",
  "brief_description": "These easy strawberry brownies are made with strawberry cake mix, and iced with a fresh strawberry glaze.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Lightly grease an 11x7-inch baking dish."
    },
    {
      "position": 2,
      "text": "Mix cake mix, melted butter, eggs, and 1 teaspoon vanilla extract in a bowl until well combined. Spread mixture into an even layer in the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick comes out clean when inserted into the center, 16 to 18 minutes. Allow brownies to cool in the pan for about 20 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, puree strawberries and remaining teaspoon of vanilla extract in a food processor or with an immersion blender until smooth."
    },
    {
      "position": 5,
      "text": "Stir strawberry mixture into confectioner\u2019s sugar until smooth, adding extra sugar as necessary to reach the consistency of a glaze. Add salt and stir."
    },
    {
      "position": 6,
      "text": "Spread strawberry glaze evenly over the cooled brownies and let stand until completely cooled. Cut into 12 squares, or refrigerate until ready to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

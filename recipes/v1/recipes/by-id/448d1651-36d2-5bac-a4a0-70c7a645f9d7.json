  "id": "448d1651-36d2-5bac-a4a0-70c7a645f9d7",
  "slug": "scottish-oat-scones",
  "name": "Scottish Oat Scones",
  "recipe_type": "dessert",
  "brief_description": "These oatmeal scones are made with currants, egg, sugar, butter, milk, and lots of rolled oats for a softly sweet and heart-healthy breakfast pastry.",
  "cuisine": "Scottish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Lightly grease a baking sheet."
    },
    {
      "position": 2,
      "text": "Mix together oats, flour, currants, sugar, baking powder, and salt in a large bowl; make a well in the center. Beat egg in a medium bowl until frothy; stir in melted butter and milk. Pour into the well and mix until a soft dough forms."
    },
    {
      "position": 3,
      "text": "Transfer dough to a clean work surface. Divide dough into 2 equal pieces, then pat each piece into a 1/2-inch-thick circle. Place dough circles onto the prepared baking sheet; score each into 8 wedges."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until risen and browned, about 15 minutes. Split wedges and serve warm."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

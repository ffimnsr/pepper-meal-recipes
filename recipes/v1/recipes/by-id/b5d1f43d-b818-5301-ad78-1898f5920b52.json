  "id": "b5d1f43d-b818-5301-ad78-1898f5920b52",
  "slug": "banana-cream-pie-i",
  "name": "Banana Cream Pie",
  "recipe_type": "dessert",
  "brief_description": "This yummy banana cream pie made with lots of bananas and a rich, creamy homemade pudding in a pre-baked pie crust is a family-pleasing dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine sugar, flour, and salt in a saucepan. Gradually stir in milk."
    },
    {
      "position": 3,
      "text": "Cook, stirring constantly, over medium heat until mixture boils and thickens. Continue to cook and stir for 2 more minutes, then remove from the heat. Place egg yolks in a medium bowl; whisk in a small amount of the hot milk mixture until smooth, then gradually whisk egg yolk mixture into the saucepan."
    },
    {
      "position": 4,
      "text": "Cook over medium-low heat, stirring constantly until mixture coats the back of a spoon, about 2 more minutes. Remove from heat and stir in butter and vanilla."
    },
    {
      "position": 5,
      "text": "Fill pastry shell with sliced bananas; pour pudding mixture on top to cover."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until filling sets, 12 to 15 minutes."
    },
    {
      "position": 7,
      "text": "Let pie cool completely on a wire rack, then chill pie in the refrigerator for at least 1 hour before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

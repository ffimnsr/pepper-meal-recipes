  "id": "e830d682-877e-5262-a1ec-a417ba632e88",
  "slug": "crunchy-almond-biscotti",
  "name": "Crunchy Almond Biscotti",
  "recipe_type": "dessert",
  "brief_description": "Almond biscotti are wonderfully crunchy cookies perfect for dipping in your morning coffee. These cookies stay fresh in an airtight container.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Spread almonds in a single layer on a baking sheet."
    },
    {
      "position": 3,
      "text": "Toast almonds in the preheated oven until lightly browned and fragrant, 8 to 10 minutes. Allow almonds to cool."
    },
    {
      "position": 4,
      "text": "Reduce oven temperature to 300 degrees F (150 degrees C). Lightly grease a baking sheet."
    },
    {
      "position": 5,
      "text": "Lightly beat eggs, vanilla, and almond extract in a medium bowl. Combine flour, sugar, baking powder, and salt in a large bowl. Gradually beat egg mixture into flour mixture with an electric mixer until dough comes together. Add toasted almonds and mix until just incorporated."
    },
    {
      "position": 6,
      "text": "Turn dough out on a lightly floured surface and shape dough into a 3x14-inch log. Transfer log to the prepared baking sheet."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until firm to the touch, 30 to 40 minutes. Allow log to cool on a wire rack for 10 minutes. Transfer log to a cutting board and cut into 1/2-inch-thick slices using a serrated knife. Return biscotti slices to the baking sheet."
    },
    {
      "position": 8,
      "text": "Return biscotti to the oven and bake until firm to the touch, about 20 minutes. Flip each cookie and continue baking until toasted, about 20 minutes more. Cool biscotti completely before storing in an airtight container."
    }
  ],
  "servings": 28,
  "cooking_time_minutes": 80,

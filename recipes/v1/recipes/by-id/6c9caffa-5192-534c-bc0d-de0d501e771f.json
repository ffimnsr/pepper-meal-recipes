  "id": "6c9caffa-5192-534c-bc0d-de0d501e771f",
  "slug": "easy-shepherds-pie-with-garlic-romano-potatoes",
  "name": "Easy Shepherd's Pie with Garlic Romano Potatoes",
  "recipe_type": "main",
  "brief_description": "This easy shepherd's pie is topped with mouthwatering mashed potatoes flavored with garlic and Romano cheese for a dish the whole family will love.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a medium baking dish."
    },
    {
      "position": 2,
      "text": "Place beef and onion in a large skillet over medium heat. Season with rosemary and basil. Cook and stir until beef is evenly browned; drain grease. Mix in mixed vegetables, diced tomatoes, and tomato sauce. Cook and stir until vegetables are heated through. Transfer to the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Place potatoes in a large pot with enough water to cover; bring to a boil. Cook until tender, about 10 minutes. Remove from heat and drain."
    },
    {
      "position": 4,
      "text": "Add butter, Romano cheese, milk, garlic, salt, and oregano to potatoes in the pot. Mash together with a potato masher until smooth. Spread mashed potatoes over beef and vegetable mixture in the baking dish."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 30 minutes. Turn the oven broiler to high and continue cooking until the top of potatoes are golden brown, about 3 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

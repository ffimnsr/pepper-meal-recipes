  "id": "492e9fdf-7c61-5477-b904-efeaca3af04f",
  "slug": "honey-roasted-carrots",
  "name": "Honey Roasted Carrots",
  "recipe_type": "dessert",
  "brief_description": "These honey roasted carrots are baked whole, glazed with honey, until deliciously sweet, tender, and caramelized to make a sensational side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place whole carrots in a baking dish and drizzle with olive oil; toss until carrots are completely covered with oil. Drizzle honey over carrots, then season with salt and pepper; mix until well coated."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until carrots are just tender, about 30 minutes, or longer if you prefer softer carrots."
    },
    {
      "position": 4,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,

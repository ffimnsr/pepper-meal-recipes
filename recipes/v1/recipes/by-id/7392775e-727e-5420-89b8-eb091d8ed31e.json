  "id": "7392775e-727e-5420-89b8-eb091d8ed31e",
  "slug": "baked-lamb-meatballs",
  "name": "Baked Lamb Meatballs",
  "recipe_type": "main",
  "brief_description": "Yogurt, raisins, cilantro, and dried herbs jazz up these easy-to-make lamb meatballs; just mix everything together and bake!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix lamb, bread, yogurt, raisins, cilantro, garlic, oregano, basil, salt, and pepper together in a bowl. Shape into 1-inch balls and place on a greased baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until meatballs are browned on the outsides and only slightly pink in the centers, about 20 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

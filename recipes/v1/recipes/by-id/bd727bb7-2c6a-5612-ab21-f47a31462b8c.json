  "id": "bd727bb7-2c6a-5612-ab21-f47a31462b8c",
  "slug": "super-duper-zucchini-muffins",
  "name": "Super Duper Zucchini Muffins",
  "recipe_type": null,
  "brief_description": "All zucchini muffin recipes are not created equal. This super duper one is sure to win a blue ribbon for it\u2019s nutrition, taste, and texture trifecta.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 12-cup muffin tin or line with paper liners."
    },
    {
      "position": 2,
      "text": "Combine flour and sugar in a large bowl; stir in baking powder, cinnamon, nutmeg, baking soda, and salt. Cut in shortening until mixture resembles coarse crumbs; make a well in the center. Stir zucchini, eggs, sour milk, and vanilla extract into well to combine; fold in walnuts. Spoon batter into the prepared muffin cups, filling each \u2154 to \u00be full; sprinkle tops with brown sugar."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 15 to 20 minutes. Cool."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

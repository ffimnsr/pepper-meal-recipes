  "id": "e6df8fab-0ca7-5675-b884-3afd861610a4",
  "slug": "jalapeno-popper-potato-salad-recipe-8682267",
  "name": "Jalapeno Popper Potato Salad",
  "recipe_type": "salad",
  "brief_description": "This jalapeno popper potato salad has the heat, the salty bacon, the cheese, and the creamy ranch-seasoned dressing that put jalapeno poppers top of mind. Bacon and potatoes roast at the same time, making prep easier.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line 2 rimmed baking sheets with foil or parchment. Arrange bacon in a single layer on a prepared pan. Add potatoes to the second pan and toss with oil, 2 tablespoons ranch seasoning, salt, and pepper until well coated."
    },
    {
      "position": 2,
      "text": "Bake both pans in the preheated oven. Cook bacon until crisp, about 15 minutes. Remove bacon to cool on a rack. Cook potatoes until browned and tender, 5 to 10 minutes more. Remove from the oven to cool."
    },
    {
      "position": 3,
      "text": "Crumble bacon, reserve 1 tablespoon for garnish, and set the remaining bacon aside."
    },
    {
      "position": 4,
      "text": "When potatoes are cool enough to handle, add to a large bowl. Add reserved bacon, green onions, jalapenos, pickled jalapenos, jalapeno brine, cheese, sour cream, mayonnaise, and remaining ranch seasoning. Stir until well combined. Serve immediately, or refrigerate until ready to serve. Garnish with reserved bacon, jalapenos, and green onion."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

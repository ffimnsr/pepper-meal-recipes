  "id": "4e13de76-28f8-5ce2-9610-bb57e92b7d14",
  "slug": "shrimp-ramen-stir-fry-recipe-8733280",
  "name": "Shrimp Ramen Stir Fry",
  "recipe_type": "main",
  "brief_description": "This shrimp ramen stir fry, loaded with vegetables and made with a delicious sauce instead of the seasoning packet, is a budget-friendly meal for one.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "For sauce, add soy sauce, oyster sauce, sesame oil, rice vinegar, chili crisp, and garlic to a small bowl. Heat grapeseed oil in a small saucepan. Carefully pour heated oil into the bowl; set sauce aside."
    },
    {
      "position": 2,
      "text": "Heat remaining 1 teaspoon sesame oil in a wok or heavy skillet. Add broccoli, carrots, bell pepper, and onion. Saut\u00e9 until vegetables are crisp-tender, about 3 minutes. Add garlic and stir until fragrant, about 35 seconds. Pour in sauce, and add shrimp. Cook for approximately 2 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, open ramen package; discard seasoning packet. Bring 2\u00bd cups water to a boil in a small saucepan. Add noodles and cook for 2 minutes. Drain; stir noodles into the wok; toss to coat. Garnish with black and white sesame seeds, and chopped green onion."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

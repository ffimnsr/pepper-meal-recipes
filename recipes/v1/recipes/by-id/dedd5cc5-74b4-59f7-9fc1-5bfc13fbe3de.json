  "id": "dedd5cc5-74b4-59f7-9fc1-5bfc13fbe3de",
  "slug": "e-z-drop-biscuits",
  "name": "E-Z Drop Biscuits",
  "recipe_type": "breakfast",
  "brief_description": "Quick and easy drop biscuits that taste great with butter and jam or plain with sausage and gravy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large bowl, combine flour, baking powder, sugar, cream of tartar and salt. Stir in butter and milk just until moistened. Drop batter on a lightly greased cookie sheet by the tablespoon."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until golden on the edges, about 8 to 12 minutes. Serve warm."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

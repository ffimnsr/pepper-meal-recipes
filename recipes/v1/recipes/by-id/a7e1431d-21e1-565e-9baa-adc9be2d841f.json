  "slug": "easy-no-cook-tuna-and-avocado-tostadas-recipe-11763804",
  "name": "Easy No Cook Tuna and Avocado Tostadas",
  "recipe_type": "main",
  "brief_description": "These easy no cook tuna and avocado tostadas make a quick summer dinner with zero time spent over the stove. Just season canned tuna, add a little mayo, mash an avocado, and layer on a tostada shell.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine tuna, bell pepper, green onion, jalapeno, mayonnaise, balsamic vinegar, and garlic powder in a bowl; stir until just combined."
    },
    {
      "position": 2,
      "text": "Spread mashed avocado evenly over tostadas. Squeeze lemon over avocado and sprinkle evenly with salt. Divide tuna mixture evenly over tostadas. Drizzle with hot sauce and more lemon juice if desired."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,

  "id": "1a1e0e00-edb4-52e5-8d87-14291de905dd",
  "slug": "simply-potatoes-easy-shepherds-pie",
  "name": "Simply Potatoes\u00ae Easy Shepherd's Pie",
  "recipe_type": "main",
  "brief_description": "Hearty and delicious, this shepherd's pie preps in just 15 minutes by using Simply Potatoes\u00ae Mashed Potatoes.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat oven to 375 degrees F. Spray 2-1/2 to 3 quart casserole baking dish with nonstick cooking spray.*"
    },
    {
      "position": 2,
      "text": "In 12-inch skillet cook ground beef and onion until browned; drain grease. Add beans, corn, tomatoes, gravy, thyme and salt. Cook until heated through. Spoon beef mixture into casserole dish. Spread Simply Potatoes\u00ae evenly over beef mixture. Bake 30 to 35 minutes or until edges are bubbly. Remove from oven."
    },
    {
      "position": 3,
      "text": "Heat broiler. Broil casserole 4 to 6 inches from heat, 3 to 5 minutes, until Simply Potatoes\u00ae are lightly browned."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "c3149ed8-e38e-56d0-b4ef-de2cfb551d07",
  "slug": "pasta-fazoolander",
  "name": "Pasta Fazoolander",
  "recipe_type": "soup",
  "brief_description": "This pasta fazoolander recipe is a hearty soup featuring cheese tortellini, white beans, and spinach in a rich broth. It's perfect for a cold winter day!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large saucepan over medium heat. Stir in tomato paste and anchovy fillet; cook until fragrant and the color deepens, 2 to 3 minutes."
    },
    {
      "position": 2,
      "text": "Pour in chicken broth and bring to a boil. Stir in tortellini and beans; cook until tortellini are cooked through but still firm to the bite, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Stir in red pepper flakes, oregano, salt, and pepper. Add spinach; cook and stir until just wilted, 2 to 3 minutes. Remove from the heat."
    },
    {
      "position": 4,
      "text": "Ladle into bowls and garnish with red pepper flakes and grated Parmesan cheese."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "fc6dcf30-b0de-5109-933c-4163d6b208f4",
  "slug": "creamy-potato-and-leek-soup",
  "name": "Creamy Potato and Leek Soup",
  "recipe_type": "soup",
  "brief_description": "Creamy potato and leek soup is quick and easy to prepare with simple ingredients and is a warm and delicious meal for the whole family to enjoy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large pot over medium heat. Cook and stir leeks, garlic, salt, and pepper in the hot butter until leeks are tender and lightly browned, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Stir chicken broth and cornstarch together in a bowl until cornstarch is dissolved; pour over the leek mixture. Add potatoes to the broth mixture and bring to a boil; season with onion powder and garlic powder. Reduce heat, add half-and-half, and simmer until potatoes are tender, about 30 minutes."
    },
    {
      "position": 3,
      "text": "Remove pot from heat and blend soup using a hand blender until smooth; season with salt and pepper."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

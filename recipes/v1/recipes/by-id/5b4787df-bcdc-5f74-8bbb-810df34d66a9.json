  "id": "5b4787df-bcdc-5f74-8bbb-810df34d66a9",
  "slug": "spicy-sausage-and-rice-casserole",
  "name": "Spicy Sausage and Rice Casserole",
  "recipe_type": "main",
  "brief_description": "This spicy sausage and rice casserole with tomatoes, onion, and bell peppers, is perfect for an easy to prep, flavorsome dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Brown sausage in a skillet over medium-high heat; drain grease. Add rice, onion, garlic, and peppers; cook and stir for 5 minutes. Stir in tomatoes, chicken broth, salt, pepper, and cayenne pepper. Transfer into a 9x13-inch baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until rice is tender and most of the liquid is absorbed, about 1 hour."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

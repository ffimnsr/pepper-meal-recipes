  "slug": "dallas-spicy-habanero-salsa-recipe-11799448",
  "name": "Dallas' Spicy Habanero Salsa",
  "recipe_type": "appetizer",
  "brief_description": "Dallas' spicy habanero salsa is made from home-grown habanero peppers, tomatoes, and onion, skillet-roasted until charred, then blended. It's very hot!",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat 1 tablespoon olive oil in a cast iron skillet. Once heated, add habaneros, tomatoes, garlic, and onion. Roast until charred., about 8 minutes"
    },
    {
      "position": 2,
      "text": "Place roasted veggies, remaining 2 tablespoons olive oil, and chicken bouillon in a blender cup and blend until smooth."
    }
  ],

  "id": "e7b68a1b-5e2c-524f-a7d4-f566b912a513",
  "slug": "japanese-style-braised-pork-ribs",
  "name": "Japanese-Style Braised Pork Ribs",
  "recipe_type": "main",
  "brief_description": "These simple, Japanese-style, braised baby back ribs with rice make for an easy meal that's full of flavor.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Remove silverskin from back of ribs by sliding the pointed end of a meat thermometer under skin and pulling up. Pat ribs dry with paper towels and cut into individual ribs."
    },
    {
      "position": 2,
      "text": "Mix soy sauce, sake, and honey together in a small bowl and set aside."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 4,
      "text": "Heat oil in a large Dutch oven over medium-high heat until hot. Sear ribs in batches until browned and they have a nice crust, about 3 minutes per side. Remove ribs to a plate."
    },
    {
      "position": 5,
      "text": "Drain Dutch oven of any excess oil. Carefully pour soy sauce mixture into the pot and scrape bottom of the pan with a wooden spoon or spatula to release any stuck-on bits. Add ribs to the pot with liquid and increase heat to medium-high. Bring to a boil. Cover tightly and remove from heat."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until ribs are tender and no longer pink, about 2 1/2 hours, flipping over halfway through cooking time."
    },
    {
      "position": 7,
      "text": "Meanwhile, bring water and rice to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until rice is tender and water has been absorbed, 20 to 25 minutes."
    },
    {
      "position": 8,
      "text": "Serve ribs and sauce with white rice and sprinkle with green onions."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 170,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

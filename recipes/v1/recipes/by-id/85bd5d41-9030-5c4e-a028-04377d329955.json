  "id": "85bd5d41-9030-5c4e-a028-04377d329955",
  "slug": "simple-caprese-salad",
  "name": "Simple Caprese Salad",
  "recipe_type": "salad",
  "brief_description": "In this simple caprese salad recipe, fresh red, ripe tomato slices alternate with mozzarella cheese slices, roasted red pepper pieces, and basil leaves.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Cut roasted red peppers into 16 large pieces; set aside."
    },
    {
      "position": 2,
      "text": "Place 1 tomato slice, 1 basil leaf, 1 mozzarella cheese slice, 1 roasted pepper piece, and 1 more basil leaf, starting at the edge of a serving platter. Continue arranging salad in same order, forming a spiral from outside to in, until all tomato slices, basil leaves, mozzarella slices, and roasted pepper pieces have been arranged; salad should end in center of platter."
    },
    {
      "position": 3,
      "text": "Drizzle salad with olive oil; sprinkle with black olives and black pepper."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

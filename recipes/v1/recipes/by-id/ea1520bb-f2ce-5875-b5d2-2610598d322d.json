  "id": "ea1520bb-f2ce-5875-b5d2-2610598d322d",
  "slug": "glenns-rhubarb-crumble",
  "name": "Rhubarb Crumble",
  "recipe_type": "dessert",
  "brief_description": "This rhubarb crumble is a combination of sweetened rhubarb and a top layer of buttery oat crumble for a cozy and delicious dessert in under an hour.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Combine rhubarb, white sugar, 2 tablespoons flour, egg, and 1/2 teaspoon cinnamon together in a large bowl until evenly coated."
    },
    {
      "position": 3,
      "text": "Spread rhubarb mixture into the prepared baking dish."
    },
    {
      "position": 4,
      "text": "Mix 1 \u00bd cups flour, brown sugar, oats, and 1/2 teaspoon cinnamon together in a separate bowl. Cut in butter using a pastry cutter or two forks until topping is crumbly. Sprinkle topping over rhubarb layer."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until hot and bubbling, about 40 minutes."
    },
    {
      "position": 6,
      "text": "Serve hot or cold."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

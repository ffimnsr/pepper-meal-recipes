  "id": "b5a8b9ec-6cd7-51ff-888c-8290c7268ddd",
  "slug": "easy-seafood-pasta-recipe-11915708",
  "name": "Easy Seafood Pasta",
  "recipe_type": "main",
  "brief_description": "The easiest seafood pasta technique is actually the best one\u2014this easy seafood pasta works with any kind of seafood. Here, Chef John uses salmon and shrimp, but truly, any seafood will do. The delicious sauce takes less time to cook than the pasta.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut seafood into bite-sized pieces and refrigerate until needed."
    },
    {
      "position": 2,
      "text": "Bring a large pot of salted water to a boil, and add pasta. Cook, stirring occasionally until tender with a bite, 10 to 12 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, for sauce, add oil to a skillet and place over medium-high heat. Add seafood and arrange into a single layer. Season with salt and cayenne, and cook and stir for 30 seconds."
    },
    {
      "position": 4,
      "text": "Add the garlic; cook, stirring for about 15 seconds. Pour in cream; wait about 1 minute for cream to start to boil. While waiting, add the zest from 1 lemon. Reduce the heat to low, squeeze in juice from half the lemon, or add more to taste. Stir everything together, and turn off heat."
    },
    {
      "position": 5,
      "text": "Once pasta is cooked use a strainer to transfer it into the sauce. Turn the heat back on to medium-high, and add tarragon. Stir and toss pasta into sauce with seafood. By the time cream returns to a boil, the seafood will be cooked and pasta is ready to serve."
    },
    {
      "position": 6,
      "text": "Turn off heat, and grate in Parmesan cheese. Taste for seasoning and serve immediately in bowls."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

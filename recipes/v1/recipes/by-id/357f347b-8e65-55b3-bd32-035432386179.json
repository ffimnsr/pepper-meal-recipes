  "id": "357f347b-8e65-55b3-bd32-035432386179",
  "slug": "chicken-fried-venison-steaks",
  "name": "Chicken-Fried Venison Steaks",
  "recipe_type": "main",
  "brief_description": "Make tasty chicken-fried venison steaks with thinly pounded venison, egg batter, and seasoned bread crumbs, then fry them up until they're golden brown.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine bread crumbs, flour, salt, and pepper in a 1-gallon resealable plastic bag. Beat eggs and milk together in a shallow bowl."
    },
    {
      "position": 2,
      "text": "Dip each steak into the egg mixture, then place into the plastic bag and shake to coat with crumbs."
    },
    {
      "position": 3,
      "text": "Heat oil in a skillet over medium heat. Add steaks and fry, turning once, until both sides are golden brown, 6 to 8 minutes per side."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "78702c26-f27c-5897-b06b-dc95d7c2ac88",
  "slug": "no-fail-pound-cake",
  "name": "No-Fail Pound Cake",
  "recipe_type": "dessert",
  "brief_description": "This pound cake uses yellow cake mix, sour cream, and eggs for a tender Bundt flavored with vanilla and lemon, perfect for brunch or a formal dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 10-inch Bundt pan."
    },
    {
      "position": 3,
      "text": "Cream together sugar and butter in a large bowl with an electric mixer until light and fluffy. Beat in eggs one at a time, mixing well after each addition."
    },
    {
      "position": 4,
      "text": "Stir in vanilla and lemon extracts."
    },
    {
      "position": 5,
      "text": "Beat in sour cream and water."
    },
    {
      "position": 6,
      "text": "Beat in cake mix and flour until incorporated. Pour batter into the prepared pan."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of cake comes out clean, 60 to 80 minutes. Let cool in the pan for 10 minutes, then turn out onto a wire rack to cool completely."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,

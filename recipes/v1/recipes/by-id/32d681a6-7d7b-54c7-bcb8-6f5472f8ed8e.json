  "schema_version": 1,
  "id": "32d681a6-7d7b-54c7-bcb8-6f5472f8ed8e",
  "slug": "chicken-primavera-alfredo",
  "name": "Chicken Primavera Alfredo",
  "recipe_type": "main",
  "brief_description": "Chicken strips, green and red bell peppers, and mushrooms are cooked in butter, then stirred into a creamy, comforting Alfredo sauce with fettuccini in this delicious chicken primavera Alfredo dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Stir in fettuccine, bring back to a boil, and cook pasta over medium heat until cooked through but still firm to the bite, about 8 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Melt 1/4 cup butter in a large skillet over medium heat; cook and stir chicken and garlic in butter until chicken is browned. Add mushrooms, green bell pepper, and red bell pepper; cook and stir until vegetables are tender."
    },
    {
      "position": 3,
      "text": "Melt remaining 1/2 cup butter with 1/2 of the heavy cream in a large saucepan over medium heat. Gradually add Parmesan cheese, alternating with pieces of cream cheese, stirring constantly. Stir in remaining heavy cream, simmering until sauce has thickened, about 5 minutes. Stir chicken and vegetable mixture into cream sauce."
    },
    {
      "position": 4,
      "text": "Transfer pasta to the saucepan and stir in egg. Cook and stir for 1 minute and serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "healthier-but-still-awesome-awesome-slow-cooker-pot-roast",
  "name": "Healthier (but still awesome) Awesome Slow Cooker Pot Roast",
  "recipe_type": "soup",
  "brief_description": "Using low-fat, low-sodium cream of mushroom and omitting the soup mix, this tender low-sodium pot roast has less sodium than the traditional version. The addition of carrots, potatoes, and string beans contributes to flavor as well as texture.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix cream of mushroom soup, chopped onion, and chuck roast in a slow cooker."
    },
    {
      "position": 2,
      "text": "Cook on Low for 8 to 9 hours or High for 3 to 4 hours. Add carrots, potatoes, string beans, and parsley 1 1/2 hours before pot roast is done."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 180,

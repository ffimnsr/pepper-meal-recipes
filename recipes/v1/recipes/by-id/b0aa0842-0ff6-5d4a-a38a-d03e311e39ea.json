  "id": "b0aa0842-0ff6-5d4a-a38a-d03e311e39ea",
  "slug": "black-bean-avocado-salsa",
  "name": "Black Bean Avocado Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This fresh-tasting black bean avocado salsa recipe is colorful, delicious, and zesty. Rub the plastic with squeezed lime peels to prevent oxidation.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Combine black beans, corn, tomatoes, bell pepper, jalape\u00f1o, cilantro, red onion, lime juice, vinegar, salt, and black pepper in a bowl."
    },
    {
      "position": 2,
      "text": "Gently stir avocado into black bean mixture. Cover salsa with plastic wrap, pressing it directly onto salsa. Chill at least 2 hours."
    }
  ],

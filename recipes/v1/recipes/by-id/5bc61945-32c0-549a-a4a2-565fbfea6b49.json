  "id": "5bc61945-32c0-549a-a4a2-565fbfea6b49",
  "slug": "bjarnes-norwegian-meatballs",
  "name": "Bjarne's Norwegian Meatballs",
  "recipe_type": "main",
  "brief_description": "These Norwegian meatballs come from a perfected family recipe. They are made with ground beef, ginger, and nutmeg then topped with a rich cream sauce.",
  "cuisine": "Norwegian Scandinavian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a jelly roll pan."
    },
    {
      "position": 2,
      "text": "Combine bread crumbs, milk, eggs, onion, ginger, salt, nutmeg, garlic, and black pepper in a mixing bowl. Let stand until bread crumbs absorb milk, about 5 minutes. Stir until just mixed and add ground beef. Mix until well blended. Shape mixture into 1-inch meatballs and place on the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until browned, about 18 minutes. Set meatballs aside."
    },
    {
      "position": 4,
      "text": "Melt butter in a large skillet over medium-high heat. Saut\u00e9 onion until tender, about 3 minutes. Stir in flour and cook until lightly browned, about 2 minutes. Slowly add broth; cook and stir gravy until smooth and thickened, 5 to 10 minutes. Blend in cream, cayenne pepper, and black pepper."
    },
    {
      "position": 5,
      "text": "Gently stir cooked meatballs into gravy and heat through, but do not boil, about 5 minutes more."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "hard",

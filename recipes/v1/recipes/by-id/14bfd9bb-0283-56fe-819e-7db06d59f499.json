  "id": "14bfd9bb-0283-56fe-819e-7db06d59f499",
  "slug": "flax-seed-crackers",
  "name": "Flax Seed Crackers",
  "recipe_type": "appetizer",
  "brief_description": "These crackers with a nutty, earthy flavor are light, but still sturdy enough for dips and spreads. Experiment with other seasoning combos.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place flax seeds in mixing bowl. Add salt, garlic powder, onion powder, and cayenne. Pour in water. Stir. Cover with plastic wrap. Refrigerate overnight."
    },
    {
      "position": 2,
      "text": "Preheat oven to 200 degrees F (95 degrees C). Line a rimmed baking sheeting with a silicone mat or parchment."
    },
    {
      "position": 3,
      "text": "Transfer soaked flax seeds to prepared baking sheet. Spread out into a thin, flat rectangle, about 1/8 inch thick, using a spatula. Score the rectangle into about 32 small, rectangles."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven until flax seeds have darkened and contracted slightly, about 3 hours. Cool in oven with door ajar. Break into individual crackers."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 180,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

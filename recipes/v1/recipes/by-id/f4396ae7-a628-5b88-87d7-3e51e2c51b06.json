  "id": "f4396ae7-a628-5b88-87d7-3e51e2c51b06",
  "slug": "michaels-foccacia-bread",
  "name": "Michael\u2019s Focaccia Bread",
  "recipe_type": "appetizer",
  "brief_description": "Michael\u2019s focaccia bread recipe is easy to make while remaining true to the original Italian bread. This may be the fastest yeast bread you\u2019ve ever made.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Dissolve honey in warm water in a large bowl; sprinkle yeast over top. Let stand until yeast softens and begins to form a creamy foam, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir in onion, 1 tablespoon olive oil, 1 tablespoon salt, then add flour until dough comes together. Turn dough out on a well-floured surface; knead until smooth and elastic, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Place dough in a lightly oiled large bowl and turn to coat. Cover with a damp cloth and let rise in a warm place until doubled in volume, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 415 degrees F (215 degrees C). Oil a baking sheet."
    },
    {
      "position": 5,
      "text": "Place dough onto the prepared baking sheet; flatten to evenly cover the whole sheet. Press indentations into dough spaced about 1 inch apart using fingertips. Drizzle with remaining 3 tablespoons olive oil, then sprinkle Parmesan cheese, rosemary, and remaining 1 tablespoon kosher salt over top. Let rise for 10 minutes."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown, about 20 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

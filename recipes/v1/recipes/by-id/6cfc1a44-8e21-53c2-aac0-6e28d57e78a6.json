  "id": "6cfc1a44-8e21-53c2-aac0-6e28d57e78a6",
  "slug": "parmesan-espresso-martini-steak-recipe-8661574",
  "name": "Parmesan Espresso Martini Steak",
  "recipe_type": "main",
  "brief_description": "This Parmesan espresso martini steak, rubbed with coffee and served with salty fricos and lightly dressed watercress, is inspired by the Parmesan-topped espresso martini trend that was everywhere last year.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Parmesan fricos: Preheat the oven to 400 degrees F (200 degrees C). Line a large baking sheet with parchment paper. Make 12 piles of Parmesan (about 2 teaspoons each), spacing about 1 inch apart, on the prepared baking sheet."
    },
    {
      "position": 2,
      "text": "Bake in the preheated oven until cheese is melted and edges are browned, 6 to 8 minutes. Let cool."
    },
    {
      "position": 3,
      "text": "Preheat an outdoor grill to medium (350 to 375 degrees F (175 to 190 degrees C))."
    },
    {
      "position": 4,
      "text": "Combine espresso powder, onion powder, paprika, brown sugar, 1/2 teaspoon salt, 1/4 teaspoon pepper, and chili powder in a small bowl. Rub mixture generously over all sides of steak."
    },
    {
      "position": 5,
      "text": "Oil grill grates. Grill steak over direct heat, covered, turning halfway through, 13 to 16 minutes or until an instant-read thermometer inserted into thickest part registers 145 degrees F (63 degrees C). Transfer steak to a cutting board and tent with foil; let rest 5 minutes. Thinly slice steak across the grain."
    },
    {
      "position": 6,
      "text": "Toss watercress with oil, vinegar, and remaining 1/4 teaspoon each salt and pepper. Serve with steak and Parmesan fricos."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": 5,
  "difficulty": "medium",

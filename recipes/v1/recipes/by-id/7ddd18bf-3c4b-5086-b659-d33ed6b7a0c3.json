{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "7ddd18bf-3c4b-5086-b659-d33ed6b7a0c3",
  "slug": "red-pepper-tomato-pasta-bake",
  "name": "Red Pepper Tomato Pasta Bake",
  "recipe_type": "main",
  "brief_description": "Marinara sauce gets blended with spicy peppers and poured over ziti and ground beef in this easy one-pan pasta bake.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add ziti and cook, stirring occasionally, until barely tender and still firm to the bite, 6 to 7 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat a 10-inch Dutch oven over medium-high heat. Add beef and saute until browned and crumbly, 5 to 7 minutes. Transfer beef to a large baking dish; drain and discard grease. Drain pasta and mix in with the beef."
    },
    {
      "position": 3,
      "text": "Melt butter in the same pan. Add onion, bell peppers, celery, garlic, and Thai chiles. Cook and stir until onions turn translucent, 4 to 5 minutes."
    },
    {
      "position": 4,
      "text": "Transfer vegetable mixture to a blender. Pour in marinara sauce, milk, cream cheese, Sriracha sauce, sour cream, and tomato paste. Blend until combined but still chunky. Taste and season with salt and pepper as desired. Pour sauce over the beef and pasta in the baking dish."
    },
    {
      "position": 5,
      "text": "Beat eggs together in the blender. Pour into the baking dish and mix well. Stir in 1 cup Cheddar cheese. Pat mixture down and top with remaining cheese."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until set, 20 to 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

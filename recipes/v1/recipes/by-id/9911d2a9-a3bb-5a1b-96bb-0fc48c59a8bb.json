  "id": "9911d2a9-a3bb-5a1b-96bb-0fc48c59a8bb",
  "slug": "buttermilk-doughnuts",
  "name": "Buttermilk Doughnuts",
  "recipe_type": "dessert",
  "brief_description": "An irresistible cake-like buttermilk doughnut recipe gets fried and topped with a vanilla glaze for a perfect crowd-pleasing treat everyone will love.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Prepare doughnuts: Whisk buttermilk, sugar, and eggs together in a bowl. Mix flour, baking soda, baking powder, salt, nutmeg, and cinnamon together in another bowl. Stir buttermilk mixture into flour mixture until combined; add butter and knead until a soft dough forms."
    },
    {
      "position": 3,
      "text": "Turn out dough onto a lightly floured work surface and roll to 1/4-inch thick. Cut dough into doughnut shapes using a 2 1/2-inch doughnut cutter."
    },
    {
      "position": 4,
      "text": "Make glaze: Beat confectioners' sugar, margarine, and vanilla together in a bowl until smooth. Gradually add milk, stirring constantly, until the desired glaze consistency is reached."
    },
    {
      "position": 5,
      "text": "Working in batches, cook doughnuts in hot oil until golden brown, about 1 minute per side. Transfer cooked doughnuts to a paper towel-lined plate to drain. Dip hot doughnuts into glaze to coat."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

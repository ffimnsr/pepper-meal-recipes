  "id": "f4d6e576-99a9-50f0-97ac-62009be0607d",
  "slug": "roasted-grape-flatbread-recipe-7182311",
  "name": "Roasted Grape Flatbread",
  "recipe_type": "appetizer",
  "brief_description": "Try this delicious flatbread recipes topped with ricotta and roasted grapes.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease a baking sheet. Unroll pizza dough onto prepared baking sheet. Bake for 6 minutes."
    },
    {
      "position": 2,
      "text": "Line a 10x15-inch baking pan with foil. Arrange grapes in prepared baking pan. Drizzle with 1 tablespoon oil and sprinkle with 1/2 teaspoon rosemary and 1/4 teaspoon salt; toss to coat."
    },
    {
      "position": 3,
      "text": "Roast grapes, stirring once halfway through, until slightly charred, about 40 minutes. Remove grapes from baking pan; pour accumulated juices into a small bowl."
    },
    {
      "position": 4,
      "text": "Meanwhile, stir together ricotta, mozzarella, parsley, pepper, and remaining 1/2 teaspoon rosemary in a small bowl."
    },
    {
      "position": 5,
      "text": "Spread ricotta mixture onto the parbaked crust. Top with roasted grapes. Bake until cheese is lightly golden, about 10 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, for dressing, whisk together reserved grape-roasting juices, vinegar, and remaining 2 teaspoons oil and 1/8 teaspoon salt in a bowl. Toss watercress with dressing. Top flatbread with dressed greens."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

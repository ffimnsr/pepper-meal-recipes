  "id": "d49471f1-2e54-5a79-9982-9a2a9ed44010",
  "slug": "easy-garlic-kale",
  "name": "Easy Garlic Kale",
  "recipe_type": "side",
  "brief_description": "This kale recipe is deliciously quick to make by sauteing chopped kale leaves with sizzling garlic. Even kale-haters in the family will ask for more!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Soak kale leaves in a large bowl of water until dirt and sand begin to fall to the bottom, about 2 minutes. Lift kale from the bowl without drying the leaves and immediately remove and discard stems. Chop the kale leaves into 1-inch pieces."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a large skillet over medium heat; cook and stir garlic until sizzling, about 1 minute. Add kale to the skillet and place a cover over the top."
    },
    {
      "position": 4,
      "text": "Cook, stirring occasionally with tongs, until kale is bright green and slightly tender, 5 to 7 minutes."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 8,
  "preparation_time_minutes": 7,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "36d94d97-0c92-58ea-8ee4-e54022e49aa3",
  "slug": "healthier-southern-peach-cobbler",
  "name": "Healthier Southern Peach Cobbler",
  "recipe_type": "dessert",
  "brief_description": "Made with less sugar, no one will know this peach cobbler is healthier than the original version.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine peaches, 2 tablespoons brown sugar, 1/4 teaspoon cinnamon, nutmeg, lemon juice, and cornstarch in a large bowl. Toss to coat evenly, and pour into a 2-quart baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 10 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, combine flour, white sugar, 1/4 cup brown sugar, baking powder, and salt in a large bowl. Blend in butter with your fingertips or a pastry blender until mixture resembles coarse meal. Stir in water until just combined."
    },
    {
      "position": 5,
      "text": "Remove peaches from oven, and drop spoonfuls of flour mixture over them."
    },
    {
      "position": 6,
      "text": "Mix together 2 tablespoons brown sugar and 1 teaspoon ground cinnamon. Sprinkle entire cobbler with the sugar and cinnamon mixture. Bake until topping is golden, about 30 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,

  "id": "fdb58a4e-f25d-54ea-a68e-f7f29682993f",
  "slug": "peach-kuchen",
  "name": "Peach Kuchen",
  "recipe_type": "dessert",
  "brief_description": "A dense crust of a cake with peach slices arranged on top like spokes. Excellent served with vanilla ice cream.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9 inch springform pan. Sift together the flour, baking powder and salt. Set aside."
    },
    {
      "position": 2,
      "text": "In a large bowl, cream together the butter and sugar until light and fluffy. Beat in the egg, then stir in the vanilla. Beat in the flour mixture. Spread dough with hands over the bottom and 1 inch up the sides of prepared springform pan. Arrange peach slices in a spoke pattern over the dough. Sprinkle with sugar and cinnamon."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 35 to 40 minutes, or until golden brown."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

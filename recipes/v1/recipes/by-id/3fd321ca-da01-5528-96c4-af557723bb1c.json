  "id": "3fd321ca-da01-5528-96c4-af557723bb1c",
  "slug": "sangria",
  "name": "Sangria (Red)",
  "recipe_type": "drink",
  "brief_description": "This red sangria recipe features green apple, orange, lemon, and lime soaked in a mixture of wine, orange juice, and rum for a refreshing summer drink.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Combine rum and sugar in a large pitcher until sugar is dissolved; add apple slices, orange slices, lemon slices, and lime slices. Slightly crush fruit against bottom of pitcher to extract some juice."
    },
    {
      "position": 2,
      "text": "Add wine and orange juice to the pitcher; stir. Add lemon-lime soda just before serving; stir."
    }
  ],
  "servings": 8,

  "id": "e7b2c4e4-c047-5ee2-b635-0f33d924f766",
  "slug": "fruity-chili",
  "name": "Fruity Chili Recipe",
  "recipe_type": "soup",
  "brief_description": "This unique chili recipe is sweetened with banana peppers, apples, and peaches.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Combine tomato sauce, kidney beans, 2 tablespoons chili powder, 1 tablespoon sugar, and 1\u20448 teaspoon cayenne pepper in a large saucepan; bring to a simmer over low heat."
    },
    {
      "position": 2,
      "text": "Place a large skillet over medium-high heat; place ground beef in the skillet; season with remaining 2 tablespoons chili powder, 1 tablespoon sugar, and 1\u20448 teaspoon cayenne pepper; cook until brown; add to sauce mixture."
    },
    {
      "position": 3,
      "text": "Heat oil in a small skillet over medium-high heat; cook onion in oil until slightly browned; add to sauce mixture, along with apple, peach, and banana pepper. Allow to simmer another 1 to 2 minutes until hot."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "c3eb7d0b-a5fd-5030-bf9c-8cad1899b3c3",
  "slug": "the-best-million-dollar-spaghetti-recipe-11954822",
  "name": "The Best Million Dollar Spaghetti",
  "recipe_type": "main",
  "brief_description": "The best million dollar spaghetti is deeply rich in a creamy tomato sauce, loaded with ground beef and sausage, and baked under a Parmesan and mozzarella crust.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Lightly grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil and cook pasta according to package directions. Drain and return to the pot. Add butter and toss until noodles are well coated. Stir in 1/4 cup marinara sauce."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat oil in a large deep skillet over medium-high heat. Add onion and cook, stirring constantly, about 2 minutes. Add ground beef, sausage, and garlic powder; cook, crumbling with a spoon, until browned and crumbly. Drain excess grease and return to the skillet."
    },
    {
      "position": 4,
      "text": "Stir in remaining marinara sauce and bring to a simmer. Reduce heat and simmer 5 to 10 minutes."
    },
    {
      "position": 5,
      "text": "Mix cream cheese, cottage cheese, and sour cream in a bowl until well combined, set aside."
    },
    {
      "position": 6,
      "text": "Add half of the spaghetti mixture to the prepared baking dish. Spread the cream cheese mixture evenly over the top, then layer with the remaining spaghetti mixture. Pour meat sauce evenly over the top and sprinkle with mozzarella and Parmesan."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until the cheese is browned and bubbly, 35 to 45 minutes Tent with foil halfway though if top begins to get too brown and continue to bake until done."
    },
    {
      "position": 8,
      "text": "Let stand for 10 minutes before serving to make it easier to slice."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

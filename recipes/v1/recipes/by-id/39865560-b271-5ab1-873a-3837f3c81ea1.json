  "id": "39865560-b271-5ab1-873a-3837f3c81ea1",
  "slug": "ground-beef-shepherds-pie",
  "name": "Ground Beef Shepherd's Pie",
  "recipe_type": "main",
  "brief_description": "This shepherd's pie with ground beef is packed with fresh vegetables for a baked casserole topped with creamy mashed potatoes and Cheddar cheese.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 2-quart casserole dish with cooking spray."
    },
    {
      "position": 3,
      "text": "Heat oil in a large skillet over medium heat. Cook and stir onion in hot oil until translucent, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Add ground beef and basil. Cook and stir until beef is crumbly and browned, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Mix in green beans, tomatoes, and garlic; cook until beans are slightly softened, about 5 minutes more."
    },
    {
      "position": 6,
      "text": "Transfer to the prepared casserole dish."
    },
    {
      "position": 7,
      "text": "Mix together mashed potatoes, water, and beaten egg in a medium bowl until smooth. Spread evenly over beef mixture."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until potatoes start to brown on top, 15 to 20 minutes."
    },
    {
      "position": 9,
      "text": "Sprinkle with cheese and continue baking until cheese is melted, about 5 more minutes."
    },
    {
      "position": 10,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

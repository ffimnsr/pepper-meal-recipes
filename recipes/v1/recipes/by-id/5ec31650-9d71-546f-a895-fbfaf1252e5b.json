  "id": "5ec31650-9d71-546f-a895-fbfaf1252e5b",
  "slug": "teriyaki-shrimp-noodles",
  "name": "Teriyaki Shrimp Noodles",
  "recipe_type": "main",
  "brief_description": "This quick stir-fry dish with shrimp, vegetables, noodles, and homemade teriyaki sauce is on the table in 20 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add udon and cook until they float at the top, about 3 minutes. Continue cooking for 2 more minutes once they are floating, but be careful not to overcook."
    },
    {
      "position": 2,
      "text": "Meanwhile, mix together soy sauce, mirin, sake, garlic, brown sugar, and ginger in a bowl; stir to combine."
    },
    {
      "position": 3,
      "text": "Heat sesame oil in a wok over medium heat. Add shrimp and vegetables and stir fry for about 2 minutes. Remove shrimp and set aside."
    },
    {
      "position": 4,
      "text": "Pour teriyaki sauce over the vegetables. Continue cooking for 3 to 4 minutes longer. Add noodles, and shrimp. Toss to combine and cook until hot. Garnish each serving with green onions and sesame seeds."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "91149942-dd99-5c0b-abd2-51460eb7023d",
  "slug": "amazing-muffin-cups",
  "name": "Amazing Muffin Cups",
  "recipe_type": "breakfast",
  "brief_description": "You'll love these breakfast egg muffins with hash brown crusts filled with eggs, sausage, bell pepper, and cheese. Plate them up or eat them on the go!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 12-cup muffin pan."
    },
    {
      "position": 2,
      "text": "Heat a nonstick skillet over medium-low heat. Add sausage links and cook, turning frequently, until well browned, 12 to 16 minutes. An instant-read thermometer inserted into the center should read 160 degrees F (70 degrees C)."
    },
    {
      "position": 3,
      "text": "While the sausage is cooking, mix hash browns, melted butter, salt, and pepper together in a bowl until well combined. Press mixture into the bottom and sides of the prepared muffin cups."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until lightly browned, about 12 minutes."
    },
    {
      "position": 5,
      "text": "Cut sausage into 1/2-inch pieces. Stir cheese, beaten eggs, and bell pepper together in a bowl."
    },
    {
      "position": 6,
      "text": "Remove hash brown crusts from the oven. Divide sausage between crusts, then spoon egg mixture over top. Sprinkle with chives."
    },
    {
      "position": 7,
      "text": "Return to the oven and bake until set, 13 to 15 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

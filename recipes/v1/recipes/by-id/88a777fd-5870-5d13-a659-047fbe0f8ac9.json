  "id": "88a777fd-5870-5d13-a659-047fbe0f8ac9",
  "slug": "blue-cheese-popovers",
  "name": "Blue Cheese Popovers",
  "recipe_type": "snack",
  "brief_description": "Cheese popovers are golden, flaky crust with a hollow center filled with savory blue cheese. Chef John's foolproof recipe provides the perfect snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk eggs, milk, flour, oil, salt, and cayenne together in a large measuring cup or mixing bowl just until blended."
    },
    {
      "position": 2,
      "text": "Cover the bowl with plastic wrap and allow to rest for 1 hour on the counter, or in the refrigerator for 2 to 3 hours, up to overnight."
    },
    {
      "position": 3,
      "text": "Grease 14 nonstick muffin cups with butter, and then mist with cooking spray."
    },
    {
      "position": 4,
      "text": "Whisk the batter for a few seconds and fill each prepared muffin cup 4/5 full. Sprinkle each evenly with blue cheese."
    },
    {
      "position": 5,
      "text": "Place the muffin pans into a cold oven with a drip pan set underneath. Set the heat to 450 degrees F (230 degrees C). Bake in the oven until popovers are well browned and fully puffed, 30 to 35 minutes."
    },
    {
      "position": 6,
      "text": "Poke each popover with a knife to allow steam to escape. Serve hot."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

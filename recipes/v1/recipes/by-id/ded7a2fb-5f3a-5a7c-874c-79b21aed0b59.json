  "id": "ded7a2fb-5f3a-5a7c-874c-79b21aed0b59",
  "slug": "edible-chocolate-chip-cookie-dough",
  "name": "Edible Chocolate Chip Cookie Dough",
  "recipe_type": "dessert",
  "brief_description": "This recipe for cookie dough is quick and easy to prepare, is safe to eat because it doesn't include eggs, and the whole family will love it!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix butter, milk, and vanilla extract together in a large bowl."
    },
    {
      "position": 2,
      "text": "Combine flour, brown sugar, white sugar, baking soda, and salt in a separate bowl; slowly mix into butter mixture, beating on low speed with an electric mixer until dough is just combined."
    },
    {
      "position": 3,
      "text": "Fold chocolate chips and walnuts into dough; drop by rounded tablespoon onto waxed paper."
    }
  ],
  "servings": 36,

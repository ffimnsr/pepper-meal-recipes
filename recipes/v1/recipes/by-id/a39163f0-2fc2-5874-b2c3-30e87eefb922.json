  "id": "a39163f0-2fc2-5874-b2c3-30e87eefb922",
  "slug": "breakfast-sausage-casserole",
  "name": "Breakfast Casserole",
  "recipe_type": "soup",
  "brief_description": "This overnight breakfast casserole with cream of mushroom soup, breakfast sausage, eggs, and Cheddar cheese is a hearty way to start your day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Cook sausage in a large skillet over medium-high heat until evenly browned, crumbly, and no longer pink in the center, 7 to 9 minutes. Drain and discard any excess grease."
    },
    {
      "position": 3,
      "text": "While the sausage is cooking, whisk eggs in a mixing bowl until smooth. Whisk in 2 cups milk, mustard powder, and salt until evenly blended."
    },
    {
      "position": 4,
      "text": "Spread bread cubes into the prepared dish; sprinkle sausage over top, then Cheddar cheese. Pour egg mixture over the entire dish. Cover and refrigerate, 8 hours to overnight."
    },
    {
      "position": 5,
      "text": "When ready to bake, preheat the oven to 300 degrees F (150 degrees C)."
    },
    {
      "position": 6,
      "text": "Remove casserole from the refrigerator and uncover. Whisk condensed soup and remaining 1/2 cup milk together in a bowl; pour mixture over casserole."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until firm and golden brown, about 1 1/2 hours."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 100,
  "preparation_time_minutes": 20,

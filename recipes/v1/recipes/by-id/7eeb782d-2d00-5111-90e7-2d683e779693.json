  "id": "7eeb782d-2d00-5111-90e7-2d683e779693",
  "slug": "oatmeal-pie-crust",
  "name": "Oatmeal Pie Crust",
  "recipe_type": "dessert",
  "brief_description": "Oatmeal pie crust is quick and easy to prepare and goes quite nicely with peanut butter or butterscotch pies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly spray a 9-inch pie dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine oats, confectioners' sugar, butter, cinnamon, nutmeg, and salt together in a bowl; press into the prepared pie dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until lightly browned, 15 to 20 minutes. Cool completely."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

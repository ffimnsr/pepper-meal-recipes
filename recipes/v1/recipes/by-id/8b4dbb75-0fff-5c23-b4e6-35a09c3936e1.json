  "id": "8b4dbb75-0fff-5c23-b4e6-35a09c3936e1",
  "slug": "hawaiian-chicken-kabobs",
  "name": "Hawaiian Chicken Pineapple Kabobs",
  "recipe_type": "dessert",
  "brief_description": "This Hawaiian chicken pineapple kabobs recipe makes tender, tangy-sweet, and delicious kabobs. They're easy to make and require only a few ingredients.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine soy sauce, brown sugar, sherry, sesame oil, ginger, and garlic powder in a shallow glass dish. Add chicken pieces and pineapple chunks; stir until well coated. Cover the dish; marinate in the refrigerator, 1 to 2 hours."
    },
    {
      "position": 2,
      "text": "Preheat the grill to medium-high heat and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Thread chicken and pineapple alternately onto skewers. Discard excess marinade."
    },
    {
      "position": 4,
      "text": "Cook on the preheated grill, turning occasionally, until chicken is longer pink in centers and the juices run clear, 15 to 20 minutes. An instant-read thermometer inserted into centers should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

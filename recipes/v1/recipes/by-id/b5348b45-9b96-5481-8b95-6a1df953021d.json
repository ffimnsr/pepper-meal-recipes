  "id": "b5348b45-9b96-5481-8b95-6a1df953021d",
  "slug": "oreo-cookie-balls",
  "name": "Oreo Balls",
  "recipe_type": "dessert",
  "brief_description": "Oreo balls are a 3-ingredient no-bake holiday treat that are easy to make with crushed chocolate cookies and cream cheese filling coated in melted chocolate.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Mix crushed Oreo cookies and cream cheese in a large bowl until well blended."
    },
    {
      "position": 3,
      "text": "Use your hands to shape mixture into 48 (1-inch) balls; place on a tray and freeze until thoroughly chilled, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Line a shallow pan with waxed paper. Dip Oreo balls in melted chocolate using a fork or toothpick, letting excess chocolate drip off before placing them in a single layer on the prepared pan. When you remove the fork or toothpick, you may see tiny holes in the coating. Use a spoon to dab a little melted chocolate over the holes to smooth and seal them."
    },
    {
      "position": 5,
      "text": "Refrigerate until firm, about 1 hour. Store in a covered container in the refrigerator."
    },
    {
      "position": 6,
      "text": "Enjoy!"
    }
  ],
  "servings": 48,

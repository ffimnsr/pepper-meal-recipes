  "id": "e8ffd288-5280-5aa8-9c31-e3ddc3d9852f",
  "slug": "daddys-popcorn",
  "name": "Daddy's Popcorn",
  "recipe_type": "appetizer",
  "brief_description": "After trying Daddy's popcorn recipe, made with corn kernels, vegetable oil, margarine, and seasoned salt, you will never go back to microwave popcorn.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut a paper grocery bag in half crosswise. (To use as a serving bowl and to absorb excess oil.)"
    },
    {
      "position": 2,
      "text": "Combine popcorn, oil, and margarine in a 2-quart pot; heat on high heat, and constantly shake the pot back and forth, until first corn kernel pops, then cover the pot, and continue shaking. When the lid lifts off the pot, remove the pot from heat; hold it over the prepared bag until popping stops."
    },
    {
      "position": 3,
      "text": "Pour popcorn into the bag. Season with \u00bc teaspoon seasoned salt; shake bag to distribute. Taste before seasoning with more salt."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

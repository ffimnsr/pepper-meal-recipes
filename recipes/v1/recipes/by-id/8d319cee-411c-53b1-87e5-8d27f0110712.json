  "id": "8d319cee-411c-53b1-87e5-8d27f0110712",
  "slug": "savory-tater-tot-casserole",
  "name": "Savory Tater Tot Casserole",
  "recipe_type": "soup",
  "brief_description": "Ground beef is layered in a casserole with chopped onions, mixed vegetables, cream of chicken soup, and topped with tater tots in this comforting, kid-friendly recipe. It bakes in an hour.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray a 9x13-inch glass baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Spread ground beef into bottom of pan, covering entire bottom, gently pressing beef down. Sprinkle with chopped onion. Layer frozen veggies evenly on top. Cover with soup, straight from the can, carefully spreading with a spatula to cover entirely."
    },
    {
      "position": 3,
      "text": "Layer tater tots on top, covering the entire top with tots. Bake in the preheated oven until the beef is done, about 1 hour. Check after 30 minutes; if tots are getting too brown, turn oven down to 350 degrees F (190 degrees C)."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

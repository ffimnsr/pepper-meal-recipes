{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "c4e96f25-0ed5-50c4-8085-9006bc1f5066",
  "slug": "cheesy-baked-broccoli-bites-recipe-11951704",
  "name": "Cheesy Baked Broccoli Bites",
  "recipe_type": "appetizer",
  "brief_description": "For these cheesy baked broccoli bites, finely chopped broccoli is mixed with mozzarella, eggs, and a touch of cornstarch, then baked until golden on the outside and tender in the center. These bites are light, flavorful, and just garlicky enough. Perfect for meal prep, quick lunches, or an easy appetizer, especially paired with your favorite dip. Use freshly-shredded mozzarella for best melting results.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Cut tough main stem from broccoli and discard. Finely chop head into florets, in 1/4-inch pieces or less. Alternatively, you can pulse broccoli in a food processor. Transfer broccoli to a bowl and let sit for 20 to 30 minutes if time allows. (see note)"
    },
    {
      "position": 3,
      "text": "Add cheese, eggs, cornstarch, salt, garlic and pepper; combine well."
    },
    {
      "position": 4,
      "text": "Using a small cookie scoop, divide mixture into approximately 24 balls, approximately 1 1/2 - 1 3/4-inch in diameter. Press the mixture together in your hands so ingredients hold a ball shape, and place on the prepared baking sheet, about 2 inches apart."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown, 18 to 20 minutes. Balls will flatten slightly as they bake. Serve as is, or with your favorite dipping sauce."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

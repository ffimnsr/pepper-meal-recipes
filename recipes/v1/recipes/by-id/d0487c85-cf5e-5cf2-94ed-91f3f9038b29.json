  "id": "d0487c85-cf5e-5cf2-94ed-91f3f9038b29",
  "slug": "oven-baked-sweet-potato-fries",
  "name": "Baked Sweet Potato Fries",
  "recipe_type": "dessert",
  "brief_description": "These sweet potato fries are coated in oil and seasoned with garlic powder and paprika, then baked until crisp for a tasty and delicious side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 425 degrees F (220 degrees C) with the rack positioned in the upper third of the oven. Grease a baking sheet."
    },
    {
      "position": 3,
      "text": "Peel sweet potatoes; cut into 1x3-inch wedges. Place wedges and soybean oil in a large bowl; toss lightly. Sprinkle with salt, pepper, garlic powder, and paprika; toss."
    },
    {
      "position": 4,
      "text": "Arrange potatoes in a single layer on the prepared baking sheet, being sure not to overcrowd."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven, turning occasionally, until tender and golden brown, 18 to 24 minutes. Cool 5 minutes before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

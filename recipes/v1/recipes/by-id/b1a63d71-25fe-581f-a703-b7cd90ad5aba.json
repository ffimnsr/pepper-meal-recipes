  "id": "b1a63d71-25fe-581f-a703-b7cd90ad5aba",
  "slug": "egg-free-and-milk-free-baked-oatmeal",
  "name": "Egg-Free and Milk-Free Baked Oatmeal",
  "recipe_type": "breakfast",
  "brief_description": "Baked oatmeal with no eggs and made with vegetable oil and soy milk. An egg-free and dairy-free recipe great for a vegan lifestyle or if you happen to be out of eggs!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Lightly grease a pie pan."
    },
    {
      "position": 2,
      "text": "Beat applesauce and white sugar together in a bowl. Add oats, soy milk, 1 tablespoon plus 1/4 teaspoon baking powder, vegetable oil, and sea salt; mix well. Fold raisins into oat mixture."
    },
    {
      "position": 3,
      "text": "Pour oat mixture into the prepared pie pan; top with brown sugar and cinnamon. Refrigerate for 8 hours to overnight."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until oatmeal is firm, 35 to 50 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

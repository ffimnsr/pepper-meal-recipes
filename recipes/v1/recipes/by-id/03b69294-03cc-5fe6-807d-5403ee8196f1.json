  "id": "03b69294-03cc-5fe6-807d-5403ee8196f1",
  "slug": "one-pan-marry-me-salmon-recipe-11935468",
  "name": "One Pan Marry Me Salmon",
  "recipe_type": "main",
  "brief_description": "In this one pan marry me salmon, a tender seared salmon fillet is the star of an at-home date night meal. Serve salmon over lemon-butter orzo, finished with parsley, and lemon zest, and paired with steamed green beans for a complete meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pat fillets dry and season with salt and pepper."
    },
    {
      "position": 2,
      "text": "Heat butter in a skillet over medium-high heat. Sear salmon until golden and just cooked through, 3 to 4 minutes per side. Remove fillets and set aside."
    },
    {
      "position": 3,
      "text": "In the same skillet, saut\u00e9 garlic, oregano, and thyme for 30 seconds."
    },
    {
      "position": 4,
      "text": "Add broth, cream, Parmesan, sun-dried tomatoes, and red pepper flakes. Simmer until slightly thickened, 2 to 3 minutes. Season to taste with salt and black pepper."
    },
    {
      "position": 5,
      "text": "Return salmon to the skillet and spoon sauce over the top to coat."
    },
    {
      "position": 6,
      "text": "Plate and garnish with parsley and a squeeze of fresh lemon."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

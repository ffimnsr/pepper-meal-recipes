  "id": "7fa7b252-3929-5ff5-8e07-d797e17d4e51",
  "slug": "light-primavera-pasta",
  "name": "Light Primavera Pasta",
  "recipe_type": "main",
  "brief_description": "This easy light primavera pasta recipe includes penne, zucchini, squash, and a light Parmesan peppercorn dressing, and it's ready in about 30 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Add penne and cook, stirring occasionally, until tender yet firm to the bite, about 11 minutes. Drain."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat a large skillet over medium heat. Add olive oil; heat for about 30 seconds. Add yellow squash, zucchini, and garlic; cook until tender, about 5 minutes. Season lightly with salt and black pepper. Transfer to a large serving bowl."
    },
    {
      "position": 3,
      "text": "Stir penne into vegetable mixture; add dressing and toss to coat. Serve hot or cold."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,

  "id": "6abde974-4ecd-568a-a16d-63d4532789f2",
  "slug": "chicken-enchilada-pasta-bake-recipe-11815611",
  "name": "Chicken Enchilada Pasta Bake",
  "recipe_type": "main",
  "brief_description": "This chicken enchilada pasta bake is the perfect easy week night meal for the family. It really feels like eating chicken enchiladas with pasta instead of tortillas and the chicken and veg filling pulling the dish together combined with red enchilada sauce.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Add penne and cook, stirring occasionally, until tender yet firm to the bite, about 11 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat oil in an extra large oven-proof skillet over medium heat. Add onion and pepper and cook until softened, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Add black beans, corn and garlic. Cook until corn is heated, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Stir in chicken, enchilada sauce, salt, and pepper until well combined. Fold in noodles until fully coated. Sprinkle cheese over top."
    },
    {
      "position": 6,
      "text": "Bake until cheese is melted, about 10 minutes."
    },
    {
      "position": 7,
      "text": "Top with green onions and cilantro. Serve with sour cream, if desired. Recipe developed by Barrett Heald"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

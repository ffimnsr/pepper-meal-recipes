  "id": "38d73d08-9cc1-5613-84f8-ebc5e7123840",
  "slug": "taco-salad-casserole-recipe-11719210",
  "name": "Taco Salad Casserole",
  "recipe_type": "salad",
  "brief_description": "This taco salad casserole features well-seasoned ground beef over crushed tortilla chips and refried beans, baked with a cheesy top. The salad component is added over each serving, a really fun way to make a taco salad.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Coat a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Cook ground beef, onion, and green bell pepper in a 12-inch skillet over medium heat, breaking up the meat with a wooden spoon, until meat is browned and vegetables are tender, 8 minutes; drain fat."
    },
    {
      "position": 3,
      "text": "Stir corn, water, and taco seasoning mix into the skillet. Bring to a boil. Reduce heat and simmer, uncovered, stirring occasionally, until thickened, 3 to 4 minutes."
    },
    {
      "position": 4,
      "text": "Heat refried beans in a small bowl in the microwave until softened, 1 to 3 minutes, stirring once."
    },
    {
      "position": 5,
      "text": "Place tortilla chips in the prepared baking dish and coarsely smash with your hands. Spoon refried beans over the chips and spread in an even layer. Top with ground beef mixture."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until heated through, about 15 minutes."
    },
    {
      "position": 7,
      "text": "Top with cheese. Bake until cheese melts, about 5 minutes."
    },
    {
      "position": 8,
      "text": "Top individual servings with romaine and tomato. Drizzle with sour cream, and taco sauce. Serve with additional tortilla chips."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

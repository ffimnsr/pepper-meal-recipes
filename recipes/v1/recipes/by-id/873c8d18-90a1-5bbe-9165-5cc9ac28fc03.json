  "id": "873c8d18-90a1-5bbe-9165-5cc9ac28fc03",
  "slug": "traditional-mexican-street-tacos",
  "name": "Traditional Mexican Street Tacos",
  "recipe_type": "appetizer",
  "brief_description": "These street tacos are easy to make at home with chicken, guacamole, onions, and cilantro layered on corn tortillas and topped with fresh lime juice.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Place a paper towel on a microwave-safe plate and top with tortillas; heat in the microwave for 10 seconds."
    },
    {
      "position": 2,
      "text": "Place chicken in a microwave-safe bowl; heat in the microwave until heated through, 30 seconds to 1 minute."
    },
    {
      "position": 3,
      "text": "Layer chicken, cilantro, onion, and guacamole, in that order, onto each tortilla. Squeeze lime juice over each taco."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 0,
  "preparation_time_minutes": 10,

  "slug": "sweet-and-spicy-quick-pickled-carrots-recipe-11712360",
  "name": "Sweet and Spicy Quick Pickled Carrots",
  "recipe_type": "salad",
  "brief_description": "These sweet and spicy quick pickled carrots taste great on a banh mi or any other sandwich, salad or a grain bowl. Or eat them right out of the jar!",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place carrots, ginger, and jalape\u00f1o, if using, in a clean pint jar with a lid."
    },
    {
      "position": 3,
      "text": "In a small saucepan, bring water, vinegar, maple syrup, and salt to a boil."
    },
    {
      "position": 4,
      "text": "Pour as much of the brine over the carrot mixture in the jar as needed to cover."
    },
    {
      "position": 5,
      "text": "Screw on jar lid and chill at least 2 hours. Store in the refrigerator for 2 to 3 weeks."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

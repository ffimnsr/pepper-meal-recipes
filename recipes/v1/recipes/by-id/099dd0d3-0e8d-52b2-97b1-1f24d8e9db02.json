  "id": "099dd0d3-0e8d-52b2-97b1-1f24d8e9db02",
  "slug": "quick-and-easy-chicken-noodle-soup",
  "name": "Quick and Easy Chicken Noodle Soup",
  "recipe_type": "soup",
  "brief_description": "This easy chicken noodle soup recipe made with veggies and leftover chicken is warm, comforting, and ready to ladle into bowls in just over 30 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a large pot over medium heat. Add onion and celery; cook until just tender, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Stir in chicken broth, vegetable broth, egg noodles, chicken, carrots, basil, oregano, salt, and black pepper to combine; bring to a boil."
    },
    {
      "position": 3,
      "text": "Reduce heat; simmer for 20 minutes."
    },
    {
      "position": 4,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

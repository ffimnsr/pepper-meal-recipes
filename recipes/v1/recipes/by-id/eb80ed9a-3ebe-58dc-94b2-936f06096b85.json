  "id": "eb80ed9a-3ebe-58dc-94b2-936f06096b85",
  "slug": "mock-chicken",
  "name": "Mock Chicken",
  "recipe_type": "main",
  "brief_description": "Make mock chicken by freezing tofu for a meat-like texture. This is a great substitute for any recipe that calls for cooked or diced chicken meat.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Leave tofu in original package and place in freezer for 72 hours."
    },
    {
      "position": 2,
      "text": "Bring a pot of water to a simmer. Place package of tofu in water and allow to thaw, approximately 10 minutes. When thawed, remove from package, place in a piece of cheesecloth, and squeeze out liquid."
    },
    {
      "position": 3,
      "text": "Shred, dice, or slice tofu and include it in your favorite recipe."
    }
  ],
  "servings": 4,

  "id": "7ef95906-c61e-5a1a-b010-d9fd6ea85eb7",
  "slug": "cherry-or-fruit-cobbler",
  "name": "Cherry or Fruit Cobbler",
  "recipe_type": "dessert",
  "brief_description": "Sweetened fresh cherries or other fruit are spooned onto a simple batter in this upside-down golden brown cobbler recipe that's a versatile summer treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a (9-inch square) baking dish."
    },
    {
      "position": 2,
      "text": "Combine milk, baking mix, \u00be cup sugar, butter, cinnamon, and nutmeg in a large bowl; pour into the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Stir cherries and remaining \u00bd cup sugar together in a bowl; spoon onto batter in the baking dish."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, 45 to 50 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

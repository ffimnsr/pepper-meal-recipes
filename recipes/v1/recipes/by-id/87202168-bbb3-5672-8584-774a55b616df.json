  "id": "87202168-bbb3-5672-8584-774a55b616df",
  "slug": "shepherds-pie-i",
  "name": "Shepherd's Pie I",
  "recipe_type": "drink",
  "brief_description": "Saute ground beef, chopped onion and crushed tomatoes together, until the meat is browned and the juices are absorbed. Pile the mixture into a casserole dish, and top it with mashed potatoes and grated Cheddar cheese. Ten minutes in a hot oven melts the cheese and warms the potatoes.",
  "cuisine": "Scottish",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in frying pan. Add chopped onions, and fry until golden brown. Add ground beef, and keep stirring until meat is browned. Add crushed tomatoes, and continue to cook until liquid from the tomatoes evaporates. Salt to taste."
    },
    {
      "position": 2,
      "text": "In the meantime, prepare the mashed potatoes as directed on the packet."
    },
    {
      "position": 3,
      "text": "Spread the meat mixture into the bottom of an oven proof dish. Cover with a layer of mashed potatoes, and top with grated cheese."
    },
    {
      "position": 4,
      "text": "Bake for 10 minutes at 400 degrees F (205 degrees C), or until cheese has melted and browned."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 45,
  "rest_time_minutes": null,
  "difficulty": "medium",

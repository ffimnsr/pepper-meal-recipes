  "id": "8f20a412-dd8e-5405-b875-753674dddd02",
  "slug": "mommys-lemonade-margaritas",
  "name": "Mommy's Lemonade (Margaritas)",
  "recipe_type": "drink",
  "brief_description": "Mommy's lemonade (margaritas) recipe relies on Minute Maid limeade, tequila, and orange liqueur to make a pitcher of this quick and popular cocktail.",
  "cuisine": "Mexican Inspired American Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Pour limeade concentrate into a pitcher; fill the can with cold water three times, pouring each into the pitcher. Fill the can with tequila; pour into the pitcher. Fill the can halfway with orange liqueur; pour into the pitcher. Stir well; chill, about 30 minutes."
    },
    {
      "position": 2,
      "text": "Pour salt onto a small, shallow plate. Moisten rims of 12 glasses with 1 lime wedge; dip moistened glasses into salt."
    },
    {
      "position": 3,
      "text": "Fill glasses with ice; pour in margarita. Garnish with lime wedges."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

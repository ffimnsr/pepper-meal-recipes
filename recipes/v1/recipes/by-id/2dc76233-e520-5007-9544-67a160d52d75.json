  "id": "2dc76233-e520-5007-9544-67a160d52d75",
  "slug": "captain-duartes-salt-cod-cakes",
  "name": "Captain Duarte's Salt Cod Cakes",
  "recipe_type": "appetizer",
  "brief_description": "Salt cod is mashed with potatoes, fresh parsley, and seafood seasoning in this salt cod recipe for crispy cakes.",
  "cuisine": "Portuguese",
  "instructions": [
    {
      "position": 1,
      "text": "Place salt cod into a bowl and cover with cold water. Refrigerate for 8 hours; pour off water and replace it with fresh water every 2 hours."
    },
    {
      "position": 2,
      "text": "After soaking cod for 8 hours, rinse in cold water and cut into 3-inch portions."
    },
    {
      "position": 3,
      "text": "Place cod and potatoes into a large pot and cover with water. Bring to a boil over high heat, then reduce heat to medium-low, cover, and simmer until potatoes are tender and cod flakes easily with a fork, about 20 minutes. Drain and allow to cool for 10 minutes."
    },
    {
      "position": 4,
      "text": "Place potatoes and cod into a mixing bowl. Season with seafood seasoning, pepper, and parsley; roughly mash with a potato masher. Stir in eggs and onion until evenly combined; there should still be pieces of cod and potato in mixture."
    },
    {
      "position": 5,
      "text": "Place flour into a shallow bowl. Form cod mixture into golf ball-sized pieces and roll in flour. Press between your palms to flatten slightly."
    },
    {
      "position": 6,
      "text": "Heat olive oil in a large skillet over medium-high heat. Working in batches, cook cod cakes in hot oil until golden and crispy on both sides, about 3 minutes per side. Drain on a paper towel-lined plate."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

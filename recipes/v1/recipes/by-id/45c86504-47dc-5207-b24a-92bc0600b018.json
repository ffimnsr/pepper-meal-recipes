  "id": "45c86504-47dc-5207-b24a-92bc0600b018",
  "slug": "copycat-cracker-barrel-meatloaf-recipe-11949753",
  "name": "Copycat Cracker Barrel Meatloaf",
  "recipe_type": "main",
  "brief_description": "This copycat Cracker Barrel meatloaf is juicy and tender, with a zippy sauce baked on top just like the restaurant favorite. Ritz crackers and sharp Cheddar cheese are baked in to give it the rich, comforting flavor of the original.",
  "cuisine": "Copycat American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 9x5-inch loaf pan with parchment paper, leaving overhang on 2 long sides."
    },
    {
      "position": 2,
      "text": "Heat oil in a small skillet over medium heat. Add onion and bell pepper. Cook and stir until tender, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Beat eggs in a large bowl. Whisk in milk, salt and pepper. Stir in cooked onion and bell pepper, cheese, and cracker crumbs. Add ground beef and stir just until combined. Pat into the prepared loaf pan. Place the loaf pan on a rimmed baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 30 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, stir together ketchup, brown sugar, mustard, and Worcestershire in a small bowl."
    },
    {
      "position": 6,
      "text": "Remove meatloaf from the oven and spoon ketchup mixture over meatloaf."
    },
    {
      "position": 7,
      "text": "Return to the oven and bake until an instant-read thermometer inserted in the center registers 160 degrees F (71 degrees C), 40 to 50 minutes."
    },
    {
      "position": 8,
      "text": "Let cool on a wire rack 15 minutes before serving. Use parchment to lift meatloaf from the pan to transfer to a cutting board to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 15,

  "id": "d52d38cb-3dcb-5347-92a9-218394077315",
  "slug": "wine-jelly",
  "name": "Wine Jelly",
  "recipe_type": "side",
  "brief_description": "This jelly is a lovely accompaniment to crackers and cream cheese. You can use any kind of wine, red or white.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine wine, lemon juice, and pectin in a large saucepot. Bring to a boil, stirring frequently. Add sugar, stirring until dissolved. Return to a rolling boil. Boil hard 1 minute, stirring constantly. Remove from heat. Skim foam off top, if necessary."
    },
    {
      "position": 2,
      "text": "Ladle hot jelly into hot, sterilized jars, leaving 1/2 inch headspace. Tighten 2 piece lids. Process for 5 minutes in boiling water bath."
    }
  ],

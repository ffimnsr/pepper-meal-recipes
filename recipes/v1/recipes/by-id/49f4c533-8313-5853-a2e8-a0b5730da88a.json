  "id": "49f4c533-8313-5853-a2e8-a0b5730da88a",
  "slug": "soy-eggs-shoyu-tamago",
  "name": "Soy Eggs (Shoyu Tamago)",
  "recipe_type": "appetizer",
  "brief_description": "Perfect in ramen, these soy eggs are boiled then soaked in a symphony of low-sodium soy sauce, mirin, ponzu, green onions, and togarashi.",
  "cuisine": "Asian Inspired Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Place eggs in a pot. Cover with about 1 inch water. Remove eggs and stir vinegar into water. Bring to a boil. Gently place eggs back in the pot. Cover and cook for 5 minutes to soft-boil. Cook 3 minutes more for hard-boiled eggs. Prepare an ice bath in the meantime."
    },
    {
      "position": 2,
      "text": "Remove heat and immediately place eggs in the ice bath. Peel eggs carefully."
    },
    {
      "position": 3,
      "text": "Combine soy sauce, ponzu sauce, mirin, scallions, garlic, brown sugar, sesame oil, togarashi, and ginger in a container such as a jar. Mix well to ensure sugar dissolves and garlic breaks up."
    },
    {
      "position": 4,
      "text": "Place eggs in mixture and seal. Marinate for 1 day. Eggs keep for 3 or 4 days after."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

  "id": "7d23d055-7927-5cd3-911c-af8e5e1140a6",
  "slug": "bloody-caesar-recipe-8730391",
  "name": "Bloody Caesar",
  "recipe_type": "appetizer",
  "brief_description": "The Bloody Caesar is an iconic Canadian cocktail. What sets it apart from the classic Bloody Mary is the base of Clamato juice, a savory mix of tomato and clam juice with a distinctly briny taste.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Sprinkle celery salt onto a plate. Moisten the rim of a glass with lime wedge. Press the moistened rim into the salt. Fill glass with ice."
    },
    {
      "position": 2,
      "text": "Add vodka, Worcestershire sauce, and Tabasco sauce, then fill with Clamato juice and gently stir. Sprinkle in a pinch of celery salt, then garnish with lime wedge, celery stick and other preferred garnishes."
    }
  ],

  "slug": "beckys-chicken-salad",
  "name": "Becky's Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "Whipped cream gives this chicken salad a lift. Green grapes and crunchy almonds add sweetness and texture to this creamy chicken salad.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl, whip cream to soft peaks."
    },
    {
      "position": 2,
      "text": "Combine meat, celery, grapes, almonds, parsley, salt, and mayonnaise with whipped cream. Chill."
    }
  ],

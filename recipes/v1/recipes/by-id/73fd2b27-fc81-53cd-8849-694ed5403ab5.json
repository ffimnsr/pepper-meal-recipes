  "id": "73fd2b27-fc81-53cd-8849-694ed5403ab5",
  "slug": "fall-harvest-orzo-pasta-salad-recipe-8730634",
  "name": "Fall Harvest Orzo Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "This fall harvest orzo pasta salad combines butternut squash, bacon, Brussels sprouts, walnuts, and cranberries with a maple vinaigrette.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a rimmed baking sheet with foil or parchment; place bacon on the sheet."
    },
    {
      "position": 2,
      "text": "Bake bacon in the preheated oven until crisp, about 10 minutes. Remove bacon from tray and drain on paper towels. Reserve drippings in the pan."
    },
    {
      "position": 3,
      "text": "Increase the oven temperature 425 degrees F (220 degrees C)."
    },
    {
      "position": 4,
      "text": "Add butternut squash, onion, 2 tablespoons olive oil, 1 teaspoon salt, \u00bd teaspoon pepper, and thyme to the pan with bacon drippings and toss to coat."
    },
    {
      "position": 5,
      "text": "Roast squash in the preheated oven until browned, about 20 minutes. Set aside."
    },
    {
      "position": 6,
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Cook orzo in the boiling water, stirring occasionally, until tender yet firm to the bite, about 10 minutes. Drain and set aside to cool."
    },
    {
      "position": 7,
      "text": "For vinaigrette, add vinegar, maple syrup, mustard, garlic powder, remaining 1 teaspoon salt, and remaining \u00bd teaspoon pepper into a bowl. Whisk in 1/4 cup olive oil until well combined. Set aside."
    },
    {
      "position": 8,
      "text": "Add pasta, Brussels sprouts, walnuts, cranberries, and vinaigrette to a large bowl and toss to combine. Gently stir in cooked vegetables and bacon. Serve immediately or refrigerate until ready to serve."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

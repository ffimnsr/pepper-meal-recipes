  "slug": "banana-pudding-milkshake-recipe-8651992",
  "name": "Banana Pudding Milkshake",
  "recipe_type": "snack",
  "brief_description": "This banana pudding milkshake is a delicious copycat of the restaurant version. With fresh banana, vanilla wafers, and pudding mix, it's a cinch to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add milk and frozen yogurt to the jar of a blender. Slice banana; set 4 to 6 slices aside for garnish. Add remaining banana and pudding mix to the blender. Set 2 vanilla wafers aside for garnish; add remaining vanilla wafers to the blender. Blend until smooth."
    },
    {
      "position": 2,
      "text": "Pour mixture into 2 tall glasses. Top each milkshake with whipped cream, remaining banana slices, and a vanilla wafer."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 5,

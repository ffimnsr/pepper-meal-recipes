{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "43a4647f-ea48-5fb0-9565-36f9a83fc818",
  "slug": "cheesy-meatloaf-cups-recipe-11928449",
  "name": "Cheesy Meatloaf Cups",
  "recipe_type": "main",
  "brief_description": "These tasty cheesy meatloaf cups cook quickly, and they\u2019re perfect for portion control. I keep a bag of them in the freezer to reheat for busy weeknight dinners. They\u2019re such a time saver.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Spray a 12-cup full-size muffin tin with cooking spray, and set aside."
    },
    {
      "position": 2,
      "text": "Place meat in a large bowl, and break up with a fork. Mix in stuffing, milk, egg, Italian seasoning, garlic powder, red pepper flakes, salt, and pepper until just combined."
    },
    {
      "position": 3,
      "text": "Scoop mixture equally into the 12 muffin cups, pressing down firmly on the bottom (using the bottom of a small glass works well) and up the sides, and spoon in some chili sauce. Make a well in the center of each, and spoon in some chili sauce."
    },
    {
      "position": 4,
      "text": "Bake uncovered in the preheated oven until cooked through, about 15 minutes. Evenly sprinkle each muffin cup with mozzarella, return to the oven, bake until cheese melts, 3 to 5 minutes more."
    },
    {
      "position": 5,
      "text": "Remove from the oven when an instant read thermometer, inserted into the center, reaches 160 degrees F (71 degrees C) and let rest for 5 minutes. Run a knife around the inside of each cup to loosen the meat, remove from muffin tin, garnish with a sprinkle of Italian seasoning, and serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

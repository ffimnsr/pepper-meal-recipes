  "id": "d64b0e7d-b2c1-5dab-a4bf-51103746d7d3",
  "slug": "migas-breakfast-tacos",
  "name": "Migas Breakfast Tacos",
  "recipe_type": "breakfast",
  "brief_description": "In these migas breakfast tacos eggs are cooked with Hatch chiles and onions and served on a tortilla topped with fried corn tortilla strips.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Crack eggs into a bowl and whisk in milk, salt, and pepper. Set aside."
    },
    {
      "position": 2,
      "text": "Melt butter in a skillet over medium heat. Add Hatch chiles and onions. Saute until onions are soft and translucent, 4 to 5 minutes. Add eggs and cook and stir until eggs are set, 3 to 4 minutes."
    },
    {
      "position": 3,
      "text": "Divide eggs between 6 tortillas and top with fried corn tortilla strips."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,

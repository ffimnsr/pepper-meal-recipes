  "schema_version": 1,
  "id": "534f99ca-55b9-5741-8506-1dbd8e510836",
  "slug": "barbequed-ribs",
  "name": "Barbequed Ribs",
  "recipe_type": "main",
  "brief_description": "These pork ribs require a double cooking process and an overnight bath in a marinade. The spicy rub and rich sauce make them worth the wait!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 300 degrees F (150 degrees C). Place ribs on a rack in a shallow roasting pan. Scatter 4 cloves of sliced garlic over ribs. Cover, and bake for 2 1/2 hours. Cool slightly."
    },
    {
      "position": 2,
      "text": "In a small bowl, mix together white sugar, paprika, salt, black pepper, chili powder, and ground cumin. Rub spices over cooled ribs. Cover, and refrigerate overnight."
    },
    {
      "position": 3,
      "text": "In a small saucepan, mix together brown sugar, cider vinegar, ketchup, chili sauce, Worcestershire sauce, lemon juice, onion, dry mustard, and 1 clove garlic. Simmer over medium-low heat, uncovered, for 1 hour. Reserve a small amount for basting; the remainder is a dipping sauce."
    },
    {
      "position": 4,
      "text": "Preheat grill for medium heat."
    },
    {
      "position": 5,
      "text": "Place ribs on grill. Grill, covered, for about 12 minutes, basting with the reserved sauce, until nicely browned and glazed. Serve with remaining sauce for dipping."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 180,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "expert",

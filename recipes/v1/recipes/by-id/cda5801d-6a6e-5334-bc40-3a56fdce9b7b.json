  "id": "cda5801d-6a6e-5334-bc40-3a56fdce9b7b",
  "slug": "easy-cold-pasta-salad",
  "name": "Easy Cold Pasta Salad",
  "recipe_type": "salad",
  "brief_description": "This easy cold pasta salad recipe with tomatoes, cucumbers, black olives, and tangy Italian dressing is quick to make and perfect for large gatherings.",
  "cuisine": "American Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil; cook rotini at a boil until tender yet firm to the bite, about 8 minutes. Drain in a colander set in the sink; cool under cold running water."
    },
    {
      "position": 2,
      "text": "Combine pasta, cucumbers, olives, onion, and tomatoes in a large bowl. Add Italian dressing; toss to combine. Cover and refrigerate before serving, at least 2 hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

  "id": "7c8c8fe6-a0fb-5577-aee4-b77210f39756",
  "slug": "cinnamon-roll-butter-swim-biscuits-recipe-11905339",
  "name": "Cinnamon Roll Butter Swim Biscuits",
  "recipe_type": "breakfast",
  "brief_description": "These cinnamon roll butter swim biscuits are the best of both worlds. A cinnamon swirl layer in the center of buttery biscuit dough makes them great for breakfast or with mid-morning coffee.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (190 degrees C). Stir brown sugar, cinnamon, and 2 tablespoons heavy cream together in a small bowl until smooth and set aside."
    },
    {
      "position": 2,
      "text": "Place butter in an 8x8-inch baking dish and microwave on high until melted."
    },
    {
      "position": 3,
      "text": "Whisk flour, sugar, baking powder, and salt together in a bowl. Add 1 cup heavy cream and buttermilk and stir until just blended."
    },
    {
      "position": 4,
      "text": "Pour half the batter into the buttered dish, then spoon brown sugar mixture randomly over the top, and use a paring knife to slightly swirl or spread the mixture. Top with remaining batter."
    },
    {
      "position": 5,
      "text": "Batter will be thick, so gently and quickly spread batter as evenly as possible over cinnamon mixture."
    },
    {
      "position": 6,
      "text": "Use a knife to score batter into 9 or 12 squares."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until biscuits are evenly browned and cooked through, 25 to 27 minutes."
    },
    {
      "position": 8,
      "text": "Meanwhile, whisk together confectioner\u2019s sugar and cream cheese with remaining heavy cream until smooth. Spread mixture evenly over hot biscuits. Serve warm or at room temperature."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

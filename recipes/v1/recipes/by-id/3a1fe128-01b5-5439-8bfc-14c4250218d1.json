  "id": "3a1fe128-01b5-5439-8bfc-14c4250218d1",
  "slug": "andouille-sausage-and-corn-chowder",
  "name": "Andouille Sausage and Corn Chowder",
  "recipe_type": "soup",
  "brief_description": "This Cajun corn chowder is slightly spicy and smoky thanks to the addition of the andouille sausage and cayenne pepper.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large pot over medium-high heat. Cook and stir onion, bell peppers, and celery in hot oil until softened, about 5 minutes. Add sausage, garlic, and cayenne pepper; cook and stir until sausage is hot, 1 to 2 minutes. Stir in corn and bay leaves; season with thyme. Saut\u00e9 until corn is warmed through, about 1 minute."
    },
    {
      "position": 2,
      "text": "Pour broth into the pot; bring to a boil. Reduce heat to medium-low and cook at a simmer for about 30 minutes, stirring occasionally."
    },
    {
      "position": 3,
      "text": "Stir in potatoes and heavy cream. Cover and continue cooking at a simmer until potatoes are tender, about 20 minutes."
    },
    {
      "position": 4,
      "text": "Season chowder with salt and black pepper. Remove and discard bay leaves. Garnish with cilantro to serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

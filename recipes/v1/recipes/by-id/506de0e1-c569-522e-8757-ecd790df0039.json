  "id": "506de0e1-c569-522e-8757-ecd790df0039",
  "slug": "dawns-easy-red-velvet-sandwich-cookies",
  "name": "Dawn's Easy Red Velvet Sandwich Cookies",
  "recipe_type": "dessert",
  "brief_description": "These tasty red velvet sandwich cookies are sure to be a hit when sandwiched with homemade cream cheese icing and decorated with chopped pecans.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix together cake mix, eggs, oil, and bourbon in a large bowl. Roll the dough into balls the size of walnuts. Place 2 inches apart on ungreased baking sheets."
    },
    {
      "position": 3,
      "text": "Bake cookies in the preheated oven until the tops start to crack, about 8 minutes. Cool in the pans for 10 minutes before removing to cool completely on a wire rack."
    },
    {
      "position": 4,
      "text": "To make the icing: Combine cream cheese, butter, evaporated milk, vanilla, and coconut in a large bowl. Add confectioners' sugar, 1 cup at a time, mixing well with each addition. If consistency is too stiff, add more milk."
    },
    {
      "position": 5,
      "text": "Place the chopped pecans in a bowl. Spread a generous amount of icing on the bottom of a cookie, sandwich it with another cookie, pressing firmly so that the icing comes all the way out to the edge. Roll the edges of the sandwich cookies in the chopped pecans. Repeat with the remaining cookies."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 8,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

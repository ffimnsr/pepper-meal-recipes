{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "0c90bb7f-63eb-59bd-a889-5e4286dce983",
  "slug": "balsamic-and-herb-quinoa-salad",
  "name": "Balsamic and Herb Quinoa Salad",
  "recipe_type": "salad",
  "brief_description": "Herb quinoa salad with balsamic dressing is made with fresh mozzarella cheese, almonds, and lima beans and is a hearty side dish or lunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring 2 cups water, quinoa, and bouillon granules to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until quinoa is tender and water has been absorbed, 15 to 20 minutes. Spread quinoa onto a baking sheet and refrigerate until cooled, about 30 minutes. Rinse the saucepan."
    },
    {
      "position": 2,
      "text": "Place lima beans into the saucepan and add water to cover beans by 1 inch; season with salt and pepper. Cover the saucepan with a lid and bring water to a boil. Reduce heat to medium and simmer until beans are cooked through but still tender, 3 to 4 minutes. Drain water and rinse beans under cold water to stop the cooking process; refrigerate until cool, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Cook and stir almonds in a skillet over medium heat until toasted, about 5 minutes. Remove the skillet from heat and cool almonds to room temperature, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Mix quinoa, lima beans, almonds, tomatoes, scallions, and mozzarella cheese together in a large bowl."
    },
    {
      "position": 5,
      "text": "Whisk vinegar, almond oil, olive oil, Italian seasoning, basil, garlic, and salt together in a small bowl until smooth; pour over quinoa mixture and stir to coat."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

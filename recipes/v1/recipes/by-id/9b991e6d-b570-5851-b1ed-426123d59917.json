  "slug": "homemade-marinara-sauce-recipe-11948855",
  "name": "Homemade Marinara Sauce",
  "recipe_type": "side",
  "brief_description": "This homemade marinara sauce is savory and flavorful, and simmers for just under a half hour. Keep San Marzano tomatoes and a few other ingredients in the pantry, and you can have delicious marinara any time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a large saucepan over medium-high heat. Add onion and 1/2 teaspoon salt and cook until very soft and translucent, about 5 minutes. Add garlic and crushed red pepper and cook one minute longer."
    },
    {
      "position": 2,
      "text": "Add tomatoes, water, remaining salt and pepper and stir to combine. Bring mixture to a simmer and cook 10-15 minutes. Use a wooden spoon or potato masher to break up the tomatoes to very small pieces."
    },
    {
      "position": 3,
      "text": "Stir in tomato paste and fresh basil and cook 5 minutes longer."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

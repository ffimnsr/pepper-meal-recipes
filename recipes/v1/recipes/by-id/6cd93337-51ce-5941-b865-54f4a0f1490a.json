  "schema_version": 1,
  "id": "6cd93337-51ce-5941-b865-54f4a0f1490a",
  "slug": "1-2-3-4-coconut-cake-recipe-11965168",
  "name": "1-2-3-4 Coconut Cake",
  "recipe_type": "dessert",
  "brief_description": "This 1-2-3-4 coconut cake is a coconut variation of the classic 1-2-3-4 cake, named for the quantities of its key ingredients. This easy cake recipe yields a moist and fluffy layered cake with a light coconut flavor, topped with a creamy homemade coconut buttercream frosting and more coconut.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour 2 9-inch round pans."
    },
    {
      "position": 2,
      "text": "Beat butter and 1 cup sugar with an electric mixer in a large bowl until light and fluffy, about 2 minutes. The mixture should be noticeably lighter in color."
    },
    {
      "position": 3,
      "text": "In a separate bowl, beat egg yolks well, then add to the butter mixture."
    },
    {
      "position": 4,
      "text": "Sift together flour, baking powder, and baking soda. Add alternately with coconut milk to the butter-sugar mixture. Beat well. Add vanilla and coconut extracts and beat until combined."
    },
    {
      "position": 5,
      "text": "Beat egg whites until stiff but not dry, 4 to 6 minutes. Add 1 cup sugar to egg whites. Fold the egg white mixture and shredded coconut into cake batter. Divide evenly into prepared pans."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 30 to 33 minutes. Cool in pans on a wire cooling rack for 30 minutes, then remove from the pans and allow to cool on the wire rack completely before frosting."
    },
    {
      "position": 7,
      "text": "For frosting, use an electric mixer or a stand mixer fitted with the paddle attachment to cream butter on medium speed until light and fluffy, about 2 minutes."
    },
    {
      "position": 8,
      "text": "Gradually add confectioners\u2019 sugar, 1 cup at a time, mixing on low speed."
    },
    {
      "position": 9,
      "text": "Gradually add coconut milk, vanilla extract, and coconut extract, starting at low then increasing to medium speed until combined. Continue to beat at a medium speed until light and fluffy (about 2 minutes), scraping the bowl as needed to make sure all ingredients are incorporated."
    },
    {
      "position": 10,
      "text": "Using a cake leveler or large serrated knife, slice off the tops of the cakes so they are even heights with flat tops. Place 1 layer on a cake stand or serving platter. Top with about 1 cup frosting and spread to create a thick, even layer. Stack the second layer of cake upside-down on top, then spread remaining frosting on the top and sides of the cake."
    },
    {
      "position": 11,
      "text": "Press shredded coconut onto the frosting on the top and sides of the cake. Chill for 30 minutes before slicing."
    }
  ],
  "servings": 12,

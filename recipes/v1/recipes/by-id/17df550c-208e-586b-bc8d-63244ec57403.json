  "id": "17df550c-208e-586b-bc8d-63244ec57403",
  "slug": "healthier-worlds-best-lasagna",
  "name": "Healthier World's Best Lasagna",
  "recipe_type": "main",
  "brief_description": "Healthier lasagna can still taste just as good as the original. Turkey sausage, ground turkey, and low fat mozzarella help make this satisfying dish just as tasty and better for you.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a Dutch oven or large skillet over medium heat. Add turkey sausage, ground turkey, onion, and garlic; cook and stir until well browned, about 15 minutes. Stir in crushed tomatoes, tomato sauce, tomato paste, and water. Season with parsley, basil, Italian seasoning, fennel seeds, and black pepper; simmer, uncovered, about 1 1/2 hours, stirring occasionally."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Bring a large pot of lightly salted water to a boil. Cook lasagna noodles in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain."
    },
    {
      "position": 4,
      "text": "Spread 1 1/2 cups sauce in bottom of a 9x13 baking dish. Arrange 6 noodles lengthwise over sauce. Spread half the ricotta over noodles; top with one third mozzarella slices. Spoon 1 1/2 cups sauce over mozzarella; sprinkle with 1/4 cup Parmesan. Repeat layers; top with remaining mozzarella and Parmesan cheese. Cover dish with aluminum foil, making sure foil doesn't touch cheese to prevent sticking."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until sauce hot and cheese melted, about 25 minutes. Remove foil; continue baking until cheese golden brown, about 25 minutes more. Cool 15 minutes before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 150,
  "preparation_time_minutes": 30,

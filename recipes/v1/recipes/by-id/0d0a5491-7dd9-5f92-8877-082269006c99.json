  "id": "0d0a5491-7dd9-5f92-8877-082269006c99",
  "slug": "instant-pot-butternut-squash-and-pear-soup",
  "name": "Instant Pot\u00ae Butternut Squash and Pear Soup",
  "recipe_type": "soup",
  "brief_description": "By precooking butternut squash in your Instant Pot\u00ae, the skin will slip right off, allowing you to make this quick and flavorful soup in just minutes!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Cut butternut squash into 4 pieces and remove seeds. Pour water into the bottom of a multi-functional electric pressure cooker and place trivet inside. Place squash on trivet, close lid, and set seal valve. Select high pressure according to manufacturer's instructions; set timer for 10 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 2,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Drain out the water and wipe the bottom of the pot dry. Remove squash skin and discard. Roughly chop any large pieces into smaller 1- to 2-inch chunks. Set aside."
    },
    {
      "position": 3,
      "text": "Select the Saute function and heat olive oil. Saute onion and garlic for 1 to 2 minutes. Add pears, salt, and sage; cook for 1 to 2 minutes more. Turn pressure cooker off. Add the squash and chicken broth. Close lid and seal valve. Select high pressure; set timer for 5 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Release pressure manually and remove lid. Blend soup until smooth using an immersion blender. Stir in heavy cream."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

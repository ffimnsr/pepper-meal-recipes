  "schema_version": 1,
  "id": "5e355619-b599-5248-937b-dd784e1cfbf7",
  "slug": "buffalo-shrimp",
  "name": "Buffalo Shrimp",
  "recipe_type": "side",
  "brief_description": "Succulent shrimp twice-coated in seasoned flour and deep fried, then coated in an extremely spicy butter sauce. Perfect for those who crave the heat. For added heat, slice up some fresh cayenne or jalapeno peppers to sprinkle over the top. Serve with lemon wedges and blue cheese dressing on the side.",
  "cuisine": "Cajun",
  "instructions": [
    {
      "position": 1,
      "text": "Combine flour, Creole-style seasoning, garlic powder, cayenne pepper, onion powder, and black pepper in a large resealable plastic bag."
    },
    {
      "position": 2,
      "text": "Rinse shrimp under cold water and place them in flour mixture. Seal the bag and shake until shrimp are well coated with flour mixture. Spread coated shrimp on a baking sheet and place in the refrigerator for 15 to 20 minutes. Set aside flour mixture in the bag."
    },
    {
      "position": 3,
      "text": "Meanwhile, make sauce: Whisk together hot sauce, butter, garlic, and cayenne pepper in a small bowl; set aside."
    },
    {
      "position": 4,
      "text": "Heat oil in a deep fryer or large saucepan to 350 degrees F (175 degrees C)."
    },
    {
      "position": 5,
      "text": "Remove shrimp from the refrigerator and shake once more in flour mixture; discard flour mixture."
    },
    {
      "position": 6,
      "text": "Working in batches, fry shrimp in hot oil until opaque, 2 to 3 minutes. Use a slotted spoon to remove fried shrimp to a serving bowl and coat with sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

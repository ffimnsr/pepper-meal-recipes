  "id": "7b353c7b-2206-54f4-b0ee-1379b2d5ef08",
  "slug": "air-fryer-spanish-tortilla",
  "name": "Air Fryer Spanish Tortilla",
  "recipe_type": "appetizer",
  "brief_description": "A Spanish tortilla is just as tasty when made in your air fryer. This vegetarian version saves on cleanup and uses less oil than traditional recipes.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Rinse potato cubes and put them into a bowl with cold water to soak for about 10 minutes."
    },
    {
      "position": 2,
      "text": "Preheat an air fryer to 325 degrees F (160 degrees C)."
    },
    {
      "position": 3,
      "text": "Drain potatoes and pat dry. Transfer to a bowl and toss with olive oil. Put them into the air fryer basket."
    },
    {
      "position": 4,
      "text": "Cook for 18 minutes. Raise the temperature to 350 degrees F (180 degrees C). Shake the basket. Add leek and shake basket again. Cook until leek has softened, about 3 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, whisk eggs, Pecorino Romano cheese, salt, and pepper together in a bowl and pour into a 6-inch, nonstick cake pan. Mix in cooked potatoes and leek. Set cake pan into the air fryer basket. Cook until tortilla has browned on top and the middle no longer jiggles, about 15 minutes."
    },
    {
      "position": 6,
      "text": "Remove from the air fryer and cool for 5 minutes. Sprinkle with Italian parsley before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

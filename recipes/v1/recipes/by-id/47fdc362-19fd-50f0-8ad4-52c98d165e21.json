  "id": "47fdc362-19fd-50f0-8ad4-52c98d165e21",
  "slug": "bramble-cocktail-recipe-11781007",
  "name": "Bramble (Cocktail)",
  "recipe_type": "appetizer",
  "brief_description": "The Bramble is a tart, refreshing gin cocktail that perfectly balances bright citrus with juicy berry flavors.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Add ice cubes, gin, lemon juice, and simple syrup to a cocktail shaker. Seal and shake vigorously until outside is frosted, 10 to 15 seconds."
    },
    {
      "position": 2,
      "text": "Fill a rocks glass with crushed ice. Strain cocktail into glass, then gently pour cr\u00e8me de m\u00fbre over the top to create a layered effect. The cr\u00e8me de m\u00fbre will sink down to the bottom of the glass. Garnish with blackberries and a lemon slice."
    }
  ],

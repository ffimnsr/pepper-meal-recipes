  "id": "39b8a228-1e90-5eab-ae92-7ab226623a6b",
  "slug": "overnight-french-toast-casserole",
  "name": "Overnight French Toast Casserole",
  "recipe_type": "breakfast",
  "brief_description": "Instead of flipping French toast two pieces at a time, try this overnight French toast casserole--prepare it at night and just wake up and pop it in the oven in the morning.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Pour melted butter into an 11x15-inch baking dish. Sprinkle brown sugar and cinnamon over the butter and top with bread slices, making sure slices are placed close together."
    },
    {
      "position": 2,
      "text": "Mix milk, eggs, and vanilla extract in a bowl until thoroughly combined; pour over bread in the baking dish. Cover with aluminum foil and refrigerate, 8 hours to overnight."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 4,
      "text": "Place the covered casserole in the preheated oven and bake for 30 minutes. Uncover, and bake until puffed and lightly golden, about 15 minutes more."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,

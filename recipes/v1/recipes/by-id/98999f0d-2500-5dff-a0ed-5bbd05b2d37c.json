  "id": "98999f0d-2500-5dff-a0ed-5bbd05b2d37c",
  "slug": "caramel-apples",
  "name": "Caramel Apples",
  "recipe_type": "dessert",
  "brief_description": "Caramel apples are a Halloween delight: Crunchy red apples on sticks, bathed in gooey caramel. Decorate with chopped nuts, melted chocolate, or candy.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Remove the stem from each apple and press a craft stick into the top. Spray a baking sheet with cooking spray."
    },
    {
      "position": 3,
      "text": "Place caramels and milk in a microwave-safe bowl; microwave for 2 minutes, stirring once. Set aside to cool briefly."
    },
    {
      "position": 4,
      "text": "Roll each apple quickly in caramel sauce until well coated. Place on prepared sheet to set."
    },
    {
      "position": 5,
      "text": "Enjoy! Celebrate fall in the sweetest way: With this homemade caramel apple recipe!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 2,
  "preparation_time_minutes": 8,

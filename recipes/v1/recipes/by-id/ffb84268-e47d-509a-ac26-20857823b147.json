  "id": "ffb84268-e47d-509a-ac26-20857823b147",
  "slug": "vegan-hearts-of-palm-ceviche",
  "name": "Vegan Hearts of Palm Ceviche",
  "recipe_type": "appetizer",
  "brief_description": "This light vegan ceviche with hearts of palm, tomatoes, onion, and cilantro gets its spice from serrano peppers. Serve over tostadas or as a dip.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Place hearts of palm slices in a glass bowl. Add tomatoes, onion, cilantro, and serrano peppers."
    },
    {
      "position": 2,
      "text": "Measure 3/4 cup hearts of palm juice into a bowl; discard remaining juice. Mix vinegar and olive oil into the bowl. Pour over hearts of palm mixture. Season with oregano, salt, and pepper. Garnish with olives and avocado slices."
    }
  ],
  "servings": 6,

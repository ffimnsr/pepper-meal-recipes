  "id": "6c3f0381-46e2-59ed-99a9-4eb7dc0cf424",
  "slug": "lemon-basil-pesto-flat-iron-steak",
  "name": "Lemon Basil Pesto Flat Iron Steak",
  "recipe_type": "main",
  "brief_description": "Lemon and basil combine nicely into a pesto topping for steaks.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Chop garlic cloves in a food processor until minced. Add basil and pine nuts and pulse a few times to combine. With the food processor running, slowly pour in olive oil, stopping once or twice to scrape down the sides. Add Parmesan cheese, lemon juice, and red pepper flakes and pulse until blended. Season with salt and pepper."
    },
    {
      "position": 2,
      "text": "Preheat an outdoor grill to medium-high heat and lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Rub steaks with minced garlic and season with salt and pepper."
    },
    {
      "position": 4,
      "text": "Grill steaks to the desired degree of doneness on the preheated grill, about 4 minutes per side for medium. Baste steaks occasionally with a little of the pesto sauce. Once done, serve topped with the remaining pesto."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

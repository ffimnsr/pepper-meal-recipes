  "id": "1c03efde-eaad-5819-bf0e-88b79f8a3520",
  "slug": "loaded-breakfast-crunchwrap-recipe-12032756",
  "name": "Loaded Breakfast Crunchwrap",
  "recipe_type": "breakfast",
  "brief_description": "This loaded breakfast crunchwrap recreates the iconic breakfast favorite with layers of eggs, bacon, cheese, jalape\u00f1os, and a crispy hash brown wrapped in a tortilla and griddled until crisp. It\u2019s an easy, flavor-packed breakfast that\u2019s perfect with your favorite hot sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a skillet over medium\u2013high heat. Add hash brown patties and cook until very crisp, 15 to 20 minutes, flipping occasionally until browned and toasted. Remove and set aside."
    },
    {
      "position": 2,
      "text": "Return skillet to medium heat and add butter. Once melted, add eggs and season with salt and pepper. Cook, stirring constantly until soft-scrambled."
    },
    {
      "position": 3,
      "text": "Add eggs to the center of 4 tortillas and add 1 to 2 tablespoons cheese on top."
    },
    {
      "position": 4,
      "text": "Place hash browns on top of eggs. Place 4 bacon halves on hash brown patties and top with jalapeno slices and remaining cheese."
    },
    {
      "position": 5,
      "text": "Cut remaining tortilla in quarters. Place one tortilla piece on top of each portion. Tuck and fold the outer large tortilla around the sides and top of the small tortilla until sealed."
    },
    {
      "position": 6,
      "text": "Heat skillet or griddle over medium-high heat and add butter to melt. Place crunchwraps, seam side down, into the skillet and cook until toasted, about 1 minute. Flip and cook until toasted, about 1 minute."
    },
    {
      "position": 7,
      "text": "Serve with hot sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

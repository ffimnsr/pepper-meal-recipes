  "id": "703095c0-c7d0-56e5-936c-b5420c3dcf34",
  "slug": "irish-soda-bread-i",
  "name": "Irish Soda Bread",
  "recipe_type": "dessert",
  "brief_description": "This Irish soda bread recipe uses sour cream for a rich, moist, cake-like texture.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease two 8x4-inch loaf pans."
    },
    {
      "position": 2,
      "text": "Mix flour, sugar, baking powder, baking soda, and salt. Add sour cream, raisins, and eggs; mix until just combined. Distribute batter evenly between the prepared pans."
    },
    {
      "position": 3,
      "text": "Bake loaves in the preheated oven for 1 hour."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 60,

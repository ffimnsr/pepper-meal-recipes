  "id": "35afd75e-7af1-59ac-9d14-c068c1356a7b",
  "slug": "jalapeno-popper-swim-biscuits-recipe-11826479",
  "name": "Jalapeno Popper Swim Biscuits",
  "recipe_type": "side",
  "brief_description": "These jalapeno popper swim biscuits are buttery biscuits with an entire cream cheese and Cheddar-filled jalapeno baked into each one.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (235 degrees C). Spray a 9x9-inch baking pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Whisk flour, baking powder, sugar, and salt together in a large bowl. Add buttermilk and stir to combine. Fold in 1 cup shredded Cheddar and chives."
    },
    {
      "position": 3,
      "text": "Pat dough evenly into the prepared baking dish. Using a spatula or dough blade, cut dough into 9 even pieces."
    },
    {
      "position": 4,
      "text": "Insert 1 jalapeno into each of the 9 sections of dough."
    },
    {
      "position": 5,
      "text": "In a small bowl combine cream cheese, remaining cheddar, and bacon. Transfer mixture into a piping bag or use a small spoon and fill each jalapeno with cream cheese mixture. Pour melted butter evenly over biscuits."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until biscuits are risen and golden brown, 20 to 25 minutes. If tops of jalapenos start to brown, tent the pan with foil. Serve with hot honey."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "7c4f1e73-7704-5709-8bde-8526035d8faa",
  "slug": "prize-winning-baby-back-ribs",
  "name": "Prize-Winning Baby Back Ribs",
  "recipe_type": "main",
  "brief_description": "Cooking ribs on the grill is easy with this foolproof recipe for spiced baby back ribs cooked low and slow until fall-off-the-bone tender and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Preheat a gas grill for high heat, or arrange charcoal briquettes on one side of the barbeque. Lightly oil the grate."
    },
    {
      "position": 3,
      "text": "Combine cumin, chili powder, paprika, salt, and pepper in a small jar; close the lid and shake to mix."
    },
    {
      "position": 4,
      "text": "Trim the membrane sheath from the back of each rack. Run a small, sharp knife between the membrane and each rib, and snip off the membrane as much as possible."
    },
    {
      "position": 5,
      "text": "Sprinkle as much of the rub onto both sides of ribs as desired. To prevent ribs from becoming too dark and spicy, do not thoroughly rub spices into ribs. Store any unused spice mix in a jar for future use."
    },
    {
      "position": 6,
      "text": "Place aluminum foil on the lower rack to capture drippings and prevent flare-ups. Lay ribs on the top rack of the grill (away from the coals, if you\u2019re using briquettes). Reduce gas heat to low and close the lid; cook ribs, undisturbed as possible, until meat pulls away easily from the bone, about 1 hour. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C)."
    },
    {
      "position": 7,
      "text": "Brush ribs with barbecue sauce, and grill for an additional 5 minutes."
    },
    {
      "position": 8,
      "text": "Serve ribs as a whole rack, or cut between each rib bone and pile individually on a platter."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

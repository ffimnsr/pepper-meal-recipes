{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "f451e49c-8d13-595f-ab8d-4309b41f7b90",
  "slug": "chef-johns-salisbury-steak",
  "name": "Chef John's Salisbury Steak",
  "recipe_type": "main",
  "brief_description": "TV dinner-reminiscent Salisbury steak, Chef John-style. Serve with buttered mashed potatoes and green beans on a tray table in front of your TV if desired!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Prepare the steaks: Mix ground beef, bread crumbs, egg, ketchup, Worcestershire sauce, mustard, soy sauce, pepper, and cayenne together in a mixing bowl with a fork or your hands until well combined. Cover with plastic wrap and refrigerate for at least 2 hours or overnight."
    },
    {
      "position": 2,
      "text": "When almost ready to cook the steaks, make the gravy: Melt butter in a large nonstick skillet over high heat. Add mushrooms, onion, and salt; saut\u00e9 until nicely browned, 5 to 8 minutes. Reduce the heat to medium and add flour; cook and stir for 3 minutes."
    },
    {
      "position": 3,
      "text": "Stir in broth, ketchup, and Worcestershire sauce. Increase the heat to high and bring to a simmer. Reduce the heat to medium and cook, stirring occasionally, until gravy thickens slightly and reduces, about 10 minutes. Taste and adjust salt as needed."
    },
    {
      "position": 4,
      "text": "Transfer gravy to a liquid measure. Scrape the pan clean with a spatula."
    },
    {
      "position": 5,
      "text": "Finish the steaks: Remove meat from the refrigerator and divide into four equal portions. Moisten hands and form each portion into a 1/2-inch-thick oval patty. Lightly season both sides of patties with salt."
    },
    {
      "position": 6,
      "text": "Melt butter in the clean skillet over medium-high heat. Add patties and cook until browned, 2 to 3 minutes per side. Pour in gravy and bring to a simmer. Reduce the heat to medium and continue to cook until gravy is piping hot and steaks are no longer pink in the center, about 5 more minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

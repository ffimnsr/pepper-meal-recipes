  "id": "a560f81b-acd3-5000-86eb-8d8d14c4498f",
  "slug": "aunt-carols-apple-pie",
  "name": "Aunt Carol's Apple Pie",
  "recipe_type": "dessert",
  "brief_description": "Aunt Carol's apple pie recipe is a favorite that's best made with Macintosh or Granny Smith apples, as they're tart and retain their shape after baking.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Peel and slice apples; place slices in a bowl. Add 1 cup white sugar, brown sugar, flour, and cinnamon; toss until apples are evenly coated. Set aside."
    },
    {
      "position": 3,
      "text": "Roll out 1 pie crust on a lightly floured work surface; fit into a 10-inch glass pie plate. Pour apple filling into crust; dot with butter. Roll out remaining 1 pie crust; lay over filling. Crimp edges together to seal."
    },
    {
      "position": 4,
      "text": "Wet hands with water; dampen top of pie then sprinkle with 1 tablespoon white sugar. Poke some ventilation holes into top crust with a fork so steam can escape."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 15 minutes, with a piece of aluminum foil under pie plate to catch overflows. Reduce the oven temperature to 350 degrees F (175 degrees C); continue baking until crust is golden brown, about 45 minutes more. Serve warm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

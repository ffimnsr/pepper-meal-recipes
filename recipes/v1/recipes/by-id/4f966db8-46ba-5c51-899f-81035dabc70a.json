  "id": "4f966db8-46ba-5c51-899f-81035dabc70a",
  "slug": "ziti-with-roasted-zucchini-and-garlic",
  "name": "Ziti with Roasted Zucchini and Garlic",
  "recipe_type": "main",
  "brief_description": "Roasted zucchini, shallots, and garlic are tossed with ziti, Parmesan cheese, and fresh basil for this vegetarian-friendly, super flavorful recipe.",
  "cuisine": "American Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Toss zucchini, shallots, and garlic with 5 tablespoons oil in a bowl until coated; season with pepper flakes, salt, and black pepper. Transfer to a rimmed baking sheet."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven, flipping occasionally, until tender, about 30 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Cook ziti in the boiling water, stirring occasionally, until tender yet firm to the bite, 9 to 12 minutes. Drain, reserving ¾ cup cooking water."
    },
    {
      "position": 5,
      "text": "Toss ziti with 1 tablespoon oil; transfer to a large pot. Add roasted vegetables, ¼ cup cooking water, and remaining 1 tablespoon oil; cook and stir over medium heat until heated through. Add ¾ cup basil and Parmesan cheese; toss and add remaining cooking water, 1 tablespoon at a time, if dry. Season with salt and black pepper. Sprinkle remaining ¼ cup basil on top."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

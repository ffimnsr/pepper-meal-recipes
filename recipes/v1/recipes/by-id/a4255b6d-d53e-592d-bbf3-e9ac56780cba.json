  "id": "a4255b6d-d53e-592d-bbf3-e9ac56780cba",
  "slug": "smoked-jalapeno-poppers-recipe-7969057",
  "name": "Smoked Jalape\u00f1o Poppers",
  "recipe_type": "appetizer",
  "brief_description": "This smoked jalape\u00f1o poppers recipe pairs simple filling ingredients like cream cheese, Cheddar, bacon, and seasonings for a savory, spicy, smoky treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the smoker to 250 degrees F (120 degrees C) according to manufacturer\u2019s directions with wood of choice."
    },
    {
      "position": 2,
      "text": "Mix cream cheese, Cheddar cheese, bacon, and steak seasoning together in a medium bowl until well combined."
    },
    {
      "position": 3,
      "text": "Fill a piping bag with cheese mixture, pipe into jalape\u00f1os, and transfer to a disposable baking sheet. Smoke until peppers are tender and slightly brown, about 2 hours."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 120,
  "preparation_time_minutes": 15,

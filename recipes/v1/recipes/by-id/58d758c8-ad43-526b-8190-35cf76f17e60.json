  "id": "58d758c8-ad43-526b-8190-35cf76f17e60",
  "slug": "spicy-slow-cooked-beanless-chili",
  "name": "Spicy Slow-Cooked Beanless Chili",
  "recipe_type": "soup",
  "brief_description": "Simple no-bean chili recipe made in the slow cooker with ground beef, tomatoes, and onion \u2014 plus jalape\u00f1os, chili powder, and cayenne for extra heat!",
  "cuisine": "Southwestern American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook ground beef in a large skillet over medium-high heat until browned and crumbly, 5 to 7 minutes; drain and discard grease."
    },
    {
      "position": 2,
      "text": "Transfer beef to a slow cooker. Add tomato sauce, diced tomatoes, onion, jalape\u00f1o peppers, chili powder, cayenne pepper, salt, garlic, and black pepper; stir to combine. Cook on Low for 10 hours or High for 6 1/2 hours."
    }
  ],
  "servings": 8,

  "id": "0e97ec16-96d7-5f58-8bee-674dca050953",
  "slug": "cookie-butter-fudge",
  "name": "Cookie Butter Fudge",
  "recipe_type": "dessert",
  "brief_description": "Cookie butter fudge is an addictive and rich way to eat cookie butter and is ready in less than an hour.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Grease an 8-inch square baking dish."
    },
    {
      "position": 2,
      "text": "Mix white sugar, evaporated milk, brown sugar, and butter in a saucepan; bring to a boil. Reduce heat to a simmer and cook, stirring continually, until mixture is smooth and sugar is dissolved, about 8 minutes. Remove saucepan from heat and stir marshmallow creme into sugar mixture until smooth."
    },
    {
      "position": 3,
      "text": "Stir cookie butter into sugar-marshmallow mixture until evenly combined; pour into the prepared baking dish. Let fudge stand until cooled and solid, at least 30 minutes."
    }
  ],
  "servings": 28,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

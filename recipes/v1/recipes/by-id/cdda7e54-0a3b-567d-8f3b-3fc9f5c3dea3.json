  "id": "cdda7e54-0a3b-567d-8f3b-3fc9f5c3dea3",
  "slug": "special-occasion-smoked-bluefish-pate",
  "name": "Special Occasion Smoked Bluefish P\u00e2t\u00e9",
  "recipe_type": "appetizer",
  "brief_description": "This special occasion smoked bluefish p\u00e2t\u00e9 recipe blends smoked bluefish and cream cheese into a zesty spread. Smoked salmon or tuna may be swapped.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Break up bluefish into pieces; place in the bowl of a food processor. Add cream cheese; pulse until smooth. Add Dijon and horseradish; pulse until reaches desired consistency."
    },
    {
      "position": 2,
      "text": "Transfer p\u00e2t\u00e9 to a bowl; cover the bowl. Refrigerate before serving, 6 hours to overnight."
    }
  ],
  "servings": 16,

  "id": "4ae3adee-d810-5f3f-b3ad-1b7288d3e1bb",
  "slug": "instant-pot-jambalaya-with-shrimp-and-chicken",
  "name": "Instant Pot Jambalaya with Shrimp and Chicken",
  "recipe_type": "soup",
  "brief_description": "This tasty chicken and shrimp jambalaya is made all in one pot \u2014 your Instant Pot! Heat lovers can double the hot pepper sauce to give it an extra kick.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select the Saut\u00e9 function. Add 1 tablespoon olive oil and cook sausage slices until browned on both sides, 3 to 4 minutes. Remove sausage from pot and set aside."
    },
    {
      "position": 2,
      "text": "Add remaining olive oil to the pot. Add onion and garlic; cook and stir for 1 minute. Add chicken, bell pepper, and celery. Cook until chicken starts to brown on the edges, 2 to 3 minutes. Add browned sausage, diced tomatoes with liquid, shrimp, thyme, salt, seasoned salt, pepper, and hot pepper sauce; stir until well combined. Turn off the Saut\u00e9 function. Close and lock the lid."
    },
    {
      "position": 3,
      "text": "Select high pressure according to manufacturer's instructions; set timer for 7 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Release pressure carefully using the quick-release method according to the manufacturer's instructions, about 5 minutes. Unlock and remove the lid after the pressure has released completely."
    },
    {
      "position": 5,
      "text": "Serve jambalaya garnished with chopped green onions."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

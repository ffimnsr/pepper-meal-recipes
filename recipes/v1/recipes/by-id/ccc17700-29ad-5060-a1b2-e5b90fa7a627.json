  "id": "ccc17700-29ad-5060-a1b2-e5b90fa7a627",
  "slug": "one-bowl-chocolate-cake-iii",
  "name": "One Bowl Chocolate Cake",
  "recipe_type": "dessert",
  "brief_description": "This homemade chocolate cake recipe is easy to make in one bowl; top with your favorite chocolate frosting for a fudgy, moist chocolate layer cake.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 9-inch round baking pans."
    },
    {
      "position": 2,
      "text": "Stir sugar, flour, cocoa, baking powder, baking soda, and salt together in a large bowl."
    },
    {
      "position": 3,
      "text": "Add eggs, milk, oil and vanilla; mix for 2 minutes on medium speed with an electric mixer."
    },
    {
      "position": 4,
      "text": "Stir in the boiling water. The batter will be thin."
    },
    {
      "position": 5,
      "text": "Pour evenly into the prepared pans."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 30 to 35 minutes. Cool in the pans for 10 minutes, then transfer to a wire rack to cool completely."
    },
    {
      "position": 7,
      "text": "Enjoy!"
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,

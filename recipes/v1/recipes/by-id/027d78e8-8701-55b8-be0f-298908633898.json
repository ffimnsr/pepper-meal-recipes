  "id": "027d78e8-8701-55b8-be0f-298908633898",
  "slug": "traditional-kentucky-burgoo",
  "name": "Traditional Kentucky Burgoo",
  "recipe_type": "soup",
  "brief_description": "This rich southern-style stew with beef, pork, and all kinds of vegetables has a smoky flavor thanks to prepared barbeque sauce. The big stew needs several hours to simmer.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in an 8-quart pot over medium heat; brown pork and beef cubes in the hot oil, working in batches if necessary."
    },
    {
      "position": 2,
      "text": "Stir in chicken broth, chicken pieces, potatoes, and carrots. Bring to a boil, reduce heat to low, and simmer stew for 1 hour."
    },
    {
      "position": 3,
      "text": "Stir in stewed tomatoes, barbeque sauce, green beans, okra, corn, onion, green bell pepper, celery, apple cider vinegar, Worcestershire sauce, garlic, bay leaves, salt, black pepper, and hot pepper sauce."
    },
    {
      "position": 4,
      "text": "Bring stew back to a boil, reduce heat to low, and simmer 1 more hour."
    },
    {
      "position": 5,
      "text": "Discard bay leaves before serving stew in bowls."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 150,
  "preparation_time_minutes": 60,
  "rest_time_minutes": null,
  "difficulty": "expert",

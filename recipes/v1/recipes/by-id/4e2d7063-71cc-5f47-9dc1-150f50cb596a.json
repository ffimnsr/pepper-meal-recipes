  "id": "4e2d7063-71cc-5f47-9dc1-150f50cb596a",
  "slug": "black-bean-and-corn-salad-ii",
  "name": "Black Bean and Corn Salad",
  "recipe_type": "salad",
  "brief_description": "This colorful black bean and corn salad has a refreshing lime and garlic dressing and makes a great side dish for any occasion.",
  "cuisine": "Southwestern Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place olive oil, lime juice, garlic, salt, and cayenne pepper in a small jar. Close the lid tightly and shake the jar until the dressing is well combined."
    },
    {
      "position": 3,
      "text": "Combine beans, corn, avocado, bell pepper, tomatoes, green onions, and cilantro in a salad bowl."
    },
    {
      "position": 4,
      "text": "Shake dressing again, pour over salad, and toss to coat."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 25,

  "id": "afa4da26-bda9-53dd-9db0-15c619cf3498",
  "slug": "tomato-and-garlic-pasta",
  "name": "Tomato and Garlic Pasta",
  "recipe_type": "main",
  "brief_description": "A simple garlic and tomato pasta recipe made with fresh tomatoes will become a favorite, go-to dish in summer because of its light, bright flavors.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place tomatoes in a large pot and cover with cold water. Bring just to a boil. Pour off water, and cover again with cold water. Peel the skin off tomatoes and cut into small pieces."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Cook angel hair pasta in the boiling water, stirring occasionally, until tender yet firm to the bite, 4 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat olive oil in a large skillet or pan, making sure there is enough to cover the bottom of the pan, and saut\u00e9 garlic until opaque but not browned. Stir in tomato paste. Immediately stir in the tomatoes, salt, and pepper. Reduce heat, and simmer until pasta is ready, adding basil at the end."
    },
    {
      "position": 4,
      "text": "Drain pasta, do not rinse in cold water. Toss with a bit of olive oil, then mix into the sauce."
    },
    {
      "position": 5,
      "text": "Reduce heat as low as possible. Keep warm, uncovered, for about 10 minutes when it is ready to serve. Garnish generously with fresh Parmesan cheese."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

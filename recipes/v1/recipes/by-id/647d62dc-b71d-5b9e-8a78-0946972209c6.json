  "slug": "apple-raisin-and-carrot-slaw-recipe-7182208",
  "name": "Apple, Raisin, and Carrot Slaw",
  "recipe_type": "salad",
  "brief_description": "This easy slaw with apples, raisins, and carrots is the perfect side for any meat or fish dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk yogurt, mayonnaise, vinegar, poppy seeds, mustard, salt, and pepper together in a large bowl. Stir in cabbage, carrot, apple, and raisins. Garnish with fresh parsley."
    }

  "id": "a106e368-c633-599f-88e9-8d0cbdfbb6de",
  "slug": "cheesy-chicken-meatballs",
  "name": "Cheesy Chicken Meatballs",
  "recipe_type": "main",
  "brief_description": "Garlic cream cheese adds great flavor to these zesty chicken meatballs, while ensuring that they'll be light, moist, and delicious.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 450 degrees F (230 degrees C). Line a rimmed baking sheet with aluminum foil, and spray with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine the chicken, eggs, cream cheese, Parmesan cheese, bread crumbs, red pepper flakes, Italian seasoning, garlic powder, vegetable oil, salt, and pepper in a large bowl; mix well. Form mixture into 20 meatballs; place on prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in center of preheated oven until juices run clear, 17 to 18 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

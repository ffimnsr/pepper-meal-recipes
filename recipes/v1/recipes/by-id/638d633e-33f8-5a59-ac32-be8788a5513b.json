  "id": "638d633e-33f8-5a59-ac32-be8788a5513b",
  "slug": "moms-barbeque-style-turkey",
  "name": "Mom's Barbecue-Style Turkey",
  "recipe_type": "dessert",
  "brief_description": "Leftover turkey is simmered in a sweet and tangy barbecue sauce with onions, celery, and peppers. Try it on a roll, over rice, with noodles, or all on its own!",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt butter in a skillet over medium heat. Place onion, celery, and green pepper in the skillet, and cook 5 minutes. Mix in ketchup, brown sugar, chili powder, and Worcestershire sauce. Season with salt. Cook over low heat until bubbly. Stir in turkey, cover, and simmer 30 minutes."
    }
  ],

  "id": "cdb216e5-9f7f-5b69-902e-de5b58cef505",
  "slug": "the-best-homemade-cupcakes",
  "name": "The Best Homemade Cupcakes",
  "recipe_type": "dessert",
  "brief_description": "Don't rely on boxed-cake mixes when making cupcakes--this simple recipe makes 2 dozen homemade moist cupcakes that taste delicious with (or without!) frosting.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line two 12-cup muffin tins with paper liners."
    },
    {
      "position": 2,
      "text": "Combine sifted flour, sugar, baking powder, and salt in a bowl. Whisk eggs together in a second bowl for 1 to 2 minutes."
    },
    {
      "position": 3,
      "text": "Beat milk, oil, and vanilla extract together in another large bowl with an electric mixer on low speed until incorporated. Add the flour mixture in increments, making sure it mixes in well. Fold in eggs. Scoop batter into the prepared muffin cups."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a cake tester inserted into the center comes out clean, about 20 to 25 minutes. Cool in the tin for 5 minutes, then transfer to a wire rack to cool completely."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

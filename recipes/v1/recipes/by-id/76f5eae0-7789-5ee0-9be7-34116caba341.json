  "id": "76f5eae0-7789-5ee0-9be7-34116caba341",
  "slug": "tres-leches-mashed-potatoes-recipe-8740222",
  "name": "Tres Leches Mashed Potatoes",
  "recipe_type": "side",
  "brief_description": "Tres leches mashed potatoes, with 3 kinds of milk, are extraordinary, with the perfect fluffy texture.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Peel and quarter potatoes, and transfer to a 6-quart pot. Add enough water to cover by 2 inches, and add 2 tablespoons kosher salt."
    },
    {
      "position": 2,
      "text": "Bring to a boil on high heat, stir once, and reduce heat to medium-low. Simmer gently, until potatoes are completely tender, but not falling apart, 30 to 40 minutes."
    },
    {
      "position": 3,
      "text": "When potatoes are almost done, add evaporated milk, milk, and buttermilk to a saucepan, and place over low heat. Drain potatoes very well and add to a large bowl, or back into the pot."
    },
    {
      "position": 4,
      "text": "Use a masher to mash potatoes smooth. Add butter; mash again until butter disappears. Add 1 teaspoon salt, white pepper, cayenne, and hot milk mixture."
    },
    {
      "position": 5,
      "text": "Use a whisk or electric hand mixer on high speed to whip potatoes until light and fluffy. Taste for seasoning, garnish with melted butter and chives, and serve immediately."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "89600fc1-0bbc-5481-aa6d-bc7e02100b4b",
  "slug": "norwegian-cabbage-rolls",
  "name": "Norwegian Cabbage Rolls",
  "recipe_type": "main",
  "brief_description": "Caraway seeds and rice are added to the filling of these Norwegian cabbage rolls to deliver extra flavor and texture.",
  "cuisine": "Norwegian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a baking pan."
    },
    {
      "position": 2,
      "text": "Heat butter in a skillet over medium heat; stir in onion. Cook and stir until the onion has softened and turned translucent, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Transfer onion to a large mixing bowl and add beef, cooked rice, cream, egg, parsley, potato starch, 2 teaspoons salt, pepper, caraway seeds, ginger, nutmeg, and cloves. Mix to combine in an even consistency and refrigerate filling until needed."
    },
    {
      "position": 4,
      "text": "Bring a large pot of generously salted water to a boil. Place 1 head of cabbage in the boiling water and parboil until bright green and leaves are softened, about 2 minutes. Carefully remove cabbage with tongs or a large fork. Repeat with remaining head of cabbage. Allow to cool, about 10 minutes."
    },
    {
      "position": 5,
      "text": "Remove outer leaves from the cooled cabbage. Lay 1 leaf flat on a work surface and cut out the stem. Spoon a generous 2 tablespoons of filling into the center of the leaf. Fold the corners at the stem end diagonally over the filling, fold the sides over, and roll up like a tiny burrito. Place in the prepared baking pan. Repeat to make remaining cabbage rolls until filling is used up."
    },
    {
      "position": 6,
      "text": "Add water to the baking pan until it is halfway up the sides of the cabbage rolls."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until beef is cooked through and no longer pink, about 40 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

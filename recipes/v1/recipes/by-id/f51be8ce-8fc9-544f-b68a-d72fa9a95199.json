  "slug": "ahi-shoyu-poke",
  "name": "Ahi Shoyu Poke",
  "recipe_type": "appetizer",
  "brief_description": "Make Hawaiian shoyu poke at home with this easy recipe that combines fresh tuna, soy sauce, onion, ginger, and sesame oil for a quick, flavorful appetizer.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine ahi cubes, soy sauce, Maui onion, green onion, chile pepper, sesame oil, sesame seeds, macadamia nuts, ginger, and sea salt in a large bowl. Gently toss to combine."
    }
  ],
  "servings": 4,

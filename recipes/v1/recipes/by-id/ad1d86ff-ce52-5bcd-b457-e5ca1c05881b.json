  "id": "ad1d86ff-ce52-5bcd-b457-e5ca1c05881b",
  "slug": "teriyaki-and-pineapple-chicken",
  "name": "Teriyaki and Pineapple Chicken",
  "recipe_type": "dessert",
  "brief_description": "This teriyaki and pineapple chicken recipe blends crisp-sweet bell peppers, pineapple, mushrooms, and chicken for a hearty dish that tastes delicious.",
  "cuisine": "Fusion Hawaiian Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Heat oil in a wok or large skillet over medium-high heat. Add chicken; cook until no longer pink in centers and juices run clear, 7 to 10 minutes."
    },
    {
      "position": 2,
      "text": "Add mushrooms, onion, bell peppers, teriyaki sauce, pineapple chunks and juice, garlic powder, and pepper flakes. Reduce heat to medium; bring to a simmer. Stir in flour; simmer until thickened, about 15 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,

  "id": "9a2ea218-48c9-54ab-872f-8eb244cee1c7",
  "slug": "slow-cooker-cream-cheese-green-chili-chicken-recipe-11923052",
  "name": "Slow Cooker Cream Cheese Green Chili Chicken",
  "recipe_type": "drink",
  "brief_description": "This slow cooker cream cheese green chili chicken is a snap to make. Cream cheese melts into the juices with green chilies, onions, and jalapenos to make plenty of sauce, while Monterey Jack cheese melts luxuriously on top.",
  "cuisine": "American Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Spray the interior of the slow cooker with cooking spray, or line with a slow cooker liner. Season chicken breasts with salt and pepper, and place in the slow cooker."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a nonstick skillet over medium heat. Add chopped onion and cook, stirring occasionally, until onions start to turn translucent, 3 to 5 minutes."
    },
    {
      "position": 3,
      "text": "Add jalapeños and garlic, and cook, stirring, about 30 seconds more. Stir in chicken broth and green chilies."
    },
    {
      "position": 4,
      "text": "Pour skillet contents over chicken breasts; sprinkle cream cheese cubes evenly over chicken. Cover, and cook on High for 2 1/2 hours, or on Low for 5 hours, until the chicken is cooked through. An instant read thermometer inserted near the center should reach 165 degrees F (74 degrees C)."
    },
    {
      "position": 5,
      "text": "Move chicken to one side of the slow cooker and give the sauce a stir. Then, turn each chicken breast in the sauce to coat completely."
    },
    {
      "position": 6,
      "text": "Top with shredded cheese, cover, and allow to stand until cheese is melted, 5 to 10 minutes. Top each serving with sliced avocado, and garnish with fresh cilantro sprigs and lime slices to serve."
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 160,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "expert",

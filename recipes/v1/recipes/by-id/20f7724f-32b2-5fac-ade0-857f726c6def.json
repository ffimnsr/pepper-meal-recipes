  "id": "20f7724f-32b2-5fac-ade0-857f726c6def",
  "slug": "lavender-lemon-curd-thumbprint-cookies",
  "name": "Lavender-Lemon Curd Thumbprint Cookies",
  "recipe_type": "dessert",
  "brief_description": "Thumbprint cookies at their best! These tender treats combine creamy lemon curd and floral lavender, making the perfect match!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Line two baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Cream butter, brown sugar, and white sugar in a bowl. Mix in egg yolks, lavender, vanilla, and almond extract until combined."
    },
    {
      "position": 3,
      "text": "Whisk together flour, cornstarch, and salt in a separate bowl. Add to butter mixture and mix to combine."
    },
    {
      "position": 4,
      "text": "Roll dough into 1-inch balls and place 2 inches apart on the prepared baking sheets. Use your thumb (or another utensil, like the bottom of a shot glass) to make indentations in the center of each cookie. Add enough lemon curd to completely fill each indentation. Place baking sheets in the refrigerator to chill for 20 minutes."
    },
    {
      "position": 5,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 6,
      "text": "Remove baking sheets from refrigerator and lightly drizzle each cookie with honey."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until cookies begin to turn golden brown, 10 to 12 minutes. Allow to cool on baking sheet for several minutes before transferring to cooling rack."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,

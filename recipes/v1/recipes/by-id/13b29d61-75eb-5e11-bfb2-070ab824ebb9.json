  "id": "13b29d61-75eb-5e11-bfb2-070ab824ebb9",
  "slug": "slow-cooker-venison-sloppy-joes",
  "name": "Slow Cooker Venison Sloppy Joes",
  "recipe_type": "main",
  "brief_description": "Venison Sloppy Joes are made with stew meat, bacon, and onion slow-cooked in a savory sauce of brown sugar, vinegar, mustard, ketchup, and spices.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook bacon in a large, deep skillet over over medium-high heat until evenly browned, 5 to 10 minutes. Remove from the skillet, crumble and set aside. Brown stew meat in bacon grease for flavor."
    },
    {
      "position": 2,
      "text": "Put onion, brown sugar, vinegar, cumin, chili powder, garlic, mustard, ketchup, salt, and pepper in slow cooker and mix well. Add bacon and venison and stir together."
    },
    {
      "position": 3,
      "text": "Cook on Low for at least 8 hours. Use a fork to separate the meat into a thick and yummy Sloppy Joe-style barbecue."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 490,
  "preparation_time_minutes": 5,

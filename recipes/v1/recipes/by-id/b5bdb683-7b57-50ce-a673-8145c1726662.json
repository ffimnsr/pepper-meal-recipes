  "id": "b5bdb683-7b57-50ce-a673-8145c1726662",
  "slug": "sugar-free-cake",
  "name": "Sugar-Free Cake",
  "recipe_type": "dessert",
  "brief_description": "This sugar-free cake, flavored with cinnamon and nutmeg, is made with applesauce, eggs, nuts, raisins, and liquid sweetener for a tender Bundt cake.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 10-inch Bundt or tube pan."
    },
    {
      "position": 2,
      "text": "Combine water and raisins in a saucepan over medium heat. Simmer until water is absorbed; set aside to cool."
    },
    {
      "position": 3,
      "text": "Mix together applesauce, oil, eggs, liquid sweetener, and vanilla in a large bowl until well combined. Sift in flour, cinnamon, baking soda, nutmeg, and salt; stir until just combined. Mix in raisins and nuts. Pour batter into the prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of cake comes out clean, about 1 hour."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 15,

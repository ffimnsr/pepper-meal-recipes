{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "bb459cd7-1d67-56f6-bf20-1fc00f2d7d2e",
  "slug": "chocolate-chip-cookie-dough-cupcake-the-best-cupcake-ever",
  "name": "Cookie Dough Cupcakes",
  "recipe_type": "dessert",
  "brief_description": "Cookies, cupcakes? You don't have to choose. These cookie cupcakes have a hidden chocolate chip cookie dough center for the undecided among us.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk flour, baking soda, and sea salt together in a large bowl; set aside. Beat butter, white sugar, and brown sugar with an electric mixer in a separate bowl until smooth. Add 1 egg and vanilla extract; beat until smooth. Mix in flour mixture until just incorporated. Fold in chocolate chips; mixing just enough to evenly combine. Form dough into tablespoon-sized balls; place onto a baking sheet, and freeze until solid, about 2 hours."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 24 muffin cups with paper liners."
    },
    {
      "position": 3,
      "text": "Lightly beat 3 eggs in a large bowl with an electric mixer. Add cake mix, water, and canola oil; continue beating for 2 minutes on medium speed. Spoon into prepared cupcake liners, filling each 2/3 full. Place a frozen cookie dough ball on the top center of each cupcake."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the cake portion of the cupcake (not the cookie dough ball) comes clean, about 20 minutes. Cool in the pans for 10 minutes before removing to cool completely on a wire rack."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "fe1310aa-7ffa-5e92-aa98-7883fed25280",
  "slug": "almond-crescent-cookies",
  "name": "Almond Crescent Cookies",
  "recipe_type": "dessert",
  "brief_description": "These delicate crescent almond cookies made with finely chopped almonds and almond extract make the perfect melt-in-the-mouth holiday treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat butter and confectioners' sugar in a bowl using an electric mixer until smooth and creamy. Add vanilla extract, almond extract, and salt; mix briefly to incorporate."
    },
    {
      "position": 3,
      "text": "Gradually stir 3/4 cup plus 2 tablespoons flour into the creamed butter, add almonds, and mix until dough is just combined."
    },
    {
      "position": 4,
      "text": "Shape dough into tiny crescents; place on an ungreased baking sheet about 2 inches apart."
    },
    {
      "position": 5,
      "text": "Bake cookies in preheated oven until edges are lightly golden, about 15 minutes. Cool on the baking sheet for 5 minutes before transferring to a wire rack to cool completely."
    },
    {
      "position": 6,
      "text": "Roll cookies in sifted confectioners' sugar when cooled."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 45,

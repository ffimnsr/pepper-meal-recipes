  "id": "8f522ca5-c175-538e-904e-1b3d80ac0a7a",
  "slug": "roasted-golden-beet-hummus",
  "name": "Roasted Golden Beet Hummus",
  "recipe_type": "appetizer",
  "brief_description": "Typically made with chickpeas, this golden beet hummus gets a creamy texture from white beans and is perfect for a snack board.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Quarter beets and toss in a bowl with olive oil. Place on the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven until a knife can be easily inserted into a beet, 35 to 40 minutes. Set aside to cool slightly."
    },
    {
      "position": 4,
      "text": "Place the beets in a food processor along with the beans, tahini, lemon juice, balsamic vinegar, cumin, turmeric, sea salt, and garlic. Blend until smooth, adding small amounts of reserved bean liquid if the consistency is too thick. Transfer hummus to a serving bowl."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

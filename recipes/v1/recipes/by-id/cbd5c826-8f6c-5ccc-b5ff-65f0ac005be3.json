  "schema_version": 1,
  "id": "cbd5c826-8f6c-5ccc-b5ff-65f0ac005be3",
  "slug": "clarks-quiche",
  "name": "Clark\u2019s Quiche",
  "recipe_type": "breakfast",
  "brief_description": "Bacon, ham, spinach, and mushrooms are layered with three cheeses in this rich, delicious quiche. This recipe makes two 9-inch pies.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Cook bacon in a large, deep skillet over medium-high heat, turning occasionally, until evenly brown. Drain on paper towels. Crumble and set aside."
    },
    {
      "position": 3,
      "text": "Meanwhile, cook spinach according to package instructions. Allow to cool, then squeeze dry and set aside."
    },
    {
      "position": 4,
      "text": "Heat olive oil in the same skillet over medium heat. Saut\u00e9 onion in hot oil until soft and translucent. Stir in mushrooms; cook until soft, about 2 minutes. Stir in ham and crumbled bacon. Remove from heat."
    },
    {
      "position": 5,
      "text": "Combine sour cream and spinach in a medium bowl; season with salt and pepper. Divide evenly between crusts, then divide and arrange bacon mixture on top. Combine Monterey Jack, Cheddar, and Parmesan in a large bowl; divide and sprinkle over bacon mixture."
    },
    {
      "position": 6,
      "text": "Whisk eggs, half-and-half, and parsley together in a separate bowl until well combined; season with salt and pepper. Place crusts on a baking sheet; pour egg mixture into crusts."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven on the center rack until the tops are puffed and golden brown, about 40 minutes. Remove from the oven; let stand for 5 to 10 minutes."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 60,

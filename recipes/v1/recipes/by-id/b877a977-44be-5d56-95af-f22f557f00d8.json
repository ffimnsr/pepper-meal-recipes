  "id": "b877a977-44be-5d56-95af-f22f557f00d8",
  "slug": "microwave-frittata-for-one",
  "name": "Microwave Frittata for One",
  "recipe_type": "breakfast",
  "brief_description": "This is a quick breakfast frittata for 1 person, made with pesto, ricotta, and Parmesan cheese. From start to finish, it is ready in about 5 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spray a large coffee mug with cooking spray."
    },
    {
      "position": 2,
      "text": "Whisk eggs, pesto, ricotta cheese, Parmesan cheese, and pepper together in a small bowl. Pour frittata mixture into coffee mug."
    },
    {
      "position": 3,
      "text": "Cook the frittata in a microwave oven for 1 minute and 30 seconds, stirring at thirty-second intervals (you will stir twice). Invert cooked frittata onto a plate or eat it right out of the coffee mug. Garnish with green onions."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

  "id": "786ba538-ae35-5a11-a4a6-edb731a79ee1",
  "slug": "coal-miners-pasties",
  "name": "Coal Miners Pasties",
  "recipe_type": "main",
  "brief_description": "Homemade pasties filled with a savory combination of steak, potatoes, turnips, and onions. Perfectly portable for picnics or serve warm for a simple supper.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Place flour, 2 teaspoons salt, and lard in a bowl. Quickly rub lard into flour with your fingertips until it resembles small peas. Pour in ice water and form into a ball. Add more water if it feels too dry. Divide dough into 6 balls; wrap in plastic and chill for one hour."
    },
    {
      "position": 2,
      "text": "In a bowl, combine steak, turnips, potatoes, onions, remaining 1 tablespoon salt, and pepper."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 4,
      "text": "Roll out one ball of dough on a floured surface to about 1/4 inch thick. Using a cake pan, trace a 9-inch circle in dough; cut out the circle. Place about 1 1/2 cups of steak mixture into middle of the circle. Fold edges of the circle up to meet along the top of filling; crimp dough along the top to seal. Repeat until dough is used up. Use a spatula to transfer pasties to an ungreased baking sheet."
    },
    {
      "position": 5,
      "text": "Bake pasties in the preheated oven for 45 minutes, or until golden. Serve hot or at room temperature."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

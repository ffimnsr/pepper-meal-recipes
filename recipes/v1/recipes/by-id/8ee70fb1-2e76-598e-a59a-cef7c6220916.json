  "id": "8ee70fb1-2e76-598e-a59a-cef7c6220916",
  "slug": "tortellini-alla-fini",
  "name": "Tortellini alla Fini",
  "recipe_type": "main",
  "brief_description": "A comforting meal with cheese tortellini, peas, and ham in a simple cream sauce. This tortellini alla fini recipe is quick, easy, and on the table in 30 minutes.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a rolling boil; stir in tortellini and return to a boil. Cook uncovered, stirring occasionally, until tortellini float to the top and the filling is hot, about 3 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, melt butter in a large saucepan over medium heat. Add cream and stir frequently until heated through. Season with nutmeg and pepper. Slowly mix in Parmesan cheese, stirring constantly; allow to thicken. Mix in ham and peas."
    },
    {
      "position": 3,
      "text": "Drain cooked tortellini and return to the pot. Pour sauce over tortellini and toss to combine."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

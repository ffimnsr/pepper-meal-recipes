  "id": "3583a08b-87be-5e98-982f-02c15fec2a8b",
  "slug": "banana-pudding-dump-cake-recipe-12031518",
  "name": "Banana Pudding Dump Cake",
  "recipe_type": "dessert",
  "brief_description": "This banana pudding dump cake combines the creamy texture of banana pudding with the ease of a dump cake. Served cold with a gooey filling and a crisp, buttery topping, it\u2019s an incredibly tasty dessert that\u2019s perfect for potlucks.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Whisk pudding mix and milk together in a large bowl until thickened, 2 to 3 minutes. Gently mix sliced bananas into the thickened pudding; set aside."
    },
    {
      "position": 3,
      "text": "Arrange vanilla wafers in an even layer in the bottom of the prepared baking dish. Spread pudding and banana mixture evenly over wafers."
    },
    {
      "position": 4,
      "text": "Sprinkle cake mix evenly over pudding mixture. Arrange sliced butter evenly over the cake mix."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the top is golden brown and the filling is bubbly, 45 to 55 minutes. Remove from the oven and cool on a wire rack for 30 minutes. Refrigerate until chilled, at least 2 hours."
    },
    {
      "position": 6,
      "text": "Beat cream, sugar, and vanilla together in a medium bowl with an electric mixer until stiff peaks form."
    },
    {
      "position": 7,
      "text": "Spread whipped cream over the chilled cake. Garnish with additional crushed vanilla wafers and fresh sliced bananas before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,

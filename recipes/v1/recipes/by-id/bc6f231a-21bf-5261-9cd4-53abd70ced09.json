  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "bc6f231a-21bf-5261-9cd4-53abd70ced09",
  "slug": "southern-tomato-frito-pie-recipe-12030600",
  "name": "Southern Tomato Frito Pie",
  "recipe_type": "side",
  "brief_description": "In Chef John\u2019s Southern tomato pie with a twist, Fritos corn chips make a crunchy crust that is faster and easier than regular pie crust, in an incredible combination of taste and texture. Use the best summer tomatoes you can find for this recipe\u2014from your garden, your neighbor\u2019s garden, or the farmer\u2019s market.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Cut each tomato into 3 or 4 thick slices. Lay down two or three layers of paper towel on the counter, and place tomatoes on top in a single layer. Sprinkle tomato slices evenly with salt. Let sit for 30 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 3,
      "text": "Transfer Fritos into the bottom of a 9x13-inch baking dish, and arrange into an even layer. (You can add a second bag of Fritos for a thicker, crunchier bottom layer.)"
    },
    {
      "position": 4,
      "text": "Toss Cheddar cheese and Monterey Jack cheese together in a bowl. Scatter 1 1/2 cups of this cheese mixture evenly over Fritos in the baking dish."
    },
    {
      "position": 5,
      "text": "Add mayonnaise and egg to the remaining cheese in the bowl and stir until evenly combined; this will be the cheese topping. Set aside until needed."
    },
    {
      "position": 6,
      "text": "If using, scatter cooked, crumbled bacon evenly over Fritos and cheese, then scatter onions and half of basil over bacon."
    },
    {
      "position": 7,
      "text": "Blot salted tomatoes, with paper towels, pressing to absorb as much excess moisture as possible. Layer tomatoes on top of basil, overlapping into an even layer. Season with black pepper and oregano; scatter remaining basil evenly over seasoned tomatoes."
    },
    {
      "position": 8,
      "text": "Dollop cheese topping in six or seven piles, equally spaced, over the surface. Spread topping evenly with a spoon or spatula almost to the edges. Sprinkle Parmesan cheese over the top."
    },
    {
      "position": 9,
      "text": "For an optional garnish, place some additional sliced tomatoes on top and press them gently into the cheese topping. Drizzle the top with olive oil."
    },
    {
      "position": 10,
      "text": "Bake in the preheated oven until the top is nicely browned around the edges, about 45 minutes. Let cool for 10 to 15 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,

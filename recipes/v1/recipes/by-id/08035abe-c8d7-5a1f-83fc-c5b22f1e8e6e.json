  "id": "08035abe-c8d7-5a1f-83fc-c5b22f1e8e6e",
  "slug": "absolutely-the-best-shrimp-scampi",
  "name": "Absolutely The Best Shrimp Scampi",
  "recipe_type": "salad",
  "brief_description": "Shrimp sauteed in olive oil, with a brandy sauce flavored with garlic shallots and oregano. Great served with a rice pilaf and salad!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine flour, black pepper, salt, and cayenne pepper in a small bowl. Dredge shrimp in flour mixture."
    },
    {
      "position": 2,
      "text": "Saut\u00e9 shrimp in olive oil in a large skillet over high heat for 5 minutes, stirring often; transfer to a broiler-safe serving dish using a slotted spoon, leaving oil in the skillet."
    },
    {
      "position": 3,
      "text": "Saut\u00e9 garlic, shallot, parsley, and oregano in same skillet over medium heat for 3 minutes, stirring constantly. Spoon over shrimp. Return skillet to stovetop."
    },
    {
      "position": 4,
      "text": "Meanwhile, preheat the broiler for medium heat."
    },
    {
      "position": 5,
      "text": "Add wine and brandy to the skillet over medium heat; ignite with a match or lighter. When flames die down, stir to loosen any browned bits on the bottom of the skillet; pour over shrimp."
    },
    {
      "position": 6,
      "text": "Broil shrimp in the preheated broiler for about 2 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

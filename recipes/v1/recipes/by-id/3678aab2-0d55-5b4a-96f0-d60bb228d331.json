  "id": "3678aab2-0d55-5b4a-96f0-d60bb228d331",
  "slug": "candied-yams",
  "name": "Candied Yams",
  "recipe_type": "dessert",
  "brief_description": "Candied yams made with canned yams or sweet potatoes, baked with butter, brown sugar, and marshmallows for a Southern Thanksgiving classic.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place drained yams or sweet potatoes in a medium baking dish; distribute butter pieces evenly on top."
    },
    {
      "position": 3,
      "text": "Sprinkle with brown sugar and top with a layer with miniature marshmallows."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until sweet potatoes are tender and marshmallows have melted, about 20 to 25 minutes."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,

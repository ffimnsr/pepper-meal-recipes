  "id": "feafa27c-24a1-55f5-82a9-6e407194d39e",
  "slug": "strawberry-balsamic-ricotta-bruschetta",
  "name": "Strawberry-Balsamic Ricotta Bruschetta",
  "recipe_type": "appetizer",
  "brief_description": "If you've never tried strawberries and balsamic together, now's the time. This unexpected pairing is an ideal way to start a meal and the perfect snack to pass around at parties.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat a conventional oven to 400 degrees F."
    },
    {
      "position": 2,
      "text": "Combine ricotta, honey, and salt in small mixing bowl; whisk to combine and set aside."
    },
    {
      "position": 3,
      "text": "Coat tortillas evenly with non-stick spray. Place in single layer on baking pan and bake 8 to 10 minutes or until golden and crispy. Remove from oven and cut each tortilla into 4 equal strips; set aside to cool and crisp."
    },
    {
      "position": 4,
      "text": "In second small mixing bowl, combine diced strawberries and chopped basil; set aside."
    },
    {
      "position": 5,
      "text": "Spread ricotta mixture evenly across tortilla strips, drizzle each with balsamic glaze, layer with arugula greens, basil scented strawberries and a sprinkling of pine nuts."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 8,
  "rest_time_minutes": null,
  "difficulty": "easy",

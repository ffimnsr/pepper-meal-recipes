{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "62fdf07d-ea8c-511a-9ba6-29e6be62a6b0",
  "slug": "high-fiber-high-protein-breakfast-bars",
  "name": "High-Fiber, High-Protein Breakfast Bars",
  "recipe_type": "appetizer",
  "brief_description": "Ingredients such as wheat germ, flaxseed, protein powder, peanut butter and oats make these breakfast bars a healthy and tasty way to start the day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Line an 8x8-inch baking dish with aluminum foil, letting foil hang down over the sides of the pan; spray pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Stir oats, wheat germ, flax seed, protein powder, cinnamon, and salt together in a bowl. Mash bananas in a separate large bowl and stir 1/4 cup Jif\u00ae peanut butter, honey, and vanilla extract into bananas, mixing well. Stir dry ingredients into banana mixture and spread into the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 20 minutes. Spread 1/4 cup natural peanut butter over top."
    },
    {
      "position": 4,
      "text": "Continue baking until lightly browned on the edges and set, 10 more minutes. Let cool in the pan and lift bars onto a work surface using aluminum foil as handles. Cut into bars, wrap in plastic wrap, and store in refrigerator."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

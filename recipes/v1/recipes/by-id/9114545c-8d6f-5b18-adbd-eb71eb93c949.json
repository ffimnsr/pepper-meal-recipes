  "id": "9114545c-8d6f-5b18-adbd-eb71eb93c949",
  "slug": "pork-and-sauerkraut",
  "name": "Pork and Sauerkraut",
  "recipe_type": "main",
  "brief_description": "This pork and sauerkraut meal is cooked in the oven with apple and onion until the pork is tender and flavorsome for a hearty New Year's dinner.",
  "cuisine": "Pennsylvania Dutch American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place pork into a large roasting pan. Season with salt and black pepper. Mix sauerkraut, water, onion, and apple in a large bowl until combined; pour over pork."
    },
    {
      "position": 3,
      "text": "Roast pork in the preheated oven until heated through, about 1 hour. Reduce oven temperature to 300 degrees F (150 degrees C). Continue roasting until an instant-read thermometer inserted into the center of pork reads at least 145 degrees F (63 degrees C), about 2 hours more; add more water as needed if sauerkraut mixture begins to look dry."
    },
    {
      "position": 4,
      "text": "Remove from the oven and allow pork to rest for about 10 minutes in a warm area before slicing."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 180,
  "preparation_time_minutes": 15,

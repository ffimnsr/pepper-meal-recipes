  "id": "e6caef37-c55a-51a4-80ba-4fb099342ecd",
  "slug": "true-maryland-crab-cakes",
  "name": "True Maryland Crab Cakes",
  "recipe_type": "dessert",
  "brief_description": "This Crab Cake recipe is the true Crab Cake with no fillers and no heavy spices, all crab meat. This recipe has been in my family for generations.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Combine pancake mix, mayonnaise, mustard, parsley, and egg in a medium bowl until well blended. Fold in crabmeat. Form into 3-inch cakes."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over medium to medium-high heat. (There should be enough oil to reach half way up the sides of the crab cakes.) When oil is hot, carefully place crab cakes in the pan. Fry until golden brown, about 8 minutes per side. If patties are browning too fast, reduce the heat. Drain on paper towels and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "9d8483a4-5d60-52a2-be38-f960142db197",
  "slug": "five-minute-ice-cream",
  "name": "Five Minute Fruit Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "This quick fruit ice cream made with frozen berries, sugar, and heavy cream comes together in a food processor or blender in just 5 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine frozen strawberries and sugar in a food processor or blender. Process until strawberries are roughly chopped."
    },
    {
      "position": 3,
      "text": "With the processor on, slowly pour in heavy cream until incorporated. Store in the freezer for up to 1 week."
    }
  ],
  "servings": 4,

  "id": "16b4e15f-ea9e-5967-bda1-fcd32160b1ef",
  "slug": "dubai-chocolate-brownies-recipe-11927059",
  "name": "Dubai Chocolate Brownies",
  "recipe_type": "dessert",
  "brief_description": "A layer of pistachio-coated kataifi upgrades these fudgy brownies. Kataifi (kadayif) is ultrafinely shredded phyllo dough. Find it in the freezer or refrigerated section at major retailers or online.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spread kataifi on a 10x15-inch rimmed baking sheet; bake, stirring halfway through, until golden, 10 to 12 minutes."
    },
    {
      "position": 2,
      "text": "Line an 8-inch square baking pan with parchment paper; grease parchment."
    },
    {
      "position": 3,
      "text": "Stir together 1/2 cup melted butter, sugar, eggs, and vanilla in a large bowl. Beat in flour, cocoa powder, salt, and baking powder. Spread in the prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted in center comes out clean, 20 to 25 minutes. Transfer pan onto a wire rack and let cool completely, about 2 hours."
    },
    {
      "position": 5,
      "text": "Stir together kataifi, 1/2 cup pistachio cream, and the tahini in a small bowl; spread over brownies."
    },
    {
      "position": 6,
      "text": "Combine 4 ounces dark chocolate and 2 teaspoons butter in a small bowl; microwave on High, stirring every 30 seconds, until smooth, 1 1/2 to 2 minutes. Stir in remaining 2 ounces chocolate until melted. Spread over kataifi mixture; drizzle with remaining 1 tablespoon pistachio cream, then use a toothpick to swirl into chocolate to create a marble effect. Sprinkle with pistachios. Chill, covered, until chocolate is set, about 1 hour."
    }
  ],
  "servings": 16,

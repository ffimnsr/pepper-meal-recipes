  "schema_version": 1,
  "id": "8de40bca-72e5-58de-859b-911ad2fe7520",
  "slug": "chocolate-potato-chip-pie-recipe-7501170",
  "name": "Chocolate Potato Chip Pie",
  "recipe_type": "dessert",
  "brief_description": "Chocolate potato chip pie hits all the rich, sweet, and salty notes with a silky chocolate filling and dark chocolate ganache in a salted potato chip crust.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Crust: In a food processor, pulse potato chips until fine crumbs. Transfer to a large bowl; add oat flour and melted butter. Mix until well combined. Press crumbs evenly into a 9-inch deep-dish pie plate."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden, 10 to 12 minutes. Set aside."
    },
    {
      "position": 4,
      "text": "Filling: Place semisweet chocolate chips, bittersweet chocolate, and heavy whipping cream in a saucepan over medium-low heat. Stir until chocolate melts and mixture is smooth, about 5 minutes. Whisk in eggs, vanilla, and salt. Cook, stirring, just until mixture begins to thicken, about 5 minutes. Remove from heat; pour filling into crust."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until set, 28 to 30 minutes. Cool for 30 minutes."
    },
    {
      "position": 6,
      "text": "Ganache: In a small saucepan over medium-low heat, whisk together the dark chocolate chips and heavy whipping cream until smooth. Whisk in the vegetable oil. Let cool for 5 minutes."
    },
    {
      "position": 7,
      "text": "Pour ganache over top of pie and smooth with an offset spatula."
    },
    {
      "position": 8,
      "text": "Before chocolate sets, sprinkle crushed chips around the edge of the pie. Let stand for 30 minutes."
    },
    {
      "position": 9,
      "text": "Place pie in refrigerator and let cool until ganache is set, 1 to 2 hours. Cut into slices and enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

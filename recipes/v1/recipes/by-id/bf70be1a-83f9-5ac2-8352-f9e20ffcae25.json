  "id": "bf70be1a-83f9-5ac2-8352-f9e20ffcae25",
  "slug": "mississippi-pot-roast",
  "name": "Mississippi Pot Roast",
  "recipe_type": "main",
  "brief_description": "Mississippi pot roast is easy to make in a slow cooker with a chuck roast, au jus gravy, and pepperoncini peppers for fork-tender, flavorsome results.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine chuck roast, pepperoncini, pepperoncini juice, butter, au jus mix, ranch dressing mix, salt, and pepper in a slow cooker."
    },
    {
      "position": 3,
      "text": "Cover and cook on Low until roast is fork-tender, about 8 hours."
    },
    {
      "position": 4,
      "text": "Remove chuck from slow cooker; shred with 2 forks."
    },
    {
      "position": 5,
      "text": "Serve with gravy and enjoy."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 480,

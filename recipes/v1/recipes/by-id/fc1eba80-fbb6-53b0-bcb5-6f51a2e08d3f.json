  "schema_version": 1,
  "id": "fc1eba80-fbb6-53b0-bcb5-6f51a2e08d3f",
  "slug": "ricotta-pie-old-italian-recipe",
  "name": "Ricotta Pie (Old Italian Recipe)",
  "recipe_type": "dessert",
  "brief_description": "This homemade ricotta pie has a sweetened crust and silky ricotta filling with chocolate chips for the perfect Italian dessert on special occasions.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "To make the filling: Beat eggs, sugar, and vanilla together in a large bowl. Stir in ricotta cheese and chocolate chips; set aside."
    },
    {
      "position": 3,
      "text": "To make the crust: Combine flour, sugar, and baking powder together in a large bowl; cut in shortening until mixture resembles coarse crumbs. Mix in beaten eggs and vanilla. Divide dough into 4 balls, wrap in plastic, and chill for at least 30 minutes."
    },
    {
      "position": 4,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease two 9-inch, deep-dish pie plates."
    },
    {
      "position": 5,
      "text": "Working with 1 dough ball at a time (keeping remaining dough chilled), roll out 2 dough balls and use them to line the bottoms and sides of the prepared pie plates. Try not to make the crust too thick, as it will expand during cooking. Working with 1 dough ball at a time (keeping remaining dough chilled), roll the remaining 2 dough balls out into 10-inch circles for the lattice tops, chilling dough for about 15 minutes if it becomes difficult to handle."
    },
    {
      "position": 6,
      "text": "Pour ricotta filling evenly into pie crusts. Start with the longest strips of dough and lay the first 2 in an X in the center of the pie. Alternate horizontal and vertical strips, weaving them in an over-and-under pattern. Use the shortest strips for the edges of the lattice. Fold the ends of the lattice strips under the edge of the bottom crust and flute the crust; brush lattice top with milk. Arrange foil on edges of crust."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven for 20 to 30 minutes; remove foil. Rotate pies on the rack so they will bake evenly. Continue to bake until a knife inserted in the center of each pie comes out clean, 25 to 30 minutes more. Cool completely on wire racks. Refrigerate until ready to serve."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 45,

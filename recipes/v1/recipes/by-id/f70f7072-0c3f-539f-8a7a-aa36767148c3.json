  "id": "f70f7072-0c3f-539f-8a7a-aa36767148c3",
  "slug": "prosciutto-parmesan-and-pine-nut-bruschetta",
  "name": "Prosciutto Parmesan and Pine Nut Bruschetta",
  "recipe_type": "appetizer",
  "brief_description": "Lightly toasted French baguette slices are spread with a diced prosciutto and Parmesan cheese blend, then sprinkled with toasted pine nuts.",
  "cuisine": "Italian Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a medium bowl, cream the butter. Blend in prosciutto, Parmesan cheese and ground black pepper."
    },
    {
      "position": 3,
      "text": "Place baguettes on a medium baking sheet. Heat in the preheated oven until lightly toasted, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Spread baguette slices with the butter mixture. Arrange on a large serving platter. Sprinkle with pine nuts."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

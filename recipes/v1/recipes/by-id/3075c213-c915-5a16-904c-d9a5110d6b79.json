{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "3075c213-c915-5a16-904c-d9a5110d6b79",
  "slug": "baked-ziti-with-spinach-and-meat",
  "name": "Baked Ziti with Spinach and Meat",
  "recipe_type": "salad",
  "brief_description": "Served alongside a dinner salad and crusty Italian bread, this baked ziti with spinach and meat makes a hearty meal your whole family will love.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Add ziti and cook, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain and set aside."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat a large skillet over medium heat. Cook and stir ground beef, onion, and 1/2 of the garlic in the hot skillet until beef is until browned and onion is wilted, 5 to 7 minutes. Add spaghetti sauce and simmer for 15 minutes."
    },
    {
      "position": 4,
      "text": "While meat sauce is simmering, heat olive oil in a medium skillet over medium heat. Add remaining garlic and cook until fragrant, about 1 minute. Add spinach and cook, tossing occasionally, until wilted, about 2 minutes. Remove from heat."
    },
    {
      "position": 5,
      "text": "Mix together ricotta cheese, 1/4 cup Parmesan cheese, and wilted spinach in a large bowl until well combined. Season with salt."
    },
    {
      "position": 6,
      "text": "Place 1/2 of the ziti in the bottom of a 9x13-inch baking dish and layer with 1/2 of the meat sauce. Spread provolone cheese on top to form a flat surface. Spread spinach mixture over the top, then cover with remaining ziti and meat sauce. Top with 2 tablespoons Parmesan and sprinkle mozzarella over top."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven for 30 minutes. Remove from the oven and let firm up for at least 10 minutes before serving."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 70,
  "preparation_time_minutes": 20,

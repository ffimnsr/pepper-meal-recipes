  "id": "f72428f6-1bbb-560d-a175-9bb6fd9a2518",
  "slug": "quesadillas-de-flor-de-calabaza-zucchini-blossom-quesadillas",
  "name": "Quesadillas de Flor de Calabaza (Zucchini Blossom Quesadillas)",
  "recipe_type": "snack",
  "brief_description": "This quesadillas de flor de calabaza recipe features zucchini blossom and cheese tortillas pan-fried in bacon grease. This is a popular snack in Mexico.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Melt bacon grease in a cast-iron or regular skillet over medium heat. Place tortillas side-by-side in the skillet; top each with 1 slice cheese and 3 zucchini blossoms. Fold tortillas in half."
    },
    {
      "position": 2,
      "text": "Cook until tortillas are lightly browned and cheese starts to melt, 2 to 3 minutes. Flip and cook until other side is crispy, lightly browned, and cheese has melted, about 1 minute more."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,

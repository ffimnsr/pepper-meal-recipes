{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "507a1bbf-cdb0-5c3c-92d6-d69ffa5de83e",
  "slug": "easter-white-borscht",
  "name": "Easter White Borscht",
  "recipe_type": "soup",
  "brief_description": "This hearty white borscht made with leeks, onion, kielbasa, and hard-cooked eggs has a thick, tangy broth made from pur\u00e9ed vegetables and sour cream.",
  "cuisine": "Polish",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water, kielbasa, and 2 whole cloves garlic in a large pot to a boil over high heat, then reduce heat to medium and simmer for 30 minutes. Remove sausage; pour cooking liquid into a separate bowl. Cut sausage into bite-sized pieces. Discard garlic."
    },
    {
      "position": 2,
      "text": "Melt butter over medium heat in the same pot. Add leeks, onion, and minced garlic; cook and stir until vegetables tender, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Transfer vegetables and about 1/2 cup reserved cooking water to a blender, filling halfway. Cover and hold lid down with a potholder; pulse a few times before leaving on to blend until smooth, adding more water as needed. Pour back into original pot. Repeat with any remaining vegetables."
    },
    {
      "position": 4,
      "text": "Add remaining cooking water and bay leaves to vegetable pur\u00e9e; bring to a simmer over medium heat. Remove and discard bay leaves."
    },
    {
      "position": 5,
      "text": "Whisk sour cream and flour together in a bowl until smooth; gradually whisk into soup until thickened. Stir in dill and vinegar, then season with salt and pepper."
    },
    {
      "position": 6,
      "text": "Divide sausage pieces and chopped eggs among bowls; ladle soup over top."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

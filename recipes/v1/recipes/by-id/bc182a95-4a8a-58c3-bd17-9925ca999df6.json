  "id": "bc182a95-4a8a-58c3-bd17-9925ca999df6",
  "slug": "roasted-pork-tenderloin",
  "name": "Roasted Pork Tenderloin",
  "recipe_type": "main",
  "brief_description": "Easy and yummy pork tenderloin, melts in your mouth. You may use more or less sage according to your taste.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Rub tenderloin with sage and garlic salt. Place tenderloin in a baking pan or casserole. Cover meat with half of the sauerkraut. Place the apple and onion, cut side down, on top of the sauerkraut. Cover with remaining sauerkraut. Sprinkle with brown sugar."
    },
    {
      "position": 3,
      "text": "Cover and bake in preheated oven for 2 to 3 hours, until the internal temperature has reached 145 degrees F (63 degrees C)."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 180,
  "preparation_time_minutes": 10,

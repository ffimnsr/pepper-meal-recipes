  "id": "57a39404-084d-514d-b989-8125dfa64952",
  "slug": "aunt-kathys-irish-soda-bread",
  "name": "Aunt Kathy's Irish Soda Bread",
  "recipe_type": null,
  "brief_description": "Try this old family recipe from Ireland's County Cork next time you want a loaf of soda bread.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease and flour a heavy pan."
    },
    {
      "position": 2,
      "text": "Mix flour, sugar, raisins, caraway seeds, baking powder, baking soda, and salt in a large bowl. Add eggs, buttermilk, and milk to the flour mixture; stir until evenly incorporated. Transfer dough to the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until when the bread is tapped on top it sounds hollow, about 75 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "hard",

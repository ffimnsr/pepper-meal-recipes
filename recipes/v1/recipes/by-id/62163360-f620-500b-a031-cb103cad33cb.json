  "id": "62163360-f620-500b-a031-cb103cad33cb",
  "slug": "ramen-noodle-frittata",
  "name": "Ramen Noodle Frittata",
  "recipe_type": "breakfast",
  "brief_description": "Ramen noodles are baked into a frittata and topped with shredded cheese. My kids love this frittata for lunch! It's so easy to make!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place noodles in a saucepan filled with boiling water, reserving the seasoning packet. Cook until tender, and drain. In a medium bowl, whisk together the eggs and seasoning packets from the noodles. Mix in noodles."
    },
    {
      "position": 2,
      "text": "Melt butter in a large skillet over medium heat. Add the noodle mixture, and cook over medium-low heat until firm, 5 to 7 minutes. Cut into fourths, and turn over to brown the other side for 1 to 2 minutes. Sprinkle cheese over the top, and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

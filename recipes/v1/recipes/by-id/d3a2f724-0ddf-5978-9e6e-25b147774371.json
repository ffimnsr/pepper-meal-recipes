  "id": "d3a2f724-0ddf-5978-9e6e-25b147774371",
  "slug": "roasted-pork-banh-mi-vietnamese-sandwich",
  "name": "Roasted Pork B\u00e1nh M\u00ec (Vietnamese Sandwich)",
  "recipe_type": "main",
  "brief_description": "This b\u00e1nh m\u00ec recipe by Chef John features a warm, crisp French roll filled with roast pork, pat\u00e9, and cool, crunchy vegetables for a tasty sandwich.",
  "cuisine": "Vietnamese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Toss radish and carrot with seasoned rice vinegar in a bowl until well coated. Let sit until veggies become slightly limp, 15 to 20 minutes. Drain and set aside or refrigerate."
    },
    {
      "position": 3,
      "text": "Mix mayonnaise, hoisin sauce, and sriracha in a small bowl. Split French roll just enough so you can open it like a book. Pull out some of the bread from the top half to better accommodate the filling if desired. Spread the interior surfaces of roll liberally with mayonnaise mixture."
    },
    {
      "position": 4,
      "text": "Transfer roll, cut-side up, to the prepared baking sheet. Bake in the preheated oven until warm and crisp with slightly browned edges, about 7 minutes."
    },
    {
      "position": 5,
      "text": "Place sliced pork, pat\u00e9, pickled radish and carrot, cucumber, jalape\u00f1o, and cilantro leaves in warm roll. Cut in half to serve."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,

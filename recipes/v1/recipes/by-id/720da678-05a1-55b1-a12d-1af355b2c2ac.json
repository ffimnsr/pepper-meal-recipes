  "id": "720da678-05a1-55b1-a12d-1af355b2c2ac",
  "slug": "rhubarb-cheese-pie",
  "name": "Rhubarb Cheese Pie",
  "recipe_type": "dessert",
  "brief_description": "This unique rhubarb pie recipe features a layer of luscious cream cheese, covered with a vanilla sour cream topping for a creamy, tart, sweet dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Place pie crust in a 9-inch pie plate."
    },
    {
      "position": 2,
      "text": "Stir \u2153 cup sugar and flour together in a large bowl until well combined; add rhubarb and toss to coat. Pour into pie crust."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 15 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, beat cream cheese, eggs, and \u2153 cup sugar together in a medium bowl until well blended."
    },
    {
      "position": 5,
      "text": "Remove pie from the oven; reduce the oven temperature to 350 degrees F (175 degrees C). Pour cream cheese mixture over rhubarb; continue baking 30 minutes more."
    },
    {
      "position": 6,
      "text": "Meanwhile, stir sour cream, 2 tablespoons sugar, and vanilla extract together in a medium bowl until smooth."
    },
    {
      "position": 7,
      "text": "Remove pie from the oven; immediately spread sour cream mixture over pie. Cool, then cut into wedges and serve."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

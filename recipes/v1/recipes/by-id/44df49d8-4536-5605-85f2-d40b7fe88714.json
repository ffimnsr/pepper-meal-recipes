  "id": "44df49d8-4536-5605-85f2-d40b7fe88714",
  "slug": "creamy-cowboy-soup-recipe-8723943",
  "name": "Creamy Cowboy Soup",
  "recipe_type": "soup",
  "brief_description": "Creamy cowboy soup is a hearty, rustic creamy soup with beef, bacon, beans, and potatoes that is perfect for the start of \u201c\u2018ber season.\u201d",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 8 minutes. Drain bacon slices on paper towels; chop when cool enough to handle."
    },
    {
      "position": 2,
      "text": "Melt butter in a saucepan over medium heat; whisk in flour. Slowly add evaporated milk, whisking until smooth. Cook until thickened slightly, about 2 minutes; remove from heat."
    },
    {
      "position": 3,
      "text": "Add oil to a large pot or Dutch oven; cook onions over medium heat until nearly translucent. Add ground beef, and cook and stir, breaking up chunks with a spatula as it cooks, 5 to 7 minutes. Drain any excess fat."
    },
    {
      "position": 4,
      "text": "Add bacon, diced tomatoes with green chiles, beans, and corn. Pour in beef broth and add the diced potatoes. Stir to combine. Add garlic granules, and cumin. Season with salt and pepper."
    },
    {
      "position": 5,
      "text": "Bring soup to a boil, then reduce heat to low. Cover; simmer until potatoes are tender; 20 to 30 minutes. Pour evaporated milk mixture into soup; stir to combine. Serve immediately."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "61e38b25-890f-57d9-ac09-b9563c11b9f5",
  "slug": "pineapple-lemonade",
  "name": "Pineapple Lemonade",
  "recipe_type": "dessert",
  "brief_description": "This pineapple lemonade is made with fresh fruit, water, and sweetener of choice for a refreshing summer beverage perfect for outdoor picnics or parties.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Core pineapple using a pineapple corer or slicer. Cut into chunks and measure out 2 cups. Reserve any pineapple juice."
    },
    {
      "position": 2,
      "text": "Combine 2 cups pineapple chunks, reserved pineapple juice, 2 cups water, and lemon juice in a blender. Blend until smooth and pour into a pitcher."
    },
    {
      "position": 3,
      "text": "Add remaining 2 cups water and sweetener to the pitcher. Stir and serve over ice."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 15,

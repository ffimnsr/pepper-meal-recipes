  "slug": "cream-cheese-frosting-ii",
  "name": "Cream Cheese Frosting",
  "recipe_type": "dessert",
  "brief_description": "This is the best cream cheese frosting recipe with simple ingredients. Smooth, creamy, and delicious \u2014 perfect for cake, cupcakes, and more.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Beat cream cheese and softened butter in a medium bowl until smooth and creamy. Mix in vanilla."
    },
    {
      "position": 3,
      "text": "Gradually add sugar, beating after each addition until incorporated. Continue to beat until frosting is very smooth."
    },
    {
      "position": 4,
      "text": "Use to frost cooled cakes or cupcakes."
    }
  ],

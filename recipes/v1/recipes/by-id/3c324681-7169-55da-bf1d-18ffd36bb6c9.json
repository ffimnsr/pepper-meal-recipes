{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "3c324681-7169-55da-bf1d-18ffd36bb6c9",
  "slug": "empanadas-fritas-de-queso",
  "name": "Empanadas Fritas de Queso",
  "recipe_type": "appetizer",
  "brief_description": "These Chilean empanadas are filled with queso chanco, a Swiss-type cheese, and can be either baked or deep-fried.",
  "cuisine": "Chilean",
  "instructions": [
    {
      "position": 1,
      "text": "Sift the flour, baking powder, and salt into a large mixing bowl. Combine the lard and milk in a saucepan, and heat until the milk is hot. Pour the hot milk into the flour mixture, and stir until a dough forms. Turn out onto a floured surface, and knead until smooth and elastic. Cover, and allow to rest for 15 minutes."
    },
    {
      "position": 2,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 3,
      "text": "Roll the dough out on a floured surface 1/4-inch thick. Cut into 4-inch rounds. Brush the outer edges of each circle with beaten egg, and fill with a small mound of cheese. Fold each circle in half to form a half-moon; press the edges with your fingers or a fork to seal. Place the empanadas onto a parchment paper-lined baking sheet. Brush the tops with remaining egg."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven until golden-brown, about 20 minutes."
    },
    {
      "position": 5,
      "text": "Alternatively, the empanadas may be deep fried in 375 degrees F (190 degrees C) oil. If deep frying, do not brush the outsides of the empanadas with egg. Drain on paper towels."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

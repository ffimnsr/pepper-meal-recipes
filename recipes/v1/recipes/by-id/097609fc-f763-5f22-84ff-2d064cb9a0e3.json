  "id": "097609fc-f763-5f22-84ff-2d064cb9a0e3",
  "slug": "philly-cheesesteak-quesadillas",
  "name": "Philly Steak Quesadillas",
  "recipe_type": "main",
  "brief_description": "This steak quesadilla recipe stuffs golden tortillas with tender beef, green bell pepper, onions, and lots of gooey cheese for a family favorite.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Cook and stir steak in a skillet over medium heat until browned, 5 to 7 minutes. Add onions and bell peppers; cook and stir until softened, 5 to 10 minutes. Pour BBQ sauce over steak mixture and simmer until sauce is slightly reduced, about 10 minutes."
    },
    {
      "position": 3,
      "text": "Lay 4 tortillas on a baking sheet; top each with steak mixture, Cheddar cheese, and remaining tortillas."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 10 minutes. Flip quesadillas and cook until cheese is melted, about 5 minutes more."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

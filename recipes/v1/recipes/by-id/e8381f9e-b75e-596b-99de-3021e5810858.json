  "id": "e8381f9e-b75e-596b-99de-3021e5810858",
  "slug": "chicken-marsala-meatballs-recipe-11997527",
  "name": "Chicken Marsala Meatballs",
  "recipe_type": "main",
  "brief_description": "These chicken Marsala meatballs are a cozy twist on the classic Italian-American dish. Tender chicken and mushroom meatballs simmer in a creamy Marsala wine sauce with garlic and fresh herbs, creating a rich, savory dinner that's delicious served over mashed potatoes or rice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place ground chicken into a large bowl. Finely mince 4 ounces mushrooms using a sharp knife or food processor. Add minced mushrooms to the chicken, along with panko breadcrumbs, Parmesan cheese, garlic, egg, parsley, salt, and pepper. Mix until evenly combined and form into approximately 24 meatballs, using a small cookie scoop."
    },
    {
      "position": 2,
      "text": "Heat olive oil over medium heat in a large non-stick skillet. Brown meatballs, turning every 1 to 2 minutes until all sides are browned, about 8 to 10 minutes. Remove meatballs to a plate."
    },
    {
      "position": 3,
      "text": "In the same skillet, heat remaining 1 tablespoon oil. Saute sliced mushrooms until browned, about 5 to 6 minutes. Add garlic and cook until fragrant, about 30 seconds. Whisk in marsala wine and chicken broth. Simmer over medium-low heat until liquid is reduced by a third to a half, 8 to 10 minutes."
    },
    {
      "position": 4,
      "text": "Whisk cold butter into the sauce until melted, then pour in heavy cream. Continue simmering, stirring occasionally, until slightly thickened, about 8 to 10 minutes."
    },
    {
      "position": 5,
      "text": "Return meatballs to the skillet and cook until meatballs are heated through, 2 to 3 minutes. Garnish with chopped parsley."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

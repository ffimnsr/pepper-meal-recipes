  "id": "99cf1d8d-8d92-502b-ae77-c9b21ab2ecf9",
  "slug": "grilled-chicken-quesadillas",
  "name": "Grilled Chicken Quesadillas",
  "recipe_type": "main",
  "brief_description": "Grilled chicken quesadillas are filled with adobo-seasoned chicken, cheese, green chiles, and olives for an easy, flavorful meal.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Place the chicken on a plate, and sprinkle with adobo seasoning on both sides. Let it marinate for 15 minutes."
    },
    {
      "position": 2,
      "text": "Heat grill for medium-high heat."
    },
    {
      "position": 3,
      "text": "Lightly oil the grill grate. Place chicken on grill, and cook for 10 minutes per side, or until juices run clear. Remove chicken from grill, and cut into bite-size pieces."
    },
    {
      "position": 4,
      "text": "Place one or two tortillas on the grill, and sprinkle with a thin layer of cheese, chicken, onion, olives, and chiles. Top with another tortilla, and grill until brown and crispy on both sides, about 3 minutes per side. Repeat with remaining ingredients. Cut into wedges to serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "medium",

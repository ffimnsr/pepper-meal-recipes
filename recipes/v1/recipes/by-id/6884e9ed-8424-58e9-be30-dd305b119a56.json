  "id": "6884e9ed-8424-58e9-be30-dd305b119a56",
  "slug": "arrachera-mexican-skirt-steak-for-tacos",
  "name": "Arrachera (Mexican Skirt Steak for Tacos)",
  "recipe_type": "main",
  "brief_description": "This arrachera recipe makes flavorful skirt steak tacos. A Mexican specialty, the beef is marinated in saz\u00f3n and adobo seasoning, lime, and beer.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Place a single layer of steak in a shallow casserole dish. Sprinkle a portion of lime juice, saz\u00f3n, and adobo seasoning. Top with chopped onion pieces. Repeat layers until all pieces of steak are seasoned. Pour beer over the mixture. Cover and refrigerate for at least 1 hour, and up to 24 hours."
    },
    {
      "position": 2,
      "text": "Preheat a grill to medium-high."
    },
    {
      "position": 3,
      "text": "Discard marinade. Grill steak until lightly charred on the outside but still slightly tender in the center for medium doneness, 6 to 7 minutes per side."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,

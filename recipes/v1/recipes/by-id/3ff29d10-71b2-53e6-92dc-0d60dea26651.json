  "id": "3ff29d10-71b2-53e6-92dc-0d60dea26651",
  "slug": "pizza-bombs-recipe-7483839",
  "name": "Pizza Bombs",
  "recipe_type": "appetizer",
  "brief_description": "You\u2019ll love these pizza bombs if you love anything pizza. For this recipe, roll up biscuit dough around pepperoni, pizza sauce and cheese, and bake these easy appetizers.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Pop open the biscuit can and divide into 8 biscuits. Flatten each biscuit with your thumb into a 1/8-inch thick circle."
    },
    {
      "position": 3,
      "text": "Spread the center of each circle with about 1 tablespoon pizza sauce, leaving a 1/4-inch edge open. Sprinkle each circle with about 1 tablespoon mozzarella cheese, and about 1 tablespoon pepperoni."
    },
    {
      "position": 4,
      "text": "Pull up the edges of each circle to form a ball, and seal completely. Roll them in your hands to ensure the dough is sealed, then set each ball on the baking sheet seal-side-down."
    },
    {
      "position": 5,
      "text": "Brush each ball with melted butter. Sprinkle with Parmesan cheese and Italian seasoning."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown, about 15 minutes. Serve with additional warmed pizza sauce for dipping."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

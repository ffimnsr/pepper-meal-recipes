  "id": "92d5d1d1-a4ef-5801-9987-0f40ad8b5af9",
  "slug": "easy-ham-and-cheese-biscuits-recipe-11838104",
  "name": "Easy Ham and Cheese Biscuits",
  "recipe_type": "salad",
  "brief_description": "These easy ham and cheese biscuits are so yummy, and you can make them in minutes. A sprinkle of everything bagel seasoning makes is a really nice touch. Serve with cut-up fruit for breakfast, or with a salad for lunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C) and line a baking sheet with parchment or foil. If using foil, grease foil lightly."
    },
    {
      "position": 2,
      "text": "Separate dough into 8 biscuits, and place on the prepared sheet pan. Gently tease apart half of each biscuit\u2019s layers, almost to the opposite edge of the biscuit, so it opens up like a book."
    },
    {
      "position": 3,
      "text": "Fold 2 slices of thinly sliced deli ham to fit each biscuit, and place on the bottom half of each biscuit. Top with 1/2 slice of cheese, folded to fit the biscuits. Gently fold top halves of biscuit dough over cheese."
    },
    {
      "position": 4,
      "text": "Brush each biscuit with melted butter and sprinkle with everything seasoning."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden brown, 15 to 20 minutes. Cool about 5 minutes and serve warm."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

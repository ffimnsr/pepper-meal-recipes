  "id": "bb22147e-7363-5ff3-9b86-c4dddab2a707",
  "slug": "2-ingredient-ice-cream",
  "name": "2-Ingredient Ice Cream",
  "recipe_type": "dessert",
  "brief_description": "This 2-ingredient ice cream, made with whipped cream and sweetened condensed milk, is so easy to make and your family and friends will love it!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat cream in a chilled glass or metal bowl with an electric mixer until soft peaks form; add condensed milk and beat until thick and well combined."
    },
    {
      "position": 2,
      "text": "Transfer mixture to a shallow container and cover with plastic wrap; freeze until solid, about 6 hours."
    }
  ],
  "servings": 4,

  "id": "c0a4ee82-adb9-5c5b-9883-9b06e4a9f8e9",
  "slug": "shuk-shuka",
  "name": "Shakshuka (Middle Eastern Baked Eggs)",
  "recipe_type": "breakfast",
  "brief_description": "Eggs are poached in a garlicky tomato sauce in this traditional Jordanian version of shakshuka, a Middle Eastern and North African classic.",
  "cuisine": "Middle Eastern",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large skillet over medium-high heat. Add chopped tomatoes and garlic, stirring occasionally, until liquid has cooked out of tomatoes. Carefully break eggs over tomatoes without breaking yolks. Lightly season with salt, reduce heat and cover."
    },
    {
      "position": 2,
      "text": "Simmer covered for 20 minutes, or until yolks are fully cooked. Adjust seasoning with salt as needed. Serve with pita bread."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,

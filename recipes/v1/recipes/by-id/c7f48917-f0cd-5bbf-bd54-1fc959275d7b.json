  "id": "c7f48917-f0cd-5bbf-bd54-1fc959275d7b",
  "slug": "fresh-semolina-and-egg-pasta",
  "name": "Fresh Semolina and Egg Pasta",
  "recipe_type": null,
  "brief_description": "Fresh semolina pasta is literally at your fingertips as you knead together two types of flour, salt, eggs, and olive oil to make homemade pasta dough.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Sift all-purpose flour, semolina flour, and a pinch of salt together in a large bowl. Make a mountain out of flour mixture on a clean surface; create a deep well in the center. Break eggs into the well and add olive oil. Whisk eggs very gently with a fork, gradually incorporating flour from the sides of the well. When mixture becomes too thick to mix with a fork, begin kneading with your hands."
    },
    {
      "position": 3,
      "text": "Knead dough until it is smooth and supple, 8 to 12 minutes, Dust dough and work surface with semolina as needed to keep dough from becoming sticky. Wrap dough tightly in plastic wrap; allow it to rest at room temperature for 30 minutes."
    },
    {
      "position": 4,
      "text": "Roll out dough with a pasta machine or a rolling pin to desired thickness. Cut into your favorite style of noodle or stuff with your favorite filling to make ravioli."
    },
    {
      "position": 5,
      "text": "Bring a large pot of lightly salted water to a boil. Cook pasta in the boiling water until tender yet firm to the bite, 1 to 3 minutes (or longer depending on thickness). Drain immediately and toss with your favorite sauce."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

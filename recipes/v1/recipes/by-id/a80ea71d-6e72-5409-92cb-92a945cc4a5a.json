  "id": "a80ea71d-6e72-5409-92cb-92a945cc4a5a",
  "slug": "pancit-sotanghon",
  "name": "Pancit Sotanghon",
  "recipe_type": "main",
  "brief_description": "Pancit sotanghon is a Filipino dish with mung bean noodles mixed with wood ear mushrooms, bok choy, and leftover chicken.",
  "cuisine": "Filipino Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Soak vermicelli in a bowl of hot water, 2 to 3 minutes. Drain. Cut noodles to desired length; set aside. Soak mushrooms in a second bowl of water; set aside to soften."
    },
    {
      "position": 2,
      "text": "Heat oil in a saucepan over medium-high heat. Cook and stir garlic in hot oil until browned, about 2 minutes. Remove garlic to a bowl and set aside for garnish. Add onion and achiote powder to the saucepan and saut\u00e9 until onion is translucent, about 5 minutes. Add chicken, soy sauce, and fish sauce. Stir in bouillon until dissolved. Pour in 1 cup water and bring to a boil."
    },
    {
      "position": 3,
      "text": "Drain softened mushrooms and cut into 1-inch pieces."
    },
    {
      "position": 4,
      "text": "Toss cabbage, bok choy, and carrot into boiling water mixture. Add vermicelli, mushrooms, black pepper, and chili powder. Cook, mixing well, until pancit is slightly dried, about 5 minutes. Transfer pancit to a platter. Garnish with egg slices and browned garlic."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

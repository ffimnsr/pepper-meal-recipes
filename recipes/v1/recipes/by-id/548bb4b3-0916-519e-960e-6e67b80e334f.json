  "id": "548bb4b3-0916-519e-960e-6e67b80e334f",
  "slug": "vegetarian-refried-beans",
  "name": "Vegetarian Refried Beans",
  "recipe_type": "side",
  "brief_description": "This traditional vegetarian and vegan refried bean recipe tastes great with hardly any fat! You can sprinkle in Monterey jack cheese if you're vegetarian.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Place beans in a large saucepan and cover with water by 1 inch. Place over high heat and bring to a boil. When beans come to a boil, drain and return them to the same pot."
    },
    {
      "position": 2,
      "text": "Cover beans with water by 2 inches; stir in 1 tablespoon garlic, tomato, cumin, and chili powder. Bring to a boil over high heat, then reduce heat to low, and simmer until beans are very soft, about 3 hours and 45 minutes, adding water as needed."
    },
    {
      "position": 3,
      "text": "Once beans have cooked, mash them with remaining garlic, oil, and salt; add water as needed to achieve desired consistency. Place over low heat for 30 minutes, stirring occasionally."
    }
  ],
  "servings": 12,

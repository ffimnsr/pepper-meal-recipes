  "id": "269495c3-9dd2-5a2e-8589-7132365e5fcb",
  "slug": "spotted-dog-irish-bread",
  "name": "Spotted Dog Irish Bread",
  "recipe_type": "breakfast",
  "brief_description": "A simple version of Irish soda bread with raisins is baked in a cast iron skillet. This is a vintage recipe handed down through the family.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Grease a 12-inch cast iron skillet."
    },
    {
      "position": 3,
      "text": "Sift flour, sugar, and baking powder together in a large bowl."
    },
    {
      "position": 4,
      "text": "Beat eggs with milk in a separate bowl."
    },
    {
      "position": 5,
      "text": "Stir egg mixture into flour mixture until moistened; batter will be very thick."
    },
    {
      "position": 6,
      "text": "Fold in raisins until thoroughly combined."
    },
    {
      "position": 7,
      "text": "Spread batter into prepared cast iron skillet."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until bread has risen and is golden brown on top, about 1 hour."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,

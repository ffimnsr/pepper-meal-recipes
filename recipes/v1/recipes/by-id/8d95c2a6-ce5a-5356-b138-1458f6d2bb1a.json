  "id": "8d95c2a6-ce5a-5356-b138-1458f6d2bb1a",
  "slug": "two-ingredient-dough-garlic-knots",
  "name": "Two-Ingredient Dough Garlic Knots",
  "recipe_type": "appetizer",
  "brief_description": "Use 2-ingredient dough to make these delicious, easy garlic knots in just 30 minutes.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine flour, yogurt, garlic granules, Italian seasoning, and salt in a bowl; mix to combine."
    },
    {
      "position": 2,
      "text": "Dust work surface with more flour. Transfer dough to work surface. Knead dough for 8 to 10 minutes with the palm of your hand. Add more flour (1 teaspoon at a time) as needed to keep dough from being too sticky."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 500 degrees F (260 degrees C). Line a baking sheet with parchment paper or a silicone baking mat (such as Silpat\u00ae)."
    },
    {
      "position": 4,
      "text": "Shape dough into a rounded loaf. Using a bench scraper, cut off 8 wedges of dough. Roll each wedge of dough into a rope shape and tie into knots. Place knots onto the prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until knots are lightly browned, 10 to 12 minutes."
    },
    {
      "position": 6,
      "text": "Meanwhile, combine melted butter, oil, garlic granules, and parsley for topping in a small glass bowl. Brush mixture over the warm knots."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

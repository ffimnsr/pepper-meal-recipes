  "id": "91edfe7b-ca56-50ae-a441-f134c44b87d0",
  "slug": "super-easy-doughnuts",
  "name": "Super Easy Doughnuts",
  "recipe_type": "dessert",
  "brief_description": "This easy donut recipe is quick to make in just 30 minutes using simple ingredients for delicious soft-on-the-inside, cakey donuts perfect for brunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir together milk and vinegar; let stand for a few minutes until thick."
    },
    {
      "position": 3,
      "text": "Cream together sugar and shortening in a mixing bowl until smooth."
    },
    {
      "position": 4,
      "text": "Beat in egg and vanilla until well-blended."
    },
    {
      "position": 5,
      "text": "Sift together flour, baking soda, and salt in a separate bowl; stir into sugar mixture alternating with milk mixture."
    },
    {
      "position": 6,
      "text": "Roll dough out on a floured surface to 1/3-inch thickness."
    },
    {
      "position": 7,
      "text": "Cut into donuts using a donut cutter. Let stand for about 10 minutes."
    },
    {
      "position": 8,
      "text": "Heat oil in a large, deep skillet to 375 degrees F (190 degrees C). Fry donuts in hot oil in batches until golden, turning over once, about 1 to 2 minutes per side."
    },
    {
      "position": 9,
      "text": "Drain on paper towels."
    },
    {
      "position": 10,
      "text": "Dust with confectioners' sugar while they are still warm and serve."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

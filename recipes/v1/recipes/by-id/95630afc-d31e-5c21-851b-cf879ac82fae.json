  "id": "95630afc-d31e-5c21-851b-cf879ac82fae",
  "slug": "sous-vide-steak",
  "name": "Sous Vide Steak",
  "recipe_type": "main",
  "brief_description": "Learn how to cook sous vide steak with this recipe. These steaks are beautifully tender when cooked this way but get extra color and flavor when seared on the grill after.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Generously season steaks with salt and black pepper. Place into a large plastic bag and vacuum seal."
    },
    {
      "position": 2,
      "text": "Place a heat-resistant pad underneath a large pot filled with water. Attach a sous vide precision cooker to the pot and set the temperature to 130 degrees F (54 degrees C). Immerse the bag with steaks into the water bath and cook for 2 hours."
    },
    {
      "position": 3,
      "text": "Remove the bag from the water bath and take out steaks. Pat very dry with paper towels."
    },
    {
      "position": 4,
      "text": "Preheat an outdoor grill to medium-high heat and lightly oil the grate."
    },
    {
      "position": 5,
      "text": "Place steak on the preheated grill. Cook, turning every minute or so until well seared all over, 3 to 4 minutes total."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 125,
  "preparation_time_minutes": 5,

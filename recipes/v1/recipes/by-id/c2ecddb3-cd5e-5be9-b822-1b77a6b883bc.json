{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "c2ecddb3-cd5e-5be9-b822-1b77a6b883bc",
  "slug": "crispy-air-fryer-crab-rangoon-rolls-recipe-12018314",
  "name": "Crispy Air Fryer Crab Rangoon Rolls",
  "recipe_type": "appetizer",
  "brief_description": "These crispy air fryer crab Rangoon rolls wrap a creamy filling of tangy cream cheese, sweet imitation crab, fresh scallions, and a kick of Sriracha in rice paper that turns irresistibly crisp in the air fryer. Finished with a brush of sweet chili sauce, they\u2019re delicious as an appetizer or snack.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Stir together crab meat, cream cheese, scallion, Sriracha, salt, Worcestershire sauce, sugar, and garlic in a medium bowl until well combined. Spoon mixture into a large piping bag or resealable plastic bag. Cut a 1-inch hole in tip or corner. Set aside."
    },
    {
      "position": 2,
      "text": "Place beaten eggs on a large rimmed plate. Dip both sides of 1 rice paper sheet in egg until it becomes slightly pliable, then remove, letting excess drip off. Place rice paper sheet on a clean work surface or plate."
    },
    {
      "position": 3,
      "text": "Pipe a 5-inch line (about 4 teaspoons) of crab mixture across the bottom 1/4 of rice paper sheet, stopping about 1 inch from sides. Starting from bottom of sheet, roll rice paper, jelly roll style, over crab mixture. Place roll seam side down. Starting with one end, loosely roll up into a spiral; tuck free end underneath to secure. (If rice paper isn\u2019t pliable enough yet, let it sit a few seconds until softened before spiraling.) Repeat with remaining egg, rice paper sheets, and crab mixture. Brush tops with remaining beaten egg, then discard excess. Sprinkle tops of rolls with sesame seeds."
    },
    {
      "position": 4,
      "text": "Preheat a 6-quart air fryer to 400 degrees F (200 degrees C) for 5 minutes. Lightly coat air fryer basket with cooking spray. Add rice paper rolls to basket, spacing 1 inch apart; spray tops with cooking spray. Cook until golden and crispy, 12 to 15 minutes."
    },
    {
      "position": 5,
      "text": "Transfer rolls to a serving plate. Brush with chili sauce, if desired, and garnish with scallions. Serve immediately with more chili sauce. Recipe developed by Tricia Manzanero Stuedeman"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,

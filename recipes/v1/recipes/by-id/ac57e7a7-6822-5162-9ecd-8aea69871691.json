  "id": "ac57e7a7-6822-5162-9ecd-8aea69871691",
  "slug": "the-best-pound-cake",
  "name": "The Best Pound Cake",
  "recipe_type": "appetizer",
  "brief_description": "This pound cake with evaporated milk is a moist dessert made with margarine, vanilla extract, and shortening \u2014 and it only takes less than two hours.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Don't preheat the oven. Grease and flour a 10-inch tube or Bundt pan. Sift together the all-purpose flour and self-rising flour; set aside."
    },
    {
      "position": 2,
      "text": "In a large bowl, cream together margarine, shortening, and sugar until light and fluffy. Beat in eggs one at a time. Then beat in flour mixture and milk, mixing just until incorporated. Finally, stir in lemon extract and vanilla."
    },
    {
      "position": 3,
      "text": "Pour batter into a 10-inch tube or Bundt pan. Place cake in a cool oven and set the oven to 350 degrees F (175 degrees C). Bake for 1 hour and 15 minutes, or until a toothpick inserted in the center comes out clean."
    }
  ],
  "servings": 14,
  "cooking_time_minutes": 75,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "schema_version": 1,
  "id": "9cb1243e-6672-5939-957b-7ff270916c0f",
  "slug": "neapolitan-style-pizza-dough-with-garlic-and-italian-seasonings",
  "name": "Neapolitan-Style Pizza Dough with Garlic and Italian Seasonings",
  "recipe_type": "main",
  "brief_description": "This Neapolitan pizza dough recipe is flavored with garlic and Italian seasonings and can be pre-baked for a few minutes before toppings are added.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, mix flour, salt, and yeast until thoroughly combined. Mix in ice water, scraping the bowl as you mix, until all flour and water have been incorporated into a soft dough. Mix in 2 tablespoons of olive oil. Turn dough out onto a floured work surface, and knead until dough is firm but slightly sticky, mixing in more flour if needed. Knead granulated garlic and Italian seasoning into dough. (The kneading step can be done in a bread machine set on the Dough setting.)"
    },
    {
      "position": 2,
      "text": "Form dough into a round, and place into an oiled bowl. Brush the top with 1/2 teaspoon of olive oil, cover the bowl with plastic wrap, and allow dough to rise until double, 1 to 2 hours. Punch down dough, and cut in half. Form each half into a 12-inch pizza crust, and place on pizza pans."
    },
    {
      "position": 3,
      "text": "Move a rack to the bottom position in oven, and preheat the oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 4,
      "text": "Bake pizza crusts on the bottom rack just until firm, 3 to 7 minutes. Allow crusts to cool for about 10 minutes before topping with sauce, cheese, or other desired ingredients and returning to the oven to bake."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

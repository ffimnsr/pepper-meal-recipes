  "id": "b652f8b4-f915-5bbc-a482-9115c369db43",
  "slug": "gluten-free-chicken-nuggets",
  "name": "Gluten-Free Chicken Nuggets",
  "recipe_type": null,
  "brief_description": "These homemade chicken nuggets are breaded with rice flour and corn cereal for a gluten-free option of a kids' favorite.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Blend cereal in a blender or food processor until it has the consistency of bread crumbs; pour into a bowl."
    },
    {
      "position": 2,
      "text": "Beat eggs in a separate bowl until smooth. Pour rice flour into a third bowl."
    },
    {
      "position": 3,
      "text": "Dredge chicken pieces in the rice flour, dip in beaten egg, and then press into the cereal to coat. Keep breaded chicken on a large plate until all are finished, but do not stack."
    },
    {
      "position": 4,
      "text": "Pour enough oil into a large skillet to just cover the bottom and heat over medium-high heat."
    },
    {
      "position": 5,
      "text": "Cook chicken nuggets in hot oil until no longer pink in the center and the juices run clear, 2 to 3 minutes per side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

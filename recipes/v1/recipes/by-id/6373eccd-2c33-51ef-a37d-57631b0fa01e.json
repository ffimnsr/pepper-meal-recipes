  "slug": "caraway-rye-bread-for-the-bread-machine",
  "name": "Caraway Rye Bread (for the bread machine)",
  "recipe_type": "dessert",
  "brief_description": "This light rye loaf for the bread machine has lots of caraway seeds and is sweetened with both brown sugar and molasses.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Put lukewarm water, milk powder, salt, brown sugar, molasses, butter, whole wheat flour, bread flour, rye flour, caraway seeds, and yeast into the pan of a bread machine in the order suggested by the manufacturer. Select the Grain setting and 2-pound loaf size."
    }
  ],

  "id": "36aed65f-9866-5ad6-a5b8-852371598992",
  "slug": "gorgonzola-cream-sauce",
  "name": "Gorgonzola Cream Sauce",
  "recipe_type": "main",
  "brief_description": "Chef John serves mini ravioli in a creamy sauce flavored with tangy Gorgonzola and Parmesan for a quick gourmet dish. It's topped with diced apple and toasted walnuts.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Place a heavy skillet over medium heat. Pour cream into skillet, bring to a simmer, and cook cream until it reduces by half, about 8 minutes, stirring occasionally. Season with salt, black pepper, and cayenne pepper."
    },
    {
      "position": 2,
      "text": "Bring a pot of salted water to a boil. Pour dried ravioli into boiling water and cook, stirring occasionally, until pasta is tender, 16 to 18 minutes. Drain pasta, reserving a cup of pasta water."
    },
    {
      "position": 3,
      "text": "Gently fold cooked ravioli into cream sauce and turn heat to low. Mix in Gorgonzola cheese, stirring gently until melted. If sauce is too thick, thin it with a little pasta cooking water."
    },
    {
      "position": 4,
      "text": "Stir in 2 tablespoons parsley and Parmesan cheese. Transfer to a serving bowl and sprinkle with diced apple, walnuts, and 1 teaspoon parsley."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "209e76b8-98ce-52ef-8a0f-caae07c2201d",
  "slug": "tres-leches-pancakes-recipe-7507446",
  "name": "Tres Leches Pancakes",
  "recipe_type": "dessert",
  "brief_description": "Tres leches pancakes make an indulgent special occasion breakfast dish, and are easy to make with boxed cake mix.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine sweetened condensed milk, evaporated milk, and half and half in a small saucepan and set over medium heat. Bring to a boil, stirring constantly for 3 to 4 minutes. Remove from heat and let cool. This is a sauce, not a syrup, so consistency will be on the thinner side."
    },
    {
      "position": 2,
      "text": "Add cake mix, almond milk, eggs, and 3 tablespoons vegetable oil to a large bowl, and beat vigorously by hand for 2 minutes."
    },
    {
      "position": 3,
      "text": "Heat a large skillet or griddle over medium heat, and lightly coat with remaining vegetable oil. Add 1/4 cup of the batter for each pancake. Cook until edges begin to puff up, small bubbles appear, pop, and leave small holes, 2 to 3 minutes. Flip pancakes and cook until golden brown on the other side, about 2 minutes more."
    },
    {
      "position": 4,
      "text": "Serve pancakes warm with a drizzle of the tres leches sauce, a dollop of whipped cream, and sprinkle of cinnamon."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "slug": "4-ingredient-ramen-mac-and-cheese-recipe-11923081",
  "name": "4-Ingredient Ramen Mac and Cheese",
  "recipe_type": "main",
  "brief_description": "This 4-ingredient ramen mac and cheese couldn't be easier. Ramen noodles in a Cheddar sauce are served with a sliced green onion garnish. It's a fast lunch for one and on the table in 15 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring water to a boil in a large saucepan. Set seasoning packet aside; add noodles to water and boil for 3 minutes. Strain noodles in a colander and run under cold water to stop the cooking. Set aside."
    },
    {
      "position": 2,
      "text": "To the saucepan add milk, cheese, and reserved seasoning packet. Cook over medium-high heat until cheese is melted and sauce has thickened, stirring often, about 3 minutes."
    },
    {
      "position": 3,
      "text": "Turn heat off. Add noodles back to the saucepan. Stir to combine."
    },
    {
      "position": 4,
      "text": "Ladle into dishes to serve, and top with sliced green onion."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "id": "6a83af3e-1df4-52bf-a4a9-8f8c2413515c",
  "slug": "smoky-four-pepper-salsa",
  "name": "Smoky Four-Pepper Salsa",
  "recipe_type": "appetizer",
  "brief_description": "This quick and easy, smoky four-pepper salsa recipe uses four kinds of peppers, both sweet and hot, and can be adjusted to any degree of heat you like.",
  "cuisine": "U.S. American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate."
    },
    {
      "position": 2,
      "text": "Rub tomatoes with oil."
    },
    {
      "position": 3,
      "text": "Cook on the preheated grill for 10 minutes; flip. Place poblanos, bell pepper, Anaheims, and jalape\u00f1o on the grill; cook 5 to 7 minutes per side."
    },
    {
      "position": 4,
      "text": "Transfer tomatoes to a bowl. Place bell pepper, poblanos, Anaheims, and jalape\u00f1o in an airtight container. Cool, about 15 minutes."
    },
    {
      "position": 5,
      "text": "Peel tomatoes. Drain. Peel and seed peppers."
    },
    {
      "position": 6,
      "text": "Combine tomatoes, peppers, onion, cilantro, vinegar, salt, and garlic in the bowl of a food processor; pulse until blended. Add liquid smoke; pulse until salsa reaches desired consistency."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

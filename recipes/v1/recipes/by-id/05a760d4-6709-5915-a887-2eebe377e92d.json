  "id": "05a760d4-6709-5915-a887-2eebe377e92d",
  "slug": "bourbon-lemonade",
  "name": "Bourbon Lemonade",
  "recipe_type": "drink",
  "brief_description": "Bourbon and brown sugar give a comforting, boozy twist to this summer-ready lemonade recipe that's easy to make ahead and serve at parties.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine hot water and brown sugar in a cocktail shaker. Stir until sugar is dissolved. Add lemon juice, bourbon, triple sec, and 1 cup of ice. Cover and shake until chilled, 15 to 20 seconds."
    },
    {
      "position": 2,
      "text": "Fill a highball glass with ice. Strain cocktail over ice and top with club soda. Stir to combine. Garnish with a lemon slice."
    }
  ],

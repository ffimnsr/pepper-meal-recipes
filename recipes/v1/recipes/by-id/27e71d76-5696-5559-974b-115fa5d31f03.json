  "id": "27e71d76-5696-5559-974b-115fa5d31f03",
  "slug": "instant-pot-teriyaki-chicken-breast",
  "name": "Instant Pot\u00ae Teriyaki Chicken Breast",
  "recipe_type": "main",
  "brief_description": "Chicken cooked in homemade teriyaki sauce is a delicious weeknight dish you can make in the Instant Pot\u00ae when you're short on time.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mix soy sauce, water, brown sugar, rice wine vinegar, mirin, sake, garlic, and pepper in a bowl to make a sauce."
    },
    {
      "position": 2,
      "text": "Place chicken in an electric pressure cooker (such as Instant Pot\u00ae). Pour sauce over chicken. Close and lock the lid. Select Meat function; set timer for 12 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 3,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove lid. An instant-read thermometer inserted into the center of the chicken should read at least 165 degrees F (74 degrees C); if not, cook chicken for another 2 to 4 minutes."
    },
    {
      "position": 4,
      "text": "Remove chicken from the pot and cut up or shred. Mix with the sauce from the pot."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

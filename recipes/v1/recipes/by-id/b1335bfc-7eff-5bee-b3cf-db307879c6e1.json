  "id": "b1335bfc-7eff-5bee-b3cf-db307879c6e1",
  "slug": "mochi-muffins-recipe-7565482",
  "name": "Mochi Muffins",
  "recipe_type": "dessert",
  "brief_description": "These yummy mochi muffins made with rice flour and coconut milk make a great breakfast, snack, or casual dessert.",
  "cuisine": "Japanese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line twelve 2 1/2-inch muffin cups with paper bake cups or grease cups generously."
    },
    {
      "position": 3,
      "text": "Whisk together rice flour, sugars, baking powder, and salt in a bowl."
    },
    {
      "position": 4,
      "text": "Whisk together coconut milk, eggs, butter, vanilla, and maple syrup in a large bowl. Add flour mixture to coconut milk mixture and stir just until combined."
    },
    {
      "position": 5,
      "text": "Divide batter between prepared muffin cups, filling nearly full. Sprinkle with sesame seeds."
    },
    {
      "position": 6,
      "text": "Bake in preheated oven until a toothpick inserted in the center comes out clean, 40 to 45 minutes. Cool in pan on a wire rack 10 minutes. Remove from pan and serve warm or cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,

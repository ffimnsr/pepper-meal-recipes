  "slug": "awesome-egg-salad-with-a-kick",
  "name": "Awesome Egg Salad with a Kick",
  "recipe_type": "salad",
  "brief_description": "Made with half mayonnaise and half sour cream, this egg salad is a bit tangy, plus it gets a nice kick from Dijon mustard and horseradish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix eggs, mayonnaise, sour cream, bacon bits, Dijon, horseradish, onion, paprika, salt, and pepper together in a bowl until well combined. Serve immediately, or refrigerate until ready to serve."
    }
  ],

  "id": "66913902-0ab9-5d59-9526-41622d42b4fe",
  "slug": "tangy-rhubarb-salsa",
  "name": "Tangy Rhubarb Salsa",
  "recipe_type": "appetizer",
  "brief_description": "Take advantage of spring\u2019s abundance of fresh rhubarb with this slightly spicy and colorful rhubarb salsa! Best made with thin stalks of rhubarb.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Stir rhubarb into a large pot of boiling water and cook for 10 seconds. Quickly drain rhubarb and rinse with cold water until cool; transfer rhubarb to a large bowl."
    },
    {
      "position": 2,
      "text": "Place red onion, green, red, and yellow bell peppers, jalape\u00f1o pepper, and cilantro into a food processor and pulse 3 or 4 times to finely chop; transfer pepper mixture to bowl with rhubarb. Stir in tomatoes."
    },
    {
      "position": 3,
      "text": "Dissolve brown sugar in Key lime juice in a bowl; lightly stir lime juice mixture into rhubarb mixture. Sprinkle salsa with salt, garlic powder, and black pepper and stir salsa again. Refrigerate at least 3 hours to blend flavors."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "320d738d-bc63-5a2e-bd40-8ae5c363e4e1",
  "slug": "coconut-curry-salmon-with-broccoli-recipe-8715339",
  "name": "Coconut Curry Salmon with Broccoli",
  "recipe_type": "main",
  "brief_description": "This coconut curry salmon with broccoli features broiled honey-curry salmon filets, simmered in a Thai red curry paste and coconut milk sauce with broccoli, for beautiful color and depth of flavor.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Line a baking sheet with aluminum foil, and brush with 1 tablespoon cooking oil. Preheat the oven\u2019s broiler."
    },
    {
      "position": 2,
      "text": "Pat salmon filets dry with paper towels and place on the prepared pan, skin side down. Brush filets with remaining 1 tablespoon oil."
    },
    {
      "position": 3,
      "text": "Season filets with curry powder, and season lightly with salt and pepper. Drizzle honey over the filets, and place under the broiler. Broil until just crisp on top, 3 to 5 minutes. Watch carefully; honey may burn easily. Remove from oven and keep warm."
    },
    {
      "position": 4,
      "text": "For coconut curry sauce, melt butter in a large nonstick skillet over medium heat. Add shallots and cook about 1 minute, then add garlic and ginger, and cook until fragrant, about 30 seconds more,"
    },
    {
      "position": 5,
      "text": "Stir in red pepper flakes and Thai red curry paste and cook about 3 minutes. Stir in coconut milk, soy sauce, and fish sauce; bring to a simmer. Add broccoli florets and cook until crisp-tender, about 3 minutes."
    },
    {
      "position": 6,
      "text": "Add salmon filets to the skillet and simmer until fish flakes easily with a fork, 3 to 5 minutes."
    },
    {
      "position": 7,
      "text": "Squeeze 1/2 lime over the skillet. Garnish with chopped chives or green onions, and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

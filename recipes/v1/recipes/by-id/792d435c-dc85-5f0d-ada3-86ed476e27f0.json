  "id": "792d435c-dc85-5f0d-ada3-86ed476e27f0",
  "slug": "insane-oven-beef-ribs",
  "name": "Easy Baked Beef Ribs",
  "recipe_type": "dessert",
  "brief_description": "This beef ribs recipe is the easiest way to cook beef short ribs in a sweet and tangy sauce in the oven for unbelievably tender ribs in just 1 hour.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Place ribs in a large pot and fill with enough water to cover. Bring to a boil and cook until meat is no longer pink, about 20 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Stir together red wine, olive oil, soy sauce, brown sugar, flour, garlic, and curry powder in a medium bowl."
    },
    {
      "position": 4,
      "text": "Coat ribs generously with sauce and arrange on a baking sheet."
    },
    {
      "position": 5,
      "text": "Roast in the preheated oven until fork-tender, about 30 minutes. Pour remaining sauce over ribs about halfway through cooking."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

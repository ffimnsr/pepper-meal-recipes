  "id": "b641dae8-4168-562e-8383-032c23ae329a",
  "slug": "white-chicken-chili-enchilada-casserole-recipe-11898775",
  "name": "White Chicken Chili Enchilada Casserole",
  "recipe_type": "main",
  "brief_description": "This white chicken chili enchilada casserole is easy to assemble and carries all the flavor of enchiladas with far less effort. Delicious comfort food at its best",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly coat a 9x13-inch baking dish with nonstick cooking spray."
    },
    {
      "position": 2,
      "text": "Stir together chicken, beans, corn, and peppers in a bowl."
    },
    {
      "position": 3,
      "text": "Whisk together enchilada sauce, sour cream, salt, and pepper in another bowl until well combined."
    },
    {
      "position": 4,
      "text": "Arrange 6 tortilla halves in the prepared baking dish to mostly cover the bottom (it’s okay to leave open spaces). Spread 1/4 the enchilada sauce mixture over the tortillas (about 2/3 cup)."
    },
    {
      "position": 5,
      "text": "Evenly top with 1/3 of the chicken mixture (about 2 cups), then sprinkle with 1/2 cup Pepper Jack cheese. Repeat this layering step 2 more times."
    },
    {
      "position": 6,
      "text": "Arrange remaining 6 tortilla halves on top. Spread with remaining 1/4 enchilada sauce mixture and sprinkle with remaining 1/2 cup Pepper Jack cheese."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until heated through and cheese is melted, 25 to 28 minutes."
    },
    {
      "position": 8,
      "text": "Let stand for 5 minutes before serving. Garnish with cilantro and avocado."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "ee397dbc-afbb-557a-89d7-963810737f8e",
  "slug": "pumpkin-cheese-bread-ii",
  "name": "Pumpkin Cream Cheese Bread",
  "recipe_type": "dessert",
  "brief_description": "This pumpkin bread has a layer of sweetened cream cheese with orange zest that pairs perfectly with the spices in the loaf for a delicious fall treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C). Lightly grease two 8x4 inch loaf pans."
    },
    {
      "position": 2,
      "text": "Combine cream cheese, 1/2 cup sugar, 1 tablespoon flour, 1 egg and orange zest in a medium bowl; beat until smooth. Set aside."
    },
    {
      "position": 3,
      "text": "Sift together 1 \u2154 cups flour, baking soda, salt, cinnamon, cloves, and pumpkin pie spice; set aside."
    },
    {
      "position": 4,
      "text": "Place pumpkin, vegetable oil, 2 eggs and 1 \u00bd cups sugar in a large bowl; beat well. Stir the pumpkin mixture into the flour mixture just until combined. Fold in the pecans if desired."
    },
    {
      "position": 5,
      "text": "Pour 1/2 of the pumpkin batter into the loaf pans. Spoon cream cheese mixture on top of this layer and then pour on the remaining batter."
    },
    {
      "position": 6,
      "text": "Bake in preheated oven until a toothpick inserted into center of the loaf comes out clean, about 60 to 70 minutes. Cool bread in pans briefly before removing to a wire rack to cool completely."
    }
  ],
  "servings": 15,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

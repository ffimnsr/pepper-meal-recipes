  "id": "e801944d-14cb-5cd3-bc83-3ed2ab43cc70",
  "slug": "maple-apple-crisp",
  "name": "Maple Apple Crisp",
  "recipe_type": "dessert",
  "brief_description": "Sliced apples are slathered in syrup, arranged in a baking dish and covered with a wonderful crumble made from brown sugar, butter and rolled oats. The crisp is then baked and served warm with scoops of rum raisin ice cream.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Place apples in an 8x8 inch baking dish. Toss apples with syrup. In a separate bowl, mix together flour, oats, sugar, and salt. Cut in butter until mixture is crumbly. Sprinkle mixture evenly over apples."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 35 minutes, until topping is golden brown. Serve warm or at room temperature."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,

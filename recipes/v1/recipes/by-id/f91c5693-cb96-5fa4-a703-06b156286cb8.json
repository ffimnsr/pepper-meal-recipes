  "slug": "buttercream-icing",
  "name": "Buttercream Icing",
  "recipe_type": "dessert",
  "brief_description": "This egg-free buttercream icing uses just 5 ingredients to achieve fantastic flavor and the perfect consistency for decorating cookies and cupcakes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat together butter, shortening, and vanilla with an electric mixer in a large bowl until creamy. Blend in confectioners' sugar, 1 cup at a time, beating well after each addition. Beat in milk; continue mixing until icing is light and fluffy. Store icing covered until ready to use."
    }
  ],

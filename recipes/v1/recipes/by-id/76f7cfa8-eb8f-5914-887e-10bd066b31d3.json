{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "76f7cfa8-eb8f-5914-887e-10bd066b31d3",
  "slug": "ultimate-creamy-chicken-enchiladas",
  "name": "Ultimate Creamy Chicken Enchiladas",
  "recipe_type": "main",
  "brief_description": "A creamy homemade sauce coats these comforting chicken enchiladas for a family-friendly dish that's easy to prepare ahead and freeze if needed.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Place chicken on a large sheet of foil and season with 1 teaspoon salt, 1/2 teaspoon chili powder, and 1/2 teaspoon cumin. Seal the foil around the chicken and place the packet on a rimmed baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until tender and no longer pink in the center, about 50 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C). Shred cooked chicken and set aside. Increase the oven temperature to 375 degrees F (190 degrees C)."
    },
    {
      "position": 4,
      "text": "While chicken cooks, prepare tortillas. Spread both sides of each tortilla lightly with butter."
    },
    {
      "position": 5,
      "text": "Heat a skillet over medium heat. Toast each tortilla, about 10 seconds on each side, and set aside."
    },
    {
      "position": 6,
      "text": "Heat oil in a large skillet over medium-high heat. Add onion, poblano pepper, and bell pepper and cook, stirring often, about 2 minutes. Add remaining salt, chili powder, and cumin and cook, stirring frequently, until veggies are very tender, about 5 minutes. Reduce heat to medium-low and stir in tomatoes and cream cheese. Cook, stirring constantly, until cheese has melted. Remove from heat and stir in sour cream and 2 cups Cheddar-Monterey Jack cheese blend. Fold in shredded chicken."
    },
    {
      "position": 7,
      "text": "Spread about 1 tablespoon refried beans down the center of a tortilla. Add about 1/4 cup chicken filling and roll up to seal. Repeat with remaining beans and filling. Pour 1/4 cup sauce in the bottom of 9x13-inch baking dish. Arrange enchiladas in a single layer over the sauce. Pour remaining enchilada sauce over the top and spread to evenly coat. Sprinkle with remaining cheese."
    },
    {
      "position": 8,
      "text": "Bake in the preheated oven until golden and bubbly, about 30 minutes. Let stand for 10 minutes before serving with desired toppings."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

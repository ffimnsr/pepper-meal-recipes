  "id": "7eda2b60-7018-5fcd-84d1-35f36ab189b2",
  "slug": "new-england-beach-pizza-recipe-8693117",
  "name": "New England Beach Pizza",
  "recipe_type": "dessert",
  "brief_description": "New England beach pizza has a thin crust, a very sweet sauce, and is topped with sprinkle of mozzarella and full slices of provolone, a good snack for a day in sun, sand, and surf.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 475 degrees F (245 degrees C)."
    },
    {
      "position": 2,
      "text": "Heat olive oil in a saucepan over medium heat; saut\u00e9 garlic until fragrant, about 30 seconds. Stir in tomato paste, and cook, stirring, for another 30 seconds. Add marinara, water, sugar, oregano, and chili flakes. Bring to a simmer, and cook, stirring occasionally, for 10 to 15 minutes. Taste for seasoning and adjust if need be. Turn off heat and reserve."
    },
    {
      "position": 3,
      "text": "Roll and stretch dough into a rectangle about 15x10 inches. Rub a 13x18-inch half sheet pan with olive oil and transfer dough on. Push, pull, and stretch dough to cover pan. If dough pulls back from the edge, let it rest for a few minutes, and then continue shaping."
    },
    {
      "position": 4,
      "text": "Top dough with a light layer of sauce (the recipe will make extra sauce). Top with mozzarella cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the crust is cooked through, and the bottom is golden brown, 15 to 20 minutes."
    },
    {
      "position": 6,
      "text": "As soon as pizza comes out of the oven, top with slices of provolone. Pizza can be served immediately, or placed back in the oven for a few minutes to melt provolone even more."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

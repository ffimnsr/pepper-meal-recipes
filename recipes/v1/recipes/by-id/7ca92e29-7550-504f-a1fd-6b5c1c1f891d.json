  "id": "7ca92e29-7550-504f-a1fd-6b5c1c1f891d",
  "slug": "easy-lemon-mousse",
  "name": "Easy Lemon Mousse",
  "recipe_type": "dessert",
  "brief_description": "This lemon mousse recipe is easy to make with whipped cream and lemon curd. It comes together in minutes for an elegant dessert but needs to chill for at least 1 hour.",
  "cuisine": "British",
  "instructions": [
    {
      "position": 1,
      "text": "Beat heavy cream in a chilled glass or metal bowl with an electric mixer until frothy. Add confectioners' sugar gradually, continuing to beat until stiff peaks form, starting on low speed and increasing to high speed, for about 2 minutes; set aside."
    },
    {
      "position": 2,
      "text": "Beat cream cheese in a bowl with an electric mixer until lump free, 1 to 2 minutes. Add the lemon curd and vanilla extract and mix until smooth and creamy, 1 to 2 minutes."
    },
    {
      "position": 3,
      "text": "Fold whipped cream into the lemon mixture until just combined. Divide mousse equally among 4 dessert dishes or ramekins. Chill for at least 1 hour before serving."
    },
    {
      "position": 4,
      "text": "Garnish with fresh berries and mint leaves."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

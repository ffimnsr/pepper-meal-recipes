  "id": "1c01e69b-fe74-5077-9b3e-8f95f2a1bfd4",
  "slug": "savory-mac-and-cheese-cake-recipe-7486525",
  "name": "Savory Mac and Cheese Cake",
  "recipe_type": "dessert",
  "brief_description": "Chef John\u2019s savory mac and cheese \u201ccake\u201d is the perfect treat for that friend who is not into sweets. A new way to enjoy macaroni and cheese with a delicious golden crust in every bite!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Generously grease an 8-inch or a 9-inch cake pan with butter. Cut a round piece of parchment paper to fit the bottom."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 3,
      "text": "Combine yogurt, eggs, salt, pepper, sugar, and cayenne in a bowl and whisk thoroughly. Add flour, and 5 ounces of Cheddar cheese, saving 1 ounce for the top. Add green onions, and mix thoroughly with a spatula."
    },
    {
      "position": 4,
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 30 seconds shorter than indicated in package directions. Drain into a colander, reserving 1/4 cup of cooking water. Do not let macaroni sit and get dry."
    },
    {
      "position": 5,
      "text": "Add melted butter to the batter, followed by the just drained macaroni, and reserved 1/4 cup of pasta water (not shown in the video). Mix thoroughly with a spatula, and then transfer into the prepared cake pan. Smooth out the surface, and top with remaining 1 ounce Cheddar cheese, and a few shakes of cayenne."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until cheese is lightly browned and cake is set, about 25 minutes. Serve hot, warm, or at room temperature garnished with green onion."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

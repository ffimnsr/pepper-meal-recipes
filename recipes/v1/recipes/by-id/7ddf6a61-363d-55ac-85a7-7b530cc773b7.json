  "id": "7ddf6a61-363d-55ac-85a7-7b530cc773b7",
  "slug": "rinnys-cavatappi-salad",
  "name": "Rinny's Cavatappi Salad",
  "recipe_type": "salad",
  "brief_description": "Rinny's cavatappi salad recipe is a classic macaroni salad made with cavatappi, tuna, ham, bell pepper, Cheddar, and a creamy dressing with pickle juice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook cavatappi in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain, run under cold water, and drain again. Set aside until completely cooled."
    },
    {
      "position": 2,
      "text": "Combine salad dressing, sour cream, pickle juice, sugar, Dijon mustard, salt, garlic salt, and black pepper in a large bowl. Stir in celery, onion, bell pepper, Cheddar cheese, ham, eggs, and tuna, then stir in cooled cavatappi until well combined. Refrigerate for at least 3 hours, stirring occasionally."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,

  "id": "1498f719-62c7-5e5a-8b2f-a0d14432ca8c",
  "slug": "zucchini-raspberry-bread",
  "name": "Zucchini-Raspberry Bread",
  "recipe_type": "dessert",
  "brief_description": "A simple zucchini bread recipe with walnuts is flavored with cinnamon, nutmeg, and lemon zest, as well as an unexpected addition of fresh raspberries.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan."
    },
    {
      "position": 2,
      "text": "Combine flour, cinnamon, and nutmeg in a large bowl. Combine sugar, zucchini, vegetable oil, egg, and lemon zest in a separate bowl; stir into flour mixture. Gently fold in raspberries and walnuts; pour into the prepared loaf pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until golden brown, 30 to 35 minutes, then cover with aluminum foil. Continue baking until a toothpick inserted into the center comes out clean, about 20 minutes. Cool in the pan for 10 minutes before transferring to a wire rack to cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

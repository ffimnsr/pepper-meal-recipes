  "name": "Pineapple Cranberry Relish",
  "recipe_type": "dessert",
  "brief_description": "This sweet, tangy and crunchy relish combines the zesty flavors of pineapple and cranberries with tart walnuts and sweet strawberries. A delightful accompaniment to holiday meals!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a large bowl, mix together the pineapple, cranberry sauce, walnuts and strawberries. Cover and chill overnight before serving."
    }

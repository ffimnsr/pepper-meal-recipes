  "id": "487010cf-7cf8-5b0e-ba3b-61e9e8851b80",
  "slug": "jalapeno-and-cucumber-margarita",
  "name": "Cucumber Jalape\u00f1o Margarita",
  "recipe_type": "drink",
  "brief_description": "This cucumber jalape\u00f1o margarita recipe combines the spicy flavor of jalape\u00f1o chiles with refreshing cucumber and lime for a chilled margarita cocktail.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine tequila, lime juice, orange liqueur, and simple syrup in a pitcher with a lid; add jalape\u00f1o and 4 thin cucumber slices. Refrigerate until chilled, at least 1 hour."
    },
    {
      "position": 2,
      "text": "Meanwhile, run lime wedges along rims of 4 pint glass; pour salt onto a flat plate. Dip moistened rims into salt to coat."
    },
    {
      "position": 3,
      "text": "Fill prepared glasses with ice; pour chilled margarita over top. Garnish each drink with 1 cucumber slice."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

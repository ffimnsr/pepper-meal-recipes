  "id": "eaf14e34-553c-5a9b-842c-ebc4398c47c4",
  "slug": "mini-sweet-potato-pies",
  "name": "Mini Sweet Potato Pies",
  "recipe_type": "appetizer",
  "brief_description": "Cute, bite-sized, mini sweet potato pies. Always a winner for the holidays and easy enough to make! Great for holiday dinner parties or sweet appetizers!",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place sweet potatoes in a saucepan with just enough water to cover. Bring to a boil; cook until fork-tender, about 5 minutes. Drain and mash sweet potatoes with a fork or potato masher."
    },
    {
      "position": 3,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Divide pie crust evenly into 24 pieces; form into small balls. Press crusts into the cups of two 12-cup mini muffin tins. Set aside."
    },
    {
      "position": 4,
      "text": "Pur\u00e9e mashed sweet potatoes, evaporated milk, egg whites, white sugar, brown sugar, cinnamon, nutmeg, and cloves in a blender or food processor until smooth. Spoon about 1 tablespoon sweet potato filling into each pie shell."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a mini pie comes out clean, about 10 minutes. Cool in the tins set on a wire rack. Garnish each mini pie with a cranberry half before serving."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "c430ee69-c999-507f-9a29-a01894ca2144",
  "slug": "slow-cooker-buffalo-chicken-sandwiches",
  "name": "Slow Cooker Buffalo Chicken Sandwiches",
  "recipe_type": "main",
  "brief_description": "This crockpot Buffalo chicken recipe is super easy to prepare. Perfect for spicy sandwiches that will please anyone who loves Buffalo chicken wings!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place chicken breasts into the slow cooker; pour in 3/4 of the wing sauce and ranch dressing mix."
    },
    {
      "position": 3,
      "text": "Cover and cook on Low for 6 to 7 hours."
    },
    {
      "position": 4,
      "text": "Shred chicken in the cooker with two forks. Stir in butter."
    },
    {
      "position": 5,
      "text": "Pile shredded chicken and sauce onto hoagie rolls. Serve with remaining Buffalo sauce."
    },
    {
      "position": 6,
      "text": "Serve and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 360,
  "preparation_time_minutes": 10,

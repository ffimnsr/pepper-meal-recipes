  "id": "4b7e1430-a848-5253-a7d5-1c979f646b88",
  "slug": "roasted-eggplant-and-mushrooms",
  "name": "Roasted Eggplant and Mushrooms",
  "recipe_type": "side",
  "brief_description": "Eggplant, mushrooms, and zucchini are roasted together with a touch of tomato for a surprisingly robust side dish or sandwich filling.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 450 degrees F (230 degrees C)."
    },
    {
      "position": 2,
      "text": "Place eggplant, zucchini, onion and mushrooms in a 2 quart casserole dish. In a small bowl combine the tomato paste with the water, and stir in garlic, basil, salt and pepper. Pour over the vegetables and mix well."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 45 minutes, or until eggplant is tender, stirring occasionally. Add water as necessary if vegetables begin to stick; however, vegetables should be fairly dry, with slightly browned edges."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "47598f97-294e-54d0-b298-5c0269df062c",
  "slug": "jumbo-shrimp-and-asparagus",
  "name": "Jumbo Shrimp and Asparagus",
  "recipe_type": "main",
  "brief_description": "Large shrimp sauteed with asparagus, flavored with ginger, soy sauce and sherry.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "In a medium saucepan, bring two cups of water to a boil. Cook asparagus in boiling water for 3 minutes. Drain, reserving 2 tablespoons of liquid."
    },
    {
      "position": 2,
      "text": "Heat the oil in a skillet over medium-high heat. Saute the shrimp pieces until the color changes, about 3 to 5 minutes. Stir in asparagus with reserved liquid , and season with ginger, soy sauce, sugar, sherry and salt to taste. Continue to cook for 5 more minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

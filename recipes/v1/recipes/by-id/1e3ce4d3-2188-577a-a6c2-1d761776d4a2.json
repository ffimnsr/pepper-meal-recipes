  "id": "1e3ce4d3-2188-577a-a6c2-1d761776d4a2",
  "slug": "taco-in-a-bag",
  "name": "Taco in a Bag",
  "recipe_type": "appetizer",
  "brief_description": "Taco in a bag, or walking tacos, are easy to put together and fun to eat! Enjoy your favorite taco fillings loaded into a corn chip bag and eaten with a fork.",
  "cuisine": "Mexican Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Cook and stir ground beef in a large skillet over medium heat until browned and crumbly, 7 to 10 minutes. Drain excess oil. Mix in water and taco seasoning. Bring to a boil, then reduce the heat and simmer for 5 minutes, stirring occasionally."
    },
    {
      "position": 3,
      "text": "Gently crush corn chips in the sealed bags. Snip one top and one bottom corner off each bag, then cut open along the side edge."
    },
    {
      "position": 4,
      "text": "Spoon equal amounts of beef, lettuce, Cheddar, tomato, sour cream, and salsa into each bag on top of crushed chips."
    },
    {
      "position": 5,
      "text": "Serve in the bag and eat using a fork. Enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "slug": "hawaiian-cole-slaw",
  "name": "Hawaiian Coleslaw",
  "recipe_type": "salad",
  "brief_description": "A tropical Hawaiian coleslaw made with crushed pineapple, onion, and coleslaw mix tossed in a creamy dressing for a sweet and tangy side dish.",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Mix coleslaw mix, pineapple, and onion together in a bowl."
    },
    {
      "position": 3,
      "text": "Whisk mayonnaise, vinegar, brown sugar, cilantro, salt, and pepper together in a bowl until dressing is smooth."
    },
    {
      "position": 4,
      "text": "Pour dressing over coleslaw mixture and toss to coat. Refrigerate until ready to serve."
    }
  ],
  "servings": 16,

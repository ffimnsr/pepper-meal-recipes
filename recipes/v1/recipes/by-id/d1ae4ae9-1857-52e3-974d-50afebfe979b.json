  "id": "d1ae4ae9-1857-52e3-974d-50afebfe979b",
  "slug": "marbled-chocolate-pumpkin-pie",
  "name": "Marbled Chocolate Pumpkin Pie",
  "recipe_type": "dessert",
  "brief_description": "Vallery Lomas was inspired by her favorite pumpkin loaf for this chocolate-y twist on our basic pumpkin pie.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Fit pie crust into a 9-inch pie dish and place it on a baking sheet."
    },
    {
      "position": 2,
      "text": "Melt the chocolate in the microwave or on the top of a double boiler. To melt the finely-chopped chocolate in the microwave, melt it in a microwave-proof bowl in 30-second intervals, stirring between intervals. Take care not to overheat, which will cause the chocolate to burn and become grainy. Set the melted chocolate aside while preparing the remainder of the pie filling."
    },
    {
      "position": 3,
      "text": "Combine pumpkin puree, condensed milk, eggs, and pumpkin pie spice in a large bowl; mix until combined."
    },
    {
      "position": 4,
      "text": "Measure \u00bd cup of the pumpkin pie filling and stir it into the bowl of melted chocolate until smooth."
    },
    {
      "position": 5,
      "text": "Pour the remaining pie filling into the pie shell. Dollop the chocolate pie filling on top. Use a toothpick or butter knife to create a marbled effect by swirling in and out of each of the dollops."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven for 15 minutes. Reduce heat to 350 degrees F (175 degrees C) and continue to bake until filling is set, 35 to 40 minutes.Remove from the oven, set on a wire rack, and cool completely before serving."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

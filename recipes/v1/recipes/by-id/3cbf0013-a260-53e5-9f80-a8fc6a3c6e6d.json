  "id": "3cbf0013-a260-53e5-9f80-a8fc6a3c6e6d",
  "slug": "scottish-shortbread-gluten-free",
  "name": "Scottish Shortbread, Gluten-Free",
  "recipe_type": "dessert",
  "brief_description": "Almond, brown rice, and sorghum flours are spiced with cinnamon, cardamom, ginger, and allspice in this gluten-free shortbread.",
  "cuisine": "Scottish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place almond flour, brown rice flour, sorghum flour, sugar, cinnamon, allspice, cardamom, ginger, and salt together in a large resealable bag; seal and shake well to combine."
    },
    {
      "position": 3,
      "text": "Mix butter and flour mixture together in a large bowl with an electric mixer until well combined."
    },
    {
      "position": 4,
      "text": "Roll dough into walnut-size balls and place 2 inches apart onto ungreased baking sheets; flatten balls slightly."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until edges are golden brown, about 27 minutes. Cool in the pan for 5 minutes before transferring to a wire rack to cool completely."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 27,

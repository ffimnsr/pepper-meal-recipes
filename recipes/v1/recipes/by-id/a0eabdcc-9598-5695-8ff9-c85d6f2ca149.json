  "id": "a0eabdcc-9598-5695-8ff9-c85d6f2ca149",
  "slug": "tempeh-kabobs-with-moroccan-couscous",
  "name": "Tempeh Kabobs with Moroccan Couscous",
  "recipe_type": "main",
  "brief_description": "Soaked in a delectable honey-soy marinade and paired with grilled vegetables, these kabobs will please both meat eaters and vegetarians.",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Place tempeh, mushrooms, eggplant, red bell pepper, and cherry tomatoes in a large resealable plastic bag. In a mixing bowl, whisk together olive oil, soy sauce, teriyaki sauce, and honey; season with 1 tablespoon ginger, 1 tablespoon garlic, and salt and pepper to taste. Pour mixture over tempeh and veggies, seal, and shake to coat. Refrigerate for 2 hours."
    },
    {
      "position": 2,
      "text": "Preheat grill for medium-high heat. Thread tempeh and veggies on skewers. Reserve remaining marinade."
    },
    {
      "position": 3,
      "text": "Grill skewers, turning often to make sure everything is cooked evenly. These can also be done in the broiler."
    },
    {
      "position": 4,
      "text": "While grilling kabobs, combine vegetable stock, 1 tablespoon grated ginger, cumin, and salt. Bring to a light boil. Stir in couscous, raisins, and garbanzo beans; cover, and remove from heat. Let sit for five minutes, or until fluffy. Just before serving, squeeze lemon over couscous and stir. Serve kabobs with reserved marinade."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "2d63aa75-c084-5a09-b3cb-6957902dd4d5",
  "slug": "parmesan-pesto-roasted-cauliflower-recipe-8730242",
  "name": "Parmesan Pesto Roasted Cauliflower",
  "recipe_type": "side",
  "brief_description": "This Parmesan pesto roasted cauliflower\u2014florets tossed with vibrant basil pesto and freshly-grated Parmesan cheese\u2014 are a flavorful, crispy side dish that's easy to prepare and perfect for any meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "In a large bowl, toss the cauliflower florets with olive oil, salt, and pepper until evenly coated. Spread cauliflower evenly in a single layer on the prepared baking sheet. Set the bowl aside."
    },
    {
      "position": 3,
      "text": "Roast in the preheated oven until golden and crispy on the edges, 25 to 30 minutes, turning halfway through cooking time."
    },
    {
      "position": 4,
      "text": "Transfer hot cauliflower back to the bowl and toss with pesto and Parmesan cheese. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

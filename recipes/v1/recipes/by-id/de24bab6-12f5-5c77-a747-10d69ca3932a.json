{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "de24bab6-12f5-5c77-a747-10d69ca3932a",
  "slug": "the-original-donair-from-the-east-coast-of-canada",
  "name": "The Original Donair From the East Coast of Canada",
  "recipe_type": "dessert",
  "brief_description": "Try this homemade donair recipe featuring thick slices of spicy beef topped with a creamy, sweet, and tangy sauce wrapped in pita bread.",
  "cuisine": "Canadian",
  "instructions": [
    {
      "position": 1,
      "text": "Make the meatloaf: Mix ground beef, cayenne pepper, black pepper, onion powder, garlic powder, salt, paprika, and oregano together in a large bowl until combined. Shape mixture into a loaf and place on a baking tray; cover with plastic wrap and let rest in the refrigerator overnight."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Bake meatloaf in the preheated oven until no longer pink in the center, about 30 minutes, turning the loaf over halfway through cooking. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C). Allow the meatloaf to cool so it holds together for slicing."
    },
    {
      "position": 4,
      "text": "Meanwhile, make the sauce: Stir evaporated milk and sugar together in a bowl until sugar is dissolved; add vinegar, 1 teaspoon at a time, to taste. Stir in garlic powder. Refrigerate sauce until ready to serve."
    },
    {
      "position": 5,
      "text": "Slice meatloaf into 1/4-inch thick slices; brown each slice in a skillet over medium heat until browned and crisp, about 5 minutes per side."
    },
    {
      "position": 6,
      "text": "Sprinkle pita bread rounds with a little water; warm briefly in a dry skillet over medium heat."
    },
    {
      "position": 7,
      "text": "To serve: Place several slices of meatloaf into each warmed pita bread; spoon about 2 tablespoons of sauce on top and roll into a cone shape. Wrap each donair in aluminum foil to keep the sauce from dripping out; serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,

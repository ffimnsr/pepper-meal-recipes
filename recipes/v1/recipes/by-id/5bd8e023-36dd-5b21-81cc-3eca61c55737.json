  "id": "5bd8e023-36dd-5b21-81cc-3eca61c55737",
  "slug": "smashed-aloo-gobi-style-naan-recipe-11998244",
  "name": "Smashed Aloo Gobi-Style Naan",
  "recipe_type": null,
  "brief_description": "Aloo gobi is a fragrant potato and cauliflower curry originating from North India. Re-create the same flavors in the form of a folded vegetarian flatbread, smashed and sizzled to crispy perfection.",
  "cuisine": "American Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Cook mashed potatoes and cauliflower according to package directions."
    },
    {
      "position": 2,
      "text": "Heat 1 tablespoon oil in a large skillet over medium heat. Add onion; cook, stirring occasionally, until tender, 2 to 3 minutes. Add ginger and garlic; cook and stir until fragrant, about 1 minute. Stir in 3 tablespoons water, the tomato paste, garam masala, salt, and cayenne. Add cooked cauliflower to skillet. Cook and stir until cauliflower is well coated, adding additional water as needed, 2 minutes. Use a fork to smash cauliflower into smaller pieces."
    },
    {
      "position": 3,
      "text": "Spoon mashed potatoes onto naan, spreading to naan edges in an even layer. Evenly top with cauliflower mixture. Fold in half from a short end."
    },
    {
      "position": 4,
      "text": "Heat remaining 1 tablespoon oil on a griddle or in a very large skillet over medium heat. Working in batches and adding more oil if needed, arrange filled naan on griddle. Weight down sandwiches with a large skillet. Cook, turning halfway through, until golden brown on both sides, 4 to 6 minutes. Stir together yogurt and chutney in a small bowl; serve with sandwiches. If you like drizzle with warmed chutney and garnish with cilantro."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

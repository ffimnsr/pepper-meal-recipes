  "id": "b62f311a-2da7-5a39-afc1-866e0f70ed32",
  "slug": "macaroons",
  "name": "Macaroons",
  "recipe_type": "dessert",
  "brief_description": "Macaroon recipes rely on whipped egg whites for light, airy texture. They strike a delicate balance between crisp edges and a tender, chewy center.",
  "cuisine": "Kosher",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a baking sheet."
    },
    {
      "position": 2,
      "text": "Beat egg whites and salt together in a small glass, metal, or ceramic bowl using an electric mixer until soft peaks form. Add sugar, 1 tablespoon at a time, beating at high speed until stiff peaks form; continue to beat until glossy. Fold coconut into egg white mixture."
    },
    {
      "position": 3,
      "text": "Drop teaspoonfuls of egg white-coconut mixture onto the prepared baking sheet, spaced about 2 inches apart."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven until edges are light golden, about 12 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

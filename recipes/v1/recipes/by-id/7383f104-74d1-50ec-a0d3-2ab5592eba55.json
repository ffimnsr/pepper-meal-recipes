  "id": "7383f104-74d1-50ec-a0d3-2ab5592eba55",
  "slug": "5-ingredient-creamy-chicken-enchilada-casserole-recipe-11949553",
  "name": "5-Ingredient Creamy Chicken Enchilada Casserole",
  "recipe_type": "main",
  "brief_description": "This creamy chicken enchilada casserole comes together with just five ingredients and a genius shortcut. Rotisserie chicken, salsa verde, and jarred Alfredo sauce make it rich, flavorful, and perfect for feeding a crowd.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine Alfredo sauce and salsa verde in a bowl."
    },
    {
      "position": 3,
      "text": "Arrange eight tortilla halves in the prepared baking dish, to mostly cover the bottom of the dish."
    },
    {
      "position": 4,
      "text": "Spread 1/3 of cooked chicken evenly over the tortillas. Pour 1/3 of Alfredo mixture on top of cooked chicken, then sprinkle with 2/3 cup of Monterey Jack cheese. Repeat the layers 2 more times, ending with the remaining cheese on top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until heated through and the cheese is melted, about 25 minutes."
    },
    {
      "position": 6,
      "text": "Let stand 5 minutes before serving. Garnish with fresh cilantro and tomatoes, if desired. Recipe developed by Ashley Sandoval"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

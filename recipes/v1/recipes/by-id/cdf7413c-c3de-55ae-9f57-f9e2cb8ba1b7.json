  "id": "cdf7413c-c3de-55ae-9f57-f9e2cb8ba1b7",
  "slug": "egg-free-dairy-free-nut-free-cake",
  "name": "Egg-Free, Dairy-Free, Nut-Free Cake",
  "recipe_type": "dessert",
  "brief_description": "This egg-free cake recipe is made with chocolate chips, cocoa powder, oil, vinegar, and water for an easy one-bowl dessert that happens to be vegan.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x8-inch baking pan."
    },
    {
      "position": 2,
      "text": "Combine flour, sugar, cocoa powder, baking soda, and salt in a large bowl; mix well using a fork. Stir in oil, vinegar, and vanilla until thoroughly moistened. Pour in cold water and mix until batter is smooth. Stir in chocolate chips. Pour batter into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 30 to 35 minutes. Cool on a wire rack."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "38d578b9-5e2c-5004-ab8e-df10907e2007",
  "slug": "french-bread-pizza-recipe-7971911",
  "name": "French Bread Pizza",
  "recipe_type": "main",
  "brief_description": "French bread pizza is easier than making homemade pizza dough and faster than calling out for delivery. Just pick up a loaf of fresh French bread and use your favorite toppings for a quick-and-easy dinner.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with aluminum foil or parchment paper for easy cleanup, and set aside."
    },
    {
      "position": 2,
      "text": "Using a serrated knife, cut the French bread in half, and then slice in half lengthwise, parallel to the cutting board, to make 4 pizzas. Lightly brush the cut sides of the bread with olive oil and place on the baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 4 minutes."
    },
    {
      "position": 4,
      "text": "Remove from the oven; spread pizza sauce over each piece of bread, and sprinkle with mozzarella cheese. Finish by adding your favorite toppings, pressing in slightly to adhere."
    },
    {
      "position": 5,
      "text": "Return to the oven and bake until cheese is melted and starting to brown, 10 to 13 minutes. Serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

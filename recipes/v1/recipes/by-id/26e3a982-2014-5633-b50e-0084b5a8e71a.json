  "id": "26e3a982-2014-5633-b50e-0084b5a8e71a",
  "slug": "roasted-garlic-parmesan-mashed-potatoes",
  "name": "Roasted Garlic Parmesan Mashed Potatoes",
  "recipe_type": "dessert",
  "brief_description": "It is the sweetness of the roasted garlic that makes these mashed potatoes so delicious.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Place garlic cloves in a small baking dish. Drizzle with olive oil, cover, and bake 45 minutes, or until golden brown."
    },
    {
      "position": 3,
      "text": "Bring a large pot of lightly salted water to boil. Add potatoes, and cook until tender but firm. Drain, and transfer to a large mixing bowl."
    },
    {
      "position": 4,
      "text": "Place roasted garlic, milk, Parmesan cheese, and butter into the bowl with the potatoes. Season with salt and pepper. Beat to desired consistency with an electric mixer."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

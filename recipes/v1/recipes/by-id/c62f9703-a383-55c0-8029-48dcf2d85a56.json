  "id": "c62f9703-a383-55c0-8029-48dcf2d85a56",
  "slug": "big-rays-mexican-monkey-bread",
  "name": "Big Ray\u2019s Mexican Monkey Bread",
  "recipe_type": "appetizer",
  "brief_description": "This cheesy pull-apart bread is made with refrigerated biscuit dough and jalapeno peppers for an easy spicy treat.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Prepare a 9x5-inch loaf pan with cooking spray."
    },
    {
      "position": 2,
      "text": "Pour melted butter into a small bowl. Dip each piece of biscuit dough in melted butter to coat."
    },
    {
      "position": 3,
      "text": "Arrange enough of the biscuit dough pieces in the bottom of the loaf pan to form a single layer; top with 1/2 cup Cheddar cheese, 1/4 cup pepper slices, and 1/4 teaspoon parsley. Repeat layering once and top with remaining biscuit dough pieces, pepper slices, and parsley flakes."
    },
    {
      "position": 4,
      "text": "Mix remaining 1/4 cup Cheddar cheese and mozzarella cheese together in a bowl; spread over the top of the ingredients to cover."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven until golden brown, 40 to 45 minutes. Cool bread in pan for 5 minutes before inverting onto a plate to serve."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,

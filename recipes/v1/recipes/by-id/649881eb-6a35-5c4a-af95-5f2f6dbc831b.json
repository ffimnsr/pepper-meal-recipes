  "slug": "fresh-guacamole",
  "name": "Fresh Guacamole",
  "recipe_type": "appetizer",
  "brief_description": "This guacamole recipe is fresh and zesty from avocado, Roma tomato, red onion, serrano chile, Worcestershire sauce, hot sauce, cilantro, and lime juice.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Combine avocado, tomato, onion, serrano, cilantro, Worcestershire sauce, salt, black pepper, garlic powder, and hot sauce in a bowl; pour lime juice over top. Serve immediately."
    }
  ],
  "servings": 2,

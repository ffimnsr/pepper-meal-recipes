  "id": "9e4bba9f-7cf2-5b70-ab32-6114ee448d05",
  "slug": "crunchy-curried-kale",
  "name": "Crunchy Curried Kale",
  "recipe_type": "side",
  "brief_description": "Crunchy curried kale with bits of tempeh, avocado, and corn tortillas is a tasty and hearty way to introduce your friends and family to vegetarian eating.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large skillet over medium-low heat; add kale and curry powder. Cook and stir kale mixture in the hot oil until wilted, about 5 minutes. Add avocados, tempeh, and tortillas; cook and stir until dry, golden brown, and crunchy, 30 to 40 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,

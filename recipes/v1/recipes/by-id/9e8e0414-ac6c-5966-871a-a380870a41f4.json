  "id": "9e8e0414-ac6c-5966-871a-a380870a41f4",
  "slug": "cinnamon-sweet-potato-slices",
  "name": "Cinnamon Sweet Potato Slices",
  "recipe_type": "dessert",
  "brief_description": "Wonderful baked sweet potato slices with a perfect blend of flavors from cinnamon, sugar, and butter. This makes an easy side to go with any meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a baking sheet with cooking spray."
    },
    {
      "position": 2,
      "text": "Arrange sweet potato slices on the baking sheet. Brush with 1/2 of the butter. Mix sugar and cinnamon in a small bowl and sprinkle 1/2 over the potatoes."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 15 minutes. Turn, brush with remaining butter, and sprinkle with remaining cinnamon and sugar. Continue baking until tender, about 15 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

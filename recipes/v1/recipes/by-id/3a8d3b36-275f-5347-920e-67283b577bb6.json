  "id": "3a8d3b36-275f-5347-920e-67283b577bb6",
  "slug": "easy-lemon-cake-mix-brownies-recipe-11703692",
  "name": "Easy Lemon Cake Mix Brownies",
  "recipe_type": "dessert",
  "brief_description": "These easy lemon cake mix brownies are frosted with a sweet-tart, lemony icing. They're easy to make and delightfully fresh.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Lightly grease an 11x7-inch baking dish."
    },
    {
      "position": 2,
      "text": "Mix lemon cake mix, canola oil, eggs, and vanilla extract in a bowl until well combined. Spread the mixture in the prepared dish in an even layer."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick comes out clean when inserted into the center, 16 to 18 minutes. Allow brownies to cool for about 20 minutes."
    },
    {
      "position": 4,
      "text": "Meanwhile, combine 1 1/2 cups confectioner\u2019s sugar, lemon zest, and lemon juice in a bowl; whisk until smooth; add more sugar as needed for a smooth, spreadable glaze. Stir in salt."
    },
    {
      "position": 5,
      "text": "Spread lemon glaze evenly over brownies and let stand until completely cooled. Refrigerate until ready to serve; cut into 12 squares."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "d84b50a3-8f34-5355-82ab-e9ab1d4dd785",
  "slug": "chocolate-raspberry-blintzes",
  "name": "Chocolate Raspberry Blintzes",
  "recipe_type": "dessert",
  "brief_description": "Slices of white bread replace pancakes in this quick and easy recipe for blintzes stuffed with berry cream cheese and Nutella\u00ae spread.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix cream cheese, chocolate-hazelnut spread, berry cream cheese, milk, and vanilla extract together in a bowl."
    },
    {
      "position": 3,
      "text": "Pour melted butter into a shallow bowl."
    },
    {
      "position": 4,
      "text": "Combine sugar and cinnamon in a separate shallow bowl."
    },
    {
      "position": 5,
      "text": "Flatten bread slices out on a work surface. Spread cream cheese mixture over each slice. Roll up each slice. Dip rolls in melted butter; coat with cinnamon sugar. Arrange seam-side down in a baking dish."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until lightly golden, 15 to 20 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

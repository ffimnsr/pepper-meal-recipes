  "id": "f05de5ec-562d-5d49-911a-3725f8e60e18",
  "slug": "pork-broccoli-and-rice-casserole",
  "name": "Pork, Broccoli and Rice Casserole",
  "recipe_type": "main",
  "brief_description": "I made this pork and broccoli dish one night when I had leftover pork roast cooked in my slow cooker and frozen. Pork, broccoli, and rice with a hint of curry. It's very homey and easy to make ahead of time.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring water and rice to a boil in a saucepan over medium-high heat. Reduce heat to low, cover, and simmer until rice is tender, about 20 minutes."
    },
    {
      "position": 3,
      "text": "Combine pork, cooked rice, and broccoli in a large bowl. Stir in soup and mayonnaise; season with pepper and curry powder. Transfer to a 9x13-inch baking dish; cover with aluminum foil."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until evenly heated through, 45 to 50 minutes. Remove foil for the last 5 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

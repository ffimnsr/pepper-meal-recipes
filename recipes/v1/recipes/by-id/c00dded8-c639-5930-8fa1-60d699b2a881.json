  "id": "c00dded8-c639-5930-8fa1-60d699b2a881",
  "slug": "vegan-pumpkin-pie",
  "name": "Vegan Pumpkin Pie",
  "recipe_type": "dessert",
  "brief_description": "This vegan recipe for pumpkin pie skips the tofu but still yields a sweet and creamy dessert you can make ahead for your Thanksgiving feast.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine almond milk, sugar, and arrowroot powder in a blender; blend until sugar and arrowroot are completely dissolved. Add pumpkin puree, pumpkin pie spice, and salt; blend until smooth. Pour into the pie shell. Cover edges of the pie shell with aluminum foil."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until center is set, about 40 minutes."
    },
    {
      "position": 4,
      "text": "Cool pie to room temperature, about 1 hour. Refrigerate until firm, 8 hours to overnight."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

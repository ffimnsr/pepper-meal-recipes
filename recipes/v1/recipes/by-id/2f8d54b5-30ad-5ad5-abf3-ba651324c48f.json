  "id": "2f8d54b5-30ad-5ad5-abf3-ba651324c48f",
  "slug": "christmas-tree-cheese-ball-recipe-8762179",
  "name": "Christmas Tree Cheese Ball",
  "recipe_type": "appetizer",
  "brief_description": "This Christmas tree cheese ball is quickly shaped, and easily decorated. Pineapple flavored cream cheese spread forms the tree, with rosemary sprigs for branches. Raspberries, pistachios, and star sprinkles make the red and green ornaments, with cheese cube presents arrayed below.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Spray one side of a 12-inch square piece of plastic wrap with cooking spray and place plastic, sprayed side up, on a work surface."
    },
    {
      "position": 2,
      "text": "Remove cream cheese spread from containers, and stack on the sprayed plastic. Lift plastic and place on spread, and mold into a cone shape using your hands."
    },
    {
      "position": 3,
      "text": "Carefully slide cream cheese cone onto a decorative plate."
    },
    {
      "position": 4,
      "text": "Dot cone with fresh raspberries, with the holes facing out. Fill each hole with a shelled pistachio, and dot the cone with pistachios. Make a row of raspberries around the bottom of the cone, gently pushing in, toward the center of the cone."
    },
    {
      "position": 5,
      "text": "Insert several fresh rosemary sprigs around the cone to imitate tree branches. Decorate with star-shaped baking sprinkle \u201cornaments,\u201d randomly placed."
    },
    {
      "position": 6,
      "text": "Use cheese cubes around base of the cone to simulate packages, and add a few red wax-wrapped mini cheeses. Serve immediately, with crackers."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

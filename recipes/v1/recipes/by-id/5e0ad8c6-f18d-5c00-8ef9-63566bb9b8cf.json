  "id": "5e0ad8c6-f18d-5c00-8ef9-63566bb9b8cf",
  "slug": "caldereta-filipino-beef-stew",
  "name": "Caldereta (Filipino Beef Stew)",
  "recipe_type": "soup",
  "brief_description": "A favorite hearty stew from the Philippines is traditionally made of goat meat, but this sweet and savory version has beef stew meat instead.",
  "cuisine": "Filipino Fusion",
  "instructions": [
    {
      "position": 1,
      "text": "Heat vegetable oil in a large pot over medium heat. Sprinkle beef with salt and black pepper and brown in the hot oil with garlic, about 10 minutes. Pour in water, pineapple juice, onion, tomato sauce, and tomato paste. Bring to a boil, turn heat to low, and simmer until beef is almost tender, 35 to 45 minutes."
    },
    {
      "position": 2,
      "text": "Stir potatoes, red bell pepper, carrot, mini sausages, pineapple chunks with their juice, olives, and bay leaves into the stew. Bring back to a boil and simmer until potatoes are tender, about 20 more minutes. Season with hot pepper sauce, salt, and black pepper."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 65,
  "preparation_time_minutes": 20,

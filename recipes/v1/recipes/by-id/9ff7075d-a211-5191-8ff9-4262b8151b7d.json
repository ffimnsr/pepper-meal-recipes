  "id": "9ff7075d-a211-5191-8ff9-4262b8151b7d",
  "slug": "persimmon-cookies-ii",
  "name": "Soft Persimmon Cookies",
  "recipe_type": "dessert",
  "brief_description": "This is a tasty recipe for soft persimmon cookies. These cake-like cookies are wonderfully sweet and delicious; a great use of autumn persimmons.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease or line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine flour, baking soda, cinnamon, cloves, nutmeg, and salt together in a bowl."
    },
    {
      "position": 3,
      "text": "Cream sugar with butter. Beat in persimmons and egg. Add flour mixture and mix until combined. Stir in chopped nuts."
    },
    {
      "position": 4,
      "text": "Drop by teaspoonfuls, 2 inches apart, onto the prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 12 to 15 minutes."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

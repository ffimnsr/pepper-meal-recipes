  "schema_version": 1,
  "id": "c442ecf2-d709-52d2-9696-d215254f609b",
  "slug": "pasta-isabarte",
  "name": "Pasta Isabarte",
  "recipe_type": "main",
  "brief_description": "A colorful and tasty dish with ziti pasta, a variety of vegetables, egg, Mozzarella and red sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F (165 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Add ziti pasta and cook until almost done, soft but not limp; drain."
    },
    {
      "position": 3,
      "text": "Place eggs in a saucepan and cover with cold water. Over medium heat, bring water to a full boil. Lower heat and simmer for 10 to 15 minutes. Immediately plunge eggs into cold water. Using a sharp knife, dice the eggs."
    },
    {
      "position": 4,
      "text": "In a large mixing bowl, gently mix tomato, olives, red peppers, yellow peppers, green peppers, onions, eggs, oregano, garlic salt, and pasta sauce. It's more fun to do the mixing with your hands! Pour the drained pasta into the bowl and mix."
    },
    {
      "position": 5,
      "text": "Pour the mixture into a large, deep, greased casserole dish. Cover with as much cheese as you can, making sure the edges are covered completely. Put lid on dish and bake on a low rack for 30 to 35 minutes or until the cheese is completely melted and turning a golden brown. Let it cool for about 10 minutes, cut into squares and serve."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

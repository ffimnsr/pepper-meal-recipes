  "id": "b95cac35-fd7b-576c-b958-abd2f873950c",
  "slug": "green-salad",
  "name": "Green Salad",
  "recipe_type": "salad",
  "brief_description": "This green salad is hearty, vibrant, and easy to make. With assorted greens, veggies, and deli meat \u2014 this versatile salad is a meal in itself!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place onion and bell pepper in a microwave-safe bowl; heat in microwave on high until soft, about 1 to 2 minutes. Set aside to cool."
    },
    {
      "position": 3,
      "text": "Combine onion, bell pepper, salad greens, deli meat, and tomato in a large salad bowl. Sprinkle with onion powder, garlic powder, salt, and black pepper; toss well to mix."
    },
    {
      "position": 4,
      "text": "Pour on salad dressing; toss well and serve."
    },
    {
      "position": 5,
      "text": "Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

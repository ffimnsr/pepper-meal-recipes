  "id": "69cc3db2-00c3-521c-97d9-547957ac10b3",
  "slug": "wine-braised-beef-brisket",
  "name": "Wine-Braised Beef Brisket",
  "recipe_type": "main",
  "brief_description": "Tender beef brisket roasts for hours until tender in an easy, savory sauce flavored with tomato and red wine.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix thyme, salt, and black pepper in a small bowl and rub the mixture over both sides of brisket."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a roasting pan over medium-high heat; place brisket in the hot oil and brown on both sides, 3 to 4 minutes per side. Remove brisket from pan and set aside."
    },
    {
      "position": 4,
      "text": "Place red onion slices into the hot roasting pan and cook and stir until onion is slightly softened, about 2 minutes. Stir in beef broth, tomato sauce, and wine."
    },
    {
      "position": 5,
      "text": "Place the brisket back into the roasting pan and cover pan with foil."
    },
    {
      "position": 6,
      "text": "Roast the brisket in the preheated oven for 1 hour; remove foil and baste brisket with pan juices. Place foil back over roasting pan and roast brisket until very tender and pan sauce has thickened, 1 1/2 to 2 more hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 150,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "d6c03e07-d33f-5727-94da-b56369f3f0c1",
  "slug": "pecan-shortbread-cookies-recipe-8415352",
  "name": "Pecan Shortbread Cookies",
  "recipe_type": "dessert",
  "brief_description": "These buttery pecan shortbread cookies are packed with chopped pecans and rolled in coarse brown sugar for a rich and flavorful sweet treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Beat butter, white sugar, and vanilla together in a large bowl with an electric mixer until combined."
    },
    {
      "position": 3,
      "text": "Add flour, pecans, and salt. Beat on low with the electric mixer until dough comes together."
    },
    {
      "position": 4,
      "text": "Line a work surface with a piece of plastic wrap about 12 inches long. Divide dough in 2 equal portions. Place a portion of dough on the plastic wrap. Using the plastic wrap to assist you, shape and roll dough into a round log about 1 \u00bd inches wide and 10 inches long. If dough is a little crumbly, press it together firmly. Repeat with the remaining dough."
    },
    {
      "position": 5,
      "text": "Wrap dough tightly in plastic wrap and chill for at least 1 hour or up to overnight."
    },
    {
      "position": 6,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 2 large baking sheets with parchment paper."
    },
    {
      "position": 7,
      "text": "Whisk egg yolk and 1 teaspoon water together in a small bowl with a fork. Pour demerara sugar on a rimmed baking sheet or 13x9-inch baking pan."
    },
    {
      "position": 8,
      "text": "Unwrap dough and brush with egg yolk mixture. Using the ends of the plastic wrap to hold the log, press all sides into demerara sugar."
    },
    {
      "position": 9,
      "text": "Slice dough logs into 1/2-inch thick rounds with a sharp knife. Place on the prepared baking sheets about 2 inches apart. Wrap dough in plastic wrap and refrigerate between batches."
    },
    {
      "position": 10,
      "text": "Bake in the preheated oven until lightly browned on the bottom, about 15 to 16 minutes."
    },
    {
      "position": 11,
      "text": "Cool on the baking sheet briefly, then transfer to a wire rack to cool completely."
    }
  ],
  "servings": 40,

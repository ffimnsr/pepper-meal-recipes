  "id": "5d7d67b2-aabb-53fa-a68e-dfe92ceb6e53",
  "slug": "simple-vegan-split-pea-soup",
  "name": "Simple Vegan Split Pea Soup",
  "recipe_type": "soup",
  "brief_description": "Split peas dissolve into a simple broth of onion, carrots, and celery to make this vegan soup that's light yet filling for any winter night.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Inspect peas, discarding any stones, foreign matter, or unattractive peas. Place peas in a fine mesh strainer and rinse under cold running water to remove pea dust."
    },
    {
      "position": 2,
      "text": "Transfer drained peas into a pot with a lid and a heavy, heat-diffusing bottom. Add water, onion, celery, ketchup, olive oil, salt, garlic, and bay leaves. Cover and bring to a boil over medium-high heat. Reduce heat to a very slow simmer. Cook, stirring and scraping the bottom every 7 to 12 minutes, until peas have largely fallen apart, about 1 1/2 hours."
    },
    {
      "position": 3,
      "text": "Stir carrots into the soup. Cook, covered, stirring often, until peas are completely dissolved and soup is thick, about 1 1/2 hours more. Remove and discard bay leaves. Season with pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 185,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

  "id": "a4a94fa5-4539-557c-82e1-4d18490fff14",
  "slug": "holland-cream-white-cream-filling",
  "name": "Holland Cream (White Cream Filling)",
  "recipe_type": "dessert",
  "brief_description": "Make tasty cream-filled donuts at home, similar to the ones you'd find in bakeries and pastry shops, with this sweet and fluffy white cream filling.",
  "cuisine": "U.S. Dutch",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Stir sugar and 1/2 cup water together in a saucepan over medium heat until sugar has dissolved and mixture comes to a boil. Remove from the heat and let cool completely, 15 to 30 minutes."
    },
    {
      "position": 3,
      "text": "Pour cooled syrup into a large mixing bowl. Add shortening, oil, and vanilla; beat with an electric mixer on high speed until well blended."
    },
    {
      "position": 4,
      "text": "Beat in confectioners' sugar, 1 cup at a time, until filling is thick and fluffy."
    },
    {
      "position": 5,
      "text": "Mix in water, 1 tablespoon at a time, if filling is too thick."
    }
  ],
  "servings": 100,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

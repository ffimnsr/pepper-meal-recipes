  "id": "4778b18c-3ceb-5571-9bfb-0012c165918b",
  "slug": "mediterranean-sausage-and-white-bean-skillet-recipe-12013359",
  "name": "Mediterranean Sausage and White Bean Skillet",
  "recipe_type": "main",
  "brief_description": "This Mediterranean sausage and white bean skillet combines Italian chicken sausage, cannellini beans, artichoke hearts, and sun-dried tomatoes in a creamy feta cheese sauce. Ready in one pan, it\u2019s an easy, flavor-packed dinner for any night of the week.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a skillet over medium-high heat. Add sausage and cook until it begins to brown, 3 to 4 minutes. Add onion and cook until beginning to soften, about 2 minutes."
    },
    {
      "position": 2,
      "text": "Stir in sundried tomatoes, artichoke hearts, marinade from the artichoke jar, and beans. Add broth and bring to a simmer. Reduce heat and simmer 10 minutes. Mash some of the beans with a fork and stir in cream. Season to taste with salt and pepper. Return to a simmer and cook until slightly thickened. Stir in crushed red pepper."
    },
    {
      "position": 3,
      "text": "Remove from heat and add parsley and feta cheese. Serve topped with lemon zest and more crushed red pepper if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

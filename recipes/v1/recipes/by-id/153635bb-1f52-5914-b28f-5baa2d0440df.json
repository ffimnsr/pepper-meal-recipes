  "id": "153635bb-1f52-5914-b28f-5baa2d0440df",
  "slug": "war-cake",
  "name": "War Cake",
  "recipe_type": "dessert",
  "brief_description": "War Cake uses ingredients that were available to the average household during World War II. Great served with whipped topping!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan."
    },
    {
      "position": 2,
      "text": "In a large saucepan over medium heat, combine brown sugar and water. Add raisins, nuts, candied citron, shortening, salt, nutmeg, and cinnamon; bring to a boil and boil 3 minutes. Remove from heat and cool."
    },
    {
      "position": 3,
      "text": "Sift in flour and baking powder; stir until well blended. Pour into prepared pan."
    },
    {
      "position": 4,
      "text": "Bake at 350 degrees F (175 degrees C) for 45 minutes or until a toothpick inserted in center comes out clean. Remove from oven and cool on a wire rack. Leave in pan and cut into squares. ."
    }
  ],
  "servings": 18,
  "cooking_time_minutes": null,

  "id": "9876a5ee-6822-5e9e-a077-e50e2de085d1",
  "slug": "shortbread-crust",
  "name": "Shortbread Crust",
  "recipe_type": "dessert",
  "brief_description": "Simple and easy shortbread crust you'll love. Especially wonderful if your planning to make a peach pie.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "In a large bowl, cream butter and confectioners' sugar until light and fluffy. Stir together flour and baking powder; blend into butter mixture. Pat into a 9 inch pie plate."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven for 12 to 15 minutes, or until edges are lightly browned."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,

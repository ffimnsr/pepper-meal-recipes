  "id": "d0a7cff6-020f-5d50-9f94-7594fbb943e3",
  "slug": "colonial-pumpkin-bars",
  "name": "Colonial Pumpkin Bars",
  "recipe_type": "dessert",
  "brief_description": "These moist pumpkin bars spread with cream cheese frosting are suitable to serve as finger-food.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Butter and flour a 10x15 inch jellyroll pan."
    },
    {
      "position": 2,
      "text": "In a large bowl, cream together 3/4 cup butter and white sugar until light and fluffy. Beat in the eggs one at a time, then stir in the pumpkin. Combine the flour, baking powder, baking soda, salt, cinnamon, and nutmeg; stir into the pumpkin mixture. Mix in walnuts. Spread evenly into the prepared pan."
    },
    {
      "position": 3,
      "text": "Bake for 30 to 35 minutes in the preheated oven, or until toothpick inserted near the center comes out clean. Cool completely before frosting."
    },
    {
      "position": 4,
      "text": "In a medium bowl, mix together the cream cheese, 1/3 cup butter, and vanilla until smooth. Gradually blend in sugar, then beat until smooth. Spread over cooled pumpkin bars. Cut into squares."
    }
  ],
  "servings": 36,

  "id": "ade361d0-056d-535f-a0f0-d967ba299903",
  "slug": "chocolate-chip-banana-muffins-recipe-8645590",
  "name": "Banana Chocolate Chip Muffins",
  "recipe_type": "breakfast",
  "brief_description": "These banana chocolate chip muffins are easy to make with gooey chocolate in every bite for that delicious banana and chocolate flavor kids love!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin or line cups with paper liners."
    },
    {
      "position": 2,
      "text": "Combine flour, sugar, baking powder, baking soda, and salt in a large bowl."
    },
    {
      "position": 3,
      "text": "Mix oil, yogurt, egg, and vanilla together in a separate bowl until well combined; stir into flour mixture until smooth. Gently fold in mashed bananas and chocolate chips. Spoon batter into the prepared muffin cups, filling each 2/3 full."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 22 to 25 minutes. Cool briefly in the tin, then transfer to a wire rack to cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

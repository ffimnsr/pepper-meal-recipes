  "id": "52b99b27-66cb-5dd1-b94f-1c2d4eb403fd",
  "slug": "grandmas-sweet-potato-pie",
  "name": "Grandma's Sweet Potato Pie",
  "recipe_type": "dessert",
  "brief_description": "Mashed sweet potatoes flavored with orange, pineapple juice, and spices are a delicious filling in this Southern pie from Grandma's recipe.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Place sweet potatoes and orange peel into a large pot and cover with water; bring to a boil. Reduce heat to medium-low and simmer until soft, about 10 minutes. Drain well and let cool. Discard orange peel."
    },
    {
      "position": 2,
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line a 9-inch pie plate with pie crust."
    },
    {
      "position": 3,
      "text": "Mash cooled sweet potatoes with a potato masher or fork. Mix in eggs until well blended. Add pineapple juice, butter, and vanilla extract; mix until combined. Mix in flour, cinnamon, nutmeg, ginger, cloves, and salt. Mix in sugar until dissolved. Blend in heavy cream using a whisk."
    },
    {
      "position": 4,
      "text": "Pour sweet potato mixture into the pie crust."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 40 to 50 minutes. Place on a cloth on a table or window sill to cool down."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 15,

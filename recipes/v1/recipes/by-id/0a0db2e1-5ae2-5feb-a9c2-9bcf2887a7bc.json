  "schema_version": 1,
  "id": "0a0db2e1-5ae2-5feb-a9c2-9bcf2887a7bc",
  "slug": "american-french-onion-soup",
  "name": "American French Onion Soup",
  "recipe_type": "soup",
  "brief_description": "This French onion soup is made with sweet caramelized onions, rich cheese, and an American twist that makes this classic an easy and delicious recipe for a rainy day.",
  "cuisine": "French Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt 1/4 cup butter in a large, oven-safe skillet on medium heat. Stir in onions until they are all coated in butter. Transfer skillet to the preheated oven and cook onions, stirring occasionally, until they are tender and well browned, about 1 hour."
    },
    {
      "position": 3,
      "text": "Transfer skillet to the stovetop; cook and stir onions over medium heat until they start to brown and stick to the bottom of the pan, about 5 minutes. Pour sherry and vinegar into the pan, and bring to a boil while scraping browned bits of onion off the bottom of the pan with a wooden spoon."
    },
    {
      "position": 4,
      "text": "Place caramelized onions in a large soup pot. Pour in chicken broth, beef broth, and thyme. Bring to a boil, skimming off any foam and fat that appear on top. Reduce heat to low and simmer for about an hour. Season with salt and pepper to taste."
    },
    {
      "position": 5,
      "text": "Preheat the oven's broiler and set the oven rack about 6 inches from the heat source."
    },
    {
      "position": 6,
      "text": "Generously brush French bread slices with melted butter. Place on a baking sheet and broil in the preheated oven until crisp and golden, about 5 minutes."
    },
    {
      "position": 7,
      "text": "Ladle soup into heat-proof bowls, top each bowl with a piece of toasted bread, sprinkle with 2 to 3 tablespoons of Cheddar cheese and Monterey Jack cheese."
    },
    {
      "position": 8,
      "text": "Broil bowls of soup under the broiler until cheese is golden and bubbly, 5 to 6 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 80,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "hard",

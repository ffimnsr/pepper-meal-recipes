  "id": "51a5ef3d-3a90-5167-9989-8aa863315576",
  "slug": "chicken-caesar-pasta-casserole-recipe-11967463",
  "name": "Chicken Caesar Pasta Casserole",
  "recipe_type": "main",
  "brief_description": "This chicken Caesar pasta casserole is over-the-top good and surprisingly easy to make. Caesar dressing adds plenty of savory flavor, while crunchy croutons and Parmesan create the perfect crispy topping. It\u2019s even easier with leftover chicken.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Grease a 2-quart casserole dish."
    },
    {
      "position": 2,
      "text": "Bring a large pot of water to a boil; add pasta and cook until tender with a bite, 8 to 11 minutes. Drain and set aside."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat a nonstick skillet over medium-high heat, and cook chicken for 4 minutes; flip and cook until no longer pink at the center and juices run clear, 3 to 4 minutes more. Let chicken rest for 5 minutes, then chop into bite-sized pieces."
    },
    {
      "position": 4,
      "text": "Mix pasta, chicken, Caesar dressing, chicken broth, green onion, and mozzarella together in a large bowl. Pour into the prepared casserole dish. Top dish with croutons and sprinkle with Parmesan cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until croutons are golden brown, about 20 minutes. Serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "9ecb46ae-335a-538e-ba14-236d2faf5e8b",
  "slug": "baked-bbq-fried-chicken",
  "name": "Baked BBQ Fried Chicken",
  "recipe_type": "main",
  "brief_description": "This baked BBQ fried chicken is a tasty, crispy Southern treat everyone will love! You can also serve the chicken without the barbecue sauce as well.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Set up a batter station: Whisk together eggs, water, milk, 2 tablespoons salt, and 2 tablespoons pepper in a large bowl with a fork until smooth. Stir together flour, 1/4 cup salt, 5 teaspoons pepper, garlic, and mesquite seasoning in another large bowl."
    },
    {
      "position": 2,
      "text": "Fill a large heavy skillet or wok halfway full with oil. Heat to 365 degrees F (180 degrees C)."
    },
    {
      "position": 3,
      "text": "Coat chicken in batter: Use a fork to pick up one chicken strip at a time and dip it into the egg mixture, then into the flour mixture, back into the egg mixture, and into the flour mixture again."
    },
    {
      "position": 4,
      "text": "Place coated strips into the hot oil to fry. Cook in batches without crowding. Once chicken is browned on one side, flip over and brown on the other side."
    },
    {
      "position": 5,
      "text": "Meanwhile, preheat the oven to 300 degrees F (150 degrees C). Butter a 12x20-inch glass baking dish, or two 9x13-inch baking dishes."
    },
    {
      "position": 6,
      "text": "Pour enough barbeque sauce into the prepared dish to coat the bottom. Arrange fried chicken strips in rows in the dish. Pour remaining sauce over the top."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until the sauce is caramelized onto the chicken, 10 to 15 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

  "id": "aca4df70-e70d-510a-acd1-b5f293ea8090",
  "slug": "instant-pot-apple-pie-steel-cut-oats",
  "name": "Instant Pot Apple Pie Steel-Cut Oats",
  "recipe_type": "breakfast",
  "brief_description": "Steel-cut oats cook quickly in an Instant Pot and are especially delicious in this apple pie version, which features fresh apples, cinnamon, and nutmeg.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine water, oats, apple, cinnamon, salt, and nutmeg in a multi-functional pressure cooker (such as Instant Pot). Close and lock the lid. Seal the vent. Select Manual function; set the timer for 5 minutes. Allow 10 to 15 minutes for pressure to build."
    },
    {
      "position": 2,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, about 10 minutes. Release remaining pressure naturally. Stir and remove the pot carefully with oven mitts."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,

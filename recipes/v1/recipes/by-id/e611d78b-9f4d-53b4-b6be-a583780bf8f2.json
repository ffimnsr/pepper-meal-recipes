  "id": "e611d78b-9f4d-53b4-b6be-a583780bf8f2",
  "slug": "apple-cake-v",
  "name": "Moist Apple and Walnut Cake",
  "recipe_type": "dessert",
  "brief_description": "This moist apple and walnut cake recipe is quick and easy to make with chopped fruit and nuts, topped with a buttery glaze. Enjoy it warm or cooled.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Sift flour, white sugar, salt, and baking soda together into a large bowl; make a well in the center. Stir oil, beaten eggs, and vanilla extract into the well until well combined (batter will be thick); fold in apples and walnuts until evenly distributed. Spread batter into the prepared baking dish."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 40 to 50 minutes."
    },
    {
      "position": 4,
      "text": "Combine brown sugar, butter, and milk in a small saucepan; bring to a boil. Cook, stirring constantly, until glaze is slightly thickened, 2 to 3 minutes."
    },
    {
      "position": 5,
      "text": "Pour glaze over hot cake."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "schema_version": 1,
  "id": "9f21bf32-7c10-574b-afd1-40f07e9ae702",
  "slug": "mushroom-and-tomato-bruschetta",
  "name": "Mushroom and Tomato Bruschetta",
  "recipe_type": "appetizer",
  "brief_description": "A juicy fresh mushroom and tomato topping sets this easy bruschetta recipe apart. The cheese-topped appetizers are broiled and served warm.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Arrange bread slices on a baking sheet in a single layer."
    },
    {
      "position": 2,
      "text": "Broil bread in the preheated oven until toasted, 1 to 2 minutes; watch carefully to prevent burning. Remove from the oven and place the baking sheet onto a wire rack. Keep the broiler on."
    },
    {
      "position": 3,
      "text": "Heat olive oil in a skillet over medium heat. Add mushrooms, green onions, garlic, salt, black pepper, and parsley; cook and stir until mushrooms are soft and juicy, about 5 minutes. Remove from the heat."
    },
    {
      "position": 4,
      "text": "While the mushrooms are cooking, mix tomatoes and balsamic vinegar together in a bowl."
    },
    {
      "position": 5,
      "text": "Top each toasted bread slice with mushroom mixture, then spread tomato mixture over top and sprinkle with mozzarella cheese."
    },
    {
      "position": 6,
      "text": "Return to the oven and broil until heated through and cheese has melted, about 5 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

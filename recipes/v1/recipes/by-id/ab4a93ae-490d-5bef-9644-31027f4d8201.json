  "id": "ab4a93ae-490d-5bef-9644-31027f4d8201",
  "slug": "blonde-brownies-ii",
  "name": "Blonde Brownies",
  "recipe_type": "dessert",
  "brief_description": "Use this blondie recipe for a lighter version of brownies topped with chocolate chips.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Grease a 9x13-inch pan."
    },
    {
      "position": 2,
      "text": "Combine flour, walnuts, baking powder, salt, and baking soda in a medium bowl. Set aside."
    },
    {
      "position": 3,
      "text": "Mix together brown sugar and melted butter in a large bowl until combined. Beat in eggs and vanilla. Stir in flour mixture. Pour batter into the prepared pan. Sprinkle top with chocolate chips."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out with a few crumbs, 20 to 25 minutes. Allow to cool, then cut into 24 bars."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

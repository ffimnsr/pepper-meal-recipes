  "id": "8991c5ab-b1fe-54ec-85b9-21d63fe426a6",
  "slug": "egg-fried-rice",
  "name": "Easy Egg Fried Rice",
  "recipe_type": "main",
  "brief_description": "The ingredients in this egg fried rice are basic pantry staples like instant rice, onion, green beans, and soy sauce, all cooked together in a wok.",
  "cuisine": "World Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Bring water, soy sauce, and salt to a boil in a medium saucepan. Stir in instant rice and remove from heat. Cover and let stand for 5 minutes."
    },
    {
      "position": 3,
      "text": "Heat oil in a medium skillet or wok over medium heat. Saut\u00e9 onions and green beans or peas in hot oil for 2 to 3 minutes."
    },
    {
      "position": 4,
      "text": "Pour in beaten egg and fry for 2 minutes, scrambling egg while it cooks."
    },
    {
      "position": 5,
      "text": "Add cooked rice to egg mixture; mix well. Season with pepper."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

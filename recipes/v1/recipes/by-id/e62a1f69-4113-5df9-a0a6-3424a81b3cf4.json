  "id": "e62a1f69-4113-5df9-a0a6-3424a81b3cf4",
  "slug": "date-cake",
  "name": "Date Cake",
  "recipe_type": "dessert",
  "brief_description": "This date cake is a simple, flavorful coffee cake filled with sweet raisins and chopped dates topped with a broiled buttery, brown sugar topping.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9-inch square pan."
    },
    {
      "position": 2,
      "text": "Combine water and raisins in a medium saucepan. Bring to a boil and cook for 5 minutes. Remove from heat, then stir in chopped dates and baking soda. Set aside."
    },
    {
      "position": 3,
      "text": "Cream together white sugar and butter in a large bowl until light and fluffy. Beat in eggs one at a time, then stir in vanilla. Add flour, salt, and date mixture; mix until combined. Pour batter into the prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, about 45 minutes. Remove cake from the oven."
    },
    {
      "position": 5,
      "text": "Set the oven to broil. Meanwhile, make the topping: Melt butter in a small saucepan; stir in brown sugar, walnuts, and cream until combined. Spread mixture over warm cake."
    },
    {
      "position": 6,
      "text": "Place cake under preheated broiler and cook until top is lightly browned, about 3 minutes. Rotate cake as needed for even browning; watch carefully as the top can burn quickly under the broiler."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 55,

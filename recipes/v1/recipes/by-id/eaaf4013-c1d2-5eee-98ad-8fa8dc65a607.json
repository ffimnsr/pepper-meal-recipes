  "id": "eaaf4013-c1d2-5eee-98ad-8fa8dc65a607",
  "slug": "4-ingredient-cheesy-sausage-pinwheels-recipe-11960035",
  "name": "4-Ingredient Cheesy Sausage Pinwheels",
  "recipe_type": "appetizer",
  "brief_description": "These 4 ingredient cheesy sausage pinwheels are incredibly easy to make and are a great appetizer for entertaining.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Unroll each sheet of crescent dough sheets (if using crescent rolls, pinch the seams together to form one solid sheet)."
    },
    {
      "position": 2,
      "text": "Divide sausage roll in half and spread each half evenly into a very thin layer over the dough sheets."
    },
    {
      "position": 3,
      "text": "Spread 1 tablespoon mustard over each sausage-topped sheet and top evenly with cheese."
    },
    {
      "position": 4,
      "text": "Beginning with the longer side of the dough, roll it securely into a log. If dough has become too soft or warm, freeze it for 10 minutes before slicing."
    },
    {
      "position": 5,
      "text": "Slice each roll into 22 (1/2 inch) slices and place on 2 lightly greased, parchment-lined baking sheets."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden brown and toasted on the bottom, 12 to 14 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

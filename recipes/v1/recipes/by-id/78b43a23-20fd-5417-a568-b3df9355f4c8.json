  "id": "78b43a23-20fd-5417-a568-b3df9355f4c8",
  "slug": "savory-toasted-pumpkin-seeds",
  "name": "Savory Toasted Pumpkin Seeds",
  "recipe_type": "appetizer",
  "brief_description": "This 4-ingredient toasted savory pumpkin seeds recipe combines Worcestershire sauce, pumpkin seeds, butter, and seasoned salt for crunchy, fall flavor",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 250 degrees F (120 degrees C)."
    },
    {
      "position": 2,
      "text": "Rinse pumpkin seeds and pat dry with paper towel: place in a bowl. Add Worcestershire sauce, melted butter, and seasoned salt; stir until evenly coated. Spread out in an even layer on a baking sheet."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven, stirring occasionally, until crisp, dry, and golden brown, about 1 hour."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 10,

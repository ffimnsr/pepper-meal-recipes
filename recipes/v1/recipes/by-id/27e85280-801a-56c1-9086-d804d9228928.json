  "slug": "blueberry-smoothie",
  "name": "Blueberry Smoothie",
  "recipe_type": "breakfast",
  "brief_description": "Blueberry smoothie recipes are a favorite way to enjoy fresh or frozen berries, and this one's a winner! Tangy yogurt and a touch of sugar balance it.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Blend blueberries, yogurt, milk, sugar, vanilla, and nutmeg in a blender until frothy, scraping down the sides of the blender if needed."
    },
    {
      "position": 3,
      "text": "Divide between 2 glasses and serve immediately. Enjoy!"
    }
  ],
  "servings": 2,

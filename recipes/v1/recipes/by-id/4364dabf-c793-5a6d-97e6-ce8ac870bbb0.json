  "id": "4364dabf-c793-5a6d-97e6-ce8ac870bbb0",
  "slug": "harvest-pumpkin-cupcakes",
  "name": "Harvest Pumpkin Cupcakes",
  "recipe_type": "dessert",
  "brief_description": "A rich and spicy harvest pumpkin cupcake recipe that is quick and easy, featuring an orange cream cheese frosting and only requires 30 minutes to make.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 32 muffin cups or line cups with paper liners."
    },
    {
      "position": 2,
      "text": "Whisk white sugar, pumpkin, eggs, and oil together in a large bowl until evenly blended. Whisk flour, cornstarch, pumpkin pie spice, baking powder, baking soda, and salt together in a separate bowl: beat into pumpkin mixture until well blended."
    },
    {
      "position": 3,
      "text": "Divide batter among the prepared muffin cups, filling each \u2154 full."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until centers spring back when touched, 30 minutes. Cool muffins in the cups for 5 minutes, then transfer to a wire rack to cool, about 25 minutes."
    },
    {
      "position": 5,
      "text": "Meanwhile, beat cream cheese and butter together in a bowl with an electric mixer until fluffy. Beat in confectioners\u2019 sugar, orange juice, vanilla extract, and orange zest until smooth. Spread over cooled cupcakes."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "93606999-57f5-5d10-95f2-c2a54e56413f",
  "slug": "spicy-spanish-style-rice",
  "name": "Spicy Spanish-Style Rice",
  "recipe_type": "side",
  "brief_description": "Chef John's Spanish-inspired spicy rice with tomatoes, jalape\u00f1os, and chili powder is super easy to make for a fiery, crowd-pleasing side dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a pot over medium-low heat. Stir rice, jalape\u00f1o, green onion, and garlic together in the melted butter until rice is completely coated with butter. Add chili powder, cumin, salt, chipotle chile powder, and cayenne pepper; cook and stir until fragrant, about 1 minute."
    },
    {
      "position": 3,
      "text": "Stir chicken stock and tomato sauce into rice mixture. Bring to a simmer, cover the pot, reduce heat to low, and simmer for 20 minutes."
    },
    {
      "position": 4,
      "text": "Turn heat off and leave pot covered on the burner for 8 minutes. Remove cover and fluff rice with a fork."
    },
    {
      "position": 5,
      "text": "Transfer rice to a platter and sprinkle chopped green onion on top."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

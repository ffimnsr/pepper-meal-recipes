  "id": "ed721289-a484-51d4-a504-8c3b3b6446f4",
  "slug": "cha-cha-cha-sangria",
  "name": "Cha Cha Cha Sangria",
  "recipe_type": "drink",
  "brief_description": "This recipe comes from a Caribbean restaurant (the Cha Cha Cha Restaurant) on Haight Street in San Francisco renowned for its sangria. Enjoy!",
  "cuisine": "U.S.",
  "instructions": [
    {
      "position": 1,
      "text": "Combine the sugar, white wine, and red wine in a large bowl and stir for several minutes until the sugar is dissolved. Stir in the sliced orange and lemon. Cover and refrigerate for 4 to 6 hours or overnight."
    },
    {
      "position": 2,
      "text": "Stir the mixture and divide it into pitchers. Add the sliced fruit and serve the sangria over ice."
    }
  ],
  "servings": 8,

  "id": "ab1acb95-0cb5-51c8-b452-0182171b59a4",
  "slug": "fried-kimchi",
  "name": "Fried Kimchi",
  "recipe_type": "dessert",
  "brief_description": "Kimchi is simply pan-fried with sesame oil, vinegar, and sugar in this Korean side dish that offers the perfect balance of sweet and sour!",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a nonstick skillet to medium-high heat. Add kimchi. Saute until fragrant and slightly yellow, about 5 minutes. Add sesame oil; cook until kimchi is coated, 2 to 3 minutes. Pour in vinegar to coat the bottom of the skillet. Increase heat slightly; bring vinegar to a boil. Add sugar. Reduce heat to low; cook until sugar dissolves and kimchi is browned, about 3 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "cf5b402d-fe75-5965-abbc-aa2788a7a1df",
  "slug": "tangy-cabbage-slaw-with-crispy-tofu-recipe-11955273",
  "name": "Tangy Cabbage Slaw With Crispy Tofu",
  "recipe_type": "salad",
  "brief_description": "This tangy cabbage slaw with crispy tofu features spicy, panko-breaded cubes of tofu, roasted until crisp, on a cabbage slaw with a soy-garlic dressing. It's crunchy and colorful, and full of delightful textures and flavors.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 450 degrees F (235 degrees C). Line a sheet pan with aluminum foil."
    },
    {
      "position": 2,
      "text": "Pat tofu dry with paper towels on all sides. Using a sharp knife, cut tofu into 3/4-inch cubes, and spread out on the prepared pan."
    },
    {
      "position": 3,
      "text": "Combine salt, white pepper, paprika, garlic powder, and powdered ginger in a small bowl. Sprinkle seasoning mix on tofu pieces, and rotate to season all sides. Sprinkle panko crumbs on all sides of tofu, and lightly press to adhere. Spray tofu cubes lightly with avocado oil spray on all sides."
    },
    {
      "position": 4,
      "text": "Bake in the center of the preheated oven until browned and very crisp, about 20 minutes. Remove from the oven and allow to cool slightly on the pan."
    },
    {
      "position": 5,
      "text": "Meanwhile, for dressing, combine soy sauce, rice vinegar, avocado oil, garlic, ginger, sugar, and chili sauce in a container with a tight fitting lid. Close the lid and shake vigorously, until well mixed. Taste dressing; season with salt and adjust sugar, if necessary."
    },
    {
      "position": 6,
      "text": "Stir together the coleslaw mix, red cabbage, and bell pepper together in a bowl. Add the dressing and toss."
    },
    {
      "position": 7,
      "text": "Place the slightly cooled baked tofu on top of the salad, and sprinkle almonds and green onions on top. Sprinkle with sesame seeds, and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,

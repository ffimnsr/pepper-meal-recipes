  "id": "e4b9e3b9-a45f-5dd0-bd86-e341376d956c",
  "slug": "peanut-free-chocolate-macaroons",
  "name": "Peanut-Free Chocolate Macaroons",
  "recipe_type": "dessert",
  "brief_description": "These no-bake, peanut-free, chocolate macaroons made with oats and coconut are also known as 'Frogs and Haystacks'.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Line a work surface with waxed paper."
    },
    {
      "position": 2,
      "text": "Stir oats, cocoa powder, and coconut together in a large bowl."
    },
    {
      "position": 3,
      "text": "Whisk sugar, milk, and butter together in a nonstick pot; bring to a boil and cook, stirring constantly, until sugar is completely dissolved, about 2 minutes. Remove from heat and stir vanilla extract into butter mixture."
    },
    {
      "position": 4,
      "text": "Stir oat mixture into butter mixture until well-combined. Drop mixture by the spoonful onto waxed paper and let sit until set, at least 15 minutes."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,

  "slug": "lomi-lomi",
  "name": "Lomi Lomi Salmon",
  "recipe_type": "salad",
  "brief_description": "This Hawaiian lomi lomi is easy to make with smoked salmon, tomato, and onion for a refreshing fish salad or side. Perfect for a luau or any party!",
  "cuisine": "Hawaiian",
  "instructions": [
    {
      "position": 1,
      "text": "Stir salted salmon, tomatoes, white onion, green onion, sea salt, and cayenne pepper in a medium bowl. Chill for at least 30 minutes before serving. Serve chilled."
    }
  ],

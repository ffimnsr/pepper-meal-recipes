  "id": "bbf741c7-b147-5410-9f6c-80f680e3b15b",
  "slug": "thin-and-crispy-oatmeal-raisin-cookies",
  "name": "Thin and Crispy Oatmeal Raisin Cookies",
  "recipe_type": "dessert",
  "brief_description": "These crispy oatmeal cookies with raisins are thin, buttery, and easy to make from scratch for a heavenly treat that's delicious dunked into coffee.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper."
    },
    {
      "position": 3,
      "text": "Combine 1 cup plus 1 tablespoon flour, baking soda, baking powder, and salt in a large bowl. Set aside."
    },
    {
      "position": 4,
      "text": "Place cold butter in a microwave-safe bowl and heat until soft, but not melted, 20 to 30 seconds. Add brown and white sugars; mix with a metal whisk or spoon until combined, about 45 seconds. Add egg, vanilla, cinnamon, and nutmeg; mix for 20 seconds. Pour in flour mixture and mix for 10 to 20 seconds."
    },
    {
      "position": 5,
      "text": "Fold in oats and raisins until incorporated, about 30 seconds."
    },
    {
      "position": 6,
      "text": "Scoop or roll dough into small balls, about 1 1/2-inches in diameter. Arrange balls 3 inches apart on the prepared baking sheets."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until tops are golden brown and edges are crisp, 13 to 15 minutes."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

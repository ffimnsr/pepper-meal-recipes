{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "e92a7d8a-782b-5259-bbe3-16593dec6583",
  "slug": "air-fryer-croissant-breakfast-boats-recipe-11813022",
  "name": "Air Fryer Croissant Breakfast Boats",
  "recipe_type": "breakfast",
  "brief_description": "These air fryer croissant breakfast boats are a delicious mix of eggs, bacon, and vegetables stuffed into a croissant, all cooked to perfection in the air fryer.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat skillet over medium-high heat. Add bacon, onion and red bell pepper and saut\u00e9 until vegetables soften, 3 to 4 minutes. Add spinach; stir until completely wilted and bright green, about 1 minute. Remove skillet from the heat; set aside."
    },
    {
      "position": 2,
      "text": "Cut a trench or a V-shape into the top of each croissant with a serrated knife, being careful not to cut all the way through the bottom. Gently hollow out the inside, removing some of the soft bread to create a \"boat\" shape with a cavity for the filling."
    },
    {
      "position": 3,
      "text": "Crack eggs into a bowl and whisk until smooth and uniform in color. Add bacon and vegetable mixture to the eggs; season with salt and pepper and stir to combine."
    },
    {
      "position": 4,
      "text": "Preheat an air fryer to 325 degrees F (165 degrees C). Line air fryer basket with aluminum foil"
    },
    {
      "position": 5,
      "text": "Set hollowed-out croissants into the basket. Carefully spoon or pour egg mixture into each croissant boat, filling them to the top."
    },
    {
      "position": 6,
      "text": "Place the basket into the air fryer and cook until eggs are set and puffed up, about 20 minutes."
    },
    {
      "position": 7,
      "text": "Remove boats from the air fryer. Sprinkle generously with Parmesan cheese while still hot and garnish with basil. Serve immediately."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

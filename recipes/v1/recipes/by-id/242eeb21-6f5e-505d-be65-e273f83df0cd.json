  "id": "242eeb21-6f5e-505d-be65-e273f83df0cd",
  "slug": "too-easy-peach-cobbler",
  "name": "Too Easy Peach Cobbler",
  "recipe_type": "dessert",
  "brief_description": "Fresh peaches are sliced and arranged in an 8x8-inch pan and covered with strips of white bread instead of the traditional biscuit dough.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Butter an 8-inch square baking dish."
    },
    {
      "position": 2,
      "text": "Cut crust from bread slices, and cut each into 4 or 5 strips. Spread fruit into prepared pan, and cover with a layer of bread strips."
    },
    {
      "position": 3,
      "text": "Beat together butter, sugar, and flour; mix in egg. Pour mixture over the fruit and bread."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven for 35 to 45 minutes, or until golden brown."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

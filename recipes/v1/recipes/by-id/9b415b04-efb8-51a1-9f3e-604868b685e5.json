  "id": "9b415b04-efb8-51a1-9f3e-604868b685e5",
  "slug": "bacon-potato-cakes-with-ham-steak-egg-and-sliced-avocado",
  "name": "Bacon Potato Cakes with Ham Steak, Egg, and Sliced Avocado",
  "recipe_type": "dessert",
  "brief_description": "Hash brown potatoes form the base of these quick and hearty bacon potato cakes topped with ham steak, fried eggs, and avocado.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bacon Potato Cakes: In large bowl, combine potatoes, bacon, Parmesan cheese, flour, garlic, eggs, green onions, and cayenne pepper; season with salt and pepper."
    },
    {
      "position": 2,
      "text": "Heat olive oil in large skillet over medium-high heat. Scoop tablespoons of batter for each pancake, flattening with spatula, and cook until underside is nicely golden brown, about 2 to 3 minutes. Flip and cook on other side, about 2 minutes longer."
    },
    {
      "position": 3,
      "text": "To Serve: Place bacon potato cakes on plate and top with ham steak. Top with fried eggs, followed by sliced avocado fanned on top."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "9510a722-62a9-5f31-9773-d23d2e91e202",
  "slug": "english-toffee",
  "name": "English Toffee",
  "recipe_type": "dessert",
  "brief_description": "This recipe for English toffee is such a great gift idea around the holidays! Who wouldn't appreciate a box of nutty, chocolaty toffee under their tree?",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Butter a 10x15-inch jellyroll pan."
    },
    {
      "position": 2,
      "text": "Melt butter in a heavy skillet over medium heat. Stir in sugar and water, then bring to a boil. Add almonds and cook, stirring constantly, until nuts are toasted and sugar is golden. Pour mixture into the prepared pan; do not spread."
    },
    {
      "position": 3,
      "text": "Immediately sprinkle chocolate chips onto hot sugar mixture. Spread chocolate over the surface as it melts. Let cool completely before breaking into pieces."
    }
  ],
  "servings": 16,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

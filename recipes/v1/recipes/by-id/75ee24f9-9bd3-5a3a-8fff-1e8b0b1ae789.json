  "id": "75ee24f9-9bd3-5a3a-8fff-1e8b0b1ae789",
  "slug": "split-pea-and-ham-soup-ii",
  "name": "Simple Split Pea and Ham Soup",
  "recipe_type": "soup",
  "brief_description": "Dried split peas are cooked with a ham bone, carrots, onion and garlic covered in water. Season with plenty of freshly ground black pepper.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place ham bone in a large pot over high heat. Add water to cover, bring to a boil, reduce heat to low and let simmer for 8 hours. Allow stock to cool, then strain and skim off any excess fat, discarding the bone and any cartilage. Return any ham meat to the pot, and bring the stock back to a boil until heated through."
    },
    {
      "position": 2,
      "text": "Add the onion, garlic and ground black pepper and allow to simmer for 1 hour. Then pour in the split peas and the carrots and allow to simmer for at least 1 more hour to allow the peas to break down. Stir together well and season to taste."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 1440,

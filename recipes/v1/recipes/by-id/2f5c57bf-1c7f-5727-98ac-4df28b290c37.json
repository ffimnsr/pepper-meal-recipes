  "schema_version": 1,
  "id": "2f5c57bf-1c7f-5727-98ac-4df28b290c37",
  "slug": "corned-beef-hash-british-style",
  "name": "Corned Beef Hash, British-Style",
  "recipe_type": "breakfast",
  "brief_description": "This is my husband's favorite meal. I always had a different version of corned beef hash until I met my Scottish husband, who taught me how it was meant to be made. It is a wonderful casserole-type dish that is very filling and perfect for cold nights. Serve with vegetables or crusty French bread.",
  "cuisine": "English",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Place the potatoes in a large pot with just enough water to cover. Bring to a boil and simmer until tender, about 10 minutes. Drain and mash, flavoring with milk, butter, salt or however you like to make them."
    },
    {
      "position": 3,
      "text": "Pour the baked beans into the bottom of a 1 1/2 quart casserole dish. Slice the corned beef and arrange on top of the beans in an even layer. Season with a few dashes of Worcestershire sauce. Top with mashed potatoes."
    },
    {
      "position": 4,
      "text": "Bake uncovered for 25 minutes in the preheated oven. The mashed potatoes should start to crisp up but not yet brown. Top with the cheese and return to the oven. Bake for another 20 minutes, or until cheese is browned."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

  "id": "062051d0-cd4f-5928-8ffd-959c3cf66619",
  "slug": "ellens-lemon-zucchini-bread",
  "name": "Ellen's Lemon Zucchini Bread",
  "recipe_type": "snack",
  "brief_description": "Lemon zest and lemon extract give this zucchini bread recipe an extra boost of citrus flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 2 loaf pans; sprinkle 1 teaspoon sugar onto the bottom and sides of the greased pans."
    },
    {
      "position": 2,
      "text": "Beat 2 cups sugar, oil, eggs, lemon zest, lemon extract, and vanilla extract together in a large bowl until well combined. Whisk flour, salt, baking soda, and baking powder together in a separate bowl until well mixed; add to sugar-lemon mixture and stir until batter is thick. Fold in zucchini until incorporated. Divide batter between the prepared pans."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 1 hour. Cool loaves in the pans for 10 minutes before removing to a wire rack to cool completely."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

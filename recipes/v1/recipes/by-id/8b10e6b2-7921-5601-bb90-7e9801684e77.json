  "id": "8b10e6b2-7921-5601-bb90-7e9801684e77",
  "slug": "bibimbap-korean-rice-with-mixed-vegetables",
  "name": "Bibimbap (Korean Rice Bowl)",
  "recipe_type": "main",
  "brief_description": "Bibimbap is a delicious Korean rice dish of warm white rice topped with tender beef, mixed veggies, gochujang chili paste, sesame seeds, and a fried egg.",
  "cuisine": "Korean",
  "instructions": [
    {
      "position": 1,
      "text": "Stir cucumber pieces and gochujang paste together in a bowl; set aside."
    },
    {
      "position": 2,
      "text": "Bring about 2 cups water to a boil in a large nonstick skillet and stir in spinach; cook until bright green and wilted, 2 to 3 minutes."
    },
    {
      "position": 3,
      "text": "Drain spinach and squeeze out as much moisture as possible; set spinach aside in a bowl and stir in soy sauce."
    },
    {
      "position": 4,
      "text": "Heat 1 teaspoon olive oil in a large nonstick skillet; cook and stir carrots until softened, about 3 minutes."
    },
    {
      "position": 5,
      "text": "Stir in garlic and cook just until fragrant, about 1 minute. Stir in cucumber mixture; sprinkle with red pepper flakes. Set carrot mixture aside in a bowl."
    },
    {
      "position": 6,
      "text": "Brown beef in a clean nonstick skillet over medium heat, about 5 minutes per side; set aside."
    },
    {
      "position": 7,
      "text": "Heat remaining 1 teaspoon olive oil in another nonstick skillet over medium-low heat. Fry eggs just on one side until yolks are runny, but whites are firm, 2 to 4 minutes."
    },
    {
      "position": 8,
      "text": "Divide cooked rice into 4 large serving bowls; top with spinach mixture, a few pieces of beef, and cucumber mixture. Place 1 egg atop each serving. Drizzle each bowl with 1 teaspoon sesame oil, a sprinkle of sesame seeds, and a small amount of gochujang paste if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

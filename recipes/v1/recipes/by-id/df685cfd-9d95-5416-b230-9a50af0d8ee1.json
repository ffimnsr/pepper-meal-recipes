  "id": "df685cfd-9d95-5416-b230-9a50af0d8ee1",
  "slug": "grilled-soy-sesame-asparagus",
  "name": "Grilled Soy-Sesame Asparagus",
  "recipe_type": "side",
  "brief_description": "This asparagus pairs especially well with Asian types of grilled foods, such as kebabs or satays.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat grill for high heat."
    },
    {
      "position": 2,
      "text": "In a bowl, mix sesame oil, soy sauce, garlic, and brown sugar. Place asparagus in the bowl, and toss to coat."
    },
    {
      "position": 3,
      "text": "Lightly oil a fine-mesh grill grate. Place asparagus on grate, and cook 8 minutes, until tender but firm. Garnish with sesame seeds to serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 8,
  "preparation_time_minutes": 10,

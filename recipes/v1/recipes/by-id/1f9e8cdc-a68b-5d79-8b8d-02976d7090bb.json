  "id": "1f9e8cdc-a68b-5d79-8b8d-02976d7090bb",
  "slug": "air-fryer-truffle-polenta-fries-recipe-8643717",
  "name": "Air Fryer Truffle Polenta Fries",
  "recipe_type": "side",
  "brief_description": "These air fryer truffle polenta fries, flavored with truffle-infused oil and truffle zest, are crispy on the outside, tender and juicy on the inside.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) according to manufacturer's instructions. Line a baking sheet with paper towels; set aside."
    },
    {
      "position": 2,
      "text": "Cut the tube of polenta in half widthwise. Cut each half in half lengthwise and then cut into 1/2-inch wide fry-shaped sticks."
    },
    {
      "position": 3,
      "text": "Whisk truffle-infused olive oil and truffle zest in a bowl. Add fries and gently toss to coat."
    },
    {
      "position": 4,
      "text": "Place fries in the basket of the air fryer in a single layer. Depending on the size of your air fryer, fries may need to be cooked in batches."
    },
    {
      "position": 5,
      "text": "Cook for 10 minutes. Shake the basket and cook 5 minutes more. Using tongs, transfer fries to the prepared baking sheet. Garnish with Parmesan and chopped parsley."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,

  "schema_version": 1,
  "id": "a791f400-1ee0-513b-a7a4-31f1ec55547f",
  "slug": "stuffed-portobello-mushrooms-with-egg-and-pesto",
  "name": "Stuffed Portobello Mushrooms with Egg and Pesto",
  "recipe_type": "appetizer",
  "brief_description": "Switch up your breakfast routine with these savory, low-carb, stuffed portobellos and serve this to impress guests at your next brunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Line a baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Use a damp cloth to remove any dirt from mushrooms. Cut stems off and use a spoon to remove gills, being careful not to break sides of the mushrooms. If there is not enough room for an egg, scrape out a bit of the mushroom flesh. Brush mushroom tops with olive oil and place, top-sides down, on the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Broil in the preheated oven until mushrooms start to release liquid, 5 to 6 minutes. Remove from oven and reduce heat to 400 degrees F (200 degrees C)."
    },
    {
      "position": 4,
      "text": "Pour out any accumulated liquid from the mushrooms and pat the insides dry with a paper towel. Return mushrooms to the baking sheet. Lightly brush the foil with additional oil to prevent sticking."
    },
    {
      "position": 5,
      "text": "Spread 1 tablespoon pesto into each mushroom. Gently crack an egg into each mushroom and season with salt and pepper. Sprinkle with Parmesan cheese."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until whites are set and egg yolks are done to your liking, 12 to 15 minutes. Garnish with parsley."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

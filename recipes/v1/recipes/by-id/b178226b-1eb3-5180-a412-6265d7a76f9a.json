  "id": "b178226b-1eb3-5180-a412-6265d7a76f9a",
  "slug": "too-much-chocolate-cake",
  "name": "Too Much Chocolate Cake",
  "recipe_type": "dessert",
  "brief_description": "This moist chocolate Bundt cake, made with cake mix, instant pudding, sour cream, and chocolate chips, makes the perfect ultra-rich chocolaty treat!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Generously grease a 12-cup Bundt pan."
    },
    {
      "position": 2,
      "text": "Beat cake mix, pudding mix, sour cream, oil, water, and eggs in a large bowl until smooth and well blended."
    },
    {
      "position": 3,
      "text": "Stir in chocolate chips."
    },
    {
      "position": 4,
      "text": "Pour batter into the prepared Bundt pan."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until top is springy to the touch and a toothpick inserted into center of cake comes out clean, 50 to 55 minutes."
    },
    {
      "position": 6,
      "text": "Cool cake thoroughly in the pan for at least 1 \u00bd hours before inverting onto a plate. Sprinkle powdered sugar on top if desired."
    },
    {
      "position": 7,
      "text": "Enjoy!"
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 15,

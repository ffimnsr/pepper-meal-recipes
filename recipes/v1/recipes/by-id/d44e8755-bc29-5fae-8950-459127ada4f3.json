  "id": "d44e8755-bc29-5fae-8950-459127ada4f3",
  "slug": "old-fashioned-creamy-rice-pudding",
  "name": "Best Old-Fashioned Creamy Rice Pudding",
  "recipe_type": "dessert",
  "brief_description": "Rice pudding with cooked rice is quick and easy to make on the stovetop. An egg, butter, and vanilla add flavor and richness to this classic dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place cooked rice in a medium saucepan. Add 1 \u00bd cups milk and salt; cook and stir over medium heat until thick and creamy, 15 to 20 minutes."
    },
    {
      "position": 3,
      "text": "Add remaining 1/2 cup milk, golden raisins, beaten egg, and white sugar; continue cooking, stirring continuously, until well blended, 2 to 3 minutes more."
    },
    {
      "position": 4,
      "text": "Remove saucepan from heat; stir in butter and vanilla extract."
    },
    {
      "position": 5,
      "text": "Serve warm and enjoy!"
    },
    {
      "position": 6,
      "text": "Store your rice pudding in an airtight container in the refrigerator for about three days. Reheat thoroughly on the stove, adding more milk as-needed to retain the creamy texture."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,

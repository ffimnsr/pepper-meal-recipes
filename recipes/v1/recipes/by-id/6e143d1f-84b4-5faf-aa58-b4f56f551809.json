{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "6e143d1f-84b4-5faf-aa58-b4f56f551809",
  "slug": "beef-and-guinness-stew",
  "name": "Beef and Guinness Stew",
  "recipe_type": "soup",
  "brief_description": "This Guinness beef stew from Chef John is a comforting Irish dish with a deep, complex, rich flavor. Dark beer does amazing things for the gravy.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Cook and stir bacon in a heavy skillet over medium-high heat until bacon is browned and crisp, 3 to 4 minutes. Turn off the heat and transfer bacon into a large stew pot, reserving bacon fat in the skillet."
    },
    {
      "position": 3,
      "text": "Season beef chuck cubes generously with 1 teaspoon salt and black pepper to taste. Turn heat to high under the skillet and sear beef pieces in the hot fat on both sides until browned, about 5 minutes. Place beef in the stew pot with bacon, leaving fat in the skillet."
    },
    {
      "position": 4,
      "text": "Turn heat down to medium; cook and stir onions in the retained fat in the skillet until lightly browned, 5 to 8 minutes; season with a large pinch of salt."
    },
    {
      "position": 5,
      "text": "Cook garlic with onions until soft, about 1 minute. Pour beer into the skillet and stir with a wooden spoon, scraping up and dissolving any browned bits of food into the liquid."
    },
    {
      "position": 6,
      "text": "Pour cooking liquid from the skillet into the stew pot. Stir in tomato paste, carrots, celery, thyme sprigs, sugar, 1/2 teaspoon black pepper, and enough chicken broth to cover."
    },
    {
      "position": 7,
      "text": "Bring stew to a gentle simmer, stirring to combine; reduce heat to low and cover pot."
    },
    {
      "position": 8,
      "text": "Simmer stew until beef is fork-tender, about 2 hours."
    },
    {
      "position": 9,
      "text": "Stir stew occasionally and skim fat or foam if desired."
    },
    {
      "position": 10,
      "text": "Remove cover and raise heat to medium-high. Bring stew to a low boil and cook until stew has slightly thickened, 15 to 20 minutes. Remove and discard thyme sprigs and adjust salt and pepper to taste."
    },
    {
      "position": 11,
      "text": "Arrange mashed potatoes in a ring in a serving bowl; ladle stew into the center of the potatoes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 150,
  "preparation_time_minutes": 30,

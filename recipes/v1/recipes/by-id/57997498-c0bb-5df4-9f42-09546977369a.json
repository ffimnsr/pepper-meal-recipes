  "id": "57997498-c0bb-5df4-9f42-09546977369a",
  "slug": "pistachio-hummus-recipe-11680823",
  "name": "Pistachio Hummus",
  "recipe_type": "appetizer",
  "brief_description": "This pistachio hummus gives traditional hummus\u2014a delicious, creamy, and savory spread on its own\u2014a unique texture and nutty flavor. Serve with your preferred dippers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Toast pistachios in a skillet over medium heat until golden brown, about 2 minutes. Cool to room temperature. Set 2 tablespoons pistachios aside."
    },
    {
      "position": 2,
      "text": "Combine toasted pistachios with 2 tablespoons oil and garlic in a food processor or blender and puree until smooth."
    },
    {
      "position": 3,
      "text": "Add chickpeas, lemon zest, lemon juice, salt, and pepper and continue to blend to an even, smooth consistency."
    },
    {
      "position": 4,
      "text": "Transfer to a small serving bowl, drizzle remaining oil on top, and sprinkle remaining pistachios on top."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

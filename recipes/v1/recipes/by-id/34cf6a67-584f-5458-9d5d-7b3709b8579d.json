  "id": "34cf6a67-584f-5458-9d5d-7b3709b8579d",
  "slug": "watermelon-summer-salad",
  "name": "Watermelon Summer Salad",
  "recipe_type": "salad",
  "brief_description": "Watermelon is tossed with onion, feta cheese and olives in this intriguing summer dish. Don't be scared by the ingredients, they work together to make a very tasty and refreshing salad. Go ahead and try it - be prepared for a pleasant surprise!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place the onion slices in a small bowl with the lime juice. The acid of the lime will mellow the flavor of the raw onion. Let stand for 10 minutes."
    },
    {
      "position": 2,
      "text": "In a large bowl, combine the watermelon cubes, feta cheese, black olives, onions with the lime juice, and mint. Drizzle olive oil over it all, and toss to blend. Dig in and be prepared for a pleasant surprise!"
    }
  ],
  "servings": 6,

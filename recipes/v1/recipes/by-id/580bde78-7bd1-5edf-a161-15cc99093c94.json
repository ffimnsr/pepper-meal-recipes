  "id": "580bde78-7bd1-5edf-a161-15cc99093c94",
  "slug": "giant-stuffed-mushrooms",
  "name": "Giant Stuffed Mushrooms",
  "recipe_type": "appetizer",
  "brief_description": "Portabello mushrooms are amazing and when they are baked with olive oil and then stuffed with an equally amazing kasha-based pilaf - flavored with carrots, and garlic - the end result is indescribable.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Remove the mushroom stems from the caps, and set the stems aside. Place the caps gill-side up on a baking sheet. Drizzle them with 1 tablespoon of the olive oil, and season with salt and pepper. Roast in the preheated oven for 25 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, prepare the pilaf stuffing. Chop mushroom stems. Heat the remaining olive oil in a skillet over medium heat. Cook chopped mushroom stems and garlic in oil until soft. Stir in the cilantro, carrot, celery and kasha; cook 2 minutes more. Pour in water. Bring the mixture to a boil, reduce heat to low, and place a lid on the pan. Simmer 20 minutes, or until the kasha is tender. Remove from the heat, and stir in parsley. Season to taste with salt and pepper."
    },
    {
      "position": 3,
      "text": "Stuff the warm mushroom caps with the pilaf, and serve."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 2,
  "preparation_time_minutes": null,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "schema_version": 1,
  "id": "36e274c7-86aa-5f81-9e89-382ca61fac98",
  "slug": "lyonnaise-potatoes",
  "name": "Lyonnaise Potatoes",
  "recipe_type": "side",
  "brief_description": "These Lyonnaise potatoes are a simple combination of par-boiled potatoes and caramelized onions baked in butter that taste absolutely extraordinary.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Peel potatoes and cut them into 1/2-inch slices. Place in a pot and cover with water; bring to a boil. Boil for 2 minutes, then drain and set aside."
    },
    {
      "position": 3,
      "text": "Heat a large oven-proof skillet over medium-high heat. Pour in olive oil, then add onions. Saut\u00e9 until lightly caramelized, 8 to 10 minutes. Stir in garlic and saut\u00e9 until onions are deep brown and garlic is soft. Transfer mixture to a bowl."
    },
    {
      "position": 4,
      "text": "Place the skillet back on the stove over low heat. Melt butter in the skillet, then cover the bottom with 1/3 of the potatoes. Season with salt and pepper. Cover potatoes with 1/2 of the onion mixture. Cover with 1/2 of the remaining potatoes; season with salt and pepper. Spread remaining onion mixture on top. Cover with remaining potatoes; season with salt and pepper."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until potatoes are tender and browned on top, 10 to 12 minutes."
    },
    {
      "position": 6,
      "text": "Use a spatula to transfer potatoes to a serving platter. Sprinkle with chopped parsley just before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

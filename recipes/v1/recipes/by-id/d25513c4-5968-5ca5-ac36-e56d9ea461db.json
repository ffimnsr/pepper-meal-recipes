  "id": "d25513c4-5968-5ca5-ac36-e56d9ea461db",
  "slug": "dill-chicken-salad-recipe-7487086",
  "name": "Dill Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "This chicken salad has a bright, fresh lemon dill flavor from the dressing, and is delicious served on toasted croissants.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spread pecans onto a baking sheet."
    },
    {
      "position": 2,
      "text": "Toast in the preheated oven until nuts start to turn golden brown and become fragrant, about 10 minutes. Remove from oven to cool to room temperature, about 10 minutes; chop."
    },
    {
      "position": 3,
      "text": "Whisk lemon juice, dill, sugar, mayonnaise and Greek yogurt together In a large bowl until smooth. Stir in celery, pecans, and shredded chicken."
    },
    {
      "position": 4,
      "text": "Stir in chicken broth as needed, 1 tablespoon at a time, until salad is your preferred texture. Season to taste with salt and black pepper."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

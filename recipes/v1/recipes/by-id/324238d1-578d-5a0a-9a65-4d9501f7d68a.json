  "id": "324238d1-578d-5a0a-9a65-4d9501f7d68a",
  "slug": "tofu-sandwich-spread",
  "name": "Tofu Sandwich Spread",
  "recipe_type": "main",
  "brief_description": "This tofu spread is a vegetarian favorite \u2014 try it on a sandwich or serve it with crackers for dipping. However you eat it, you'll be back for more!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Drain tofu and freeze overnight. Thaw and cut into quarters. Squeeze out any moisture by hand, then wrap in paper towels and squeeze again. Crumble into a medium bowl."
    },
    {
      "position": 2,
      "text": "Add celery, green onion, mayonnaise, soy sauce, and lemon juice. Stir until well blended."
    }
  ],
  "servings": 4,

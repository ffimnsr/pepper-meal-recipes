  "id": "bbe4d0f1-9e05-5397-8afd-dff31771a462",
  "slug": "steak-burrito-recipe-7561794",
  "name": "Steak Burrito",
  "recipe_type": "main",
  "brief_description": "This steak burrito is made from leftover steak, beans, rice, and everything else you love in a burrito.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Fold a paper towel around tortilla. Microwave on High until pliable, 5 to 10 seconds."
    },
    {
      "position": 2,
      "text": "Lay tortilla flat on a plate. Layer steak, rice, beans, cheese, onion, and cilantro in a line across the middle of the tortilla. Fold opposing edges of the tortilla to overlap the filling. Roll 1 of the opposing edges around the filling and tuck tortilla to form a burrito."
    }
  ],

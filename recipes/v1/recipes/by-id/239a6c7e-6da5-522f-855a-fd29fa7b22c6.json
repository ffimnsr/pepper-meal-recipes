  "slug": "great-mustard-relish",
  "name": "Great Mustard Relish",
  "recipe_type": "side",
  "brief_description": "Make this great mustard relish recipe with dill pickles, chopped onion, and your favorite yellow mustard \u2014 hot dogs, brats, and burgers will thank you.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Add pickles to the bowl of a food processor; pulse into \u00bc-inch pieces. Transfer minced pickles to a bowl."
    },
    {
      "position": 2,
      "text": "Add onions to the bowl of the food processor; pulse into \u00bc-inch pieces. Transfer minced onions to bowl with pickles."
    },
    {
      "position": 3,
      "text": "Stir mustard into pickles and onions until well blended."
    }
  ],

  "id": "0c73ee81-7d66-5fbf-b201-b94d6a3ccee6",
  "slug": "quick-pasta-sauce",
  "name": "Quick Pasta Sauce",
  "recipe_type": "side",
  "brief_description": "This easy pasta sauce made with canned crushed tomatoes, fresh garlic, and dried basil is super quick to prep and cooks in less than 30 minutes!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over low heat; add garlic and saut\u00e9 until tender, about 2 minutes."
    },
    {
      "position": 3,
      "text": "Stir in crushed tomatoes, basil, salt, and pepper. Simmer, stirring occasionally, until slightly thickened, 15 to 20 minutes. Serve immediately."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 5,

  "id": "5ba5c9a6-67d9-51a9-98c6-94f2c57817bc",
  "slug": "apple-cider-margarita-recipe-7686376",
  "name": "Apple Cider Margarita",
  "recipe_type": "appetizer",
  "brief_description": "This apple cider margarita is a nice fall twist on traditional margaritas using apple cider, tequila, cinnamon whiskey, butterscotch schnapps, and lime.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Moisten the rim of two margarita glasses with honey. Stir cinnamon and sugar together on a plate. Lightly dip the moistened rim of each glass into cinnamon and sugar mixture."
    },
    {
      "position": 2,
      "text": "Fill a cocktail shaker with fresh ice. Add apple cider, tequila, cinnamon whiskey, and butterscotch schnapps. Squeeze 2 limes into the shaker. Cover and shake vigorously until the outside of the shaker has frosted."
    },
    {
      "position": 3,
      "text": "Fill 2 glasses with ice; strain mixture into glasses. Garnish with apple slices."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 0,
  "preparation_time_minutes": 5,

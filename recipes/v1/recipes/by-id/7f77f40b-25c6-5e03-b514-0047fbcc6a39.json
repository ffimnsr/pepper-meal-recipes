  "slug": "strawberry-oatmeal-breakfast-smoothie",
  "name": "Strawberry Oatmeal Breakfast Smoothie",
  "recipe_type": "breakfast",
  "brief_description": "This oatmeal smoothie has a deep pink color and a rich, creamy texture. It's fast, filling, and delicious \u2014 perfect for a quick on-the-go breakfast!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather ingredients."
    },
    {
      "position": 2,
      "text": "Blend soy milk, oats, strawberries, and banana in a blender until smooth. Add sugar and vanilla and blend again until smooth."
    },
    {
      "position": 3,
      "text": "Pour into glasses and serve."
    }
  ],

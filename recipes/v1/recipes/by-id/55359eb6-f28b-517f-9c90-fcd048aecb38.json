{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "55359eb6-f28b-517f-9c90-fcd048aecb38",
  "slug": "ground-beef-and-broccoli-stir-fry-recipe-8679070",
  "name": "Ground Beef Stir Fry",
  "recipe_type": "main",
  "brief_description": "This ground beef stir fry combines tender broccoli, savory beef, and a quick homemade sauce in one pan for an easy, flavorful weeknight dinner.",
  "cuisine": "American Chinese",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk together beef broth, soy sauce, brown sugar, cornstarch, ginger, garlic, and rice vinegar in a bowl until combined and sugar and cornstarch are dissolved; set aside."
    },
    {
      "position": 3,
      "text": "Heat 2 tablespoons of the oil in a large skillet over medium-high heat until shimmering. Add onion, and cook, stirring occasionally, until softened, about 2 minutes. Add broccoli, and cook, stirring occasionally, until bright green, tender-crisp, and onion is browned, 6 to 7 minutes. Transfer to a plate. Do not wipe skillet clean."
    },
    {
      "position": 4,
      "text": "Reduce the heat to medium, and add remaining 1 tablespoon oil to skillet. Add ground beef and salt, and cook, stirring often to break meat into even crumbles, until browned and cooked through, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Whisk broth mixture again, and pour into skillet. Cook over medium heat, stirring constantly, until sauce thickens slightly, 3 to 5 minutes. Return broccoli mixture to skillet, and cook, stirring occasionally, until sauce evenly coats meat and vegetables, 3 to 4 minutes."
    },
    {
      "position": 6,
      "text": "Serve over rice, and garnish with scallions and toasted sesame seeds. Recipe developed by Catherine Jessee"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

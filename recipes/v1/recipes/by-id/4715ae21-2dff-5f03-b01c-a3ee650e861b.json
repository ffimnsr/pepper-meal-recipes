  "id": "4715ae21-2dff-5f03-b01c-a3ee650e861b",
  "slug": "sweet-and-spicy-pumpkin-seeds",
  "name": "Sweet and Spicy Pumpkin Seeds",
  "recipe_type": "appetizer",
  "brief_description": "Butter, salt, Worcestershire sauce, brown sugar, and hot sauce are all you need to spice up your pumpkin seed haul from Halloween decorating or any fall cooking involving pumpkins.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 300 degrees F (150 degrees C). Line a baking pan with aluminum foil."
    },
    {
      "position": 2,
      "text": "Stir together the pumpkin seeds and butter in a bowl. Add the salt, Worcestershire sauce, brown sugar, and hot pepper sauce; stir. Spread the seeds in a single layer on the baking pan."
    },
    {
      "position": 3,
      "text": "Bake in preheated oven until crispy, about 45 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,

  "id": "40f9da53-c1b3-57ca-8be9-ae7044350a28",
  "slug": "cherry-zucchini-bread",
  "name": "Cherry-Zucchini Bread",
  "recipe_type": "dessert",
  "brief_description": "When your garden is overflowing with zucchini, try this delicious zucchini bread with sweet cherries--it's so delicious, nobody will know it's got zucchini in it!",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease and flour 5 mini loaf pans."
    },
    {
      "position": 2,
      "text": "Combine flour, cinnamon, nutmeg, baking powder, baking soda, and salt in a bowl."
    },
    {
      "position": 3,
      "text": "Beat eggs in a separate, large bowl with an electric mixer. Add sugar, grated zucchini, coconut oil, buttermilk, and vanilla extract; beat until combined. Add flour mixture and blend until just combined. Fold in pecans, chopped cherries, and cherry juice. Transfer batter into the prepared loaf pans."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 35 to 40 minutes."
    }
  ],
  "servings": 20,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

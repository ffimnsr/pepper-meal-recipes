{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "c826eae0-03de-5a45-aa75-7b5afc9e69e6",
  "slug": "pecan-pie-cheesecake",
  "name": "Pecan Pie Cheesecake",
  "recipe_type": "dessert",
  "brief_description": "This pecan pie cheesecake has a creamy filling and a gooey caramel pecan pie topping on a crunchy pecan crust for a decadent holiday dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9-inch springform pan with cooking spray; line bottom with a round of parchment paper, and wrap outside of pan with heavy duty aluminum foil. To make the crust: Combine graham cracker crumbs, pecans, sugar, cinnamon, and salt for the crust in a bowl. Stir in melted butter until mixture has a sand-like consistency."
    },
    {
      "position": 2,
      "text": "Press crumb mixture evenly into the bottom and up the sides of the prepared pan using a flat-bottomed measuring cup or your fingers."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven on the center oven rack until lightly browned and fragrant, about 10 minutes. Remove from oven and cool on a wire rack for 15 minutes. Reduce oven temperature to 325 degrees F (165 degrees C), and place oven rack in lower third position."
    },
    {
      "position": 4,
      "text": "Meanwhile, make the cheesecake filling: Combine cream cheese and brown sugar in a food processor and process until smooth and no lumps remain, about 45 seconds, scraping down sides as needed. Add eggs, 1 at a time, pulsing once after each addition. Add sour cream, flour, vanilla, cinnamon, and salt; pulse 2 to 3 times or until combined. Pour batter into cooled crust."
    },
    {
      "position": 5,
      "text": "Bake cheesecake in the hot oven at 325 degrees F (165 degrees C) on rack in lower third position until center jiggles slightly, 45 to 50 minutes. Turn oven off, prop oven door open slightly, and let cheesecake stand in oven 1 hour. Remove from oven, discard foil, and run a knife around around edge of crust to release from pan (to avoid cracks while cooling). Cover with plastic wrap, and chill at least 6 hours or overnight."
    },
    {
      "position": 6,
      "text": "To make the pecan pie topping: Set a a medium nonstick saucepan over low heat. Add sugar in an even layer and cook over low, undisturbed, until warm, about 2 minutes. Add water, and stir constantly until all the sugar is melted, about 45 seconds. Add butter, stirring constantly until butter is melted and incorporated, about 30 seconds."
    },
    {
      "position": 7,
      "text": "Increase heat to medium; add heavy cream, rum, cinnamon, and vanilla, and cook, stirring constantly, until well combined and slightly thickened, about 2 minutes. Add pecans, stirring until well coated, and remove from heat. Cool until room temperature and thickened, about 30 minutes."
    },
    {
      "position": 8,
      "text": "Remove cheesecake from the refrigerator, and carefully remove from springform pan. Place on a serving platter, and top with cooled pecan pie topping. Serve immediately, or allow cheesecake to soften for 15 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,

  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "1eefd0ba-d3b5-56d9-8413-820d422f6f62",
  "slug": "chicken-tikka-masala",
  "name": "Chicken Tikka Masala",
  "recipe_type": "main",
  "brief_description": "Chicken tikka masala made easy with this delicious recipe. Marinate chicken in yogurt and spices, grill, then simmer together in a tomato cream sauce.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine yogurt, lemon juice, 2 teaspoons cumin, cinnamon, cayenne, black pepper, ginger, and 1 teaspoon salt in a large bowl."
    },
    {
      "position": 3,
      "text": "Stir in chicken, cover, and refrigerate for 1 hour."
    },
    {
      "position": 4,
      "text": "Preheat a grill for high heat. Lightly oil the grill grate. Thread chicken onto skewers, and discard marinade."
    },
    {
      "position": 5,
      "text": "Grill until juices run clear, about 5 minutes on each side."
    },
    {
      "position": 6,
      "text": "Melt butter in a large heavy skillet over medium heat. Saut\u00e9 garlic and jalape\u00f1o for 1 minute. Season with remaining 2 teaspoons cumin, paprika, and remaining 1 teaspoon salt. Stir in tomato sauce and cream. Simmer on low heat until sauce thickens, about 20 minutes."
    },
    {
      "position": 7,
      "text": "Add grilled chicken, and simmer for 10 minutes."
    },
    {
      "position": 8,
      "text": "Transfer to a serving platter, and garnish with fresh cilantro. Serve over rice."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "hard",

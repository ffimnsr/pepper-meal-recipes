  "id": "6dd6b86d-1753-5aef-b47a-7df786cce237",
  "slug": "pepperoni-casserole",
  "name": "Pepperoni Casserole",
  "recipe_type": "main",
  "brief_description": "Tender pasta with sauce and Italian sausage is topped with mozzarella, cottage cheese, and a layer of pepperoni for a hearty baked noodle casserole.",
  "cuisine": "Italian Inspired Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch casserole dish."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Place pasta in the pot, cook for 8 to 10 minutes, until al dente, and drain."
    },
    {
      "position": 3,
      "text": "Cook sausage in a skillet over medium heat until evenly browned."
    },
    {
      "position": 4,
      "text": "Combine cooked pasta, sausage, and pasta sauce in the prepared casserole dish. Mix cottage cheese, olives, and mozzarella cheese in a bowl; spoon over sausage and pasta mixture. Top with pepperoni slices."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until bubbly and lightly browned on top, about 25 to 30 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,

  "slug": "easy-chicken-and-bell-pepper-fajitas",
  "name": "Easy Chicken and Bell Pepper Fajitas",
  "recipe_type": "main",
  "brief_description": "Chicken tenderloins, bell peppers, and onion are sauteed in this quick and easy recipe for chicken fajitas that's perfect for Mexican night.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Mix garlic powder, chili powder, paprika, and basil in a large bowl. Add chicken strips; stir to coat with garlic powder mixture."
    },
    {
      "position": 2,
      "text": "Heat oil in a large skillet over medium heat. Add chicken, onion, green bell pepper, and red bell pepper; cook and stir until chicken is no longer pink and vegetables are tender, 7 to 10 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 7,

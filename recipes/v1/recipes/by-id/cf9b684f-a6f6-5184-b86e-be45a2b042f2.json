  "id": "cf9b684f-a6f6-5184-b86e-be45a2b042f2",
  "slug": "creamy-quinoa-risotto",
  "name": "Creamy Quinoa Risotto",
  "recipe_type": "main",
  "brief_description": "Replace arborio rice with quinoa to make a creamy and delicious quinoa risotto for a whole-grain version of the traditional meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Rinse quinoa twice and drain well."
    },
    {
      "position": 2,
      "text": "Pour chicken broth into a saucepan; bring to a boil."
    },
    {
      "position": 3,
      "text": "Melt butter in a separate saucepan over medium-high heat; saute onion and garlic until onion is soft, about 5 minutes. Stir quinoa into onion mixture; cook, stirring frequently, until quinoa is toasted and coated in oil, about 3 minutes."
    },
    {
      "position": 4,
      "text": "Slowly pour wine over quinoa mixture; cook and stir until wine is absorbed, about 5 minutes. Ladle 1/2 cup chicken broth over quinoa mixture; cook, stirring frequently, until absorbed, 3 to 5 minutes. Continue ladling broth, 1/2 cup at a time, over quinoa mixture; cook, stirring frequently, until quinoa is tender and has burst, about 20 minutes. You may not use all the chicken broth."
    },
    {
      "position": 5,
      "text": "Mix Parmesan cheese and cream into quinoa mixture; season with marjoram, thyme, salt, and pepper. Add a splash of chicken broth to make quinoa more creamy, if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

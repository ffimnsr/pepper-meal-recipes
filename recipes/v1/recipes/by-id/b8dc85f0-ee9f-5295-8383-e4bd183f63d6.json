  "slug": "mango-chipotle-guacamole",
  "name": "Mango Chipotle Guacamole",
  "recipe_type": "appetizer",
  "brief_description": "With a smoky twist on traditional guacamole, this dip gets a kick from chipotle powder and sweet notes from mango. It's excellent with chips or paired with carne asada or carnitas.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Mash avocados in a small bowl, leaving chunks if desired. Mix in mango, garlic, cilantro, lime juice, chipotle powder and salt. Serve immediately."
    }
  ],
  "servings": 4,

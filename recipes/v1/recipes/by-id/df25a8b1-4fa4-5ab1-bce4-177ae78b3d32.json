{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "df25a8b1-4fa4-5ab1-bce4-177ae78b3d32",
  "slug": "garlic-butter-steak-bites-with-mushrooms-recipe-8751632",
  "name": "Garlic Butter Steak Bites With Mushrooms",
  "recipe_type": "appetizer",
  "brief_description": "These garlic butter steak bites with mushrooms are marinated for just a short while, then quickly seared in a skillet. Combined with sauteed mushrooms, onions, and garlic butter, they can easily be an appetizer or a main course.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine coconut aminos, red wine vinegar, 1 tablespoon olive oil, salt, and pepper in a large resealable plastic bag. Seal the bag and gently squeeze ingredients to mix."
    },
    {
      "position": 2,
      "text": "Add steak pieces to marinade, squeeze the air out, and seal. Gently move steak pieces around inside the bag to coat with marinade. Refrigerate at least 15 to 20 minutes, but no longer than 1 hour."
    },
    {
      "position": 3,
      "text": "Meanwhile, melt 2 tablespoons butter in a microwave-safe dish, stir in minced garlic, and set aside. Drain marinade from steak pieces and gently blot with paper towels."
    },
    {
      "position": 4,
      "text": "Heat remaining butter over medium-high heat in a large skillet. When butter is sizzling, add steak pieces in a single layer and sear until browned, 1 to 2 minutes per side. Brown in 2 batches, if needed. Remove steak from skillet to a plate and tent with foil; set aside to rest."
    },
    {
      "position": 5,
      "text": "Add mushrooms and onions to the same skillet. Stir frequently until mushrooms and onions begin to pick up some color, about 2 minutes. Add about 2 tablespoons water, if skillet seems dry, and turn heat down to medium."
    },
    {
      "position": 6,
      "text": "Add garlic butter to the skillet, and cook until vegetables are tender, about 3 to 5 minutes more. Stir in steak pieces and any accumulated juices, and coat with garlic butter in the skillet. Sprinkle parsley over skillet and remove from heat. Garnish with additional fresh parsley sprigs, if desired."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "18b1ef71-46c5-535b-a8aa-a2f95e36ca9c",
  "slug": "spiced-plum-upside-down-cake-with-oats",
  "name": "Spiced Plum Upside-Down Cake with Oats",
  "recipe_type": "dessert",
  "brief_description": "This spiced plum cake is a makeover of the classic pineapple upside-down cake, with the addition of oats.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine oats and water in a medium bowl. Let sit for 20 minutes."
    },
    {
      "position": 3,
      "text": "Combine brown sugar, 1/2 cup butter, white sugar, eggs, and vanilla extract in a large bowl. Add oatmeal mixture and mix until combined."
    },
    {
      "position": 4,
      "text": "Sift flour, baking soda, 1 teaspoon cinnamon, nutmeg, salt, and allspice together in a bowl. Add to oatmeal mixture."
    },
    {
      "position": 5,
      "text": "Place 2 tablespoons butter in a 9-inch square baking pan and melt in the preheated oven. Remove from the oven and sprinkle sugar and cinnamon on top. Sprinkle plums evenly over sugar. Pour batter over plums and spread evenly."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 50 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

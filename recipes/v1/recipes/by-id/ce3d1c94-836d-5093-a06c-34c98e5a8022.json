  "id": "ce3d1c94-836d-5093-a06c-34c98e5a8022",
  "slug": "hot-artichoke-and-spinach-dip-ii",
  "name": "Hot Spinach Artichoke Dip",
  "recipe_type": "appetizer",
  "brief_description": "This spinach artichoke dip is deliciously cheesy, creamy, and easy to make! Serve this flavorful dip hot with toasted bread or tortilla chips.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a small baking dish."
    },
    {
      "position": 2,
      "text": "Mix cream cheese, mayonnaise, Parmesan cheese, Romano cheese, garlic, basil, garlic salt, salt, and pepper together in a medium bowl."
    },
    {
      "position": 3,
      "text": "Gently stir in artichoke hearts and spinach."
    },
    {
      "position": 4,
      "text": "Transfer the mixture to the prepared baking dish; top with mozzarella cheese."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until bubbly and lightly browned, about 25 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

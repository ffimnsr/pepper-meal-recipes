  "id": "c6c17449-b6e0-5a68-9674-245ac769e288",
  "slug": "caramel-frosting-i",
  "name": "Caramel Frosting",
  "recipe_type": "dessert",
  "brief_description": "This quick caramel frosting, made with brown sugar, butter, and milk, is an easy, smooth, sweet icing for topping cakes, cookies, and bars.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a saucepan over medium heat. Stir in brown sugar and 3 tablespoons milk. Boil vigorously for 1 minute."
    },
    {
      "position": 3,
      "text": "Remove from heat and stir in 1/2 cup confectioners' sugar."
    },
    {
      "position": 4,
      "text": "Cool slightly, then beat in vanilla and remaining 1/2 cup confectioners\u2019 sugar. Add additional milk, 1 teaspoon at a time, if frosting is too thick."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

  "schema_version": 1,
  "id": "59197254-11ca-5909-9cf5-812bf4c9e5b7",
  "slug": "sweet-and-spicy-pepper-relish",
  "name": "Sweet and Spicy Pepper Relish",
  "recipe_type": "dessert",
  "brief_description": "This easy pepper relish made with spicy chiles, onion, bell pepper, sugar, and vinegar makes a sweet and tangy condiment for hot dogs and burgers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Wearing rubber or latex gloves, trim tops off chiles. Pulse chiles, bell peppers, and onion in a food processor, working in batches, until finely chopped, about 1 minute per batch. Transfer to a nonreactive 3-quart pot."
    },
    {
      "position": 2,
      "text": "Stir sugar, vinegar, and pickling salt into chile mixture; bring to a boil. Reduce heat to medium and simmer, stirring more frequently toward the end of cooking to prevent scorching, until thickened, 20 to 30 minutes."
    },
    {
      "position": 3,
      "text": "Ladle relish into wide-mouth, \u00bd-pint jars, leaving \u00bd inch headspace. Wipe the rims clean with a damp paper towel. Let cool to room temperature, about 1 hour."
    },
    {
      "position": 4,
      "text": "Screw on the lids and store in the refrigerator for 2 to 3 weeks or the freezer for up to 6 months."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

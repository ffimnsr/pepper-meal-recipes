  "slug": "ranch-dressing-ii",
  "name": "Homemade Ranch Dressing",
  "recipe_type": "salad",
  "brief_description": "This ranch dressing recipe is easy to make at home with sour cream, mayo, and herbs for a creamy salad dressing that tastes better than store-bought!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk mayonnaise, sour cream, chives, parsley, dill, garlic powder, onion powder, salt, and pepper together in a large bowl until well-combined."
    },
    {
      "position": 3,
      "text": "Cover and refrigerate for 30 minutes before serving."
    }
  ],
  "servings": 12,

  "id": "ac1e7944-0c4c-550c-b81a-952fe96d080d",
  "slug": "salted-caramel-chocolate-pecan-cookies",
  "name": "Salted Caramel Chocolate Pecan Cookies",
  "recipe_type": "dessert",
  "brief_description": "These chocolate pecan cookies are shortbread-style thumbprint confections coated in pecans, filled with salted caramel, and drizzled with chocolate.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 3 to 4 baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Beat butter and sugar together in a bowl using an electric mixer until pale and fluffy. Beat in vanilla extract. Reduce mixer speed to low and gradually beat in flour and 1/2 teaspoon salt. Press dough together in plastic wrap; roll dough into 1 1/2-inch balls."
    },
    {
      "position": 3,
      "text": "Place beaten eggs in one small dish and pecans in another dish. Dip each dough ball into the eggs and roll in pecans. Place dredged balls on the prepared baking sheets; press your thumb into the center of each ball."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 10 minutes. Press each cookie again, with a spoon. Return to the oven and continue baking until golden, about 10 minutes more. Cool on wire racks."
    },
    {
      "position": 5,
      "text": "Combine caramels and heavy cream in a small saucepan over low heat. Cook, stirring constantly, until caramels are melted and mixture is smooth, 4 to 6 minutes. Spoon the mixture into the thumbprints of the cookies and sprinkle with sea salt."
    },
    {
      "position": 6,
      "text": "Melt chocolate chips in a microwave-safe bowl in 15-second intervals, stirring after each melting, 1 to 3 minutes. Stir in oil. Drizzle chocolate over the cookies."
    }
  ],
  "servings": 48,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "259036d8-8764-5530-b004-d98429cf255a",
  "slug": "mediterranean-chicken-sheet-pan-dinner",
  "name": "Mediterranean Chicken Sheet Pan Dinner",
  "recipe_type": "main",
  "brief_description": "Bold Mediterranean flavors and colors combine on one sheet pan for a simple yet impressive dinner with chicken, potatoes, bell peppers, and olives. Bonus is the minimal cleanup!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a large rimmed baking sheet with aluminum foil."
    },
    {
      "position": 2,
      "text": "Whisk olive oil, juice of 1 lemon, vinegar, tarragon, oregano, paprika, salt, and pepper together in a large bowl."
    },
    {
      "position": 3,
      "text": "Add chicken thighs, onion, baby bell peppers, and potatoes. Stir until everything is evenly coated."
    },
    {
      "position": 4,
      "text": "Transfer vegetable-chicken mixture to the prepared baking sheet and spread in an even layer. Scatter lemon slices over the vegetables, making sure to leave the chicken uncovered so that the skin will brown."
    },
    {
      "position": 5,
      "text": "Bake in preheated oven for about 40 minutes. Remove from oven and top with feta, parsley, and olives."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

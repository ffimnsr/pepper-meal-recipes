  "id": "4247ce1d-644c-5056-a104-a5354ec4c0e6",
  "slug": "healthy-peanut-butter-mousse",
  "name": "Healthy Peanut Butter Mousse",
  "recipe_type": "appetizer",
  "brief_description": "Whip up this quick and easy mousse with peanut butter, Greek yogurt, and chocolate chips the next time you need a healthy after-school snack.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Microwave peanut butter in a microwave-safe bowl until liquid and smooth, about 20 seconds."
    },
    {
      "position": 2,
      "text": "Stir Greek yogurt into the peanut butter with a spoon until smooth, scraping off any peanut butter stuck to the spoon. Stir in stevia and vanilla extract. Fold in chocolate chips."
    }
  ],
  "servings": 1,
  "cooking_time_minutes": 1,

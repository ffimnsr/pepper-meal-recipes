  "id": "6ce43304-2fd3-5c8e-b846-0adf84c10102",
  "slug": "enchilada-casserole-iii",
  "name": "Enchilada Casserole",
  "recipe_type": "main",
  "brief_description": "This enchilada casserole recipe layers corn tortillas dipped in enchilada sauce with savory beef, beans, and cheese for a comforting, delicious dinner.",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix dry enchilada sauce according to package directions, replacing tomato sauce with the tomato paste and water."
    },
    {
      "position": 3,
      "text": "Cook ground beef with garlic salt and onion powder in a large skillet until browned and crumbly, about 5 to 7 minutes; drain fat."
    },
    {
      "position": 4,
      "text": "Mix refried beans and 1/2 cup of the prepared enchilada sauce with the beef."
    },
    {
      "position": 5,
      "text": "Dip enough corn tortillas to cover the bottom of a 3 quart casserole dish in the remaining enchilada sauce. Arrange tortillas in the dish."
    },
    {
      "position": 6,
      "text": "Spoon in half of the meat mixture, covering the tortillas. Spread half of the Cheddar and Monterey Jack cheeses over the beef."
    },
    {
      "position": 7,
      "text": "Cover with another layer of tortillas dipped in enchilada sauce. Spoon in remaining beef mixture and top with a final layer of tortillas dipped in enchilada sauce. Pour any remaining sauce over the layers and top with remaining cheese."
    },
    {
      "position": 8,
      "text": "Cover and bake in preheated oven for 20 minutes. Remove from oven and let sit for 5 minutes before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

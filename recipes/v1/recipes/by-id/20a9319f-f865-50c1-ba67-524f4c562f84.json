  "id": "20a9319f-f865-50c1-ba67-524f4c562f84",
  "slug": "air-fryer-apple-cobbler-bites-recipe-12068032",
  "name": "Air Fryer Apple Cobbler Bites",
  "recipe_type": "appetizer",
  "brief_description": "This air fryer apple cobbler bites recipe makes a warm, cozy snack in just minutes. Apple slices are piled with a buttery brown sugar and oat topping that caramelizes beautifully in the air fryer for an easy taste of apple cobbler.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine apple slices and lemon juice in a large mixing bowl; toss until well coated."
    },
    {
      "position": 2,
      "text": "Combine oats, brown sugar, butter, flour, cinnamon, apple pie spice, and salt in a second bowl until a crumbly mixture forms."
    },
    {
      "position": 3,
      "text": "Working in batches, press the crumble mixture onto one side of each apple slice and place into a prepared air fryer basket."
    },
    {
      "position": 4,
      "text": "Air fry at 400 degrees F (200 degrees C) for 3 minutes. Flip each slice and top each slice with more crumble. Air fry for 2 minutes more."
    },
    {
      "position": 5,
      "text": "Lay apples on a plate to cool. Drizzle with caramel sauce before serving."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

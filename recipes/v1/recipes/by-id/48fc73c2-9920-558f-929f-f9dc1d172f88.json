  "id": "48fc73c2-9920-558f-929f-f9dc1d172f88",
  "slug": "quick-classic-gazpacho",
  "name": "Quick Classic Gazpacho",
  "recipe_type": "soup",
  "brief_description": "This gazpacho with canned tomatoes, cucumber, and jalape\u00f1o is a fine substitute for any version made with fresh, vine-ripened tomatoes.",
  "cuisine": "Spanish",
  "instructions": [
    {
      "position": 1,
      "text": "Pour 1/2 cup diced tomatoes into a food processor. Add water and oil to the food processor; blend until pur\u00e9ed. Pour into a medium bowl and add remaining diced tomatoes."
    },
    {
      "position": 2,
      "text": "Stir in cucumber, bell pepper, onion, jalape\u00f1o, garlic, vinegar, and parsley; season with salt and pepper. Cover and refrigerate for at least 2 hours before serving."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": null,

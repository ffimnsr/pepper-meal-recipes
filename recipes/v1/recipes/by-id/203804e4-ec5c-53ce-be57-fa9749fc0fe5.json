  "id": "203804e4-ec5c-53ce-be57-fa9749fc0fe5",
  "slug": "sliced-steak-peppers-and-mushrooms-in-the-oven",
  "name": "Sliced Steak, Peppers, and Mushrooms in the Oven",
  "recipe_type": "main",
  "brief_description": "For this recipe, cook flank steak in the oven with onions, peppers, mushrooms, and tomatoes. Serve it with rice, noodles, or potatoes for a fast meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine oil, herb seasoning, paprika, and salt in a 9x13-inch baking pan. Add steak slices, undrained tomatoes, mushrooms, onion, and bell pepper; stir to combine."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven, uncovered, until vegetables are tender and steak is cooked through, about 25 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,

  "slug": "margaritas",
  "name": "Frozen Margaritas",
  "recipe_type": "drink",
  "brief_description": "This frozen margarita recipe uses frozen limeade concentrate for an easy twist on the classic recipe. Making a margarita has never been easier!",
  "cuisine": "Mexican Inspired Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a blender with crushed ice. Pour in limeade concentrate, tequila, and triple sec; blend until smooth. Pour into margarita glasses and serve with lime wedges if desired."
    }
  ],

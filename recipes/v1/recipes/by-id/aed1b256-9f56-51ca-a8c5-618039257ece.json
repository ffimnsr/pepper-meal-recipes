  "id": "aed1b256-9f56-51ca-a8c5-618039257ece",
  "slug": "pineapple-heaven-cake-recipe-11949726",
  "name": "Pineapple Heaven Cake",
  "recipe_type": "dessert",
  "brief_description": "This pineapple heaven cake bakes in a 9x13-inch pan, with crushed pineapple in the batter, a lovely pineapple glaze, and a final touch of whipped cream and coconut. It's moist with a ton of pineapple flavor.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan."
    },
    {
      "position": 2,
      "text": "Combine cake mix, undrained crushed pineapple, the eggs, and 1/2 cup of the melted butter in a bowl. Beat with an electric mixer on medium speed 2 minutes. Spread batter evenly in prepared pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until a toothpick inserted in center has a few moist crumbs, 30 to 35 minutes."
    },
    {
      "position": 4,
      "text": "Cool cake completely on a wire rack, about 1 hour."
    },
    {
      "position": 5,
      "text": "Whisk together 1 cup powdered sugar, 1 tablespoon melted butter and 2 tablespoons of reserved pineapple juice in a small bowl. Whisk in additional pineapple juice, 1 teaspoon at a time to reach spreadable consistency. Drizzle and gently spread over cooled cake. Top with pineapple tidbits."
    },
    {
      "position": 6,
      "text": "Beat whipping cream with an electric mixer in a medium bowl until it thickens. Add 1 tablespoon powdered sugar and the vanilla. Beat until the cream holds soft peaks."
    },
    {
      "position": 7,
      "text": "Top each serving with sweetened whipped cream and coconut."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 15,

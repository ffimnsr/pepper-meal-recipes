  "id": "ca8236e1-2c50-5812-a8f7-2dc9850fce38",
  "slug": "pear-scones",
  "name": "Pear Scones",
  "recipe_type": "breakfast",
  "brief_description": "This quick and easy pear scones recipe takes less than 30 minutes to make and uses fresh chopped pear, brown sugar, and cinnamon for a homemade treat.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Whisk flour, brown sugar, baking powder, cinnamon, and salt together in a bowl; cut in butter with 2 knives or a pastry blender until mixture resembles coarse crumbs."
    },
    {
      "position": 3,
      "text": "Whisk half-and-half and egg together in a separate bowl; stir into flour mixture until moistened. Stir in pear. Drop large spoonfuls of dough onto an ungreased baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until golden brown, about 15 minutes. Cool slightly on wire rack before serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 20,

  "id": "c775a0e2-c986-510b-854f-c48424a0c5c5",
  "slug": "candied-carrots",
  "name": "Candied Carrots",
  "recipe_type": "side",
  "brief_description": "These candied carrots are made with tender, boiled carrots cooked in a buttery brown sugar sauce until glazed for a colorful, crowd-pleasing side.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Place carrots in a pot of salted water; bring to a boil. Reduce heat to a low boil and cook until tender but not mushy, about 15 minutes. Drain and return carrots to the pot."
    },
    {
      "position": 3,
      "text": "Place the pot with carrots over the lowest possible heat setting. Stir in brown sugar, butter, salt, and pepper. Cook until sugar is bubbly, 3 to 5 minutes."
    },
    {
      "position": 4,
      "text": "Serve hot."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 25,

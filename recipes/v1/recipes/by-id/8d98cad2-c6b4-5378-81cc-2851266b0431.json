  "id": "8d98cad2-c6b4-5378-81cc-2851266b0431",
  "slug": "stuffed-portobello-mushroom-caps",
  "name": "Stuffed Portobello Mushroom Caps",
  "recipe_type": "appetizer",
  "brief_description": "This stuffed portabello mushroom caps recipe mixes two types of bread crumbs and cheese with crabmeat for a tasty topping to your portobellos.",
  "cuisine": "American Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Mix crabmeat, Italian-style bread crumbs, panko, Parmesan cheese, mozzarella cheese, egg, milk, and butter in a bowl until thick yet pliable enough to shape. Divide and roll into 12 1-inch balls."
    },
    {
      "position": 3,
      "text": "Gently press balls into mushroom caps and press to spread into a rounded mound atop mushrooms."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until heated through and golden on top, about 30 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

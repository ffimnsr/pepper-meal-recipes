  "id": "e7525750-83c1-5440-953e-c56f37f4f393",
  "slug": "raspberry-almond-kiss-cookies",
  "name": "Raspberry Almond Kiss Cookies",
  "recipe_type": "dessert",
  "brief_description": "So easy and tasty too. I got this recipe from my mother in law years ago. I prefer them without the kisses however they are good with or without them.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "In a medium bowl, cream together the butter, 1/2 cup white sugar and brown sugar until smooth. blend in the egg and 1 teaspoon almond extract. Combine the flour, baking soda and salt; stir into the creamed mixture. Cover dough and refrigerate for at least one hour, or until easy to handle."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Roll dough into 1 inch balls, roll the balls in the remaining white sugar and place them 2 inches apart onto ungreased cookie sheets."
    },
    {
      "position": 3,
      "text": "Bake for 10 to 12 minutes in the preheated oven, or until golden brown. While hot from the oven, immediately press a chocolate kiss into the center of each one. Remove from cookie sheets to cool on wire racks."
    },
    {
      "position": 4,
      "text": "In a small bowl, mix together the confectioners' sugar, milk, raspberry jam and 1/4 teaspoon almond extract until smooth. Drizzle over cooled cookies."
    }
  ],
  "servings": 36,
  "cooking_time_minutes": 10,

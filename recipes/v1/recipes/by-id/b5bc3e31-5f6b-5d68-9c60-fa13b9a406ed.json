  "schema_version": 1,
  "id": "b5bc3e31-5f6b-5d68-9c60-fa13b9a406ed",
  "slug": "luscious-blueberry-pie-perfection",
  "name": "Luscious Blueberry Pie Perfection!",
  "recipe_type": "dessert",
  "brief_description": "This luscious blueberry pie perfection recipe lets the flavor of fresh blueberries shine through in a delectable, warmly spiced gingersnap crumb crust.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to to 350 degrees F (175 degrees C) with an oven rack in center position."
    },
    {
      "position": 2,
      "text": "Combine gingersnap crumbs, brown sugar, and butter in a bowl; press into bottom and up the sides of a 9-inch pie plate."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven on the center rack until just set, 3 to 4 minutes (do not overbake or crust will be too hard to cut). Cool."
    },
    {
      "position": 4,
      "text": "Stir cornstarch and water together in a saucepan until smooth; add 1 \u00bd cups blueberries and white sugar. Bring to a boil over medium heat, stirring until thickens, 1 to 2 minutes. Off heat, stir in remaining 2 \u00bd cups blueberries and lemon juice."
    },
    {
      "position": 5,
      "text": "Pour blueberry filling into crust; refrigerate until set, at least 1 hour."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

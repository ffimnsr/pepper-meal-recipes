  "id": "db66dd75-8313-537d-93dc-5cb303604e33",
  "slug": "slow-cooker-chile-verde",
  "name": "Slow Cooker Chile Verde",
  "recipe_type": "soup",
  "brief_description": "This slow cooker chili verde recipe is easy to make with cubed pork shoulder simmered in a flavorful tomato and jalape\u00f1o broth until tender and juicy.",
  "cuisine": "Mexican Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Heat olive oil in a large skillet or Dutch oven over medium heat. Cook and stir onion and garlic in hot oil until fragrant, about 2 minutes. Add pork and cook, stirring occasionally, until browned on all sides. Transfer pork mixture to a slow cooker and stir in salsa, tomatoes, and jalape\u00f1o peppers."
    },
    {
      "position": 2,
      "text": "Cover and cook on High for 3 hours. Reduce to Low and cook, 4 to 5 more hours."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 430,
  "preparation_time_minutes": 20,

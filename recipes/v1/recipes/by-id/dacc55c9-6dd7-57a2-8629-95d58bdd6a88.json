  "slug": "blueberry-lemonade",
  "name": "Blueberry Lemonade",
  "recipe_type": "dessert",
  "brief_description": "Blueberry lemonade is easy to make from scratch with fresh blueberries, lemon juice, and your favorite sweetener for a cool, refreshing summer drink.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine blueberries, sweetener, lemon juice, and 1 cup water together in a blender; blend until smooth. Pour into a pitcher. Add remaining water and stir. Serve chilled or over ice."
    }
  ],

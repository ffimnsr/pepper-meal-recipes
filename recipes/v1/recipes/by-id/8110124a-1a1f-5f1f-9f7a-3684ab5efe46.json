  "id": "8110124a-1a1f-5f1f-9f7a-3684ab5efe46",
  "slug": "cheesy-cauliflower-cakes-recipe-11803145",
  "name": "Cheesy Cauliflower Cakes",
  "recipe_type": "dessert",
  "brief_description": "These cheesy cauliflower cakes have a similar look and feel to a crab cake, but are completely vegetarian and super easy to make. Serve with fresh lemon to squeeze on top.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Line 2 baking sheets with parchment paper."
    },
    {
      "position": 2,
      "text": "Cook cauliflower in a large pot of lightly salted boiling water, until fork tender, 8 to 10 minutes. Drain and let stand until cool enough to handle."
    },
    {
      "position": 3,
      "text": "Lightly mash cooked cauliflower with a potato masher or fork into small pieces in a large bowl."
    },
    {
      "position": 4,
      "text": "Add eggs, breadcrumbs, mozzarella cheese, and Parmesan cheese. Stir just until combined."
    },
    {
      "position": 5,
      "text": "Form mixture, using your hands, into 1 1/2- to 2-inch balls. Lightly flatten between palms and place onto the prepared baking sheets."
    },
    {
      "position": 6,
      "text": "Bake until golden brown and cooked through, 20 to 25 minutes. Serve with lemon wedges. Recipe developed by Barrett Heald"
    }
  ],
  "servings": 5,
  "cooking_time_minutes": 8,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "cc8fc76c-f08f-5617-8f9e-fa5970d5f4aa",
  "slug": "butternut-squash-soup-ii",
  "name": "Butternut Squash Soup",
  "recipe_type": "soup",
  "brief_description": "This easy butternut squash soup is made with easy ingredients and cooks up into a thick, velvety soup ready to be seasoned with fall spices.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Melt butter in a large pot over medium heat, and cook onion, celery, carrot, potatoes, and squash until lightly browned, about 5 minutes. Pour in enough chicken stock to cover vegetables."
    },
    {
      "position": 3,
      "text": "Bring to a boil over medium-high heat. Reduce heat to low, cover pot, and simmer until all vegetables are tender, about 40 minutes."
    },
    {
      "position": 4,
      "text": "Transfer soup to a blender and process until smooth. Return to the pot and mix in any remaining stock to reach desired consistency. Season with salt and pepper."
    },
    {
      "position": 5,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

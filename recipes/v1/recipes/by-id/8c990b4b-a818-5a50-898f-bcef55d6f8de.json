  "id": "8c990b4b-a818-5a50-898f-bcef55d6f8de",
  "slug": "chococonut-chip-cookies",
  "name": "Chococonut Chip Cookies",
  "recipe_type": "dessert",
  "brief_description": "This coconut-chocolate chip cookie recipe makes dozens of delicious drop cookies using pantry staples, semisweet chocolate chips, and flaked coconut.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Beat butter, white sugar, and brown sugar together with an electric mixer in a large bowl until light and fluffy. Beat first egg into butter mixture. Beat second egg into mixture along with vanilla extract."
    },
    {
      "position": 3,
      "text": "Combine flour, baking soda, and salt together in a separate bowl; stir into butter mixture until just combined. Fold in chocolate chips and coconut. Drop spoonfuls of dough 2 inches apart onto ungreased cookie sheets."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until edges are golden, about 8 to 10 minutes. Cool on the cookie sheets briefly before removing to a wire rack to cool completely."
    }
  ],
  "servings": 72,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,

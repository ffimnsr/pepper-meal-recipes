  "id": "61636c67-cc60-50c1-aa42-ff1d0d2a6fc7",
  "slug": "yummy-veggie-omelet",
  "name": "Yummy Veggie Omelet",
  "recipe_type": "breakfast",
  "brief_description": "This veggie omelet for 2 is delightfully fluffy and stuffed with saut\u00e9ed onion, bell pepper, and Swiss cheese for a filling and healthy breakfast.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Melt 1 tablespoon butter in a medium skillet over medium heat. Cook and stir onion and bell pepper in butter until just tender, 4 to 5 minutes. Transfer vegetables to a bowl, season with 1/4 teaspoon salt, and set aside."
    },
    {
      "position": 2,
      "text": "Beat together eggs, milk, remaining 1/2 teaspoon salt, and pepper in a separate bowl."
    },
    {
      "position": 3,
      "text": "Melt remaining 1 tablespoon butter in the skillet over medium heat; swirl to coat the bottom of the skillet with butter. When butter is bubbly, pour in egg mixture and cook undisturbed until the bottom of eggs begin to set, about 1 minute. Gently lift the edges of omelet with a spatula to let any uncooked egg flow onto the skillet. Continue cooking until the center of omelet starts to look dry, 1 to 2 more minutes."
    },
    {
      "position": 4,
      "text": "Sprinkle cheese over omelet, then spoon vegetable mixture over 1/2 of the omelet. Use a spatula to gently fold omelet over vegetables. Cook until cheese melts to desired consistency, about 1 minute. Slide omelet onto a plate. Cut in half and serve."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

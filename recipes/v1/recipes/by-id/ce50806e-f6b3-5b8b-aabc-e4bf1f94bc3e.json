  "id": "ce50806e-f6b3-5b8b-aabc-e4bf1f94bc3e",
  "slug": "instant-pot-venison-pot-roast",
  "name": "Instant Pot Venison Pot Roast",
  "recipe_type": "main",
  "brief_description": "The Instant Pot makes venison fork-tender, the potatoes creamy, and the carrots crisp-tender. A mouthwatering comfort-food meal, ready in just 3 hours!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select Saut\u00e9 function. Add olive oil and let heat for 1 minute. Sear venison roast in hot oil for 2 minutes. Flip roast over and sear for 2 minutes more. Cancel Saut\u00e9 mode."
    },
    {
      "position": 2,
      "text": "Place water in a small bowl and add stew seasoning. Whisk until seasoning is dissolved. Pour mixture over roast."
    },
    {
      "position": 3,
      "text": "Close and lock the lid. Select High pressure according to manufacturer's instructions. Set the timer for 120 minutes. Allow 10 minutes for pressure to build."
    },
    {
      "position": 4,
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Add potatoes and carrots to the pot. Spoon sauce over them to coat."
    },
    {
      "position": 5,
      "text": "Close and lock the lid again. Select High pressure according to manufacturer's instructions. Set timer for 10 minutes. Allow 10 minutes for pressure to build."
    },
    {
      "position": 6,
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, about 15 minutes. Season with salt and pepper."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 155,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,

  "id": "2cb27980-1f8f-5dfb-975c-3bfe667d20d1",
  "slug": "barbeque-rib-brine",
  "name": "Barbeque Rib Brine",
  "recipe_type": "side",
  "brief_description": "Pink curing salt, brown sugar, garlic powder, onion powder, and pork seasoning combine in this brine recipe for moist, delicious barbequed ribs.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Put water into a large pot; add brown sugar, pork seasoning, garlic powder, onion powder, and curing salt. Bring the mixture to a boil, reduce heat to low, and cook and stir until the seasonings are completely dissolved, 20 to 30 minutes."
    },
    {
      "position": 2,
      "text": "Cool brine completely before adding meat."
    }
  ],
  "servings": 30,

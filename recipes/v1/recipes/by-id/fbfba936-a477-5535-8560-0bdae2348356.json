  "slug": "healthier-mediterranean-tuna-salad",
  "name": "No-Mayo Mediterranean Tuna Salad",
  "recipe_type": "salad",
  "brief_description": "This Mediterranean tuna salad with red onion, parsley, and a light lemon dressing is packed with different flavors and textures for a refreshing lunch.",
  "cuisine": "Mediterranean Inspired American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine tuna, onion, and parsley in a medium bowl."
    },
    {
      "position": 2,
      "text": "Whisk oil, lemon juice, lemon zest, salt, and pepper together in a small bowl; toss with tuna mixture."
    }
  ],

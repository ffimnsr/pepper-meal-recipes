  "id": "9b6d7c8b-5279-52b0-a102-4dce52241f7c",
  "slug": "reibekuchen-german-potato-pancakes",
  "name": "Reibekuchen (German Potato Pancakes)",
  "recipe_type": "dessert",
  "brief_description": "Reibekuchen (potato pancakes) are very popular in Germany as a quick and easy weeknight dinner. Traditionally they are served with apple sauce.",
  "cuisine": "German",
  "instructions": [
    {
      "position": 1,
      "text": "Peel potatoes and finely grate. Set grated potatoes onto a clean kitchen towel, twist to close, and press most of the liquid out of the potatoes, leaving only a little moisture."
    },
    {
      "position": 2,
      "text": "Mix pressed potatoes, onion, egg, and oats in a large bowl and season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Heat oil in a large skillet. Shape small potato pancakes with 2 spoons out of the potato mixture and set into the hot oil. Bake in batches until browned, 3 to 5 minutes per side, adding more oil as necessary. Drain on paper towels before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

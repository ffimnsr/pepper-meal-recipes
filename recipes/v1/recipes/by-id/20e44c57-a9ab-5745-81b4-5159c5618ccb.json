  "schema_version": 1,
  "id": "20e44c57-a9ab-5745-81b4-5159c5618ccb",
  "slug": "plantain-empanadas",
  "name": "Plantain Empanadas",
  "recipe_type": "appetizer",
  "brief_description": "This recipe for cheese-stuffed plantain empanadas is made with three ingredients and no flour. They're a homemade version of Nicaraguan plantain empanadas.",
  "cuisine": "Latin American",
  "instructions": [
    {
      "position": 1,
      "text": "Cut plantain, with the peel left on, into 3 pieces."
    },
    {
      "position": 2,
      "text": "Bring a pot of water to a boil. Add plantain pieces; boil until peels start to bubble, 3 to 5 minutes. Remove plantains with a slotted spoon. Cool until easy enough to handle; peel. Add plantains to a bowl; mash."
    },
    {
      "position": 3,
      "text": "Divide and shape mashed plantain into 3 golf-sized balls. Wrap each ball with 1 piece of plastic wrap; press into a 6-inch round. Unwrap plantain rounds; place 1 \u00bd tablespoons cheese in center of each round. Fold rounds over cheese; pinch edges together."
    },
    {
      "position": 4,
      "text": "Heat oil in a skillet over medium heat. Fry stuffed plantains until lightly browned, 2 to 3 minutes; flip. Fry until other side is lightly browned, 2 to 3 minutes more. Drain on paper towels."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

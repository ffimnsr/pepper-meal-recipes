  "id": "edd86a0f-3ff3-5b13-9841-972e8c429374",
  "slug": "turkey-lumpia",
  "name": "Turkey Lumpia",
  "recipe_type": "appetizer",
  "brief_description": "This twist on a Filipino favorite, filled with ground turkey, is a delicious appetizer or party treat.",
  "cuisine": "Filipino",
  "instructions": [
    {
      "position": 1,
      "text": "Line a cookie sheet with waxed paper."
    },
    {
      "position": 2,
      "text": "Combine turkey, egg, onion, garlic, cumin, Creole seasoning, salt, and pepper in a bowl. Mix well with your hands."
    },
    {
      "position": 3,
      "text": "Position a wonton wrapper on a cutting board so it looks like a diamond. Spread a heaping teaspoonful of the turkey mixture in a horizontal line across the bottom third of the wrapper. Fold over the bottom corner and roll once. Fold over the two side corners and roll again to secure. Dampen the top corner with a little cool water. Roll up and press to seal."
    },
    {
      "position": 4,
      "text": "Place the roll on the prepared cookie sheet. Repeat with remaining rolls, arranging them in a single layer. Freeze until ready to fry."
    },
    {
      "position": 5,
      "text": "Heat oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C). Fry the lumpia in batches, about 3 minutes per batch. Remove from the oil and cut in half. Fry again for 30 seconds. Drain on paper towels."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

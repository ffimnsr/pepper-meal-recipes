  "id": "0a91ea5a-dc60-51c3-b7e9-c84a7efe3172",
  "slug": "easy-sweet-potato-pie",
  "name": "Easy Sweet Potato Pie",
  "recipe_type": "dessert",
  "brief_description": "This sweet potato pie has a rich, creamy filling made with evaporated milk, eggs, butter, sugar, spices, and a splash of rum for a holiday favorite.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 425 degrees F (220 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine sweet potatoes, evaporated milk, sugar, salt, cinnamon, nutmeg, rum, eggs and butter in the bowl of a food processor; blend until smooth. Pour into prepared pie shell."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 10 minutes. Reduce heat to 300 degrees F (150 degrees C) and continue to bake until the filling is firm, about 50 minutes more."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,

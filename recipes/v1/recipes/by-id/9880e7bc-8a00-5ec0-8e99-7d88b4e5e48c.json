  "id": "9880e7bc-8a00-5ec0-8e99-7d88b4e5e48c",
  "slug": "keto-chicken-parmesan",
  "name": "Keto Chicken Parmesan",
  "recipe_type": "salad",
  "brief_description": "A tasty, easy keto chicken Parmesan. Keep to your keto diet with this favorite Italian dish \u2014 chicken Parm is a perfect meal with veggies or salad.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Set the oven rack about 6 inches from the heat source and preheat the oven's broiler."
    },
    {
      "position": 2,
      "text": "Slice chicken breast through the middle horizontally from one side to within 1/2 inch of the other side. Open the two sides and spread them out like an open book. Pound chicken flat until about 1/2-inch thick."
    },
    {
      "position": 3,
      "text": "Beat egg and cream together in a bowl."
    },
    {
      "position": 4,
      "text": "Combine crushed pork rinds, Parmesan cheese, salt, garlic powder, red pepper, black pepper, and Italian seasoning in a separate shallow bowl or plate."
    },
    {
      "position": 5,
      "text": "Dip chicken into egg mixture; coat completely. Press chicken into breading; thickly coat both sides."
    },
    {
      "position": 6,
      "text": "Heat a skillet over medium-high heat; add ghee. Place chicken in the pan; cook until no longer pink in the center and the juices run clear, about 3 minutes per side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C). Be careful to keep breading in place."
    },
    {
      "position": 7,
      "text": "Transfer chicken to a baking sheet. Cover with tomato sauce; top with mozzarella cheese."
    },
    {
      "position": 8,
      "text": "Broil until cheese is bubbling and barely browned, about 2 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "3cec2e13-72d6-599c-a1ea-e6949e8421fd",
  "slug": "asian-flat-iron-steak",
  "name": "Asian Flat Iron Steak",
  "recipe_type": "main",
  "brief_description": "In this recipe, Asian flat iron steak is marinated in a mixture with soy sauce, rice wine vinegar, brown sugar, green onions, garlic, and mustard powder.",
  "cuisine": "Asian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk soy sauce, vinegar, brown sugar, green onions, garlic, and mustard powder together in a bowl; pour into a resealable plastic bag. Add steak, coat with marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator, 3 to 4 hours."
    },
    {
      "position": 2,
      "text": "Remove steak from marinade; shake off excess. Discard remaining marinade."
    },
    {
      "position": 3,
      "text": "Heat a non-stick skillet over medium-high heat. Add steak; cook until outside is seared, about 1 minute per side. Continue cooking until desired doneness is reached, about 5 minutes more per side. An instant-read thermometer inserted into the center should read 140 degrees F (60 degrees C) for medium."
    },
    {
      "position": 4,
      "text": "Transfer steak to a cutting board; rest before cutting, 3 to 5 minutes. Sprinkle sesame seeds over steak."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

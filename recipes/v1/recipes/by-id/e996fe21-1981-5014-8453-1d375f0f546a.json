  "id": "e996fe21-1981-5014-8453-1d375f0f546a",
  "slug": "pickle-brine-chicken",
  "name": "Pickle Brine Chicken",
  "recipe_type": "drink",
  "brief_description": "Use pickle brine in Chef John's recipe for tender chicken breasts soaked in leftover pickle juice, sugar, salt, and cayenne, then grilled until juicy.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Whisk together pickle juice, brown sugar, kosher salt, 1 teaspoon black pepper, and 1 pinch cayenne pepper in a large bowl until sugar dissolves. Place chicken breasts in brine, using a plate or bowl to keep breasts submerged. Refrigerate for 1 to 2 hours."
    },
    {
      "position": 3,
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate."
    },
    {
      "position": 4,
      "text": "Remove chicken breasts from brine, discard brine, and dry chicken breasts with paper towels. Brush each breast with olive oil; season with salt, black pepper, and cayenne pepper. Cook chicken on the preheated grill until no longer pink in the center and the juices run clear, about 5 minutes per side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 5,
      "text": "Transfer chicken to a plate, tent with aluminum foil, and let chicken rest for 5 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,

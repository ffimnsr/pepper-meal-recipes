  "schema_version": 1,
  "id": "efac581a-ddb5-5e62-8a99-fe713cc739b8",
  "slug": "slow-cooker-corned-beef-reuben-sandwiches",
  "name": "Slow Cooker Corned Beef Reuben Sandwiches",
  "recipe_type": "main",
  "brief_description": "This slow cooker corned beef and sauerkraut is simmered with spiced, dark beer for delicious open-faced toasted Reuben sandwiches on St. Paddy's Day.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Place sauerkraut with liquid into a slow cooker and lay corned beef on top. Add beer, onion, garlic, and pickling spice around and on top of corned beef."
    },
    {
      "position": 2,
      "text": "Cook on Low until brisket is very tender, 7 to 8 hours. Remove brisket from the slow cooker and let rest for 10 minutes."
    },
    {
      "position": 3,
      "text": "Drain and discard excess liquid from the slow cooker so you can easily access sauerkraut."
    },
    {
      "position": 4,
      "text": "Thinly slice corned beef against the grain. Assemble open-faced sandwiches by layering corned beef, sauerkraut, and Swiss cheese slices on rye bread. Reserve remaining corned beef for another use."
    },
    {
      "position": 5,
      "text": "Place open-faced sandwiches in a toaster oven and toast until cheese is melted, about 5 minutes. Serve with Thousand Island dressing as a condiment."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 425,
  "preparation_time_minutes": 20,

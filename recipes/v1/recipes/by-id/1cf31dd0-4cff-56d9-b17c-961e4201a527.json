  "id": "1cf31dd0-4cff-56d9-b17c-961e4201a527",
  "slug": "award-winning-white-chicken-chili",
  "name": "Award-Winning White Chicken Chili",
  "recipe_type": "soup",
  "brief_description": "Easy white chicken chili in the crockpot! Great northern beans, corn, chiles, and chicken are transformed into an award-winning chili in the slow cooker.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Layer chicken, great northern beans, and corn in a slow cooker."
    },
    {
      "position": 3,
      "text": "Mix chicken broth, condensed soup, chile peppers, and taco seasoning together in a bowl. Pour broth mixture over top."
    },
    {
      "position": 4,
      "text": "Cover and cook on Low until chicken is no longer pink in the center and the juices run clear, 8 to 10 hours. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C)."
    },
    {
      "position": 5,
      "text": "Transfer chicken to a cutting board. Shred with two forks or cut into bite-sized pieces. Return to the slow cooker."
    },
    {
      "position": 6,
      "text": "Stir in sour cream and pepper Jack cheese; cover and cook on Low until cheese is melted, 3 to 5 minutes."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 485,
  "preparation_time_minutes": 15,

  "name": "Slow-Cooker Apple Raspberry Sauce",
  "recipe_type": "side",
  "brief_description": "This recipe for homemade applesauce uses raspberries for a tasty variation on a classic item.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine apples, raspberries, water, brown sugar, cinnamon, and nutmeg in a slow cooker crock."
    },
    {
      "position": 2,
      "text": "Cook on Low until apples can easily be mashed, about 6 hours."
    }

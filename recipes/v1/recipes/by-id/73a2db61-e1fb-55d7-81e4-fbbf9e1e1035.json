  "id": "73a2db61-e1fb-55d7-81e4-fbbf9e1e1035",
  "slug": "green-bean-and-potato-salad",
  "name": "Green Bean and Potato Salad",
  "recipe_type": "salad",
  "brief_description": "This green bean potato salad with red onion and basil is tossed in a zippy Dijon mustard and balsamic vinaigrette for a tasty side dish or easy lunch.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place potatoes in a large pot and fill with about 1 inch of water; bring to a boil. Cook until potatoes are tender, about 15 minutes; add green beans to steam after the first 10 minutes. Drain and allow to cool slightly."
    },
    {
      "position": 2,
      "text": "Cut potatoes into quarters and transfer to a large bowl. Add green beans, onion, basil, salt, and pepper; toss until combined. Set aside."
    },
    {
      "position": 3,
      "text": "Whisk together olive oil, balsamic vinegar, mustard, lemon juice, garlic, and Worcestershire sauce in a medium bowl until well combined. Pour over salad and stir to coat. Season with salt and pepper."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

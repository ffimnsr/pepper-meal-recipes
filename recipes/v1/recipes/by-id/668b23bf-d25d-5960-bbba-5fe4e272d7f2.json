  "id": "668b23bf-d25d-5960-bbba-5fe4e272d7f2",
  "slug": "basic-fruit-smoothie",
  "name": "Basic Fruit Smoothie",
  "recipe_type": "breakfast",
  "brief_description": "A tasty fruit smoothie recipe with strawberries, banana, peaches, fruit juice, and ice. Feel free to experiment with your favorite fruits!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine strawberries, peaches, and banana in a blender; blend until smooth."
    },
    {
      "position": 3,
      "text": "Add ice and pour in juice; blend again to desired consistency."
    },
    {
      "position": 4,
      "text": "Enjoy!"
    }
  ],
  "servings": 4,

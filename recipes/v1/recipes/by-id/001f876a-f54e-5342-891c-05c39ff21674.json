  "id": "001f876a-f54e-5342-891c-05c39ff21674",
  "slug": "spiralized-apple-salad",
  "name": "Spiralized Apple Salad",
  "recipe_type": "salad",
  "brief_description": "Fresh apples are spiralized into crunchy noodles and tossed with a mild vinaigrette dressing in this quick and easy spin on fruit salad.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Whisk olive oil, white balsamic vinegar, Dijon mustard, and honey in a small bowl to make dressing."
    },
    {
      "position": 2,
      "text": "Cut Granny Smith and Red Delicious apples into noodles using a spiralizer fitted with the large shredding blade."
    },
    {
      "position": 3,
      "text": "Place apple noodles in a large bowl and toss with lime juice to keep them from turning brown. Pour in dressing; mix gently until salad is combined."
    },
    {
      "position": 4,
      "text": "Place pine nuts in a small skillet over medium-low heat. Toast pine nuts, shaking often, until golden brown, about 5 minutes. Sprinkle pine nuts over salad."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 3,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

  "id": "92f971aa-144b-5c33-92e5-2b115aa1c05f",
  "slug": "mississippi-chicken-meatballs-recipe-11913781",
  "name": "Mississippi Chicken Meatballs",
  "recipe_type": "main",
  "brief_description": "These Mississippi chicken meatballs combine the flavors you love in Mississippi chicken\u2014a pop of pepperoncini, ranch seasoning, and Monterey Jack cheese\u2014into meatballs, with a quick sauce. Serve them over mashed potatoes for the ultimate comfort meal.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine ground chicken, 1 1/2 tablespoons ranch seasoning, 1 1/2 tablespoon au jus mix, egg, breadcrumbs, cheese, and pepperoncini peppers in a bowl until just combined."
    },
    {
      "position": 3,
      "text": "Form 1 1/2-inch balls (about 1 tablespoon each); place on a baking sheet. Spray meatballs with cooking spray."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven for 15 minutes; rotate meatballs halfway through baking time to brown evenly."
    },
    {
      "position": 5,
      "text": "Meanwhile, combine butter, 1/2 tablespoon ranch seasoning, 1/2 tablespoon au jus mix, pepperoncini brine, and chicken broth in a small saucepan. Bring to a boil, reduce heat, and simmer, whisking constantly until reduced slightly, about 3 minutes."
    },
    {
      "position": 6,
      "text": "Remove from the oven; allow meatballs to cool for 5 to 10 minutes, Serve over mashed potatoes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

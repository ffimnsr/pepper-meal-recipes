  "id": "41de762f-4caa-50d0-96c7-a98693bad874",
  "slug": "american-flag-cookie-cake-recipe-12008496",
  "name": "American Flag Cookie Cake",
  "recipe_type": "dessert",
  "brief_description": "This American flag cookie cake transforms refrigerated sugar cookie dough into a festive fruit pizza topped with a creamy frosting and fresh summer berries. It\u2019s an easy dessert that makes the perfect centerpiece for Fourth of July celebrations.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Let cookie dough stand at room temperature for 10 to 15 minutes before baking."
    },
    {
      "position": 2,
      "text": "Line a rimmed baking sheet with parchment paper. Press cookie dough lightly onto the parchment paper and place a second piece of parchment on top. Using a rolling pin or your hands, press dough into a thin layer all the way to the edges of the pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until just beginning to brown around the edges, 11 to 13 minutes. Let cool completely, about 20 minutes. Once cooled, carefully peel the the parchment paper off, then place the cookie cake in your serving tray or cooled baking sheet."
    },
    {
      "position": 4,
      "text": "Meanwhile, for cream cheese frosting, beat cream cheese and butter together in a bowl with an electric mixer until smooth. Add vanilla, lemon zest, lemon juice, and salt. Gradually add confectioners\u2019 sugar until well blended. Add 2/3 of the whipped topping into the mixture and blend until just combined."
    },
    {
      "position": 5,
      "text": "Spread 3/4 of cream cheese frosting over cooled cookie crust, leaving a 1/4-inch border around the edges."
    },
    {
      "position": 6,
      "text": "Fold remaining whipped topping into remaining frosting; add mixture to a large resealable plastic bag or piping bag. Set aside."
    },
    {
      "position": 7,
      "text": "Arrange blueberries in a single layer in a rectangular shape in the left corner of the pan. Place 5 rows of strawberries over the frosting, leaving white space in between each row. Add raspberry halves in between every 1 to 2 strawberries."
    },
    {
      "position": 8,
      "text": "Snip the corner of the plastic bag and pipe cream cheese frosting in between each row of berries."
    },
    {
      "position": 9,
      "text": "Serve immediately or refrigerate until ready to serve. Can be made up to 1 day ahead."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 30,

  "id": "b53d5898-08fb-5949-9575-f94f43c9308c",
  "slug": "spinach-quiche",
  "name": "Spinach Quiche",
  "recipe_type": null,
  "brief_description": "This spinach quiche packs lots of veggies, plus herbed feta and Cheddar in a deep-dish pie crust for cheesy deliciousness in every bite.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C)."
    },
    {
      "position": 2,
      "text": "Melt butter in a medium skillet over medium heat. Add onion and garlic and saute until lightly browned, about 7 minutes."
    },
    {
      "position": 3,
      "text": "Stir in spinach, mushrooms, feta, and 1/2 cup Cheddar. Season with salt and pepper."
    },
    {
      "position": 4,
      "text": "Spoon mixture into prepared pie crust."
    },
    {
      "position": 5,
      "text": "Whisk eggs and milk together in a medium bowl until combined. Season with salt and pepper."
    },
    {
      "position": 6,
      "text": "Pour over the spinach mixture in pie crust, allowing egg mixture to thoroughly combine with spinach mixture."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven for 15 minutes."
    },
    {
      "position": 8,
      "text": "Sprinkle the top with remaining Cheddar and bake until set in center, 35 to 40 minutes longer."
    },
    {
      "position": 9,
      "text": "Allow to cool briefly before slicing and serving, about 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

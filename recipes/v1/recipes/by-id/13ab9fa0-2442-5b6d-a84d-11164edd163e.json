  "id": "13ab9fa0-2442-5b6d-a84d-11164edd163e",
  "slug": "oven-roasted-potatoes",
  "name": "Oven Roasted Potatoes",
  "recipe_type": "side",
  "brief_description": "These crispy roasted potatoes flavored with olive oil, garlic, herbs, and red pepper flakes make a delicious family-pleasing potato side dish for any meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 475 degrees F (245 degrees C)."
    },
    {
      "position": 2,
      "text": "Combine oil, garlic, basil, marjoram, dill, thyme, oregano, parsley, pepper flakes, and salt in a large bowl."
    },
    {
      "position": 3,
      "text": "Stir in potatoes until evenly coated. Place potatoes in a single layer on a roasting pan or baking sheet."
    },
    {
      "position": 4,
      "text": "Roast in the preheated oven, turning occasionally to brown on all sides, until tender with crispy edges, about 20 to 30 minutes."
    },
    {
      "position": 5,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

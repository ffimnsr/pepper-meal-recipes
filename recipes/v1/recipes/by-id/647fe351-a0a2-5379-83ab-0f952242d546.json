  "id": "647fe351-a0a2-5379-83ab-0f952242d546",
  "slug": "tomato-and-basil-quiche",
  "name": "Tomato Quiche",
  "recipe_type": "breakfast",
  "brief_description": "A delightful tomato quiche with cheese, onion, and basil that's easy to make with a prepared pastry crust but tastes like you spent all day in the kitchen!",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Bake pie shell in preheated oven for 8 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, heat olive oil in a large skillet over medium heat. Saut\u00e9 onion until soft; remove from skillet. Sprinkle tomato slices with flour and basil, then saut\u00e9 in the same skillet for 1 minute on each side. Whisk eggs and milk together in a bowl until smooth; season with salt and pepper."
    },
    {
      "position": 3,
      "text": "Spread 1 cup shredded cheese in the bottom of pie crust. Layer onions over cheese, and top with tomatoes. Cover with egg mixture; sprinkle remaining 1/2 cup shredded cheese on top."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven for 10 minutes. Reduce heat to 350 degrees F (175 degrees C), and continue to bake until filling is puffed and golden brown, about 15 to 20 minutes. Serve warm."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

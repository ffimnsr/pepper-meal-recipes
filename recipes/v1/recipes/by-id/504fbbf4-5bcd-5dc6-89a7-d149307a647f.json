  "id": "504fbbf4-5bcd-5dc6-89a7-d149307a647f",
  "slug": "peach-and-blueberry-cobbler",
  "name": "Peach and Blueberry Cobbler",
  "recipe_type": "dessert",
  "brief_description": "This simple blueberry peach cobbler uses canned peaches and frozen blueberries with an easy topping so you can have a taste of summer all year round.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 9-inch square glass baking dish."
    },
    {
      "position": 2,
      "text": "Pour peaches with juice into the prepared baking dish and sprinkle blueberries on top."
    },
    {
      "position": 3,
      "text": "Whisk together flour, sugar, and baking powder in a large bowl until thoroughly combined. Cut in butter with 2 knives or a pastry blender until mixture resembles coarse crumbs; sprinkle over blueberries and peaches."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until fruit is bubbling and topping is golden brown, 45 minutes to 1 hour. Allow to cool; filling will thicken as it cools."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

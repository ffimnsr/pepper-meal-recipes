  "id": "6082cf6b-f05b-5b3b-9ec3-dca826b1196e",
  "slug": "quick-chinese-chicken-salad",
  "name": "Quick Chinese Chicken Salad",
  "recipe_type": "salad",
  "brief_description": "Chicken salad is a great way to use up leftover chicken breast. With this easy salad, dinner is quick, and you don't have to turn on the oven.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine vinegar, sugar, soy sauce, vegetable oil, and sesame oil in large bowl, stirring until sugar dissolves."
    },
    {
      "position": 2,
      "text": "Add salad mixture and cilantro, tossing to coat all pieces."
    },
    {
      "position": 3,
      "text": "Add chicken; toss to combine. Serve immediately."
    }
  ],
  "servings": 4,

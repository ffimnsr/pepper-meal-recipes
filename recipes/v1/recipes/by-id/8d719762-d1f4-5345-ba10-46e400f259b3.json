  "id": "8d719762-d1f4-5345-ba10-46e400f259b3",
  "slug": "falafel-dough-pizza",
  "name": "Falafel Dough Pizza",
  "recipe_type": "main",
  "brief_description": "A red-lentil dough is topped with a yogurt-tahini sauce, cheese, parsley, and olives in this fun vegetarian pizza inspired by falafel.",
  "cuisine": "Middle Eastern Inspired African",
  "instructions": [
    {
      "position": 1,
      "text": "Place red lentils in a bowl and cover with water. Let soak until softened, about 2 hours. Drain."
    },
    {
      "position": 2,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper and grease with 2 teaspoons oil."
    },
    {
      "position": 3,
      "text": "Place lentils in a food processor with onion, garlic, 1/2 bunch parsley, cilantro, and 1/4 cup green onions; pulse until finely ground."
    },
    {
      "position": 4,
      "text": "Transfer lentil mixture to a large bowl. Add 1/3 cup oil, egg, baking powder, black pepper, chile powder, cumin, coriander, and salt; mix until well-blended. Spread dough to 1/4-inch thickness onto prepared baking sheet."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until golden and firm, about 15 minutes. Remove from oven."
    },
    {
      "position": 6,
      "text": "Combine yogurt, lemon juice, tahini, and salt in a small bowl; mix well until sauce is smooth."
    },
    {
      "position": 7,
      "text": "Layer sauce, Cheddar cheese, tomato, olives, 1 tablespoon parsley, and 2 teaspoons green onion on top of baked dough."
    },
    {
      "position": 8,
      "text": "Return to the oven and bake until cheese is melted, about 5 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 35,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "0083ba58-399d-540b-89a5-3af0ce5c60ec",
  "slug": "impossible-pumpkin-pie-ii",
  "name": "Bisquick Impossible Pumpkin Pie",
  "recipe_type": "dessert",
  "brief_description": "This impossible pumpkin pie with Bisquick baking mix, evaporated milk, and pumpkin pur\u00e9e is a great option if you don't feel like making a crust!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9-inch pie pan."
    },
    {
      "position": 2,
      "text": "Combine sugar and baking mix in a large bowl. Stir in butter, milk, and eggs; beat in pumpkin, spice, and vanilla until smooth. Pour into prepared pie pan."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven for 50 to 55 minutes, or until knife inserted in center comes out clean. Refrigerate any remaining pie."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

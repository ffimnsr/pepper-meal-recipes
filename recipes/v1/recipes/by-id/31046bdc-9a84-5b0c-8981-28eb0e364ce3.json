  "slug": "coconut-margarita-recipe-8630074",
  "name": "Coconut Margarita",
  "recipe_type": "appetizer",
  "brief_description": "This coconut margarita is a delicious, rich margarita made with fresh orange and lime juices, cream of coconut, and coconut milk.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Fill a cocktail shaker with ice. Add tequila, lime juice, orange juice, cream of coconut, and coconut milk. Shake until tequila mixture is completely chilled and cream of coconut is incorporated, about 30 seconds. Pour into glass. Serve immediately."
    }
  ],

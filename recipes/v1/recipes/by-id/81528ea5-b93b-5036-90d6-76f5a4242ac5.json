  "id": "81528ea5-b93b-5036-90d6-76f5a4242ac5",
  "slug": "chocolate-buttermilk-pie-with-whiskey-and-almonds",
  "name": "Chocolate Buttermilk Pie with Whiskey and Almonds",
  "recipe_type": "dessert",
  "brief_description": "Give buttermilk pie a makeover with whiskey, dark cocoa, and almonds for improved texture and an added kick.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place pastry crust in a pie plate. Refrigerate for 20 to 30 minutes."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 3,
      "text": "Combine white sugar, brown sugar, flour, cocoa powder, cornmeal, and salt in a small bowl."
    },
    {
      "position": 4,
      "text": "Whisk eggs, buttermilk, butter, whiskey, and vanilla paste together in a large bowl. Add sugar mixture and blend until smooth. Stir in almonds by hand until incorporated. Pour mixture into the chilled pastry crust."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until crust is golden and center is set, 50 to 60 minutes. Transfer pie to a wire rack and cool to room temperature before serving."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 10,

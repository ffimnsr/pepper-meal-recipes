  "schema_version": 1,
  "id": "788d6555-48f4-543b-a7ac-0504dbf25df5",
  "slug": "beef-medallions-with-caramelized-pan-sauce",
  "name": "Beef Medallions with Caramelized Pan Sauce",
  "recipe_type": "main",
  "brief_description": "This flavorful dish of beef tenderloin medallions with a Marsala wine and mushroom sauce can be easily whipped together in just over 30 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Season beef medallions with salt and pepper; set aside."
    },
    {
      "position": 2,
      "text": "Heat vegetable oil in a skillet over high heat. Cook beef medallions until browned, about 2 minutes per side; transfer to a warm plate."
    },
    {
      "position": 3,
      "text": "Reduce heat to medium; add mushrooms, 1 tablespoon unsalted butter, olive oil, and pinch of salt to skillet. Cook and stir until mushrooms are very well browned, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Stir in tomato sauce; cook and stir until thickens, about 5 minutes."
    },
    {
      "position": 5,
      "text": "Add Marsala; increase heat to high. Cook and scrape browned bits from bottom of skillet until most of Marsala evaporated. Stir in broth and bring to a boil; cook and stir until reduced by half, about 5 minutes."
    },
    {
      "position": 6,
      "text": "Reduce heat to low; add beef medallions back to skillet and simmer until cooked to medium-rare, 2 to 3 minutes. Transfer beef medallions to serving plates."
    },
    {
      "position": 7,
      "text": "Off heat, stir remaining 1 1/2 tablespoons butter and oregano into sauce until butter melts. Taste for seasoning; adjust if necessary."
    },
    {
      "position": 8,
      "text": "Spoon sauce over beef medallions and serve immediately."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

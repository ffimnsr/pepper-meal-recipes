  "slug": "green-grape-salad",
  "name": "Green Grape Salad",
  "recipe_type": "salad",
  "brief_description": "This grape salad is a wonderful creamy dessert salad made with crisp green grapes folded into a sweetened cream cheese mixture with pecans.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Wash and dry grapes."
    },
    {
      "position": 3,
      "text": "Mix cream cheese, sour cream, sugar, and vanilla together in a large bowl. Add grapes and mix until evenly incorporated."
    },
    {
      "position": 4,
      "text": "Sprinkle with brown sugar and pecans, mix again and refrigerate until serving."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": null,

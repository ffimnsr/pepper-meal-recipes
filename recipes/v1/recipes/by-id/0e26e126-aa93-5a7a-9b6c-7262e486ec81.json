  "id": "0e26e126-aa93-5a7a-9b6c-7262e486ec81",
  "slug": "mushroom-shrimp-and-winter-melon-soup",
  "name": "Mushroom, Shrimp, and Winter Melon Soup",
  "recipe_type": "soup",
  "brief_description": "Sweet, refreshing winter melon contrasts nicely with the umami flavor of shiitake mushroom and shrimp in this tasty soup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine mushrooms and water in a bowl. Let sit until mushrooms are soft, at least 15 minutes. Drain mushrooms and reserve 2 cups soaking water."
    },
    {
      "position": 2,
      "text": "Soak shrimp in salt water. Peel, then soak again in salt water. Drain and blot dry."
    },
    {
      "position": 3,
      "text": "Heat sunflower oil in a skillet over medium heat. Add shrimp and cook for 2 to 3 minutes per side. Remove from the heat."
    },
    {
      "position": 4,
      "text": "Put winter melon, mushrooms, and bamboo shoots in a pan with the reserved soaking water, sake, chicken bouillon, and ginger. Cook over medium heat, skimming any foam that rises to the top, until winter melon is transparent, about 10 minutes."
    },
    {
      "position": 5,
      "text": "Divide shrimp between 2 bowls. Ladle soup over top. Add lemon and cilantro and season with salt and pepper."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

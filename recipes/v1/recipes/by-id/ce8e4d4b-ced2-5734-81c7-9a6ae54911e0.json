  "id": "ce8e4d4b-ced2-5734-81c7-9a6ae54911e0",
  "slug": "apple-butter-meatballs-recipe-8714730",
  "name": "Apple Butter Meatballs",
  "recipe_type": "appetizer",
  "brief_description": "These apple butter meatballs are baked until golden, then tossed in a smooth glaze made from apple butter, bourbon, soy sauce, and a touch of maple syrup.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Combine ground beef, ground pork, panko, onion, milk, egg, salt, granulated garlic, and pepper in a large bowl. If mixture is too soft or wet, place in the refrigerator for 15 to 20 minutes to firm up before rolling. Shape into 24 meatballs, about 1 1/2 inches in diameter, and place on the prepared baking sheet."
    },
    {
      "position": 3,
      "text": "Bake meatballs in the preheated oven until no longer pink at the center and browned on the outside, about 20 minutes. An instant read thermometer inserted into the center of meatballs should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 4,
      "text": "Meanwhile, prepare apple butter bourbon glaze. In a small saucepan, whisk together apple butter, bourbon, soy sauce, maple syrup, and Dijon mustard. Bring to a simmer over medium-low heat and stir frequently until the sauce is smooth and just thickened, 5 to 7 minutes."
    },
    {
      "position": 5,
      "text": "Remove meatballs from the oven and transfer to a large bowl. Pour glaze over meatballs and gently toss to coat evenly. Serve warm."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": 20,

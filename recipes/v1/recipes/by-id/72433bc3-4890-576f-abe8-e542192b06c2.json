  "id": "72433bc3-4890-576f-abe8-e542192b06c2",
  "slug": "caprese-pasta-with-thai-basil",
  "name": "Caprese Pasta with Thai Basil",
  "recipe_type": "salad",
  "brief_description": "Try this light summery caprese pasta with Thai basil and lemon flavored balsamic vinegar for lunch on a hot day.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes."
    },
    {
      "position": 2,
      "text": "Combine cherry tomatoes, mozzarella balls, olive oil, balsamic vinegar, garlic, and Thai basil in a large mixing bowl; mix well. Season with salt and pepper to taste."
    },
    {
      "position": 3,
      "text": "Drain pasta and top with cherry tomato mixture."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,

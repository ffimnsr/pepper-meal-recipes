  "id": "e12feec6-692e-50be-a710-48252a910383",
  "slug": "chicken-salad-with-bacon-lettuce-and-tomato",
  "name": "Chicken Salad with Bacon, Lettuce, and Tomato",
  "recipe_type": "salad",
  "brief_description": "This chicken salad with bacon and tomato is dressed in a creamy mixture of mayonnaise, lemon juice, and parsley and served over crisp lettuce leaves.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Cook bacon in a large skillet and over medium-high heat, turning occasionally, until evenly browned and crispy, about 10 minutes. Drain on paper towels and crumble when cool enough to handle."
    },
    {
      "position": 2,
      "text": "Whisk mayonnaise, green onion, parsley, lemon juice, Worcestershire sauce, salt, and black pepper together in a bowl until smooth."
    },
    {
      "position": 3,
      "text": "Stir chicken, tomato, and celery together in a bowl. Add crumbled bacon; pour mayonnaise dressing over top and toss to coat. Cover and refrigerate until chilled, at least 30 minutes."
    },
    {
      "position": 4,
      "text": "When ready to serve, remove from the refrigerator and stir. Serve over romaine lettuce leaves and garnish with avocado slices."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,
  "difficulty": "medium",

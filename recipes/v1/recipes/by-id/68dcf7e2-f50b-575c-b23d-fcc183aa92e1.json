  "id": "68dcf7e2-f50b-575c-b23d-fcc183aa92e1",
  "slug": "blended-baked-oats",
  "name": "Blended Baked Oats",
  "recipe_type": "dessert",
  "brief_description": "Try these blended baked oats made with banana, egg, and almond milk, and sweetened with a really ripe banana. It's sure to change your morning routine!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray the bottom and sides of two 8-ounce ramekins with cooking spray."
    },
    {
      "position": 2,
      "text": "Combine oats, almond milk, banana, egg, maple syrup, baking powder, vanilla, cinnamon, and salt in a blender. Blend until well combined, 30 to 60 seconds. Stir in blueberries. Transfer to the prepared ramekins."
    },
    {
      "position": 3,
      "text": "Bake in the preheated oven until firm, about 25 minutes."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

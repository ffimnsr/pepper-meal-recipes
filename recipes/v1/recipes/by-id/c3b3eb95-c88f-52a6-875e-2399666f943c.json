  "id": "c3b3eb95-c88f-52a6-875e-2399666f943c",
  "slug": "authentic-mexican-breakfast-tacos",
  "name": "Mexican Breakfast Tacos",
  "recipe_type": "breakfast",
  "brief_description": "These Mexican breakfast tacos are a quick, easy, and tasty morning meal of warm tortillas filled with chorizo scrambled eggs, salsa, and hot sauce.",
  "cuisine": "Mexican",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large skillet over medium-high heat. Cook and stir sausage in the hot skillet until browned and crumbly, 5 to 7 minutes. Remove sausage to a plate. Drain and discard grease; wipe the skillet clean with a paper towel."
    },
    {
      "position": 2,
      "text": "Place the same skillet over medium heat and grease with cooking spray. Whisk together eggs, milk, salt, and pepper in a medium bowl; pour into the prepared skillet. Cook and gently stir until scrambled and almost dry. Add sausage; continue to cook and stir until firm."
    },
    {
      "position": 3,
      "text": "Meanwhile, warm a second skillet over high heat. Cook tortillas until hot and crispy on the edges, but still pliable, about 45 seconds per side."
    },
    {
      "position": 4,
      "text": "Sprinkle Monterey Jack cheese evenly onto hot tortillas. Top each with scrambled eggs, salsa, and hot pepper sauce."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "easy",

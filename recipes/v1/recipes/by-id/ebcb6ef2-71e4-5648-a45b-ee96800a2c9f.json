  "slug": "tomato-chutney-ii",
  "name": "Tomato Chutney",
  "recipe_type": "dessert",
  "brief_description": "This tomato chutney is super simple to make with freshly chopped tomatoes, ginger, garlic, sugar, and spices for a sweet and flavorful condiment.",
  "cuisine": "Indian",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Combine tomatoes, ginger, garlic, cilantro, chili powder, sugar, and salt in a saucepan over medium heat, stirring occasionally, until thick and tomatoes have broken down, about 10 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 10,

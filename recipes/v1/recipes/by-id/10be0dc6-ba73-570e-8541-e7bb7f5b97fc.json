  "id": "10be0dc6-ba73-570e-8541-e7bb7f5b97fc",
  "slug": "slow-cooker-chili-ii",
  "name": "Slow Cooker Chili",
  "recipe_type": "soup",
  "brief_description": "This easy slow cooker chili made with ground beef, beans, veggies, and spices simmers away in a crockpot for a hearty and filling weeknight dinner.",
  "cuisine": "Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Place beef in a skillet over medium heat and cook until evenly brown, 8 to 10 minutes. Drain grease."
    },
    {
      "position": 2,
      "text": "Transfer beef to a slow cooker and mix in onion, celery, bell pepper, garlic, tomato puree, kidney beans, and cannellini beans. Season with chili powder, salt, basil, oregano, parsley, black pepper, and hot pepper sauce."
    },
    {
      "position": 3,
      "text": "Cover and cook on Low for 8 hours."
    },
    {
      "position": 4,
      "text": "Serve hot in bowls with your favorite toppings. Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 490,
  "preparation_time_minutes": 15,

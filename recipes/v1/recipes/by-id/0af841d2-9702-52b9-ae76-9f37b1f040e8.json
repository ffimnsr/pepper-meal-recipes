  "id": "0af841d2-9702-52b9-ae76-9f37b1f040e8",
  "slug": "chicken-alfredo-rice-casserole-recipe-11731750",
  "name": "Chicken Alfredo Rice Casserole",
  "recipe_type": "side",
  "brief_description": "This chicken Alfredo rice casserole begins with a freshly-made garlicky cream and Parmesan sauce. Chicken, rice, peas, and cheese sauce are topped with crunchy breadcrumb topping and baked to golden perfection. With only 20 minutes of hands-on time, it's comfort food at its best.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Spray an 8x6-inch dish with nonstick cooking spray. Set aside."
    },
    {
      "position": 2,
      "text": "For casserole, melt butter in a saucepan. Add cream and bring to a simmer; cook for 5 minutes, stirring constantly. Add Parmesan cheese, garlic, pepper, and parsley. Stir until combined. Set aside."
    },
    {
      "position": 3,
      "text": "Stir chicken, rice, and peas into sauce. Season with salt and pepper. Pour into the prepared dish. Set aside."
    },
    {
      "position": 4,
      "text": "For topping combine panko, Parmesan cheese, butter, and garlic powder. Sprinkle over top."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until heated and topping is golden brown, 25 to 28 minutes."
    }
  ],
  "servings": 3,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "e050bbdb-17b5-5818-a708-d9edbfa0e78c",
  "slug": "potato-ham-broccoli-and-cheese-soup-with-baby-dumplings",
  "name": "Potato, Ham, Broccoli, and Cheese Soup with Baby Dumplings",
  "recipe_type": "soup",
  "brief_description": "This broccoli, ham, and cheese soup features potato chunks in a creamy base seasoned with parsley and thyme for a hearty, filling, cold-weather meal.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Heat butter in a large stockpot over medium heat. Cook and stir onion, celery, carrot, and garlic in hot butter until onion is translucent. Stir in potatoes, chicken stock, parsley, thyme, and cayenne pepper; bring to a boil. Cover, reduce heat, and simmer until potatoes are tender, about 15 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, mix together flour and egg in a bowl using a fork until mixture resembles grains of rice."
    },
    {
      "position": 3,
      "text": "Stir milk and ham into the stockpot; bring to a simmer. Slowly sprinkle flour-egg mixture into soup, stirring constantly to prevent clumps. Simmer for 10 minutes, stirring occasionally."
    },
    {
      "position": 4,
      "text": "Stir in broccoli and Cheddar cheese; cook until broccoli is tender and cheese is melted, about 5 minutes. Season with salt and pepper."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 45,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

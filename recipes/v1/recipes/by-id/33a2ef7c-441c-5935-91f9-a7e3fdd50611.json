  "id": "33a2ef7c-441c-5935-91f9-a7e3fdd50611",
  "slug": "tuna-melt-casserole-recipe-11747960",
  "name": "Tuna Melt Casserole",
  "recipe_type": "main",
  "brief_description": "This tuna melt casserole is an updated spin on tuna noodle: it's a baked version of the classic hot sandwich. If you like it spicy, use jalape\u00f1os instead of the capers.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 9x13-inch baking dish."
    },
    {
      "position": 2,
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until tender yet firm to the bite, 7 to 9 minutes. Drain noodles and return to pot."
    },
    {
      "position": 3,
      "text": "Melt 3 tablespoons butter in a large skillet over medium heat. Add onion, celery, and garlic. Cook, stirring frequently, until tender, about 6 minutes. Gradually stir in flour, salt, and cayenne. Cook, stirring constantly, until flour is lightly golden, about 1 minute. Whisk in milk. Cook, whisking constantly, until thickened and bubbly. Gradually stir in 1 cup cheese. Cook, stirring constantly, until cheese melts and sauce is smooth."
    },
    {
      "position": 4,
      "text": "Stir sauce, tuna, capers, and mustard into noodles. Transfer to prepared dish."
    },
    {
      "position": 5,
      "text": "Melt remaining 1 tablespoon butter. Toss bread cubes with melted butter and seafood seasoning. Arrange tomato slices over noodle mixture. Sprinkle with remaining 1 cup cheese. Top with seasoned bread cubes."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until hot and bubbly and bread cubes are lightly browned, 25 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 55,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "hard",

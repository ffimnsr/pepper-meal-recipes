  "slug": "peanut-butter-chocolate-overnight-oats",
  "name": "Peanut Butter Chocolate Overnight Oats",
  "recipe_type": "breakfast",
  "brief_description": "These overnight oats are flavored with chocolate-almond milk and peanut butter and thickened with chia seeds.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Combine chocolate protein milk, oats, peanut butter powder, and chia seeds in a 1/2 pint jar with lid. Cover jar with lid."
    },
    {
      "position": 2,
      "text": "Refrigerate oatmeal for 8 hours or overnight."
    }
  ],

  "slug": "nova-lox-everything-breakfast-bagel",
  "name": "Nova Lox Everything Breakfast Bagel",
  "recipe_type": "breakfast",
  "brief_description": "Save the money and make your own breakfast bagels with cream cheese, capers, and smoked salmon instead of doing grab-and-go.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Split bagel thins and toast the bagel thins until lightly golden."
    },
    {
      "position": 2,
      "text": "Smear 2 tablespoons whipped cream cheese on each bagel. Top each bagel with a tomato slice, 1 ounce smoked salmon, and capers. Serve immediately."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 2,

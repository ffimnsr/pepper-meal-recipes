  "id": "7f65ead8-a691-52f3-8e4d-4f1b46d2362b",
  "slug": "thai-chicken-noodle-soup",
  "name": "Thai Chicken Noodle Soup",
  "recipe_type": "soup",
  "brief_description": "This Thai chicken noodle soup uses red curry, red bell peppers, coconut milk, and fresh basil. It's delicious and bursting with bright, bold flavors!",
  "cuisine": "Thai",
  "instructions": [
    {
      "position": 1,
      "text": "Heat a large stock pot over medium heat. Add oil, carrots, onion, and bell pepper. Cook for about 3 minutes. Add chicken and mix well. Add garlic. Cook until chicken is no longer pink in the center and juices run clear, 5 to 10 minutes."
    },
    {
      "position": 2,
      "text": "Mix in chicken broth, coconut milk, curry paste, salt, and pepper. Bring soup to a boil, about 5 minutes. Add noodles and allow soup to come to a boil again. Reduce heat to low and simmer about 3 minutes."
    },
    {
      "position": 3,
      "text": "Cover the pot, remove from heat, and let sit just until noodles are tender, 5 to 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

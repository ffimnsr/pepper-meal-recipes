  "schema_version": 1,
  "id": "a0a86992-bd95-5164-ab0a-3137d9da4cc6",
  "slug": "costas-french-market-doughnuts-beignets",
  "name": "Costas French Market Doughnuts (Beignets)",
  "recipe_type": "breakfast",
  "brief_description": "Try this genuine recipe for Costas French Market doughnuts (beignets). These tender pillow-like doughnuts taste like those at New Orleans' Cafe du Monde.",
  "cuisine": "Southern",
  "instructions": [
    {
      "position": 1,
      "text": "Pour \u00bd cup room temperature water into a small bowl; sprinkle yeast over water and let stand to dissolve, about 5 minutes."
    },
    {
      "position": 2,
      "text": "Combine white sugar, shortening, and salt in a large bowl; pour 1 cup boiling water over shortening mixture, then stir in evaporated milk. Cool mixture until lukewarm, then add yeast mixture and beaten eggs."
    },
    {
      "position": 3,
      "text": "Slowly mix in flour until dough forms a ball. Cover dough with plastic wrap and refrigerate 30 to 60 minutes."
    },
    {
      "position": 4,
      "text": "Roll out dough, working with a small portion (a little larger than a baseball) at a time, until \u215b-inch thick. Cut dough into strips 2- to 3-inches wide, then cut at an angle in the opposite direction, making diamond shapes."
    },
    {
      "position": 5,
      "text": "Heat oil in a deep, wide, heavy-bottomed skillet over medium-high heat to 360 degrees F (180 degrees C)."
    },
    {
      "position": 6,
      "text": "Lower dough diamonds carefully into the hot oil in batches. Fry until puffed and golden brown, 3 to 5 minutes. Carefully transfer to a rack set on paper towels to drain; cool until you can handle them."
    },
    {
      "position": 7,
      "text": "Place beignets in a clean paper bag with confectioners' sugar; shake gently until covered generously. Or use a sifter to dust beignets with confectioners' sugar."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

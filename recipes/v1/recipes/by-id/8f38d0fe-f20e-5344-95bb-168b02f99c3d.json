  "id": "8f38d0fe-f20e-5344-95bb-168b02f99c3d",
  "slug": "basic-irish-soda-bread-with-cheese",
  "name": "Basic Irish Soda Bread With Cheese",
  "recipe_type": "main",
  "brief_description": "A simple soda-risen bread is cut into squares, brushed with egg, dipped into grated Parmesan cheese, and baked for a savory accompaniment to your Irish meal.",
  "cuisine": "Irish",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper. Beat eggs in a bowl and set aside. Place the Parmesan cheese into a shallow bowl."
    },
    {
      "position": 2,
      "text": "In a bowl, mix the flour, salt, and baking soda until well combined. Add in milk, several tablespoons at a time, until the mixture forms a soft dough. Turn the dough out onto a well-floured work surface, and knead several times until the dough comes together."
    },
    {
      "position": 3,
      "text": "Roll the dough out into a rectangle about 1/2 inch thick, and cut into 2x3-inch squares. Brush each square with beaten egg, and dip the top of the square into the Parmesan cheese. Place the squares onto the prepared baking sheet."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until the squares are lightly browned, about 10 minutes."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 10,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

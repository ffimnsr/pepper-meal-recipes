  "id": "889c0c6e-14ff-554f-adf3-1ed6c7a7457f",
  "slug": "simple-chopped-liver",
  "name": "Simple Chopped Liver",
  "recipe_type": "appetizer",
  "brief_description": "This Jewish chopped liver spread is a delicious savory blend of tender cooked liver, onion, and hard-boiled eggs perfect for Passover celebrations.",
  "cuisine": "Jewish American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Place eggs into a saucepan and cover with water. Bring to a boil, then remove the from heat and let eggs stand in hot water for 15 minutes. Remove eggs from hot water, cool under cold running water, and peel."
    },
    {
      "position": 3,
      "text": "Meanwhile, heat canola oil in a skillet over medium heat. Add onions and cook, stirring occasionally, until soft and translucent, about 5 minutes. Reduce heat to medium-low and continue cooking and stirring until onions are very tender and golden brown, 5 to 10 more minutes. Transfer to a plate."
    },
    {
      "position": 4,
      "text": "Cook chicken livers in the same skillet until no longer pink in the center and the juices run clear, 5 to 10 minutes. Place chicken livers onto the same plate as onions and allow to cool."
    },
    {
      "position": 5,
      "text": "Process chicken livers and onions in a food processor to the desired consistency."
    },
    {
      "position": 6,
      "text": "Transfer to a bowl, season with salt and sugar, and stir in chopped eggs."
    },
    {
      "position": 7,
      "text": "Chill before serving, about 2 hours. Enjoy!"
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,
  "difficulty": "medium",

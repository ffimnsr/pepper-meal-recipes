  "id": "f37279f1-df1a-51e7-a491-bb2bf2a0ea26",
  "slug": "mock-a-roons",
  "name": "Mock-a-Roons",
  "recipe_type": "dessert",
  "brief_description": "Easy cookies! These are very chewy yummy mockaroons. They do not have real coconut in them. Just a few ingredients and you're done.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease cookie sheets."
    },
    {
      "position": 2,
      "text": "In a medium bowl, cream together the butter and sugar until smooth. Stir in the egg and coconut extract. Combine the flour and potato flakes, and stir into the batter until well blended. Drop heaping spoonfuls onto the prepared cookie sheets."
    },
    {
      "position": 3,
      "text": "Bake for 12 minutes, or until the tops are still white, and the bottoms are light brown. This will insure chewy cookies. Cool for a few minutes on the cookie sheet before removing to wire racks to cool completely."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 12,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

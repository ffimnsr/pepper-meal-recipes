  "id": "4206d1f1-0e89-5670-b036-5466908623b6",
  "slug": "mock-macaroons",
  "name": "Mock Macaroons",
  "recipe_type": "dessert",
  "brief_description": "Oatmeal \"marinated\" in brown sugar and vegetable oil makes for crispy edges and a chewy middle.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Combine oatmeal, brown sugar and oil in a bowl. Stir to mix well. Cover and let stand at least 5 hours, or overnight."
    },
    {
      "position": 2,
      "text": "Pre-heat oven to 350 degrees F (175 degrees C). Grease cookie sheets - use non-stick if possible."
    },
    {
      "position": 3,
      "text": "Add the egg, salt and almond extract to oatmeal and stir well until blended."
    },
    {
      "position": 4,
      "text": "Drop by rounded teaspoonfuls about 1-1/2 inches apart on greased cookie sheets. Bake 7 or 8 minutes or until edges are browned and center is golden. Remove from cookie sheet and cool on racks."
    }
  ],
  "servings": 30,
  "cooking_time_minutes": null,

  "id": "9530c1f5-bb44-5c84-b738-2ad56a19831c",
  "slug": "grilled-cheese-casserole-recipe-11885539",
  "name": "Grilled Cheese Casserole",
  "recipe_type": "breakfast",
  "brief_description": "This grilled cheese casserole, with flavors of both a grilled cheese sandwich and a breakfast casserole, is a great way to use older bread, and leftover cheese from any charcuterie board.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Lightly spray a 9x9-inch casserole dish with cooking spray. Lay 2 slices of bread in the bottom of the dish. Butter the bread facing up."
    },
    {
      "position": 3,
      "text": "Cover buttered bread with cheese, then place 2 pieces bacon on each slice. Top each with an additional slice of bread and butter the tops."
    },
    {
      "position": 4,
      "text": "Whisk eggs and milk together in a bowl. Season with salt and pepper, then pour egg mixture around the sandwiches. Let mixture stand while the oven preheats."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until the bread is golden brown and the eggs are set, about 20 minutes. Serve warm."
    }
  ],
  "servings": 2,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "a4cd5ee7-8e78-5580-bad3-f754a2acc083",
  "slug": "mississippi-chicken-casserole-recipe-11865469",
  "name": "Mississippi Chicken Casserole",
  "recipe_type": "main",
  "brief_description": "Mississippi chicken casserole is a creamy casserole with shredded chicken, egg noodles, and pepperoncini. It's quick and easy to put together and makes a great weeknight dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 2-quart baking dish with cooking spray."
    },
    {
      "position": 2,
      "text": "Stir together cream cheese, sour cream, 1/2 cup Monterey Jack cheese, melted butter, pepperoncini brine, ranch dressing mix, and au jus gravy mix in a large bowl until well combined. Stir in milk."
    },
    {
      "position": 3,
      "text": "Fold in cooked noodles, chicken, and pepperoncini peppers until evenly coated."
    },
    {
      "position": 4,
      "text": "Spread mixture into the prepared baking dish; sprinkle with remaining 1/2 cup Monterey Jack cheese."
    },
    {
      "position": 5,
      "text": "Bake until hot and bubbly, 25 to 30 minutes Recipe developed by Nicole Irwin"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "b1730106-925c-5998-9a13-f3e4d7be69d0",
  "slug": "green-tomato-and-pepper-relish",
  "name": "Green Tomato and Pepper Relish",
  "recipe_type": "dessert",
  "brief_description": "This green tomato and pepper relish recipe strikes the perfect balance between sweet and tart, resulting in a versatile condiment for your favorite dish.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Inspect 6 pint-sized jars for cracks and rings for rust, discarding any defective ones. Immerse in simmering water until relish is ready. Wash new, unused lids and rings in warm soapy water."
    },
    {
      "position": 2,
      "text": "Combine green tomatoes, onions, and bell peppers in the bowl of a food processor; pulse until coarsely chopped. Transfer to a large bowl; pour boiling water over vegetable mixture and set aside for 20 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Add vegetable mixture to a large pot over medium-high heat; stir in sugar, vinegar, mustard, salt, and turmeric to combine. Bring to a boil until vegetables are softened, about 10 minutes."
    },
    {
      "position": 4,
      "text": "Pack relish into hot, sterilized jars, filling to within \u00bc inch of tops. Run a clean knife or thin spatula around insides of jars to remove any air bubbles. Wipe rims with a moist paper towel to remove any residue. Top with lids and screw rings on tightly."
    },
    {
      "position": 5,
      "text": "Place a rack in the bottom of a large stockpot and fill halfway with water. Bring to a boil and lower jars 2 inches apart into the boiling water using a holder. Pour in more boiling water to cover jars by at least 1 inch. Bring to a rolling boil, cover, and process for 15 minutes."
    },
    {
      "position": 6,
      "text": "Remove jars from the stockpot and place onto a cloth-covered or wood surface, several inches apart, until cool, 2 to 24 hours. Press centers of lids with a finger to ensure lids do not move up or down. Remove rings for storage and store in a cool, dark area."
    }
  ],
  "servings": 64,
  "cooking_time_minutes": 25,
  "preparation_time_minutes": 30,
  "rest_time_minutes": null,

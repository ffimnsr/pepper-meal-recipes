  "id": "5970749c-b03e-53d2-8b82-39d247e71eb6",
  "slug": "apple-crumble-pie",
  "name": "Apple Crumble Pie",
  "recipe_type": "dessert",
  "brief_description": "This apple crumble pie has a classic apple pie filling with cinnamon and is topped with a rich and buttery crumb topping for a cozy fall dessert.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 400 degrees F (200 degrees C.)"
    },
    {
      "position": 2,
      "text": "Arrange apple slices in unbaked pie shell. Mix 1/2 cup sugar and cinnamon; sprinkle over apples."
    },
    {
      "position": 3,
      "text": "To make the crumble topping: Place 1/3 cup sugar and flour in a bowl. Cut in cold butter with 2 knives or pastry blender until the mixture resembles coarse crumbs; spoon mixture over apples."
    },
    {
      "position": 4,
      "text": "Bake in preheated oven until apples are soft and top is lightly browned, about 40 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 40,
  "preparation_time_minutes": 30,

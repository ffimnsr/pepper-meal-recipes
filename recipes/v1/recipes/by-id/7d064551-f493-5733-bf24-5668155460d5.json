  "slug": "slow-cooker-creamy-pot-roast",
  "name": "Slow Cooker Creamy Pot Roast",
  "recipe_type": "main",
  "brief_description": "This recipe for savory pot roast in a creamy gravy is perfect for serving over mashed potatoes or noodles.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Season roast all over with salt and black pepper and place roast in a slow cooker. Whisk golden mushroom soup, sliced mushrooms, cream of mushroom soup, onion soup mix, and garlic together in a bowl; pour over beef roast."
    },
    {
      "position": 2,
      "text": "Cook on Low for 8 to 10 hours."
    }
  ],
  "servings": 10,
  "cooking_time_minutes": 480,

{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "b3a27726-c823-5b8e-a2d3-3f7daed00832",
  "slug": "quick-cinnamon-rolls",
  "name": "Quick Cinnamon Rolls",
  "recipe_type": "dessert",
  "brief_description": "This quick cinnamon roll recipe makes big, soft, fluffy rolls with a sweet cinnamon filling and homemade cream cheese frosting in just 40 minutes.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather Ingredients. Preheat the oven to 400 degrees F (200 degrees C). Brush an 8-inch square baking dish with 1 tablespoon of the melted butter."
    },
    {
      "position": 2,
      "text": "To make the dough: Whisk flour, white sugar, baking powder, and salt together in a large bowl. Work 3 tablespoons softened butter into flour mixture using your hands until butter is lentil-sized."
    },
    {
      "position": 3,
      "text": "Pour milk into flour-butter mixture and stir with a rubber spatula until a soft dough forms."
    },
    {
      "position": 4,
      "text": "Turn dough out onto a well-floured work surface and roll dough into a 10-inch square pan. Brush surface of dough with remaining 2 tablespoons melted butter."
    },
    {
      "position": 5,
      "text": "To make the filling: Whisk \u00bc cup white sugar, brown sugar, and cinnamon together in a small bowl. Sprinkle 1 tablespoon cinnamon-sugar mixture in the bottom of the prepared baking dish. Sprinkle remaining cinnamon sugar over butter-brushed dough."
    },
    {
      "position": 6,
      "text": "Roll dough around filling to form a log; cut log into 9 rolls about 1-inch wide; place rolls, cut-side up, in the prepared baking dish."
    },
    {
      "position": 7,
      "text": "Bake in the preheated oven until rolls are puffed and lightly golden, 20 to 25 minutes."
    },
    {
      "position": 8,
      "text": "To make the frosting: Beat confectioners' sugar, cream cheese, 1/4 cup softened butter, and vanilla extract together in a bowl until frosting is smooth."
    },
    {
      "position": 9,
      "text": "Top hot cinnamon rolls with cream cheese frosting."
    }
  ],
  "servings": 9,
  "cooking_time_minutes": 20,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

  "id": "cb57436f-1667-57be-a7e8-ce9be95f6954",
  "slug": "gnocchi-bake",
  "name": "Gnocchi Bake",
  "recipe_type": "main",
  "brief_description": "A satisfying casserole of chewy gnocchi, savory sausage, stretchy cheese, and your favorite jarred sauce is the perfect recipe for a quick weeknight meal.",
  "cuisine": "Italian Inspired",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C)."
    },
    {
      "position": 2,
      "text": "Bring a large pot of lightly salted water to a boil. Add gnocchi, and cook until tender, 5 to 8 minutes."
    },
    {
      "position": 3,
      "text": "Meanwhile, crumble sausage into a skillet over medium-high heat. Cook and stir until evenly browned. Drain grease, and stir in spaghetti sauce. Remove from heat, and carefully combine with cooked gnocchi and half of the mozzarella cheese. Transfer to a casserole dish. Sprinkle remaining cheese on top."
    },
    {
      "position": 4,
      "text": "Bake for 15 to 20 minutes in the preheated oven, until cheese is melted and sauce is bubbly."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 30,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

  "id": "ff2355aa-0bfc-55c3-aeba-4cc112ccfd56",
  "slug": "french-macarons",
  "name": "French Macarons",
  "recipe_type": "dessert",
  "brief_description": "A thick buttercream filling is sandwiched between two tender macarons in this recipe for the classy French treat you can now make at home.",
  "cuisine": "French",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Line a baking sheet with parchment paper."
    },
    {
      "position": 2,
      "text": "Beat egg whites in a glass, metal, or ceramic bowl with an electric mixer on medium speed until foamy, about 30 seconds. Add white sugar and continue to beat until peaks are stiff enough and stay in place when the bowl is turned upside down, about 5 minutes."
    },
    {
      "position": 3,
      "text": "Sift 1 2/3 cup confectioners' sugar, almond flour, and salt together twice. Fold into egg whites until batter is creamy and falls slowly off the lifted spatula, about 50 turns with a spatula. Transfer batter to a piping bag fitted with a round tip."
    },
    {
      "position": 4,
      "text": "Pipe batter onto the parchment paper, using a circular motion to make macarons 1 inch in diameter. Tap the baking sheet against the counter about 10 times to release any air bubbles."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven for 9 minutes. Rotate the baking sheet and continue baking until macarons are shiny and rise slightly to form feet (ruffles around the edge), about 9 minutes more. Peel off parchment paper and allow to cool completely, about 30 minutes."
    },
    {
      "position": 6,
      "text": "Beat butter, 2/3 cup confectioners' sugar, and vanilla extract with an electric mixer until creamy and thick, about 10 minutes. Transfer filling to a piping bag fitted with a round tip."
    },
    {
      "position": 7,
      "text": "Pipe a small amount of filling in the center on the flat side of 1 macaron; top with another macaron and press gently to sandwich together."
    }
  ],
  "servings": 24,
  "cooking_time_minutes": 18,
  "preparation_time_minutes": 45,

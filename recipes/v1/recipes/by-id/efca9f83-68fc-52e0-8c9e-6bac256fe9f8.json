  "id": "efca9f83-68fc-52e0-8c9e-6bac256fe9f8",
  "slug": "julias-new-mexican-guacamole",
  "name": "Julia's New Mexican Guacamole",
  "recipe_type": "appetizer",
  "brief_description": "Full of New Mexico-inspired flavor, this easy chilled guacamole is stuffed with chile peppers, avocados, and cream cheese.",
  "cuisine": "Southwestern Tex-Mex",
  "instructions": [
    {
      "position": 1,
      "text": "Pit and spoon avocados into a small bowl and add cream cheese. Mash together until well blended."
    },
    {
      "position": 2,
      "text": "Add tomatoes and peppers to the mixture and mix well. Mix in lime juice, garlic powder, hot sauce, and salt. Chill for at least 20 minutes before serving."
    }
  ],
  "servings": 8,

  "id": "43b52790-c80b-5dd1-8fa3-31ae5f138e79",
  "slug": "smash-dumpling-tacos-recipe-11781222",
  "name": "Smash Dumpling Tacos",
  "recipe_type": "appetizer",
  "brief_description": "These smash dumpling tacos are made with pork dumpling filling, spread onto flour tortillas, then cooked smash-style and folded into a taco, the-n topped with fresh pickled cucumber.",
  "cuisine": "Asian",
  "instructions": [
    {
      "position": 1,
      "text": "Combine cucumber, rice vinegar, salt, and chili flakes in a small bowl. Set aside."
    },
    {
      "position": 2,
      "text": "For taco filling, combine pork, garlic, sesame oil, soy sauce, rice vinegar, ginger paste, and green onions in a bowl; mix gently with your hands or a fork."
    },
    {
      "position": 3,
      "text": "Heat a large skillet over medium-high heat. Spread 2 tablespoons filling over a tortilla in a flat, even layer."
    },
    {
      "position": 4,
      "text": "Place tortilla in the skillet filling side down. Using a spatula, press and cook for 3 minutes. Flip and cook 2 minutes more. Repeat with remaining tortillas."
    },
    {
      "position": 5,
      "text": "Top with pickles; garnish with cilantro, sesame seeds, and Sriracha."
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 5,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "easy",

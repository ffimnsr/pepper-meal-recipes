  "id": "b008db98-39df-519d-988c-0faf1003584f",
  "slug": "deconstructed-cabbage-roll-casserole",
  "name": "Deconstructed Cabbage Roll Casserole",
  "recipe_type": "main",
  "brief_description": "This deconstructed cabbage roll casserole recipe uses typical cabbage roll ingredients like cabbage, rice, and Italian sausage for the same great taste.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a casserole dish."
    },
    {
      "position": 2,
      "text": "Heat a large skillet over medium-high heat. Add sausage; cook and stir until browned and crumbly, 5 to 7 minutes. Drain and discard grease."
    },
    {
      "position": 3,
      "text": "Stir in onion, bell pepper, and garlic; cook until onion is translucent, 8 to 10 minutes. Stir in cabbage; cook until slightly softened, about 5 minutes."
    },
    {
      "position": 4,
      "text": "Transfer sausage mixture to the prepared casserole dish. Stir in tomato sauce, cooked rice, Worcestershire sauce, brown sugar, lemon juice, Cajun seasoning, black pepper, and salt until combined."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until cabbage is tender, about 30 minutes."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,
  "difficulty": "medium",

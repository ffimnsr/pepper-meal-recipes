  "id": "1c62a38c-9b93-524d-8690-5ed548a72060",
  "slug": "old-fashioned-blueberry-custard-pie",
  "name": "Old-Fashioned Blueberry Custard Pie",
  "recipe_type": "dessert",
  "brief_description": "This old-fashioned blueberry custard pie recipe makes the ultimate creamy, delicious blueberry-forward summer dessert with an easy prepared pie crust.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 410 degrees F (210 degrees C). Place 1 pie crust in a 9-inch pie plate."
    },
    {
      "position": 2,
      "text": "Beat eggs together in a large bowl; whisk in sugar, flour, cornstarch, milk, nutmeg, cinnamon, and salt. Add blueberries; stir to combine. Pour blueberry mixture into bottom crust."
    },
    {
      "position": 3,
      "text": "Roll out remaining pie crust into a 10-inch circle; cut into \u00bd-inch strips with a sharp paring knife or pastry wheel. Moisten rim of pie with a small amount of water. Start with the longest strips and lay the first 2 in an X in the center of the pie. Alternate horizontal and vertical strips, weaving them in an over-and-under pattern. Use the shortest strips for the edges of the lattice. Fold the ends of the lattice strips under the edge of the bottom crust and flute the crust."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until center is set, about 50 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 50,
  "preparation_time_minutes": 25,
  "rest_time_minutes": null,

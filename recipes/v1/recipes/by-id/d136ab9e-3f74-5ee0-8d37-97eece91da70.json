  "id": "d136ab9e-3f74-5ee0-8d37-97eece91da70",
  "slug": "cornbread-donuts-recipe-11746129",
  "name": "Cornbread Donuts",
  "recipe_type": "dessert",
  "brief_description": "Chef John's cornbread donuts are baked, not fried, so they're almost as easy to make as a batch of cornbread. Only slightly sweet, the donuts are drizzled with a spicy chipotle icing after baking.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Generously butter 2 nonstick donut pans (6 compartments per pan)."
    },
    {
      "position": 2,
      "text": "Whisk flour, cornmeal, baking powder, salt, and baking soda together in a bowl; set aside."
    },
    {
      "position": 3,
      "text": "Add egg and sugar to a large bowl; whisk until mixture turns a pale yellow, about 1 minute."
    },
    {
      "position": 4,
      "text": "Whisk in melted butter until combined, then whisk in milk and buttermilk. Add cornmeal mixture and whisk until a thick, sticky batter forms, 2 to 3 minutes, to develop a little bit of gluten so donuts are not overly fragile after baking."
    },
    {
      "position": 5,
      "text": "Spoon or pipe batter evenly into prepared pans, for 12 donuts total. Tap pans on the counter a few times to settle the batter down."
    },
    {
      "position": 6,
      "text": "Bake in the preheated oven until golden on the top and a toothpick inserted in the thickest part comes out clean, about 15 minutes."
    },
    {
      "position": 7,
      "text": "Let cool for 10 minutes; remove donuts from pans to cool completely on a wire rack."
    },
    {
      "position": 8,
      "text": "Whisk confectioner\u2019s sugar, lemon juice, milk, and chipotle together in a small bowl until very thick and smooth. Add confectioner\u2019s sugar, a small amount at a time, to form an icing thick enough to hold its shape when piped."
    },
    {
      "position": 9,
      "text": "Pipe or spread icing as desired over donuts. Let icing set until firm, 30 to 60 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,
  "difficulty": "medium",

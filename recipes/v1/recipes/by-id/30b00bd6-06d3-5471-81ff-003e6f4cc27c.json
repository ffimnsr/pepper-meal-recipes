  "id": "30b00bd6-06d3-5471-81ff-003e6f4cc27c",
  "slug": "strawberry-cream-cheese-pound-cake",
  "name": "Strawberry Cream Cheese Pound Cake",
  "recipe_type": "dessert",
  "brief_description": "This strawberry and cream cheese pound cake is perfectly textured! And bonus \u2014 it uses less sugar than other pound cake recipes.",
  "cuisine": null,
  "instructions": [
    {
      "position": 1,
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a fluted tube pan (such as Bundt)."
    },
    {
      "position": 2,
      "text": "Beat sugar, 1 cup plus 2 teaspoon butter, and cream cheese in a mixing bowl until light and fluffy, about 3 minutes. Mix in vanilla and salt until well combined. Add eggs, one at a time, beating thoroughly after each addition."
    },
    {
      "position": 3,
      "text": "Gradually add flour, one cup at a time, beating until just incorporated. Fold in muddled strawberries. Pour batter into the prepared pan, then lightly sprinkle vanilla sugar over top."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour."
    },
    {
      "position": 5,
      "text": "Remove from the oven and set on a wire rack to cool for 5 to 10 minutes. Invert carefully onto a serving plate or cooling rack and let cool completely."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 60,
  "preparation_time_minutes": 15,
  "rest_time_minutes": null,

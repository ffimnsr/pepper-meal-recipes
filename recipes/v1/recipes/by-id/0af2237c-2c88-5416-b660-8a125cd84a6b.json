  "id": "0af2237c-2c88-5416-b660-8a125cd84a6b",
  "slug": "balsamic-pasta-primavera",
  "name": "Balsamic Pasta Primavera",
  "recipe_type": "main",
  "brief_description": "Fresh ingredients shine in this easy weeknight pasta primavera dish that's made zesty and delicious with a balsamic vinegar-based sauce.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender yet firm to the bite, 7 to 9 minutes."
    },
    {
      "position": 2,
      "text": "Meanwhile, combine balsamic vinegar, 1/4 cup oil, garlic, Dijon mustard, and pepper in a small bowl. Set sauce aside."
    },
    {
      "position": 3,
      "text": "Heat 2 tablespoons oil in a large pan over medium-high heat. Add mushrooms, squash, and onion. Cook for 3 minutes; stir in balsamic sauce mixture. Continue cooking until vegetables are tender, about 3 minutes more, adding parsley during the last minute of cooking. Drain cooked pasta, add to the pan, and toss to coat with sauce. Serve hot."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "easy",

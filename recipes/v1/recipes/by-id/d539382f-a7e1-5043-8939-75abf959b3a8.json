  "id": "d539382f-a7e1-5043-8939-75abf959b3a8",
  "slug": "filipino-chicken-adobo",
  "name": "Filipino Chicken Adobo",
  "recipe_type": "main",
  "brief_description": "A jalapeno, garlic, and soy mixture does double duty in this popular Filipino chicken adobo recipe, serving as a marinade for the chicken wings and a base for the sauce.",
  "cuisine": "Filipino",
  "instructions": [
    {
      "position": 1,
      "text": "Whisk soy sauce, jalapeno peppers, and garlic together in a large glass or ceramic bowl. Add chicken wings and toss to evenly coat. Cover the bowl with plastic wrap and marinate in the refrigerator for at least 1 hour."
    },
    {
      "position": 2,
      "text": "Remove chicken wings from the marinade and shake off excess. Reserve marinade."
    },
    {
      "position": 3,
      "text": "Heat oil in a large saucepan over medium heat. Place chicken wings in the hot oil and pan-fry for 2 minutes per side. Slowly pour in reserved marinade (including garlic) and water. Bring to a boil. Add bay leaves and peppercorns and simmer until chicken is tender, about 20 minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C)."
    },
    {
      "position": 4,
      "text": "Stir in vinegar and cook for 5 minutes. Stir again and season with sugar and salt to taste. Serve hot."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

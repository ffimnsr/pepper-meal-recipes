{
  "$schema": "../../schemas/recipe.schema.json",
  "schema_version": 1,
  "id": "731e8518-fdc2-5f09-b814-5f6149a0003a",
  "slug": "chocolate-dipped-pistachio-biscotti",
  "name": "Chocolate-Dipped Pistachio Biscotti",
  "recipe_type": "dessert",
  "brief_description": "Swap out the mix-ins in this sweet caf\u00e9 treat and create original flavors customized just for your family.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 325 degrees F. Line a large baking sheet with Reynolds\u00ae Parchment Paper; set aside."
    },
    {
      "position": 2,
      "text": "Stir together the sugar, butter, vanilla, baking powder, and salt in a large bowl. Add the eggs and whites, beating vigorously with a wooden spoon until evenly incorporated. Fold in the dried apricots, then 11/2 cups pistachios until thoroughly incorporated. Gradually stir in the flour and cornmeal until very well blended (if necessary, work in the last of it with your hands). Let dough stand for 5 minutes to firm up."
    },
    {
      "position": 3,
      "text": "Divide the dough in half. Using greased hands, shape and smooth each half into an 8x4-inch loaf, spacing them 4 inches apart on the prepared baking sheet. Pat each loaf to an even thickness."
    },
    {
      "position": 4,
      "text": "Bake 24 to 28 minutes or until firm and light brown and a toothpick inserted near the center of each comes out clean. Remove from oven. Set aside; cool completely. Transfer to a cutting board. Using a large, serrated knife, cut each loaf into slices about 1/4 inch thick. Place slices, cut side down, on parchment-paper-lined baking sheets."
    },
    {
      "position": 5,
      "text": "Return one baking sheet to the oven. Bake slices 12 to 14 minutes or until toasted and light brown, turning once halfway through baking and watching closely to avoid overbrowning. Slide the parchment paper with baked cookies on it to a wire rack and let cool. Repeat with remaining slices."
    },
    {
      "position": 6,
      "text": "Microwave chocolate and shortening in a medium microwave-safe bowl on 100% power (high) 1 to 2 minutes or until melted and smooth, stirring every 30 seconds."
    },
    {
      "position": 7,
      "text": "Dip one half of each cookie crosswise into melted chocolate. Allow excess chocolate to drip off and place on clean parchment paper. Sprinkle with remaining 1/4 cup chopped pistachios and let stand until set."
    }
  ],
  "servings": 60,
  "cooking_time_minutes": 42,
  "preparation_time_minutes": 45,

  "id": "b574658b-fc54-58dd-8c3a-93dedffcc172",
  "slug": "red-white-and-blue-misu",
  "name": "Red, White, and Blue-Misu",
  "recipe_type": "dessert",
  "brief_description": "Inspired by Italian tiramisu and British trifle, this red, white, and blue-misu recipe layers whipped mascarpone and cream, angel food cake, and berries.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Beat cream in a large bowl until stiff peaks form; gently fold in mascarpone until well incorporated. Set aside."
    },
    {
      "position": 2,
      "text": "Place \u00bd strawberries in a blender; blend until smooth. Transfer pur\u00e9ed strawberries to a large bowl; stir in remaining whole strawberries and blueberries."
    },
    {
      "position": 3,
      "text": "Layer \u2153 angel food cake cubes in bottom of a trifle or serving bowl. Cover with \u2153 berry mixture; gently spoon \u2153 whipped cream mixture over berries. Repeat layers twice more, ending with cream mixture. Chill until ready to serve."
    },
    {
      "position": 4,
      "text": "Shave chocolate using a vegetable peeler, letting curls fall on top of dessert."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": null,
  "preparation_time_minutes": 20,
  "rest_time_minutes": null,

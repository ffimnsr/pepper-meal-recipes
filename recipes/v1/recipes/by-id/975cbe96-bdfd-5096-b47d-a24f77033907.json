  "id": "975cbe96-bdfd-5096-b47d-a24f77033907",
  "slug": "stuffing-meatloaf",
  "name": "Stuffing Meatloaf",
  "recipe_type": "main",
  "brief_description": "This savory meatloaf with stuffing mix is super easy to make. Top with shredded mozzarella cheese for a delicious, budget-friendly dinner.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Gather all ingredients."
    },
    {
      "position": 2,
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x5-inch loaf pan with cooking spray."
    },
    {
      "position": 3,
      "text": "Mix beef, onion, stuffing mix, and egg by hand in a bowl. Press beef mixture into the prepared pan."
    },
    {
      "position": 4,
      "text": "Bake in the preheated oven until no longer pink in the center, 35 to 40 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C)."
    },
    {
      "position": 5,
      "text": "Top meatloaf with shredded mozzarella cheese and let rest while cheese melts, about 10 minutes."
    }
  ],
  "servings": 8,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 10,
  "rest_time_minutes": null,
  "difficulty": "medium",

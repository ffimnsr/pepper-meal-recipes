  "id": "d91b5c52-1b7b-5428-9b2e-5c9be2b4a2ec",
  "slug": "best-smoked-salmon-dip-recipe-8741722",
  "name": "Best Smoked Salmon Dip",
  "recipe_type": "appetizer",
  "brief_description": "This easy, party-ready dip is perfect for any get-together. You can make this up to three days in advance.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Flake smoked salmon with a fork."
    },
    {
      "position": 2,
      "text": "Beat together cream cheese and mayonnaise in a large bowl with an electric mixer at medium speed until smooth. Add red onion, green onion, capers, lemon juice, dill, and Creole seasoning; mix well. Gently fold in smoked salmon."
    },
    {
      "position": 3,
      "text": "Chill in an airtight container at least 2 hours (and up to 3 days). Garnish with additional dill and green onions. Serve with crackers and crostini."
    }
  ],
  "servings": 32,
  "cooking_time_minutes": null,

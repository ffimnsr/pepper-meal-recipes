  "id": "53aac27e-8ca2-57b6-9b46-6222c962a84c",
  "slug": "grilled-jerk-sweet-potato-wedges-recipe-11998185",
  "name": "Grilled Jerk Sweet Potato Wedges",
  "recipe_type": "dessert",
  "brief_description": "A DIY jerk seasoning mix adds major flavor to potato wedges, a perfect side to any meat dish.",
  "cuisine": "Caribbean",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat an outdoor grill to medium heat (350 degrees F to 375 degrees F) and lightly oil grill grates."
    },
    {
      "position": 2,
      "text": "Scrub sweet potatoes and cut each into 8 (1/2 -inch-thick) wedges. Toss wedges with oil, jerk seasoning, and table salt."
    },
    {
      "position": 3,
      "text": "Grill sweet potato wedges, covered, turning occasionally, until tender, 16 to 18 minutes. Serve with a drizzle of additional oil and garnish with flaky salt."
    }
  ],
  "servings": 4,
  "cooking_time_minutes": 16,
  "preparation_time_minutes": 15,

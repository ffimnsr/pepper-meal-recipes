  "id": "3d6ef4bd-65f1-5013-a5e8-34a298756cce",
  "slug": "buttermilk-ranch-cheeseball",
  "name": "Buttermilk Ranch Cheese Ball",
  "recipe_type": "appetizer",
  "brief_description": "This simple Hidden Valley Ranch cheese ball is coated with pecans and is quick to make. It's a great way to make an appetizer at a moment's notice.",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Mix sour cream with ranch dressing mix in a bowl until smoothly combined. Add cream cheese and Cheddar cheese to the bowl and mix together with your hands until thoroughly blended. Chill mixture for 5 minutes, then shape into a ball."
    },
    {
      "position": 2,
      "text": "Place pecans into a shallow bowl and roll all sides of cheese ball in pecans to coat. Serve immediately."
    }
  ],
  "servings": 16,

  "id": "c444e8e3-b43e-508f-a3b6-8698e6e4d2e0",
  "slug": "simple-hamburger-stroganoff",
  "name": "Simple Hamburger Stroganoff",
  "recipe_type": "main",
  "brief_description": "This beef stroganoff recipe with hamburger is just as tasty as if it were made with a more expensive cut of beef, but it's much easier on your wallet.",
  "cuisine": "Eastern European",
  "instructions": [
    {
      "position": 1,
      "text": "Gather the ingredients."
    },
    {
      "position": 2,
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until tender yet firm to the bite, 7 to 9 minutes. Drain."
    },
    {
      "position": 3,
      "text": "Meanwhile, cook ground beef in a large skillet over medium-high heat, stirring occasionally, until browned and crumbly, 5 to 7 minutes; drain and discard grease."
    },
    {
      "position": 4,
      "text": "Stir in cream cheese, mushrooms with liquid, and gravy mix; cook and stir over medium heat until cream cheese melts, 2 to 3 minutes. Add condensed soup, sour cream, and milk; cook, stirring occasionally, until smooth and creamy, 3 to 5 minutes."
    },
    {
      "position": 5,
      "text": "Drain egg noodles; stir into the beef mixture. Cook until heated through, 2 to 3 minutes."
    },
    {
      "position": 6,
      "text": "Serve hot and enjoy!"
    }
  ],
  "servings": 6,
  "cooking_time_minutes": 15,
  "preparation_time_minutes": 5,
  "rest_time_minutes": null,
  "difficulty": "medium",

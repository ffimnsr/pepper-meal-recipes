  "id": "6579aeaf-bed0-5e0b-9a69-f1291294d05e",
  "slug": "owens-mozzarella-and-tomato-salad",
  "name": "Owen's Mozzarella and Tomato Salad",
  "recipe_type": "salad",
  "brief_description": "So easy, looks great, and tastes fabulous. Plump tomatoes are topped with thick slices of cheese, a drizzle of good olive oil, and fresh basil.",
  "cuisine": "Italian",
  "instructions": [
    {
      "position": 1,
      "text": "Chop tomatoes in half, then slice finely; arrange on four plates. Trickle a tablespoon of olive oil over each serving, and sprinkle with black pepper. Lay slices of cheese over tomatoes, and strips of basil over cheese. Cover with plastic wrap, and refrigerate for 30 minutes before serving."
    }
  ],

  "id": "f6082328-a3b3-561c-b790-81bcb58badb3",
  "slug": "fresh-strawberry-coffee-cake",
  "name": "Fresh Strawberry Coffee Cake",
  "recipe_type": "dessert",
  "brief_description": "This superb strawberry coffee cake made from scratch and topped with fresh strawberries and a crumbly coconut topping is sure to impress your guests!",
  "cuisine": "American",
  "instructions": [
    {
      "position": 1,
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9-inch baking pan."
    },
    {
      "position": 2,
      "text": "Beat 1/4 cup butter in a bowl until creamy; add 3/4 cup sugar and egg. Beat until fully incorporated."
    },
    {
      "position": 3,
      "text": "Mix 1 \u00bd cups flour, baking powder, and salt together in a separate bowl. Stir flour mixture, alternating with milk, into butter mixture until combined. Pour batter into prepared baking pan. Arrange strawberries on top of batter."
    },
    {
      "position": 4,
      "text": "Mix 1/2 cup flour, 1/2 cup sugar, 1/4 cup butter, and coconut together in a bowl. Sprinkle topping over strawberries."
    },
    {
      "position": 5,
      "text": "Bake in the preheated oven until a toothpick inserted in the center of the cake comes out clean, about 35 minutes."
    }
  ],
  "servings": 12,
  "cooking_time_minutes": 35,
  "preparation_time_minutes": 15,
